{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-normal",
      "type": "process",
      "command": "${workspaceFolder}/pawno/pawncc.exe",
      "args": [
        "${file}",
        "-Dgamemodes",
        "-;+",
        "-(+",
        "-v2",
        "-d3"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
