// ------------------------------------
stock IsABike(vehicleid)
{
	switch(GetVehicleData(vehicleid, V_MODELID))
	{
		case 481, 509, 510, 15644: return 1;
	}
	return 0;
}
stock IsAMoto(vehicleid)
{
	switch(GetVehicleData(vehicleid, V_MODELID))
	{
		case 581, 522, 461, 521, 523, 463, 468, 471, 586, 15127, 15129, 15130, 15132..15136, 15139, 15245, 15644: return 1;
	}
	return 0;
}
stock IsANumber(vehicleid)
{
	switch(GetVehicleData(vehicleid, V_MODELID))
	{
		case 462, 15646, 448, 447, 446, 441, 425, 493, 488, 487, 15285,15243,15154,15111,15112,606,607,584,583,577,564,563,548,539,537,538,531,532,530,520,523,519,512,513,511,501,509,510,497,476,473,469,464,465,449,435,432,417: return 1;
	}
	return 0;
}
stock VehicleData_Init(vehicleid, modelid, Float:x, Float:y, Float:z, Float:angle, color1, color2, addsiren=0, action_type, action_id)
{
	if(IsValidVehicleID(vehicleid))
	{
		SetVehicleData(vehicleid, V_MODELID, modelid);
		
		SetVehicleData(vehicleid, V_SPAWN_X_LAST, 		x);
		SetVehicleData(vehicleid, V_SPAWN_Y_LAST, 		y);
		SetVehicleData(vehicleid, V_SPAWN_Z_LAST, 		z);
		SetVehicleData(vehicleid, V_SPAWN_ANGLE_LAST, 	angle);
		
		SetVehicleData(vehicleid, V_COLOR_1, 	color1);
		SetVehicleData(vehicleid, V_COLOR_2, 	color2);
		
		SetVehicleData(vehicleid, V_ADDSIREN, 		addsiren);
		
		SetVehicleData(vehicleid, V_ACTION_TYPE, 	action_type);
		SetVehicleData(vehicleid, V_ACTION_ID, 		action_id);
		SetVehicleData(vehicleid, V_DRIVER_ID, 		INVALID_PLAYER_ID);
		SetVehicleData(vehicleid, V_doTime, 		0);
		
		SetVehicleData(vehicleid, V_FUEL, 40.0);
		SetVehicleData(vehicleid, V_MILEAGE, 0.0);
		SetVehicleData(vehicleid, V_LIMIT, true);

		SetVehicleData(vehicleid, V_HEALTH, 1000.0);
	
		SetVehicleParamsEx(vehicleid, IsABike(vehicleid) ? VEHICLE_PARAM_ON : VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF);
		vehicle_ClearData(vehicleid);
		SetVehicleParam(vehicleid, V_LOCK, 0);
		if(!Iter_Contains(Vehicles, vehicleid))
		{
			Iter_Add(Vehicles, vehicleid);
		}

		#if defined VehiclePlayersStream@YSII_Cg
		#endif

		#if defined PlayerInVehicle@YSII_Cg
		#endif
	}
}
stock vehicle_ClearData(n_veh_vehicleid)
{
	VehicleData[n_veh_vehicleid][V_PLAYERID] = -1;
	vehicle_MusicPlayer_Destroy(n_veh_vehicleid);
	ClearVehicleParams(n_veh_vehicleid);
	SearchVehicle_ModelIndex(n_veh_vehicleid);
}
