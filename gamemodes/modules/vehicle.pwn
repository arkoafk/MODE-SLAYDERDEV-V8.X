stock SearchVehicle_ModelIndex(vehicleid)
{
	new idx = VehicleModelIndexLookup[VehicleData[vehicleid][V_MODELID]];
	Handling_ClearData(vehicleid);
	Handling_VehicleData[vehicleid][E_MODEL_INDEX] = idx;
	return idx;
}
stock vehicle_SearchHandling(vehicleid)
{
	for(new i; i < sizeof(Handling_StaticData); i++)
	{
		if(Handling_VehicleData[vehicleid][E_MODEL_INDEX] == Handling_StaticData[i][E_MODEL_INDEX]) return i;
	}
	return -1;
}
stock UpdateVehicleHadling(vehicleid, playerid = INVALID_PLAYER_ID)
{
	if(Handling_VehicleData[vehicleid][E_MODEL_INDEX] < 0) return 0;
	new
		BitStream:bsn = BS_New();
	BS_WriteValue(bsn, 
			PR_UINT8, 215,
			PR_UINT16, 7,
			PR_UINT32, vehicleid,
			PR_UINT32, Handling_VehicleData[vehicleid][E_MODEL_INDEX]);
	new uid = vehicle_SearchHandling(vehicleid);
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_MASS] + Handling_VehicleData[vehicleid][E_MASS]); //fMass
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_TURNMASS] + Handling_VehicleData[vehicleid][E_TURNMASS]); // fTurnMass
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_DRAGMULT] + Handling_VehicleData[vehicleid][E_DRAGMULT]); // fDragMult
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_CENTRE_OF_MASS][0] + Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][0]); // vecCentreOfMassX
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_CENTRE_OF_MASS][1] + Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][1]); // vecCentreOfMassY
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_CENTRE_OF_MASS][2] + Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][2]); // vecCentreOfMassZ
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_PERCENT_SUBMERGED] + Handling_VehicleData[vehicleid][E_PERCENT_SUBMERGED]); // nPercentSubmerged
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_TRACTION_MULTIPLIER] + Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER]); // fTractionMultiplier
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_DRIVE_TYPE] + Handling_VehicleData[vehicleid][E_DRIVE_TYPE]); // transmissionData_m_nDriveType
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_ENGINE_TYPE] + Handling_VehicleData[vehicleid][E_ENGINE_TYPE]); // transmissionData_m_nEngineType
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_NUMBER_OF_GEARS] + Handling_VehicleData[vehicleid][E_NUMBER_OF_GEARS]); // transmissionData_m_nNumberOfGears
	BS_WriteValue(bsn, PR_UINT32, Handling_StaticData[uid][E_TRANSIMISSION_HANDLING_FLAGS] + Handling_VehicleData[vehicleid][E_TRANSIMISSION_HANDLING_FLAGS]); // transmissionData_m_nHandlingFlags
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_ENGINE_ACCELERATION] + Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION]); // transmissionData_m_fEngineAcceleration
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_ENGINE_INERT] + Handling_VehicleData[vehicleid][E_ENGINE_INERT]); // transmissionData_m_fEngineInertia
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_MAXGEAR_VELOCITY] + Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY]); // transmissionData_m_fMaxGearVelocity
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_BRAKE_DECELERATION] + Handling_VehicleData[vehicleid][E_BRAKE_DECELERATION]); // fBrakeDeceleration
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_BRAKE_BIAS] + Handling_VehicleData[vehicleid][E_BRAKE_BIAS]); // fBrakeBias
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_STEERING_LOCK] + Handling_VehicleData[vehicleid][E_STEERING_LOCK]); // fSteeringLock
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_TRACTION_LOSS] + Handling_VehicleData[vehicleid][E_TRACTION_LOSS]); // fTractionLoss
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_TRACTION_BIAS] + Handling_VehicleData[vehicleid][E_TRACTION_BIAS]); // fTractionBias
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_FORCE_LEVEL] + Handling_VehicleData[vehicleid][E_SUSPENSION_FORCE_LEVEL]); // fSuspensionForceLevel
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_DAMPING_LEVEL] + Handling_VehicleData[vehicleid][E_SUSPENSION_DAMPING_LEVEL]); // fSuspensionDampingLevel
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_HIGH] + Handling_VehicleData[vehicleid][E_SUSPENSION_HIGH]); // fSuspensionHighSpdComDamp
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_UPPER] + Handling_VehicleData[vehicleid][E_SUSPENSION_UPPER]); // fSuspensionUpperLimit
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_LOWER] + Handling_VehicleData[vehicleid][E_SUSPENSION_LOWER]); // fSuspensionLowerLimit
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_BIAS] + Handling_VehicleData[vehicleid][E_SUSPENSION_BIAS]); // fSuspensionBiasBetweenFrontAndRear
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SUSPENSION_ANTI_DRIVE] + Handling_VehicleData[vehicleid][E_SUSPENSION_ANTI_DRIVE]); // fSuspensionAntiDiveMultiplier
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_COLLISION_DAMAGE] + Handling_VehicleData[vehicleid][E_COLLISION_DAMAGE]); // fCollisionDamageMultiplier
	BS_WriteValue(bsn, PR_UINT32, Handling_StaticData[uid][E_MODEL_FLAGS] + Handling_VehicleData[vehicleid][E_MODEL_FLAGS]); // nModelFlags
	BS_WriteValue(bsn, PR_UINT32, Handling_StaticData[uid][E_HANDLING_FLAGS] + Handling_VehicleData[vehicleid][E_HANDLING_FLAGS]); // nHandlingFlags
	BS_WriteValue(bsn, PR_FLOAT, Handling_StaticData[uid][E_SEAT_OFFSET] + Handling_VehicleData[vehicleid][E_SEAT_OFFSET]); // fSeatOffsetDistance
	BS_WriteValue(bsn, PR_UINT32, Handling_StaticData[uid][E_MONETARY_VALUE] + Handling_VehicleData[vehicleid][E_MONETARY_VALUE]); // nMonetaryValue
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_FRONT_LIGHTS] + Handling_VehicleData[vehicleid][E_FRONT_LIGHTS]); // nFrontLights
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_REAR_LIGHTS] + Handling_VehicleData[vehicleid][E_REAR_LIGHTS]); // nRearLights
	BS_WriteValue(bsn, PR_UINT8, Handling_StaticData[uid][E_ANIM_GROUP] + Handling_VehicleData[vehicleid][E_ANIM_GROUP]); // nAnimGroup
	if(playerid == INVALID_PLAYER_ID) 
	{
		foreach(new i: VehiclePlayersStream[vehicleid]) 
		{
			PR_SendPacket(bsn, i);
		}
	}
	else PR_SendPacket(bsn, playerid);
	BS_Delete(bsn);
	return 1;
}
stock Handling_ClearData(vehicleid)
{
    //Handling_VehicleData[vehicleid][E_MODEL_INDEX] = -1;
    Handling_VehicleData[vehicleid][E_MASS] = 0.0;
    Handling_VehicleData[vehicleid][E_TURNMASS] = 0.0;
    Handling_VehicleData[vehicleid][E_DRAGMULT] = 0.0;
