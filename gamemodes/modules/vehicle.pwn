// ---------------------------------------------------
stock SetVehicleParamsInit(vehicleid)
{	
	GetVehicleParamsEx
	(
		vehicleid,
		g_vehicle_params[vehicleid][V_ENGINE],
		g_vehicle_params[vehicleid][V_LIGHTS],
		g_vehicle_params[vehicleid][V_ALARM],
		g_vehicle_params[vehicleid][V_LOCK],
		g_vehicle_params[vehicleid][V_BONNET],
		g_vehicle_params[vehicleid][V_BOOT],
		g_vehicle_params[vehicleid][V_OBJECTIVE]
	);
}

stock GetVehicleParam(vehicleid, E_VEHICLE_PARAMS_STRUCT:paramid)
{
	SetVehicleParamsInit(vehicleid);
	return g_vehicle_params[vehicleid][paramid];
}

stock SetVehicleParam(vehicleid, E_VEHICLE_PARAMS_STRUCT:paramid, set_value)
{
	SetVehicleParamsInit(vehicleid);
	g_vehicle_params[vehicleid][paramid] = bool: set_value;
	//printf("%i", set_value);
	SetVehicleParamsEx
	(
		vehicleid,
		g_vehicle_params[vehicleid][V_ENGINE],
		g_vehicle_params[vehicleid][V_LIGHTS],
		g_vehicle_params[vehicleid][V_ALARM],
		g_vehicle_params[vehicleid][V_LOCK],
		g_vehicle_params[vehicleid][V_BONNET],
		g_vehicle_params[vehicleid][V_BOOT],
		g_vehicle_params[vehicleid][V_OBJECTIVE]
	);
	player_UpdateSpeed(VehicleData[vehicleid][V_DRIVER_ID]);
}

stock CreateVehicleLabel(vehicleid, const text[], color, Float:x, Float:y, Float:z, Float:drawdistance, testlos = 0, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_3D_TEXT_LABEL_SD)
{
	if(IsValidVehicle(vehicleid))
	{
		SetVehicleData(vehicleid, V_LABEL, CreateDynamic3DTextLabel(text, color, x, y, z, drawdistance, INVALID_PLAYER_ID, vehicleid, testlos, worldid, interiorid, playerid, streamdistance));
	}
	return 1;
}

stock UpdateVehicleLabel(vehicleid, color, const text[])
{
	if(IsValidVehicleID(vehicleid))
	{
		if(IsValidDynamic3DTextLabel(GetVehicleData(vehicleid, V_LABEL)))
		{
			UpdateDynamic3DTextLabelText(GetVehicleData(vehicleid, V_LABEL), color, text);
		}
	}
	return 1;
}

stock DestroyVehicleLabel(vehicleid)
{
	if(IsValidVehicleID(vehicleid))
	{
		if(IsValidDynamic3DTextLabel(GetVehicleData(vehicleid, V_LABEL)))
		{
			DestroyDynamic3DTextLabel(GetVehicleData(vehicleid, V_LABEL));
			SetVehicleData(vehicleid, V_LABEL, Text3D: -1);
		}
	}
	return 1;
}
new bool:Helmet[MAX_PLAYERS];
stock ClearVehicleData(vehicleid)
{
	VehicleData[vehicleid][V_PLAYERID] = -1;
	VehicleData[vehicleid][V_MODELID] = 0;
	VehicleData[vehicleid][V_SPAWN_X] = 0.0;
	VehicleData[vehicleid][V_SPAWN_Y] = 0.0;
	VehicleData[vehicleid][V_SPAWN_Z] = 0.0;
	VehicleData[vehicleid][V_SPAWN_ANGLE] = 0.0;
	VehicleData[vehicleid][V_SPAWN_X_LAST] = 0.0;
	VehicleData[vehicleid][V_SPAWN_Y_LAST] = 0.0;
	VehicleData[vehicleid][V_SPAWN_Z_LAST] = 0.0;
	VehicleData[vehicleid][V_SPAWN_ANGLE_LAST] = 0.0;
	VehicleData[vehicleid][V_COLOR_1] = 1;
	VehicleData[vehicleid][V_COLOR_2] = 1;
	VehicleData[vehicleid][V_ADDSIREN] = 0;
	// -------------
	VehicleData[vehicleid][V_ACTION_TYPE] = 0;
	VehicleData[vehicleid][V_ACTION_ID] = 0;
	VehicleData[vehicleid][V_CREATE_ID] = -1;
	// -------------
	VehicleData[vehicleid][V_DRIVER_ID] = INVALID_PLAYER_ID;
	VehicleData[vehicleid][V_doTime] = 0;
	// -------------
	VehicleData[vehicleid][V_LIMIT] = 0;
	VehicleData[vehicleid][V_ALARM] = 0;
	VehicleData[vehicleid][V_FUEL] = 0.0;
	VehicleData[vehicleid][V_MILEAGE] = 0.0;
	VehicleData[vehicleid][V_LABEL] = Text3D:-1;
	VehicleData[vehicleid][V_HEALTH] = 0.0;
	VehicleData[vehicleid][V_LAST_LOAD_TIME] = 0;
	SetString(VehicleData[vehicleid][vNumber_String], "");
	VehicleData[vehicleid][vNumber_Type] = 0;
	VehicleData[vehicleid][vStrob] = false;
	VehicleData[vehicleid][vWash] = 0.0;
	VehicleData[vehicleid][vWear] = 0.0;
	//SetString(VehicleData[vehicleid][vNumber_Region], "");
	ClearTintingParams(vehicleid);
	for(new i; i < 12; i++)
	{
		VehicleData[vehicleid][vTuning][i] = -1;
	}
	return 1;
}
stock ClearTintingParams(vehicleid)
{
	if(!IsValidVehicleID(vehicleid)) return 0;
	for(new i; i < 3; i++)
	{
		VehicleTinted[vehicleid][0][i] = -1;
		VehicleTinted[vehicleid][1][i] = -1;
	}
	return 1;
}
