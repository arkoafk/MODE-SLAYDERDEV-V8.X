#define GetVehicleData(%0,%1)		VehicleData[%0][%1]
#define SetVehicleData(%0,%1,%2)	VehicleData[%0][%1] = %2
#define IsValidVehicleID(%0)		(1 <= %0 < MAX_VEHICLES)

