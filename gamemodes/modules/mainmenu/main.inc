cmd:setrep(playerid, params[]){
	extract params -> new player, rep, info; else return SCM(playerid, -1, !"Используй:/setrep [playerid] [rep] [info/1-4]");
	if(!(1 <= info <= 4)) return SCM(playerid, -1, !"Используй:/setrep [playerid] [rep] [info/1-4]");
	PI[playerid][pRep] = rep;
	PI[playerid][pRepInfo] = info;
	UpdateDataInt("players", "Reputation", PI[player][pRep], PI[player][pID]);
	UpdateDataInt("players", "RepInfo", PI[player][pRepInfo], PI[player][pID]);
	SendAdminsMessagef(0x99999FF, "[A] %s[%i] выдал игроку %s[%i] репутацию с параметрами %i, %i", PN(playerid), playerid, PN(player), player, rep, info);
	SCM(playerid, -1, !"Готово");
	return true;
}