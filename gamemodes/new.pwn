public OnPlayerRequestSpawn(playerid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK);

	if(!IsPlayerLogged(playerid))
	{
		f(str_1, sizeof str_1, "{FFFFFF}Для игры на сервере Вы должны пройти регистрацию");

		SPD(
			playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
			"{FF6600}Ошибка",
			str_1,
			"Закрыть", ""
		);
		Kick(playerid);
	}
	return 0;
}
new bool:player_Connected[MAX_PLAYERS char],
	player_PLoadConnect[MAX_PLAYERS char],
	bool:Restart_Mode;
public OnPlayerConnect(playerid)
{
	if(!Restart_Mode)
	{
		if(player_Connected{playerid} != false)
		{
			SCM(playerid, -1, "Перезайдите в игру #391");
			return 1;
		}
		player_Connected{playerid} = true;
		OnPlayerResetData(playerid);
		SetPlayerVirtualWorld(playerid, 1000+playerid);
		GetPlayerName(playerid, PI[playerid][pNickName], 24);
		GetPlayerName(playerid, PI[playerid][pNickName_Set], 24);
		GetPlayerIp(playerid, PI[playerid][pIP], 17);
		ExecutePacket(playerid, webClose, "QuestsTalks");
		ExecutePacket(playerid, webClose, "Authorization");
		GameTextForPlayerEx(playerid, "~y~Загрузка", 10000, 1);
		TogglePlayerSpectating(playerid, true);
	}
	else
	{
		SCMAll(-11521793, "Администратор инициализировал рестарт сервера. Все аккаунты сохранены.");
		SCMAll(-11521793, "Сервер недоступен...");
	}
	return 1;
}
public: GetPlayerDataMySQL(playerid)
{
	SetPlayerTime(playerid,global_hour,global_minute);
	//ExecutePacket(playerid, webUpdate, "client.setChatStatus(false)");
	//ExecutePacket(playerid, webUpdate, "playSound('sounds/new_year/sound_1.mp3')");
	if(!cache_num_rows()) 
	{
		PI[playerid][pID] = -1;
		if(!IsValidNickName(PN(playerid)))
		{
			SCM(playerid,-10092289, "Имя содержит недопустимые символы или длинна ника привышает 24 символа");
			SCM(playerid,-1, "Используйте латинские буквы a-z A-Z и символ подчеркивания, например: Name_Surname");
			Kick(playerid, "Недоступный никнейм для регистрации");
			return 1;
		}
		//train
		player_TempObject[playerid] = CreatePlayerObject(playerid, 10926, 226.0, 2773.2299804688, 13.39999961853, 0, 0, -90, 300.0);

		register_CreateActor(playerid);
		//camera
		SetPlayerCameraPos(playerid, 225.2203, 2771.0354, 17.9784);
		SetPlayerCameraLookAt(playerid, 225.2203, 2766.5376, 17.9784);
		player_registerCamera[playerid] = CreatePlayerObject(playerid, 10887, 225.80000305176, 2774.1298828125, 13.89999961853, 0, 0, -90, 300.0);
		AttachCameraToPlayerObject(playerid, player_registerCamera[playerid]);
		MovePlayerObject(playerid, player_registerCamera[playerid], 225.80000305176, 2774.1298828125, 13.89999961853, 1.2000000476837, 1.2000000476837);
		MovePlayerObject(playerid, player_TempObject[playerid], 226.0, 2773.2299804688, 13.39999961853, 1.2000000476837, 0, 0, -90);
		//
		ExecutePacket(playerid, webOpen, "Overlay", "[1000, 2300]");
		ExecutePacket(playerid, webOpen, "Authorization", (str_f("[\"register\", [78,135,137,212,213,230,15327,15353,15354,15355,15524,15525], %i, %i, %i, %i, %i]", NUMBER_SERVER, xpayday, typeEvent == 1 ? 1 : 0, typeEvent == 2 ? 1 : 0, typeEvent == 3 ? 1 : 0)));
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setRegistrationStage(1)");
		ExecutePacket(playerid, webUpdate, "playSound('sounds/train/move.mp3', 0, 1)");
	}
	else
	{
		switch(random(6))
		{
			case 0:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://gosopop.com/mp3/Christell - Dubidubidu (Gosopop.com).mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-41)));
			}
			case 1:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://gosopop.com/mp3/Daryana - Juice (Gosopop.com).mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-5)));
			}
			case 2:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://music.radmir.online/audio/Король и Шут - Кукла колдуна.mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-21)));
			}
			case 3:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://music.radmir.online/audio/Макс Корж - Шантаж.mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-28)));
			}
			case 4:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://music.radmir.online/audio/7Б — Молодые ветра.mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-35)));
			}
			case 5:
			{
				ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
					[\"https://music.radmir.online/audio/MORGENSHTERN - Последняя Любовь.mp3\",%i,230,[0.0,0.0,0.0],50000.0,0.10000,[0.0,0.0,0.0]]", global_time-37)));
			}
		}
		SetPlayerVirtualWorld(playerid, 1111);
		cache_get_int(0, "ID", PI[playerid][pID]);
		cache_get_string(0, "Password", PI[playerid][pPassword]);
		cache_get_string(0, "Last_IP", PI[playerid][pLast_IP]);
		cache_get_string(0, "ID_Telegram", PI[playerid][pID_Telegram]);
		cache_get_string(0, "Last_Position", str_1), sscanf(str_1, "p<,>a<f>[4]", PI[playerid][pLast_Position]);
		cache_get_int(0, "Last_LoginTime", PI[playerid][pLast_LoginTime]);
		ExecutePacket(playerid, webOpen, "Authorization", \
				(str_f("[\"auth\", \"%s\", %i, %i, %i, %i, %i, \"https://radmir.online/recovery-password\"]", PN(playerid), NUMBER_SERVER, xpayday, typeEvent == 1 ? 1 : 0, typeEvent == 2 ? 1 : 0, typeEvent == 3 ? 1 : 0)));
		InterpolateCameraPos(playerid, 2977.8777, 2708.2363, 10.8944, 2941.8748, 2716.5952, 10.5185, 90000, CAMERA_CUT);
		InterpolateCameraLookAt(playerid, 2969.5554, 2762.2256, 10.4230, 2969.5554, 2762.2256, 10.4230, 90000, CAMERA_CUT);
	}
	return 1;
}
public: player_CheckPlayerIp(playerid)
{
	if(cache_num_rows() > 0)
	{
		static CountBanIP;
		cache_get_int(0, !"CountBanIP", CountBanIP);
		if(CountBanIP > 0)
		{
			ExecutePacket(playerid, webClose, "Authorization");
			SCMf(playerid, COLOR_RED, "Данный IP заблокирован. (%s)", PI[playerid][pIP]);
			Kick(playerid);
			return 1;
		}
		str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT * FROM `OwnableCars` WHERE `Owner` = '%s' AND `VehicleID` = '-1' AND ((%i-`Last_LoginTime`) < 600) LIMIT 100;", PN(playerid), global_time);
		mysql_tquery(mysql, str_q, "LoadOwnableCar", "i", 1);
	}
	return 1;
}
public: player_CheckPlayerHwid(playerid)
{
	if(cache_num_rows() > 0)
	{
		static CountHash;
		cache_get_int(0, !"CountHash", CountHash);
		if(CountHash > 0)
		{
			SCMf(playerid, COLOR_RED, "Данный HWID адрес заблокирован. (%s|%s)", player_Hardware_SerialID[playerid], player_Hardware_HashID[playerid]);
			Kick(playerid);
			return 1;
		}
		//player_Hardware_SerialID[playerid]
		str_mes[0] = EOS;
		mysql_escape_string(player_Hardware_SerialID[playerid], str_mes);
		UpdatePlayerDataStr(playerid, "Hardware_SerialID", str_mes);

		str_mes[0] = EOS;
		mysql_escape_string(player_Hardware_HashID[playerid], str_mes);
		UpdatePlayerDataStr(playerid, "Hardware_HashID", str_mes);
	}
	return 1;
}
public OnPlayerDisconnect(playerid, reason)
{
	if(!player_Connected{playerid}) return 1;
	player_Connected{playerid} = false;
	Iter_Remove(PlayerPlayersStream[playerid], playerid);
	if(player_UpdateEx[playerid] != -1) KillTimer(player_UpdateEx[playerid]), player_UpdateEx[playerid] = -1;
	if(IsPlayerLogged(playerid))
	{
		DisablePlayerGPS(playerid);
		SavePlayerData(playerid);
		UnLoadOwnableCars(PN(playerid));
//		throns_OnPlayerDisconnect(playerid, reason);
		player_Pursuit_Stop(playerid, 0);
		CasinoDice_PlayerDisconnect(playerid);
		player_TradeItemClose(playerid, "Обмен был прерван ~n~одним из участников");
		player_DutyDefaultJobs_Exit(playerid);
		UpdatePlayerDataInt(playerid, "PlayerID", -1);
		count_disconnect++;
		cmd_uncuff(PI[playerid][pTemp_Escort]);
		if(!GetPlayerVirtualWorld(playerid) && !GetPlayerInterior(playerid))
		{
			GetPlayerPos(playerid, PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2]);
			GetPlayerFacingAngle(playerid, PI[playerid][pLast_Position][3]);
		}
		else
		{
			for(new i; i < 4; i++)
			{
				PI[playerid][pLast_Position][i] = 0.0;
			}
		}
		//
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "Игрок %s вышел с сервера. IP: %s", str_log, PI[playerid][pIP]);
		SendLog(0, str_log);
		//
		mysql_tquery(mysql, (str_f("UPDATE `players` SET `Last_Position` = '%f,%f,%f,%f' WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2], PI[playerid][pLast_Position][3], PI[playerid][pID])));
		UpdatePlayerDataInt(playerid, "Last_LoginTime", global_time);
		//if(GetPlayerCars(playerid) > 0) 
		//{
		//	UpdatePlayerDataInt(playerid, "UnLoadCars_ID", SetTimerEx("off_UnLoadOwnableCars", 120000, false, "s", PN(playerid)));
		//}
		if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
		if(player_UpdateCasino[playerid] != -1) KillTimer(player_UpdateCasino[playerid]), player_UpdateCasino[playerid] = -1;
		if(GetPlayerData(playerid, pTemp_BedID) != -1) ClearMedBed(playerid, GetPlayerData(playerid, pTemp_BedID));
		PI[playerid][pLogged] = false;
		PI[playerid][pID] = -1;
	}
	BlockIpAddress(PI[playerid][pIP], 6000);
	OnPlayerResetData(playerid);
	return 1;
}
public OnPlayerSpawn(playerid)
{
	//SCM(playerid, -1, "onplayerspawn");
	SCMD(playerid, "OnPlayerSpawn");
	if(!IsPlayerLogged(playerid))
	{
		Kick(playerid, "Выход за пределы spawn");
		return 1;
	}
	if(player_Paintball_DeathEx{playerid} > 0) return 1;
	if(!player_Paintball_Death(playerid)) return 1;
	player_FracGarageEntered[playerid] = -1;
	player_HouseEntered[playerid] = -1;
	player_BizEntered[playerid] = -1;
	player_GarageEntered[playerid] = -1;
	player_EntranceEntered[playerid] = -1;
	player_EntranceList[playerid] = -1;
	SetPlayerSkillsInit(playerid);

	player_GetSpawnInfo(playerid, true);
	if(GetPlayerData(playerid, pHospital)) 
	{
		PI[playerid][pHealth] = 15.0;
		SetPlayerHealth(playerid, 15.0);
		SetPlayerVirtualWorld(playerid, 3);
		SetPlayerInterior(playerid, 3);
	}
	SetPlayerSpecialAction(playerid, 0);
	//SetPlayerTeam(playerid, NO_TEAM); //no_team
	return 1;
}
new 
	gangCapture_Type = -1,
	gangCapture_UnixTime,
	gangCapture_StepTime,
	gangCapture_FamilyID = -1,
	gangCapture_HackerID = -1,
	gangCapture_HackerStep;
new player_PaintBall_KillCount[MAX_PLAYERS];
public OnPlayerDeath(playerid, killerid, reason)
{
	//printf("OnPlayerDeath %i", playerid);
	//SCMf(playerid, -1, "%i, %i, %i", playerid, killerid, WEAPON:reason);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "OnPlayerDeath %i-%i", killerid, reason);
	SCMD(playerid, str_mes);
	if(!IsPlayerLogged(playerid)) return 0;
	new bool:police_arrest = true;
	if(gangCapture_HackerID == playerid) player_HackMenu_Hide(playerid);
	cmd_uncuff(PI[playerid][pTemp_Escort]);
	ResetPlayerWeapons(playerid);
	//static Float:x, Float:y, Float:z;
	//GetPlayerPos(playerid, x, y, z);
	//SetPlayerPos(playerid, x, y, z);
	killerid = INVALID_PLAYER_ID;
	reason = 255;
	if(player_GetDamage_TargetID[playerid] != INVALID_PLAYER_ID && player_GetDamage_Tick{playerid} < 30)
	{
		killerid = player_GetDamage_TargetID[playerid];
		if(!IsPlayerLogged(killerid)) killerid = INVALID_PLAYER_ID;
		reason = player_GetDamage_WeaponID{playerid};
		player_GetDamage_Tick{playerid} = 255;
		SendDeathMessage(killerid, playerid, reason);
	}
	else killerid = INVALID_PLAYER_ID;
	//
	if(player_Paintball_ID{playerid} != 255 && killerid != INVALID_PLAYER_ID)
	{
		player_PaintBall_KillCount[killerid]++;
		SCMf(killerid,-831901185, "Вы убили игрока %s[%i], количество ваших очков %i ед", PN(playerid), playerid, player_PaintBall_KillCount[killerid]);
		SetPlayerHealthEx(killerid, 25.0);
		police_arrest = false;
	}
	if(Family_Capture_gzID != -1)
	{
		if(killerid != INVALID_PLAYER_ID)
		{
			if(player_IsFamilyCapture{playerid} != false && player_IsFamilyCapture{killerid} != false && PI[playerid][pFamily_ID] != PI[killerid][pFamily_ID])
			{
				if(IsPlayerInDynamicArea(killerid, Family_Capture_areaID))
				{
					//new id = GetFamilyID(Family_Capture_FamID),
					//	id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);
					//SCMf(playerid, -1, "%i, %i, %i, %i", Family_Capture_FamID, PI[playerid][pFamily_ID], BizData[Family_Capture_BizID][bGangRoof_ID], PI[killerid][pFamily_ID]);
					if(Family_Capture_FamID == PI[playerid][pFamily_ID]) 
					{
						Family_Capture_BizKill++;
					}
					else if(BizData[Family_Capture_BizID][bGangRoof_ID] == PI[playerid][pFamily_ID]) 
					{
						Family_Capture_FamKill++;
					}
				}
			}
		}
	}
	cmd_uncuff(PI[playerid][pTemp_Escort]);
	if(GetPlayerData(playerid, pTemp_BedID) != -1)
	{
		ClearMedBed(playerid, GetPlayerData(playerid, pTemp_BedID));
	}
	if(killerid != INVALID_PLAYER_ID && police_arrest == true)
	{
		if(PI[killerid][pMember_ID] != 2 && !PI[killerid][pMember_Duty])
		{
			SetPlayerSuspectLevel(killerid, 1);
			if(PI[killerid][pMember_ID] != 2)
			{
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "[Всем постам] %s[%i] совершил убийство | [нет данных], Арзамас. Подробнее в полицейском планшете", PN(killerid), killerid);
				SendTeamMessage(2, 13434879, str_mes);
			}
			else if(PI[killerid][pMember_ID] == 2)
			{
				if(PI[playerid][pLevel_Suspect] > 0 && PI[killerid][pMember_Duty] != false)
				{
					str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "[Всем постам] %s %s нейтрализовал преступника %s", FractionRName[PI[killerid][pMember_ID]][PI[killerid][pMember_Rang]], PN(killerid), PN(playerid));
					SendTeamMessage(2, 13434879, str_mes);
					player_Arrest_Wait(killerid, playerid);
				}
			}
		}
	}
	if(!player_Paintball_Death(playerid)) return 1;
	player_Container_Close(playerid);
	player_LoadAks{playerid} = 3;
	PI[playerid][pHospital] = true;
	player_DeathMenu_Close(playerid);
	SetPlayerSpecialAction(playerid, 0);
	RefreshInvWeapon(playerid);
	PI[playerid][pHealth] = 15.0;
	PI[playerid][pArmour] = 0.0;
	SetPlayerHealth(playerid, PI[playerid][pHealth]);
	SetPlayerArmour(playerid, PI[playerid][pArmour]);
	player_GetDamage_TargetID[playerid] = INVALID_PLAYER_ID;
	return 1;
}
public OnVehicleSpawn(vehicleid)
{
	IsCheckRentVehicle(vehicleid);

	new number = UpdateCarData(vehicleid);
	if(number != INVALID_VEHICLE_ID)
	{
		SetVehiclePos(vehicleid, CarData[number][cPos][0], CarData[number][cPos][1], CarData[number][cPos][2]);
		SetVehicleZAngle(vehicleid, CarData[number][cPos][3]);
		LinkVehicleToInterior(vehicleid, CarData[number][cInterior]);
		SetVehicleVirtualWorld(vehicleid, CarData[number][cVirtualWorld]);
	}
	else
	{
		new bool:break_search;
		for(new i; i < sizeof(fractionCarData); i++)
		{
			if(team_CarData[i] == vehicleid)
			{
				SetVehiclePos(vehicleid, fractionCarData[i][fcX], fractionCarData[i][fcY], fractionCarData[i][fcZ]);
				SetVehicleZAngle(vehicleid, fractionCarData[i][fcA]);
				LinkVehicleToInterior(vehicleid, fractionCarData[i][fcInterior]);
				SetVehicleVirtualWorld(vehicleid, fractionCarData[i][fcWorld]);
				break_search = true;
				break;
			}
		}
		if(!break_search)
		{
			for(new i; i < sizeof(mafiaCarData); i++)
			{
				if(mafia_CarData[i] == vehicleid)
				{
					SetVehiclePos(vehicleid, mafiaCarData[i][fcX], mafiaCarData[i][fcY], mafiaCarData[i][fcZ]);
					SetVehicleZAngle(vehicleid, mafiaCarData[i][fcA]);
					LinkVehicleToInterior(vehicleid, mafiaCarData[i][fcInterior]);
					SetVehicleVirtualWorld(vehicleid, mafiaCarData[i][fcWorld]);
					break_search = true;
					break;
				}
			}
		}
		if(!break_search)
		{
			for(new i; i < sizeof(CarriersCarData); i++)
			{
				if(Carriers_CarData[i] == vehicleid)
				{
					if(Carriers_CarTrailer[i] != -1)
					{
						new next = Carriers_CarTrailer[i];
						DestroyVehicle(Carriers_CarTrailer[i], next, "fasts");
						Carriers_CarTrailer[i] = -1;
					}
					SetVehiclePos(vehicleid, CarriersCarData[i][fcX], CarriersCarData[i][fcY], CarriersCarData[i][fcZ]);
					SetVehicleZAngle(vehicleid, CarriersCarData[i][fcA]);
					LinkVehicleToInterior(vehicleid, CarriersCarData[i][fcInterior]);
					SetVehicleVirtualWorld(vehicleid, CarriersCarData[i][fcWorld]);

					Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] = 0.0;
					Handling_VehicleData[vehicleid][E_ENGINE_INERT] = 0.0;
					Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = 0.0;

					break_search = true;
					break;
				}
			}
		}
	}
	SetVehicleData(vehicleid, V_DRIVER_ID, INVALID_PLAYER_ID);

	SetVehicleData(vehicleid, V_LIMIT, true);
	SetVehicleParamsEx(vehicleid, IsABike(vehicleid) ? VEHICLE_PARAM_ON : VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF, VEHICLE_PARAM_OFF);
	return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
	foreach(new playerid: PlayerInVehicle[vehicleid])
	{
		if(GetPlayerVehicleID(playerid) == vehicleid)
		{
			new Float:x, Float:y, Float:z;
			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z+2);
		}
	}
	SetVehicleHealth(vehicleid, 1000.0);
	OnVehicleSpawn(vehicleid);
	IsCheckRentVehicle(vehicleid);
	return 1;
}
public OnPlayerText(playerid, text_unsafe[])
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);
	if(!IsPlayerLogged(playerid)) return 0;
	if(strlen(text_unsafe) > 80 || strlen(text_unsafe) < 1) return 0;
	static text_safe[80];
	text_safe[0] = EOS;
	if(strlen(text_unsafe)) mysql_escape_string(text_unsafe, text_safe);
	if(GetPlayerData(playerid, pMuteTime))
	{
		SCM(playerid, 0xFF6600FF, !"Вы не можете использовать чат во время мута");

		SetPlayerChatBubble(playerid, "(( MUTED ))", -11521793, 10.5, 2000);

		return 0;
	}

	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SCM(playerid, 0x6B6B6BFF, "Не флудите");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SCM(playerid, 0x6B6B6BFF, "Пожалуйста, подождите несколько секунд...");

		return 0;
	}
	if(!strcmp(text_safe, "(", true))
	{
		Action(playerid, "расстроился", _, false);
	}
	else if(!strcmp(text_safe, "((", true))
	{
		if(!IsPlayerInAnyVehicle(playerid))
			ApplyAnimation(playerid, "GRAVEYARD", "mrnF_loop", 4.1, false, 0, 0, 0, 0, 0);

		Action(playerid, "сильно расстроился", _, false);
	}
	else if(!strcmp(text_safe, ")", true))
	{
		Action(playerid, "улыбается", _, false);
	}
	else if(!strcmp(text_safe, "))", true))
	{
		Action(playerid, "смеётся", _, false);
	}
	else if(!strcmp(text_safe, "=0", true))
	{
		Action(playerid, "удивился", _, false);
	}
	else SendMessageInChat(playerid, text_safe);

	return 0;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
	return 0;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	player_GetTickCount_Car[playerid] = GetTickCount();
	if(CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC, FLOOD_RATE_KICK))
	{
		SCM(playerid, 0x6B6B6BFF, "При продолжении Вы будете отключены от сервера");

		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500)
			SCM(playerid, 0x6B6B6BFF, "Пожалуйста, подождите несколько секунд...");
		return 0;
	}
	if(!ispassenger)
	{
		if(!IsPlayerFractionVehicleUsed(playerid, vehicleid))
		{
			RemovePlayerFromVehicle(playerid);
			SCM(playerid, 0xCECECEFF, "Вам недоступен данный транспорт");
			return 1;
		}
		if(!IsPlayerMafiaVehicleUsed(playerid, vehicleid))
		{
			RemovePlayerFromVehicle(playerid);
			SCM(playerid, 0xCECECEFF, "Вам недоступен данный транспорт");
			return 1;
		}
		if(VehicleData[vehicleid][V_MODELID] == 15644)
		{
			if(player_TempVehicleID[playerid] != vehicleid)
			{
				player_UpdateAcs(playerid, playerid, -1);
				player_DestroyVehicle(playerid);
				new Float:x, Float:y, Float:z;
				GetPlayerPos(playerid, x, y, z);
				SetPlayerPos(playerid, x, y, z+0.001);
			}
		}
		if(GetPlayerData(playerid, pLicense_Driving) < 1)
		{
			if(!IsABike(vehicleid))
			{
				ClearAnimations(playerid);
				return SCM(playerid, 0x999999FF, !"У Вас нет прав");
			}
		}

		if(GetPlayerData(playerid, pTemp_Cuffed))
		{
			ClearAnimations(playerid);

			static Float: x, Float: y, Float: z;
			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z);

			return SCM(playerid, 0x999999FF, !"Вы закованы в наручники");
		}

		if(IsPlayerInVehicle(GetVehicleData(vehicleid, V_DRIVER_ID), vehicleid) && GetPlayerState(GetVehicleData(vehicleid, V_DRIVER_ID)) == PLAYER_STATE_DRIVER)
		{
			ClearAnimations(playerid);

			static Float: x, Float: y, Float: z;
			GetPlayerPos(playerid, x, y, z);
			SetPlayerPos(playerid, x, y, z);
			return GameTextForPlayerEx(playerid, "~r~Транспорт используется", 1000, 2);
		}
	}
	return 1;
}
stock IsPlayerFractionVehicleUsed(playerid, vehicleid)
{
	if(!IsValidVehicle(vehicleid)) return -1;
	if(VehicleData[vehicleid][V_ACTION_TYPE] == 2)
	{
		if(VehicleData[vehicleid][V_ACTION_ID] == PI[playerid][pMember_ID])
		{
			new uid = fraction_SearchFCarsUID(vehicleid);
			if(uid != -1)
			{
				if(!(PI[playerid][pMember_Rang] < team_CarRang[uid]))
				{
					return 1;
				}
				SCMf(playerid, 0xCECECEFF, "Этот транспорт доступен с %i ранга", team_CarRang[uid]);
				return -2;
			}
		}
		return 0;
	}
	return -1;
}
stock fraction_SearchFCarsUID(vehicleid)
{
	for(new i; i < sizeof(fractionCarData); i++)
	{
		if(team_CarData[i] == vehicleid) return i;
	}
	return -1;
}
stock IsPlayerMafiaVehicleUsed(playerid, vehicleid)
{
	if(!IsValidVehicle(vehicleid)) return -1;
	if(VehicleData[vehicleid][V_ACTION_TYPE] == 3)
	{
		if(VehicleData[vehicleid][V_ACTION_ID] == GetFamilyID(PI[playerid][pFamily_ID]))
		{
			return 1;
		}
		return 0;
	}
	return -1;
}
public OnPlayerExitVehicle(playerid, vehicleid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	//str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "OnPlayerStateChange %i-%i", newstate, oldstate);
	//SCMD(playerid, str_mes);
	opat_OnPlayerStateChange(playerid, newstate, oldstate);
	if(newstate == 7 && (oldstate == 2 || oldstate == 3))
	{
		SetPlayerPos(playerid, 0, 0, 0);
		PI[playerid][pHospital] = true;
		player_Spawn(playerid);
	}
	if(!IsPlayerLogged(playerid)) return 1;
	if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);

		if(vehicleid > 0) OnPlayerEnterVehicleEx(playerid, vehicleid, !(newstate % 2));
	}
	else if(oldstate == PLAYER_STATE_DRIVER || oldstate == PLAYER_STATE_PASSENGER)
	{
		new vehicleid = player_LastVehicleID[playerid];

		if(vehicleid != INVALID_VEHICLE_ID) OnPlayerExitVehicleEx(playerid, vehicleid, !(oldstate % 2));
	}
	return 1;
}
stock player_Pilot_GetNextPoint(playerid)
{
	new id = player_DefaultJob_Progress[playerid][0];
	DisablePlayerRaceCheckpoint(playerid);
	if(player_DefaultJob_Type{playerid} == 0)
	{
		//"playSound('sounds/pilot/landing_rus.wav')"
		if(id == 4)
		{
			ExecutePacket(playerid, webUpdate, "playSound('sounds/pilot/landing_rus.wav')");
		}
		else if(id == 22)
		{
			ExecutePacket(playerid, webUpdate, "playSound('sounds/pilot/takeoff.mp3')");
		}
		if(id >= sizeof(PilotData_0))
		{
			player_Pilot_Select(playerid, 1);
			return 1;
		}
		else SetPlayerRaceCheckpoint(playerid, 3, PilotData_0[id][pdPos][0], PilotData_0[id][pdPos][1], PilotData_0[id][pdPos][2], PilotData_0[id][pdPosNext][0], PilotData_0[id][pdPosNext][1], PilotData_0[id][pdPosNext][2], PilotData_0[id][pdSize]);
	}
	else
	{
		if(id == 7)
		{
			ExecutePacket(playerid, webUpdate, "playSound('sounds/pilot/landing_rus.wav')");
		}
		else if(id == 22)
		{
			ExecutePacket(playerid, webUpdate, "playSound('sounds/pilot/takeoff.mp3')");
		}
		if(id >= sizeof(PilotData_1))
		{
			player_Pilot_Select(playerid, 0);
			return 1;
		}
		else SetPlayerRaceCheckpoint(playerid, 3, PilotData_1[id][pdPos][0], PilotData_1[id][pdPos][1], PilotData_1[id][pdPos][2], PilotData_1[id][pdPosNext][0], PilotData_1[id][pdPosNext][1], PilotData_1[id][pdPosNext][2], PilotData_1[id][pdSize]);
	}
	player_DefaultJob_Progress[playerid][0]++;
	return 1;
}
stock player_Pilot_Select(playerid, type)
{
	GameTextForPlayerEx(playerid, "~g~Высадка", 20000, 1);
	SCM(playerid,-1412567126, "Подождите пока закончится высадка пассажиров.");
	player_DefaultJob_Progress[playerid][0] = -2;
	TogglePlayerControllable(playerid, false);
	player_DefaultJob_Type{playerid} = type;
	SetTimerEx("player_UnFreeze", 20000, false, "i", playerid);
}
stock player_Machinist_GetNextPoint(playerid)
{
	player_DefaultJob_Progress[playerid][0]++;
	new id = player_DefaultJob_Progress[playerid][0];
	if(player_DefaultJob_Progress[playerid][0] >= sizeof(MachinistData)) 
	{
		id = 0;
		player_DefaultJob_Progress[playerid][0] = 0;
	}
	if(id > 0)
	{
		if(!(id+1 >= sizeof(MachinistData)))
		{
			if(strlen(MachinistData[id+1][mdName]) > 3) //triazov
			{
				GameTextForPlayerEx(playerid, "Снижайте скорость~n~Рядом станция", 10000, 1);
			}
		}
		if(strlen(MachinistData[id-1][mdName]) > 3) 
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid > 0)
			{
				if(GetVehicleSpeed(vehicleid) < 40)
				{
					PI[playerid][pTemp_Wage] += 1800000+random(300000);
					ExecutePacket(playerid, webUpdate, (str_f("interface('Machinist').setMoney(%i)", PI[playerid][pTemp_Wage])));
				}
				else
				{
					SCM(playerid, COLOR_LIGHTRED, "Вы проехали станцию!");
					//if(GetStrMoney(playerid) > 400000)
					if(CompareInt64(playerid, "<", 400000))
					{
						
					}
					else
					{
						GivePlayerMoneyEx(playerid, -400000, "проехали станцию");
					}
				}
				player_DefaultJob_CPoint{playerid} = 255;
			}
		}
	}
	DisablePlayerRaceCheckpoint(playerid);
	SetPlayerRaceCheckpoint(playerid, (strlen(MachinistData[id][mdName]) > 3 ? 1 : 2), MachinistData[id][mdPosition][0], MachinistData[id][mdPosition][1], MachinistData[id][mdPosition][2], 0.0, 0.0, 0.0, (strlen(MachinistData[id][mdName]) > 3 ? 5.0 : 2.0));
	new idex = player_DefaultJob_CPoint{playerid};
	if(idex != 255) ExecutePacket(playerid, webUpdate, (str_f("interface('Machinist').setStation('[\"%s\", %i, 1]')", MachinistData[idex][mdName], floatround(GetPlayerDistanceFromPoint(playerid, MachinistData[idex][mdPosition][0], MachinistData[idex][mdPosition][1], MachinistData[idex][mdPosition][2])))));
	return 1;
}
stock player_Machinist_Update(playerid)
{
	if(player_DefaultJob_CPoint{playerid} == 255)
	{
		new id = 3;
		for(new i; i < sizeof(MachinistData); i++)
		{
			if(strlen(MachinistData[i][mdName]) > 3 && player_DefaultJob_Progress[playerid][0] < i)
			{
				id = i;
				break;
			}
		}
		player_DefaultJob_CPoint{playerid} = id;
	}
	new id = player_DefaultJob_CPoint{playerid};
	ExecutePacket(playerid, webUpdate, (str_f("interface('Machinist').setStation('[\"%s\", %i, 1]')", MachinistData[id][mdName], floatround(GetPlayerDistanceFromPoint(playerid, MachinistData[id][mdPosition][0], MachinistData[id][mdPosition][1], MachinistData[id][mdPosition][2])))));
	return 1;
}
public: OnPlayerEnterVehicleEx(playerid, vehicleid, is_driver)
{
	//SCMf(playerid, -1, "%i %i %i %i", VehicleData[vehicleid][V_MODELID], player_DefaultJob_ID[playerid], player_TempVehicleID[playerid], vehicleid);
	if(Iter_Contains(vehicle_MusicPlayer, vehicleid))
	{
		if(vehicle_MusicPlayer_AreaID[vehicleid] != -1)
		{
			vehicle_MusicPlayer_Play(vehicleid, playerid);
		}
	}
	if(VehicleData[vehicleid][V_MODELID] == 538)
	{
		if(player_TempVehicleID[playerid] != vehicleid)
		{
			RemovePlayerFromVehicle(playerid);
			return 0;
		}
		else if(player_DefaultJob_ID[playerid] == 2)
		{
			player_DefaultJob_Timer{playerid} = 0;
			player_DefaultJob_Progress[playerid][0] = -1;
			ExecutePacket(playerid, webOpen, "Machinist", "[[1, 1, 1, 1], [\"100-120\", 0], [\"Южный\", 1032, 1], 0]");
			player_Machinist_GetNextPoint(playerid);
		}
	}
	VehicleData[vehicleid][V_doTime] = 0;
	player_LastVehicleID[playerid] = vehicleid;
	if(player_HundredEntered[playerid] != -1)
	{
		ExecutePacket(playerid, webOpen, "Interactions", "[[50,\"Выехать из гаража\"]]");
	}
	if(GetPlayerData(playerid, pTemp_Cuffed))
	{
		ClearAnimations(playerid);

		static Float: x, Float: y, Float: z;
		GetPlayerPos(playerid, x, y, z);
		SetPlayerPos(playerid, x, y, z);

		return SCM(playerid, 0x999999FF, !"Вы закованы в наручники");
	}
	new vehicle_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
	if(is_driver)
	{
		SetVehicleData(vehicleid, V_DRIVER_ID, playerid);
		if(!GetVehicleParam(vehicleid, V_LOCK))
		{
			if(GetPlayerData(playerid, pLicense_Driving) > 0)
			{
				player_ShowSpeed(playerid, vehicleid);
				new number = GetVehicleID(vehicleid);
				if(number != INVALID_VEHICLE_ID)
				{
					if(CarData[number][cOwner_Type] == 2)
					{
						if(CarData[number][cFamily_ID] != PI[playerid][pFamily_ID])
						{
							new id = GetFamilyID(CarData[number][cFamily_ID]);
							if(id >= 0)
							{
								SCMf(playerid, 0xCECECEFF, "Данный транспорт принадлежит банде %s", FamilyData[id][fName]);
								RemovePlayerFromVehicle(playerid);
								return 1;
							}
						}
					}
					else if(GetString(CarData[number][cOwner], "The State"))
					{
						foreach(new i: PlayerPlayersStream[playerid])
						{
							SCMf(i, COLOR_RED, "Игрок %s[%i] смог урвать с розыгрыша модель %i, за %i мс.", PN(playerid), playerid, CarData[number][cModel], GetTickCount() - player_GetTickCount_Car[playerid]);
						}
						SCM(playerid, COLOR_GREEN, !"Теперь это ваша личная машина!");
						ChangeCarOwner(number, PN(playerid));
						UpdateCarData(vehicleid);
					}
				}
				switch(vehicle_type)
				{
					case 1:
					{
						if(player_RentVehicle_ID[playerid] != vehicleid)
						{
							RemovePlayerFromVehicle(playerid);
							return SCM(playerid, 0xCECECEFF, "Транспорт принадлежит другому игроку");
						}
						else SCMf(playerid, 0xE4BC43FF, "Срок аренды скутера истекает через {E4E4E4}%i мин{E4BC43}.", floatround(player_RentVehicle_Timeout[playerid] / 60));
					}
					case 2:
					{
						new type = IsPlayerFractionVehicleUsed(playerid, vehicleid);
						if(type == 1)
						{
							if(GetVehicleVirtualWorld(vehicleid) > 0)
							{
								SPD(playerid, 20463, 0, "{FFCD00}Парковка", "Вы действительно хотите выехать с парковки на данном транспорте?", "Да","Отмена");
							}
						}
						else if(type == -2)
						{

						}
						else
						{
							RemovePlayerFromVehicle(playerid);
							SCM(playerid, 0xCECECEFF, "Вам недоступен данный транспорт");
						}
					}
					case 3:
					{
						if(!IsPlayerMafiaVehicleUsed(playerid, vehicleid))
						{
							RemovePlayerFromVehicle(playerid);
							SCM(playerid, 0xCECECEFF, "Вам недоступен данный транспорт");
							return 1;
						}
					}
					case 4:
					{
						new id = player_SearchJobID(playerid, 0);
						if(id != -1)
						{
							new i = PI[playerid][pJob_BizID][id];
							if(i != -1)
							{
								if(i == VehicleData[vehicleid][V_ACTION_ID])
								{
									new carid = PI[playerid][pTemp_JobCarID][id];
									//SCMf(playerid, -1, "%i/%i", carid, vehicleid);
									if(carid != vehicleid && carid != -1)
									{
										//if(VehicleData[carid][V_ACTION_TYPE] == 4) OnVehicleSpawn(carid);
										SCM(playerid,-1717986817, "За Вами уже закреплён рабочий транспорт. Чтобы взять новый, сдайте свой нынешний");
										RemovePlayerFromVehicle(playerid);
										return 1;
									}
									else if(carid == vehicleid)
									{
										if(player_ReturnTimer[playerid][id]-global_time > 0)
										{
											player_ReturnTimer[playerid][id] = -1;
											ExecutePacket(playerid, webClose, "InformationTimer");
											return 1;
										}
									}
									SPD(playerid, 20479, 0, "{FFCD00}Работа в транспортной компании", "{FFFFFF}Вы действительно хотите начать свой рабочий день?<n><n>В качестве залога с Вас снимут {ffe36c}20000000 руб.{ffffff} Если Вы не получите штрафов, то деньги будут возвращены.", "Начать","Отмена");
									return 1;
								}
							}
						}	
						SCM(playerid,-825307393, "* Вы не работаете дальнобойщиком в этой транспортной компании");
						RemovePlayerFromVehicle(playerid);
					}
				}
			}
			else
			{
				if(!IsABike(vehicleid))
				{
					RemovePlayerFromVehicle(playerid);
					SCM(playerid, 0x999999FF, !"У Вас нет прав");
				}
			}
		}
		else if(VehicleData[vehicleid][V_PLAYERID] != playerid) RemovePlayerFromVehicle(playerid);
	}
	return 1;
}

public: OnPlayerExitVehicleEx(playerid, vehicleid, is_driver)
{
	if(vehicleid == -1) return 0;
	VehicleData[vehicleid][V_doTime] = 0;
	if(player_HundredEntered[playerid] != -1) player_Interaction_Hide(playerid);
	if(Iter_Contains(vehicle_MusicPlayer, vehicleid))
	{
		if(vehicle_MusicPlayer_AreaID[vehicleid] != -1)
		{
			vehicle_MusicPlayer_Play(vehicleid, playerid);
		}
	}
	if(is_driver)
	{
		if(VehicleData[vehicleid][V_MODELID] == 15644)
		{
			if(player_TempVehicleID[playerid] == vehicleid)
			{
				player_UpdateAcs(playerid, playerid, -1);
				player_DestroyVehicle(playerid);
			}
		}
		if(VehicleData[vehicleid][V_PLAYERID] == playerid)
		{
			if(player_DefaultJob_ID[playerid] == 3)
			{
				player_Pilot_Exit(playerid);
			}
		}
		new vehicle_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
		switch(vehicle_type)
		{
			case 4:
			{
				new id = player_SearchJobID(playerid, 0);
				if(id != -1)
				{
					new i = PI[playerid][pJob_BizID][id];
					if(i != -1)
					{
						if(i == VehicleData[vehicleid][V_ACTION_ID])
						{
							if(vehicleid == PI[playerid][pTemp_JobCarID][id]) 
							{
								player_ReturnTimer[playerid][id] = global_time+120;
								ExecutePacket(playerid, webOpen, "InformationTimer", (str_f("[\"Вернуться в транспорт\",%i]", player_ReturnTimer[playerid][id])));
								//SCMf(playerid, -1, "%s", (str_f("[\"Вернуться в транспорт\",%i]", player_ReturnTimer[playerid][id])));
								SCM(playerid,-10092289, "У Вас есть 2 минуты чтобы вернуться в транспорт, иначе он пропадёт");
							}
						}
					}
				}
			}
		}
		SetVehicleData(vehicleid, V_DRIVER_ID, INVALID_PLAYER_ID);
		player_HideSpeed(playerid);
	}
	else
	{
		if(GetPlayerData(playerid, pTemp_Cuffed)) TogglePlayerControllable(playerid, true);
	}
	return 1;
}

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	if(!IsPlayerLogged(playerid)) return 0;
    return 1;
}

public OnPlayerEnterCheckpoint(playerid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	//DisablePlayerCheckpoint(playerid);
	if(!IsPlayerLogged(playerid)) return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	if(player_TempVehicleID[playerid] != vehicleid && player_DefaultJob_ID[playerid] == 2)
	{
		PutPlayerInVehicle(playerid, player_TempVehicleID[playerid], 0);
	}
	return 1;
}

public OnPlayerLeaveCheckpoint(playerid)
{
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, 500, FLOOD_RATE_KICK);
	if(!IsPlayerLogged(playerid)) return 1;
	//DisablePlayerRaceCheckpoint(playerid);
	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid > 0)
	{
		if(IsPlayerCarriersRaceCP{playerid} != false)
		{
			if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) > 0 || VehicleData[vehicleid][V_MODELID] == 15097)
			{
				if(player_Carriers_Products[playerid] < 10)
				{
					SCM(playerid,-1717986817, "Вы привезли слишком мало топлива. Вернитесь на точку, и загрузите побольше (/gps)");
					return 1;
				}
				IsPlayerCarriersRaceCP{playerid} = false;
				DisablePlayerRaceCheckpoint(playerid);

				new time = player_Carriers_Products[playerid]/200;
				SCMf(playerid,-1, "Разгрузка товара началась, примерное время: {b3ee7b}%i сек{ffffff}, не покидайте свой транспорт", time);
				TogglePlayerControllable(playerid, false);
				SetTimerEx("player_Carriers_UnLoadBiz", time*1000, false, "i", playerid);
			}
			else SCM(playerid,-1717986817, "Ваш прицеп должен быть прикреплён к рабочему транспорту");
		}
		else if(VehicleData[vehicleid][V_MODELID] == 538)
		{
			if(player_TempVehicleID[playerid] == vehicleid && player_DefaultJob_ID[playerid] == 2)
			{
				//SCMf(playerid, -1, "4 %i %i, %i", player_TempVehicleID[playerid], vehicleid, player_DefaultJob_ID[playerid]);
				player_Machinist_GetNextPoint(playerid);
			}
		}
		else if(VehicleData[vehicleid][V_MODELID] == 577)
		{
			if(player_TempVehicleID[playerid] == vehicleid && player_DefaultJob_ID[playerid] == 3)
			{
				//SCMf(playerid, -1, "4 %i %i, %i", player_TempVehicleID[playerid], vehicleid, player_DefaultJob_ID[playerid]);
				player_Pilot_GetNextPoint(playerid);
			}
		}
	}
	//new action_type = GetPlayerRaceCPInfo(playerid, RCP_ACTION_TYPE);
	//new vehicleid = GetPlayerVehicleID(playerid);
	return 1;
}

