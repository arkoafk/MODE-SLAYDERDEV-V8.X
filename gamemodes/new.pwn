				else SCMf(playerid, 0xCECECEFF, "Этот дом уже куплен. Владелец: %s", HouseData[id][hOwner]);
			}
		}
		case 23245:
		{
			if(!response) return 1;
			new id = player_EnterTrash[playerid];
			if(Iter_Contains(TrashData, id))
			{
				if(InventoryTrash[0][id] == 0)
				{
					GivePlayerMoneyEx(playerid, InventoryTrash[1][id], "trash");
				}
				else if(!InvAdd(playerid, InventoryTrash[0][id], InventoryTrash[1][id], "", InventoryTrash[2][id], InventoryTrash[3][id], InventoryTrashString[id], "Поднял с земли"))
				{
					return 1;
				}
				player_EnterTrash[playerid] = -1;
				OnPlayerInventory_WeaponSet(playerid, InventoryTrash[0][id]);
				SafeDestroyTrash(id);
				Iter_Remove(TrashData, id);
			}
		}
		case 914:
		{
			if(!response) return 1;
			listitem = player_ShowID[playerid][22];
			new bizid = player_BizEntered[playerid];
			if(bizid != -1)
			{
				new price = global_GetShopPrice(ShopStaticData[listitem][shopName])*BizData[bizid][bProductEx];
				if(GiveBusinessMoney(playerid, bizid, price, -20) == -1) return SCM(playerid, 0xed9121FF, !"В бизнесе закончились продукты!");
				
				if(CompareInt64(playerid, "<", price)) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2), SCM(playerid, 0xCECECEFF, !"На счету недостаточно средств");
				//if(player_Cash[playerid] < price) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2), SCM(playerid, 0xCECECEFF, !"На счету недостаточно средств");
				GivePlayerMoneyEx(playerid, -price, (str_f("Магазин №%i", bizid)));
				SCMf(playerid,0xed9121FF,"Вы купили \"%s\" за %i руб.", ShopStaticData[listitem][shopName], price);
				switch(ShopStaticData[listitem][shopType])
				{
					case 13, 9, 19, 28:
					{
						f(str_mes, sizeof(str_mes), "%s купил(а) %s", PN(playerid), ShopStaticData[listitem][shopName]);
						player_PickAdapt(playerid, str_mes);
					}
					default:
					{
						InvAdd(playerid, ShopStaticData[listitem][shopItemUID], 1, "", 0, 0, "", "Магазин");
					}
				}
			}
		}
		case 913:
		{
			if(!response) return 1;
			new bizid = player_BizEntered[playerid];
			if(bizid != -1)
			{
				new id = player_ShowData[playerid][listitem];
				if(id != -1)
				{
					player_ShowID[playerid][22] = id;
					if(ShopStaticData[id][shopName])
					{
						if(ShopStaticData[id][shopItemUID] == 41)
						{
							player_ItemStore_Open(playerid);
							return 1;
						}
					}
					str_1[0] = EOS, f(str_1, sizeof(str_1),"{FFFFFF}Вы подтверждаете покупку данного товара? \n\n\t\
															{FFFFFF}Товар: {E0B543}%s\n\t\
															{FFFFFF}Стоимость: {E09043}%i руб", \
																ShopStaticData[id][shopName],\
																global_GetShopPrice(ShopStaticData[id][shopName])*BizData[bizid][bProductEx]);
					SPD(playerid, 914, DIALOG_STYLE_MSGBOX, "Подтверждение", str_1, "Купить","Отмена");
				}
				else SCM(playerid, -1, "error 230123123");
			}
			else if(player_EnterBiz[playerid] != -1)
			{
				bizid = player_EnterBiz[playerid];
				if(BizStaticData[BizData[bizid][bType]][bsType] == 1) //АЗС
				{
					listitem++;
					new price = (global_GetShopPrice(fuelTypeName[listitem])*BizData[bizid][bProductEx])*15;
					player_ShowData[playerid][99] = price;
					SPD(playerid, 916, 0, "Покупка канистры", (str_f("\
						Вы выбрали тип топлива %s. Стоимость канистры %i руб.\n\
						Желаете приобрести канистру?", fuelTypeName[listitem], price)), "Да","Нет");
				}
			}
		}
		case 916:
		{
			if(!response || player_Canister{playerid} != false) return 1;
			new price = player_ShowData[playerid][99];
			if(CompareInt64(playerid, "<", price)) return SCM(playerid, 1973670570, "У вас недостаточно средств.");
			//if(GetStrMoney(playerid) < price) return SCM(playerid, 1973670570, "У вас недостаточно средств.");
			GivePlayerMoneyEx(playerid, -price, "Заправка(Канистра)");
			SetPlayerAttachedObject(playerid, 3, 1650, 5, 0.15000000596046, 0, 0, 0, -90, 180, 1, 1, 1);
			SCM(playerid,-4301654, "Вы купили канистру с 15 литрами бензина.");
			SCM(playerid,1973670570, "Подойдите к транспортному средству и используйте меню взаимодействия.");
			player_Canister{playerid} = true;
			ExecutePacket(playerid, webOpen, "Interactions", "[[8,\"Заправить из канистры\"]]");
		}
		case 912:
		{
			if(!response) return 1;
			new vehicleid = GetNearestVehicleID(playerid, 5.0);
			if(vehicleid != INVALID_VEHICLE_ID)
			{
				player_Canister{playerid} = false;
				player_Interaction_Hide(playerid);
				VehicleData[vehicleid][V_FUEL] += 15.0;
				UpdateCarData_Sync(GetVehicleID(vehicleid), true);
				player_UpdateAcs(playerid, playerid, 3, true);
				ApplyAnimation(playerid, "CRIB", "CRIB_Use_Switch", 4, 0, 0, 0, 0, 0, 1);
				SCM(playerid,1724645631, "Транспорт заправлен");
			}
		}
		case 902:
		{
			if(!response) return 1;
			if(CompareInt64(playerid, "<", 25000)) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
			//if(player_Cash[playerid] < 25000) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
			GivePlayerMoneyEx(playerid, -25000, "Курс лечения", true, true);
			PI[playerid][pHealth] = 70;
			SetPlayerHealth(playerid, 70.0);
			if(GetPlayerData(playerid, pTemp_BedID) != -1) ClearMedBed(playerid, GetPlayerData(playerid, pTemp_BedID));
			SetPlayerData(playerid, pHospital, false);
		}
		case DIALOG_BIZ_CAR_MARKET:
		{
			if(!response) return 1;
			//SCM(playerid, -1, "На время открытия, администрация выдает машины через розыгрыш, купить машины в салоне невозможно!");
			player_ShowBuyCar(playerid);
		}
		case DIALOG_GOTO_GPS:
		{
			if(response)
			{
				SetPlayerPosEx(playerid, GetPVarFloat(playerid, "goto_x"), GetPVarFloat(playerid, "goto_y"), GetPVarFloat(playerid, "goto_z"), 90.0);
				DeletePVar(playerid, !"goto_x");
				DeletePVar(playerid, !"goto_y");
				DeletePVar(playerid, !"goto_z");
			}
		}
		case DIALOG_PLAYER_SECURITY_SETTINGS:
		{
			if(response)
			{
				switch(listitem + 1)
				{
					case 4:
					{
						Dialog
						(
							playerid, DIALOG_SECURITY_SETTING_PASS_1, DIALOG_STYLE_INPUT,
							"{FFCD00}Изменение пароля",
							"{FFFFFF}Введите Ваш текущий пароль в поле ниже:",
							"Далее", "Назад"
						);
					}
				}
			}
		}
		case DIALOG_SECURITY_SETTING_PASS_1:
		{
			if(response)
			{
				if(strlen(inputtextsave) && GetString(inputtextsave, PI[playerid][pPassword]))
				{
					Dialog
					(
						playerid, DIALOG_SECURITY_SETTING_PASS_2, DIALOG_STYLE_INPUT,
						"{FFCD00}Новый пароль",
						"{FFFFFF}Введите новый пароль в поле ниже:",
						"Изменить", "Отмена"
					);
					return 1;
				}
				else SCM(playerid, 0xFF6600FF, !"Вы ввели неверный пароль");
			}
			ShowPlayerSecuritySettings(playerid);
		}
		case DIALOG_SECURITY_SETTING_PASS_2:
		{
			if(response)
			{
				if(!(6 <= strlen(inputtextsave) <= 15) || strfind(inputtextsave, " ") != -1)
				{
					SCM(playerid, 0xFF6600FF, !"Длина пароля должна быть от 6 до 15 символов");
					SCM(playerid, 0xFF6600FF, !"Также не допускается использование пробелов");
				}
				else
				{
					mysql_tquery(mysql,(str_f("UPDATE `players` SET `Password` ='%s' WHERE `ID` = '%i' LIMIT 1", inputtextsave, GetPlayerAccountID(playerid))));

					f(PI[playerid][pPassword], 25, "%s", inputtextsave);
					SCMf(playerid, 0xFFFF00FF,"Ваш новый пароль: {3399FF}%s", GetPlayerData(playerid, pPassword));
					SCM(playerid, 0xFFFFFFFF, !"Рекомендуем сделать скрин {00CC00}(клавиша F8) {FFFFFF}чтобы не забыть его");
					ShowPlayerSecuritySettings(playerid);
					return 1;
				}

				SPD
				(
					playerid, DIALOG_SECURITY_SETTING_PASS_2, DIALOG_STYLE_INPUT,
					"{FFCD00}Новый пароль",
					"{FFFFFF}Введите новый пароль в поле ниже:",
					"Изменить", "Отмена"
				);
			}
			else ShowPlayerSecuritySettings(playerid);
		}
		case DIALOG_REPORT:
		{
			if(!response) return 1;
			player_ReportInput(playerid, inputtextsave);
		}
	}
	return 1;
}
