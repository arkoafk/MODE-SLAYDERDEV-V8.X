					}
					case 2:
					{
						ExecutePacket(playerid, webUpdate, (str_f("\
							interface('PlayerInteraction').onServerResponse('[\"%s\",[\
								[0,\"Изменить должность\",2,57,0],\
								[0,\"Пригласить игрока\",2,67,1],\
