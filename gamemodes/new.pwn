		}
		WashData_Object[id][i] = -1;
	}
	//мыльница(пузырьки)
	WashData_Object[id][0] = CreateDynamicObject(18720, \
										WashData_Position[id][0]-1.069844, \
										WashData_Position[id][1]+3.121803, \
										WashData_Position[id][2]+2, \
										0.0, 0.0, WashData_Position[id][3], 0, 0);
