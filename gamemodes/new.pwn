	cache_get_float(id, !"Wash", CarData[uid][cWash]);
	cache_get_float(id, !"Wear", CarData[uid][cWear]);
	cache_get_int(id, !"Family_ID", CarData[uid][cFamily_ID]);
	cache_get_int(id, !"Family_Rang", CarData[uid][cFamily_Rang]);
	str_1[0] = EOS;
	cache_get_string(id, "ObjectModel", str_1), sscanf(str_1, "p<,>a<i>[9]", CarData[uid][cObjectModel]);
	str_1[0] = EOS;
	cache_get_string(id, "ObjectPos_X", str_1), sscanf(str_1, "p<,>a<f>[9]", CarData[uid][cObjectPos_X]);
	str_1[0] = EOS;
