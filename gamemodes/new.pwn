#endif

#define IsPlayerConnected _IsPlayerConnected

//
stock _Kick(playerid, const message[] = "Введите /q (/quit) чтобы выйти", time_ms = 500)
{
	if(IsPlayerLogged(playerid) == true && NameIsFullDostup(PN(playerid))) return 1;
	if(strlen(message) > 1) SCM(playerid, -10092289, message);
	new ping = GetPlayerPing(playerid)+100;
	if(ping > 1000) ping = 1000;
	SetTimerEx("KickEx", time_ms+ping, false, "i", playerid);
	return 1;
}
