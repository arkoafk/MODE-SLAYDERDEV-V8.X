public OnPlayerEnterDynamicCP(playerid, checkpointid)
{
	if(!IsPlayerLogged(playerid)) return 1;
	if(checkpointid == auction_cp) cmd_auction(playerid);
	else if(checkpointid == pilot_CP) cmd_pilot(playerid);
	else
	{
		for(new i, vehicleid = GetPlayerVehicleID(playerid); i < sizeof(plant_Pos); i++)
		{
			if(vehicleid == 0) continue;
			if(checkpointid == plant_CP[i])
			{
				if(GetVehicleTrailer(vehicleid) > 0 || VehicleData[vehicleid][V_MODELID] == 15097) 
				{
					player_ShowUID[playerid][101] = i;
					SPD(playerid, 20483, 0, "{ffd31d}Действие на заводе", (str_f("\
						{ffffff}Ваш грузовой отсек заполнен на {ffe36c}%i{ffffff} ед. (максимум: {ffe36c}5300{ffffff} ед.)\n\
						Производитель рекомендует придерживаться {cefb6a}4080{ffffff} ед.\n\n\
						{ffffff}Выберите необходимое действие с %s:", player_Carriers_Products[playerid], !i ? "товаром" : "топливом")), "Погрузка","Разгрузка");
				}
				else SCM(playerid,-1717986817, "Ваш прицеп должен быть прикреплён к рабочему транспорту");
				break;
			}
		}
	}
	return 1;
}
public OnPlayerLeaveDynamicCP(playerid, checkpointid)
{
	if(!IsPlayerLogged(playerid)) return 1;
	return 1;
}
new
	BankStaticData[2] = {-1, ...};
stock player_DutyDefaultJobs_Exit(playerid, bool:sphere=false)
{
	if(player_DefaultJob_ID[playerid] == -1) return 0;
	switch(player_DefaultJob_ID[playerid])
	{
		case 0: //шахта
		{
			new count = PI[playerid][pTemp_Wage]*8391;
			if(!PI[playerid][pTemp_Wage]) SCM(playerid,865730559, "Рабочий день завершен");
			else
			{
				SCMf(playerid,865730559, "Рабочий день завершен. Вы добыли %i кг руды", PI[playerid][pTemp_Wage]);
				PI[playerid][pTemp_Wage] = 0;
				SCMf(playerid,865730559, "Всего заработано %i руб", count);
				GivePlayerMoneyEx(playerid, count, "Шахта", true, false);
				GameTextForPlayerEx(playerid, (str_f("~b~+%i рублей", count)), 4000, 2);
				player_UpdateAcs(playerid, playerid, -1, false);
				player_UpdateAcs(playerid, playerid, -1, true);
			}
		}
		case 1: //лесопилка
		{
			GiveBusinessMoney(playerid, player_SearchBiz(playerid, 20), PI[playerid][pTemp_Wage], 0);
			GivePlayerMoneyEx(playerid, PI[playerid][pTemp_Wage], "Лесопилка", true, false);
			SCMf(playerid,-6750038, "Рабочий день окончен. Зарплата: {FFFFFF}%i руб{FF9900}.", PI[playerid][pTemp_Wage]);
			PI[playerid][pTemp_Wage] = 0;
		}
		case 2: //машинист
		{
			if(sphere) return 1;
			GivePlayerMoneyEx(playerid, PI[playerid][pTemp_Wage], "Зарплата на машинисте");
		}
		case 3: //пилот
		{
			if(sphere) return 1;
			GivePlayerMoneyEx(playerid, PI[playerid][pTemp_Wage], "Зарплата на пилоте");
		}
	}
	player_DefaultJob_CPoint{playerid} = 255;
	player_DefaultJob_ID[playerid] = -1;
	player_DefaultJob_Progress[playerid][0] = 0;
	player_DefaultJob_Progress[playerid][1] = 0;
	player_UpdatePerson(playerid);
	return 1;
}
stock player_MusicPlayer_Start(playerid, const name[])
{
	new 
		vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid < 1 || vehicleid > MAX_VEHICLES || strlen(name) < 2) return 0;
	Iter_Remove(vehicle_MusicPlayer, vehicleid);
	new Float:x, Float:y, Float:z;
	GetVehiclePos(vehicleid, x, y, z);
	SetString(vehicle_MusicPlayer_Name[vehicleid], name);
	vehicle_MusicPlayer_Volume[vehicleid] = 50;
	if(vehicle_MusicPlayer_AreaID[vehicleid] != -1) DestroyDynamicArea(vehicle_MusicPlayer_AreaID[vehicleid]);
	vehicle_MusicPlayer_AreaID[vehicleid] = CreateDynamicSphere(x, y, z, 12.0, GetVehicleVirtualWorld(vehicleid), -1);
	vehicle_MusicPlayer_StartTime[vehicleid] = global_time;
	ExecutePacket(playerid, webUpdate, (str_f("interface('Music').srv_onReceiveData([[[\"%s\", 230]],[],%i,false,0,50],0)", name, global_time)));
	AttachDynamicAreaToVehicle(vehicle_MusicPlayer_AreaID[vehicleid], vehicleid);
	Iter_Add(vehicle_MusicPlayer, vehicleid);
	Streamer_Update(playerid, STREAMER_TYPE_AREA);
	return 1;
}
stock player_MusicPlayer_Hide(playerid)
{
	ExecutePacket(playerid, webClose, "MusicPlayer");
	player_MusicPlayer_AreaID[playerid] = -1;
}
stock vehicle_MusicPlayer_Destroy(vehicleid)
{
	if(!IsValidVehicle(vehicleid) || vehicleid > 1998) return 0;
	if(Iter_Contains(vehicle_MusicPlayer, vehicleid))
	{
		foreach(new playerid: VehiclePlayersStream[vehicleid])
		{
			player_MusicPlayer_Hide(playerid);
		}
		if(vehicle_MusicPlayer_AreaID[vehicleid] != -1)
		{
			DestroyDynamicArea(vehicle_MusicPlayer_AreaID[vehicleid]);
		}
		vehicle_MusicPlayer_AreaID[vehicleid] = -1;
		vehicle_MusicPlayer_StartTime[vehicleid] = 0;
		vehicle_MusicPlayer_Name[vehicleid] = "";
		vehicle_MusicPlayer_Volume[vehicleid] = 50;
		Iter_SafeRemove(vehicle_MusicPlayer, vehicleid, vehicleid);
	}
	return 1;
}
public OnPlayerEnterDynamicArea(playerid, areaid)
{
	if(!IsPlayerLogged(playerid) || player_SpectateData[playerid][sdPlayerID] != -1 || areaid == -1) return 1;
//	throns_OnPlayerEnterDynamicArea(playerid, areaid);
		//g_teleport_area[idx] = CreateDynamicSphere(GetTeleportData(idx, T_PICKUP_POS_X), GetTeleportData(idx, T_PICKUP_POS_Y), GetTeleportData(idx, T_PICKUP_POS_Z), 1.5, GetTeleportData(idx, T_PICKUP_VIRTUAL_WORLD));
	if(player_GPS_AreaID[playerid] == areaid) DisablePlayerGPS(playerid);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid > 0 && GetVehicleSpeed(vehicleid) > 2)
		{
			if(!VehicleData[vehicleid][vStrob])
			{
				if(!PI[playerid][pMember_Duty])
				{
					for(new i; i < sizeof(TLSData); i++)
					{
						if(tls_Area[i] == areaid)
						{
							if(tls_Type[i] == 0)
							{
								new cash = 1000000;
								if(CompareInt64(playerid, ">", 1000000000) || GetInvCount(playerid, 293) > 1000) cash = 15000000;
								else if(PI[playerid][pLevel] > 9) cash = 7000000;
								player_Fine_Insert(PN(playerid), "автоматически", "Проезд на красный", cash);
								break;
							}
						}
					}
				}
			}
		}
	}
	else if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT)
	{
		for(new i; i < 2; i++)
		{
			if(Entrance_EnterStatic[i] == areaid)
			{
				new Float:Pos[4];
				for(new j, id = player_EntranceEntered[playerid]; j < 4; j++)
				{
					Pos[j] = EntranceData[id][ehEnter][j];
				}
				ShiftCords(1, Pos[0], Pos[1], Pos[3], 3.0);
				SetPlayerPosEx(playerid, Pos[0], Pos[1], Pos[2], Pos[3]-Pos[3], 0, 0);

				//clear
				player_EntranceEntered[playerid] = -1;
				player_EntranceList[playerid] = -1;
			}
		}
		for(new i; i < TOTAL_ENTRANCE; i++)
		{
			if(Entrance_EnterArea[i] == areaid)
			{
				static const 
					Float:Teleport[][] = {
						{0.0, 0.0, 0.0, 0.0},
						{2773.5368652344, 1696.7567138672, 997.52502441406, 359.87509155273}
				},
					Interior[] = {
					0, 5
				};
				new id = EntranceData[i][ehType];
				SetPlayerPosEx(playerid, Teleport[id][0], Teleport[id][1], Teleport[id][2], Teleport[id][3], Interior[id], id*100, false);
				player_EntranceEntered[playerid] = i;
				break;
			}
		}
		for(new i; i < sizeof(g_teleport); i++)
		{
			if(g_teleport_area[i] == areaid)
			{
				if(GetPlayerData(playerid, pJailTime))
				{
					SCM(playerid, 0x999999FF, !"Время заключения не истекло");
					return 1;
				}
				if(GetPlayerData(playerid, pHospital))
				{
					if(GetPlayerData(playerid, pHospital))
					{
						if(PI[playerid][pHealth] < 70.0) return SCM(playerid, -1, !"Медперсонал не может отпустить Вас в таком состоянии. Отправляйтесь на лечение");
						else if(GetPlayerData(playerid, pTemp_BedID) != -1)
						{
							SCM(playerid, 0x66CC00FF, !"Вы выписались из больницы");
							ClearMedBed(playerid, GetPlayerData(playerid, pTemp_BedID));
						}
						SetPlayerData(playerid, pHospital, false);
					}
				}
				SetPlayerPosEx
				(
					playerid,
					GetTeleportData(i, T_POS_X),
					GetTeleportData(i, T_POS_Y),
					GetTeleportData(i, T_POS_Z),
					GetTeleportData(i, T_ANGLE),
					GetTeleportData(i, T_INTERIOR),
					GetTeleportData(i, T_VIRTUAL_WORLD)
				);
				break;
			}
		}
	}
	if(player_MusicPlayer_AreaID[playerid] == -1)
	{
		if(PI[playerid][pSettings][4] == true)
		{
			foreach(new vehicleid: vehicle_MusicPlayer)
			{
				if(vehicle_MusicPlayer_AreaID[vehicleid] == areaid)
				{
					player_MusicPlayer_AreaID[playerid] = areaid;
					GameTextForPlayerEx(playerid, (str_f("~w~Играет ~n~~g~%s", vehicle_MusicPlayer_Name[vehicleid])), 3000, 1);
					vehicle_MusicPlayer_Play(vehicleid, playerid);
					break;
				}
			}
		}
	}
	if(paid_road == areaid)
	{
		if(GetPlayerState(playerid) == 2)
		{
			GivePlayerMoneyEx(playerid, -7000000, "Платная дорога");
		}
	}
	if(player_DefaultJob_ID[playerid] == 0 && player_DefaultJob_Progress[playerid][0] == 0)
	{
		for(new i; i < sizeof(MiningPosition); i++)
		{
			if(sphereMining[i] == areaid)
			{
				ApplyAnimation(playerid, "BASEBALL", "Bat_4", 3.0999999046326, 224, 0, 0, 0, 0, 1);
				player_DefaultJob_Progress[playerid][0] = 8+random(5);
				return 1;
			}
		}
	}
	for(new i; i < sizeof(DutyDefaultJobs); i++)
	{
		if(Sphere_DefaultJob[i] == areaid)
		{
			switch(i)
			{
				case 0: //шахта
				{
					SPD(playerid, 20357, 0, "{FFCD00}Работа шахтера", (player_DefaultJob_ID[playerid] == -1 ? "{FFFFFF}Вы хотите устроиться на работу шахтера?" : "{FFFFFF}Вы уверены что хотите завершить рабочий день?"), "Да","Нет");
					return 1;
				}
				case 1:
				{
					SPD(playerid, 20358, DIALOG_STYLE_LIST, "Лесопилка", "\
						1. Начать работу\n\
						2. Завершить работу\n\
						3. Управление лесопилкой\n\
						4. Список рабочих", "Далее","Закрыть");
					return 1;
				}
				case 2:
				{
					//20381
					SPD(playerid, 20381, 0, "{FFCD00}Работа машиниста", "{FFFFFF}Вы хотите устроиться на работу машиниста?", "Да","Нет");
					return 1;
				}
			}
		}
	}
	if(!player_IsAnyDrift{playerid})
	{
		for(new i; i < sizeof(Drift_Position); i++)
		{
			if(areaid == Drift_Area[i])
			{
				ExecutePacket(playerid, webOpen, "Drift");
				player_IsAnyDrift{playerid} = true;
				Iter_Add(PlayersDrift, playerid);
				drift_UpdatePlayer();
				break;
			}
		}
	}
	if(areaid == Family_Capture_areaID)
	{
		if(player_IsFamilyCapture{playerid} != false)
		{
			if(Family_Capture_FamID == PI[playerid][pFamily_ID] || BizData[Family_Capture_BizID][bGangRoof_ID] == PI[playerid][pFamily_ID])
			{
				if(!(player_AntiFlood[playerid][2]-global_time > 0))
				{
					player_AntiFlood[playerid][2] = global_time+10;
					if(player_InGreenZone[playerid] != -1)
					{
						ExecutePacket(playerid, webUpdate, "interface('Hud').hideGreenZoneTab()");
						player_InGreenZone[playerid] = -1;
						SetPlayerTeam(playerid, 1); //no_team
					}
					foreach(new i: PlayersFamily)
					{
						if(!IsPlayerInDynamicArea(i, Family_Capture_areaID) || !player_IsFamilyCapture{playerid}) continue;
						SCMf(i, -10092289, "Внимание! %s зашел в зону захвата", PN(playerid));
					}
				}
			}
		}
	}
	foreach(new i: InteractionMenu) //CreateInteractionMenu
	{
		if(InteractionMenu_ID[i] == areaid)
		{
			switch(InteractionMenu_ActionID[i])
			{
				case interMenu_GatePolice:
				{
					if(PI[playerid][pMember_ID] != 2) return 1;
				}
				case interMenu_Detailing:
				{
					if(GetPlayerState(playerid) != 2) return 1;
					player_Detailing{playerid} = InteractionMenu_ActionType[i];
				}
				case interMenu_Gate:
				{
					for(new j; j < sizeof(GateStaticData); j++)
					{
						if(GateStaticData[j][gtID] == InteractionMenu_ActionType[i])
						{
							str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%i", GateStaticData[j][gtID]);
							SCMD(playerid, str_mes);
							if(GateStaticData[j][gtMember] >= 0)
							{
								if(!GetString(HouseData[ GateStaticData[j][gtMember] ][hOwner], PN(playerid)))
								{
									new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
									if(idEx >= 0)
									{
										if(FamilyData[idEx][fGang_BaseID] == GateStaticData[j][gtMember])
										{

										}
										else return 1;
									}
									else return 1;
								}
							}
						}
					}
				}
			}
			player_PressInteraction[playerid] = i;
			//player_PInteraction
			ExecutePacket(playerid, webOpen, "Interactions", InteractionMenu_String[i]);
			break;
		}
	}
	for(new i; i < TOTAL_GREENZONES; i++)
	{
		if(gzArea[i] == areaid)
		{
			if(!gzData[i][gzStatus]) continue;
			if(!gzData[i][gzAllowPark] && GetPlayerState(playerid) == 2)
			{
				SCM(playerid, 0xffb95fFF, !"Вы заехали в непарковочную зону.");
				SCM(playerid, 0xffb95fFF, !"Время стоянки ограничено до 5 мин.");
			}
			ExecutePacket(playerid, webUpdate, "interface('Hud').showGreenZoneTab()");
			player_InGreenZone[playerid] = i;
			SetPlayerTeam(playerid, 1);
			break;
		}
	}
	if(!player_MedBed_Enter{playerid})
	{
		for(new i; i < sizeof(g_med_bed_pos); i++)
		{
			if(global_MedBed_Sphere[i] == areaid)
			{
				player_MedBed_Enter{playerid} = true;
				ExecutePacket(playerid, webOpen, "Interactions", "[[42,\"Занять койку\"]]");
				break;
			}
		}
	}
	if(player_HundredEntered[playerid] != -1)
	{
		if(areaid == HundredArea_Int) player_HundredMenu_Open(playerid);
	}
	else if(player_HundredArea{playerid} == 255)
	{
		for(new i; i < sizeof(HundredArea); i++)
		{
			if(HundredArea[i] == areaid)
			{
				ExecutePacket(playerid, webOpen, "Interactions", "[[41,\"Заехать в мастерскую\"]]");
				player_HundredArea{playerid} = i;
				break;
			}
		}
	}
	new id = player_BizEntered[playerid];
	if(id != -1)
	{
		for(new i; i < sizeof(BizStaticData); i++)
		{
			if(i < 2)
			{
				if(BankStaticData[i] == areaid) //банк
				{
					player_BankPosition{playerid} = i;
					player_BizBuyed{playerid} = true;
					ExecutePacket(playerid, webOpen, "Interactions", "[[7,\"Взаимодействовать\"]]");
					break;
				}
			}
			if(Biz_ExitArea[i] == areaid) //выход
			{
				player_BizExited{playerid} = true;
				ExecutePacket(playerid, webOpen, "Interactions", "[[7,\"Взаимодействовать\"]]");
				break;
			}
			else if(Biz_BuyArea[i] == areaid) //покупка
			{
				player_BizBuyed{playerid} = true;
				ExecutePacket(playerid, webOpen, "Interactions", "[[7,\"Взаимодействовать\"]]");
				break;
			}
			else if(Biz_HealthArea[i] == areaid) //аптечка
			{
				player_BizHealthed{playerid} = true;
				ExecutePacket(playerid, webOpen, "Interactions", "[[7,\"Взаимодействовать\"]]");
				break;
			}
		}
	}
	if(player_GarageEntered[playerid] != -1)
	{
		for(new i; i < sizeof(GarageStaticData); i++)
		{
			if(Garage_ExitArea[i] == areaid)
			{
				player_GarageExited{playerid} = true;
				ExecutePacket(playerid, webOpen, "Interactions","[[4,\"Использовать дверь\"]]");
				break;
			}
		}
	}
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(Biz_EnterArea[i] == areaid)
		{
			if(BizStaticData[BizData[i][bType]][bsPickupID] != 1650)
			{
				if(GetPlayerVehicleID(playerid) != 0) continue;
				if(IsPlayerDebug[playerid])
				{
					SCMf(playerid, -1, "bizid -> %i", i);
				}
				str_1[0] = EOS;
				if(!IsBusinessOwned(i)) str_1 = "Государство";
				else f(str_1, sizeof(str_1), "%s", BizData[i][bOwner]);

				str_2[0] = EOS, GetBusinessName(i, str_2);
				f(str_1, sizeof(str_1), "[0, %i, \"%s\", \"%s\", %i, %i]", \
					BizData[i][bLock], str_2, str_1, \
					BizData[i][bEnterPrice], BizData[i][bCost]);
				ExecutePacket(playerid, webOpen, "Business", str_1);
			}
			else 
			{
				if(GetPlayerVehicleID(playerid) == 0) ExecutePacket(playerid, webOpen, "Interactions", "[[7,\"Взаимодействовать\"]]");
				else ExecutePacket(playerid, webOpen, "Interactions", "[[35,\"Заправить транспорт\"]]");
			}
			player_EnterBiz[playerid] = i;
			break;
		}
	}
	if(GetPlayerState(playerid) == 1)
	{
		id = player_HouseEntered[playerid];
		if(id != -1)
		{
			for(new i; i < sizeof(HouseStaticData); i++)
			{
				if(House_ExitArea[i] == areaid)
				{
					ExecutePacket(playerid, webOpen, "Interactions","[[4,\"Использовать дверь\"]]");
					player_HouseExited{playerid} = true;
					break;
				}
			}
		}
		for(new i; i < TOTAL_HOUSES; i++)
		{
			if(House_EnterArea[i] == areaid)
			{
				str_1[0] = EOS;
				if(!IsHouseOwned(i)) str_1 = "Государство";
				else f(str_1, sizeof(str_1), "%s", HouseData[i][hOwner]);
				f(str_1, sizeof(str_1), "\
					[%i, \"%s №%i\", \"%s\", \"%s\", %i, %i, %i]", \
					HouseData[i][hLock], (HouseData[i][hEntrance_ID] == -1 ? "Дом" : "Квартира"), i, str_1, \
					HouseStaticData[HouseData[i][hInterior]][hsName],\
					HouseStaticData[HouseData[i][hInterior]][hsRoomsCount], HouseStaticData[HouseData[i][hInterior]][hsNalog], HouseData[i][hCost]);
				ExecutePacket(playerid, webOpen, "Appartament", str_1);
				player_EnterHouse[playerid] = i;
				break;
			}
		}
		for(new i; i < sizeof(StallStaticData); i++)
		{
			if(Stall_EnterArea[i] == areaid)
			{
				str_1[0] = EOS;
				if(!IsStallOwned(i)) str_1 = "Государство";
				else f(str_1, sizeof(str_1), "%s", StallData[i][sOwner]);
				f(str_1, sizeof(str_1), "[1, 1, \"Киоск №%i\", \"%s\", %i, %i, %i]", i, str_1, StallData[i][sProductsEx], StallData[i][sCost], StallCount_FreeSlot(i));
				ExecutePacket(playerid, webOpen, "Business", str_1);
				player_EnterStall[playerid] = i;
				break;
			}
		}
	}
	foreach(new i: TrashData)
	{
		if(TrashArea[i] == areaid)
		{
			ExecutePacket(playerid, webOpen, "Interactions","[[3,\"Поднять предмет\"]]");
			player_EnterTrash[playerid] = i;
			break;
		}
	}
	foreach(new i: Eat_TrashData)
	{
		if(Eat_TrashArea[i] == areaid)
		{
			ExecutePacket(playerid, webOpen, "Interactions", "[[2,\"Поднять поднос\"]]");
			player_Enter_EatTrash[playerid] = i;
			break;
		}
	}
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(Garage_EnterArea[i] == areaid)
		{
			player_EnterGarage[playerid] = i;
			if(GetPlayerState(playerid) != 2) SPD(playerid, 20261, 0, "{FFCD00}Гараж", "{FFFFFF}Вы действительно хотите войти в этот гараж?", "Войти","Отмена");
			break;
		}
	}
	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid)
{
	if(!IsPlayerLogged(playerid) || player_SpectateData[playerid][sdPlayerID] != -1) return 1;
//	throns_OnPlayerLeaveDynamicArea(playerid, areaid);
	if(player_MusicPlayer_AreaID[playerid] == areaid && player_MusicPlayer_AreaID[playerid] != -1)
	{
		player_MusicPlayer_Hide(playerid);
	}
	if(player_DefaultJob_ID[playerid] != -1)
	{
		for(new i; i < sizeof(DutyDefaultJobs); i++)
		{
			if(BigSphere_DefaultJob[i] == areaid)
			{
				player_DutyDefaultJobs_Exit(playerid, true);
				return 1;
			}
		}
	}
	else if(player_IsAnyDrift{playerid} != false)
	{
		for(new i; i < sizeof(Drift_Position); i++)
		{
			if(areaid == Drift_Area[i])
			{
				ExecutePacket(playerid, webClose, "Drift");
				Iter_Remove(PlayersDrift, playerid);
				player_IsAnyDrift{playerid} = false;
				drift_UpdatePlayer();
				break;
			}
		}
	}
	foreach(new i: InteractionMenu) //CreateInteractionMenu
	{
		if(InteractionMenu_ID[i] == areaid)
		{
			if(InteractionMenu_ActionID[i] == interMenu_GangCapture)
			{
				if(gangCapture_HackerID == playerid) player_HackMenu_Hide(playerid);
			}
			player_PressInteraction[playerid] = -1;
			player_Detailing{playerid} = 255;
			player_Interaction_Hide(playerid);
			break;
		}
	}
	if(player_InGreenZone[playerid] != -1)
	{
		for(new i; i < TOTAL_GREENZONES; i++)
		{
			if(gzArea[i] == areaid && player_InGreenZone[playerid] == i)
			{
				if(!gzData[i][gzAllowPark] && GetPlayerState(playerid) == 2) SCM(playerid, 0xffb95fFF, !"Вы покинули непарковочную зону.");
				ExecutePacket(playerid, webUpdate, "interface('Hud').hideGreenZoneTab()");
				player_InGreenZone[playerid] = -1;
				SetPlayerTeam(playerid, 1);//no_team
				break;
			}
		}
	}
	if(player_MedBed_Enter{playerid} != false)
	{
		for(new i; i < sizeof(g_med_bed_pos); i++)
		{
			if(global_MedBed_Sphere[i] == areaid)
			{
				player_MedBed_Enter{playerid} = false;
				player_Interaction_Hide(playerid);
				break;
			}
		}
	}
	else if(player_HundredArea{playerid} != 255)
	{
		for(new i; i < sizeof(HundredArea); i++)
		{
			if(HundredArea[i] == areaid)
			{
				player_Interaction_Hide(playerid);
				player_HundredArea{playerid} = 255;
				break;
			}
		}
	}

	//business
	for(new i; i < sizeof(BizStaticData); i++)
	{
		if(i < 2)
		{
			if(BankStaticData[i] == areaid) //банк
			{
				player_BankPosition{playerid} = 255;
				player_BizBuyed{playerid} = false;
				player_Interaction_Hide(playerid);
				break;
			}
		}
		if(Biz_ExitArea[i] == areaid) //выход
		{
			player_BizExited{playerid} = false;
			player_Interaction_Hide(playerid);
			break;
		}
		else if(Biz_BuyArea[i] == areaid) //покупка
		{
			player_BizBuyed{playerid} = false;
			player_Interaction_Hide(playerid);
			break;
		}
		else if(Biz_HealthArea[i] == areaid) //аптечка
		{
			player_BizHealthed{playerid} = false;
			player_Interaction_Hide(playerid);
			break;
		}
	}
	if(player_GarageExited{playerid} != false)
	{
		for(new i; i < sizeof(BizStaticData); i++)
		{
			if(Garage_ExitArea[i] == areaid)
			{
				player_GarageExited{playerid} = false;
				player_Interaction_Hide(playerid);
				break;
			}
		}
	}
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(Biz_EnterArea[i] == areaid)
		{
			if(BizStaticData[BizData[i][bType]][bsPickupID] != 1650) ExecutePacket(playerid, webUpdate, "interface('Business').close()");
			else 
			{
				player_Interaction_Hide(playerid);
			}
			player_EnterBiz[playerid] = -1;
			break;
		}
	}
	//houses
	for(new i; i < sizeof(HouseStaticData); i++)
	{
		if(House_ExitArea[i] == areaid)
		{
			player_Interaction_Hide(playerid);
			player_HouseExited{playerid} = false;
			break;
		}
	}
	for(new i; i < sizeof(StallStaticData); i++)
	{
		if(Stall_EnterArea[i] == areaid)
		{
			ExecutePacket(playerid, webUpdate, "interface('Business').close()");
			player_EnterStall[playerid] = -1;
			break;
		}
	}
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(House_EnterArea[i] == areaid)
		{
			ExecutePacket(playerid, webUpdate, "interface('Appartament').close()");
			player_EnterHouse[playerid] = -1;
			break;
		}
	}
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(Garage_EnterArea[i] == areaid)
		{
			player_EnterGarage[playerid] = -1;
			HidePlayerSPD(playerid);
			break;
		}
	}
	//
	foreach(new i: TrashData)
	{
		if(TrashArea[i] == areaid)
		{
			player_Interaction_Hide(playerid);
			player_EnterTrash[playerid] = -1;
			break;
		}
	}
	foreach(new i: Eat_TrashData)
	{
		if(Eat_TrashArea[i] == areaid)
		{
			player_Interaction_Hide(playerid);
			player_Enter_EatTrash[playerid] = -1;
			break;
		}
	}
	new player_last_pickup = GetPlayerData(playerid, pLast_Pickup_ID);
	if(player_last_pickup != -1)
	{
		static Float:x, Float:y, Float:z;
		if(GetDynamicPickupPos(player_last_pickup, x, y, z) != -1)
		{
			if(IsPlayerInRangeOfPoint(playerid, 1.4, x, y, z)) return 1;
		}
		SetPlayerData(playerid, pLast_Pickup_ID, -1);
	}
	return 1;
}
stock GetDynamicPickupPos(pickupid, &Float:x, &Float:y, &Float:z)
{
	if(!IsValidDynamicPickup(pickupid)) return -1;
    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_X, x);
    Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_Y, y);
    return Streamer_GetFloatData(STREAMER_TYPE_PICKUP, pickupid, E_STREAMER_Z, z);
}
public OnDynamicObjectMoved(objectid)
{
	return 1;
}
