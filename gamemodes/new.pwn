stock OnPlayerInventory_WeaponUpdate(playerid)
{
	ResetPlayerWeapons(playerid);
	for(new i; i < 20; i++)
	{
		//SCMf(playerid, -1, "1. %i", Inventory[playerid][0][i]);
		if(Inventory[playerid][0][i] == -1) continue;
		new item = Inventory_IsValidWeapon(Inventory[playerid][0][i]);
		//SCMf(playerid, -1, "2. %i", Inventory[playerid][0][i]);
		if(item == -1) continue;
		//SCM(playerid, -1, "+++");
		GivePlayerWeapon(playerid, ItemsData_Weapon[item][idGunUID], Inventory[playerid][1][i]);
	}
	return 1;
}
stock OnPlayerInventory_WeaponSet(playerid, id)
{
	new item = Inventory_IsValidWeapon(id);
	if(item != -1)
	{
		OnPlayerInventory_WeaponUpdate(playerid);
	}
}
stock OnPlayerInventory_WeaponAdd(playerid, weaponid, count)
{
	new i = GetWeaponUID(weaponid);
	if(i != -1)
	{
		if(!InvAdd(playerid, ItemsData_Weapon[i][idItemUID], count, "", 0, 0, "", "Получил оружие (WeaponAdd)"))
		{
			return 0;
		}
		OnPlayerInventory_WeaponUpdate(playerid);
	}
	else GivePlayerWeapon(playerid, weaponid, count);
	return 1;
}
stock OnPlayerInventory_WeaponShot(playerid, weaponid)
{
	if(weaponid >= 4 && weaponid <= 35)
	{
		//new slot = -1;
		for(new i; i < 20; i++)
		{
			if(Inventory[playerid][0][i] == -1) continue;
			new item = Inventory_IsValidWeapon(Inventory[playerid][0][i]);
			if(item == -1) continue;
			if(ItemsData_Weapon[item][idGunUID] != weaponid) continue;
			if(ItemsData[Inventory[playerid][0][i]][ItemCombination] == true)
			{
				if(Inventory[playerid][1][i]-1 > 0) SetInvItem(playerid, i, ItemsData_Weapon[item][idItemUID], Inventory[playerid][1][i]-1, 0, 0, "");
				else RefreshInvPlayer(playerid, i);
			}
			else if(Inventory[playerid][1][i] != 1) SetInvItem(playerid, i, ItemsData_Weapon[item][idItemUID], 1, 0, 0, "");
			break;
		}
	}
	return 1;
}
stock Inventory_IsValidWeapon(weaponid)
{
	for(new i; i < sizeof(ItemsData_Weapon); i++)
	{
		if(ItemsData_Weapon[i][idItemUID] == weaponid) return i;
	}
	return -1;
}
stock GetWeaponUID(weaponid)
{
	for(new i; i < sizeof(ItemsData_Weapon); i++)
	{
		if(ItemsData_Weapon[i][idGunUID] == weaponid) return i;
	}
	return -1;
}
stock IsValidAcsProperty(model)
{
	if(model <= 0) return 0; // или false
	for(new i; i < sizeof(PropertyAcsData); i++)
	{
		if(PropertyAcsData[i][accModel] == model) 
		{
			return i;
		}
	}
	return -1;
}
stock IsValidAcsPerson(model)
{
	for(new i; i < sizeof(PersonAcsData); i++)
	{
		if(PersonAcsData[i][accModel] == model)
		{
			//printf("IsValidAcsPerson %i %i", i, PersonAcsData[i][accModel]);
			return i;
		}
	}
	return -1;
}
