stock player_Sawmill_Point(playerid, type)
{
	if(player_DefaultJob_ID[playerid] != 1) return 0;
	if(GetPlayerState(playerid) != 1) return 0;
	switch(player_DefaultJob_Progress[playerid][0])
	{
		case 0:
		{
			if(type == 1)
			{
				SetPlayerSpecialAction(playerid,25);
				SCM(playerid,-1412567126, "Отнесите бревно на пилораму.");
				SetPlayerAttachedObject(playerid, 2, 14039, 1, 0.15399999916553, 0.4459989964962, 0, 91.599998474121, 1.9999990463257, -98.999908447266, 0.37799900770187, 0.41499799489975, 0.41799899935722);
				SetPlayerCheckpoint(playerid, 470.91070556641, -2371.8190917969, 34.778301239014, 1.5);
				player_DefaultJob_Progress[playerid][0]++;
			}
			else 
			{
				SetPlayerCheckpoint(playerid, 477.86349487305, -2439.0234375, 34.762901306152, 1.5);
				SCM(playerid,-1412567126, "Возьмите бревно со склада и отнесите на пилораму, чтобы начать работать.");
			}
		}
		case 1:
		{
			if(type == 2)
			{
				TogglePlayerControllable(playerid, false);
				ExecutePacket(playerid, webOpen, "ProgressBar", "[[\"Нажимайте Y <br>с небольшим интервалом\",0,1000]]");
				ExecutePacket(playerid, webUpdate, "ProgressBar", "interface('ProgressBar').getBarInfo(\"[[\"Нажимайте Y <br>с небольшим интервалом\",0,1000]]\")");
				player_DefaultJob_Progress[playerid][1] = 0;
				player_DefaultJob_Progress[playerid][0]++;
			}
			else SCM(playerid,-2127958, "Для начало необходимо отнести распиленные брёвна на склад.");
		}
		case 2:
		{
			if(type == 3)
			{
				TogglePlayerControllable(playerid, true);
				ExecutePacket(playerid, webClose, "ProgressBar");
				player_DefaultJob_Progress[playerid][1] = 0;
				ApplyAnimation(playerid, "CARRY", "PUTDWN", 4.0999999046326, 0, 0, 0, 0, 0, 1);
				SCM(playerid,-1412567126, "Вы успешно начали работу на станке. Ожидайте, пока станок распилит бревно.");
				SetPlayerSpecialAction(playerid,0);
				RemovePlayerAttachedObject(playerid, 2);
				SetPlayerCheckpoint(playerid, 488.32037353516, -2383.3347167969, 34.05627822876, 1.5);
				player_DefaultJob_Progress[playerid][0]++;
			}
			else SCM(playerid,-2127958, "Для начала возьмите бревно со склада.");
		}
		case 3:
		{
			if(type == 4)
			{
				SetPlayerSpecialAction(playerid,25);
				SetPlayerAttachedObject(playerid, 2, 14043, 1, -0.24300000071526, 0.38999900221825, 0, -89.00008392334, 0.29999899864197, 98.099952697754, 0.30099898576736, 1, 0.51700001955032);
				ApplyAnimation(playerid, "CARRY", "LIFTUP", 4.0999999046326, 0, 0, 0, 0, 0, 1);
				SCM(playerid,-1412567126, "Отнесите доску на склад.");
				SetPlayerCheckpoint(playerid, 505.48498535156, -2376.8388671875, 34.778301239014, 1.5);
				player_DefaultJob_Progress[playerid][0]++;
			}
			else SCM(playerid,-2127958, "На данный момент нет распиленных брёвен.");
		}
		case 4:
		{
			if(type == 5)
			{
				SetPlayerCheckpoint(playerid, 477.86349487305, -2439.0234375, 34.762901306152, 1.5);
				ApplyAnimation(playerid, "CARRY", "PUTDWN", 4.0999999046326, 0, 0, 0, 0, 0, 1);
				SCM(playerid,-1412567126, "Вы перенесли все распиленные брёвна, отправляйтесь на склад за новым бревном.");
				SetPlayerSpecialAction(playerid,0);
				RemovePlayerAttachedObject(playerid, 2);
				player_DefaultJob_Progress[playerid][0] = 0;
				new count = 650000+random(150000);
				PI[playerid][pTemp_Wage] += count;
				GameTextForPlayerEx(playerid, (str_f("~g~+%i руб~n~~w~Заработано: ~g~%i", count, PI[playerid][pTemp_Wage])), 3000, 2);
			}
			else SCM(playerid,-2127958, "У вас нет в руках распиленного бревна.");
		}
	}
	return 1;
}
