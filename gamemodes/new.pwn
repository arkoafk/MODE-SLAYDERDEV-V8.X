stock family_IsPlayerHouseOwner(playerid)
{
	new house_id = player_HouseEntered[playerid];
	if(house_id != -1 && PI[playerid][pFamily_ID] != -1)
	{
		if(HouseData[house_id][hGang_FamilyID] == PI[playerid][pFamily_ID])
		{
			return house_id;
		}
	}
	return -1;
}
stock house_CheckItem(playerid)
{
	if(player_InvType{playerid} == 1)
	{
		//new idEx = GetFamilyID(HouseData[id][hGang_FamilyID]);
		new house_id = family_IsPlayerHouseOwner(playerid);
		if(house_id != -1)
		{
			new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
			if(idEx >= 0 && FamilyData[idEx][fBalance] > 0)
			{
				new fslot = -1;
				for(new i; i < 24; i++)
				{
					if(InventoryHouse[house_id][0][i] == -1)
					{
						fslot = i;
					}
					if(InventoryHouse[house_id][0][i] == 0)
					{
						InventoryHouse[house_id][0][i] = 0;
						InventoryHouse[house_id][1][i] = FamilyData[idEx][fBalance];
						fslot = -1;
						break;
					}
				}
				if(fslot != -1)
				{
					InventoryHouse[house_id][0][fslot] = 0;
					InventoryHouse[house_id][1][fslot] = FamilyData[idEx][fBalance];
				}
			}
		}
	}
}
stock OnPlayerInventory(playerid, type)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID)
	{
		OpenInterface[playerid][7] = false;
		SCM(playerid,-5963521, "Уведомление:{FFFFFF} Во время обмена невозможно!");
		ExecutePacket(playerid, webClose, "InventoryNew");
		return 1;
	}
	if(!OpenInterface[playerid][7]) 
	{
		player_SetCursorStatus(playerid, false);
		ExecutePacket(playerid, webClose, "InventoryNew");
		player_InvType{playerid} = 255;
		player_TrunkOpen[playerid] = -1;
	}
	else
	{
		player_InvType{playerid} = type;
		house_CheckItem(playerid);
		new cash = strval(player_Cash[playerid]);
		if(cash < 0 || cash > 2000000000) cash = 2000000000;
		player_CheckItem(playerid, 0, cash);
		player_CheckItem(playerid, 100, 1, PI[playerid][pSkin]);
		//inv

		str_2[0] = EOS;
		strcat(str_2, "[0,");
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[\"%s\",%i,%s,%i,%i,%i,%.2f,60.00]", \
			PN(playerid), playerid, GetStrMoney(playerid), PI[playerid][pSkin], GetInvCount(playerid, 293),\
			GetPlayerPremium(playerid), GetInvHeft(Inventory[playerid], 20));
		strcat(str_2, str_1);
		strcat(str_2, ",[");
		ShowInvMenu(playerid);
		strcat(str_2, "],");

		strcat(str_2, "[");
		GetInvCellData(playerid); //update str_2
		strcat(str_2, "]]");
		//printf(str_2);
		//
		ExecutePacket(playerid, webOpen, "InventoryNew", str_2);
		player_SetCursorStatus(playerid, true);
		//printf("%s", str_2);
	}
	return 1;
}
stock ShowInvMenu(playerid)
{
	new statusBag = IsPlayerBagUsed(playerid);
	if(statusBag == 1)
	{
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[2,\"Рюкзак\",%.2f,20.00]", GetInvHeft(InventoryBag[playerid], 24));
		strcat(str_2, str_1);
	}
	if(player_InvType{playerid} == 1)
	{
		new id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
		if(id != -1 && id != -2)
		{
			if(statusBag == 1) strcat(str_2, ",");
			str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,\"%s\",%.2f,300.00]", \
				(HouseData[id][hGang_FamilyID] == -1 ? "Шкаф" : "Склад"), GetInvHeft(InventoryHouse[id], 24));
			strcat(str_2, str_1);
		}
		else player_InvType{playerid} = 255;
	}
	else if(player_InvType{playerid} == 2)
	{
		new id = IsTrunkDostup(playerid);
		if(id != -1)
		{
			if(statusBag == 1) strcat(str_2, ",");
			str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,\"Багажник\",%.2f,100.00]", \
				GetInvHeft(InventoryTrunk[id], 24));
			strcat(str_2, str_1);
		}
		else player_InvType{playerid} = 255;
	}
	else if(player_InvType{playerid} == 3)
	{
		new id = player_GarageEntered[playerid];
		if(id != -1)
		{
			if(statusBag == 1) strcat(str_2, ",");
			str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,\"Багажник\",%.2f,20.00]", \
				GetInvHeft(InventoryGarage[id], 24));
			strcat(str_2, str_1);
		}
		else player_InvType{playerid} = 255;
	}
}
stock IsTrunkDostup(playerid)
{
	new id = player_TrunkOpen[playerid];
	if(id != -1)
	{
		id = OwnableCar[player_TrunkOpen[playerid]];
		if(id != INVALID_VEHICLE_ID)
		{
			if(!CarData[player_TrunkOpen[playerid]][cBagAll] && !GetString(CarData[player_TrunkOpen[playerid]][cOwner], PN(playerid))) 
			{
				OpenInterface[playerid][7] = false;
				OnPlayerInventory(playerid, 0);
				SCM(playerid, 0x999999FF, !"Багажник закрыт");
				return -2;
			}
			return player_TrunkOpen[playerid];
		}
	}
	return -1;
}
