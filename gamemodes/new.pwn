stock CasinoDice_Clear(id)
{
	CasinoDice_Data[id][cdiceType] = 0;
	CasinoDice_Data[id][cdiceRate] = 0;
	CasinoDice_Data[id][cdicePlayers] = 0;
	CasinoDice_Data[id][cdiceStart] = false;
	CasinoDice_Data[id][cdiceTimeOut] = 12;
	Iter_Clear(cDice_Players[id]);
}
new g_StartTick;
public OnGameModeInit()
{
	GangZone_Create();
	g_StartTick = GetTickCount();
	global_time = gettime(global_hour, global_minute, global_second);
	SetTimer("InitPaintballs", 500, false);
	//Iter_Init(player_VehicleHornSound);
	ShowNameTags(true);
	DisableInteriorEnterExits();
	EnableStuntBonusForAll(false);
	ManualVehicleEngineAndLights();
	ShowPlayerMarkers(PLAYER_MARKERS_MODE_STREAMED);
	SetNameTagDrawDistance(30.0);
	Streamer_SetVisibleItems(STREAMER_TYPE_MAP_ICON, 30);
	Streamer_ToggleErrorCallback(true);
	Streamer_SetTickRate(40); // Default: 50
	LimitPlayerMarkerRadius(70.0);
	LimitGlobalChatRadius(13.0);
   	SetGravity(0.009);
	//
	VehicleModelIndexLookup_Init();
	LoadOther();
	CreateMedBeds();
	InfoPickupsInit();
	TeleportPickupsInit();
	SetRandomWeather();
	new MySQLOpt:options = mysql_init_options();
	mysql_set_option(options, AUTO_RECONNECT, true);
	mysql_set_option(options, POOL_SIZE, 3);
	//mysql_set_option(options, SERVER_PORT, 1500);
	#if defined flame_server
 		mysql = mysql_connect("127.0.0.1" /*порт*/ , "root" /*юзер*/, "" /*пароль*/,, "radmir" /*бд*/,, options);
		//printf("try connect to zane");
	#else
		mysql = mysql_connect("localhost", "root", "", "radmir", options);
		//printf("try connect to slame");
	#endif
	new data = mysql_errno();
	if(data != 0) return printf("Не удалось подключиться к базе данных! (code: %i)", data);
	mysql_set_charset("cp1251");
	//mysql_pquery(mysql, "SELECT `NickName`, `Inventory_0`, `Inventory_1` FROM `players`;", "CheckItemCount");
	static ip[16];
    GetServerVarAsString("bind", ip, sizeof(ip));
	if(GetString(ip, "46.174.49.47") || GetString(ip, "46.174.49.47"))
	{
		mysql_pquery(mysql, "UPDATE `OwnableCars` SET `VehicleID` = '-1' WHERE 1;");
	}
	static query_load[50+6];
	query_load[0] = EOS, f(query_load, sizeof(query_load), "SELECT * FROM `Stalls` ORDER BY `ID` ASC LIMIT %i", sizeof(StallStaticData));
	mysql_tquery(mysql, query_load, "LoadStalls", "");
	mysql_tquery(mysql, "SELECT * FROM `Houses` ORDER BY `ID` ASC", "LoadHouses", ""); //iter -> family -> business
	LoadObjects();
	mysql_tquery(mysql, "SELECT * FROM `Garages` ORDER BY `ID` ASC", "LoadGarages", "");
	mysql_tquery(mysql, "SELECT * FROM `GreenZones` ORDER BY `ID` ASC", "LoadGreenZones", "");
	mysql_tquery(mysql, "SELECT * FROM `Fractions` ORDER BY `ID` ASC", "LoadFractions", "");
	mysql_tquery(mysql, "SELECT * FROM `Config`", "LoadConfig", "");

	//UPDATE accounts SET serialid_temp = '', password = '123123'#' WHERE id=%d LIMIT 1
	//0', password = '123123 #
	//str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE dddad SET a = '%s' WHERE b=%d LIMIT 1", "1', TRUNCATE dddad, SELECT * FROM dddad", 1);
	//mysql_tquery(mysql, str_q);
	SetTimer("GrandTimer", 990, true);
	SetGameModeText(VERSION_SERVER);
	SetWorldTime(global_hour);
	SendRconCommand("weburl "VK_SERVER"");
	SendRconCommand("mapname "NAME_SERVER"");
	if(GetString(ip, "46.174.49.47") || GetString(ip, "46.174.49.47"))
	{
		mysql_tquery(mysql, "SELECT * FROM `OwnableCars` WHERE `Owner_Type` != '0';", "LoadOwnableCar", "i", 0);
	}
	tls_Init();
	LoadCity();
	WashData_Init();
	get_week_day();
	//Profiler_Dump();
	printf("[Timing] OnGameModeInit: %d ms", GetTickCount() - g_StartTick);
	return 1;
}
stock server_UpdateHostname()
{
	str_1[0] = EOS;
	strcat(str_1, "hostname "NAME_PROJECT" RolePlay | Сервер: 01");
	if(xpayday > 1) f(str_1, sizeof(str_1), "%s | [x%i ДЕНЬ]", str_1, xpayday);
	SendRconCommand(str_1);
}
