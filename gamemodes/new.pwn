new
	tls_Object[sizeof(TLSData)] = {-1, ...},
	tls_Area[sizeof(TLSData)] = {-1, ...},
	tls_Type[sizeof(TLSData)] = {1, ...},
	bool:tls_TypeOld[sizeof(TLSData)],
	tls_Timer[sizeof(TLSData)] = {10, ...};
stock tls_Init()
{
	for(new i; i < sizeof(TLSData); i++)
	{
		tls_Area[i] = CreateDynamicSphere(TLSData[i][tlsPosition][0], TLSData[i][tlsPosition][1], TLSData[i][tlsPosition][2], 8.0, 0, 0);
		tls_Object[i] = CreateDynamicObject(10425, TLSData[i][tlsPosition][0], TLSData[i][tlsPosition][1], TLSData[i][tlsPosition][2], 0.0, 0.0, TLSData[i][tlsPosition][3], 0, 0);
		tls_Type[i] = 1;
		tls_TypeOld[i] = TLSData[i][tlsPointNext];
	}
}
stock tls_Update()
{
	/*
	tls_Type
		0 зеленый
		1 желтый
		2 красный
	*/
	for(new i, bool:update; i < sizeof(TLSData); i++)
	{
		if(global_hour > 21 || global_hour < 6) 
		{
			tls_Type[i] = 1;
			update = true;
			tls_TypeOld[i] = !tls_TypeOld[i];
			Streamer_SetFloatData(STREAMER_TYPE_OBJECT, tls_Object[i], E_STREAMER_Z, TLSData[i][tlsPosition][2] + (!tls_TypeOld[i] ? -10.0 : 0.0));
		}
		else if(tls_Type[i] == 1)
		{
			tls_TypeOld[i] = !tls_TypeOld[i];
			tls_Type[i] = (!tls_TypeOld[i] ? 0 : 2);
			tls_Timer[i] = 10;
			update = true;
		}
		else
		{
			tls_Timer[i]--;
			if(!tls_Timer[i])
			{
				tls_Type[i] = 1;
				update = true;
			}
		}
		if(update != false)
		{
			Streamer_SetIntData(STREAMER_TYPE_OBJECT, tls_Object[i], E_STREAMER_MODEL_ID, tls_StaticColor[tls_Type[i]]);
		}
	}
	return 1;
}
