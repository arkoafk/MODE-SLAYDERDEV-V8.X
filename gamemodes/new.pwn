	format(str_mes, sizeof str_mes, "[A] %s[%i] установил %s[%i] вирт.мир №%i", PN(playerid), playerid,
		PN(to_player), to_player, world);
	SendAdminsMessage(0x999999FF, str_mes);

	format(str_mes, sizeof str_mes, "Установил %s[acc:%i] вирт.мир %i", PN(to_player), GetPlayerAccountID(to_player), world);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

