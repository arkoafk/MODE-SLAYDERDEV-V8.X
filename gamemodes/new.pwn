stock ShowPlayerReportSPD(playerid)
{
	SPD(playerid, DIALOG_REPORT, DIALOG_STYLE_INPUT,
		"{FFCD00}Связь с администрацией","\
		{FFFFFF}Введите свое сообщение для администрации сервера<n>\
		Оно должно быть кратким и ясным<n><n>\
		{66CC66}Если вы хотите подать жалобу на игрока,<n>\
		обязательно укажите его ID и причину жалобы<n><n>\
		{999999}Если Вы хотите задать вопрос, используйте команду /faq", "Отправить","Назад");
}
stock SendAdminsMessage(color, const message[])
{
	new count;
	foreach(new i: PlayersAdmin)
	{
		if(!IsPlayerLogged(i)) continue;
		if(!PI[i][pAdmin] || !PI[i][pTemp_ADuty]) continue;
		SCM(i, color, message);
		count ++;
	}
	return count;
}
stock SendYoutubesMessage(const message[])
{
	new count;
	foreach(new i: Player)
	{
		if(!IsPlayerLogged(i)) continue;
		if(!PI[i][pYouTube]) continue;
		SCM(i, 0xcccc00FF, message);
		count ++;
	}
	return count;
}
stock HidePlayerSPD(playerid)
{
	ExecutePacket(playerid, webUpdate, "closeLastDialog();");
}
stock ShowCurrentTime(playerid)
{
	new year, month, day;

	getdate(year, month, day);

	SetPlayerChatBubble(playerid, "звонит в службу точного времени...", 0xDD90FFFF, 25.0, 7000);
	if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "COP_AMBIENT", "Coplook_watch", 4.0, false, 0, 0, 0, 0, 0);

	str_1[0] = EOS, f(str_1, sizeof str_1, "~y~%i:%02d~n~~w~%02d.%02d.%i", global_hour, global_minute, day, month, year);
	GameTextForPlayerEx(playerid, str_1, 3000, 2);

	str_1[0] = EOS, f(str_1, sizeof str_1,"\
		{FFFFFF}Здравствуйте!\n\
		Вы позвонили в службу точного времени\n\n\
		Сегодняшняя дата:\t\t{66CC00}%i %s %i г.\n\
		{FFFFFF}День недели:\t\t\t{66CC00}%s\n\
		{FFFFFF}Текущее время:\t\t{3399FF}%i:%02d\n\n\
		{FFFFFF}Время в игре за час:\t\t{FF7000}%i мин\n\
		{FFFFFF}Время в игре сегодня:\t{FF7000}%i ч %i мин\n\
		{FFFFFF}Время в игре вчера:\t\t{FF7000}%i ч %i мин",
			day,
			GetMonthName(month),
			year,
			GetDayName(GetDayOfWeek(year, month, day)),
			global_hour,
			global_minute,
			ConvertUnixTime(GetPlayerData(playerid, pGameTime_forHour), CONVERT_TIME_TO_MINUTES),
			ConvertUnixTime(PI[playerid][pGameTime_forDay][0], CONVERT_TIME_TO_HOURS),
			ConvertUnixTime(PI[playerid][pGameTime_forDay][0], CONVERT_TIME_TO_MINUTES),
			ConvertUnixTime(PI[playerid][pGameTime_forDay][1], CONVERT_TIME_TO_HOURS),
			ConvertUnixTime(PI[playerid][pGameTime_forDay][1], CONVERT_TIME_TO_MINUTES)
	);
	SCM(playerid, 0x99CC00FF, "Вы позвонили в службу точного времени");

	return SPD(playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FFCD00}Точное время", str_1, "Закрыть", "");
}

stock GetDayOfWeek(year, month, day)
{
    new a = (14 - month) / 12;
    new y = year + 4800 - a;
	new m = month + 12 * a - 3;
	new c_date = day + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045;
	new day_of_week = c_date % 7 + 1;

    return day_of_week;
}
stock SPD(playerid, dialogid, style, const caption[], const info[], const button1[], const button2[] = "", const info_2[] = "", bool:back = false, bool:next = false)
{
	if(!OpenInterface[playerid][5]) OpenInterface[playerid][5] = true;
	player_DialogID[playerid] = dialogid;
	player_MultiDialog_Back{playerid} = back;
	player_MultiDialog_Next{playerid} = next;
	str_d[0] = EOS;
    for (new i = sizeof str_d - 1; i != -1; i--)
	{
        str_d[i] = '\0';
	}
    for(new i, j; info[i] != '\0'; i++) 
	{
		if(i > 4094 || j > 4094)
		{
			break;
		}
        if (info[i] == '\n') strcat(str_d, "<n>"), j += 3;
        else if(info[i] == '\t') strcat(str_d, "<t>"), j += 3;
        else if(info[i] == '\"') str_d[j++] = '\'';
        else str_d[j++] = info[i];
    }
	str_1[0] = EOS, f(str_1, sizeof str_1, "window.addDialogInQueue('[%i,%i,\"%s\",\"%s\",\"%s\",\"%s\",%i,%i]', \"%s\", 0)", 0, style, caption, info_2, button1, button2, back, next, str_d);
	ExecutePacket(playerid, webUpdate, str_1);
	return 1;
}
#define acc_ShowPlayerDialog SPD
stock ShowCheckPassword(playerid)
{
	ShowPlayerDialog(playerid, 2394, DIALOG_STYLE_PASSWORD, !"{FFFFFF}Аутентификация", !"{FFFFFF}Введите пароль от сервера\nАвторизация/Регистрация автоматически появится при {FFCD00}СНЯТИИ {FFFFFF}пароля!", !"Далее", !"");
	return SCM(playerid,0xFFCD00FF,!"Авторизация/Регистрация появится автоматически при СНЯТИИ пароля!");
}
stock abs(value) return value = -value;
stock IsNumeric(const dest[], pos=0)
{
	do
	{
		switch(dest[pos])
		{
			case '0'..'9': continue;
			default: return false;
		}
	}
	while(dest[++pos]);
	return true;
}
stock IsIntEx(money, add)
{
	new count = money+add;
	if(count > 2000000000 || count < 0) return 0;
	return 1;
}
stock GivePlayerMoneyEx(playerid, money, const desc[]="None", bool:save=true, bool:game_text=true)
{
	AddInt64(playerid, money);
	if(!GetString(desc, "None"))
	{
		string_log[0] = EOS, f(string_log, sizeof(string_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(string_log, sizeof(string_log), "Игрок %s получил %i руб. Причина: %s", string_log, money, desc);
		SendLog(0, string_log);
	}
	if(save)
	{

	}
	//player_SaveCash{playerid} = 2;
	if(game_text != false)
	{
		str_1[0] = EOS, f(str_1, sizeof str_1, "%s%i рублей", money < 0 ? ("~r~") : ("~g~+"), money);
		GameTextForPlayerEx(playerid, str_1, 3000, 2);
	}
	return 1;
}
stock player_Hud_MoneyUpdate(playerid)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Cash` FROM players WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q, "callback_CheckInt64", "i", playerid);
}
stock GivePlayerDonate(playerid, donate, const desc[]="None", bool:save=true, bool:game_text=true)
{
	new count = PI[playerid][pCash_Donate]+donate;
	if(count > 2000000000 || count < 0) donate = 0;
	PI[playerid][pCash_Donate] += donate;
	player_SaveCash_Donate{playerid} = 3;
	ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerDonate('%i')", PI[playerid][pCash_Donate])));
	if(game_text)
	{
		str_1[0] = EOS, f(str_1, sizeof str_1, "~w~%s%i coins", donate < 0 ? ("") : ("+"), donate);
		GameTextForPlayerEx(playerid, str_1, 4000, 2);
	}
	if(save)
	{

	}
	if(!GetString(desc, "None"))
	{
		string_log[0] = EOS, f(string_log, sizeof(string_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(string_log, sizeof(string_log), "Игрок %s получил %i доната. Причина: %s", string_log, donate, desc);
		SendLog(0, string_log);
	}
	return 1;
}

stock SendMessageInLocal(playerid, const message[], color, Float: radius = 30.0)
{
	static Float: x, Float: y, Float: z;
	GetPlayerPos(playerid, x, y, z);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerLogged(i) || GetPlayerVirtualWorld(i) != GetPlayerVirtualWorld(playerid) || !IsPlayerInRangeOfPoint(i, radius, x, y, z)) continue;
		SCM(i, color, message);
	}
	return 1;
}

stock Action(playerid, const message[], Float:radius=25.0, bool:bubble=true, color = 0xDD90FFFF)
{
	if(bubble) SetPlayerChatBubble(playerid, message, color, radius, 7000);
	str_1[0] = EOS, f(str_1, sizeof str_1, "%s %s", PN(playerid), message);
	SendMessageInLocal(playerid, str_1, color, radius);
	return 1;
}

stock EnablePlayerGPS(playerid, markertype, Float: x, Float: y, Float: z, const message[] = "Место отмечено у Вас на GPS")
{
	DisablePlayerGPS(playerid);
	SetPlayerMapIcon(playerid, 98, x, y, z, markertype, 0, MAPICON_GLOBAL);
	player_GPS_AreaID[playerid] = CreateDynamicSphere(x, y, z, 30.0, -1, -1, playerid);
	static 
		Gps[128], Float:px, Float:py, Float:pz;
	GetPlayerPos(playerid, px, py, pz);
	format(Gps, sizeof Gps, "window.getRoute(%f, %f, %f, %f, %f, %f, 0, 1)", px, py, pz, x, y, z);
	ExecutePacket(playerid, webUpdate, Gps);
	if(strlen(message)) SCM(playerid, 0xFFFF00FF, message);
	if(GetPlayerAdminEx(playerid) > 2)
	{
		SPD(playerid, DIALOG_GOTO_GPS, DIALOG_STYLE_MSGBOX, "Подтверждение", "Вы действительно хотите телепортироваться на это место?", "Да", "Отмена");
	    SetPVarFloat(playerid, "goto_x", x);
		SetPVarFloat(playerid, "goto_y", y);
		SetPVarFloat(playerid, "goto_z", z);
		return 1;
	}
	return 1;
}
stock DisablePlayerGPS(playerid)
{
	if(player_GPS_AreaID[playerid] != -1)
	{
		DestroyDynamicArea(player_GPS_AreaID[playerid]);
		player_GPS_AreaID[playerid] = -1;
	}
	RemovePlayerMapIcon(playerid, 98);
}
stock IsPlayerInRangeOfPlayer(playerid, to_player, Float: distance)
{
	new Float: x, Float: y, Float: z;
	GetPlayerPos(to_player, x, y, z);

	return IsPlayerInRangeOfPoint(playerid, distance, x, y, z);
}
stock ApplyAnimationEx(playerid, const animlib[], const animname[], Float:fDelta, loop, lockx, locky, freeze, time, forcesync, anim_type=USE_ANIM_TYPE_NONE)
{
	if(strlen(animlib) > 35 || strlen(animname) > 35 || strlen(animname) < 2 || strlen(animname) < 2) return 0;
	SetPlayerData(playerid, pTemp_AnimType, anim_type);
	ApplyAnimation(playerid, animlib, animname, fDelta, loop, lockx, locky, freeze, time, forcesync);
	if(player_ShowData[playerid][111] != 6) 
	{
		ExecutePacket(playerid, webOpen, "Interactions", "[[73,\"Выключить анимацию\"]]");
		PI[playerid][pTemp_AnimUsed] = true;
	}
	return 1;
}
stock SendPlayerOffer(playerid, to_player, type, value_1 = 0, value_2 = 0)
{
	if(GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER) == INVALID_PLAYER_ID)
	{
		switch(type)
		{
			case OFFER_TYPE_HANDSHAKE:
			{
				f(str_1, sizeof str_1, "Игрок %s предлагает пожать Вам руку", PN(playerid));
				SCM(to_player, 0x3399FFFF, str_1);
				f(str_1, sizeof str_1, "Вы предложили %s пожать руку", PN(to_player));
				SCM(playerid, 0x3399FFFF, str_1);
			}
			case OFFER_TYPE_KISS:
			{
				format(str_1, sizeof str_1, "Игрок %s предлагает поцеловаться с Вами", PN(playerid));
				SCM(to_player, 0x3399FFFF, str_1);
				format(str_1, sizeof str_1, "Вы предложили %s поцеловаться с Вами", PN(to_player));
				SCM(playerid, 0x3399FFFF, str_1);
			}
			case OFFER_TYPE_INVITE:
			{
				SCMf(to_player, 0x3399FFFF, "%s предлагает Вам вступить в организацию \"%s\"", PN(playerid), FractionStaticData[PI[playerid][pMember_ID]][frName]);
				SCMf(playerid, 0x3399FFFF, "Вы предложили %s вступить в организацию \"%s\"", PN(to_player), FractionStaticData[PI[playerid][pMember_ID]][frName]);
			}
			case OFFER_TYPE_FINVITE:
			{
				new id = GetFamilyID(PI[playerid][pFamily_ID]);
				if(id >= 0)
				{
					format(str_1, sizeof str_1, "%s предлагает Вам вступить в семью/банду \"%s\"", PN(playerid), FamilyData[id][fName]);
					SCM(to_player, 0x3399FFFF, str_1);
					format(str_1, sizeof str_1, "Вы предложили %s вступить в семью/банду \"%s\"", PN(to_player), FamilyData[id][fName]);
					SCM(playerid, 0x3399FFFF, str_1);
				}
			}
			case OFFER_TYPE_MEDHELP:
			{
				format(str_1, sizeof str_1, "%s предлагает Вам пройти курс платного лечения за %i руб", PN(playerid), value_1);
				SCM(to_player, 0x3399FFFF, str_1);
				format(str_1, sizeof str_1, "Вы предложили %s пройти у Вас курс платного лечения за %i руб", PN(to_player), value_1);
				SCM(playerid, 0x3399FFFF, str_1);
			}
			case OFFER_TYPE_HEAL:
			{
				format(str_1, sizeof str_1, "%s предлагает Вам пройти курс лечения за %i руб", PN(playerid), value_1);
				SCM(to_player, 0x3399FFFF, str_1);
				format(str_1, sizeof str_1, "Вы предложили %s пройти у Вас курс лечения за %i руб", PN(to_player), value_1);
				SCM(playerid, 0x3399FFFF, str_1);
			}
			case OFFER_TYPE_CHANGE_SEX:
			{
				format(str_1, sizeof str_1, "%s предлагает сделать Вам операцию по смене пола за %i руб", PN(playerid), value_1);
				SCM(to_player, 0x3399FFFF, str_1);
				format(str_1, sizeof str_1, "Вы предложили %s операцию по смене пола за %i руб", PN(to_player), value_1);
				SCM(playerid, 0x3399FFFF, str_1);
			}
			default: return 1;
		}
		SCM(to_player, 0xFFFFFFFF, "Нажмите {00CC00}Y {FFFFFF}для согласия или {FF6600}N {FFFFFF}для отказа");
		SetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER, to_player);

		SetPlayerOfferInfo(to_player, O_INCOMING_PLAYER, playerid);
		SetPlayerOfferInfo(to_player, O_INCOMING_TYPE, type);

		SetPlayerOfferValue(to_player, 0, value_1);
		SetPlayerOfferValue(to_player, 1, value_2);
	}
	else SCM(playerid, 0xFFFFFFFF, !"Используйте {FF9900}/cancel {FFFFFF}чтобы отозвать предыдущее предложение");

	return 1;
}

// ------------------------------------------
CMD:yes(playerid)
{
    new offer_id = GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER);
	new offer_type = GetPlayerOfferInfo(playerid, O_INCOMING_TYPE);

	//new value_1 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[0];
	//new value_2 = GetPlayerOfferInfo(playerid, O_INCOMING_VALUE)[1];

	if(offer_id != INVALID_PLAYER_ID)
	{
		if(IsPlayerConnected(offer_id) && IsPlayerLogged(offer_id))
		{
			if(GetPlayerOfferInfo(offer_id, O_OUTCOMIG_PLAYER) == playerid)
			{
				ClearPlayerOffer(offer_id);
			}
            else offer_type = -1;
			static Float: x, Float: y, Float: z;
			static Float: dist;

			GetPlayerPos(offer_id, x, y, z);

			dist = 5.0;

			if(dist <= 10.0)
			{
				switch(offer_type)
				{
					case OFFER_TYPE_INVITE:
					{
						if(GetPlayerData(playerid, pWarn)) return SCM(playerid, 0xCECECEFF, !"У вас есть предупреждения");
						if(IsPlayerFraction(playerid) <= 0) return SCM(playerid, 0xCECECEFF, !"У вас уже есть организация");
						if(PI[offer_id][pMember_Rang] < 8)
						{
							SCM(playerid, 0xCECECEFF, !"У данного игрока нет доступа.");
						}
						else
						{
							fraction_InvitePlayer(playerid, PI[offer_id][pMember_ID]);
							SCMf(playerid, 0x66CC00FF, "Поздравляем! Вы вступили в организацию \"%s\"", FractionStaticData[PI[offer_id][pMember_ID]][frName]);
							SCMf(offer_id, 0x66CC00FF, "%s принял Ваше предложение вступить в организацию", PN(playerid));
							
							str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
							f(str_log, sizeof(str_log), "Лидер/Зам %s принял во фракцию %s, игрока %s", str_log, FractionStaticData[PI[offer_id][pMember_ID]][frName], PN(offer_id));
							SendLog(0, str_log);
						}
					}
					case OFFER_TYPE_FINVITE:
					{
						new id = GetFamilyID(PI[offer_id][pFamily_ID]);
						str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s [%i] принял игрока %s [%i]", FamilyData[id][fName], PN(offer_id), offer_id, PN(playerid), playerid);
						SendFamilyMessage(offer_id, str_mes);
						family_InvitePlayer(playerid, PI[offer_id][pFamily_ID], PN(offer_id));
						SCMf(playerid, 0x32a44bFF, "Поздравляем! Вы вступили в семью/банду \"%s\"", FamilyData[id][fName]);
						SCM(playerid, 0x1E90FFFF, !"Используйте {d8284c}/fmenu > помощь по семье{1E90FF}, чтобы узнать о новых возможностях");
						SCMf(offer_id, 0x32a44bFF, "%s принял Ваше предложение вступить в семью/банду", PN(playerid));
					}
					case OFFER_TYPE_HANDSHAKE:
					{
						if(!(IsPlayerInAnyVehicle(playerid) && IsPlayerInAnyVehicle(offer_id)))
						{
							new Float: to_x, Float: to_y;
							new Float: angle;

							GetPlayerPos(playerid, to_x, to_y, z);
							angle = GetAngleToPoint(x, y, to_x, to_y);

							SetPlayerFacingAngle(playerid, angle);
							SetPlayerFacingAngle(offer_id, angle + 180.0);

							format(str_mes, sizeof str_mes, "пожал(а) руку %s", PN(offer_id));
							Action(playerid, str_mes, _, false);

							ApplyAnimation(playerid, "GANGS", "hndshkfa", 4.1, 0, 1, 1, 0, 0, 1);
							ApplyAnimation(offer_id, "GANGS", "hndshkfa", 4.1, 0, 1, 1, 0, 0, 1);
						}
						else SCM(playerid, 0xCECECEFF, !"Вы либо игрок не должны находиться в транспорте");
					}
                    case OFFER_TYPE_KISS:
					{
						if(!(IsPlayerInAnyVehicle(playerid) && IsPlayerInAnyVehicle(offer_id)))
						{
							new Float: to_x, Float: to_y;
							new Float: angle;

							GetPlayerPos(playerid, to_x, to_y, z);
							angle = GetAngleToPoint(x, y, to_x, to_y);

							SetPlayerFacingAngle(playerid, angle);
							SetPlayerFacingAngle(offer_id, angle + 180.0);

							format(str_mes, sizeof str_mes, "поцеловался с %s", PN(offer_id));
							Action(playerid, str_mes, _, false);

							ApplyAnimation(playerid, "KISSING", "Playa_Kiss_02", 4.1, 0, 1, 1, 0, 0, 1);
							ApplyAnimation(offer_id, "KISSING", "Playa_Kiss_02", 4.1, 0, 1, 1, 0, 0, 1);
						}
						else SCM(playerid, 0xCECECEFF, !"Вы либо игрок не должны находиться в транспорте");
					}
					default:
						SCM(playerid, 0x999999FF, !"В данный момент Вам ничего не предлагают");
				}
			}
			else SCM(playerid, 0x999999FF, !"Игрок слишком далеко");
		}
		else SCM(playerid, 0x999999FF, !"Игрок вышел из игры");

		ClearPlayerOffer(playerid);
	}
	else SCM(playerid, 0x999999FF, !"В данный момент Вам ничего не предлагают");

	return 1;
}

CMD:no(playerid)
{
	new offer_id = GetPlayerOfferInfo(playerid, O_INCOMING_PLAYER);

	if(offer_id != INVALID_PLAYER_ID)
	{
		if(GetPlayerOfferInfo(offer_id, O_OUTCOMIG_PLAYER) == playerid)
		{
			ClearPlayerOffer(offer_id);

			format(str_mes, sizeof str_mes, "%s отказался от Вашего предложения", PN(playerid));
			SCM(offer_id, 0xFF6600FF, str_mes);

			format(str_mes, sizeof str_mes, "Вы отказались от предложения игрока %s", PN(offer_id));
			SCM(playerid, 0xFF6600FF, str_mes);

			GameTextForPlayerEx(offer_id, "~r~no", 4000, 1);
		}
		else SCM(playerid, 0xFF6600FF, !"Вы отказались от предложения игрока");
	}
	else SCM(playerid, 0x999999FF, !"В данный момент Вам ничего не предлагают");

	ClearPlayerOffer(playerid);
	return 1;
}

CMD:cancel(playerid, params[])
{
	new offer_id = GetPlayerOfferInfo(playerid, O_OUTCOMIG_PLAYER);

	if(offer_id != INVALID_PLAYER_ID)
	{
		if(GetPlayerOfferInfo(offer_id, O_INCOMING_PLAYER) == playerid)
		{
			ClearPlayerOffer(offer_id);

			format(str_mes, sizeof str_mes, "%s отозвал свое предложение", PN(playerid));
			SCM(offer_id, 0xFF6600FF, str_mes);

			format(str_mes, sizeof str_mes, "Вы отозвали свое предложение для %s", PN(offer_id));
			SCM(playerid, 0xFF6600FF, str_mes);
		}
		else SCM(playerid, 0xFF6600FF, !"Вы отозвали свое последнее предложение");

		ClearPlayerOffer(playerid);
	}
	else SCM(playerid, 0xCECECEFF, !"У Вас нет активных предложений");

	return 1;
}

CMD:hi(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
		return SCM(playerid, 0x999999FF, !"Нельзя использовать в машине");
	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /hi [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(OpenInterface[to_player][6] != false) return SCM(playerid, 0x999999FF, !"Вы находитесь слишком далеко от игрока");

	static Float: to_x, Float: to_y, Float: z;
	GetPlayerPos(to_player, to_x, to_y, z);

	new Float: dist = GetPlayerDistanceFromPoint(playerid, to_x, to_y, z);
	if(0.5 <= dist <= 2.5)
	{
		SendPlayerOffer(playerid, to_player, OFFER_TYPE_HANDSHAKE);
	}
	else if(dist < 20.0)
	{
		new Float: x, Float: y;
		new Float: angle;

		GetPlayerPos(playerid, x, y, z);
		angle = GetAngleToPoint(to_x, to_y, x, y);

		SetPlayerFacingAngle(playerid, angle);

		format(str_mes, sizeof str_mes,"машет рукой %s", PN(to_player));
		Action(playerid, str_mes, _, false);

		ApplyAnimation(playerid, "PED", "endchat_03", 4.1, 0, 1, 1, 0, 0, 1);
	}
	else SCM(playerid, 0x999999FF, !"Вы находитесь слишком далеко от игрока");

	return 1;
}

CMD:me(playerid, params[])
{
	if(IsPlayerMuted(playerid))
		return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /me [текст]");

	return Action(playerid, params);
}

CMD:do(playerid, params[])
{
	if(IsPlayerMuted(playerid))
		return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /do [текст]");

	SetPlayerChatBubble(playerid, params, 0xDD90FFFF, 25.0, 5000);

	f(str_mes, sizeof str_mes, "%s%s (%s)", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{DD90FF} " : ""), params, PN(playerid));
	SendMessageInLocal(playerid, str_mes, 0xDD90FFFF, 25.0);

	return 1;
}
CMD:try(playerid, params[])
{
