new gzData[MAX_GREEN_ZONES][E_GREEN_ZONES_STRUCT],
	TOTAL_GREENZONES,
	gzArea[MAX_GREEN_ZONES] = {-1, ...};

public: LoadGreenZones()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++) 
	{
		stat = LoadGreenZoneMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[GreenZones]: зеленых зон загружено -> %i", TOTAL_GREENZONES);
	else printf("[GreenZones]: UNKNOWN ( all stat -> %i)", TOTAL_GREENZONES);
}
public: LoadGreenZoneMySQL(id)
{
	cache_get_int(id, "ID", gzData[TOTAL_GREENZONES][gzID]);
	cache_get_string(id, !"Position", str_2), sscanf(str_2, "p<,>a<f>[4]", gzData[TOTAL_GREENZONES][gzPosition]);
	cache_get_string(id, "Name", gzData[TOTAL_GREENZONES][gzName]);
	cache_get_int(id, "AllowPark", gzData[TOTAL_GREENZONES][gzAllowPark]);
	cache_get_int(id, "Status", gzData[TOTAL_GREENZONES][gzStatus]);
	cache_get_float(id, "Radius", gzData[TOTAL_GREENZONES][gzRadius]);
	gzArea[TOTAL_GREENZONES] = CreateDynamicSphere(gzData[TOTAL_GREENZONES][gzPosition][0], gzData[TOTAL_GREENZONES][gzPosition][1], gzData[TOTAL_GREENZONES][gzPosition][2], gzData[TOTAL_GREENZONES][gzRadius]);
	TOTAL_GREENZONES++;
	return 1;
}
