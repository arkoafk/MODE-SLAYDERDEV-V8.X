}
stock player_Accessories_Change(playerid, item)
{
	GetAccessoriesData(playerid, item);
	ExecutePacket(playerid, webUpdate, (str_f("interface('Accessories').setItems('[%s]')", str_2)));
	return 1;
}
stock player_Accessories_Click(playerid, item)
{
	RemovePlayerAttachedObject(playerid, 8);
	SetPlayerAttachedObject(playerid, 8, AccessoriesData[item][acsModel], GetBoneAks(AccessoriesData[item][acsModel]));
	EditAttachedObject(playerid, 8);
	return 1;
}
stock player_Accessories_Buy(playerid, item)
{
	new bizid = player_BizEntered[playerid];
	if(bizid != -1)
	{
		new cost = AccessoriesData[item][acsCost]*BizData[bizid][bProductEx];
		if(CompareInt64(playerid, "<", cost)) return GameTextForPlayerEx(playerid, "У вас недостаточно денег", 1800, 1);
		//if(GetStrMoney(playerid) < cost) return GameTextForPlayerEx(playerid, "У вас недостаточно денег", 1800, 1);
		GameTextForPlayerEx(playerid, "~g~Вы успешно купили ~n~~g~ данный аксессуар", 1800, 1);
		ExecutePacket(playerid, webUpdate, "interface('Accessories').closePayment()");
		GiveBusinessMoney(playerid, player_BizEntered[playerid], cost/8, 0);
		GivePlayerMoneyEx(playerid, -cost, (str_f("Магазин аксессуаров №%i", player_BizEntered[playerid])));
		static const invID[] = {0, 181,182,183,184,185,219,220,221,222,260};
		str_log[0] = EOS;
		f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		strcat(str_log, "Магазин аксессуаров");
		InvAdd(playerid, invID[AccessoriesData[item][acsType]+1], 1, "", AccessoriesData[item][acsModel], 0, "", str_log);
	}
	return 1;
}
//static const unique_car[] = {400,467,16900,15622};
stock IsUniqueCar(modelid)
{
	//for(new i; i < sizeof unique_car; i++) if(unique_car[i] == modelid) return 0;
	for(new i; i < sizeof(donate_Cars); i++)
	{
		if(donate_Cars[i][ddModel] == modelid) return 0;
	}
	return 1;
}
CMD:eat(playerid)
{
	if(!player_EatTrash{playerid}) SCM(playerid,-1717986817, "У Вас нет с собой еды");
	else
	{
		player_EatTrash{playerid} = false;
		SetPlayerSpecialAction(playerid, 0);
		RemovePlayerAttachedObject(playerid, 5);
		player_UpdateAcs(playerid, playerid, 5);
		SetPlayerHunger(playerid, 30.0);
		ApplyAnimation(playerid,"FOOD","EAT_Burger", 2.0,0,0,0,0,5000,1);
		str_mes[0] = EOS;
        switch(global_hour)
		{
            case 7..12: f(str_mes, sizeof(str_mes), "%s завтракает", PN(playerid));
			case 13..17: f(str_mes, sizeof(str_mes), "%s обедает", PN(playerid));
			case 18..23: f(str_mes, sizeof(str_mes), "%s ужинает", PN(playerid));
			default: f(str_mes, sizeof(str_mes), "%s ест", PN(playerid));
		}
		SetPlayerChatBubble(playerid, str_mes, 0xFFFF00FF, 40.0, 3000);
		ProxDetector(10.0, playerid, str_mes, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
		player_Interaction_Hide(playerid);
	}
	return 1;
}
CMD:pick(playerid) //поднять
{
	if(!player_EatTrash{playerid})
	{
		player_PickEat(playerid);
	}
	else SCM(playerid,-1717986817, "У Вас уже есть собой еда");
	return 1;
}
CMD:put(playerid) //положить
{
	if(!player_EatTrash{playerid}) SCM(playerid,-1717986817, "У Вас нет с собой еды");
	else
	{
		if(!(player_AntiFlood[playerid][5]-global_time > 0))
		{
			player_AntiFlood[playerid][5] = global_time+15;
			new id = Iter_Free(Eat_TrashData);
			if(id == -1) return SCM(playerid, -1717986817, !"В данный момент нельзя выбрасывать еду!");
			static Float:x, Float:y, Float:z;
			GetPlayerPos(playerid, x, y, z);
			SafeDestroy_EatTrash(id);
			ApplyAnimation(playerid, "CARRY", "PUTDWN", 4.0999999046326, 0, 0, 0, 0, 0, 1);
			//3d label
			Eat_Trash3DLabel[id] = CreateDynamic3DTextLabel("Поднять:\n{FFCD00}/pick", -1714683700, x-1.0, y+0.7, z-0.3, 5.0);

			//object
			Eat_TrashObject[id] = CreateDynamicObject(10028, x-1.0, y+0.7, z-0.3, -25.5, 24, 254.80633544922);

			//area
			Eat_TrashArea[id] = CreateDynamicSphere(x, y, z, 2.0);
			Iter_Add(Eat_TrashData, id);
			player_EatTrash{playerid} = false;
			SetPlayerSpecialAction(playerid, 0);
			player_UpdateAcs(playerid, playerid, 5, true);
			player_Interaction_Hide(playerid);
		}
		else SCM(playerid, -1717986817, "Нельзя так, часто выбрасывать еду.");
	}
	return 1;
}
stock player_PickEat(playerid)
{
	new id = player_Enter_EatTrash[playerid];
	if(Iter_Contains(Eat_TrashData, id))
	{
		ApplyAnimation(playerid, "CARRY", "liftup", 4.5999999046326, 0, 0, 0, 0, 0, 1);
		player_PickAdapt(playerid);
		SafeDestroy_EatTrash(id);
		Iter_Remove(Eat_TrashData, id);
	}
	else SCM(playerid,-1717986817, "Рядом с Вами нет еды");
}
stock player_PickAdapt(playerid, const text[]="")
{
	if(strlen(text) > 0)
	{
		SetPlayerChatBubble(playerid, str_mes, 0xFFFF00FF, 40.0, 3000);
		ProxDetector(10.0, playerid, str_mes, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
	}
	player_Interaction_Hide(playerid);
	ExecutePacket(playerid, webOpen, "Interactions", "[[0,\"Перекусить\"],[1,\"Выбросить поднос\"]]");
	player_EatTrash{playerid} = true;
	SetPlayerSpecialAction(playerid, 25);
	RemovePlayerAttachedObject(playerid, 5);
	SetPlayerAttachedObject(playerid, 5, 10028, 13, 0.33000001311302, 0.10499899834394, -0.13999900221825, 80.199928283691, 10.200016021729, -83.700073242188);
}
stock SafeDestroy_EatTrash(id)
{
	if(IsValidDynamic3DTextLabel(Eat_Trash3DLabel[id]))
	{
		DestroyDynamic3DTextLabel(Eat_Trash3DLabel[id]);
		Eat_Trash3DLabel[id] = Text3D:-1;
	}
	if(IsValidDynamicObject(Eat_TrashObject[id]))
	{
		DestroyDynamicObject(Eat_TrashObject[id]);
		Eat_TrashObject[id] = -1;
	}
	if(IsValidDynamicArea(Eat_TrashArea[id]))
	{
		DestroyDynamicArea(Eat_TrashArea[id]);
		Eat_TrashArea[id] = -1;
	}
}
stock player_Interaction_Click(playerid, id)
{
	if(!IsPlayerMobile{playerid})
	{
		player_SetCursorStatus(playerid, false);
		if(player_EatTrash{playerid} != false)
		{
			if(id == 1)
			{
				callcmd::put(playerid);
			}
			else
			{
				callcmd::eat(playerid);
			}
		}
		else if(player_Detailing{playerid} != 255)
		{
			new number = GetVehicleID(GetPlayerVehicleID(playerid));
			if(number != INVALID_VEHICLE_ID)
			{
				if(!GetString(CarData[number][cOwner], PN(playerid)))
				{
					SCM(playerid, 0x999999FF, !"Это не ваша машина!");
					return 1;
				}
				new i = player_Detailing{playerid};
				if(id == 218) player_TintingGarage_Open(playerid, i);
				else if(id == 219) player_detVinyls_Open(playerid, i);
			}
		}
	}
	else
	{
		player_ClientSideALT(playerid);
	}
	return 1;
}

stock player_Interaction_Hide(playerid)
{
	if(player_EatTrash{playerid} != false || player_Canister{playerid} != false || player_Detailing{playerid} != 255) return 0;
	ExecutePacket(playerid, webClose, "Interactions");
	return 1;
}
stock player_SetCursorStatus(playerid, bool:status)
{
	player_CursorData{playerid} = status;
	ExecutePacket(playerid, webUpdate, (str_f("client.setCursorStatus(%s)", (!status ? "false" : "true"))));
}
CMD:call(playerid, params[])
{
	if(!GetPlayerPhone(playerid))
		return SCM(playerid, 0x999999FF, !"У Вас нет телефона. Его можно купить в сотовом салоне");


	if(GetPlayerData(playerid, pPhone_Cash) >= 5)
	{
		new number;
		if(sscanf(params, "d", number)) return SCM(playerid, -1, "/c 060, 60, 111");

		switch(number)
		{
			case 060:
			{
				ShowCurrentTime(playerid);
			}
			case 111:
			{
				SetPlayerPhoneUseState(playerid, true);

				f(str_1, sizeof str_1,"{FFFFFF}Здравствуйте! Вы позвонили оператору.\n\
					На счету Вашего мобильного телефона {00FF00}%i руб\n\n\
					{FFFFFF}Пополнить его можно в любом банкомате.\n\
					Всего доброго!",
					GetPlayerData(playerid, pPhone_Cash));
				SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FFCD00}Оператор сотовой связи", str_1, "Ок", "Отмена");
			}
		}
	}
	else
	{
		SCM(playerid, 0xCECECEFF, !"На счету недостаточно средств");
		SCM(playerid, 0xCECECEFF, !"Пополнить мобильный телефон можно в любом банкомате");
	}
	return 1;
}
alias:call("c")
stock player_addNotif(const owner[], const title[], const text[], const item_add[]="-1,0,0,0")
{
	new playerid = GetPlayerID(owner);
	if(playerid != INVALID_PLAYER_ID)
	{
		ExecutePacket(playerid, webOpen, "Notification", "[0, 1]");
	}
	static string_query[4096];
	string_query[0] = EOS, f(string_query, sizeof(string_query), "\
		INSERT INTO `player_Notification` (`Owner`, `title`, `text`, `inventory_add`, `time`) VALUES \
		('%s', '%s', '%s', '%s', UNIX_TIMESTAMP(NOW()))", owner, title, text, item_add);
	mysql_tquery(mysql, string_query);
}
CMD:notification(playerid)
{
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `ID`, `title`, FROM_UNIXTIME(time, '%%Y-%%m-%%d %%H:%%m:%%s') AS `convert_time` FROM `player_Notification` WHERE `Owner` = '%s' LIMIT 40;", PN(playerid));
	mysql_tquery(mysql, str_q, "player_Notif_List", "i", playerid);
	return 1;
}
alias:notification("nt")
public: player_Notif_List(playerid)
{
	new result = cache_num_rows();
	str_1 = "- Список уведомлений пуст";
	player_ShowID[playerid][0] = -1;
	if(result > 0)
	{
		str_1[0] = EOS;
		for(new i; i < result; i++)
		{
			cache_get_int(i, "ID", player_ShowID[playerid][i]);
			str_mes[0] = EOS, cache_get_string(i, "convert_time", str_mes);
			strcat(str_1, (str_f("- %s |", str_mes)));
			str_mes[0] = EOS, cache_get_string(i, "title", str_mes);
			strcat(str_1, (str_f("%s\n", str_mes)));
		}
	}
	SPD(playerid, 20380, 2, "{3399FF}Список уведомлений [1 / 1]", str_1, "Выбрать","Закрыть");
	return 1;
}
public: player_Notif_Delete(playerid)
{
	new result = cache_num_rows();
	if(result > 0)
	{
		static id;
		cache_get_int(0, "ID", id);
		cache_get_string(0, "text", str_1);
		new item[4],
			itemString[24];
		str_mes[0] = EOS, cache_get_string(0, !"inventory_add", str_mes), sscanf(str_mes, "p<,>iiiis[24]", item[0], item[1], item[2], item[3], itemString);
		if(item[0] > 0)
		{
			strcat(str_1, (str_f("\n\nВыдан предмет %s, в количестве %i, с параметром [%i,%i,%s]", ItemsData[item[0]][ItemName], item[1], item[2], item[3], itemString)));
			str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
			strcat(str_log, "/notification");
			if(InvAdd(playerid, item[0], item[1], "", item[2], 0, itemString, str_log) == 0)
			{
				return 1;
			}
		}
		SPD(playerid, 0, 0, "{3399FF}Уведомление", str_1, "Закрыть");
		mysql_tquery(mysql, (str_f("DELETE FROM `player_Notification` WHERE `ID` = '%i' LIMIT 1;", id)));
	}
	return 1;
}
stock player_CasinoExchange_Open(playerid)
{
	ExecutePacket(playerid, webOpen, "CasinoExchange", (str_f("[0,[%i,%i],[%s,%i]]", (player_BizEntered[playerid] == -1 ? 13000000 : 10000000), (player_BizEntered[playerid] == -1 ? 8100000 : 9100000), GetStrMoney(playerid), GetInvCount(playerid, 293))));
	OpenInterface[playerid][79] = true;
}
CMD:alist(playerid)
{
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT \
		`Owner`, `Type`,\
		FROM_UNIXTIME(time, '%%Y-%%m-%%d %%H:%%m:%%s') AS `give_time`,\
		`Admin`, `Reason` FROM `player_AList` WHERE `Owner` = '%s' ORDER BY `ID` DESC LIMIT 50;", PN(playerid));
	mysql_tquery(mysql, str_q, "player_AList_open", "i", playerid);
	return 1;
}
CMD:check_alist(playerid, get[])
{
	extract get -> new string:name[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /check_alist [name]");
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT \
		`Owner`, `Type`,\
		FROM_UNIXTIME(time, '%%Y-%%m-%%d %%H:%%m:%%s') AS `give_time`,\
		`Admin`, `Reason` FROM `player_AList` WHERE `Owner` = '%s' ORDER BY `ID` DESC LIMIT 50;", name);
	mysql_tquery(mysql, str_q, "player_AList_open", "i", playerid);
	return 1;
}
public: player_AList_open(playerid)
{
	str_1 = "{FFFFFF}Список наказаний пуст";
	new result = cache_num_rows();
	if(result > 0)
	{
		str_1[0] = EOS;
		for(new i; i < result; i++)
		{
			str_mes[0] = EOS, cache_get_string(i, "Type", str_mes);
			strcat(str_1, (str_f("%s\t\t\t", str_mes)));

			str_mes[0] = EOS, cache_get_string(i, "give_time", str_mes);
			strcat(str_1, (str_f("%s\t", str_mes)));

			str_mes[0] = EOS, cache_get_string(i, "Admin", str_mes);
			strcat(str_1, (str_f("%s\t", str_mes)));

			str_mes[0] = EOS, cache_get_string(i, "Reason", str_mes);
			strcat(str_1, (str_f("%s\n", str_mes)));
		}
	}
	SPD(playerid, 0, 0, "{FFCD00}Последние 10 наказаний за 2 месяца", (str_f("\
		Тип наказания\t\t\tДата наказания\tНик администратора\tПричина\n\n\
		%s", str_1)), "Закрыть");
	return 1;
}
stock player_addAList(const owner[], const type[], const admin[], const reason[])
{
	mysql_tquery(mysql, (str_f("\
		INSERT INTO `player_AList` (`Owner`, `Type`, `time`, `Admin`, `Reason`) VALUES ('%s', '%s', UNIX_TIMESTAMP(NOW()), '%s', '%s')", owner, type, admin, reason)));
}
CMD:xxl_guard(playerid)
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	str_1 = "{FFFFFF}Наименование\t{FFFFFF}Статус\t{dc143c}Обработано\n";
	for(new i; i < sizeof(ac_Name); i++)
	{
		strcat(str_1, (str_f("%s\t%s\t{dc143c}%i\n", ac_Name[i][acName], ac_Punish_Name[ac_Type[i]], ac_Trigger[i])));
	}
	SPD(playerid, 20383, 5, "xxl guard", str_1, "Выбрать","Закрыть");
	return 1;
}
public OnRakcheatFilteredData(playerid, id, const desc[])
{
	if(PI[playerid][pAdmin] > 1) return 1;
	new data = SearchAC_UID(id);
	if(!(player_AC_FloodTime[playerid][data]-global_time > 0))
	{
		player_AC_FloodTime[playerid][data] = global_time+2;
		ac_Trigger[data]++;
		switch(ac_Type[data])
		{
			case 1: //notif
			{
				str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[XXL Guard] Игрок %s[%i] подозревается в использовании читов. [code: %i, ping: %i, subdata: name: %s, %s]", PN(playerid), playerid, id, GetPlayerPing(playerid), ac_Name[data][acName], desc);
				SendAdminsMessage(COLOR_RED, str_mes);
			}
			case 2: //kick
			{
				str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[XXL Guard] Игрок %s[%i] был кикнут за использование читов. [code: %i, ping: %i, subdata: name: %s, %s]", PN(playerid), playerid, id, GetPlayerPing(playerid), ac_Name[data][acName], desc);
				SendAdminsMessage(0x999999FF, str_mes);

				static year, month, day;

				getdate(year, month, day);
				SPD(playerid, 0, 0, "Анти-чит", (str_f("\
					Вы были отключены от сервера по подозрению в использовании стороннего ПО\n\
					Если произошла ошибка, пожалуйста, сделайте скриншот и обратитесь к администрации\n\
					Вы можете перезайти на сервер и продолжить игру\n\n\
					%s (ID: %i)\n\
					Cheat Code: #%i-%s\n\
					Ping: %i\n\
					Packet Loss: %.6f%%\n\
					Time: %02i.%02i.%04i - %02i:%02i", \
						PN(playerid), playerid, data, desc, GetPlayerPing(playerid), NetStats_PacketLossPercent(playerid),\
						day, month, year, global_hour, global_minute)), "Закрыть");
				Kick(playerid, (str_f("Вы были кикнуты по подозрению в читерстве [Код #%i-%s]", data, desc)));
			}
		}
	}
	player_AC_FloodWarning[playerid][data] = 0;
	return 1;
}
CMD:code(playerid, get[])
{
	if(strlen(get) > 33 || strlen(get) < 31) return SCM(playerid, 0xCECECEFF, "Используйте: /code [token]");
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `ID`, `Type`, `Count`, `Model` FROM `player_PresentRoll` WHERE `Token` = '%s' LIMIT 1;", get);
	mysql_tquery(mysql, str_q, "player_presentcode", "i", playerid);
	return 1;
}
public: player_presentcode(playerid)
{
	if(!cache_num_rows()) SCM(playerid, 0x999999FF, "Введенный код не существует");
	else
	{
		//SCM(playerid, 0x999999FF, !"Забрать данный приз возможно после 09.02.24 10:00:00");
		static id, type, count, model;
		cache_get_int(0, "ID", id);
		cache_get_int(0, "Type", type);
		cache_get_int(0, "Count", count);
		cache_get_int(0, "Model", model);
		switch(type)
		{
			case 1: //auto
			{
				static Float:position[4];
				GetPlayerPos(playerid, position[0], position[1], position[2]);
				position[3] = 180.0;
				CreateOwnableCar(PN(playerid), model, position, 1, 1);
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на автомобиль: модели %i", model);
			}
			case 2: //skin
			{
				str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
				strcat(str_log, "/code");
				if(!InvAdd(playerid, 100, 1, "", model, 0, "", str_log)) return 0;
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на скин: модели %i", model);
			}
			/*case 3: //acs
			{

			}*/
			case 4: //cash
			{
				GivePlayerMoneyEx(playerid, count, "player_site_code");
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на деньги: количество %i", count);
			}
			case 5: //exp
			{
				PI[playerid][pExp] += count;
				CheckNextLevel(playerid);
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на EXP: количество %i", count);
			}
			case 6: //слоты
			{
				PI[playerid][pPropertySlots][model]++;
				SaveSlotsProperty(playerid);
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на слот для %i типа имущества.", model);
			}
			case 7: //наколка
			{
				PI[playerid][pLevel_Tatto] = model;
				UpdatePlayerDataInt(playerid, "Level_Tatto", PI[playerid][pLevel_Tatto]);
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на наколку %i уровня.", model);
			}
			/*case 8: //case
			{

			}*/
			case 9: //donaterub
			{
				GivePlayerDonate(playerid, count, "player_site_code");
				SCMf(playerid, 0x3399FFFF, "Поздравляем! Вы активировали код на доната: количество %i.", count);
			}
		}
		str_q[0] = EOS, f(str_q, sizeof(str_q), "DELETE FROM `player_PresentRoll` WHERE `ID` = '%i' LIMIT 1;", id);
		mysql_tquery(mysql, str_q);
	}
	return 1;
}
stock SaveSlotsProperty(playerid)
{
	str_1[0] = EOS;
	for(new i; i < 5; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, PI[playerid][pPropertySlots][i]);
	}
	UpdateDataStr("players", "PropertySlots", str_1, PI[playerid][pID]);
}
stock SendLog(type, const string[])
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `action_logs` (`type`, `desc`, `time`) VALUE ('%i', '%s', UNIX_TIMESTAMP(NOW()))", type, string);
	mysql_tquery(mysql, str_q);
}
CMD:yt(playerid, get[])
{
	if(!PI[playerid][pYouTube]) return -1;
	if(!strlen(get)) return SCM(playerid, 0xCECECEFF, !"Используйте: {ffffff} /yt [текст]");
	f(str_mes, sizeof str_mes, "[YT] %s[%i]: %s", PN(playerid), playerid, get);
	SendYoutubesMessage(str_mes);
	return 1;
}
CMD:yts(playerid)
{
	SCM(playerid, 0x66CC33FF, !"Ютуберы онлайн:");
	new count;
	foreach(new i: Player)
	{
		if(!IsPlayerConnected(i) || !IsPlayerLogged(i) || PI[i][pAdmin] > 7 || !PI[i][pYouTube]) continue;
		str_q[0] = EOS;
		if(IsPlayerAFK{i} || PI[i][pAFKTime] > 1) f(str_q, sizeof(str_q),"{FF0000}AFK [%02d:%02d]",(floatround(GetPlayerData(i, pAFKTime) / 60) % 60), GetPlayerData(i, pAFKTime) % 60);
		SCMf(playerid, 0xFFFF00FF, "%s[%i] (lvl %i) %s", PN(i), i, PI[i][pYouTube], str_q);
		count++;
	}
	if(!count) SCM(playerid, 0xFFCD00FF, "Нет ютуберов в сети");
	return 1;
}
CMD:makeyt(playerid, get[])
{
	extract get -> new string:name[24], rang; else
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /makeyt [nickname] [rang(0-5)]");
		return 0;
	}
	if(rang > 5 || rang < 0) return 0;
	new to_player = GetPlayerID(name);
	if(!IsPlayerLogged(to_player))
	{
		mysql_tqueryf(mysql, "UPDATE `players` SET `YouTube` = '%i' WHERE `NickName` = '%s' LIMIT 1;", rang, name);
	}
	else
	{
		PI[to_player][pYouTube] = bool:rang;
		UpdatePlayerDataInt(to_player, "YouTube", PI[to_player][pYouTube]);
	}
	str_1[0] = EOS, f(str_1, sizeof str_1, "Админ %s[%i] изменил уровень ютуберки %s[%i] на %i уровень", PN(playerid), playerid, name, to_player, rang);
	SendAdminsMessage(-11521793, str_1);
	return 1;
}
CMD:yt_help(playerid)
{
	SCM(playerid, 0xFFFF00FF, !"Доступные команды:");
	new level = PI[playerid][pYouTube]+1;
	if(level > 6) level = 6;
	else if(level < 2) level = 2;
	for(new i=1; i < level; i++)
	{
		str_1[0] = EOS;
		strcat(str_1, (str_f("%i уровень:", i)));
		for(new j; j < sizeof(commandsYTData); j++)
		{
			if(commandsYTData[j][caLevel] == i)
			{
				strcat(str_1, (str_f(" /%s", commandsYTData[j][caName])));
				if(strlen(str_1) > 100)
				{
					SCM(playerid, 0xCC9900FF, str_1);
					str_1[0] = EOS;
					strcat(str_1, (str_f("%i уровень:", i)));
					continue;
				}
			}
		}
		if(strlen(str_1) > 13) SCM(playerid, 0xCC9900FF, str_1);
	}
	return 1;
}
CMD:checkbiz(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /checkbiz [id]");
	if(id < 0 || id > TOTAL_BUSINESSES-1) return 0;
	SCMf(playerid, -1, "id: %i, uid: %i, owner: %s, cash: %i, profit: %i, product: %i", id, BizData[id][bID], BizData[id][bOwner], BizData[id][bBalance], BizData[id][bProductEx], BizData[id][bProducts]);
	return 1;
}
CMD:donate(playerid) 
{
	player_UpdateDonate(playerid);
	return 1;
}
stock player_UpdateDonate(playerid)
{
	player_Donate_Open(playerid);
}
alias:donate("hcoins", "rcoins", "zcoins", "rub", "rubles")
stock player_Donate_Open(playerid)
{
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{F5F5F5}Магазин | Баланс: {3FC1C9}%i{F5F5F5} рублей", PI[playerid][pCash_Donate]);
	str_1[0] = EOS, f(str_1, sizeof(str_1), "\
		{F5F5F5}Пополнить баланс можно по ссылке {3FC1C9}"SITE_SERVER"/pay\n\
		{FFFFFF}Конвертировать рубли в вирты\t{3FC1C9}1 рубль - %i вирт\n\
		{FFFFFF}Конвертировать рубли в очки опыта\t{3FC1C9}1 рубль - %i exp\n\
		{f0f8ff}Приобрести слот для дома\t{3FC1C9}%i рублей\n\
		{f0f8ff}Приобрести слот для бизнеса\t{3FC1C9}%i рублей\n\
		{f0f8ff}Приобрести слот для гаража\t{3FC1C9}%i рублей\n\
		{f0f8ff}Приобрести слот для автомобиля\t{3FC1C9}%i рублей\n\
		{e297bd}[NEW]{f0f8ff}Приобрести слот для киоска\t{3FC1C9}%i рублей\n\
		{FC5185}Эксклюзивные автомобили\tОт 300 рублей\n\
		{FC5185}Эксклюзивная одежда\tОт 200 рублей\n\
		{FC5185}Эксклюзивные объекты для авто\tОт 150 рублей\n\
		{FC5185}Эксклюзивные объекты для недвижимости\tОт 150 рублей\n\
		{364F6B}И{F9ED69}м{F08A5D}е{B83B5E}н{6A2C70}н{F38181}а{95E1D3}я VIP\t{FFFFFF}1500 рублей\n\
		{f0f8ff}Наколка для персонажа {FC5185}'Пахан'\t{3FC1C9}250 рублей\n\
		{FC5185}Эксклюзивные аксессуары для персонажа\tОт 100 рублей\n\
		{e297bd}Смена игрового имени\t{FC5185}123 рублей", 500000*xpayday, 1*xpayday, donate_slots_price[0], donate_slots_price[1], donate_slots_price[2],donate_slots_price[3], donate_slots_price[4]);
	SPD(playerid, 20386, 5, str_mes, str_1, "Выбрать","Закрыть");
	return 1;
}
stock player_Donate_Switch(playerid, listitem)
{
	switch(listitem)
	{
		case 0:
		{
			str_1[0] = EOS, f(str_1, sizeof(str_1), "{FFFFFF}\
				{F5F5F5}Ставка:\t\t{3FC1C9}1 рубль = %i виртов\n\
				{F5F5F5}Кол-во рублей:\t{3FC1C9}%i.00\n\
				{F5F5F5}Введите количество рублей, которые Вы\n\
				{F5F5F5}хотите конвертировать в вирты:", 500000*xpayday, PI[playerid][pCash_Donate]);
			SPD(playerid, 20387, DIALOG_STYLE_INPUT, "{F5F5F5}Обменник", str_1, "Далее", "Назад");
		}
		case 1:
		{
			str_1[0] = EOS, f(str_1, sizeof(str_1), "{FFFFFF}\
				{F5F5F5}Ставка:\t\t{3FC1C9}1 рубль = %i очков опыта\n\
				{F5F5F5}Кол-во рублей:\t{3FC1C9}%i.00\n\
				{F5F5F5}Введите количество рублей, которые Вы\n\
				{F5F5F5}хотите конвертировать в EXP:", 1*xpayday, PI[playerid][pCash_Donate]);
			SPD(playerid, 20388, DIALOG_STYLE_INPUT, "{F5F5F5}Обменник", str_1, "Далее", "Назад");
		}
		case 2..6: //{f0f8ff}Приобрести слот для дома\t{3FC1C9}150 рублей\n
		{
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{F5F5F5}Покупка слота | Баланс: {3FC1C9}%i{F5F5F5} рублей", PI[playerid][pCash_Donate]);
			player_ShowUID[playerid][66] = listitem-2;
			str_1[0] = EOS, f(str_1, sizeof(str_1), "\
				{F5F5F5}Вы уверены, что хотите приобрести {3FC1C9}1 слот на %s?\n\
				{F5F5F5}После покупки количество доступных слотов увеличится до {3FC1C9}%i{F5F5F5} слотов\n\
				{3FC1C9}Цена покупки составляет %i рублей", donate_slots_name[listitem-2], PI[playerid][pPropertySlots][listitem-2]+1, donate_slots_price[listitem-2]);
			SPD(playerid, 20390, 0, str_mes, str_1, "Купить", "Назад");
		}
		case 7: //авто
		{
			player_Donate_Cars(playerid);
		}
		case 8: //одежда
		{
			player_Donate_Skins(playerid);
		}
		case 9: //объекты для авто
		{
			player_Donate_CarsAks(playerid);
		}
		case 10: //объекты для имущки
		{

		}
		case 11: //именная випка
		{

		}
		case 12: //наколка
		{
			SPD(playerid, 20392, 0, "{F5F5F5}Подтверждение", "\
						{F5F5F5}Вы действительно хотите приобрести наколку {3FC1C9}\"Пахан\" за 250 рублей?\n\
						Для покупки нажмите \"Далее\", если вы хотите отказаться \"Назад\".", "Далее", "Назад");
		}
		case 13: //аксы на перса
		{
			player_Donate_PersonAks(playerid);
		}
		case 14: //смена ника
		{
			SPD(playerid, 20450, DIALOG_STYLE_INPUT, "{FFD83D}Изменение имени", "\
					{FFFFFF}Вы можете изменить имя своего персонажа платно\n\
					{FFFFFF}Стоимость данной услуги равняется - {6699FF}123 рублей\n\n\
					Введите новое имя в поле ниже. Допустимы только латинские символы:", "Изменить", "Закрыть");
		}
	}
	return 1;
}
stock player_Donate_Cars(playerid, list=1)
{
	if(list < 1) list = 1;
	player_ShowID[playerid][20] = list;
	str_1[0] = EOS;
	new 
		start = sizeof(donate_Cars)-((list-1)*35)-1,
		end = sizeof(donate_Cars)-(list*35),
		bool:next = true;

	str_1 = "Наименование\tЦена\n";
	if(end < 1) end = 0, next = false;
	for(new i=start; i >= end; --i)
	{
		strcat(str_1, (str_f("{F5F5F5}%s{FFFFFF}[модель: %i]\t{3FC1C9}%i рублей\n", donate_Cars[i][ddName], donate_Cars[i][ddModel], donate_Cars[i][ddPrice])));
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{F5F5F5}Эксклюзивные авто | Баланс: {3FC1C9}%i{F5F5F5} рублей", PI[playerid][pCash_Donate]);
	SPD(playerid, 20389, DIALOG_STYLE_TABLIST_HEADERS, str_mes, str_1, "Купить", "Закрыть", "", (list > 1 ? true : false), next);
	return 1;
}
