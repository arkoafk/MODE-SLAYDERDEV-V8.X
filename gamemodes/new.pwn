CMD:restart(playerid)
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	OnRestart();
	return 1;
}
stock OnRestart()
{
	SCMAll(-11521793, "Инициализирован рестарт сервера. Все аккаунты сохранены.");
	foreach(new i: Player){
		GameTextForPlayerEx(i, "Перезагрузка сервера", 10000, 1);
	}
	SaveServer();
	GameModeExit();
	return 1;
}
stock gang_StartCaptureAll()
{
	
	return 1;
}
stock player_GangCapture_Update(playerid)
{
	ExecutePacket(playerid, webClose, "GangTimer");
	if(gangCapture_Type != -1 && gangCapture_FamilyID != -1)
	{
		new id = GetFamilyID(gangCapture_FamilyID);
		if(id >= 0)
		{
			ExecutePacket(playerid, webOpen, "GangTimer", (str_f("\
				[\"%s\", \"#%s\", \"Проводит захват: `%s`\", %i]", \
					FamilyData[id][fName], FamilyColorData[FamilyData[id][fColor]],\
					fWalking[gangCapture_Type], gangCapture_UnixTime)));
		}
	}
	return 1;
}
stock player_GangCapture_Hack(playerid, type)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		//ид особы
		//"понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"
/*
	{"Центральный особняк", {1935.9066, 37.9323, 8.1209}},
	{"Северный особняк", {4064.8909, 3813.2771, 7.4718}},
	{"Западный особняк", {-3256.8931, 822.3658, 6.6934}},
	{"Особняк мафии №4", {2330.6794, 1540.6089, 14.0577}}
*/
		if(gangCapture_HackerID == -1)
		{
			if(global_hour == 18 && global_minute < 45)
			{
				//if( global_weekday == 2 && type == 2 || global_weekday == 4 && type == 1 ||
				//	global_weekday == 5 && type == 4 || global_weekday == 6 && type == 0)
				if( (global_weekday == 2 && type == 2) || (global_weekday == 4 && type == 1) ||
					(global_weekday == 5 && type == 3) || (global_weekday == 6 && type == 0))
				{
					gangCapture_HackerStep = 0;
					gangCapture_Type = type;
					gangCapture_UnixTime = global_time+600;
					gangCapture_FamilyID = PI[playerid][pFamily_ID];
					gangCapture_HackerID = playerid;
					foreach(new i: PlayersFamily)
					{
						//new id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);
						SCMf(i, 0x944636FF, "%s[%i] {FFFFFF}из группировки {FF63C2}\"%s\"", PN(playerid), playerid, FamilyData[id][fName]);
						SCMf(i, 0xFFFFFFFF, "Пытается взломать охранную систему особняка {618ba3}\"%s\"", fWalking[type][fwName]);
						player_GangCapture_Update(i);
					}
					SCM(playerid, COLOR_GREY, "Не покидайте место компьютера чтобы взломать охранную систему");
					player_HackMenu_Show(playerid);
					return 1;
				}
				else SCM(playerid, -1, "days");
			}
			SCM(playerid, COLOR_GREY, "Расписание захватов");
			SCM(playerid, COLOR_GREY, "Западный особняк - Среда 18:00");
			SCM(playerid, COLOR_GREY, "Северный особняк - Пятница 18:00");
			SCM(playerid, COLOR_GREY, "База Паши Пэла - Суббота 18:00");
			SCM(playerid, COLOR_GREY, "Центральный особняк - Воскресенье 18:00");
		}
		else
		{
			SCMf(playerid, COLOR_GREY, "Игрок %s[%i] уже проводит взлом", PN(gangCapture_HackerID), gangCapture_HackerID);
		}
	}
	return 1;
}
stock gangCapture_Clear(text[] = "")
{
	if(gangCapture_Type != -1 && gangCapture_FamilyID != -1)
	{
		new id = GetFamilyID(gangCapture_FamilyID);
		foreach(new i: PlayersFamily)
		{
			//new id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);
			ExecutePacket(i, webClose, "GangTimer");
			if(strlen(text) < 5)
			{
				f(text, 144, "Группировке {FFCC00}\"%s\" {FFFFFF}не удается взломать охранную систему особняка {66CCFF}\"%s\"", FamilyData[id][fName], fWalking[gangCapture_Type][fwName]);
			}
			SCM(i, -1, text);
		}
	}
	gangCapture_HackerStep = 0;
	gangCapture_Type = -1;
	gangCapture_UnixTime = -1;
	gangCapture_FamilyID = -1;
	gangCapture_HackerID = -1;
	return 1;
}
stock player_HackMenu_Show(playerid)
{
	if(gangCapture_HackerID == playerid)
	{
		ExecutePacket(playerid, webUpdate, "interface('Hacking').shuffleComputerMatrix(16)");
		ExecutePacket(playerid, webUpdate, "interface('Hacking').swapItems(1,1)");
		ExecutePacket(playerid, webOpen, "Hacking");
		ExecutePacket(playerid, webUpdate, "interface('Hacking').shuffleComputerMatrix(16)");
		ExecutePacket(playerid, webUpdate, "interface('Hacking').swapItems(1,1)");
		gangCapture_StepTime = 80;
	}
	return 1;
}
stock player_HackMenu_Hide(playerid)
{
	ExecutePacket(playerid, webClose, "Hacking");
	if(gangCapture_HackerID == playerid)
	{
		gangCapture_Clear();
	}
}
stock player_HackMenu_KeyChange(playerid)
{
	if(gangCapture_HackerID == playerid && gangCapture_HackerStep < 4)
	{
		gangCapture_HackerStep++;
		GameTextForPlayerEx(playerid, (str_f("~g~Успешно[%i/4]~n~~w~Стойте возле охранной системы", gangCapture_HackerStep)), 4000, 3);
		ExecutePacket(playerid, webClose, "Hacking");
		if(gangCapture_HackerStep < 4)
		{
			gangCapture_StepTime = 40;
		}
	}
	return 1;
}
stock Update_GangCapture()
{
	if(gangCapture_HackerID != -1)
	{
		//if(gangCapture_UnixTime >= global_time) return 0;
		if(gangCapture_HackerStep < 4)
		{
			gangCapture_StepTime--;
			//SCMf(gangCapture_HackerID, -1, "%i", gangCapture_StepTime);
			if(gangCapture_StepTime <= 2 && gangCapture_HackerID != -1)
			{
				player_HackMenu_Show(gangCapture_HackerID);
			}
		}
		if((gangCapture_UnixTime-global_time) > 0) return 0;
		if(gangCapture_HackerStep > 3)
		{
			//они вин
			new id = GetFamilyID(gangCapture_FamilyID);
			foreach(new i: PlayersFamily)
			{
				ExecutePacket(i, webUpdate, "closeInterface('BattleMansionEnd')");
				ExecutePacket(i, webUpdate, (str_f("openInterface('BattleMansionEnd', '[\"окончена!\", \"%s\", 3000]')", FamilyData[id][fName])));
				if(PI[i][pFamily_ID] == gangCapture_FamilyID)
				{
					SCMf(i,-3211094, "%s Ваше криминальное влияние было повышено на 50 очков победа в войне за особняк", FamilyData[id][fName]);
					SCMf(i,-3211094, "%s Вашей банде было установлено новое место базы в особняке: %s", FamilyData[id][fName], fWalking[gangCapture_Type][fwName]);
				}
			}
			fWalking_FamilyID[gangCapture_Type] = id;
			server_UpdateGang_Label();
			SaveFWalking();
			FamilyData[id][fGang_Reputation] += 50;
			UpdateDataInt("Familys", "Gang_Reputation", FamilyData[id][fGang_Reputation], FamilyData[id][fID]);
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Группировка \"%s\" успешно захватывает особняк \"%s\"", FamilyData[id][fName], fWalking[gangCapture_Type][fwName]);
			gangCapture_Clear(str_mes);
		}
	}
	return 1;
}
stock SaveFWalking()
{
	str_1[0] = EOS;
	for(new i; i < sizeof(fWalking); i++) f(str_1, sizeof(str_1), "%s%i,", str_1, fWalking_FamilyID[i]);
	mysql_tqueryf(mysql, "UPDATE `Config` SET `fWalking` = '%s' WHERE 1;", str_1);
	return 1;
}
stock get_week_day()
{
	new year, month, day;
			
	getdate(year, month, day);
	

	f(str_q, sizeof(str_q), "SELECT WEEKDAY(\"%02d-%02d-%d\")", year, month, day);
	
	new Cache: mysql_result = mysql_query(mysql, str_q);
	
	cache_get_value_index_int(0, 0, global_weekday);

	cache_delete(mysql_result);

	return global_weekday;
}
CMD:police_tablet(playerid)
{
	if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_ID] != 8) return SCM(playerid, 0x999999FF, "Вы не работник правоохранительных органов");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	OpenInterface[playerid][120] = true;
	player_Cache_Page[playerid] = 0;
	ExecutePacket(playerid, webOpen, "Police");
	return 1;
}
CMD:addentrance(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	SCM(playerid, 0xCECECEFF, !"ВСТАВАТЬ ЛИЦО К ДВЕРИ ОТКУДА БУДУТ ВЫХОДИТЬ ИГРОКИ!!!");
	extract get -> new type; else return SCM(playerid, 0xCECECEFF, !"Используйте: /addentrance [type]");
	if(type < 0 || type > 1) return SCM(playerid, 0xCECECEFF, !"Используйте: /addentrance [type]");

	SendAdminsMessagef(0x999999FF, "Админ %s[%i] создал подъезд №%i", PN(playerid), playerid, TOTAL_ENTRANCE);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	GetPlayerFacingAngle(playerid, position[3]);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `Entrance` (`Enter`, `Type`) VALUES ('%f,%f,%f,%f,', '%i');", position[0], position[1], position[2], position[3], type);
	mysql_tquery(mysql, str_q, "func_AddEntrance");
	return 1;
}
public: func_AddEntrance()
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `Entrance` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadEntranceMySQL", "i", 0);
	return 1;
}
CMD:changebusiness_posa(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new id; else return SCM(playerid, -1, "/changebusiness_posa id");
	if(id < 0 || id > TOTAL_BUSINESSES-1) return 0;
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] перенес бизнес %i", PN(playerid), playerid, id);
	static Float:position[3];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	for(new i; i < 3; i++)
	{
		BizData[id][bEnter][i] = position[i];
	}
	UpdateBiz(id, true);
	mysql_tquery(mysql, (str_f("UPDATE `Businesses` SET `Enter` = '%f,%f,%f' WHERE `ID` = '%i' LIMIT 1;", position[0], position[1], position[2], BizData[id][bID])));
	return 1;
}
stock OnPlayerInventoryUseSkate(playerid, slot)
{
	if(!OpenInterface[playerid][7]) return 0;
	if(slot > 9 || slot < 0) return SCM(playerid, 0xC0C0C0FF, "* Данное действие можно использовать только с одетым скейтом");
	if(!InventoryAks_Used[playerid][slot]) return SCM(playerid, 0xC0C0C0FF, "* Данное действие можно использовать только с одетым скейтом");
	if(GetPlayerInterior(playerid) != 0 || GetPlayerVirtualWorld(playerid) != 0) return SCM(playerid, 0xC0C0C0FF, "* Данное действие можно использовать только на улице");
	new vehicleid = player_TempVehicleID[playerid];
	if(vehicleid != -1)
	{
		if(GetPlayerVehicleID(playerid) > 0) return 0;
	}
	RemovePlayerAttachedObject(playerid, slot);
	
	new Float:x, Float:y, Float:z, Float:angle;
	GetPlayerPos(playerid, x, y, z);
	GetPlayerFacingAngle(playerid, angle);

	cmd_vec(playerid, 15644, 1, 1);
	PutPlayerInVehicle(playerid, player_TempVehicleID[playerid], 0);
	vehicleid = player_TempVehicleID[playerid];
	switch(InventoryAks[playerid][2][slot])
	{
		case 16464:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate1");
		}
		case 16465:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate2");
		}
		case 16678:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate3");
		}
		case 16679:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate4");
		}
		case 16982:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate5");
		}
		case 16983:
		{
			VehicleData[ vehicleid ][vTuning][3] = tsd_GetName("Paintjob|individual/15644|skate6");
		}
	}
	UpdateVehicleTuning(vehicleid, INVALID_PLAYER_ID, 3);
	SCM(playerid, 0xfab13bFF, !"Вы успешно встали на скейтборд");
	//SetVehicleParam(vehicleid, V_LOCK, 1);
	return 1;
}
