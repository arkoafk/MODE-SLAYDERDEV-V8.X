	SendClientMessageToAll(0xFFCD00FF, !"Чат был очищен администрацией");
	f(str_2, sizeof str_2, "[A] %s[%i] очистил чат", PN(playerid), playerid);
	SendAdminsMessage(0x999999FF, str_2);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "Очистил чат");
	return 1;
}

CMD:weap(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) < 1) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /weap [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	//new625],

	str_1[0] = EOS, f
	(
		str_1,
		sizeof str_1,
		"\
		Слот\tОружие\t\tПатроны\n{FFFFFF}\
		"
	);

	for(new i = 0; i < 13; i++)
	{
		new weapon_id, weapon_ammo;

		GetPlayerWeaponData(to_player, i, weapon_id, weapon_ammo);

		str_mes[0] = EOS, f(str_mes, sizeof str_mes, "\n%i\t%s%s%i", i+1, weapon_names[weapon_id], weapon_dialog_tabulation[weapon_id], weapon_ammo);
		strcat(str_1, str_mes);
	}

	Dialog
	(
		playerid,
		INVALID_DIALOG_ID,
		DIALOG_STYLE_MSGBOX,
		"{FFCC00}Оружия у игрока",
		str_1,
		"Закрыть",
		""
	);

	format(str_mes, sizeof str_mes, "Смотрит оружие %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
CMD:a(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) >= 1)
	{
		if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: {ffffff} /a [текст]");
		
		f(str_mes, sizeof str_mes, "[%s] %s[%i]: %s", (PI[playerid][pAdmin] < 2 ? "H" : "A"), PN(playerid), playerid, params);
		SendAdminsMessage(0x99CC00FF, str_mes);

		//SendLog(playerid, LOG_TYPE_ADMIN_CHAT, params);
	}

	return 1;
}

CMD:admins(playerid, params[])
{
	if(GetPlayerAdminEx(playerid) > 0 || PI[playerid][pLevel_VIP] > 2)
	{
		SCM(playerid, 0x66CC33FF, !"Админы онлайн:");
		new count;
		foreach(new i: PlayersAdmin)
		{
			if(!IsPlayerConnected(i) || !IsPlayerLogged(i) || !PI[i][pAdmin] || NameIsFullDostup(PN(i)) == 1) continue;
			str_q[0] = EOS;
			if(IsPlayerAFK{i} || PI[i][pAFKTime] > 1) f(str_q, sizeof(str_q),"{FF0000}AFK [%02d:%02d]",(floatround(GetPlayerData(i, pAFKTime) / 60) % 60), GetPlayerData(i, pAFKTime) % 60);
			else if(player_SpectateData[i][sdPlayerID] != -1 && GetPlayerAdminEx(playerid) > 0) f(str_q, sizeof(str_q),"{00CC00}/sp > %i", player_SpectateData[i][sdPlayerID]);
			SCMf(playerid, 0xFFFF00FF, "%s[%i] (%i lvl) %s", PN(i),i,PI[i][pAdmin],str_q);
			count++;
		}
		if(!count) SCM(playerid, 0xFFCD00FF, "Нет администраторов в сети");
		//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "Смотрит список администрации");
	}
	return 1;
}

CMD:admlist(playerid)
{
	player_AdminsList(playerid);
	return 1;
}
CMD:ytlist(playerid)
{
	player_YTList(playerid);
	return 1;
