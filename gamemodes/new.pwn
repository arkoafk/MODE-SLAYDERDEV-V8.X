stock Cache:_mysql_query(MySQL:handle, const query[], bool:use_cache = true)
{
	printf("mysql_query(type: '%i', query: '%s')", use_cache, query);
	return mysql_query(handle, query, use_cache);
}
#if defined _ALS_mysql_query
    #undef mysql_query
#else
    #define _ALS_mysql_query
#endif

#define mysql_query _mysql_query
//
stock _mysql_escape_string(source[], desc[], max_len = sizeof(desc))
{
	for(new i; i < strlen(source); i++)
	{
		switch(source[i])
		{
			case '&', '|', '{', '}', 'A'..'Z', 'a'..'z', 'А'..'Я', 'а'..'я', '0'..'9', ' ', '>', '<', '(', ')', '/', '+', '-','_', '?', '!', '.', ',', '@', '#', ':', 'ё': continue;
			default: source[i] = ' ';
		}
	}
	mysql_escape_string(source, desc, max_len);
}
#if defined _ALS_mysql_escape_string
    #undef mysql_escape_string
#else
    #define _ALS_mysql_escape_string
#endif

#define mysql_escape_string _mysql_escape_string

//
stock _RemovePlayerFromVehicle(playerid)
{
    if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER && GetPlayerState(playerid) != PLAYER_STATE_PASSENGER)
	{
		new Float:pos_X, Float:pos_Y, Float:pos_Z;
		GetPlayerPos(playerid, pos_X, pos_Y, pos_Z);
		SetPlayerPos(playerid, pos_X, pos_Y, pos_Z);
		return 0;
	}
	RemovePlayerFromVehicle(playerid);
	new Float:pos_X, Float:pos_Y, Float:pos_Z;
	GetPlayerPos(playerid, pos_X, pos_Y, pos_Z);
	return SetPlayerPos(playerid, pos_X + 2.5, pos_Y + 2.5, pos_Z);
}
#if defined _ALS_RemovePlayerFromVehicle
    #undef RemovePlayerFromVehicle
#else
    #define _ALS_RemovePlayerFromVehicle
#endif
#define RemovePlayerFromVehicle _RemovePlayerFromVehicle
