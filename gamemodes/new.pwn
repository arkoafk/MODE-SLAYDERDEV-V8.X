stock player_OwnableCarMenu(playerid, id, number)
{
	if(IsAOwnableCar(number)) //loaded
	{
		if(GetString(CarData[number][cOwner], PN(playerid)))
		{
			str_2[0] = EOS, f(str_2, sizeof(str_2), "\
				{FFFFFF}1. {669900}Открыть или {FF3300}Закрыть транспорт\n\
				{FFFFFF}2. Вставить / вытащить ключи\n\
				3. Отметить транспорт на GPS {FF6600}(300000 руб)\n\
				4. Содержимое багажника\n\
				5. Доступ к багажнику %s\n\
				{FFFFFF}6. Документы на транспорт\n\
				{888888}7. Припарковать транспорт\n\
				{FFFFFF}8. Доставить на штрафстоянку [500000 руб.]\n\
				{dc143c}Выгрузить", \
					(!CarData[number][cBagAll] ? ("{FF3300}(для владельца)") : ("{669900}(для всех)")));
			SPD(playerid, 20245, DIALOG_STYLE_LIST,"{FFCD00}Система управления транспортом",str_2,"Выбрать","Закрыть");
		}
		else
		{
			SCM(playerid, COLOR_RED, "[Ошибка] При загрузке авто произошла ошибка - #93131F");
			printf("[Ошибка] При загрузке авто произошла ошибка - #93131F(%i,%i) [%s] [%s]",id, number, CarData[number][cOwner], PN(playerid));
		}
	}
	else
	{
		SPD(playerid, 20246, DIALOG_STYLE_LIST,"{FFCD00}Система управления транспортом","\
				{FFFFFF}1. Отметить транспорт на GPS {FF6600}(300000 руб)\n\
				{888888}2. Загрузить транспорт\n\
				{FFFFFF}3. Доставить на штрафстоянку [500000 руб.]","Выбрать","Закрыть");
	}
}
stock IsValidCarModel(model)
{
	for(new i; i < sizeof(VehicleStaticData); i++)
	{
		if(VehicleStaticData[i][vsModel] == model) return i;
	}
	return -1;
}
public: GetOwnableCarPos(playerid, id)
{
	static Float:Position[4];
	str_1[0] = EOS, cache_get_string(0, !"Position", str_1), sscanf(str_1, "p<,>a<f>[4]", Position);
	if(id == -31)
	{
		if(CompareInt64(playerid, "<", 300000)) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
		//if(player_Cash[playerid] < 300000) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
		GivePlayerMoneyEx(playerid, -300000, "Метка ТС на GPS", true, true);
		GiveBusinessMoney(playerid, player_SearchBiz(playerid, 29), -300000, -5);
		EnablePlayerGPS(playerid, 55, Position[0], Position[1], Position[2], "Местоположение Вашего транспорта отмечено на GPS");
	}
	else
	{
	}
	return 1;
}
public: LoadOwnableCar_List(playerid, dialogid)
{
	new count = cache_num_rows();
	if(!count) SCM(playerid, 0x999999FF, !"У Вас нет личного транспорта (#1)");
	else
	{
		str_2[0] = EOS;
		new loaded;
		for(new i; i < count; i++)
		{
			player_ShowID[playerid][i] = -1;
			player_ShowData[playerid][i] = -1;
			new id,
				model,
				number;
			cache_get_int(i, !"ID", id);
			cache_get_int(i, !"Model", model);
			cache_get_int(i, !"VehicleID", number);
			new uid = IsValidCarModel(model);
			if(uid != -1)
			{
				if(IsAOwnableCar(number)) //loaded
				{
					str_1[0] = EOS, f(str_1, sizeof(str_1), "\
									{FFFFFF}- %s (%i)\n", VehicleStaticData[uid][vsName], model);
					strcat(str_2, str_1);
				}
				else
				{
					str_1[0] = EOS, f(str_1, sizeof(str_1), "\
									{888888}- %s (%i)\n", VehicleStaticData[uid][vsName], model);
					strcat(str_2, str_1);
				}
				player_ShowID[playerid][loaded] = id;
				player_ShowData[playerid][loaded] = number;
				player_ShowUID[playerid][loaded] = uid;
				loaded++;
			}
			else printf("[LoadOwnableCar_List] error -> %i,%i,%i", playerid, dialogid, model);
		}
		if(!loaded) SCM(playerid, 0x999999FF, !"У Вас нет личного транспорта (#2)");
		else if(loaded == 1)
		{
			if(dialogid == 20244)
			{
				player_ShowID[playerid][50] = player_ShowID[playerid][0];
				player_ShowData[playerid][50] = player_ShowData[playerid][0];
				player_OwnableCarMenu(playerid, player_ShowID[playerid][50], player_ShowData[playerid][50]);
			}
			else SPD(playerid, dialogid, DIALOG_STYLE_LIST,"{FFCD00}Выберите транспорт",str_2,"Выбрать","Закрыть");
		}
		else SPD(playerid, dialogid, DIALOG_STYLE_LIST,"{FFCD00}Выберите транспорт",str_2,"Выбрать","Закрыть");
	}
	return 1;
}
stock LoadOwnableCarMySQL(id, uid)
{
	TrunkOpen{uid} = false;
	for(new j; j < 24; j++) RefreshInvTrunk(uid, j);
	CarData[uid][cOwner_Type] = 0;
	SetString(CarData[uid][cNumber_String], "-");
	SetString(CarData[uid][cRegNumber_String], "-");
	for(new i; i < 12; i++) 
	{
		CarData[uid][cTuning][i] = -1;
		if(i < 9)
		{
			CarData[uid][cObjectModel][i] = -1;
			CarData[uid][cObjectPos_X][i] = 0.0;
			CarData[uid][cObjectPos_Y][i] = 0.0;
			CarData[uid][cObjectPos_Z][i] = 0.0;
			CarData[uid][cObjectPos_rX][i] = 0.0;
			CarData[uid][cObjectPos_rY][i] = 0.0;
			CarData[uid][cObjectPos_rZ][i] = 0.0;
		}
		if(i < 3)
		{
			CarTinted[uid][0][i] = -1;
			CarTinted[uid][1][i] = -1;
		}
	}
	cache_get_int(id, "ID", CarData[uid][cID]);
	cache_get_int(id, "Owner_Type", CarData[uid][cOwner_Type]);
	cache_get_string(id, "Owner", CarData[uid][cOwner]);
	cache_get_int(id, "Number_Type", CarData[uid][cNumber_Type]);
	cache_get_string(id, "Number_String", CarData[uid][cNumber_String]);
