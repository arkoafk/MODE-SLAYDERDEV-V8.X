public OnPlayerClickMap(playerid, Float:fX, Float:fY, Float:fZ)
{
	if(!IsPlayerLogged(playerid)) return 1;
	if(fX > 4000 || fY > 4000)
	{
		SCM(playerid, 0xCECECEFF, "* Точка не в зоны достигаемости, действие невозможено.");
		return 1;
	}
	if(GetPlayerAdminEx(playerid) > 1)
	{
		SetPlayerPos(playerid, fX, fY, fZ+1000);
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			SetVehiclePos(GetPlayerVehicleID(playerid), fX, fY, fZ);
			PutPlayerInVehicle(playerid, GetPlayerVehicleID(playerid), 0);
		}
		else
		{
			SetPlayerPosFindZ(playerid, fX, fY, fZ);
		}
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
	}
    return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags)
{
	CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);
	if(!IsPlayerLogged(playerid)) return 0;
	if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
	{
		SCM(playerid, 0x6B6B6BFF, "Не флудите");
		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500) SCM(playerid, 0x6B6B6BFF, !"Пожалуйста, подождите несколько секунд...");
		return 0;
	}
	if(!CheckParams(params)) return 0;
	for(new i; i < sizeof commandsAdminData; i++)
	{
		//SCMf(playerid, -1, "%i %i");
		if(!GetString(cmd, commandsAdminData[i][caName]) &&
			!TextFind(commandsAdminData[i][caNameAlias], (str_f("|%s|", cmd)))) continue;
		if(PI[playerid][pAdmin] < commandsAdminData[i][caLevel]) 
		{
			if(PI[playerid][pYouTube] > 0)
			{
				for(new a; a < sizeof commandsYTData; a++)
				{
					//SCMf(playerid, -1, "%a %a");
					if(!GetString(cmd, commandsYTData[a][caName]) &&
						!TextFind(commandsYTData[a][caNameAlias], (str_f("|%s|", cmd)))) continue;

					//if(!IsPlayerChangeIp(playerid) && !GetString(cmd, "yt")) return 0;
					if(PI[playerid][pYouTube] < commandsYTData[a][caLevel]) 
					{
						return 0;
					}
					return 1; //это чтоб кмд не попадали под админку
				}
			}
			return 0;
		}
		if(!PI[playerid][pTemp_ADuty])
		{
			callcmd::apanel(playerid);
			return 0;
		}
		if(player_cAdminFlood[playerid][i] > global_time)
		{
			SCMf(playerid, COLOR_LIGHTRED, "[Ошибка] {FFFFFF}Выполнить это действие можно после %i сек.", player_cAdminFlood[playerid][i] - global_time);
			return 0;
		}
		if(!NameIsFullDostup(PN(playerid)) && strlen(params) > 1) player_cAdminFlood[playerid][i] = global_time+commandsAdminData[i][caFlood];
		break;
	}
	//commandsYTData
    return 1; // разрешить выполнение команды
}
CMD:protect(playerid, get[])
{
	extract get -> new to_player; else return SCM(playerid, 0xCECECEFF, "Используйте: /protect [id]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	
	SendAdminsMessagef(COLOR_RED, "[PROTECT] %s[%i] подтвердил IP адрес %s %s[%i]", PN(playerid), playerid, (PI[to_player][pAdmin] > 0 ? "администратора" : "игрока"), PN(to_player), to_player);
	SetString(PI[to_player][pAccept_IP], PI[to_player][pIP]);
	UpdateDataStr("players", "Accept_IP", PI[to_player][pIP], PI[to_player][pID]);
	SCMf(playerid, -1, "Вы подтвердили IP адрес %s.", (PI[to_player][pAdmin] > 0 ? "администратора" : "игрока"));
	SCMf(to_player, -1, "Администратор %s[%i] подтвердил ваш IP адрес.", PN(playerid), playerid);
	return 1;
}
alias:protect("acceptip")
//
CMD:protect_guard(playerid)
{
	if(PI[playerid][pAdmin] < 10 || !NameIsFullDostup(PN(playerid))) return -1;
	
	SendAdminsMessagef(COLOR_RED, "[PROTECT] %s[%i] подтвердил IP адрес %s[%i]", PN(playerid), playerid, PN(playerid), playerid);
	SetString(PI[playerid][pAccept_IP], PI[playerid][pIP]);
	UpdateDataStr("players", "Accept_IP", PI[playerid][pIP], PI[playerid][pID]);
	SCMf(playerid, -1, "Вы подтвердили IP адрес %s.", (PI[playerid][pAdmin] > 0 ? "администратора" : "игрока"));
	SCMf(playerid, -1, "Администратор %s[%i] подтвердил ваш IP адрес.", PN(playerid), playerid);
	return 1;
}
//
stock CheckParams(const params[])
{
	for(new i; i < strlen(params); i++)
	{
	    switch(params[i])
	    {
	        case '"', '^', '}', '{', '=', 'A'..'Z', 'a'..'z', 'А'..'Я', 'а'..'я', '0'..'9', ' ', '>', '<', '(', ')', '/', '+', '-','_', '?', '!', '.', ',', '@', '[', ']', ':', 'ё': continue;
	        default: return 0;
	    }
	}
	return 1;
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags)
{
	if(result == -1)
	{
		SCM(playerid, 0x6B6B6BFF, !"Такой команды нет.");
		CheckPlayerFlood(playerid, true, MAX_FLOOD_RATE, FLOOD_RATE_INC);
		if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE)
		{
			SCM(playerid, 0x6B6B6BFF, !"Не флудите");
			if(GetPlayerAntiFloodData(playerid, AF_RATE) >= MAX_FLOOD_RATE + 500) SCM(playerid, 0x6B6B6BFF, "Пожалуйста, подождите несколько секунд...");
			return 0;
		}
		return 0;
	}
	if(result == 1)
	{
		if(PI[playerid][pAdmin] > 0)
		{
			for(new i; i < sizeof commandsAdminData; i++)
			{
				//SCMf(playerid, -1, "%i %i");
				if(!GetString(cmd, commandsAdminData[i][caName]) &&
					!TextFind(commandsAdminData[i][caNameAlias], (str_f("|%s|", cmd)))) continue;
				str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
				f(str_log, sizeof(str_log), "Админ %s использовал команду [/%s], с параметром [%s]", str_log, cmd, params);
				SendLog(1, str_log);
				return 1;
			}
		}
		else if(PI[playerid][pYouTube] > 0)
		{
			for(new i; i < sizeof(commandsYTData); i++)
			{
				//SCMf(playerid, -1, "%i %i");
				if(!GetString(cmd, commandsYTData[i][caName]) &&
					!TextFind(commandsYTData[i][caNameAlias], (str_f("|%s|", cmd)))) continue;
				str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
				f(str_log, sizeof(str_log), "Ютубер %s использовал команду [/%s], с параметром [%s]", str_log, cmd, params);
				SendLog(1, str_log);
				SendAdminsMessagef(COLOR_YELLOW, "Ютубер %s[%i] использовал команду [/%s], с параметром [%s]", PN(playerid), playerid, cmd, params);
				return 1;
			}
		}
		else
		{
			str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
			f(str_log, sizeof(str_log), "Игрок %s использовал команду [/%s], с параметром [%s]", str_log, cmd, params);
			SendLog(1, str_log);
			return 1;
		}
	}
	//printf("%s[%i] used command: %s[%s]", PN(playerid), playerid, cmd, params);
    return 1; // разрешить выполнение команды
}
