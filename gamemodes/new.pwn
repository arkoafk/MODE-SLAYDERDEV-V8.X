	str_1[0] = EOS, cache_get_string(id, !"Color", str_1), sscanf(str_1, "p<,>a<i>[2]", CarData[uid][cColor]);
	str_1[0] = EOS, cache_get_string(id, "Position", str_1), sscanf(str_1, "p<,>a<f>[4]", CarData[uid][cPos]);
