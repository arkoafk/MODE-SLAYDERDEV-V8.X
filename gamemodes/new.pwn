CMD:apanel(playerid)
{
	if(PI[playerid][pAdmin] < 1) return 1;
	//if(CheckAdmin(playerid, 7)) return 1;
	if(!PI[playerid][pTemp_ADuty])
	{
		if(strlen(PI[playerid][pPassword_Admin]) > 4)
		{
			SPD(playerid, 20306, DIALOG_STYLE_PASSWORD,"{FFD83D}Система безопасности",
				"{FFFFFF}Введите пароль:",
				"Далее", "Закрыть");
		}
		else SPD(playerid, 20306, DIALOG_STYLE_PASSWORD, "{FFD83D}Система безопасности", "\
					{FFFFFF}Создайте свой личный пароль для авторизации как администратор", "Далее", "Закрыть");
	}
	else
	{
		str_1 = "{FFFFFF}Уровень доступа\tДействие\n";
		f(str_1, sizeof(str_1), "\
			%s\
			[1]\t Список администрации\n\
			[2]\t Очистить Чат\n\
			[4]\t Заправить машины\n\
			[2]\t Починить машину\n\
			[7]\t Спавн Транспорта\n\
			[3]\t BANLIST{FFFFFF}\n\
			[4]\t Лидеры/Снять лидера\n\
			[7]\t Дома на слёт\n\
			[7]\t Бизнесы на слёт\n\
			[6]\t Пополнить склад для организации.\n\
			[8]\t Управление GreenZones\n\
			[8]\t Пополнить продукты для гос. бизнесов.\n\
			{ff0000}[10]{FFFFFF}\t Панель основателя\n\
			[5]\t Список ютуберов\n", str_1);
		SPD(playerid, 20299, DIALOG_STYLE_TABLIST_HEADERS, "APanel", str_1, "Выбор", "Отмена");
	}
	return 1;
}
alias:apanel("alogin")
stock player_AdminsList(playerid, list = 0)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `NickName`, `Admin`, FROM_UNIXTIME(Last_LoginTime, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date` FROM `players` WHERE `Admin` > 0 ORDER BY `Admin` DESC LIMIT %i, 25", 25*list);
	mysql_tquery(mysql, str_q, "player_AdminsListMySQL", "ii", playerid, list);
	return 1;
}
public: player_AdminsListMySQL(playerid, list)
{
	player_ShowID[playerid][20] = list;
	str_1 = "Ник\tУровень\tДата активности\n";
	new count = cache_num_rows();
	for(new i; i < count; i++)
	{
		str_mes[0] = EOS, cache_get_string(i, "NickName", str_mes);
		strcat(str_1, (str_f("%s\t", str_mes)));

		static level;
		cache_get_int(i, "Admin", level);
		strcat(str_1, (str_f("%i\t", level)));

		str_mes[0] = EOS, cache_get_string(i, "date", str_mes);
		strcat(str_1, (str_f("%s\n", str_mes)));
	}
	if(!count) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "Список администрации", "{FFFFFF}Пуст", "", "Назад");
	SPD(playerid, 20300, DIALOG_STYLE_TABLIST_HEADERS, "Список администрации", str_1, "Выбрать", "Назад", "", (list > 0 ? true : false), (count == 25 ? true : false));
	return 1;
}
