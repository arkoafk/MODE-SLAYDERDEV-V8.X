stock UpdateStats_Property()
{
	new house_free;
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(GetString(HouseData[i][hOwner], "The State")) house_free++;
	}
	new garage_free;
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(GetString(GarageData[i][gOwner], "The State")) garage_free++;
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "\
			Состояние недвижимости\n\
			(обновляется каждый час)\n\n\
			{FF6633}Куплено домов: %i\n\
			{99FF33}Свободно домов: %i\n\
			{FF6633}Куплено гаражей: %i\n\
			{99FF33}Свободно гаражей: 61", TOTAL_HOUSES-house_free, house_free, TOTAL_GARAGES-garage_free, garage_free);
	UpdateDynamic3DTextLabelText(StatsProperty_3DLabel, 0xCCFF66FF, str_mes);
	return 1;
}
stock UpdateStats_Business()
{
	new business_free;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(GetString(BizData[i][bOwner], "The State")) business_free++;
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "\
		Состояние бизнеса\n\
		(обновляется каждый час)\n\n\
		{FF6633}Куплено бизнесов: %i\n\
		{99FF33}Свободно бизнесов: %i", TOTAL_BUSINESSES-business_free, business_free);
	UpdateDynamic3DTextLabelText(StatsBusiness_3DLabel, 0xCCFF66FF, str_mes);
}
