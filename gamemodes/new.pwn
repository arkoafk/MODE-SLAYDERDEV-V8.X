stock LoadCarriers()
{
	for(new i; i < sizeof(Carriers_PickupPos); i++)
	{
		Create3DTextLabel("Информация о \nтрудоустройстве", 0xFFFFFFFF, Carriers_PickupPos[i][0], Carriers_PickupPos[i][1], Carriers_PickupPos[i][2], 18.0000, 0, 0);
		CreatePickup(1275, 64, Carriers_PickupPos[i][0], Carriers_PickupPos[i][1], Carriers_PickupPos[i][2], -1, pickupInvCarriers);
		Carriers_Area[i] = CreateDynamicSphere(Carriers_PickupPos[i][0], Carriers_PickupPos[i][1], Carriers_PickupPos[i][2], 100.0, 0, 0, -1);
	}
	for(new i; i < sizeof(CarriersCarData); i++)
	{
		Carriers_CarTrailer[i] = -1;
		Carriers_CarData[i] = AddStaticVehicleEx(CarriersCarData[i][fcModel], CarriersCarData[i][fcX], CarriersCarData[i][fcY], CarriersCarData[i][fcZ], CarriersCarData[i][fcA], CarriersCarData[i][fcColor_0], CarriersCarData[i][fcColor_1], 300);
		VehicleData[Carriers_CarData[i]][V_ACTION_TYPE] = 4;
		VehicleData[Carriers_CarData[i]][V_ACTION_ID] = iter_SearchNearestBusiness(36, CarriersCarData[i][fcX], CarriersCarData[i][fcY], CarriersCarData[i][fcZ]);
		OnVehicleSpawn(Carriers_CarData[i]);
	}
	//STREAMER_TAG_RACE_CP CreateDynamicRaceCP(type, Float:x, Float:y, Float:z, Float:nextx, Float:nexty, Float:nextz, Float:size, worldid = -1, interiorid = -1, playerid = -1, Float:streamdistance = STREAMER_RACE_CP_SD, STREAMER_TAG_AREA areaid = STREAMER_TAG_AREA -1, priority = 0)
	for(new i; i < sizeof(plant_Pos); i++)
	{
		plant_CP[i] = CreateDynamicCP(plant_Pos[i][0], plant_Pos[i][1], plant_Pos[i][2], 5.1999998092651, 0, 0);
	}
	//Create3DTextLabel("Склад\nпроизводственного\nцеха", 0xFFFFFFFF, -1044.6556, 2208.5808, 42.0000, 25.0000, 0, 0);
	//Create3DTextLabel("Нефтезавод\n\n{FFCD00}На складе\n28920 л. нефти.", 0xFFFFFFFF, 2650.2498, 633.9956, 23.1951, 30.0000, 0, 0);
	//Create3DTextLabel("На складе:\n{FF9900}Топливо: 1000000 / 1000000 л.", 0xFFFFFFFF, -1113.0325, 2167.2761, 41.9553, 20.0000, 0, 0);
	//Create3DTextLabel("На складе:\n{FF9900}Металл: 46940892 / 1000000 кг.", 0xFFFFFFFF, -1038.5582, 2188.2224, 41.9553, 22.0000, 0, 0);
}
