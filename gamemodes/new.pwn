stock Timer_100ms()
{
	for(new i; i < sizeof(windPosition); i++)
	{
		if(windObject[i] == -1) continue;
		windRotY[i] += 0.01;
		if(windRotY[i] >= 360.0) windRotY[i] = 0.0;
		SetDynamicObjectRot(windObject[i], 0.0, windRotY[i], 0.0);
	}
}
public: GrandTimer()
{
	Timer_100ms();
	//if(GetTickCount() - GlobalTick < 950) return 1;
//	GlobalTick = GetTickCount();
	global_time = gettime(global_hour, global_minute, global_second);
	if(global_hour == 6 && global_minute == 8 && global_second == 30)
	{
		OnRestart();
	}
	else if(global_minute == 0)
	{
		if((global_time-g_last_pay_day_time) > 120)
		{
			OnceHourTimer();
		}
	}
	else if(global_minute == 59)
	{
		if((global_time-g_last_pay_day_time_2) > 120)
		{
			g_last_pay_day_time_2 = global_time;
			if(((global_hour % 2) == 0) && global_hour > 9 && global_hour < 23)
			{
				SendClientMessageToAll(0xFFCD00FF, "В порт доставлена новая партия контейнеров.");
				if(global_hour == 14 || global_hour == 18) container_Spawn(3, 7);
				else container_Spawn(-1, -1);
			}
			static ip[16];
			GetServerVarAsString("bind", ip, sizeof(ip));
			if(GetString(ip, "46.174.49.47") || GetString(ip, "46.174.49.47"))
			{
				foreach(new playerid: Player)
				{
					if(!IsPlayerLogged(playerid)) continue;
					if(global_hour == 23)
					{
						for(new i=6; i >= 1; --i)
						{
							PI[playerid][pGameTime_forDay][i] = PI[playerid][pGameTime_forDay][i-1];
						}
						PI[playerid][pGameTime_forDay][0] = 0;
					}
					PI[playerid][pGameTime_forHour] = 0;
				}
				if(global_hour == 23)
				{
					for(new i; i < TOTAL_BUSINESSES; i++)
					{
						if(BizData[i][bBalance_ForDay] < 80000000) 
						{
							GiveBusinessMoney(INVALID_PLAYER_ID, i, 10000000+random(30000000), -55);
						}
					}
					for(new i; i < sizeof(StallStaticData); i++)
					{
						if(!IsStallOwned(i)) continue;
						new cash = 20000000+random(30000000);
						if(IsIntEx(StallData[i][sBalance], cash))
						{
							StallData[i][sBalance] += cash;
							UpdateDataInt("Stalls", "Balance", StallData[i][sBalance], StallData[i][sID]);
						}
					}
					mysql_tquery(mysql, "UPDATE `players` SET \
						`GameTime_forDay_6` = `GameTime_forDay_5`,\
						`GameTime_forDay_5` = `GameTime_forDay_4`,\
						`GameTime_forDay_4` = `GameTime_forDay_3`,\
						`GameTime_forDay_3` = `GameTime_forDay_2`,\
						`GameTime_forDay_2` = `GameTime_forDay_1`,\
						`GameTime_forDay_1` = `GameTime_forDay_0`, \
						`GameTime_forDay_0` = '0', `adminKick_ForDay` = '0', \
						`adminBan_ForDay` = '0', `adminJail_ForDay` = '0', `adminAns_ForDay` = '0',\
						`adminMute_ForDay` = '0', `adminWarn_ForDay` = '0' WHERE 1;");
				}
			}
		}
	}
	else if((global_minute == 15 || global_minute == 35) && global_second == 20)
	{
		str_q[0] = EOS;
		mysql_stat(str_q);
		printf("mysql stat => %s", str_q);
	}
	else if(global_minute == 20 && global_second == 20 && global_hour > 11 && global_hour < 23)
	{
		pubSpawn_Start(random(3));
	}
	for(new i; i < sizeof(ContPositionData); i++)
	{
		container_Update(i);
	}
	tls_Update();
	Update_GangCapture();
	Update_CasinoDice();
	Update_FamilyCapture();
	//print("grandtimer++");
	OnVehicleUpdateEx();
	OnSecondUpdate();
	return 1;
}
