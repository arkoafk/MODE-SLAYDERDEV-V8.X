	cache_get_int(id, !"VirtualWorld", CarData[uid][cVirtualWorld]);
	cache_get_int(id, !"AlarmON", CarData[uid][cAlarmON]);
	cache_get_int(id, !"KeyIN", CarData[uid][cKeyIN]);
	cache_get_int(id, !"BagAll", CarData[uid][cBagAll]);
	str_1[0] = EOS, cache_get_string(id, "Position_SAB", str_1), sscanf(str_1, "p<,>a<f>[6]", CarData[uid][cPos_SAB]);
	str_1[0] = EOS, cache_get_string(id, "Tuning", str_1), sscanf(str_1, "p<,>a<i>[12]", CarData[uid][cTuning]);
	str_1[0] = EOS, cache_get_string(id, "Tinted_0", str_1), sscanf(str_1, "p<,>a<i>[3]", CarTinted[uid][0]);
	str_1[0] = EOS, cache_get_string(id, "Tinted_1", str_1), sscanf(str_1, "p<,>a<i>[3]", CarTinted[uid][1]);
