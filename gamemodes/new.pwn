CMD:myslots(playerid, get[])
{
	if(PI[playerid][pAdmin] > 0)
	{
		extract get -> new player:id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /myslots [id игрока]");
		cmd_myslots(playerid, id);
		return 1;
	}
	else cmd_myslots(playerid, playerid);
	return 1;
}
alias:myslots("myslot")
stock cmd_myslots(to_player, playerid)
{
	SPD(to_player, 0, DIALOG_STYLE_TABLIST_HEADERS, PN(playerid), (str_f("\
		{FFA500}Тип \t Общее кол-во \t Покупных\n\
		{ffffff}Слотов на бизнес: \t {FFA500}%i \t {ffffff}%i\n\
		{ffffff}Слотов на дом: \t {FFA500}%i \t {ffffff}%i\n\
		{ffffff}Слотов на гараж: \t {FFA500}%i \t {ffffff}%i\n\
		{ffffff}Слотов на киоски: \t {FFA500}%i \t {ffffff}%i\n\
		{ffffff}Слотов на транспорт: \t {FFA500}%i \t {ffffff}%i", \
			player_BusinessSlotsCount(playerid), PI[playerid][pPropertySlots][1],\
			player_HouseSlotsCount(playerid), PI[playerid][pPropertySlots][0],\
			player_GarageSlotsCount(playerid), PI[playerid][pPropertySlots][2],\
			player_StallSlotsCount(playerid), PI[playerid][pPropertySlots][4],\
			player_CarSlotsCount(playerid), PI[playerid][pPropertySlots][3])), "Закрыть");
	return 1;
}
stock player_Container_Click(playerid, click)
{
	if(!OpenInterface[playerid][122]) return 0;
	new type = player_ContTakeUID[playerid];
	if(type != -1)
	{
		if(!GetString(cont_Owner[type], PN(playerid)))
		{
			SCM(playerid,-825307393, "Этот контейнер Вам не принадлежит.");
			player_ContainerTake_Close(playerid);
			return 1;
		}
		player_ContTakeClick[playerid] = click;
		switch(cont_PresentType[type])
		{
			case 0..6: //{"Антиквариат", 1500000, 10467},
			{
				//cont_PresentUID[id][click] = -1;
				new price, uid, model;
				sscanf(contStatic_Present[cont_PresentUID[type][click]][cspData], "p<|>iii", price, uid, model);
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes),"{769A37}%s: №%i, %i", ContTypeData[cont_PresentType[type]][ctName], uid, model);
				str_1[0] = EOS, f(str_1, sizeof(str_1), "\
					{ffffff}-Государственная стоимость: {FFA500}%i руб\n\
					{ffffff}-Стоимость в порту: {FFA500}%i руб {B25520}(-30%%)\n\
					{ffffff}\t\n\
					{ffffff}1.Оставить себе\n\
					{ffffff}2.Продать в порту", price, price / 100 * 30);
				SPD(playerid, 20418, DIALOG_STYLE_LIST, str_mes, str_1, "Выбор", "Отмена");
			}
		}
	}
	return 1;
}
stock player_Container_Take(playerid)
{
	new type = player_ContTakeUID[playerid];
	if(type != -1)
	{
		if(!GetString(cont_Owner[type], PN(playerid)))
		{
			SCM(playerid,-825307393, "Этот контейнер Вам не принадлежит.");
			player_ContainerTake_Close(playerid);
			return 1;
		}
		str_1[0] = EOS;
		new count;
		for(new i; i < 4; i++)
		{
			if(cont_PresentUID[type][i] < 0) continue;
			new price, uid, model;
			sscanf(contStatic_Present[cont_PresentUID[type][i]][cspData], "p<|>iii", price, uid, model);
			f(str_1, sizeof(str_1), "%s[%i,%i,%i],", str_1, uid, model, i);
			count++;
		}
		if(count > 0)
		{
			strdel(str_1, strlen(str_1)-1, strlen(str_1));
			if(!OpenInterface[playerid][122])
			{
				OpenInterface[playerid][122] = true;
				ExecutePacket(playerid, webClose, "Containers");
				new modelEx;
				switch(cont_PresentType[type])
				{
					case 1,5: modelEx = 1;
					case 4: modelEx = 2;
					case 3: modelEx = 3;
					default: modelEx = 4;
				}
				ExecutePacket(playerid, webOpen, "Containers", (str_f("[[%i],[%s]]", modelEx, str_1)));
			}
			else 
			{
				ExecutePacket(playerid, webUpdate, (str_f("interface('Containers').getItems('[%s]', '[]')", str_1)));
			}
		}
		else player_ContainerTake_Close(playerid);
	}
	else player_ContainerTake_Close(playerid);
	return 1;
}
stock player_ContainerTake_Close(playerid)
{
	if(player_ContTakeUID[playerid] != -1)
	{
		OpenInterface[playerid][122] = false;
		ExecutePacket(playerid, webClose, "Containers");
		container_Clear(player_ContTakeUID[playerid]);
		player_ContTakeUID[playerid] = -1;
		player_ContTakeClick[playerid] = -1;
	}
}
stock player_Container_TakeCar(playerid)
{
	new type = player_ContTakeUID[playerid];
	if(type != -1)
	{
		if(!GetString(cont_Owner[type], PN(playerid)))
		{
			SCM(playerid,-825307393, "Этот контейнер Вам не принадлежит.");
			player_ContainerTake_Close(playerid);
			return 1;
		}
		new uid = addcars_SearchUID(cont_PresentUID[type][0]),
			default_cost, cost;
		if(uid == -1) 
		{
			cost = 18000000;
			default_cost = 30000000;
		}
		else
		{
			cost = (AddCarsData[uid][acCost]*2) / 100 * 30;
			default_cost = AddCarsData[uid][acCost]*2;
		}
		str_1[0] = EOS, f(str_1, sizeof(str_1),"\
			{ffffff}-Государственная стоимость: {FFA500}%i руб\n\
			{ffffff}-Стоимость в порту: {FFA500}%i руб {B25520}(-30%%)\n\
			{ffffff}\t\n\
			{ffffff}1.Оставить себе\n\
			{ffffff}2.Продать в порту", default_cost, cost);
		SPD(playerid, 20419, DIALOG_STYLE_LIST, "{769A37}Действие с транспортом", str_1, "Выбор", "Отмена");
	}
	return 1;
}
stock IsEntranceOwned(id)
{
	new count;
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(HouseData[i][hEntrance_ID] == id)
		{
			if(!IsHouseOwned(i)) count++;
		}
	}
	return count;
}
stock IsValidModel_Strob(vehicleid)
{
	static const model_Strob[] = {15143, 15282, 15283, 15604, 596, 597, 598, 599, 15123, 15195, 15241, 15606, 15607, 15608 ,15609 ,15620};
	for(new i; i < sizeof(model_Strob); i++)
	{
		if(model_Strob[i] == VehicleData[vehicleid][V_MODELID]) return 1;
	}
	return 0;
}
stock UpdateVehicleStrob(vehicleid, forplayerid = INVALID_VEHICLE_ID)
{
	if(!IsValidModel_Strob(vehicleid)) return 0;
	str_2[0] = EOS;
	if(!VehicleData[vehicleid][vStrob])
	{
		f(str_2, sizeof str_2, "delStroboscopes(\"[[%i],[%i]]\")", vehicleid, vehicleid + 1000);
	}
	else
	{
		f(str_2, sizeof str_2, "addStroboscopes(\"[[%i,0,-0.31,-0.02,0.75,150.00,200,%i,-1,45.00,%i],[%i,1,0.31,-0.02,0.75,150.00,400,%i,-1,45.00,%i]]\")",
			vehicleid, vehicleid, vehicleid + 1000, vehicleid + 1000, vehicleid, vehicleid);
	}
	if(forplayerid == INVALID_PLAYER_ID) 
	{
		foreach(new i: VehiclePlayersStream[vehicleid]) 
		{
			player_StrobSees[i][vehicleid] = VehicleData[vehicleid][vStrob];
			ExecutePacket(i, webUpdate, str_2);
		}
	}
	else 
	{
		player_StrobSees[forplayerid][vehicleid] = VehicleData[vehicleid][vStrob];
		ExecutePacket(forplayerid, webUpdate, str_2);
	}
	return 1;
}
//15607 190
CMD:vmute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /vmute [id игрока] [время в минутах] [причина (необязательно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 120;
	if(!(1 <= mute_time <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от 1 до %i минут", max_minute);
	if(GetPlayerData(to_player, pVMuteTime) > 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока уже есть мут вип чата");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя поставить затычку администратору выше по рангу");
	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s заблокировал VIP чат игроку %s на %i мин", PN(playerid), PN(to_player), mute_time);

	if(strlen(reason)) format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pVMuteTime, mute_time * 60);
	UpdatePlayerDataInt(to_player, "VMuteTime", mute_time * 60);

	SCM(to_player, 0xCECECEFF, !"Время до окончания бана VIP чата: {CCCC00}/time");
	player_addAList(PN(to_player), "Мут VIP чата", PN(playerid), reason);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminMute_ForDay`=`adminMute_ForDay`+1, `adminMute`=`adminMute`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:unvmute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /unmute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	if(GetPlayerData(to_player, pVMuteTime) <= 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока нет мута VIP чата");
	str_mes[0] = EOS; ////new80];
	format(str_mes, sizeof str_mes, "Администратор %s снял затычку VIP чата с игрока %s", PN(playerid), PN(to_player));
	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pVMuteTime, 0);
	UpdatePlayerDataInt(to_player, "VMuteTime", 0);

	SCM(to_player, 0x66CC00FF, "Доступ в чат восстановлен");
	return 1;
}
CMD:vc_mute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /vc_mute [id игрока] [время в минутах] [причина (необязательно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 120;
	if(!(1 <= mute_time <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от 1 до %i минут", max_minute);
	if(GetPlayerData(to_player, pVC_muteTime) > 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока уже есть мут вип чата");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя поставить затычку администратору выше по рангу");
	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s заблокировал голосовой чат игроку %s на %i мин", PN(playerid), PN(to_player), mute_time);

	if(strlen(reason)) format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pVC_muteTime, mute_time * 60);
	UpdatePlayerDataInt(to_player, "VC_muteTime", mute_time * 60);

	SCM(to_player, 0xCECECEFF, !"Время до окончания бана VOICE чата: {CCCC00}/time");
	player_addAList(PN(to_player), "Мут VOICE чата", PN(playerid), reason);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminMute_ForDay`=`adminMute_ForDay`+1, `adminMute`=`adminMute`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:unvc_mute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /unvc_mute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	if(GetPlayerData(to_player, pVC_muteTime) <= 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока нет мута VIP чата");
	str_mes[0] = EOS; ////new80];
	format(str_mes, sizeof str_mes, "Администратор %s снял затычку голосового чата с игрока %s", PN(playerid), PN(to_player));
	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pVC_muteTime, 0);
	UpdatePlayerDataInt(to_player, "VC_muteTime", 0);

	SCM(to_player, 0x66CC00FF, "Доступ в чат восстановлен");
	return 1;
}
