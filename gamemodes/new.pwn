						new attachVehicle = GetVehicleTrailer(vehicleid);
						if(VehicleData[vehicleid][V_MODELID] == 15097)
						{
							SPD(playerid, !response ? 20485 : 20484, 1, "{FFCD00}Действие на заводе", (str_f("{ffffff}Введите количество товара, которое хотите %s:", !response ? "выгрузить" : "погрузить")), "Далее","Закрыть");
						}
						else if(attachVehicle == trailerid)
						{
							if(VehicleData[trailerid][V_MODELID] != 435)
