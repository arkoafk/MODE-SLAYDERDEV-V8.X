stock ClearPlayerInfo(playerid)
{
	if(player_registerCamera[playerid] != -1) DestroyPlayerObject(playerid, player_registerCamera[playerid]), player_registerCamera[playerid] = -1;
	if(player_TempObject[playerid] != -1) DestroyPlayerObject(playerid, player_TempObject[playerid]), player_TempObject[playerid] = -1;
	if(player_registerSkin[playerid] != -1) DestroyDynamicActor(player_registerSkin[playerid]), player_registerSkin[playerid] = -1;
	for(new i; i < 5; i++)
	{
		if(player_registerActor[playerid][i] != -1) DestroyDynamicActor(player_registerActor[playerid][i]), player_registerActor[playerid][i] = -1;
	}
	player_BankPosition{playerid} = 255;
	player_HundredArea{playerid} = 255;
	player_HundredEntered[playerid] = -1;
	player_TintingEntered[playerid] = -1;
	player_BizEntered[playerid] = -1;
	player_GarageEntered[playerid] = -1;
	player_EnterGarage[playerid] = -1;
	player_GarageExited{playerid} = false;
	player_EnterBiz[playerid] = -1;
	player_BizExited{playerid} = false;
	player_BizBuyed{playerid} = false;
	player_BizHealthed{playerid} = false;
	player_Install_Number{playerid} = 255;
	player_SaveInv{playerid} = 255;
	player_SaveJail{playerid} = 255;
	player_SaveMute{playerid} = 255;
	player_SaveSettings{playerid} = 255;
	player_SaveHealth{playerid} = 255;
	player_SaveArmour{playerid} = 255;
	player_SaveCash{playerid} = 255;
	player_SaveCash_Donate{playerid} = 255;
	player_EnterTrash[playerid] = -1;
	player_InvType{playerid} = 255;
	player_FracGarageEntered[playerid] = -1;
	player_HouseEntered[playerid] = -1;
	player_EnterHouse[playerid] = -1;
	player_EnterStall[playerid] = -1;
	player_SlotStall[playerid] = -1;
	player_HouseExited{playerid} = false;
	for(new i; i < 24; i++) 
	{
		if(i < 20) RefreshInvPlayer(playerid, i);
		if(i < 10) RefreshAksInv(playerid, i);
		RefreshInvBag(playerid, i);
	}
//	EnterToBiz[playerid] = -1;
	IsPlayerDebug[playerid] = false;
	for(new i; i < sizeof(CefPublic); i++) 
	{
		OpenInterface[playerid][i] = false;
	}

	g_pickup_flood[playerid] = 0;

	ClearPlayerOffer(playerid);
	ClearPlayerListitemValues(playerid);
	AntiFloodPlayerInit(playerid);
}

stock CreateMedBeds()
{
	for(new i; i < sizeof g_med_bed_pos; i ++)
	{
		global_MedBed_Sphere[i] = CreateDynamicSphere(g_med_bed_pos[i][0], g_med_bed_pos[i][1], g_med_bed_pos[i][2], 1.2);
		g_med_bed_label[i] = CreateDynamic3DTextLabel(!" ", 0xFFFFFFEE, g_med_bed_pos[i][0], g_med_bed_pos[i][1], g_med_bed_pos[i][2], 5.0, _, _, _, 3, 3);
		UpdateDynamic3DTextLabelTextf(g_med_bed_label[i], 0xFFFFFFFFFFFFFFEE, "Койка №%i\n{00CC00}Свободна", i + 1);
	}
}
stock RemovePlayerAttachedObjects(playerid)
{
	for(new idx; idx < MAX_PLAYER_ATTACHED_OBJECTS; idx ++)
	{
		if(IsPlayerAttachedObjectSlotUsed(playerid, idx))
		{
			RemovePlayerAttachedObject(playerid, idx);
		}
	}
}
stock TeleportPickupsInit()
{
	for(new idx; idx < sizeof g_teleport; idx ++)
	{
		if(strlen(GetTeleportData(idx, T_NAME)) && !GetTeleportData(idx, T_PICKUP_VIRTUAL_WORLD))
		{
			new Text3D:buffer = CreateDynamic3DTextLabel
			(
				GetTeleportData(idx, T_NAME),
				0x3399FFEE,
				GetTeleportData(idx, T_PICKUP_POS_X),
				GetTeleportData(idx, T_PICKUP_POS_Y),
				GetTeleportData(idx, T_PICKUP_POS_Z) + 0.8,
				5.0,
				INVALID_PLAYER_ID,
				INVALID_VEHICLE_ID,
				0,
				0,
				0,
				-1,
				STREAMER_3D_TEXT_LABEL_SD
			);
			SetTeleportData(idx, T_LABEL, buffer);
		}
		CreatePickup(1318, 23, GetTeleportData(idx, T_PICKUP_POS_X), GetTeleportData(idx, T_PICKUP_POS_Y), GetTeleportData(idx, T_PICKUP_POS_Z), GetTeleportData(idx, T_PICKUP_VIRTUAL_WORLD));
		g_teleport_area[idx] = CreateDynamicSphere(GetTeleportData(idx, T_PICKUP_POS_X), GetTeleportData(idx, T_PICKUP_POS_Y), GetTeleportData(idx, T_PICKUP_POS_Z), 1.5, GetTeleportData(idx, T_PICKUP_VIRTUAL_WORLD));
	}
	print(!"[TP]: Все входы/выходы созданы");
}
stock InfoPickupsInit()
{
	for(new idx; idx < sizeof info_pickup; idx ++)
	{
		CreatePickup(1239, 23, GetInfoPickupData(idx, IP_POS_X), GetInfoPickupData(idx, IP_POS_Y), GetInfoPickupData(idx, IP_POS_Z), -1, PICKUP_ACTION_TYPE_INFO_PICKUP, idx);
		static title_color[16];
		format(title_color, sizeof title_color, "{%06x}", GetInfoPickupData(idx, IP_TITLE_COLOR) >>> 8);
		strins(GetInfoPickupData(idx, IP_TITLE), title_color, 0, 64);

		strins(GetInfoPickupData(idx, IP_INFO), "{FFFFFF}", 0, 100+91);
		if(strlen(GetInfoPickupData(idx, IP_LABEL_INFO)) > 3)
			CreateDynamic3DTextLabel(GetInfoPickupData(idx, IP_LABEL_INFO), 0x99CC00DD, GetInfoPickupData(idx, IP_POS_X), GetInfoPickupData(idx, IP_POS_Y), GetInfoPickupData(idx, IP_POS_Z) + 0.7, 9.5);
	}
}
