								SPD(playerid, !response ? 20485 : 20484, 1, "{FFCD00}Действие на заводе", (str_f("{ffffff}Введите количество товара, которое хотите %s:", !response ? "выгрузить" : "погрузить")), "Далее","Закрыть");
							}
							else
							{
								SCM(playerid,-1717986817, "Данный прицеп не подходит для вашего заказа, возьмите в гараже другой");
								SCM(playerid,-1717986817, "Ваш заказ не предусматривает загрузку / разгрузку на заводе");
							}
						}
						else SCM(playerid,-1717986817, "Ваш прицеп должен быть прикреплён к рабочему транспорту");
					}
					else SCM(playerid,-1717986817, "Вы должны взять соответствующий прицеп из гаража компании");
				}
			}
		}
		case 20482:
		{
			if(!response) return 1;
			new uid = player_SearchJobID(playerid, 0);
			if(uid != -1)
			{
				new bizid = player_ShowUID[playerid][158];

				player_Carriers_BizID[playerid] = bizid;

				new type = (BizData[bizid][bType] == 1 ? 0 : 1);
				SetPlayerRaceCheckpoint(playerid, 2, plant_Pos[type][0], plant_Pos[type][1], plant_Pos[type][2], 0.0, 0.0, 0.0, 6);
				SCM(playerid,-1, " ");
				if(type == 0)
				{
					SCM(playerid,-1, "Вы начали выполнение заказа. Загрузите необходимое количество {ffd595}топлива{ffffff} на нефтезаводе ({ffbc57}(Отмечено красной точкой){ffffff})");
					SCM(playerid,-1, "После этого отправляйтесь к {ffd595}заправочной станции{ffffff}, которая будет отмечена {f06868}красной точкой{ffffff} на карте");
				}
				else
				{
					SCM(playerid,-1, "Вы начали выполнение заказа. Загрузите необходимое количество {ffd595}товара{ffffff} на заводе ({ffbc57}(Отмечено красной точкой){ffffff})");
				}
				//player_Carriers_Products[playerid] = 0;
				//player_Carriers_Update(playerid, temp);

				player_Carriers_RandAdvice(playerid);
			}
		}
		case 20481:
		{
			if(!response) return callcmd::teamcar(playerid);
			new rang = strval(inputtextsave);
			if(rang > 0 && rang < 11)
			{
				new carid = player_ShowUID[playerid][111];
				if(VehicleData[carid][V_ACTION_TYPE] == PI[playerid][pMember_ID])
				{
					team_CarRang[carid] = rang;
					fraction_SaveCars();
					callcmd::teamcar(playerid);
				}
			}
		}
		case 20480:
		{
			if(!response) return 1;
			new vehicleid = GetPlayerVehicleID(playerid);
			if(IsValidVehicle(vehicleid))
			{
				new vehicle_type = GetVehicleData(vehicleid, V_ACTION_TYPE);
				switch(vehicle_type)
				{
					case 4:
					{
						new id = player_SearchJobID(playerid, 0);
						if(id != -1)
						{
							new i = PI[playerid][pJob_BizID][id];
							if(i != -1)
							{
								if(i == VehicleData[vehicleid][V_ACTION_ID])
								{
									new carid = PI[playerid][pTemp_JobCarID][id];
									if(carid == vehicleid)
									{
										switch(listitem)
										{
											case 0: //1. {ffc386}Поместить транспорт {ffffff}на парковку\n
											{
												player_Carriers_DutyExit(playerid, id, true);
												SCM(playerid,-1, " ");
												new Float:carhp;
												GetVehicleHealth(vehicleid, carhp);
												if(carhp > 800) 
												{
													GivePlayerMoneyEx(playerid, 20000000, "Вернул фуру обратно ТК");
													SCM(playerid,-1, "Возвращена сумма, которая являлась залогом: {ffe36c}20000000 руб.");
												}
												if(player_Carriers_Wage[playerid] > 0)
												{
													SCMf(playerid,-1, "Ваша общая прибыль за данную смену составляет: {00CC00}%i руб.", player_Carriers_Wage[playerid]);
												}
												SCM(playerid,-1, "Грузовик был {ffe36c}отправлен на парковку{ffffff}, Ваш рабочий день завершён");
											}
											case 1: //2. {ffc386}Поместить прицеп{ffffff} в гараж\n
											{
												new uid = Carriers_SearchVehicleUID(vehicleid);
												if(uid != -1)
												{
													new trailer = Carriers_CarTrailer[uid];
													if(trailer == -1)
													{
														SCM(playerid,-1717986817, "Вы не брали прицеп из гаража компании");
													}
													else
													{
														if(GetVehicleTrailer(vehicleid) > 0)
														{
															//помещаем
															SCM(playerid,-1, "Ваш прицеп был {ffe36c}помещён в гараж{ffffff} транспортной компании");
															new next = trailer;
															Carriers_CarTrailer[uid] = -1;
															DestroyVehicle(trailer, next, "fastr 231");
														}
														else SCM(playerid,-1717986817, "Вам необходимо прикрепить прицеп к транспорту");
													}
												}
											}
											case 2: //3. {fff486}Вывезти из гаража{ffffff} прицеп для груза\n
											{
												player_Carriers_TrailerSpawn(playerid, vehicleid, 435);
											}
											case 3: //4. {fff486}Вывезти из гаража{ffffff} цистерну для топлива\n
											{
												player_Carriers_TrailerSpawn(playerid, vehicleid, 584);
											}
											case 4: //5. Информация о транспорте", "Далее","Закрыть");
											{
												SPD(playerid, 0, 0, "{FFCD00}Информация о парковке", "{ffffff}На базе каждой транспортной компании есть парковка для грузовиков. Одновременно на парковке не может<n>располагаться более 5 фур. Это стандартные лимиты на парковочные места. Иногда транспорта<n>может и вовсе не быть.<n><n>Начинающие компании могут позволить себе немного транспорта, по мере развития автопарк становится больше.<n>Обищй лимит транспортных средств в компании - 20 единиц. На каждого сотрудника предусмотрен транспорт.<n><n>Как только сотрудник возьмёт себе транспорт и покинет парковку, при наличии транспорта в гараже,<n>спустя некоторое время на парковку будет вывезен очередной грузовик. Владелец компании может полностью <n>распоряжаться своими транспортными средствами, и при необходимости изменять свой автопарк.<n><n>Если сотрудник нанёс ущерб транспорту, или доставлемому товару - ему выдадут штраф на определённую сумму.<n>Полный список штрафов можно глянуть в руководстве (/jmenu > Руководство).<n><n>", "Закрыть");
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		case 20479:
		{
			if(!response) return RemovePlayerFromVehicle(playerid);
			new id = player_SearchJobID(playerid, 0);
			if(id != -1)
			{
				new i = PI[playerid][pJob_BizID][id],
					vehicleid = GetPlayerVehicleID(playerid);
				if(i != -1 && IsValidVehicle(vehicleid))
				{
					if(i == VehicleData[vehicleid][V_ACTION_ID])
					{
						//if(player_Cash[playerid] < 20000000)
						if(CompareInt64(playerid, "<", 20000000))
						{
							GameTextForPlayerEx(playerid, "~r~Недостаточно денег", 4000, 2);
							RemovePlayerFromVehicle(playerid);
							return 1;
						}
						GivePlayerMoneyEx(playerid, -20000000, "Аренда грузовика ТК");
						Carriers_ResetVehicle(playerid);
						PI[playerid][pTemp_JobCarID][id] = vehicleid;
						DestroyVehicleLabel(vehicleid);
						VehicleData[vehicleid][V_FUEL] = 150.0;
						new type = BizData[i][bType];
						f(str_mes, sizeof(str_mes), "Транспортная компания\n{ffffff}%s %s", BizStaticData[type][bsName], BizData[i][bName]);
