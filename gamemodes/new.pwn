CMD:s(playerid, params[])
{
	if(GetPlayerLevel(playerid) < 2)
		return SCM(playerid, 0xCECECEFF, !"Этим можно пользоваться со 2 уровня");

	if(IsPlayerMuted(playerid))
		return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /s [текст]");

	SetPlayerChatBubble(playerid, params, 0xFFFFFFFF, 37.0, 5000);

	f(str_mes, sizeof str_mes, "%s%s[%i] крикнул: %s", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{FFFFFF} " : ""), PN(playerid), playerid, params);
	SendMessageInLocal(playerid, str_mes, 0xFFFFFFFF, 37.0);

	ApplyAnimation(playerid, "ON_LOOKERS", "shout_01", 4.0, 0, 0, 0, 0, 0, 0);
	return 1;
}

CMD:n(playerid, params[])
{
	if(IsPlayerMuted(playerid))
		return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /n [нон-рп сообщение]");

	SetPlayerChatBubble(playerid, params, 0x999999FF, 30.0, 5000);

	f(str_mes, sizeof str_mes, "%s(( %s[%i]: %s ))", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{CCCC99} " : ""), PN(playerid), playerid, params);
	SendMessageInLocal(playerid, str_mes, 0xCCCC99FF, 30.0);

	return 1;
}

CMD:lic(playerid, params[])
{
	extract params -> new to_player; else return SCM(playerid, 0x999999FF, !"Используйте: /lic [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 4.0))
		return SCM(playerid, 0x999999FF, !"* Игрок слишком далеко");

	ExecutePacket(to_player, webOpen, "Docs", (str_f("[[1,[\"%s\",[%i,%i,%i,0,0,0]]]]", PN(playerid), (PI[playerid][pLicense_Driving] > 0 ? 1 : 0), (PI[playerid][pLicense_Driving] > 1 ? 1 : 0), PI[playerid][pLicense_Weapon])));
	format(str_mes, sizeof str_mes, "%s свои лицензии", to_player == playerid ? "просматривает" : "показал");
	Action(playerid, str_mes, _, false);
	return 1;
}

CMD:pass(playerid, params[])
{
	extract params -> new to_player; else return SCM(playerid, 0x999999FF, !"Используйте: /pass [id игрока]");

	if(!IsPlayerConnected(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
		return SCM(playerid, 0x999999FF, !"* Игрок слишком далеко");
	if(OpenInterface[to_player][6] != false) return SCM(playerid, 0x999999FF, !"Вы находитесь слишком далеко от игрока");
	Action(playerid, "показал свой паспорт", _, false);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "[[0,[\"%s\",%i,\"Нет\",%i,0,%i,%i,0,\"\"]]]", PN(playerid), PI[playerid][pSex], PI[playerid][pLevel], PI[playerid][pSkin], PI[playerid][pWanted]);
	ExecutePacket(to_player, webOpen, "Docs", str_mes);
	return 1;
}
CMD:l(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

		new lights = (GetVehicleParam(vehicleid, V_LIGHTS) ^ VEHICLE_PARAM_ON);
		SetVehicleParam(vehicleid, V_LIGHTS, lights);
	}
	return 1;
}
alias:l("lights")
CMD:sl(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

		new limit = (GetVehicleData(vehicleid, V_LIMIT) ^ VEHICLE_PARAM_ON);
		SetVehicleData(vehicleid, V_LIMIT, limit);
	}
	return 1;
