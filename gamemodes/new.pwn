new bool:IsPlayerDebug[MAX_PLAYERS];
stock SCMD(playerid, const message[])
{
	if(!IsPlayerDebug[playerid]) return 1;
	SCM(playerid,-1,message);
	return 1;
}
CMD:debug_show(playerid)
{
	//if(CheckAdmin(playerid, 8)) return 1;
	IsPlayerDebug[playerid] = !IsPlayerDebug[playerid];
	if(IsPlayerDebug[playerid]) SCM(playerid,-1,!"debug on");
	else SCM(playerid,-1,!"debug off");
	return 1;
}
