			case 82: //[0,\"Посмотреть тех. паспорт\",4,82,2]
			{

			}
			case 38: //[0,\"Список событий\",6,38,0],
			{

			}
			case 105: //[0,\"Список руководителей\",6,105,1]
			{

			}
		}
	}
	return 1;
}
CMD:sellproperty(playerid)
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	SPD(playerid, 20378, DIALOG_STYLE_LIST, "sellproperty", "1. Дома\n2. Бизнесы\n3. Гаражи\n4. Слет симок(те кто не заходили в игру 15 дней)", "Вайпнуть", "Назад");
	return 1;
}
public: SellProperty(id)
{
	if(!freeze_sellproperty[id]) return 0;
	if(id == -1 || id == 1)
	{
		for(new i; i < TOTAL_BUSINESSES; i++)
		{
			if(!GetString(BizData[i][bOwner], "Sell Nalog")) continue;
			if(!GetString(BizData[i][bAuction_Owner], "The State"))
			{
				ChangeBusinessOwner(i, BizData[i][bAuction_Owner]);
				SetString(BizData[i][bAuction_Owner], "The State");
				BizData[i][bAuction_Bet] = 0;
				UpdateDataInt("Businesses", "Auction_Bet", BizData[i][bAuction_Bet], BizData[i][bID]);
				UpdateDataStr("Businesses", "Auction_Owner", BizData[i][bAuction_Owner], BizData[i][bID]);
			}
			else ChangeBusinessOwner(i, "The State");
		}
	}
	if(id == -1 || id == 0)
	{
		for(new i; i < TOTAL_HOUSES; i++)
		{
			if(!GetString(HouseData[i][hOwner], "Sell Nalog")) continue;
			if(!GetString(HouseData[i][hAuction_Owner], "The State"))
			{
				ChangeHouseOwner(i, HouseData[i][hAuction_Owner]);
				SetString(HouseData[i][hAuction_Owner], "The State");
				HouseData[i][hAuction_Bet] = 0;
				UpdateDataInt("Houses", "Auction_Bet", HouseData[i][hAuction_Bet], HouseData[i][hID]);
				UpdateDataStr("Houses", "Auction_Owner", HouseData[i][hAuction_Owner], HouseData[i][hID]);
			}
			else ChangeHouseOwner(i, "The State");
		}
	}
	if(id == -1 || id == 2)
	{
		for(new i; i < TOTAL_GARAGES; i++)
		{
			if(!GetString(GarageData[i][gOwner], "Sell Nalog")) continue;
			if(!GetString(GarageData[i][gAuction_Owner], "The State"))
			{
				ChangeGarageOwner(i, GarageData[i][gAuction_Owner]);
				SetString(GarageData[i][gAuction_Owner], "The State");
				GarageData[i][gAuction_Bet] = 0;
				UpdateDataInt("Garages", "Auction_Bet", GarageData[i][gAuction_Bet], GarageData[i][gID]);
				UpdateDataStr("Garages", "Auction_Owner", GarageData[i][gAuction_Owner], GarageData[i][gID]);
			}
			else ChangeGarageOwner(i, "The State");
		}
	}
	if(id == -1 || id == 3)
	{
		mysql_tquery(mysql, (str_f("UPDATE `players` SET `Phone_Number` = '0' WHERE `Phone_Number` != 0 AND `Last_LoginTime` <= %i", global_time-864000)));
	}
	freeze_sellproperty[id] = false;
	return 1;
}
CMD:returnmoney(playerid)
{
	if(PI[playerid][pReturnMoney] > 0)
	{
		GivePlayerMoneyEx(playerid, PI[playerid][pReturnMoney], "ReturnMoney");
		PI[playerid][pReturnMoney] = 0;
		UpdateDataInt("players", "ReturnMoney", PI[playerid][pReturnMoney], PI[playerid][pID]);
	}
	return 1;
}
stock SetPlayerHealthEx(playerid, Float: health)
{
	PI[playerid][pHealth] += health;
	if(PI[playerid][pHealth] > 90) 
	{
		PI[playerid][pHospital] = false;
		UpdatePlayerDataInt(playerid, "Hospital", PI[playerid][pHospital]);
		if(GetPlayerData(playerid, pTemp_BedID) != -1)
		{
			ClearMedBed(playerid, GetPlayerData(playerid, pTemp_BedID));
		}
		PI[playerid][pTemp_BedID] = -1;
	}

	if(PI[playerid][pHealth] > 100) PI[playerid][pHealth] = 100;
	else if(PI[playerid][pHealth] < 2) PI[playerid][pHealth] = 0;

//	s_PlayerHealth[playerid] = PI[playerid][pHealth];
	SetPlayerHealth(playerid, PI[playerid][pHealth]);
	player_SaveHealth{playerid} = 5;
	return 1;
}
stock SetPlayerArmourEx(playerid, Float:armour)
{
	PI[playerid][pArmour] += armour;
	if(PI[playerid][pArmour] > 100) PI[playerid][pArmour] = 100;
	else if(PI[playerid][pArmour] < 0) PI[playerid][pArmour] = 0;

//	s_PlayerArmour[playerid] = PI[playerid][pArmour];
	SetPlayerArmour(playerid, PI[playerid][pArmour]);
	player_SaveArmour{playerid} = 5;
}
stock ClothingStore_List(playerid, list)
{
	if(list < 0) list = 0;
	player_ShowID[playerid][20] = list;
	str_1[0] = EOS;
	new 
		start = list*8,
		end = (list+1)*8,
		bool:count;
	for(new i=start; i < end; i++)
	{
		if(!PI[playerid][pSex]) 
		{
			if(i >= sizeof(ClothingStore_Data_0)) end = sizeof(ClothingStore_Data_0)-1;
		}
		else if(i >= sizeof(ClothingStore_Data_1)) end = sizeof(ClothingStore_Data_1)-1;
	}
	
	str_1[0] = EOS;
	for(new i=start; i < end; i++)
	{
		if(!count) count = true;
		else strcat(str_1, ",");
		if(!PI[playerid][pSex]) 
		{
			strcat(str_1, (str_f("[%i,%i]", ClothingStore_Data_0[i][0], ClothingStore_Data_0[i][1])));
		}
		else
		{
			strcat(str_1, (str_f("[%i,%i]", ClothingStore_Data_1[i][0], ClothingStore_Data_1[i][1])));
		}
	}
	return 1;
}
stock ClothingStore_Update(playerid)
{
	if(!OpenInterface[playerid][24])
	{
		OpenInterface[playerid][24] = true;
		ClothingStore_List(playerid, 0);
		ExecutePacket(playerid, webOpen, "ClothingStore", (str_f("[%s]", str_1)));
		SetPlayerPos(playerid, 1990.369140625, 1898.9442138672, 1001.1);
		SetPlayerFacingAngle(playerid, 316.0);
		SetPlayerCameraPos(playerid, 1991.7893066406, 1901.3530273438, 1001.7111206055);
		SetPlayerCameraLookAt(playerid, 1990.0413818359, 1896.4249267578, 1000.4935302734);
		SetPlayerVirtualWorld(playerid, 1000+playerid);
		TogglePlayerControllable(playerid, false);
	}
	else
	{
		ClothingStore_List(playerid, player_ShowID[playerid][20]);
		ExecutePacket(playerid, webUpdate, (str_f("interface('ClothingStore').loadItems('[%s]')", str_1)));
	}
	return 1;
}
stock player_ClothingStore(playerid, event, item)
{
	if(!OpenInterface[playerid][24]) return 1;
    switch(event)
    {
        case 0:
        {
			if (item == -1 && !player_ShowID[playerid][20]) return 1;
			else if(item != -1)
			{
				if (!PI[playerid][pSex]) 
				{
					if(player_ShowID[playerid][20] >= floatround(sizeof(ClothingStore_Data_0)) / 8) return 1;
				}
				else if(player_ShowID[playerid][20] >= floatround(sizeof(ClothingStore_Data_1)) / 8) return 1;
			}
			ClothingStore_List(playerid, player_ShowID[playerid][20]+(item == -1 ? -1 : 1));
			ClothingStore_Update(playerid);
			ExecutePacket(playerid, webUpdate, (str_f("interface('ClothingStore').setPage('%i')", player_ShowID[playerid][20] + 1)));
        }
        case 1:
        {
			SetPlayerSkin(playerid, (!PI[playerid][pSex] ? ClothingStore_Data_0[(player_ShowID[playerid][20] * 8) + item][1] : ClothingStore_Data_1[(player_ShowID[playerid][20] * 8) + item][1]));
        }
        case 2:
        {
			player_ShowData[playerid][20] = player_ShowID[playerid][20] * 8 + item;
			SPD(playerid, 20341, DIALOG_STYLE_MSGBOX,
                "{FFCD00}Магазин одежды",
                "{FFFFFF}Вы действительно хотите приобрести этот набор одежды?",
                "Да", "Нет");
        }
        case 4: player_ClothingStore_Exit(playerid);
    }
    return 1;
}
stock player_ClothingStore_Exit(playerid)
{
	ExecutePacket(playerid, webClose, "ClothingStore");
	OpenInterface[playerid][24] = false;
	SetCameraBehindPlayer(playerid);
	TogglePlayerControllable(playerid, true);

	SetPlayerVirtualWorld(playerid, player_BizEntered[playerid] + 5);
	player_UpdatePerson(playerid);
}
CMD:dice(playerid)
{
	if(player_Casino_Type{playerid} == 2) return 1;
	for(new i; i < sizeof(Casino_Dice); i++)
	{
		if(!IsPlayerInRangeOfPoint(playerid, 2.5, Casino_Dice[i][0], Casino_Dice[i][1], 1011.8900146484)) continue;
		cmd_dice(playerid, i);
		return 1;
	}
	SCM(playerid, -1, "Вы должны находиться рядом со слотом игры в кости!");
	return 1;
}
stock cmd_dice(playerid, type)
{
	ExecutePacket(playerid, webClose, "CasinoDice");
	if(player_Casino_Type{playerid} == 2) return 1;
	player_Casino_ID{playerid} = type;
	player_Casino_Type{playerid} = 2;
	ExecutePacket(playerid, webOpen, "CasinoDice", "{\"windows\":{\"queries\":true,\"game\":false,\"action\":false}}");
	player_CasinoDice_Update(playerid);
	return 1;
}
stock drift_UpdatePlayer()
{
	str_1[0] = EOS;
	new count;
	foreach(new playerid: PlayersDrift)
	{
		if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid) || count < 5) continue;
		//["Michael_Oreshkin", 2717, 191, "Audi"]
		str_while[count] = playerid;
		count++;
	}
	for(new i; i < count; i++)
	{
		new playerid = str_while[count];
		f(str_1, sizeof(str_1), "interface('Drift').setInfo('[\"%s\", [\"%s\", %i, 0, \"LADA\"], [%s]]')", PN(playerid), Drift_NickName, Drift_Count, str_1);
		ExecutePacket(playerid, webUpdate, str_1);
	}
	return 1;
}
stock memset(array[], val, size = sizeof array)
{
	#pragma unused array, val
	static
		fill_inst_offset;
	if (fill_inst_offset == 0) {
		#emit lctrl 6
		#emit move.alt 
		#emit lctrl 0  
		#emit add      
		#emit move.alt
		#emit lctrl 1  
		#emit sub.alt           
		#emit add.c 92                
		#emit stor.pri fill_inst_offset 
	} {}               
	#emit load.s.pri size               
	#emit shl.c.pri 2  
	#emit sref.pri fill_inst_offset     
	#emit load.s.alt 12
	#emit load.s.pri 16
	#emit fill 1   
	#emit zero.pri
	#emit retn
}
