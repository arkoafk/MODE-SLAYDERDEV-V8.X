			{
				SPD(playerid, 20342, DIALOG_STYLE_LIST, "{FFCD00}Салон сотовой связи", "\
					1. Мобильный телефон\t\t{2EB82E}735000 руб\n\
					2. Часы с коричневым ремешком\t\t{2EB82E}1050000 руб\n\
					3. Часы с белым ремешком\t\t{2EB82E}1050000 руб\n\
					4. Изменить номер телефона\t\t{2EB82E}175000 руб\n\
					5. Изменить цвет телефона\t\t{2EB82E}70000 руб\n\
					6. Планшет\t\t{2EB82E}350000 руб\n\
					7. Фотоаппарат\t\t{2EB82E}245000 руб\n\
					8. Пополнить счёт телефона", "Выбрать","Закрыть");
			}
			//35, "Спортзал
			//36, "Транспортная Компания
			//37, "Тир
			//38, "Управление статистики
			//39, "Ферма
			//40, "Шиномонтаж
			//41, "Sex shop
			//42, "Ветровые станции
			default: player_BusinessShopDialog(playerid);
