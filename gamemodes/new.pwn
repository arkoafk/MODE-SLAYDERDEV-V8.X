	CarObject[MAX_OWNABLECARS][9] = {{INVALID_OBJECT_ID, ...}, ...},
	CarTinted[MAX_OWNABLECARS][2][3],
	OwnableCar[MAX_OWNABLECARS] = {INVALID_VEHICLE_ID, ...},
