stock player_BusinessShopDialog(playerid)
{
	new bizid = player_BizEntered[playerid];
	if(bizid != -1)
	{
		player_ShopDialog(playerid, bizid);
	}
}
stock player_ShopDialog(playerid, bizid)
{
	str_1 = "Товар \tСтоимость\n\n";
	new loaded;
	for(new i; i < sizeof(ShopStaticData); i++) 
	{
		if(ShopStaticData[i][shopType] != BizData[bizid][bType]) continue;
		f(str_1, sizeof(str_1), "%s%i. %s \t%i руб\n", \
			str_1, loaded+1, \
			ShopStaticData[i][shopName], \
			global_GetShopPrice(ShopStaticData[i][shopName])*BizData[bizid][bProductEx]);
		player_ShowData[playerid][loaded] = i;
		loaded++;
	}
	SPD(playerid, 913, DIALOG_STYLE_TABLIST_HEADERS, "Список товаров",str_1,"Выбор","Закрыть");
}
stock player_BusinessBuyed(playerid)
{
	new bizid = player_BizEntered[playerid];
	if(bizid != -1)
	{
