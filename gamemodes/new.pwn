public: KickEx(playerid)
{
	if(playerid == INVALID_PLAYER_ID) return 0;
	Kick(playerid);
	return 1;
}
stock _IsPlayerConnected(playerid)
{
	if(playerid < 0 || playerid > MAX_PLAYERS-1) return 0;
	return (playerid & 0xFFFF0000) ? 0 : (IsPlayerConnected(playerid));
}
