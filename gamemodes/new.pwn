CMD:sellgarage(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_garage(playerid, 20344);
	return 1;
}
stock SellGarage(id)
{
	GarageData[id][gLevel] = 0;
	GarageData[id][gLock] = true;
	UpdateDataInt("Garages", "Level", GarageData[id][gLevel], GarageData[id][gID]);
	UpdateDataInt("Garages", "Lock", GarageData[id][gLock], GarageData[id][gID]);
	ChangeGarageOwner(id, "The State");
}
CMD:sellmyhome(playerid, get[])
{
	extract get -> new to_player, price; else return SCM(playerid, 0xCECECEFF, "Используйте: /sellmyhome [id игрока] [стоимость]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(price < 1) return SCM(playerid, 0xFF6600FF, "Укажите стоимость продажи");
	//if (player_Cash[to_player] < price) return SCM(playerid, 0xCECECEFF, "У этого игрока нет такой суммы");

	new count = player_HouseSlotsCount(to_player);
	if(count <= GetPlayerHouses(to_player))
	{
		SCM(playerid, 0x3399FFFF, "Игрок уже имеете максимально количество домов.");
		return 1;
	}
	SetPVarInt(playerid, "sellmyhome_toplayer", to_player);
	SetPVarInt(playerid, "sellmyhome_price", price);
	cmd_house(playerid, 20346);
	return 1;
}
CMD:sellmycar(playerid, get[])
{
	extract get -> new to_player, price; else return SCM(playerid, 0xCECECEFF, "Используйте: /sellmycar [id игрока] [стоимость]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(price < 1) return SCM(playerid, 0xFF6600FF, "Укажите стоимость продажи");
	//if(player_Cash[to_player] < price) return SCM(playerid, 0xCECECEFF, "У этого игрока нет такой суммы");
	new vehicleid = GetNearestVehicleID(playerid, 6.0);
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new number = GetVehicleID(vehicleid);
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				SCM(playerid, 0x808080FF, !"Вы должны находиться рядом со своим авто!");
				return 1;
			}
			SetPVarInt(playerid, "sellmycar_toplayer", to_player);
			SetPVarInt(playerid, "sellmycar_price", price);
			SetPVarInt(playerid, "sellmycar_VehicleID", vehicleid);
			cmd_getv(playerid, playerid, 20347);
		}
	}
	return 1;
}
CMD:pcreate(playerid)
{
	player_CreatePromo(playerid, 0);
	return 1;
}
CMD:pcode(playerid)
{
	SPD(playerid, 20411, 1, "Активация бонус кода", "Введите ваш бонус код в поле ниже", "Далее","Отмена");
	return 1;
}
public: player_pcode(playerid)
{
	if(!cache_num_rows()) SCM(playerid, 0x999999FF, "Введенный промокод не существует");
	else
	{
		cache_get_string(0, "Name", player_Promo_Name[playerid]);
		cache_get_string(0, "Data_0", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][0]);
		cache_get_string(0, "Data_1", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][1]);
		cache_get_string(0, "Data_2", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][2]);
		cache_get_int(0, "Activation", player_Promo_Used[playerid]);
		cache_get_int(0, "Minutes", player_Promo_Minutes[playerid]);
		if(player_Promo_Used[playerid] < 2)
		{
			SCM(playerid, 0x999999FF, "Введенный промокод не существует");
			str_q[0] = EOS, f(str_q, sizeof(str_q), "DELETE FROM `Promocodes` WHERE `Name` = '%s' LIMIT 1;", player_Promo_Name[playerid]);
			mysql_tquery(mysql, str_q);
			return 1;
		}
		str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `pID` FROM `Promocodes_Used` WHERE `pID` = '%i' AND `Name` = '%s' LIMIT 1;", PI[playerid][pID], player_Promo_Name[playerid]);
		mysql_tquery(mysql, str_q, "player_pcode_used", "i", playerid);
	}
	return 1;
}
public: player_pcode_used(playerid)
{
	if(!cache_num_rows())
	{
		player_Promocode_Presents(playerid);
		f(str_1, sizeof(str_1), "\
			Вы действительно хотите активировать бонус-код \"%s\"?\n\
			Призы:\n\
			%s", player_Promo_Name[playerid], str_1);
		SPD(playerid, 20368, DIALOG_STYLE_MSGBOX, "Подтверждение", str_1, "Создать", "Отмена");
	}
	else SCM(playerid, 0x999999FF, "Вы уже активировали этот промокод");
	return 1;
}
stock player_CreatePromo(playerid, step)
{
	switch(step)
	{
		case 0: //start
		{
			player_Promo_Name[playerid][0] = EOS;
			for(new i; i < 10; i++)
			{
				player_Promo_Data[playerid][0][i] = 0;
				player_Promo_Data[playerid][1][i] = 0;
				player_Promo_Data[playerid][2][i] = 0;
			}
			SPD(playerid, 20348, DIALOG_STYLE_INPUT, "{FFCD00}Создание промокода", "\
				Введите название промокода\n\
				{AAAAAA}От 4 до 32 символов", "Ввести", "Закрыть");
		}
		case 1: //add present
		{
			str_1 = "{AAAAAA}Добавить приз\n\
					 {AAAAAA}Изменить количество активаций\n\
					 {AAAAAA}Изменить количество минут для активации\n\
					 {AAAAAA}Создать промокод\n";
			for(new i, count = 1; i < 10; i++)
			{
				new item = player_Promo_Data[playerid][0][i];
				if(!item) continue;
				if(!player_Promo_Data[playerid][1][i] && !player_Promo_Data[playerid][2][i]) 
				{
					strcat(str_1, (str_f("{940000}%i. %s, индитификатор %i, количество %i\n", count, ItemsPromoData[item], player_Promo_Data[playerid][1][i], player_Promo_Data[playerid][2][i])));
				}
				else
				{
					strcat(str_1, (str_f("{FFFFFF}%i. %s, индитификатор %i, количество %i\n", count, ItemsPromoData[item], player_Promo_Data[playerid][1][i], player_Promo_Data[playerid][2][i])));
				}
				count++;
			}
			SPD(playerid, 20349, DIALOG_STYLE_LIST, "{FFCD00}Приз за промокод", str_1, "Выбрать", "Закрыть");
		}
	}
	return 1;
}
CMD:get_info(playerid, get[])
{
	extract get -> new string:name[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /get_info [name]");
	str_mes[0] = EOS, mysql_escape_string(name, str_mes, 24);
	if(!NameIsFullDostup(PN(playerid)) && NameIsFullDostup(str_mes)) return SCM(playerid, -1, "Используйте: /get_info [name]");
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] просматривает статистику игрока %s", PN(playerid), playerid, str_mes);
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `ID`, `NickName`, `NickName_Referal`, FROM_UNIXTIME(Register_Time, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date_reg`, `Register_IP`, `Last_IP`, `Accept_IP`, `Email`, `Email_Accept`, `Cash`, `Bank`, `Admin`, `Family_ID`, `Family_Rang`, `Level`, `Exp`, `Phone_Number`, `Member_ID`, `Member_Rang`, FROM_UNIXTIME(Last_LoginTime, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date`, `Cash_Donate`, `Level_VIP`, `ID_Telegram`, `NickName_Telegram` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", str_mes);
	mysql_tquery(mysql, str_q, "player_getinfo", "i", playerid);
	return 1;
}
alias:get_info("checkoff", "get_off")
public: player_getinfo(playerid)
{
	if(!cache_num_rows())
	{
		SCM(playerid, 0x999999FF, "Игрок с таким именем не найден");
		return 1;
	}
	cache_get_int(0, "ID", PI[MAX_PLAYERS][pID]); //-1; //id в бд
	player_ShowData[playerid][0] = EOS;
	cache_get_string(0, "NickName", player_ShowData[playerid]); //-1; //реферал
	player_ShowID[playerid][55] = PI[MAX_PLAYERS][pID];
	cache_get_string(0, "NickName_Referal", PI[MAX_PLAYERS][pNickName_Referal]); //-1; //реферал
	static p_date_reg[22];
	cache_get_string(0, "date_reg", p_date_reg);
	cache_get_string(0, "Register_IP", PI[MAX_PLAYERS][pRegister_IP]);
	cache_get_string(0, "Last_IP", PI[MAX_PLAYERS][pLast_IP]);
	cache_get_string(0, "Accept_IP", PI[MAX_PLAYERS][pAccept_IP]);
	cache_get_string(0, "Email", PI[MAX_PLAYERS][pEmail]);
	cache_get_int(0, "Email_Accept", PI[MAX_PLAYERS][pEmail_Accept]); //false;
	static p_cash[20];
	cache_get_bigint(0,"Cash",p_cash);
	cache_get_int(0, "Bank", PI[MAX_PLAYERS][pBank]); //0;			// деньги в банке
	cache_get_int(0, "Admin", PI[MAX_PLAYERS][pAdmin]); //0;		// уровень админки
	cache_get_int(0, "Family_ID", PI[MAX_PLAYERS][pFamily_ID]); //-1;
	cache_get_int(0, "Family_Rang", PI[MAX_PLAYERS][pFamily_Rang]); //0;
	cache_get_int(0, "Level", PI[MAX_PLAYERS][pLevel]); //0;		// уровень игрока
	cache_get_int(0, "Exp", PI[MAX_PLAYERS][pExp]); //0;			// очки опыта игрока
	cache_get_int(0, "Phone_Number", PI[MAX_PLAYERS][pPhone_Number]); //0;		// номер телефона
	cache_get_int(0, "Member_ID", PI[MAX_PLAYERS][pMember_ID]); //0;			// организация
	cache_get_int(0, "Member_Rang", PI[MAX_PLAYERS][pMember_Rang]); //0;
	static p_date[22];
	cache_get_string(0, "date", p_date);
	cache_get_int(0, "Cash_Donate", PI[MAX_PLAYERS][pCash_Donate]); //0;	// текущий баланс донат-очков
	cache_get_int(0, "Level_VIP", PI[MAX_PLAYERS][pLevel_VIP]); //0;			// уровень премиум аккаунта
	cache_get_string(0, "ID_Telegram", PI[MAX_PLAYERS][pID_Telegram]); //-1;
	cache_get_string(0, "NickName_Telegram", PI[MAX_PLAYERS][pNickName_Telegram]);
	new family_id = GetFamilyID(PI[MAX_PLAYERS][pFamily_ID]);
	if(family_id >= 0) f(str_mes, sizeof(str_mes), "%s [uid: %i, rang: %i]", FamilyData[family_id][fName], family_id, PI[MAX_PLAYERS][pFamily_Rang]);
	else str_mes = "Отсутствует";
	str_1[0] = EOS, f(str_1, sizeof(str_1), "\
				\n\
				{FFFFFF}Ник пригласившего:\t%s\n\
				Дата регистрации:\t%s\n\
				Регистрационный IP:\t%s\n\
				Последний вход с IP:\t%s\n\
				Подтвержденный IP:\t%s\n\
				EMail:\t%s %s(*)\n\
				\n\
				{FFFFFF}Деньги наличные:\t%s\n\
				Деньги в банке:\t%i\n\
				Уровень админ. прав:\t%i\n\
				Семья:\t%s\n\
				Игровой уровень:\t%i\n\
				Очки опыта:\t%i\n\
				Номер телефона:\t%i\n\
				Организация:\t%s [%s, %i]\n\
				Последний вход:\t%s\n\
				Донат очки:\t%i\n\
				VIP уровень:\t%i\n\n\
				Telegram UID:\t%s\n\
				Telegram Name:\t%s\
				\n", \
					PI[MAX_PLAYERS][pNickName_Referal], p_date_reg, PI[MAX_PLAYERS][pRegister_IP], PI[MAX_PLAYERS][pLast_IP], PI[MAX_PLAYERS][pAccept_IP],\
					PI[MAX_PLAYERS][pEmail], (!PI[MAX_PLAYERS][pEmail_Accept] ? "{c70000}" : "{138708}"), p_cash, PI[MAX_PLAYERS][pBank],\
					PI[MAX_PLAYERS][pAdmin], str_mes, PI[MAX_PLAYERS][pLevel], PI[MAX_PLAYERS][pExp], PI[MAX_PLAYERS][pPhone_Number], \
					FractionStaticData[PI[MAX_PLAYERS][pMember_ID]][frName], "-", PI[MAX_PLAYERS][pMember_Rang],\
					p_date, PI[MAX_PLAYERS][pCash_Donate], PI[MAX_PLAYERS][pLevel_VIP], PI[MAX_PLAYERS][pID_Telegram], PI[MAX_PLAYERS][pNickName_Telegram]);
	SPD(playerid, 20353, DIALOG_STYLE_MSGBOX, (str_f("%s(UID: %i)", player_ShowData[playerid], PI[MAX_PLAYERS][pID])), str_1, "Имущество", "Закрыть");
	return 1;
}
CMD:addpcar(playerid, get[])
{
	extract get -> new model; else return SCM(playerid, 0xCECECEFF, !"Используйте: /addpcar [model]");
	if(IsValidCarModel(model) == -1) return SCM(playerid, -1, !"Машина с такой моделью не добавлена на сервер!");
	SendAdminsMessagef(COLOR_RED, "[A] %s[%i] создал машину для розыгрыша [model: %i]", PN(playerid), playerid, model);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	position[3] = 180.0;
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `OwnableCars` (`Owner`, `Model`, `Position`, `Color`) VALUES ('%s', '%i', '%.2f,%.2f,%.2f,%.2f,', '%i,%i')", "The State", model, position[0], position[1], position[2], position[3], 1, 1);
	mysql_tquery(mysql, str_q, "player_addpcar");
	return 1;
}
public: player_addpcar()
{
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT * FROM `OwnableCars` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadOwnableCar", "i", 0);
	return 1;
}
CMD:anim(playerid)
{
	if(GetPlayerState(playerid) != 1) return SCM(playerid,-825307393, "Анимации нельзя использовать в транспорте");
	SPD(playerid, 20354, DIALOG_STYLE_LIST, "{9966FF}Анимации", "\
		{33CC00}Информация\n\
		1. Приветствие/Прощание\n\
		2. Танцы\n\
		3. Положение\n\
		4. Передвижение\n\
		5. Стойки\n\
		6. Действие\n\
		7. Любовь 18+\n\
		8. Жесты\n\
		9. Питание\n\
		10. Эксклюзивные анимации", "Выбрать","Закрыть");
	return 1;
}
public: player_BuySimCard(playerid, number)
{
	if(!cache_num_rows())
	{
		PI[playerid][pPhone_Number] = number;
		UpdatePlayerDataInt(playerid, "Phone_Number", PI[playerid][pPhone_Number]);
		str_1[0] = EOS; f(str_1, sizeof(str_1),"{FFFFFF}Номер телефона изменен\n\
			Теперь с Вами  можно связаться по номеру {FFD83D}%i",
			PI[playerid][pPhone_Number]);
		
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "Игрок %s купил номер телефона %i", str_log, PI[playerid][pPhone_Number]);
		SendLog(0, str_log);

		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{66CC00}Номер изменен", str_1, "Закрыть", "");
	}
	else
	{
		SCM(playerid, 0xFF6600FF, "Введенный Вами номер уже занят");
		SPD
		(
			playerid, 20360, DIALOG_STYLE_INPUT,
			"{66CC00}Изменение номера",
			"{FFFFFF}Введите новый номер в поле ниже\n\n"\
			"{FF6633}Примечания:\n"\
			"{FFD83D}- Номер должен быть шестизначным,\n"\
			"например: 777777\n"\
			"- Номер не должен начинаться с 0\n\n"\
			"{FFFFFF}Вы также можете вернуть свой\n"\
			"стандартный номер. Для этого\n"\
			"введите в поле {3399FF}цифру 0",
			"Сменить", "Отмена"
		);
	}
	return 1;
}
CMD:take_number(playerid)
{
	foreach(new i: PlayerVehiclesStream[playerid])
	{
		new number = GetVehicleID(i);
		if(number == INVALID_VEHICLE_ID) continue;
		static Float:x, Float:y, Float:z;
		GetVehicleShiftPos(i, 1, x, y, z, 4.0);
		static Float:Rx, Float:Ry, Float:Rz;
		GetVehicleShiftPos(i, 0, Rx, Ry, Rz, 4.0);
		if(IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z) || IsPlayerInRangeOfPoint(playerid, 2.0, Rx, Ry, Rz))
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)) || GetString(CarData[number][cNumber_String], "-"))
			{
				SCM(playerid,-825307393, "* С этого транспорта нельзя снять номер");
			}
			else
			{
				player_Install_Number{playerid} = 4;
				ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0999999046326, 128, 0, 0, 0, 0, 1);
				SCM(playerid,1724645631, "Вы успешно сняли номер с транспорта");
				str_log[0] = EOS;
				f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
				strcat(str_log, "снял номер с машины");
				InvAdd(playerid, 99, 1, "", CarData[number][cNumber_Type], 0, CarData[number][cNumber_String], str_log);
				CarData[number][cNumber_Type] = -1;
				SetString(CarData[number][cNumber_String], "-");
				UpdateDataInt("OwnableCars", "Number_Type", CarData[number][cNumber_Type], CarData[number][cID]);
				UpdateDataStr("OwnableCars", "Number_String", CarData[number][cNumber_String], CarData[number][cID]);

				VehicleData[i][vNumber_Type] = -1;
				SetString(VehicleData[i][vNumber_String], "-");
				UpdateVehicleNumber(i);
			}
			return 1;
		}
	}
	SCM(playerid,-825307393, "* Вы не находитесь рядом с номером транспорта");
	return 1;
}
stock player_Promocode_Presents(playerid)
{
	str_1[0] = EOS;
	for(new i, count = 1; i < 10; i++)
	{
		if(!player_Promo_Data[playerid][1][i] && !player_Promo_Data[playerid][2][i]) continue;
		switch(player_Promo_Data[playerid][0][i])
		{
			case 1,2,3:
			{
				strcat(str_1, (str_f("%i. %s, количество %i\n", count, ItemsPromoData[player_Promo_Data[playerid][0][i]], player_Promo_Data[playerid][2][i])));
			}
			case 4:
			{
				strcat(str_1, (str_f("%i. %s, количество %i\n", count, ItemsData[player_Promo_Data[playerid][1][i]][ItemName], player_Promo_Data[playerid][2][i])));
			}
			default:
			{
				strcat(str_1, (str_f("%i. %s, индитификатор %i, количество %i\n", count, ItemsPromoData[player_Promo_Data[playerid][0][i]], player_Promo_Data[playerid][1][i], player_Promo_Data[playerid][2][i])));
			}
		}
		count++;
	}
}
CMD:exchange(playerid, get[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, 503.3533, 452.4387, 1000.6922)) return SCM(playerid,-111665921, "Ошибка:{FFFFFF} Вы должны находиться у нотариуса на месте для обмена");
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid,-5963521, "Уведомление:{FFFFFF} Вы уже обмениваетесь!");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /exchange [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SCM(playerid,-111665921, "Ошибка:{FFFFFF} Игрок слишком далеко от Вас");
	if(player_TradeID[to_player] != INVALID_PLAYER_ID) SCM(playerid,-5963521, "Уведомление:{FFFFFF} Игрок уже обменивается!");
	if(PI[playerid][pLevel] < 3 || PI[to_player][pLevel] < 3) return SCM(playerid,-5963521, "Уведомление:{FFFFFF} У игрока или у вас недостаточен уровень для проведения сделки. (Необходим 3 уровень)");
	SCM(playerid,-5963521, "Уведомление:{FFFFFF} Вы согласились на обмен. Ждём подтверждения второго игрока");
	player_TradeID[playerid] = to_player;
	player_TradeID[to_player] = playerid;
	player_Trade_Open(playerid);
	player_Trade_Open(to_player);
	return 1;
}
stock player_Trade_Open(playerid)
{
	player_Trade_Accept{playerid} = false;
	ExecutePacket(playerid, webOpen, "Trade", "{\"isNotary\":0, \"payText\":\"При совершении обмена взымается плата 12500000 руб с каждой из сторон<br>При передаче семьи снимается дополнительная плата 120 донат очков\"}");
}
stock player_Trade_UpdateAddComm(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	//SCM(playerid, -1, "player_Trade_UpdateAddComm");
	return 1;
}
stock player_Trade_Start(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	//SCM(playerid, -1, "player_Trade_Start");
	new to_player = player_TradeID[playerid];
	if(!player_Trade_Accept{playerid} || !player_Trade_Accept{to_player}) SCM(playerid,-111665921, "Ошибка:{FFFFFF} Одна из сторон не готова закончить сделку");
	else if(!player_Trade_Timer[playerid]) player_Trade_Finished(playerid);
	else
	{
		GameTextForPlayerEx(playerid, (str_f("~r~Ожидайте %i сек.", player_Trade_Timer[playerid])), 3000, 1);
		GameTextForPlayerEx(to_player, (str_f("~r~Ожидайте %i сек.", player_Trade_Timer[to_player])), 3000, 1);
	}
	return 1;
}
stock player_Trade_IsValid(playerid)
{
	new to_player = player_TradeID[playerid];
	if(to_player == playerid || !IsPlayerConnected(to_player) || !IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
	{
		player_Trade_Close(playerid, "Уведомление:{FFFFFF} Обмен был завершен, так как один из игроков отошел далеко.");
		return 0;
	}
	return 1;
}
stock player_Trade_SetObject(playerid, count)
{
	if(!player_Trade_IsValid(playerid) || count > 1000000000 || count < 1) return 0;
	if(CompareInt64(playerid, "<", 12500000+count)) return SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет столько денег");
	//if(GetStrMoney(playerid) < 12500000+count) return SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет столько денег");
	player_Trade_Timer[playerid] = 10;
	player_Trade_Timer[player_TradeID[playerid]] = 10;
	//SCMf(playerid, -1, "player_Trade_SetObject %i", type);
	player_Trade_AddPay[playerid] = count;
	player_Trade_Update(playerid);
	return 1;
}
stock player_Trade_SetAddComm(playerid, type)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	SCMf(playerid, -1, "player_Trade_SetAddComm %i", type);
	return 1;
}
stock player_Trade_SetExchangeObject(playerid, type)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	player_Trade_Timer[playerid] = 10;
	player_Trade_Timer[player_TradeID[playerid]] = 10;
	player_Trade_ItemType[playerid] = type-1;
	//SCMf(playerid, -1, "player_Trade_SetExchangeObject %i", player_Trade_ItemType[playerid]);
	switch(player_Trade_ItemType[playerid])
	{
		case 0: //гараж
		{
			if(!GetPlayerGarages(playerid)) SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет гаража");
			else cmd_garage(playerid, 20371);
		}
		case 1: //бизнес
		{
			if(!GetPlayerBusinesses(playerid)) SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет бизнеса");
			else cmd_business(playerid, 20371);
		}
		case 2: //машины
		{
			cmd_cars(playerid, 20371);
		}
		case 3:
		{
			if(!GetPlayerHouses(playerid)) SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет дома");
			else cmd_house(playerid, 20371);
		}
		case 4:
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У вас нет футбольного клуба");
		}
		case 5: //семья
		{

		}
		case 6: //simcard
		{
			if(!player_Trade_ChangeItem(playerid, 0)) player_Trade_ItemType[playerid] = -1;
		}
		case 7: //огород
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет огорода");
		}
		case 8:
		{
			if(!GetPlayerStalls(playerid)) SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет киоска");
			else cmd_stall(playerid, 20371);
		}
		case 9: //деньги
		{
			if(!player_Trade_ChangeItem(playerid, 0)) player_Trade_ItemType[playerid] = -1;
		}
	}
	return 1;
}
stock player_Trade_AcceptExchange(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	SCM(playerid,-5963521, "Уведомление:{FFFFFF} Ожидание подтверждения обмена");
	player_Trade_Accept{playerid} = true;
	player_Trade_Timer[playerid] = 10;
	player_Trade_Timer[player_TradeID[playerid]] = 10;
	player_Trade_Update(playerid);
	return 1;
}
stock player_Trade_CancelStatus(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	player_Trade_Accept{playerid} = false;
	player_Trade_Timer[playerid] = 10;
	player_Trade_Timer[player_TradeID[playerid]] = 10;
	player_Trade_Update(playerid);
	return 1;
}
stock player_Trade_Close(playerid, const text[] = "")
{
	//SCM(playerid, -1, "player_Trade_HidePlayerPanel");
	ExecutePacket(playerid, webClose, "Trade");
	new to_player = player_TradeID[playerid];
	if(IsPlayerConnected(to_player))
	{
		if(IsPlayerLogged(to_player))
		{
			if(strlen(text) > 1) SCM(to_player,-5963521, text);
			player_TradeID[to_player] = INVALID_PLAYER_ID;
			player_Trade_ItemType[to_player] = -1;
			player_Trade_ItemID[to_player] = -1;
			player_Trade_ItemUID[to_player] = -1;
			player_Trade_Accept{to_player} = false;
			player_Trade_AddPay[to_player] = 0;
			player_Trade_Timer[to_player] = 0;
			ExecutePacket(to_player, webClose, "Trade");
		}
	}
	if(strlen(text) > 1) SCM(playerid,-5963521, text);
	player_TradeID[playerid] = INVALID_PLAYER_ID;
	player_Trade_ItemType[playerid] = -1;
	player_Trade_ItemID[playerid] = -1;
	player_Trade_ItemUID[playerid] = -1;
	player_Trade_Accept{playerid} = false;
	player_Trade_AddPay[playerid] = 0;
	player_Trade_Timer[playerid] = 0;
	return 1;
}
stock player_Trade_ChangeItem(playerid, listitem)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	new id = player_ShowID[playerid][listitem];
	if(id == -1) return 0;
	player_Trade_ItemID[playerid] = id;
	new to_player = player_TradeID[playerid];
	player_Trade_Accept{playerid} = false;
	player_Trade_Accept{to_player} = false;
	switch(player_Trade_ItemType[playerid])
	{
		case 0: //гараж
		{
			if(!GetString(PN(playerid), GarageData[id][gOwner]))
			{
				SCM(playerid, COLOR_RED, !"Это не ваш гараж!");
				return 0;
			}
		}
		case 1: //бизнес
		{
			if(!GetString(PN(playerid), BizData[id][bOwner]))
			{
				SCM(playerid, COLOR_RED, !"Это не ваш бизнес!");
				return 0;
			}
		}
		case 2: //машины
		{
			//player_ShowUID[playerid][loaded]
			if(!IsAOwnableCar(player_ShowData[playerid][listitem]))
			{
				player_Trade_ItemID[playerid] = id;
				player_Trade_ItemUID[playerid] = player_ShowUID[playerid][listitem];
			}
			else SCM(playerid, COLOR_RED, !"Транспорт должен быть выгружен");
		}
		case 3: //дом
		{
			if(!GetString(PN(playerid), HouseData[id][hOwner]))
			{
				SCM(playerid, COLOR_RED, !"Это не ваш дом!");
				return 0;
			}
		}
		case 4:
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У вас нет футбольного клуба");
		}
		case 5: //семья
		{
			new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
			if(idEx >= 0)
			{
				if(!GetString(FamilyData[idEx][fOwner], PN(playerid)))
				{
					SCM(playerid,-111665921, "Ошибка:{FFFFFF} Вы должны быть владельцем семьи");
					return 0;
				}
			}
			else 
			{
				SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет семьи");
				return 0;
			}
		}
		case 6: //simcard
		{
			if(!PI[playerid][pPhone_Number]) 
			{
				SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет сим-карты");
				return 0;
			}
			player_Trade_ItemID[playerid] = PI[playerid][pPhone_Number];
		}
		case 7: //огород
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет огорода");
		}
		case 8:
		{
			if(!GetString(PN(playerid), StallData[id][sOwner]))
			{
				SCM(playerid, COLOR_RED, !"Это не ваш киоск!");
				return 0;
			}
			//SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет киоска");
		}
		case 9: //деньги
		{
			player_Trade_ItemID[playerid] = 0;
		}
	}
	player_Trade_Update(playerid);
	return 1;
}
stock player_Trade_Update(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	str_mes[0] = EOS;
	new sell_count = 500,
		id = player_Trade_ItemID[playerid];
	if(id == -1) return 0;
	switch(player_Trade_ItemType[playerid])
	{
		case 0: //гараж
		{
			f(str_mes, sizeof(str_mes), "Гараж №%i", id);
			sell_count = GarageStaticData[GarageData[id][gInterior]][gsCost];
		}
		case 1: //бизнес
		{
			f(str_mes, sizeof(str_mes), "Бизнес №%i", id);
			sell_count = BizData[id][bCost];
		}
		case 2: //машины
		{
			if(player_Trade_ItemUID[playerid] == -1)
			{
				SCM(playerid, -1, "Ошибка №13201032 trade");
				return 1;
			}
			f(str_mes, sizeof(str_mes), "Транспорт %s", VehicleStaticData[player_Trade_ItemUID[playerid]][vsName]);
			sell_count = 50000000;
		}
		case 3: //дом
		{
			f(str_mes, sizeof(str_mes), "%s №%i", (HouseData[id][hEntrance_ID] == -1 ? "Дом" : "Квартира"), id);
			sell_count = HouseData[id][hCost];
		}
		case 4:
		{
			//SCM(playerid,-111665921, "Ошибка:{FFFFFF} У вас нет футбольного клуба");
		}
		case 5: //семья
		{
			new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
			f(str_mes, sizeof(str_mes), "Семья %s(%i)", FamilyData[idEx][fName], FamilyData[idEx][fID]);
		}
		case 6: //simcard
		{
			f(str_mes, sizeof(str_mes), "Сим-карта %i", player_Trade_ItemID[playerid]);
			sell_count = 50000;
		}
		case 7: //огород
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет огорода");
		}
		case 8:
		{
			//SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет киоска");
			f(str_mes, sizeof(str_mes), "Киоск №%i", id);
			sell_count = StallData[id][sCost];
		}
		case 9: //деньги
		{
			f(str_mes, sizeof(str_mes), "Деньги %i", player_Trade_AddPay[playerid]);
			sell_count = 0;
		}
	}
	ExecutePacket(playerid, webUpdate, (str_f("\
		interface('Trade').updateData('\
			{\"player1\": \
			{\"item\": %i,\"itemName\": \"%s\",\
			\"itemPrice\": %i,\"itemSurcharge\": %i,\
			\"state\": %i,\"commission\": %i}}')", player_Trade_ItemType[playerid], str_mes, sell_count, player_Trade_AddPay[playerid], player_Trade_Accept{playerid}, 0)));
	
	new to_player = player_TradeID[playerid];
	ExecutePacket(to_player, webUpdate, (str_f("\
		interface('Trade').updateData('\
			{\"player2\": \
			{\"item\": %i,\"itemName\": \"%s\",\
			\"itemPrice\": %i,\"itemSurcharge\": %i,\
			\"state\": %i,\"commission\": %i}}')", player_Trade_ItemType[playerid], str_mes, sell_count, player_Trade_AddPay[playerid], player_Trade_Accept{playerid}, 0)));
	return 1;
}
stock player_Trade_Finished(playerid)
{
	if(!player_Trade_IsValid(playerid)) return 0;
	new to_player = player_TradeID[playerid];
	if(CompareInt64(playerid, "<", 12500000+player_Trade_AddPay[playerid]))
	//if(GetStrMoney(playerid) < 12500000+player_Trade_AddPay[playerid])
	{
		SCMf(playerid,-111665921, "Ошибка:{FFFFFF} Сделка не была совершена, так как у вас недостаточно средств. Необходимо %i руб", 12500000+player_Trade_AddPay[playerid]);
		SCM(to_player,-111665921, "Ошибка:{FFFFFF} У игрока недостаточно средств.");
		return 1;
	}
	if(CompareInt64(to_player, "<", 12500000+player_Trade_AddPay[to_player]))
	//if(GetStrMoney(to_player) < 12500000+player_Trade_AddPay[to_player])
	{
		SCMf(to_player,-111665921, "Ошибка:{FFFFFF} Сделка не была совершена, так как у вас недостаточно средств. Необходимо %i руб", 12500000+player_Trade_AddPay[to_player]);
		SCM(playerid,-111665921, "Ошибка:{FFFFFF} У игрока недостаточно средств.");
		return 1;
	}
	//if(CompareInt64(playerid, "<", 50000)) return SCM(playerid, 0xCECECEFF, !"Для того чтобы поставить метку дома, нужно иметь 50000 руб.");
	/*if(!IsIntEx(player_Cash[playerid], player_Trade_AddPay[to_player]+(-12500000-player_Trade_AddPay[playerid])))
	{
		SCM(to_player,-111665921, "Ошибка:{FFFFFF} Сделка не была совершена, так как у вас будет денег сверхлимита");
		SCM(playerid,-111665921, "Ошибка:{FFFFFF} Игрок не может принять деньги сверхлимита.");
		return 1;
	}
	if(!IsIntEx(player_Cash[to_player], player_Trade_AddPay[playerid]+(-12500000-player_Trade_AddPay[to_player])))
	{
		SCM(playerid,-111665921, "Ошибка:{FFFFFF} Сделка не была совершена, так как у вас будет денег сверхлимита");
		SCM(to_player,-111665921, "Ошибка:{FFFFFF} Игрок не может принять деньги сверхлимита.");
		return 1;
	}*/
	//проверка
	switch(player_Trade_ItemType[playerid])
	{
		case 0: //гараж
		{
			new count = player_GarageSlotsCount(to_player);
			if(count <= GetPlayerGarages(to_player))
			{
				SCMf(to_player, 0x3399FFFF, "Все слоты для гаража заняты. Всего у вас слотов для покупки гаражей: %i", count);
				SCM(playerid, 0x3399FFFF, "У вашего оппонента нет слотов для гаража.");
				return 1;
			}
		}
		case 1: //бизнес
		{
			new count = player_BusinessSlotsCount(to_player);
			if(count <= GetPlayerBusinesses(to_player))
			{
				SCMf(to_player, 0x3399FFFF, "Все слоты для бизнеса заняты. Всего у вас слотов для покупки бизнесов: %i", count);
				SCM(playerid, 0x3399FFFF, "У вашего оппонента нет слотов для бизнеса.");
				return 1;
			}
		}
		case 2: //машины
		{
			new count = player_CarSlotsCount(to_player);
			if(count <= GetPlayerCarsSQL(to_player))
			{
				SCMf(to_player, 0x3399FFFF, "Все слоты для машин заняты. Всего у вас слотов для покупки машин: %i", count);
				SCM(playerid, 0x3399FFFF, "У вашего оппонента нет слотов для дома.");
				return 1;
			}
		}
		case 3: //house
		{
			new count = player_HouseSlotsCount(to_player);
			if(count <= GetPlayerHouses(to_player))
			{
				SCMf(to_player, 0x3399FFFF, "Все слоты для дома заняты. Всего у вас слотов для покупки домов: %i", count);
				SCM(playerid, 0x3399FFFF, "У вашего оппонента нет слотов для дома.");
				return 1;
			}
		}
		case 8:
		{
			new count = player_StallSlotsCount(to_player);
			if(count <= GetPlayerStalls(to_player))
			{
				SCMf(to_player, 0x3399FFFF, "Все слоты для киоска заняты. Всего у вас слотов для покупки киосков: %i", count);
				SCM(playerid, 0x3399FFFF, "У вашего оппонента нет слотов для киоска.");
				return 1;
			}
		}
	}
	switch(player_Trade_ItemType[to_player])
	{
		case 0: //гараж
		{
			new count = player_GarageSlotsCount(playerid);
			if(count <= GetPlayerGarages(playerid))
			{
				SCMf(playerid, 0x3399FFFF, "Все слоты для гаража заняты. Всего у вас слотов для покупки гаражей: %i", count);
				SCM(to_player, 0x3399FFFF, "У вашего оппонента нет слотов для гаража.");
				return 1;
			}
		}
		case 1: //бизнес
		{
			new count = player_BusinessSlotsCount(playerid);
			if(count <= GetPlayerBusinesses(playerid))
			{
				SCMf(playerid, 0x3399FFFF, "Все слоты для бизнеса заняты. Всего у вас слотов для покупки бизнесов: %i", count);
				SCM(to_player, 0x3399FFFF, "У вашего оппонента нет слотов для бизнеса.");
				return 1;
			}
		}
		case 2: //машины
		{
			new count = player_CarSlotsCount(playerid);
			if(count <= GetPlayerCarsSQL(playerid))
			{
				SCMf(playerid, 0x3399FFFF, "Все слоты для машин заняты. Всего у вас слотов для покупки машин: %i", count);
				SCM(to_player, 0x3399FFFF, "У вашего оппонента нет слотов для дома.");
				return 1;
			}
		}
		case 3: //house
		{
			new count = player_HouseSlotsCount(playerid);
			if(count <= GetPlayerHouses(playerid))
			{
				SCMf(playerid, 0x3399FFFF, "Все слоты для дома заняты. Всего у вас слотов для покупки домов: %i", count);
				SCM(to_player, 0x3399FFFF, "У вашего оппонента нет слотов для дома.");
				return 1;
			}
		}
		case 8:
		{
			new count = player_StallSlotsCount(playerid);
			if(count <= GetPlayerStalls(playerid))
			{
				SCMf(playerid, 0x3399FFFF, "Все слоты для киоска заняты. Всего у вас слотов для покупки киосков: %i", count);
				SCM(to_player, 0x3399FFFF, "У вашего оппонента нет слотов для киоска.");
				return 1;
			}
		}
	}
	GivePlayerMoneyEx(playerid, (-12500000-player_Trade_AddPay[playerid])+player_Trade_AddPay[to_player], (str_f("Нотариус %s", PN(to_player))));
	GivePlayerMoneyEx(to_player, (-12500000-player_Trade_AddPay[to_player])+player_Trade_AddPay[playerid], (str_f("Нотариус %s", PN(playerid))));
	new family_toplayer = GetFamilyID(PI[to_player][pFamily_ID]);
	
	static const ItemsTypeObject[][] = {
		{"Гараж №"},
		{"Бизнес №"},
		{"Транспорт №"},
		{"Дом №"},
		{"Футбольного клуба №"},
		{"Семью №"},
		{"Сим-карту "},
		{"Огород №"},
		{"Киоск №"},
		{"Деньги "}
	};
	//передача от playerid
	new number_playerid = PI[playerid][pPhone_Number],
		number_toplayer = PI[to_player][pPhone_Number];
	switch(player_Trade_ItemType[playerid])
	{
		case 0: //гараж
		{
			ChangeGarageOwner(player_Trade_ItemID[playerid], PN(to_player));
		}
		case 1: //бизнес
		{
			ChangeBusinessOwner(player_Trade_ItemID[playerid], PN(to_player));
		}
		case 2: //машины
		{
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Owner` = '%s' WHERE ID = '%i' LIMIT 1;", PN(to_player), player_Trade_ItemID[playerid]);
			mysql_tquery(mysql, str_q);
		}
		case 3:
		{
			ChangeHouseOwner(player_Trade_ItemID[playerid], PN(to_player));
		}
		case 4:
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У вас нет футбольного клуба");
		}
		case 5: //семья
		{
			new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
			ChangeFamilyOwner(idEx, PN(to_player));
			family_InvitePlayer(playerid, to_player, "передача", 10);
			PI[playerid][pFamily_Rang] = 1;
			UpdateDataInt("players", "Family_Rang", PI[playerid][pFamily_Rang], PI[playerid][pID]);
		}
		case 6: //simcard
		{
			PI[to_player][pPhone_Number] = number_playerid;
			PI[playerid][pPhone_Number] = 0;
		}
		case 7: //огород
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет огорода");
		}
		case 8:
		{
			//SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет киоска");
			ChangeStallOwner(player_Trade_ItemID[playerid], PN(to_player));
		}
		case 9: //деньги
		{
			//GivePlayerMoneyEx(to_player, player_Trade_AddPay[playerid], "exchange", false, false);
			//GivePlayerMoneyEx(playerid, -player_Trade_AddPay[playerid], "exchange", false, false);
		}
	}

	//передача от to_player
	switch(player_Trade_ItemType[to_player])
	{
		case 0: //гараж
		{
			ChangeGarageOwner(player_Trade_ItemID[to_player], PN(playerid));
		}
		case 1: //бизнес
		{
			ChangeBusinessOwner(player_Trade_ItemID[to_player], PN(playerid));
		}
		case 2: //машины
		{
			//ChangeCarOwner(player_Trade_ItemUID[to_player], PN(playerid));
			
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Owner` = '%s' WHERE ID = '%i' LIMIT 1;", PN(playerid), player_Trade_ItemID[to_player]);
			mysql_tquery(mysql, str_q);
		}
		case 3:
		{
			ChangeHouseOwner(player_Trade_ItemID[to_player], PN(playerid));
		}
		case 4:
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У вас нет футбольного клуба");
		}
		case 5: //семья
		{
			family_InvitePlayer(to_player, playerid, "передача", 10);
			ChangeFamilyOwner(family_toplayer, PN(playerid));

			//	PI[to_player][pFamily_Rang] = 1;
			//	UpdateDataInt("players", "Family_Rang", PI[to_player][pFamily_Rang], PI[to_player][pID]);

			//PI[playerid][pFamily_Rang] = 10;
			//UpdateDataInt("players", "Family_Rang", PI[playerid][pFamily_Rang], PI[playerid][pID]);
		}
		case 6: //simcard
		{
			PI[playerid][pPhone_Number] = number_toplayer;
			PI[to_player][pPhone_Number] = 0;
		}
		case 7: //огород
		{
			SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет огорода");
		}
		case 8:
		{
			//SCM(playerid,-111665921, "Ошибка:{FFFFFF} У Вас нет киоска");
			ChangeStallOwner(player_Trade_ItemID[to_player], PN(playerid));
		}
		case 9: //деньги
		{
			//GivePlayerMoneyEx(playerid, player_Trade_AddPay[to_player], "exchange", true, false);
			//GivePlayerMoneyEx(to_player, -player_Trade_AddPay[to_player], "exchange", true, false);
		}
	}
	UpdatePlayerDataInt(playerid, "Phone_Number", PI[playerid][pPhone_Number]);
	UpdatePlayerDataInt(to_player, "Phone_Number", PI[to_player][pPhone_Number]);
	str_1 = "Деньги";
	str_2 = "Деньги";
	if(player_Trade_ItemType[playerid] != 9) 
	{
		f(str_1, sizeof(str_1), "%s%i", ItemsTypeObject[player_Trade_ItemType[playerid]], player_Trade_ItemID[playerid]);
	}
	if(player_Trade_ItemType[to_player] != 9) 
	{
		f(str_2, sizeof(str_2), "%s%i", ItemsTypeObject[player_Trade_ItemType[to_player]], player_Trade_ItemID[to_player]);
	}
	//log
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Игрок %s обменял \"%s\" + %i руб. на \"%s\" + %i руб. c игроком ", str_log, str_1, player_Trade_AddPay[playerid], str_2, player_Trade_AddPay[to_player]);
	static string[sizeof(action_log)+24+6];
	string[0] = EOS, f(string, sizeof(string), action_log, PI[to_player][pID], PN(to_player), PI[to_player][pID]);
	strcat(str_log, string);
	SendLog(9, str_log);

	SCMf(playerid, 0xFFCD00FF, "Успешно:{FFFFFF} Вы обменяли {FFCD00}\"%s\" {FFFFFF}на {FFCD00}\"%s\" {FFFFFF}с игроком {FFCD00}%s[%i]",\
								str_1, str_2, PN(to_player), to_player);
	SCMf(playerid, -1, "{FFFFFF}. С его доплатой {FFCD00}%i руб", player_Trade_AddPay[to_player]);
	//"Успешно:{FFFFFF} Вы обменяли {FFCD00}"Деньги" {FFFFFF}на {FFCD00}"Деньги" {FFFFFF}с игроком {FFCD00}Morik_Simanov[268]{FFFFFF}. С его доплатой {FFCD00}9999 руб
	SCMf(to_player, 0xFFCD00FF, "Успешно:{FFFFFF} Вы обменяли {FFCD00}\"%s\" {FFFFFF}на {FFCD00}\"%s\" {FFFFFF}с игроком {FFCD00}%s[%i]",\
								str_2, str_1, PN(playerid), playerid);
	SCMf(to_player, -1, "{FFFFFF}. С его доплатой {FFCD00}%i руб", player_Trade_AddPay[playerid]);
	player_Trade_Close(playerid);
	GiveBusinessMoney(playerid, player_BizEntered[playerid], 5500000, 0);
	return 1;
}
//15074
CMD:skin(playerid, params[]){
	extract params -> new skin_id; else return SCM(playerid, COLOR_GREY, "Используйте: /skin [ID скина]");
	SetPlayerSkin(playerid, skin_id);
	return 1;
}
