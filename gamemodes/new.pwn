stock pubSpawn_Start(city)
{
	//msg
	static const cityNames[][] = {
		"Арзамасе", "Южном", "Районе Эдово"
	};
	SCMAllf(0x6495EDFF, "[Информация] В {FFFFFF}%s {6495ED}были размещены сундуки, в которых игроки могут найти кейсы и ключи.", cityNames[city]);
	
	//clear old data
	switch(city)
	{
		case 0:
		{
			for(new i; i < sizeof(pubSpawn_IsSpawned_Arzamas); i++)
			{
				pubSpawn_IsSpawned_Arzamas[i] = false;
			}
		}
		case 1:
		{
			for(new i; i < sizeof(pubSpawn_IsSpawned_South); i++)
			{
				pubSpawn_IsSpawned_South[i] = false;
			}
		}
		case 2:
		{
			for(new i; i < sizeof(pubSpawn_IsSpawned_Edovo); i++)
			{
				pubSpawn_IsSpawned_Edovo[i] = false;
			}
		}
	}

	//init new data
	new limit = 30;
	if(Iter_Count(Player) > 70) limit = LIMIT_PUBSPAWN_POSITION;
	for(new i; i < LIMIT_PUBSPAWN_POSITION; i++)
	{
		pubSpawn_Clear(i);
		if(i < limit)
		{
			pubSpawn_CaseID[i] = random(sizeof(CaseStaticData));
			switch(city)
			{
				case 0:
				{
					new rand = random(sizeof(pubSpawn_Position_Arzamas));
					if(!pubSpawn_IsSpawned_Arzamas[rand])
					{
						pubSpawn_IsSpawned_Arzamas[rand] = true;
						pubSpawn_Create(i, pubSpawn_Position_Arzamas[rand]);
					}
				}
				case 1:
				{
					new rand = random(sizeof(pubSpawn_Position_South));
					if(!pubSpawn_IsSpawned_South[rand])
					{
						pubSpawn_IsSpawned_South[rand] = true;
						pubSpawn_Create(i, pubSpawn_Position_South[rand]);
					}
				}
				case 2:
				{
	//				pubSpawn_Position_Edovo
					new rand = random(sizeof(pubSpawn_Position_Edovo));
					if(!pubSpawn_IsSpawned_Edovo[rand])
					{
						pubSpawn_IsSpawned_Edovo[rand] = true;
						pubSpawn_Create(i, pubSpawn_Position_Edovo[rand]);
					}
				}
			}
		}
	}
}
stock pubSpawn_Create(i, Float:pos[4])
{
	new rand_case = pubSpawn_CaseID[i];
	pubSpawn_ObjectCase[i] = CreateDynamicObject(CaseStaticData[rand_case][csCaseID], pos[0], pos[1], pos[2]-0.8, 0.0, 0.0, pos[3], 0, 0, -1, 60.0);
	pubSpawn_ObjectBonnet[i] = CreateDynamicObject(CaseStaticData[rand_case][csBonnetID], pos[0], pos[1], (pos[2] - 0.8 + (!CaseStaticData[rand_case][csSetForBonnet] ? 0.0 : 0.2)), 0.0, 0.0, pos[3], 0, 0, -1, 60.0);
	pubSpawn_Label[i] = CreateDynamic3DTextLabel("Секретный сундук\n{FFFFFF}Нажмите L.ALT, чтобы забрать его", 0x42AAFFFF, pos[0], pos[1], pos[2], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	pubSpawn_MapIcon[i] = CreateDynamicMapIcon(pos[0], pos[1], pos[2], 41, 0, 0, 0, -1, 60.0);
	pubSpawn_InterMenu[i] = CreateInteractionMenu("[[7,\"Взаимодействовать\"]]", pos[0], pos[1], pos[2], 2.0, interMenu_CaseRandom, i, 0, 0);
	return 1;
}
stock pubSpawn_Clear(i)
{
	if(IsValidDynamicObject(pubSpawn_ObjectBonnet[i]) || pubSpawn_ObjectBonnet[i] != -1)
	{
		DestroyDynamicObject(pubSpawn_ObjectBonnet[i]);
		pubSpawn_ObjectBonnet[i] = -1;
	}
	if(IsValidDynamicObject(pubSpawn_ObjectCase[i]) || pubSpawn_ObjectCase[i] != -1)
	{
		DestroyDynamicObject(pubSpawn_ObjectCase[i]);
		pubSpawn_ObjectCase[i] = -1;
	}
	if(IsValidDynamic3DTextLabel(pubSpawn_Label[i]) || pubSpawn_Label[i] != Text3D:-1)
	{
		DestroyDynamic3DTextLabel(pubSpawn_Label[i]);
		pubSpawn_Label[i] = Text3D:-1;
	}
	if(IsValidDynamicMapIcon(pubSpawn_MapIcon[i]) || pubSpawn_Label[i] != Text3D:-1)
	{
		DestroyDynamicMapIcon(pubSpawn_MapIcon[i]);
		pubSpawn_MapIcon[i] = -1;
	}
	if(pubSpawn_InterMenu[i] != -1)
	{
		DestroyInteractionMenu(pubSpawn_InterMenu[i]);
	}
}
CMD:pubspawn_case(playerid)
{
	pubSpawn_Start(random(3));
	return 1;
}
stock ShowGarageLevelUP(playerid, id)
{
	if(id != player_GarageEntered[playerid]) return SCM(playerid, COLOR_RED, "Вы должны находиться в бизнесе!");
	str_1[0] = EOS;
	new bool:next;
	for(new i; i < sizeof(Garage_improvements); i++)
	{
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{CC3344}%i уровень:\t{FFFFFF}%s\t\t", i, Garage_improvements[i][I_NAME]);
		switch(i)
		{
			case 1,4,5: strcat(str_2, "\t");
			default: strcat(str_2, "\t\t");
		}
		if(GarageData[id][gLevel] < i) 
		{
			if(!next)
			{
				player_ShowID[playerid][i] = 1;
				next = true;
			}
			else player_ShowID[playerid][i] = 2;
			f(str_2, sizeof(str_2), "%s%i руб\n", str_2, Garage_improvements[i][I_PRICE]);
		}
		else player_ShowID[playerid][i] = 0, f(str_2, sizeof(str_2), "%s{2277AA}Куплено\n", str_2, Garage_improvements[i][I_PRICE]);
		strcat(str_1, str_2);
	}
	SPD(playerid, 20461, DIALOG_STYLE_LIST, "Улучшение для гаража", str_1, "Выбрать", "Назад");
	return 1;
}
CMD:plist(playerid)
{
	str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `ID`, `Name`, `timeOut` FROM `Promocodes_Used` WHERE `pID` = '%i' AND `timeOut` != -1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q, "player_plist", "i", playerid);
	return 1;
}
public: player_plist(playerid)
{
	str_1[0] = EOS;
	if(!cache_num_rows()) return SCM(playerid, -1, "Список пуст");
	for(new i, rows = cache_num_rows(); i < rows; i++)
	{
		cache_get_int(i, "ID", player_ShowUID[playerid][i]);
		static name[32];
		cache_get_string(i, "Name", name);
		static timeout;
		cache_get_int(i, "timeOut", timeout);
		if(timeout-PI[playerid][pGameTime_forAll] > 0) player_ShowData[playerid][i] = 0;
		else player_ShowData[playerid][i] = 1;

		f(str_1, sizeof(str_1), "%s%s %s\n", str_1, name, (timeout-PI[playerid][pGameTime_forAll] > 0 ? (str_f("Необходимо отыграть %i минут", (timeout-PI[playerid][pGameTime_forAll])/60)) : "Можно забрать"));
	}
	SPD(playerid, 20462, DIALOG_STYLE_LIST, "/plist", str_1, "Далее", "Закрыть");
	return 1;
}
public: player_plist_take(playerid)
{
	new rows;
	cache_get_row_count(rows);
	if(rows)
	{
		static id;
		cache_get_int(0, "ID", id);
		static name[32];
		cache_get_string(0, "Name", name);
		cache_get_string(0, "Data_0", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][0]);
		cache_get_string(0, "Data_1", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][1]);
		cache_get_string(0, "Data_2", str_1), sscanf(str_1, "p<,>a<i>[10]", player_Promo_Data[playerid][2]);
		player_Promocode_Take(playerid);
		mysql_tquery(mysql, (str_f("DELETE FROM `Promocodes_Used` WHERE `ID` = '%i' LIMIT 1;", id)));
		SCMf(playerid, -1, "Вы забрали все призы с промокода %s", name);
	}
	return 1;
}
stock player_Promocode_Take(playerid)
{
	for(new i; i < 10; i++)
	{
		if(!player_Promo_Data[playerid][1][i] && !player_Promo_Data[playerid][2][i]) continue;
		switch(player_Promo_Data[playerid][0][i])
		{
			case 1:
			{
				GivePlayerMoneyEx(playerid, player_Promo_Data[playerid][2][i], "/pcode");
			}
			case 2:
			{
				GivePlayerDonate(playerid, player_Promo_Data[playerid][2][i], "/pcode");
			}
			case 3:
			{
				PI[playerid][pExp] += player_Promo_Data[playerid][2][i];
				CheckNextLevel(playerid);
			}
			case 4:
			{
				InvAdd(playerid, player_Promo_Data[playerid][1][i], player_Promo_Data[playerid][2][i], "", 0, 0, "", "/pcode");
			}
			case 5:
			{
				PI[playerid][pPropertySlots][player_Promo_Data[playerid][1][i]]++;
				SaveSlotsProperty(playerid);
			}
		}
		player_Promo_Data[playerid][0][i] = 0;
		player_Promo_Data[playerid][1][i] = 0;
		player_Promo_Data[playerid][2][i] = 0;
	}
}
/*
	/sc — статистика по проделанной работе
	? /tbank — казна фракции (для использования необходимо отыграть РП)
	Примечание: снятие наличных доступно только лидеру.
	/team_history — фракционная история (принятие, увольнение, повышение)
	+ /leave — покинуть фракцию по собственному желанию
	+ Примечание: требуется прокаченное улучшение «Решительность»
	/lock 5 — открыть\закрыть фракционный транспорт
	/police_tablet — полицейский планшет со всей информацией о гражданах
	/wanted — список подозреваемых преступников
	/setmark [id] — отметить подозреваемого преступника на карте
	/m [текст] — сказать в автомобильный мегафон
	Примечание: вы должны находиться в служебном транспорте.
	/pg [id] — начать погоню за преступником (Закончить погоню за преступником)
	команды, для использования которых необходимо отыграть РП:
	/ticket [id] [сумма] [причина] — выписать штраф
	Примечание: доступно от 2 ранга.
	/takelic [id] [Причина] — забрать лицензию на вождение
	Примечание: доступно от 6 ранга.
	/cuff [id] — надеть наручники на игрока
	Примечание: игрок должен быть оглушен дубинкой или находиться в патрульной машине.
	/uncuff [id] — снять наручники
	/escort [id] — вести преступника за собой
	Примечание: игрок должен быть в наручниках.
	/su [id] — объявить преступника в розыск
	Примечание: в открывшемся окне выберите причину розыска.
	/clear [id] — снять розыск
	/ejectout [id] — выкинуть нарушителя из закрытого автомобиля
	/putpl [id] — посадить подозреваемого в патрульную машину
	/arrest [id] — посадить преступника в КПЗ
	Примечание: работает у здания МВД.
	/search [id] — обыскать игрока на наличие патронов или наркотиков
	/remove [id] [(наркотики) или (патроны)] — изъять у игрока что-то из этого
	Примечание: Изымать вещи можно только у арестованных или людей в наручниках.
	/break [id ограждения 1-7] — поставить ограждение
	/dbreak [номер над ограждением] — убрать ограждение
	/break_door — выбивание закрытых дверей
	Примечание: доступно ОМОН.
	/su_reasons — настройка причин выдачи розыска
*/
public: player_PoliceTablet_Query(playerid, event_type, event_id)
{
	if(!cache_num_rows()) return 0;
	switch(event_type)
	{
		case 3,5:
		{
			if(event_id == 0)
			{
				str_2[0] = EOS;
				cache_get_int(0, "ID", PI[MAX_PLAYERS][pID]); 
				cache_get_string(0, "NickName", PI[MAX_PLAYERS][pNickName]); 
				cache_get_int(0, "Level", PI[MAX_PLAYERS][pLevel]);
				cache_get_int(0, "Sex", PI[MAX_PLAYERS][pSex]);
				cache_get_int(0, "Skin", PI[MAX_PLAYERS][pSkin]); 
				cache_get_int(0, "Level_Suspect", PI[MAX_PLAYERS][pLevel_Suspect]);
				new total = player_Fines_Counts(PI[MAX_PLAYERS][pNickName]);
				ExecutePacket(playerid, webUpdate, (str_f("interface('Police').%s('[1,\"%s\",\"\",%i,0,%i,0,%i,%i,%i]')", (event_type == 3 ? "setDatabase" : "setModalPlayerData"), PI[MAX_PLAYERS][pNickName], PI[MAX_PLAYERS][pLevel_Suspect], total, 18+PI[MAX_PLAYERS][pLevel], PI[MAX_PLAYERS][pSkin], PI[MAX_PLAYERS][pID])));
			}
			else if(event_id == 1)
			{
				str_1[0] = EOS;
				for(new i; i < TOTAL_HOUSES; i++)
				{
					if(!GetString(HouseData[i][hOwner], PI[MAX_PLAYERS][pNickName])) continue;
					if(HouseData[i][hEntrance_ID] == -1)
					{
						//- Дом %i
						f(str_1, sizeof(str_1), "%s[1,\"- Дом №%i\",725],", str_1, i);
					}
					else
					{
						//- Подъезд: %i | Квартира: %i
						f(str_1, sizeof(str_1), "%s[1,\"- Подъезд: %i| Квартира: %i\",725],", str_1, HouseData[i][hEntrance_ID], i);
					}
				}
				for(new i, rows = cache_num_rows(); i < rows; i++)
				{
					new model;
					cache_get_int(i, "Model", model);
					new uid = IsValidCarModel(model);
					if(uid != -1)
					{
						static type, string[36];
						cache_get_int(i, "Number_Type", type);
						cache_get_string(i, "Number_String", string);
						f(str_1, sizeof(str_1), "%s[0,\"%s\",\"%i %s\"],", str_1, VehicleStaticData[uid][vsName], type, string);
					}
				}
				strdel(str_1, strlen(str_1)-1, strlen(str_1));
				ExecutePacket(playerid, webUpdate, (str_f("interface('Police').%s('[%s]')", (event_type == 3 ? "setDatabaseProperties" : "setModalProperties"), str_1)));
			}
		}
		case 11:
		{
			for(new i, rows = cache_num_rows(); i < rows; i++)
			{
				static name[24], name_police[24], reason[36], cash, time;
				cache_get_string(i, "NickName", name);
				cache_get_string(i, "NickName_Police", name_police);
				cache_get_string(i, "Reason", reason);
				cache_get_int(i, "cash", cash);
				cache_get_int(i, "time", time);
				f(str_1, sizeof(str_1), "%s[-7,\"%s\",\"%s\",0,%i,%i,\"%s\"],", str_1, name, reason, cash, time, name_police);
			}
			strdel(str_1, strlen(str_1)-1, strlen(str_1));
			ExecutePacket(playerid, webUpdate, (str_f("interface('Police').updateFinesList('[%s]')", str_1)));
		}
	}
	return 1;
}
stock player_PoliceTablet_Request(playerid, event_type, event_id, string[])
{
	#pragma unused event_id
	if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_ID] != 8) return SCM(playerid, 0x999999FF, "Вы не работник правоохранительных органов");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(player_AntiFlood[playerid][23]-global_time > 0)
	{
		SCMf(playerid,-1145324613, "* Вы уже недавно отправляли запрос, подождите %i сек", player_AntiFlood[playerid][23]-global_time);
		return 1;
	}
	player_AntiFlood[playerid][23] = global_time+2;
	//static cache_name[24];
	//SetString(cache_name, player_Cache_NickName[playerid]);
	//if(!GetString(cache_name, player_Cache_NickName[playerid]) || event_type == 5)
	{
		mysql_escape_string(string, player_Cache_NickName[playerid], 24);
		//SCMf(playerid, -1, "request -> %i, %i, %s", event_type, event_id, string);
		switch(event_type)
		{
			case 3:
			{
				if(player_Cache_Page[playerid] != 0) return SCM(playerid,-1145324613, "* Действие невозможно, перезагрузите планшет.");
				ExecutePacket(playerid, webUpdate, "interface('Police').setDatabase('[]')");
				ExecutePacket(playerid, webUpdate, "interface('Police').setDatabaseProperties('[]')");

				if(IsValidNickName(player_Cache_NickName[playerid]))
				{
					str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT `ID`, `NickName`, `Level`, `Sex`, `Skin`, `Level_Suspect` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", player_Cache_NickName[playerid]);
					mysql_tquery(mysql, str_q, "player_PoliceTablet_Query", "iii", playerid, 3, 0);

					str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT `Model`, `Number_Type`, `Number_String` FROM `OwnableCars` WHERE `Owner` = '%s';", player_Cache_NickName[playerid]);
					mysql_tquery(mysql, str_q, "player_PoliceTablet_Query", "iii", playerid, 3, 1);
				}
			}
			case 5: //просмотр игрока из розыска
			{
				if(player_Cache_Page[playerid] != 5) return SCM(playerid,-1145324613, "* Действие невозможно, перезагрузите планшет.");
				ExecutePacket(playerid, webUpdate, "interface('Police').setModalPlayerData('[]')");
				ExecutePacket(playerid, webUpdate, "interface('Police').setModalProperties('[]')");

				if(IsValidNickName(player_Cache_NickName[playerid]))
				{
					str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT `ID`, `NickName`, `Level`, `Sex`, `Skin`, `Level_Suspect` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", player_Cache_NickName[playerid]);
					mysql_tquery(mysql, str_q, "player_PoliceTablet_Query", "iii", playerid, 5, 0);

					str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT `Model`, `Number_Type`, `Number_String` FROM `OwnableCars` WHERE `Owner` = '%s';", player_Cache_NickName[playerid]);
					mysql_tquery(mysql, str_q, "player_PoliceTablet_Query", "iii", playerid, 5, 1);
				}
			}
			case 7: //объявить в розыск
			{
				player_Cache_Level[playerid] = 2;
				player_Suspect_List(playerid);
			}
			case 11: //просмотр штрафов
			{
				if(player_Cache_Page[playerid] != 3) return SCM(playerid,-1145324613, "* Действие невозможно, перезагрузите планшет.");
				ExecutePacket(playerid, webUpdate, "interface('Police').updateFinesList('[]')");
				if(IsValidNickName(player_Cache_NickName[playerid]))
				{
					str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT * FROM `player_Fines` WHERE `NickName` = '%s' ORDER BY `time` DESC", player_Cache_NickName[playerid]);
					mysql_tquery(mysql, str_q, "player_PoliceTablet_Query", "iii", playerid, 11, 0);
				}
			}
		}
	}
	return 1;
}
stock player_PoliceTablet_GiveFine(playerid, cash, name[], reason[])
{
	if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_ID] != 8) return SCM(playerid, 0x999999FF, "Вы не работник правоохранительных органов");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	mysql_escape_string(name, player_Cache_NickName[playerid], 24);
	new to_player = GetPlayerID(player_Cache_NickName[playerid]);
	if(!IsPlayerLogged(to_player)) return SCM(playerid,-825307393, "* Игрок не найден");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SCM(playerid,-825307393, "Игрок находится слишком далеко");
	if(cash > 10000000 || cash < 10) return 0;
	mysql_escape_string(reason, player_Cache_Reason[playerid], 36);
	player_Cache_Int[playerid] = cash;
	player_Fine_Accept(playerid);
	return 1;
}
CMD:ticket(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_ID] != 8) return SCM(playerid, 0x999999FF, "Вы не работник правоохранительных органов");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	extract get -> new to_player, cash, string:reason[36]; else return SCM(playerid,-825307393, "Используйте: /ticket [id игрока] [сумма] [причина]");
	if(!IsPlayerLogged(to_player)) return SCM(playerid,-825307393, "* Игрок не найден");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SCM(playerid,-825307393, "Игрок находится слишком далеко");
	if(cash > 10000000 || cash < 10) return 0;
	mysql_escape_string(PN(to_player), player_Cache_NickName[playerid], 24);
	mysql_escape_string(reason, player_Cache_Reason[playerid], 36);
	player_Cache_Int[playerid] = cash;
	player_Fine_Accept(playerid);
	return 1;
}
stock player_Fine_Accept(playerid)
{
	SPD(playerid, 20465, 0, "{FFCD00}Выдача штрафа", (str_f("\
		{FFFFFF}Имя нарушителя:\t%s\n\
		Сумма штрафа:\t%i\n\
		Причина:\t\t%s\n\n\
		Вы действительно хотите выписать штраф?", \
			player_Cache_NickName[playerid], \
			player_Cache_Int[playerid],\
			player_Cache_Reason[playerid])), "Выписать","Отмена");
}
stock player_Fine_Insert(const name[], const name_police[], const reason[], cash)
{
	mysql_tquery(mysql, (str_f("\
		INSERT INTO `player_Fines` (`NickName`, `NickName_Police`, `Reason`, `cash`, `time`) VALUES \
		('%s', '%s', '%s', '%i', UNIX_TIMESTAMP(NOW()))", name, name_police, reason, cash)));
	new playerid = GetPlayerID(name);
	if(playerid != INVALID_PLAYER_ID)
	{
		if(GetString(name_police, "автоматически"))
		{
			GameTextForPlayerEx(playerid, "~r~Штраф", 3000, 1);
			ExecutePacket(playerid, webUpdate, "window.playSound('sounds/fine/notification_roadfine.mp3', 0, 0, 0.00)");
			SCMf(playerid,865730559, "Полиция выписала Вам штраф на сумму %i руб. Причина: %s", cash, reason);
			SCM(playerid,-1, "Оплатить штраф можно в любом банке и банкомате. Для просмотра Ваших неоплаченных штрафов используйте: /mytickets");
			SCM(playerid,-65281, "Обратите внимание: У Вас есть 3 дня чтобы оплатить штраф, иначе Ваше вод. удостоверение будет аннулировано");
		}
		else
		{
			SCM(playerid, -1, "Оплатить штраф можно в любом банке и банкомате. Для просмотра Ваших неоплаченных штрафов используйте: {CCCC00}/mytickets");
			SCM(playerid, 0xffff00FF, "Обратите внимание: У Вас есть 3 дня чтобы оплатить штраф, иначе Ваше вод. удостоверение будет аннулировано");
		}
	}
	return 1;
}
CMD:mytickets(playerid)
{
	//SCM(playerid,-1, "* У вас нет штрафов");
	str_q[0] = EOS, f(str_q, sizeof(str_q),"SELECT `ID`, `Reason`, `cash`, FROM_UNIXTIME(time, '%%Y-%%m-%%d, %%H:%%m') AS `time_string` FROM `player_Fines` WHERE `NickName` = '%s';", PN(playerid));
	mysql_tquery(mysql, str_q, "player_Fines_List", "ii", playerid, 20466);
}
public: player_Fines_List(playerid, dialogid)
{
	new rows = cache_num_rows();
	if(!rows) SCM(playerid,-1, "* У вас нет штрафов");
	else
	{
		str_1 = "{999999}Номер штрафа\t{999999}Время выдачи\t{999999}Сумма\t{999999}Причина\n";
		for(new i; i < rows; i++)
		{
			cache_get_int(i, "ID", player_ShowUID[playerid][i]);
			static time_string[36], cash, reason[36];
			cache_get_string(i, "Reason", reason);
			cache_get_int(i, "cash", cash);
			cache_get_string(i, "time_string", time_string);
			f(str_1, sizeof(str_1), "%s№%i\t%s\t%i руб\t%s\n", str_1, player_ShowUID[playerid][i], time_string, cash, reason);
		}
		SPD(playerid, dialogid, 5, "{FFCD00}Список штрафов", str_1, "Выбрать","Назад");
	}
	return 1;
}
public: player_Fines_Click(playerid, dialogid)
{
	new rows = cache_num_rows();
	if(!rows)
	{
		if(dialogid == 0) SCM(playerid,-1, "* У вас нет штрафов");
		else SCM(playerid,-10092289, "Штраф с таким номером не найден либо он уже оплачен");
	}
	else
	{
		cache_get_int(0, "ID", player_ShowUID[playerid][0]);
		static time_string[36], reason[36], police[24];
		cache_get_string(0, "NickName_Police", police);
		cache_get_string(0, "Reason", reason);
		cache_get_int(0, "cash", player_ShowUID[playerid][1]);
		cache_get_string(0, "time_string", time_string);
		SPD(playerid, dialogid, 0, "{FFCD00}Информация о штрафе", (str_f("\
			{FFFFFF}Номер штрафа:\t%i\n\
			Размер штрафа:\t%i руб\n\
			Кем выписан:\t\t%s\n\
			Когда выписан:\t%s\n\n\
			Причина штрафа:\t%s", player_ShowUID[playerid][0], player_ShowUID[playerid][1], police, time_string, reason)), (dialogid == 0 ? "Закрыть" : "Оплатить"), (dialogid == 0 ? "" : "Закрыть"));

	}
	return 1;
}
public: player_Fines_ClickAll(playerid)
{
	new rows = cache_num_rows();
	if(!rows) SCM(playerid,-2127958, "В данный момент у вас нет штрафов.");
	else
	{
		cache_get_int(0, "sum", player_ShowUID[playerid][1]);
		cache_get_int(0, "count", player_ShowUID[playerid][0]);
		if(!player_ShowUID[playerid][0]) SCM(playerid,-2127958, "В данный момент у вас нет штрафов.");
		else SPD(playerid, 20470, 0, "{FFCD00}Оплата всех штрафов", (str_f("{FFFFFF}На ваше имя выписано {FFCD00}%i {FFFFFF}штрафов на сумму {FFCD00}%iруб.", player_ShowUID[playerid][0], player_ShowUID[playerid][1])), "Оплатить","Назад");
	}
	return 1;
}
stock player_Fines_Counts(const name[])
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) as total FROM `player_Fines` WHERE `NickName` = '%s' LIMIT 1;", name);
	new Cache:result = mysql_query(mysql, str_q);
	new count;
	cache_get_int(0, "total", count);
	cache_delete(result);
	return count;
}
stock player_PoliceTablet_ChangePage(playerid, page)
{
	player_Cache_Page[playerid] = page;
	switch(page)
	{
		case 5: //федеральный розыск
		{
			str_1[0] = EOS;
			foreach(new i: Player)
			{
				if(!IsPlayerLogged(i) || !PI[i][pLevel_Suspect]) continue;
				if(!IsValidNickName(PN(i))) continue;
				f(str_1, sizeof(str_1), "%s[\"%s\",%i,%i,%i],", str_1, PN(i), i, PI[i][pID], PI[i][pLevel_Suspect]);
			}
			strdel(str_1, strlen(str_1)-1, strlen(str_1));
			ExecutePacket(playerid, webUpdate, (str_f("interface('Police').updateWantedList('[%s]')", str_1)));
		}
		case 6: //региональный розыск
		{

		}
		case 7: //архив
		{

		}
		case 8: //карта преступников
		{

		}
		case 9: //подмога
		{

		}
	}
	return 1;
}
//259200
CMD:su(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 2) return SCM(playerid,-825307393, "Доступно с 2 ранга");
	extract get -> new to_player, level = -1;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid,-2127958, "Используйте: /su [id игрока] [уровень розыска (в случае ручного ввода причины)]");
	SetString(player_Cache_NickName[playerid], PN(to_player));
	player_Cache_Level[playerid] = 2;
	if(level > 0 && level < 7)
	{
		player_Cache_Level[playerid] = level;
		SPD(playerid, 20472, 2, "{FFCD00}Причина выдачи розыска", "\
			{FFFFFF}1. Выбрать причину из списка\n\
			{FFFFFF}2. Ввести причину в ручную", "Далее","Закрыть");
	}
	else player_Suspect_List(playerid);
	return 1;
}
stock player_Suspect_List(playerid)
{
	str_1[0] = EOS;
	for(new i; i < sizeof(Reason_Suspect); i++)
	{
		f(str_1, sizeof(str_1), "%s{FFFFFF}%i. %s\n", str_1, i+1, Reason_Suspect[i]);
	}
	SPD(playerid, 20464, 2, "{FFCD00}Причина выдачи розыска", str_1, "Готово","Назад");
}
stock player_Suspect_Give(playerid, const reason[])
{
	new id = GetPlayerID(player_Cache_NickName[playerid]);
	if(!IsPlayerLogged(id)) return SCM(playerid,-825307393, "Выдавать оффлайн розыск нельзя");
	if(player_Cache_Level[playerid] <= 0) player_Cache_Level[playerid] = 2;
	SetPlayerSuspectLevel(id, player_Cache_Level[playerid]);
	Action(playerid, "объявил(а) в федеральный розыск", 25.0, true, -577699841);
	SCMf(playerid,-6750038, "Вы объявили %s в розыск. Текущий уровень розыска %i", player_Cache_NickName[playerid], PI[id][pLevel_Suspect]);
	SCMf(playerid,-6750038, "Причина объявления в розыск: %s", reason);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s[%i] объявил %s[%i] в розыск [%i/6], причина: %s", FractionRName[PI[playerid][pMember_ID]][PI[playerid][pMember_Rang]], PN(playerid), playerid, PN(id), id, PI[id][pLevel_Suspect], reason);
	SendTeamMessage(PI[playerid][pMember_ID], 13434879, str_mes);

	SCMf(id,-6750038, "%s %s объявил Вас в розыск. Текущий уровень розыска %i", FractionRName[PI[playerid][pMember_ID]][PI[playerid][pMember_Rang]], PN(playerid), PI[id][pLevel_Suspect]);
	SCMf(id,-6750038, "Причина объявления в розыск: %s", reason);
	return 1;
}
CMD:pg(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 2) return SCM(playerid,-825307393, "Доступно с 2 ранга");
	extract get -> new to_player; else return cmd_pg(playerid);
	player_Pursuit_Start(playerid, to_player);
	return 1;
}
stock player_Pursuit_Start(playerid, to_player)
{
	if(!IsPlayerPursuit(playerid, to_player)) return 1;
	player_Pursuit_Init(playerid, to_player, false);
	player_Pursuit_Init(to_player, playerid, true);

	Action(playerid, "отслеживание местоположение человека по GPS-трекеру", 25.0, true, -577699841);
	SCMf(playerid,-10016257, "[Полицейская погоня]{FCFCFC} Вы начали погоню за игроком %s", PN(to_player));

	SCMf(to_player,-10016257, "[Полицейская погоня]{FCFCFC} Внимание! Полицейскии %s [%i] начал погоню за вами!", PN(playerid), playerid);
	return 1;
}
stock player_Pursuit_Init(playerid, to_player, bool:type)
{
	if(playerid == -1) return 0;
	player_Pursuit_ID[playerid] = to_player;
	player_Pursuit_Type{playerid} = type;
	player_Pursuit_Timer[playerid] = 0;
	return 1;
}
stock player_Pursuit_Update(playerid)
{
	new to_player = player_Pursuit_ID[playerid];
	if(to_player != -1)
	{
		if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return player_Pursuit_Stop(playerid, 132);
		if(!player_Pursuit_Type{playerid})
		{
			if(!IsPlayerInRangeOfPlayer(playerid, to_player, 300.0)) player_Pursuit_Timer[playerid]++;
			else if(player_Pursuit_Timer[playerid] > 0) player_Pursuit_Timer[playerid]--;
			if(player_Pursuit_Timer[playerid] > 10) return player_Pursuit_Stop(playerid, 1);
		}
	}
	return 1;
}
stock player_Pursuit_Stop(playerid, type)
{
	if(player_Pursuit_ID[playerid] != -1)
	{
		new suspect = -1,
			police = -1;
		if(!player_Pursuit_Type{playerid}) 
		{
			police = playerid;
			suspect = player_Pursuit_ID[playerid];
		}
		else
		{
			police = player_Pursuit_ID[playerid];
			suspect = playerid;
		}
		if(PI[suspect][pJailTime] < 2)
		{
			switch(type)
			{
				case -1:
				{
					SCM(police,-10092289, "{FF6729}[Полицейская погоня]{FCFCFC} Вы отменили погоню");
					SCM(suspect,-10016257, "{FF6729}[Полицейская погоня]{FCFCFC} Полицейский отменили погоню за вами");
				}
				case 0:
				{
					if(!PI[suspect][pLevel_Suspect])
					{
						SCMAllf(-11521793, "%s выходит при аресте/погоне (+40 минут заключения)", PN(suspect));
						JailPlayer(suspect, (PI[suspect][pLevel_Suspect]*30)*60 + 2400, true);
					}
					SCM(police,-10092289, "{FF6729}[Полицейская погоня]{FCFCFC} Розыскиваемый вышел с игры");
				}
				case 1:
				{
					SCM(police,-10092289, "{FF6729}[Полицейская погоня]{FCFCFC} Разыскиваемый {FF6600}ушел{FFFFFF} от погони!");
					SCM(suspect,-10092289, "{FF6729}[Полицейская погоня]{FCFCFC} Вы {FF6600}ушли{FFFFFF} от погони!");
				}
			}
		}
		player_Pursuit_Init(police, -1, false);
		player_Pursuit_Init(suspect, -1, false);
	}
	return 1;
}
stock IsPlayerPursuit(playerid, to_player)
{
	new bool:check = true;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) check = false, SCM(playerid,-825307393, "* Такого игрока нет");
	else if(player_Pursuit_ID[playerid] == to_player)
	{
		SPD(playerid, 20475, 0, "Подтверждение", (str_f("Вы действительно хотите окончить погоню за %s", PN(player_Pursuit_ID[playerid]))), "Да","Нет");
		return 0;
	}
	else if(!PI[to_player][pLevel_Suspect]) check = false, SCM(playerid,-825307393, "* Данный человек не находится в розыске");
	else if(!IsPlayerInRangeOfPlayer(playerid, to_player, 40.0)) check = false, SCM(playerid, 0x999999FF, !"* Игрок слишком далеко");
	return check;
}
stock cmd_pg(playerid)
{
	SCM(playerid,-825307393, "Используйте: /pg [ID игрока]");
	SCM(playerid,-825307393, "Подсказка: Используйте команду без ввода ID чтобы");
	SCM(playerid,-825307393, "Подсказка: вывести список игроков в розыске в Вашем поле зрения");
	new count;
	str_1[0] = EOS;
	new Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPlayer(playerid, i, 100.0) || !PI[i][pLevel_Suspect] || playerid == i) continue;
		f(str_1, sizeof(str_1), "%s{CECECE}- %s[%i] (розыск: %i | дист.: %.2f м)\n", str_1, PN(i), i, PI[i][pLevel_Suspect], GetPlayerDistanceFromPoint(i, x, y, z));
		player_ShowUID[playerid][count] = i;
		count++;
	}
	if(!count) SPD(playerid, 0, 2, "Список игроков", "- список пуст", "Далее","Отмена");
	else SPD(playerid, 20474, 2, "Список игроков", str_1, "Далее","Отмена");
	return 1;
}
CMD:arrest(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 2) return SCM(playerid,-825307393, "Доступно с 2 ранга");
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, 217.7637,1370.5646,12.1993)) return SCM(playerid,-825307393, "Вы должны находиться на парковке участка.");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /arrest [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid,-2127958, "Используйте: /su [id игрока] [уровень розыска (в случае ручного ввода причины)]");
	if(!PI[to_player][pLevel_Suspect]) return SCM(playerid,-825307393, "Этот игрок не в розыске");
	if(!PI[to_player][pTemp_Cuffed]) return SCM(playerid,-825307393, "Игрок должен быть в наручниках");
	Action(playerid, (str_f("передаёт преступника %s в полицейский участок", PN(to_player))), 25.0, true, -577699841);
	SetTimerEx("player_Arrest_Wait", 4000, false, "ii", playerid, to_player);
	return 1;
}
public: player_Arrest_Wait(playerid, to_player)
{
	if(!IsPlayerLogged(to_player) || !IsPlayerLogged(playerid)) return 0;
	SCMf(playerid,-1, "%s был доставлен в тюрьму для отбывания наказания", PN(to_player));
	SCMf(playerid,1724645631, "Время заключения: %i:00", PI[to_player][pLevel_Suspect]*30);
	if(PI[to_player][pLevel] > 1)
	{
		GivePlayerMoneyEx(playerid, PI[to_player][pLevel_Suspect]*4000000, "Посадил в тюрьму");
	}
	player_Pursuit_Stop(playerid, 404);
	JailPlayer(to_player, (PI[to_player][pLevel_Suspect]*30)*60, true);
	SCMf(to_player, -1, "%s посадил вас в тюрьму", PN(playerid));
	cmd_uncuff(playerid);
	cmd_uncuff(to_player);
	return 1;
}
public: player_CheckFines(playerid)
{
	if(cache_num_rows() > 0)
	{
		static count;
		cache_get_int(0, !"count", count);
		if(count > 0)
		{
			player_Fines_PayText(playerid);
			SCM(playerid, 0x999999FF, !"Если права не вернулись после погашения всех штрафов, напишите команду /givelic");
			PI[playerid][pLicense_Driving] = 0;
		}
	}
	return 1;
}
CMD:givelic(playerid)
{
	if(!PI[playerid][pLicense_Driving])
	{
		if(player_AntiFlood[playerid][24]-global_time > 0)
		{
			SCMf(playerid,-1145324613, "* Вы уже недавно проверяли наличие прав, подождите %i сек", player_AntiFlood[playerid][24]-global_time);
			return 1;
		}
		player_AntiFlood[playerid][24] = global_time+20;
		new total = player_Fines_Counts(PN(playerid));
		if(total <= 0)
		{
			SCM(playerid, COLOR_GREEN, !"Вам было возвращено водительское удостоверение, больше не нарушайте.");
			PI[playerid][pLicense_Driving] = 1;
		}
		else player_Fines_PayText(playerid);
	}
	else SCM(playerid, 0x999999FF, !"У вас уже имеются водительское удостоверение.");
	return 1;
}
stock player_Fines_PayText(playerid)
{
	SCM(playerid, COLOR_GREEN, !"У вас имеются не оплаченые штрафы. Водительское удостоверение временно изъято.");
	SCM(playerid, COLOR_GREEN, !"Водительское удостоверение будет возвращено автоматически после погашения всех штрафов.");
}
stock ClearAnimationsSync(playerid)
{
	SetPlayerSpecialAction(playerid, 0);
    ClearAnimations(playerid);
    ApplyAnimation(playerid, !"BD_FIRE", !"BD_Fire1", 4.1, 0, 0, 0, 0, 1, 1);
	return 1;
}
//setleader
CMD:setleader(playerid, get[])
{
	extract get -> new to_player, id; else
	{
		SCM(playerid, 0xCECECEFF, "1 - Правительство");
		SCM(playerid, 0xCECECEFF, "2 - Министерство Внутренних Дел");
		SCM(playerid, 0xCECECEFF, "3 - Министерство Здравоохранения");
		SCM(playerid, 0xCECECEFF, "4 - Министерство Обороны");
		SCM(playerid, 0xCECECEFF, "5 - Министерство Чрезвычайных Ситуаций");
		SCM(playerid, 0xCECECEFF, "6 - Национальная гвардия");
		SCM(playerid, 0xCECECEFF, "7 - ТРК \"Ритм\"");
		SCM(playerid, 0xCECECEFF, "8 - ФСИН (Тюрьма)");
		SCM(playerid, 0xCECECEFF, "Используйте: /setleader [id игрока] [организация]");
		return 1;
	}
	if(!IsPlayerLogged(to_player)) return SCM(playerid,-825307393, "* Игрок не найден");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 20.0)) return SCM(playerid,-825307393, "Игрок находится слишком далеко");
	if(!GetString(FractionData[id][frLeader], "Нет"))
	{
		SCMf(playerid, -825307393, "/setleaderoff %s", FractionData[id][frLeader]);
		SCMf(playerid,-825307393, "* У данной фракции есть лидер ( %s ), снимите его для назначения нового руководителя.", FractionData[id][frLeader]);
		return 1;
	}
	if(id > 8 || id < 1) return SCM(playerid, 0xCECECEFF, "Укажите фракцию от 1 до 8");
	fraction_InvitePlayer(to_player, id, 10);
	SendAdminsMessagef(0xCECECEFF, "[A] %s[%i] назначил лидера %s[%i] во фракцию %s", PN(playerid), playerid, PN(to_player), to_player, FractionStaticData[id][frName]);
	
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Админ %s назначил лидера %s[%i] во фракцию %s", str_log, PN(to_player), to_player, FractionStaticData[id][frName]);
	SendLog(0, str_log);
	return 2;
}
alias:setleader("makeleader")
CMD:setleaderoff(playerid, get[])
{
	extract get -> new string:name[24]; else
	{
		SCM(playerid, 0xCECECEFF, "Используйте: /setleaderoff[name]");
		return 1;
	}
	static safeName[24];
	safeName[0] = EOS, mysql_escape_string(name, safeName, 24);
	for(new i=1; i < sizeof(FractionStaticData); i++)
	{
		if(GetString(FractionData[i][frLeader], safeName))
		{
			new id = GetPlayerID(safeName);
			
			if(id == INVALID_PLAYER_ID)
			{
				mysql_tquery(mysql, (str_f("UPDATE `players` SET `Member_ID` = '0', `Member_Rang` = '1' WHERE `NickName` = '%s' LIMIT 1;", safeName)));
				SetString(FractionData[i][frLeader], "Нет");
				UpdateDataStr("Fractions", "Leader", "Нет", FractionData[i][frID]);
			}
			else
			{
				fraction_InvitePlayer(id, 0);
				SCMf(id, -1, "Администратор %s[%i] снял вас с должности лидера фракции %s", PN(playerid), playerid, FractionStaticData[i][frName]);
			}
			SendAdminsMessagef(0xCECECEFF, "[A] %s[%i] снял лидера %s[%i] с фракции %s", PN(playerid), playerid, safeName, id, FractionStaticData[i][frName]);
			
			str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
			f(str_log, sizeof(str_log), "Админ %s снял лидера %s[%i] с фракции %s", str_log, safeName, id, FractionStaticData[i][frName]);
			SendLog(0, str_log);
			return 2;
		}
	}
	return 1;
}
alias:setleaderoff("makeleaderoff")
CMD:clear(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 5) return SCM(playerid,-825307393, "Доступно с 5 ранга");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /clear [id игрока]");
	if(!IsPlayerLogged(to_player) || playerid == to_player) return SCM(playerid,-825307393, "* Игрок не найден");
	SCMf(playerid,865730559, "Вы сняли розыск с %s", PN(to_player));
	SCMf(to_player,865730559, "%s %s снял с Вас розыск", FractionRName[PI[playerid][pMember_ID]][PI[playerid][pMember_Rang]], PN(playerid));
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s[%i] снял розыск у %s[%i]", FractionRName[PI[playerid][pMember_ID]][PI[playerid][pMember_Rang]], PN(playerid), playerid, PN(to_player), to_player);
	SendTeamMessage(2, 13434879, str_mes);
	Action(playerid, "удалил(а) разыскиваемого с федеральной базы данных", 25.0, true, -577699841);
	SetPlayerSuspectLevel(to_player, -100);
	return 1;
}
stock SetPlayerSuspectLevel(playerid, level)
{
	new old = PI[playerid][pLevel_Suspect];
	PI[playerid][pLevel_Suspect] += level;
	if(PI[playerid][pLevel_Suspect] > 6) PI[playerid][pLevel_Suspect] = 6;
	else if(PI[playerid][pLevel_Suspect] < 1) PI[playerid][pLevel_Suspect] = 0;
	if(old != PI[playerid][pLevel_Suspect])
	{
		SetPlayerSuspectInit(playerid);
		UpdateDataInt("players", "Level_Suspect", PI[playerid][pLevel_Suspect], PI[playerid][pID]);
	}
}
CMD:wanted(playerid)
{
	Action(playerid, "просматривает список разыскиваемых по федеральной базе", 25.0, true, -577699841);
	cmd_wanted(playerid, 0);
	return 1;
}
stock cmd_wanted(playerid, list)
{
	player_ShowID[playerid][20] = list;
	str_1 = "Розыск\tИмя\n";
	new count, iter;
	foreach(new i: Player)
	{
		if(!IsPlayerLogged(i)) continue;
		iter++;
		if(list*20 <= iter) continue;
		f(str_1, sizeof(str_1), "%s{FFFFFF}%i\t%s[%i]\n", str_1, PI[i][pLevel_Suspect], PN(i), i);
		count++;
		if(count >= 20)
		{
			break;
		}
	}
	SPD(playerid, 20476, 5, "{FFCD00}Список разыскиваемых", str_1, "Закрыть","Отмена", "", (list > 1 ? true : false), (count >= 20 ? true : false));
	return 1;
}
CMD:setmark(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 4) return SCM(playerid,-825307393, "Доступно с 4 ранга");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /setmark [id игрока]");
	if(!IsPlayerLogged(to_player) || playerid == to_player) return SCM(playerid,-825307393, "* Игрок не найден");
	EnablePlayerGPS(playerid, 41, player_TempPosition[to_player][0], player_TempPosition[to_player][1], player_TempPosition[to_player][2]);
	return 1;
}
CMD:ejectout(playerid, get[])
{
	if(PI[playerid][pMember_ID] != 2) return SCM(playerid, 0x999999FF, "Вы не сотрудник МВД");
	if(!PI[playerid][pMember_Duty]) return SCM(playerid, 0x999999FF, "Вы должны быть одеты в рабочую форму");
	if(PI[playerid][pMember_Rang] < 2) return SCM(playerid,-825307393, "Доступно с 2 ранга");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /ejectout [id игрока]");
	if(!IsPlayerLogged(to_player) || playerid == to_player) return SCM(playerid,-825307393, "* Игрок не найден");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 20.0)) return SCM(playerid,-825307393, "Игрок находится слишком далеко");
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT && (GetPlayerState(to_player) == PLAYER_STATE_DRIVER || GetPlayerState(to_player) == PLAYER_STATE_PASSENGER))
	{
		RemovePlayerFromVehicle(to_player);
		Action(playerid, (str_f("разбил стекло автомобиля, вытащил оттуда %s", PN(to_player))), 25.0, true, 0xDD90FFFF);
	}
	else SCM(playerid,-825307393, "* Игрок должен быть в машине");
	return 1;
}
CMD:phone(playerid)
{
	if(!PI[playerid][pPhone_Number]) return SCM(playerid, 0x999999FF, !"У Вас нет телефона. Его можно купить в сотовом салоне");
	OpenInterface[playerid][88] = !OpenInterface[playerid][88];
	if(!OpenInterface[playerid][88])
	{
		ExecutePacket(playerid, webUpdate, "interface('Phone').hidePhone()");
	}
	else
	{
		SCM(playerid,-7327489, "Чтобы скрыть / показать курсор, используйте ALT; чтобы скрыть телефон, нажмите стрелочку вниз");
		GetPhoneData(playerid);
		if(!player_Phone_Loaded{playerid})
		{
			player_Phone_Loaded{playerid} = true;
			ExecutePacket(playerid, webUpdate, "interface('Phone').clearContacts()");
			ExecutePacket(playerid, webUpdate, "interface('Phone').addContact('[[\"Авиапоставки\",710,-1,1],[\"Больница\",3,-1,1],[\"Полиция\",2,-1,1],[\"МЧС\",101,-1,1],[\"Автомеханики\",90,-1,1],[\"Время\",60,-1,1],[\"Баланс\",111,-1,1]]')");
			
			ExecutePacket(playerid, webOpen, "Phone", str_1);
		}
		else
		{
			ExecutePacket(playerid, webUpdate, (str_f("interface('Phone').showPhone('%s')", str_1)));
		}
	}
	//"interface('Phone').updateTime('["01:45","5 мая",100,0,0,[8,9]]')"
	return 1;
}
stock player_Phone_Close(playerid)
{
	OpenInterface[playerid][88] = false;
	ExecutePacket(playerid, webUpdate, "interface('Phone').hidePhone()");
	return 1;
}
stock GetPhoneData(playerid)
{
	new year, month, day;
	getdate(year, month, day);
	str_1[0] = EOS, f(str_1, sizeof(str_1), "[\"%02i:%02i\",\"%i %s\",100,%i,1,[7,10,11,8,10,11,9,10,11,3]]", global_hour, global_minute, day, GetMonthName(month), PI[playerid][pPhone_Sounds]);
}
stock player_Phone_Click(playerid, clickid)
{
	if(!OpenInterface[playerid][88]) return 0;
	SCMf(playerid, -1, "%i", clickid);
	switch(clickid){
		case 14:{
			ExecutePacket(playerid, webUpdate, "interface('Phone').getCurrentApp().setDisplayParams(1)");
		}
	}
	return 1;
}
stock player_Phone_GameEvent(playerid, const name[], const subname[], item)
{
	if(!OpenInterface[playerid][88]) return 0;
	SCMf(playerid, -1, "%s, %s, %i", name, subname, item);
	if(GetString(name, "easter"))
	{
		if(GetString(subname, "end_timer")) //открытие
		{
			ExecutePacket(playerid, webUpdate, "interface('Phone').getApp('easter').onServerResponse(0, '[0,5,1714874750,5,1,10,0,[[-2500,2550],[2238,-1793],[-2019,-2080],[-819,-1618],[3175,-1840],[2633,-190],[12,-2937],[70,-1526],[-1903,2793],[-15,1433],[-1147,2695],[-1865,2898],[2177,1645],[-2592,2189],[-238,-1059],[2270,-198],[2290,-1707],[-2074,-1967],[-123,1379],[-2199,54]],[[\"Ушки кролика\",6,15885,180],[\"Маска кролика\",6,15876,225],[\"Маска петушка\",6,15875,225],[\"Бананка с зайцем\",6,16994,500],[\"Рюкзак золотое яйцо\",6,16993,675],[\"Костюм акулы\",4,17049,1200],[\"Костюм кролика\",4,15551,1200]]]')");
		}
		else if(GetString(subname, "buy_item")) //покупка
		{

		}
		else if(GetString(subname, "take_point"))
		{
			
		}
		else if(GetString(subname, "end_timer"))
		{
			
		}
		else if(GetString(subname, "end_timer"))
		{
			
		}
	}
	return 1;
}
stock player_Phone_ChangeSoundMode(playerid, bool:type)
{
	if(!OpenInterface[playerid][88]) return 0;
	PI[playerid][pPhone_Sounds] = type;
	UpdatePlayerDataInt(playerid, "Phone_Sounds", PI[playerid][pPhone_Sounds]);
	return 1;
}
stock player_MouseButton_Click(playerid, click)
{
	if(player_AntiFlood[playerid][25]-global_time > 0)
	{
		return 1;
	}
	player_AntiFlood[playerid][25] = global_time+2;
	if(click == 3)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsValidVehicle(vehicleid))
		{
			if(VehicleData[vehicleid][V_ACTION_TYPE] == 2 && VehicleData[vehicleid][V_ACTION_TYPE] == 2)
			{
				callcmd::m(playerid);
			}
		}
	}
	return 1;
}
CMD:tpass(playerid, params[])
{
	extract params -> new to_player; else return SCM(playerid, 0x999999FF, !"Используйте: /tpass [id игрока]");

	new id = player_SearchJobID(playerid, 0);
	if(id == -1) return SCM(playerid,-1717986817, !"Ваш рейтинг не сформирован, введите команду (необходимо заново устроиться в компанию)");

	new i = PI[playerid][pJob_BizID][id];
	if(i == -1) return SCM(playerid,-1717986817, !"Ваш рейтинг не сформирован, введите команду (необходимо заново устроиться в компанию)");

	if(!IsPlayerConnected(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
		return SCM(playerid, 0x999999FF, !"* Игрок слишком далеко");

	Action(playerid, "показал свой паспорт", _, false);
	new type = BizData[i][bType];
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s", BizStaticData[type][bsName], BizData[i][bName]);
	f(str_mes, sizeof(str_mes), "[[4,[\"%s\",\"%s\",4,6]]]", PN(playerid), str_mes);
	ExecutePacket(to_player, webOpen, "Docs", str_mes);
	return 1;
}
CMD:bizlist(playerid)
{
	player_Contract_Business(playerid, 20477);
	return 1;
}
CMD:fuellist(playerid)
{
	player_Contract_Business(playerid, 20478);
	return 1;
}
stock player_Contract_Business(playerid, dialogid)
{
	new id = player_SearchJobID(playerid, 0);
	if(id == -1) return SCM(playerid,-825307393, !"* Вы не работаете дальнобойщиком");

	new bizid = PI[playerid][pJob_BizID][id];
	if(bizid == -1) return SCM(playerid,-825307393, !"* Вы не работаете дальнобойщиком");
//	if(player_Carriers_Products)
	{
		new biz_id = player_Carriers_BizID[playerid];
		if(biz_id != -1)
		{
			SCM(playerid,-1, " ");
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%i %s", player_Carriers_Products[playerid], (BizData[bizid][bType] == 1 ? "л" : "ед"));
			SCMf(playerid,-1, "- Грузовой {FFFF00}%s{ffffff}. Заказчику требуется {FFFF00}%i %s", player_Carriers_Products[playerid] <= 0 ? "отсек пуст" : str_mes, 15000-BizData[biz_id][bProducts], BizData[biz_id][bType] == 1 ? "л.{ffffff} топлива" : "ед.{ffffff} товара");
			player_Carriers_DialogOrder(playerid, 0, "{FFCD00}Подробности о взятом заказе", "Закрыть","");
			return 1;
		}
	}

	str_1 = "{ffffff}Бизнес\t{ffffff}Требуется\t{ffffff}Оплата работы\n";
	new count;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(BizData[i][bProducts] > 10000) continue;
		if(dialogid == 20477)
		{
			if(BizData[i][bType] == 1) continue;
		}
		else
		{
			if(BizData[i][bType] != 1) continue;
		}
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s", BizStaticData[BizData[i][bType]][bsName], BizData[i][bName]);
		f(str_1, sizeof(str_1), "%s№%i: %s\t%i %s.\t%i руб\n", str_1, i, str_mes, 15000-BizData[i][bProducts], (dialogid == 20477 ? "ед" : "л"), GetCarriersWage(i));
		player_ShowData[playerid][count] = i;
		count++;
		if(count > 70)
		{
			break;
		}
	}
	if(!count) SCM(playerid,-825307393, !"На данный момент активных заказов нет, загляните сюда позже");
	else SPD(playerid, dialogid, 5, "{FFCD00}Контракты на доставку", str_1, "Выбрать","Закрыть");
	return 1;
}
stock GetCarriersWage(i)
{
	new dist;
	if(dist > 3000) dist = 3000;
	else if(dist > 2000) dist = 2000;
	else if(dist > 1000) dist = 1000;
	else dist = 500;
	return (dist*(15000-BizData[i][bProducts]))/100*75;
}
stock player_Carriers_DutyExit(playerid, i, bool:eject)
{
	if(PI[playerid][pTemp_JobCarID][i] == -1) return 0;
	if(eject) RemovePlayerFromVehicle(playerid);
	player_ReturnTimer[playerid][i] = -1;
	new carid = PI[playerid][pTemp_JobCarID][i];
	PI[playerid][pTemp_JobCarID][i] = -1;
	VehicleData[carid][V_CREATE_ID] = -1;
	DestroyVehicleLabel(carid);
	OnVehicleSpawn(carid);
	ExecutePacket(playerid, webClose, "InformationTimer");
	return 1;
}
stock Carriers_SearchSpawn(Float:x, Float:y, Float:z)
{
	new Float:Distance, Float:Distance_ = 100000.0, useid = -1;
	for(new i; i < sizeof(Carriers_PickupPos); i++)
	{
		Distance = DistancePointToPoint(x, y, z, Carriers_PickupPos[i][0], Carriers_PickupPos[i][1], Carriers_PickupPos[i][2]);
		if(Distance < Distance_) useid = i, Distance_ = Distance;
	}
	return useid;
}
stock player_Carriers_TrailerSpawn(playerid, vehicleid, modelid)
{
	if(VehicleData[vehicleid][V_MODELID] == 15097)
	{
		SCM(playerid,-1717986817, !"Транспорт, в котором Вы находитесь, не предусматривает использование прицепа");
	}
	else
	{
		if(player_AntiFlood[playerid][26]-global_time > 0) return SCM(playerid,-1717986817, !"Вывозить прицеп из гаража можно раз в 90 сек, подождите");
		player_AntiFlood[playerid][26] = global_time+90;
		new uid = Carriers_SearchVehicleUID(vehicleid);
		if(uid != -1)
		{
			new trailer = Carriers_CarTrailer[uid];
			if(trailer == -1)
			{
				//new id = CarriersCarData[Carriers_SearchSpawn(CarriersCarData[uid][fcX], CarriersCarData[uid][fcY], CarriersCarData[uid][fcZ])][fcID];
				static const Float:tr_Pos[][][] = {
					{
						{2403.4756,-644.2738,13.5829,90.9838}, // ПРИЦЕП ЮЖНЫЙ
						{2403.2078,-636.7379,13.5454,89.9071}, // ПРИЦЕП ЮЖНЫЙ
						{2403.7593,-629.3854,13.5645,88.7737}, // ПРИЦЕП ЮЖНЫЙ
						{2403.3528,-622.3737,13.5620,90.6014}, // ПРИЦЕП ЮЖНЫЙ
						{2403.6758,-615.1230,13.5799,89.5968}, // ПРИЦЕП ЮЖНЫЙ
						{2403.7600,-607.6860,13.5806,89.3262} // ПРИЦЕП ЮЖНЫЙ
					},
					{
						{-2495.7222,-1.6441,15.1140,168.3891}, // ПРИЦЕП ЛЫТКА ТРИАЗОВ ПИДАРАС
						{-2503.0190,-0.2641,15.2182,166.6207}, // ПРИЦЕП ЛЫТКАРИНА
						{-2509.8896,1.4621,15.1968,168.6806}, // ПРИЦЕП ЛЫТКАРИНА
						{-2516.8757,2.8808,15.1947,167.5548}, // ПРИЦЕП ЛЫТКАРИНА
						{-2524.3374,4.3567,15.2563,165.8539}, // ПРИЦЕП ЛЫТКАРИНА
						{-2531.3450,6.1486,15.2099,168.2371} // ПРИЦЕП ЛЫТКАРИНА
					},
					{
						{2112.2183,1796.2211,16.5194,1.7443}, // ПРИЦЕП БАТЫРЕВА
						{2119.6335,1796.4426,16.5399,359.7090}, // ПРИЦЕП БАТЫРЕВА
						{2126.5354,1796.2477,16.5658,3.3896}, // ПРИЦЕП БАТЫРЕВА
						{2133.9463,1796.1847,16.5518,1.1547}, // ПРИЦЕП БАТЫРЕВА
						{2141.3826,1795.9689,16.5654,1.9036}, // ПРИЦЕП БАТЫРЕВА
						{2148.3652,1796.3196,16.5569,1.3149} // ПРИЦЕП БАТЫРЕВА
					}
				};
				new rand_pos = random(6),
					id = CarriersCarData[uid][fcID];
				Carriers_CarTrailer[uid] = AddStaticVehicleEx(modelid, tr_Pos[id][rand_pos][0], tr_Pos[id][rand_pos][1], tr_Pos[id][rand_pos][2], tr_Pos[id][rand_pos][3], 1, 1, 600000);
			}
			else SCM(playerid,-1717986817, !"У Вас уже есть свой прицеп. Чтобы взять новый, для начала верните свой");
		}
	}
	return 1;
}
stock Carriers_UpdateDuty(playerid)
{
	for(new i; i < 3; i++)
	{
		if(player_ReturnTimer[playerid][i]-global_time < 1 && player_ReturnTimer[playerid][i] >= global_time)
		{
			new carid = PI[playerid][pTemp_JobCarID][i];
			if(carid != -1)
			{
				player_Carriers_DutyExit(playerid, i, false);
				break;
			}
		}
	}
}
public OnPlayerAttachTrailer(playerid, vehicleid, trailerid, status)
{
	if(!status)
	{
		if(VehicleData[vehicleid][V_MODELID] != 15097)
		{
			new uid = Carriers_SearchVehicleUID(vehicleid);
			if(uid != -1)
			{
				player_Carriers_Update(playerid, 0);
				new trailer = Carriers_CarTrailer[uid];
				if(trailer == trailerid)
				{
					VehicleData[trailer][V_ACTION_TYPE] = -4;
					SCM(playerid,-1, (VehicleData[trailer][V_MODELID] == 435 ? "Вы прикрепили за собой {ffbc57}прицеп для груза{ffffff}. Для работы используйте команду: {ffbc57}/bizlist{ffffff}" : "Вы прикрепили за собой {ffbc57}прицеп с цистерной{ffffff}. Для работы используйте команду: {ffbc57}/fuellist{ffffff}"));
				}
				else SCM(playerid,-1, !"Это не ваш прицеп, отцепите его. Работа с ним будет невозможна");
			}
		}
	}
	return 1;
}
CMD:teamcar(playerid)
{
	if(!PI[playerid][pMember_ID]) return SCM(playerid, 0x999999FF, !"Вы не состоите в организациях");
	if(PI[playerid][pMember_Rang] < 10) return SCM(playerid, 0x999999FF, !"У вас нету доступа к этой команде");
	str_1[0] = EOS;
	for(new i, count; i < sizeof(fractionCarData); i++)
	{
		if(fractionCarData[i][fcID] == PI[playerid][pMember_ID])
		{
			new vehicleid = team_CarData[i],
				uid = IsValidCarModel(VehicleData[vehicleid][V_MODELID]);
			if(uid != -1)
			{
				f(str_1, sizeof(str_1), "%s{%s}- %s (%i){03c03c}[с %i ранга]\n", str_1, (GetPlayerVehicleID(playerid) == team_CarData[i] ? "008000" : "ffffff"), VehicleStaticData[uid][vsName], VehicleData[vehicleid][V_MODELID], team_CarRang[i]);
				player_ShowData[playerid][count] = i;
				count++;
			}
		}
	}
	SPD(playerid, 20401, DIALOG_STYLE_LIST, "Транспорт организации", str_1, "Выбрать", "Закрыть");
	return 1;
}
stock fraction_SaveCars()
{
	str_1[0] = EOS;
	for(new i; i < sizeof(fractionCarData); i++) f(str_1, sizeof(str_1), "%s%i,", str_1, team_CarRang[i]);
	UpdateDataStr("Config", "carsRang", str_1, 1);
}
stock player_Carriers_ListOrders(playerid, dialogid)
{
	new uid = Carriers_SearchVehicleUID(GetPlayerVehicleID(playerid));
	if(uid != -1)
	{
		new trailerid = Carriers_CarTrailer[uid],
			vehicleid = Carriers_CarData[uid];
		if(dialogid == 20477)
		{
			if(trailerid != -1)
			{
				new attachVehicle = GetVehicleTrailer(vehicleid);
				if(attachVehicle == trailerid)
				{
					if(VehicleData[trailerid][V_MODELID] == 435)
					{
						player_Carriers_AcceptOrder(playerid, vehicleid);
					}
					else SCM(playerid,-1717986817, !"Ваш прицеп не соответствует выбранному заказу");
				}
				else SCM(playerid,-1717986817, !"Ваш прицеп должен быть прикреплён к рабочему транспорту");
			}
			else SCM(playerid,-1717986817, !"Вы должны взять соответствующий прицеп из гаража компании");
		}
		else
		{
			if(trailerid != -1 || VehicleData[vehicleid][V_MODELID] == 15097)
			{
				new attachVehicle = GetVehicleTrailer(vehicleid);
				if(VehicleData[vehicleid][V_MODELID] == 15097)
				{
					player_Carriers_AcceptOrder(playerid, vehicleid);
				}
				else if(attachVehicle == trailerid)
				{
					if(VehicleData[trailerid][V_MODELID] != 435)
					{
						player_Carriers_AcceptOrder(playerid, vehicleid);
					}
					else SCM(playerid,-1717986817, !"Ваш прицеп не соответствует выбранному заказу");
				}
				else SCM(playerid,-1717986817, !"Ваш прицеп должен быть прикреплён к рабочему транспорту");
			}
			else SCM(playerid,-1717986817, !"Вы должны взять соответствующий прицеп из гаража компании");
		}
	}
	return 1;
}
stock player_Carriers_AcceptOrder(playerid, vehicleid)
{
	if(GetPlayerVehicleID(playerid) == vehicleid)
	{
		player_Carriers_DialogOrder(playerid, 20482, "{FFCD00}Заказ на поставку груза", "Принять","Назад");
	}
	else SCM(playerid,-1717986817, !"Необходимо располагаться в рабочем транспорте");
	return 1;
}
stock player_Carriers_DialogOrder(playerid, dialogid, const name[], const button_0[], const button_1[])
{
	new id = player_SearchJobID(playerid, 0);
	if(id == -1) return SCM(playerid,-825307393, !"* Вы не работаете дальнобойщиком");

	new job_bizid = PI[playerid][pJob_BizID][id];
	if(job_bizid == -1) return SCM(playerid,-825307393, !"* Вы не работаете дальнобойщиком");

	new bizid = player_ShowUID[playerid][158];
	if(BizData[bizid][bProducts] > 15000) return SCM(playerid,-1717986817, !"Заказ уже кем то выполняется");

	str_1[0] = EOS, f(str_1, sizeof(str_1), "\
		{ffffff}Создатель контракта: {f0c94f}%s %s{ffffff}\n\
		Необходимый товар: {f0c94f}%s\n\
		{ffffff}Длина пути от места загрузки: {f0c94f}%i м.\n\n\
		{ffffff}Необходимое количество: {f0c94f}%i {ffffff}ед.\n\
		Оплата за всю работу: {aef04f}%i{ffffff} руб.\n\n\
		Бонус от Вашего навыка: {aef04f}+ 0 {ffffff}руб.\n\
		Комиссия компании составляет: {ffe36c}%i%%{ffffff}\n\n\
		Примерное количество заездов: {f0c94f}%i{ffffff} кр.", \
			BizStaticData[BizData[bizid][bType]][bsName], BizData[bizid][bName], \
			(BizData[bizid][bType] == 1 ? "Топливо" : "Потребительский"), \
			(BizData[bizid][bType] == 1 ? floatround(DistancePointToPoint(BizData[bizid][bEnter][0], BizData[bizid][bEnter][1], BizData[bizid][bEnter][2], plant_Pos[0][0], plant_Pos[0][1], plant_Pos[0][2])) : 1),\
			15000-BizData[bizid][bProducts], GetCarriersWage(bizid), BizData[job_bizid][bProductEx], (15000 - BizData[bizid][bProducts])/5000);
	SPD(playerid, dialogid, 0, name, str_1, button_0, button_1);
	return 1;
}
stock player_Carriers_RandAdvice(playerid)
{
	static const adviceList[][] = {
		"Если выполнение контракта затянется, то есть шанс не получить вознаграждение в виде очков рейтинга",
		"После окончания рабочего дня необходимо вернуть транспорт в гараж компании",
		"Если Вы хотите посмотреть подробности о взятом заказе, то введите команду для просмотра контрактов",
		"Пожалуйста, относитесь к другим игрокам с пониманием, и будьте терпеливее",
		"Переодически транспорт необходимо обслуживать, принесённый ущерб приближает его к поломке",
		"Среди компаний существует номинация 'Сотрудник недели', и каждый может принять в ней участие",
		"Если Вы нанесли ущерб доставляемому грузу, то Вам придётся оплатить штраф от компании",
		"Старайтесь не терять свой прицеп, за такую потерю компания может выдать Вам штраф"
	};
	SCMf(playerid,-4433921, "Совет по работе: {ffffff}%s", adviceList[random(sizeof(adviceList))]);
}
CMD:cl(playerid, get[])
{
    extract get -> new player:targetid; else return SCM(playerid, -1, !"Используйте: /cl [id]");
    if(!IsPlayerConnected(targetid)) return SCM(playerid, -1, !"Игрок не в сети!");
    if(!IsPlayerMobile{targetid}) SCMf(playerid, -1, "Игрок %s[%i] подключен с PC Launcher'a!", PN(targetid), targetid);
    else SCMf(playerid, -1, "Игрок %s[%i] подключен с Mobile Launcher'a!", PN(targetid), targetid);
	return 1;
}
CMD:cl_stat(playerid)
{
	new mobile, pc;
	foreach(new i: Player)
	{
		if(!IsPlayerMobile{i}) pc++;
		else mobile++;
	}
	SCMf(playerid, -1, "pc: %i, mobile: %i", pc, mobile);
}
CMD:compare_cash(playerid, get[])
{
	return 1;
}
CMD:add_cash(playerid, get[])
{
	AddInt64(playerid, strval(get));
	return 1;
}
stock CompareInt64(playerid, const sign[], number_2)
{
	if(player_AntiFlood[playerid][27]-global_time > 0){
		SCM(playerid,-1717986817, !"Нельзя это делать так часто");
		return 1;
	}
	player_AntiFlood[playerid][27] = global_time+1;
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT IF(%s %s %i, '1', '0') as comparison_result", player_Cash[playerid], sign, number_2);
	new Cache:result = mysql_query(mysql, str_q);
	
	new data;
	cache_get_int(0, !"comparison_result", data);
	cache_delete(result);
	return data;
}
stock AddInt64(playerid, amount)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `Cash` = CASE WHEN (`Cash` + %i) < 0 THEN 0 ELSE (`Cash` + %i) END WHERE `ID` = '%i' LIMIT 1;", amount, amount, PI[playerid][pID]);
	mysql_tquery(mysql, str_q, "callback_AddInt64", "i", playerid);
	return 1;
}
public: callback_AddInt64(playerid, const name[]){
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Cash` FROM players WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q, "callback_CheckInt64", "i", playerid);
	return 1;
}
public: callback_CheckInt64(playerid){
	if(!cache_num_rows()) return 0;
	//static Cash[15];
	cache_get_bigint(0, "Cash", player_Cash[playerid]);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "window.interface('Hud').info.money = %s", player_Cash[playerid]);
	ExecutePacket(playerid, webUpdate, str_mes);
	ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerMoney('%s')", player_Cash[playerid])));
	return 1;
}
public OnOutgoingRPC(playerid, rpcid, BitStream:bs){
    if(rpcid == 164){
        CustomSyncs(bs);
    }
    return 1;
}
// Синхронизация транспорта --
enum SyncsCars{
    car_id,
    car_modelId,
    Float:car_pos[4],
    inter_color[2],
    Float:health,
    inter,
    damage[4],
    addsiren,
    modslot[14],
    paintjob,
    car_color[2]
};

stock CustomSyncs(BitStream:bs){
    static Syncs[SyncsCars];
    BS_ReadValue(
        bs,
        PR_UINT16, Syncs[car_id],
        PR_UINT32, Syncs[car_modelId],
        PR_FLOAT3, Syncs[car_pos],
        PR_FLOAT, Syncs[car_pos][3]
    );
    for(new i = 0; i < 2; i++) BS_ReadValue(bs, PR_UINT8, Syncs[inter_color][i]);
    BS_ReadValue(bs,
        PR_FLOAT, Syncs[health],
        PR_UINT8, Syncs[inter]
    );
    for(new i = 0; i < 4; i++){
        if(i < 2) BS_ReadValue(bs, PR_UINT32, Syncs[damage][i]);
        else BS_ReadValue(bs, PR_UINT8, Syncs[damage][i]);
    }
    BS_ReadValue(bs, PR_UINT8, Syncs[addsiren]);
    for(new i = 0; i < 14; i++)
        BS_ReadValue(bs, PR_UINT8, Syncs[modslot][i]);
    BS_ReadValue(bs, PR_UINT8, Syncs[paintjob]);
    for(new i = 0; i < 2; i++)
        BS_ReadValue(bs, PR_UINT32, Syncs[car_color][i]);
    if(IsValidVehicle(Syncs[car_id])){
        BS_Reset(bs);
        static Float:qwuat[4] = {0.0,0.0,0.0,0.0};
        static Float:rot_w, Float:rot_z;
        Quaternion(Syncs[car_pos][3], rot_w, rot_z);
        qwuat[0] = rot_w, qwuat[3] = rot_z;
        BS_WriteValue(
            bs,
            PR_UINT16, Syncs[car_id],
            PR_UINT32, Syncs[car_modelId],
            PR_FLOAT, Syncs[car_pos][0],
            PR_FLOAT, Syncs[car_pos][1],
            PR_FLOAT, Syncs[car_pos][2],
            PR_NORM_QUAT, qwuat
        );
        for(new i = 0; i < 2; i++)BS_WriteValue(bs, PR_UINT8, Syncs[inter_color][i]);
        BS_WriteValue(bs,
            PR_FLOAT, Syncs[health],
            PR_UINT8, Syncs[inter]
        );
        for(new i = 0; i < 4; i++){
            if(i < 2) BS_WriteValue(bs, PR_UINT32, Syncs[damage][i]);
            else BS_WriteValue(bs, PR_UINT8, Syncs[damage][i]);
        }    
        BS_WriteValue(bs, PR_UINT8, Syncs[addsiren]);
        for(new i = 0; i < 14; i++) BS_WriteValue(bs, PR_UINT8, Syncs[modslot][i]);
        BS_WriteValue(bs, PR_UINT8, Syncs[paintjob]);
        for(new i = 0; i < 2; i++) BS_WriteValue(bs, PR_UINT32, Syncs[car_color][i]);
    }
}
stock Quaternion(Float:angle_rot, &Float:w_rot, &Float:z_rot){
   new Float:angle = -angle_rot * 0.01745329251;
   w_rot = floatcos(angle / 2);
   z_rot = floatsin(angle / 2);
}
// --
cmd:housecord(playerid, get[]){
	if(!GetPlayerAdminEx(playerid)) return true;
	extract get -> new hid; else return SCMf(playerid, -1, "/housecord [house id/0-%i]", TOTAL_HOUSES);
	if(hid < 0 || hid > TOTAL_HOUSES) return SCMf(playerid, -1, "/housecord [house id/0-%i]", TOTAL_HOUSES);
	GetPlayerPos(playerid, HouseData[hid][hEnter][0], HouseData[hid][hEnter][1], HouseData[hid][hEnter][2]);
	GetPlayerFacingAngle(playerid, HouseData[hid][hEnter][3]);
	UpdateHouse(hid, true);
	SaveHouse(hid);
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[A] %s[%i] сменил координаты дома [№%i] с параметрами %.2f,%.2f,%.2f,%.2f", PN(playerid), playerid, hid, HouseData[hid][hEnter][0], HouseData[hid][hEnter][1], HouseData[hid][hEnter][2], HouseData[hid][hEnter][3]);
	SendAdminsMessage(0x999999FF, str_mes);
	SCM(playerid, -1, !"Готово");
	return true;
}
stock SaveHouse(hid){
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "UPDATE Houses SET Enter='%.2f,%.2f,%.2f,%.2f,' WHERE ID=%d", HouseData[hid][hEnter][0], HouseData[hid][hEnter][1], HouseData[hid][hEnter][2], HouseData[hid][hEnter][3], HouseData[hid][hID]);
	mysql_tquery(mysql, str_mes);
	return true;
}
cmd:bizcord(playerid, get[]){
	if(!GetPlayerAdminEx(playerid)) return true;
	extract get -> new bid; else return SCMf(playerid, -1, "/bizcord [biz id/0-%i]", TOTAL_BUSINESSES);
	if(bid < 0 || bid > TOTAL_BUSINESSES) return SCMf(playerid, -1, "/bizcord [biz id/0-%i]", TOTAL_BUSINESSES);
	GetPlayerPos(playerid, BizData[bid][bEnter][0], BizData[bid][bEnter][1], BizData[bid][bEnter][2]);
	GetPlayerFacingAngle(playerid, BizData[bid][bEnter][3]);
	UpdateBiz(bid, true);
	SaveBiz(bid);
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[A] %s[%i] сменил координаты бизнеса [№%i] с параметрами %.2f,%.2f,%.2f,%.2f", PN(playerid), playerid, bid, BizData[bid][bEnter][0], BizData[bid][bEnter][1], BizData[bid][bEnter][2], BizData[bid][bEnter][3]);
	SendAdminsMessage(0x999999FF, str_mes);
	SCM(playerid, -1, !"Готово");
	return true;
}
stock SaveBiz(bid){
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "UPDATE Businesses SET Enter='%.2f,%.2f,%.2f,%.2f,' WHERE ID=%d", BizData[bid][bEnter][0], BizData[bid][bEnter][1], BizData[bid][bEnter][2], BizData[bid][bEnter][3], BizData[bid][bID]);
	mysql_tquery(mysql, str_mes);
	return true;
}
CMD:map(playerid, params[]){
	extract params -> new model, string:name[30]; else return SCM(playerid, -1, !"/map [ID объекта] [name]");
	if(strlen(name) < 1 || strlen(name) > 30)
		return SCM(playerid, 0xCECECEFF, !"Используйте: /map [ID объекта] [название] (1 - 30)");
	if(GetString(name, "None")) return 0;
	if(TOTALOBJECTS + 1 > MAX_CREATE_OBJECTS) return SCM(playerid, COLOR_GREY, !"Превышен лимит созданных объектов");
	static const mysql_str[] = "SELECT * FROM `Objects` WHERE `Name` = '%s'";
	new str[sizeof(mysql_str) + (-2 + 30)];
	format(str, sizeof str, mysql_str, name);
	mysql_tquery(mysql, str);
	new rows;
	cache_get_row_count(rows);
	if(rows) return SCM(playerid, COLOR_GREY, !"Данное название объекта уже используется!");
	static Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	EditObjectPlayer[playerid] = CreateDynamicObject(model, x+2, y+2, z, 0, 0, 0);
	EditDynamicObject(playerid, EditObjectPlayer[playerid]);
	SetString(ObjectNamePlayer[playerid], name);
	SetPVarInt(playerid, "obj_edit", 1);
	SetPVarInt(playerid, "obj_model", model);
	return true;
}
CMD:dellmap(playerid, params[]){
	static name[30];
	if(sscanf(params, "s[30]", name))
		return SCM(playerid, -1, !"/dellmap [название объекта]");
	if(strlen(name) < 1 || strlen(name) > 30)
		return SCM(playerid, -1, !"/dellmap [название объекта] (1 - 30)");
	if(GetString(name, "None")) return 0;
	static obj_id = -1;
	for(new i; i < TOTALOBJECTS; i++){
		if(GetString(ObjInfo[i][objName], name)){
			obj_id = i;
			break;
		}
	}
	if(obj_id == -1) return SCM(playerid, COLOR_GREY, !"Объект под данным именем не найден");
	static const mysql_str[] = "DELETE FROM `Objects` WHERE `Name` = '%s'";
	new str[sizeof(mysql_str) + (-4 + 52)];
	SCM(playerid, -1, !"Готово");
	SendAdminsMessagef(0x999999FF, "[А] %s[%i] удалил обьект [№%i] с параметрами %i, %s", PN(playerid), playerid, ObjInfo[obj_id][objID], ObjInfo[obj_id][objModel], ObjInfo[obj_id][objName]);
	format(str, sizeof(str), mysql_str, name);
	mysql_tquery(mysql, str);
	DestroyDynamicObject(ObjInfo[obj_id][objID]);
	SetString(ObjInfo[obj_id][objName], "");
	return true;
}
CMD:maplist(playerid, params[]){
	mysql_tquery(mysql, "SELECT * FROM `Objects` WHERE 1", "OnMapList", "i", playerid);
	return true;
}
public:OnMapList(playerid){
	new rows;
	cache_get_row_count(rows);
	TOTALOBJECTS = rows;
	if(!TOTALOBJECTS) return SCM(playerid, -1, !"Список пуст");
	str_1[0] = EOS, f(str_1, sizeof str_1, "Модель\tНазвание\tАдминистратор\n");
	for(new i; i < TOTALOBJECTS; i++){
		if(ObjInfo[i][objName]){
			f(str_1, sizeof str_1, "%s%i\t%s\t%s\n", str_1, ObjInfo[i][objModel], ObjInfo[i][objName], ObjInfo[i][objCreater]);
		}
	}
	SPD(playerid, 20486, DIALOG_STYLE_TABLIST_HEADERS, "Список созданых обьектов", str_1, "Настроить", "Закрыть");
	return true;
}
ORPC:155(playerid, BitStream:bs){
    new playerCount = 0, unreadBits;
    static uid[MAX_PLAYERS], score[MAX_PLAYERS], ping[MAX_PLAYERS];
    BS_GetNumberOfUnreadBits(bs, unreadBits);

    while(unreadBits >= 16 + 32 + 32){
        BS_ReadValue(bs, PR_UINT16, uid[playerCount]);
        BS_ReadValue(bs, PR_INT32, score[playerCount]);
        BS_ReadValue(bs, PR_UINT32, ping[playerCount]);
        playerCount++;
        BS_GetNumberOfUnreadBits(bs, unreadBits);
    }

    BS_Reset(bs);

    BS_WriteValue(bs, PR_STRING8, ""NAME_SERVER"");
    BS_WriteValue(bs, PR_UINT16, Iter_Count(Player));

    for(new i = 0; i < playerCount; i++){
        new pid = uid[i];

        BS_WriteValue(bs, PR_UINT16, pid);
        BS_WriteValue(bs, PR_INT16, score[i]);

        BS_WriteValue(bs, PR_INT8, (GetPlayerAdminEx(pid) > 1 ? 1 : 0));

        BS_WriteValue(bs, PR_INT8, (IsPlayerMuted(pid) ? 1 : 0));
        BS_WriteValue(bs, PR_UINT32, GetPlayerColor(pid));
        BS_WriteValue(bs, PR_UINT32, ping[i]);
    }
    return true;
}
