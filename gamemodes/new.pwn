CMD:rem(playerid)
{
	if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid,0x808080FF,"* Вы не транспорте");
	if(!Helmet[playerid]) Action(playerid,"надел(а) ремень безопасности", PN(playerid));
	else Action(playerid,"снял(а) ремень безопасности", PN(playerid));
	Helmet[playerid] = !Helmet[playerid];
	player_UpdateSpeed(playerid);
	return 1;
}
CMD:med(playerid)
{
	new bedid = -1;
	for(new i; i < sizeof g_med_bed_pos; i++)
	{
		if(!IsPlayerInRangeOfPoint(playerid, 1.5, g_med_bed_pos[i][0], g_med_bed_pos[i][1], g_med_bed_pos[i][2])) continue;
		bedid = i;
		break;
	}

	if(bedid == -1) return 1;
	else if(GetPlayerData(playerid, pTemp_BedID) != -1) return SCM(playerid, 0xCECECEFF, !"Вы уже заняли койку");
	else if(PI[playerid][pHealth] > 95.0) return SCM(playerid, 0xCECECEFF, !"Вы не нуждаетесь в лечении");
	else if(g_med_bed_used[bedid]) return SCM(playerid, 0xCECECEFF, !"Эта койка занята");
	else
	{
		SetPlayerData(playerid, pTemp_BedID, bedid);
		g_med_bed_used[bedid] = true;
		PI[playerid][pHospital] = true;
		SetPlayerVirtualWorld(playerid, 3);
		SetPlayerInterior(playerid, 3);
		UpdatePlayerDataInt(playerid, "Hospital", PI[playerid][pHospital]);
		UpdateDynamic3DTextLabelTextf(g_med_bed_label[bedid], 0xFFFFFFEE, "Койка №%i\n\n{FFCD00}Пациент:\n%s", bedid + 1, PN(playerid));
		SCMf(playerid, 0x66CC00FF, "Вы заняли койку №%i. В зависимости от состояния здоровья лечение может занять время", bedid + 1);
		SCM(playerid, -1, !"Чтобы выписаться подойдите к врачу или выйдите за пределы больницы");
	}
	return 1;
}
CMD:bugreport(playerid, get[])
{
	extract get -> new string:str[127]; else return SCM(playerid, 0xCECECEFF, !"Используй: /bugreport [информация об ошибке]");
	if(GetPVarInt(playerid,!"bugreport")>global_time) return SCMf(playerid,0xCECECEFF,"Отправлять сообщения в bugreport, можно через %i секунд!",GetPVarInt(playerid,!"bugreport")-global_time);
	SCM(playerid, 0xFFFFFFFF, !"Ваше сообщение отправлено, если ваше обращение поможет...");
	SCM(playerid, 0xFFFFFFFF, !"...улучшить сервер, то вы будете вознаграждены!");
	SetPVarInt(playerid,!"bugreport",global_time+120);
	str_1[0] = EOS, mysql_escape_string(str, str_1);
	mysql_tqueryf(mysql,"INSERT INTO `bugreport` (`bug_name`, `bug_text`, `bug_date`) VALUES ('%s', '%s', '%i');", PN(playerid), str_1, global_time);
	return 1;
}
stock UpdateDataFloat(tablename[], field[], Float:data, ID, set = 0)
{
    if(set == 0) mysql_tqueryf(mysql, "UPDATE `%s` SET `%s` = '%f' WHERE `ID` = '%i' LIMIT 1", tablename, field, data, ID);
    else mysql_tqueryf(mysql, "UPDATE `%s` SET `%s` = '%.4f' WHERE `ID` = '%i' LIMIT 1", tablename, field, data, ID);
    return 1;
}
stock UpdateDataStr(tablename[], field[], data[], ID)
{
	static string_query[4096];
    string_query[0] = EOS, f(string_query, sizeof(string_query), "UPDATE `%s` SET `%s` = '%s' WHERE `ID` = '%i' LIMIT 1;", tablename, field, data, ID);
	mysql_tquery(mysql, string_query);
	printf("UpdateDataStr -> [%s]", string_query);
	return 1;
}
stock UpdateDataInt(tablename[], field[], data, ID) 
{
	static string_query[4096];
    string_query[0] = EOS, f(string_query, sizeof(string_query), "UPDATE `%s` SET `%s` = '%i' WHERE `ID` = '%i' LIMIT 1;", tablename, field, data, ID);
	mysql_tquery(mysql, string_query);
	printf("UpdateDataInt -> [%s]", string_query);
	return 1;
}
stock GetString(const param1[], const param2[], bool:ignorecase = false) return !strcmp(param1, param2, ignorecase);
stock NameIsFullDostup(const name[])
{
	for(new i; i < sizeof(IsFullDostupName); i++)
	{
	    if(GetString(IsFullDostupName[i], name)) return 1;
	}
	return 0;
}
stock NameIsWhiteList(const name[])
{
	for(new i; i < sizeof(IsFullWhiteList); i++)
	{
	    if(GetString(IsFullWhiteList[i], name)) return 1;
	}
	return 0;
}
CMD:finditem(playerid, get[])
{
	extract get -> new string:params[10]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /finditem [название]");
	new count;
	for(new i; i < sizeof(ItemsData); i++)
	{
		if(strfind(ItemsData[i][ItemName],params,true) == -1) continue;
		SCMf(playerid, -1, "Предмет: %s (ID: %i)", ItemsData[i][ItemName], i);
		count++;
	}
	if(!count) SCM(playerid, -1, !"Ничего не найдено!");
	return 1;
}
CMD:findcar(playerid, get[])
{
	//if(CheckAdmin(playerid, 7)) return 1;
	extract get -> new string:params[10]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /findcar [название]");
	new count;
	for(new i; i < sizeof(VehicleStaticData); i++)
	{
		if(strfind(VehicleStaticData[i][vsName],params,true) == -1) continue;
		SCMf(playerid, -1, "Название: %s (ID: %i)", VehicleStaticData[i][vsName], VehicleStaticData[i][vsModel]);
		count++;
	}
	if(!count) SCM(playerid, -1, !"Ничего не найдено!");
	return 1;
}
CMD:findskin(playerid, get[])
{
	//if(CheckAdmin(playerid, 7)) return 1;
	extract get -> new string:params[10]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /findskin [название]");
	new count;
	for(new i; i < sizeof(SkinsStaticData); i++)
	{
		if(strfind(SkinsStaticData[i][scID],params,true) == -1) continue;
		SCMf(playerid, -1, "Скин: %s (ID: %i)", SkinsStaticData[i][scName], SkinsStaticData[i][scID]);
		count++;
	}
	if(!count) SCM(playerid, -1, !"Ничего не найдено!");
	return 1;
}
public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
	//SCMf(playerid, -1, "%i", response);
	if(response == EDIT_RESPONSE_CANCEL)
	{
		new slot = GetPVarInt(playerid, "InstallVehTun");
		if(slot > 0)
		{
			new number = EditObjectToVehicle[playerid];
			CarData[number][cObjectModel][slot-1] = -1;
		}
		player_EditObject_Cancel(playerid);
		return 0;
	}
	else if(response == EDIT_RESPONSE_FINAL)
	{
		new data = GetPVarInt(playerid, "propertyObject_type");
		if(data == 1 || data == 2)
		{
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 15.0, x,y,z))
			{
				player_EditObject_Cancel(playerid);
				return 0;
			}
			new id = GetPVarInt(playerid, "propertyObject_id"),
				model = GetPVarInt(playerid, "propertyObject_model");
			if(data == 1)
			{
				if(player_HouseEntered[playerid] == -1)
				{
					if(DistancePointToPoint(HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], x, y, z) > 15)
					{
						SCM(playerid, COLOR_RED, "Нельзя устанавливать украшения слишком далеко от имущества");
						player_EditObject_Cancel(playerid);
						return 0;
					}
				}
				new slot = -1;
				for(new i; i < 10; i++)
				{
					if(HouseData[id][hObject_Model][i] < 1000)
					{
						slot = i;
						break;
					}
				}
				if(slot != -1)
				{
					if(!InvRemoveEx(playerid, 41, 1, model, -1, "", "Поставил украшение на дом"))
					{
						SCM(playerid, COLOR_RED, "Для того, чтобы поставить украшение, нужно его иметь!");
					}
					else
					{
						//printf("%f %f %f", x, y, z);
						HouseData[id][hObject_Model][slot] = model;
						HouseData[id][hObject_Position_X][slot] = x;
						HouseData[id][hObject_Position_Y][slot] = y;
						HouseData[id][hObject_Position_Z][slot] = z;

						HouseData[id][hObject_Position_rX][slot] = rx;
						HouseData[id][hObject_Position_rY][slot] = ry;
						HouseData[id][hObject_Position_rZ][slot] = rz;

						HouseData[id][hObject_Interior][slot] = GetPlayerInterior(playerid);
						HouseData[id][hObject_VirtualWorld][slot] = GetPlayerVirtualWorld(playerid);
						SaveHouse_Object(id);
						UpdateHouse_Object(id, slot);
					}
				}
				else SCM(playerid, COLOR_RED, "В данном имуществе закончились слоты под объекты!");
			}
			else
			{
				if(player_BizEntered[playerid] == -1)
				{
					if(DistancePointToPoint(BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], x, y, z) > 15)
					{
						SCM(playerid, COLOR_RED, "Нельзя устанавливать украшения слишком далеко от имущества");
						player_EditObject_Cancel(playerid);
						return 0;
					}
				}
				new slot = -1;
				for(new i; i < 10; i++)
				{
					if(BizData[id][bObject_Model][i] < 1000)
					{
						slot = i;
						break;
					}
				}
				if(slot != -1)
				{
					if(!InvRemoveEx(playerid, 41, 1, model, -1, "", "Поставил украшение на бизнес"))
					{
						SCM(playerid, COLOR_RED, "Для того, чтобы поставить украшение, нужно его иметь!");
					}
					else
					{
						//printf("%f %f %f", x, y, z);
						BizData[id][bObject_Model][slot] = model;
						BizData[id][bObject_Position_X][slot] = x;
						BizData[id][bObject_Position_Y][slot] = y;
						BizData[id][bObject_Position_Z][slot] = z;
						//printf("2 %f %f %f", BizData[id][bObject_Position_X][slot], BizData[id][bObject_Position_Y][slot], BizData[id][bObject_Position_Z][slot]);
						BizData[id][bObject_Position_rX][slot] = rx;
						BizData[id][bObject_Position_rY][slot] = ry;
						BizData[id][bObject_Position_rZ][slot] = rz;

						BizData[id][bObject_Interior][slot] = GetPlayerInterior(playerid);
						BizData[id][bObject_VirtualWorld][slot] = GetPlayerVirtualWorld(playerid);
						//printf("3 %f %f %f", BizData[id][bObject_Position_X][slot], BizData[id][bObject_Position_Y][slot], BizData[id][bObject_Position_Z][slot]);
						SaveBiz_Object(id);
						//printf("4 %f %f %f", BizData[id][bObject_Position_X][slot], BizData[id][bObject_Position_Y][slot], BizData[id][bObject_Position_Z][slot]);
						UpdateBiz_Object(id, slot);
						//printf("5 %f %f %f", BizData[id][bObject_Position_X][slot], BizData[id][bObject_Position_Y][slot], BizData[id][bObject_Position_Z][slot]);
					}
				}
				else SCM(playerid, COLOR_RED, "В данном имуществе закончились слоты под объекты!");
			}
			player_EditObject_Cancel(playerid);
		}
		else if(GetPVarInt(playerid, "InstallVehTun"))
		{
			new slot = GetPVarInt(playerid, "InstallVehTun"),
				number = EditObjectToVehicle[playerid];
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 5.0, x,y,z) || !IsValidVehicle(OwnableCar[EditObjectToVehicle[playerid]]))
			{
				player_EditObject_Cancel(playerid);
				CarData[number][cObjectModel][slot-1] = -1;
				return 0;
			}
			if(!InvRemoveEx(playerid, 285, 1, CarData[number][cObjectModel][slot-1], -1, "", "Поставил украшение на транспорт"))
			{
				SCM(playerid, 0x3399FFFF, !"У вас нет предмета который вы хотите одеть на транспорт!");
				player_EditObject_Cancel(playerid);
				CarData[number][cObjectModel][slot-1] = -1;
				return 1;
			}
			new Float:Tx,Float:Ty,Float:Tz,Float:Tr;
			GetVehiclePos(OwnableCar[number],Tx,Ty,Tz);
			GetVehicleZAngle(OwnableCar[number], Tr);
			new 
				Float:ofx = x-Tx, 
				Float:ofy = y-Ty, 
				Float:ofz = z-Tz, 
				Float:ofaz = rz-Tr;

			new Float:finalx = ofx*floatcos(Tr, degrees)+ofy*floatsin(Tr, degrees), 
				Float:finaly = -ofx*floatsin(Tr, degrees)+ofy*floatcos(Tr, degrees);

			if(finalx >= 3.5 || finaly >= 3.5 || ofz >= 3.5)
			{
				finalx = 3.5;
				finaly = 3.5;
			}
			CarData[number][cObjectPos_X][slot-1] = finalx;
			CarData[number][cObjectPos_Y][slot-1] = finaly;
			CarData[number][cObjectPos_Z][slot-1] = ofz;
			CarData[number][cObjectPos_rX][slot-1] = rx;
			CarData[number][cObjectPos_rY][slot-1] = ry;
			CarData[number][cObjectPos_rZ][slot-1] = ofaz;
			UpdateCarObject(number, slot-1);
			Streamer_Update(playerid);
			EditObjectPlayer_Pos[playerid][0] =
			EditObjectPlayer_Pos[playerid][1] =
			EditObjectPlayer_Pos[playerid][2] = 0.0;
			DeletePVar(playerid, "InstallVehTun");
			EditObjectToVehicle[playerid] = -1;
			if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) DestroyDynamicObject(EditObjectPlayer[playerid]);
			EditObjectPlayer[playerid] = INVALID_OBJECT_ID;
			SCM(playerid, 0x3399FFFF, !"Вы установили украшение на свой транспорт");
			SCM(playerid, 0x3399FFFF, !"Чтобы снять украшение используйте интерактивное меню на {ffd700}клавишу R");
			SaveOwnable_Object(number);
		}
		if(GetPVarInt(playerid, "InstallVehStage"))
		{
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 3.0, x,y,z) || !IsValidVehicle(OwnableCar[EditObjectToVehicle[playerid]]))
			{
				player_EditObject_Cancel(playerid);
				return 0;
			}
			new slot = GetPVarInt(playerid, "InstallVehStage")-1,
				number = EditObjectToVehicle[playerid];
			new Float:Tx,Float:Ty,Float:Tz,Float:Tr;
			GetVehiclePos(OwnableCar[number],Tx,Ty,Tz);
			GetVehicleZAngle(OwnableCar[number], Tr);
			new 
				Float:ofx = x-Tx, 
				Float:ofy = y-Ty, 
				Float:ofz = z-Tz, 
				Float:ofaz = rz-Tr;

			new Float:finalx = ofx*floatcos(Tr, degrees)+ofy*floatsin(Tr, degrees), 
				Float:finaly = -ofx*floatsin(Tr, degrees)+ofy*floatcos(Tr, degrees);

			if(finalx >= 3.5 || finaly >= 3.5 || ofz >= 3.5)
			{
				finalx = 3.5;
				finaly = 3.5;
			}
			//
			switch(slot)
			{
				case 0: //радиатор
				{
					CarData[number][cStage_RadPos][0] = finalx;
					CarData[number][cStage_RadPos][1] = finaly;
					CarData[number][cStage_RadPos][2] = ofz;
					CarData[number][cStage_RadPos][3] = rx;
					CarData[number][cStage_RadPos][4] = ry;
					CarData[number][cStage_RadPos][5] = ofaz;
				}
				case 1:
				{
					CarData[number][cStage_ExhPos][0] = finalx;
					CarData[number][cStage_ExhPos][1] = finaly;
					CarData[number][cStage_ExhPos][2] = ofz;
					CarData[number][cStage_ExhPos][3] = rx;
					CarData[number][cStage_ExhPos][4] = ry;
					CarData[number][cStage_ExhPos][5] = ofaz;
				}
				case 2:
				{
					CarData[number][cStage_TurPos][0] = finalx;
					CarData[number][cStage_TurPos][1] = finaly;
					CarData[number][cStage_TurPos][2] = ofz;
					CarData[number][cStage_TurPos][3] = rx;
					CarData[number][cStage_TurPos][4] = ry;
					CarData[number][cStage_TurPos][5] = ofaz;
				}
				case 3:
				{
					CarData[number][cStage_SupPos][0] = finalx;
					CarData[number][cStage_SupPos][1] = finaly;
					CarData[number][cStage_SupPos][2] = ofz;
					CarData[number][cStage_SupPos][3] = rx;
					CarData[number][cStage_SupPos][4] = ry;
					CarData[number][cStage_SupPos][5] = ofaz;
				}
			}
			//
			UpdateCarObject_Stage(number, slot);
			SaveOwnable_StageObject(number, slot);
			Streamer_Update(playerid);
			EditObjectPlayer_Pos[playerid][0] =
			EditObjectPlayer_Pos[playerid][1] =
			EditObjectPlayer_Pos[playerid][2] = 0.0;
			DeletePVar(playerid, "InstallVehStage");
			EditObjectToVehicle[playerid] = -1;
			if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) DestroyDynamicObject(EditObjectPlayer[playerid]);
			EditObjectPlayer[playerid] = INVALID_OBJECT_ID;
		}
		if(GetPVarInt(playerid, "objedit")){
			ObjInfo[ListMap][objPosX] = x;
			ObjInfo[ListMap][objPosY] = y;
			ObjInfo[ListMap][objPosZ] = z;

			ObjInfo[ListMap][objRotX] = rx;
			ObjInfo[ListMap][objRotY] = ry;
			ObjInfo[ListMap][objRotZ] = rz;
			DestroyDynamicObject(ObjInfo[ListMap][objID]);
			ObjInfo[ListMap][objID] = CreateDynamicObject(ObjInfo[ListMap][objModel], ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY], ObjInfo[ListMap][objPosZ], ObjInfo[ListMap][objRotX], ObjInfo[ListMap][objRotY], ObjInfo[ListMap][objRotZ]);
			mysql_tquery(mysql, (str_f("UPDATE `Objects` SET `PosX` = '%.2f', `PosY` = '%.2f', `PosZ` = '%.2f', `RotX` = '%.2f', `RotY` = '%.2f', `RotZ` = '%.2f' WHERE `Name` = '%e' LIMIT 1;", x, y, z, rx, ry, rz, ObjInfo[ListMap][objName])));
			SendAdminsMessagef(0x999999FF, "[A] %s[%i] поменял координаты обьекту [№%i] с параметрами %.2f, %.2f, %.2f, %.2f, %.2f, %.2f", PN(playerid), playerid, ObjInfo[ListMap][objID], x, y, z, rx, ry, rz);
			DeletePVar(playerid, "objedit");
			str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s поменял координаты обьекту [№%i] с параметрами %.2f, %.2f, %.2f, %.2f, %.2f, %.2f", PN(playerid), ObjInfo[ListMap][objID], x, y, z, rx, ry, rz);
			SendLog(1, str_log);
			SCM(playerid, -1, "Готово");	
		}
		if(GetPVarInt(playerid, "obj_edit"))
		{
			SetString(ObjInfo[TOTALOBJECTS][objName], ObjectNamePlayer[playerid]);
			SetString(ObjInfo[TOTALOBJECTS][objCreater], PN(playerid));
			ObjInfo[TOTALOBJECTS][objModel] = GetPVarInt(playerid, "obj_model");

			ObjInfo[TOTALOBJECTS][objPosX] = x;
			ObjInfo[TOTALOBJECTS][objPosY] = y;
			ObjInfo[TOTALOBJECTS][objPosZ] = z;

			ObjInfo[TOTALOBJECTS][objRotX] = rx;
			ObjInfo[TOTALOBJECTS][objRotY] = ry;
			ObjInfo[TOTALOBJECTS][objRotZ] = rz;

			DestroyDynamicObject(EditObjectPlayer[playerid]);
			ObjInfo[TOTALOBJECTS][objID] = CreateDynamicObject(ObjInfo[TOTALOBJECTS][objModel], ObjInfo[TOTALOBJECTS][objPosX], ObjInfo[TOTALOBJECTS][objPosY], ObjInfo[TOTALOBJECTS][objPosZ], ObjInfo[TOTALOBJECTS][objRotX], ObjInfo[TOTALOBJECTS][objRotY], ObjInfo[TOTALOBJECTS][objRotZ]);

			static const mysql_str[] = "INSERT INTO `Objects` (`Name`, `Model`, `PosX`, `PosY`, `PosZ`, `RotX`, `RotY`, `RotZ`, `Creater`) VALUES ('%s', %d, '%f', '%f', '%f', '%f', '%f', '%f', '%s')";
			static str[sizeof(mysql_str) + 30 + 10 + (6 * 6)];

			format(str, sizeof(str), mysql_str,
				ObjInfo[TOTALOBJECTS][objName],
				ObjInfo[TOTALOBJECTS][objModel],
				ObjInfo[TOTALOBJECTS][objPosX],
				ObjInfo[TOTALOBJECTS][objPosY],
				ObjInfo[TOTALOBJECTS][objPosZ],
				ObjInfo[TOTALOBJECTS][objRotX],
				ObjInfo[TOTALOBJECTS][objRotY],
				ObjInfo[TOTALOBJECTS][objRotZ],
				ObjInfo[TOTALOBJECTS][objCreater]);

			SendAdminsMessagef(0x999999FF, "[А] %s[%i] создал обьект [№%i] с параметрами %i, %s", PN(playerid), playerid, ObjInfo[TOTALOBJECTS][objID], ObjInfo[TOTALOBJECTS][objModel], ObjInfo[TOTALOBJECTS][objName]);
			SCM(playerid, -1, "Готово");
			str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s создал обьект [№%i] с параметрами %i, %s", PN(playerid), ObjInfo[TOTALOBJECTS][objID], ObjInfo[TOTALOBJECTS][objModel], ObjInfo[TOTALOBJECTS][objName]);
			SendLog(1, str_log);
			mysql_tquery(mysql, str);
			DeletePVar(playerid, "obj_edit");

			TOTALOBJECTS ++;
		}
	}
	else if(response == EDIT_RESPONSE_UPDATE)
	{
		new data = GetPVarInt(playerid, "propertyObject_type");
		if(data == 1 || data == 2)
		{
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 15.0, x,y,z))
			{
				player_EditObject_Cancel(playerid);
				return 0;
			}
			if(data == 1)
			{

			}
			else
			{
				
			}
		}
		else if(GetPVarInt(playerid, "InstallVehTun"))
		{
			new slot = GetPVarInt(playerid, "InstallVehTun"),
				number = EditObjectToVehicle[playerid];
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 5.0, x,y,z) || !IsValidVehicle(OwnableCar[EditObjectToVehicle[playerid]]))
			{
				player_EditObject_Cancel(playerid);
				CarData[number][cObjectModel][slot-1] = -1;
				return 0;
			}
			new carid = OwnableCar[EditObjectToVehicle[playerid]];
			new Float:Tx,Float:Ty,Float:Tz,Float:Tr, obj = EditObjectPlayer[playerid];
			GetVehiclePos(carid,Tx,Ty,Tz);
			GetVehicleZAngle(carid, Tr);
			new Float: ofx, Float: ofy, Float: ofz, Float: finalx, Float: finaly;
			ofx = x-Tx, ofy = y-Ty, ofz = z-Tz;
			finalx = ofx*floatcos(Tr, degrees)+ofy*floatsin(Tr, degrees), finaly = -ofx*floatsin(Tr, degrees)+ofy*floatcos(Tr, degrees);

			if(finalx >= 3.5 || finaly >= 3.5 || ofz >= 3.5)
			{
				SetDynamicObjectPos(obj, Tx, Ty, Tz);
			}
		}
		else if(GetPVarInt(playerid, "InstallVehStage"))
		{
			if(!IsValidDynamicObject(EditObjectPlayer[playerid]) || !IsPlayerInRangeOfPoint(playerid, 3.0, x,y,z) || !IsValidVehicle(OwnableCar[EditObjectToVehicle[playerid]]))
			{
				player_EditObject_Cancel(playerid);
				return 0;
			}
			new carid = OwnableCar[EditObjectToVehicle[playerid]];
			new Float:Tx,Float:Ty,Float:Tz,Float:Tr, obj = EditObjectPlayer[playerid];
			GetVehiclePos(carid,Tx,Ty,Tz);
			GetVehicleZAngle(carid, Tr);
			new Float: ofx, Float: ofy, Float: ofz, Float: finalx, Float: finaly;
			ofx = x-Tx, ofy = y-Ty, ofz = z-Tz;
			finalx = ofx*floatcos(Tr, degrees)+ofy*floatsin(Tr, degrees), finaly = -ofx*floatsin(Tr, degrees)+ofy*floatcos(Tr, degrees);

			if(finalx >= 2.5 || finaly >= 2.5 || ofz >= 2.5)
			{
				SetDynamicObjectPos(obj, Tx, Ty, Tz);
			}
		}
	}
	return 1;
}
stock LoadObjects()
{
	static Cache: result;
	result = mysql_query(mysql, "SELECT * FROM `Objects` WHERE 1");
	TOTALOBJECTS = cache_num_rows();

    if(TOTALOBJECTS)
    {
    	for(new i; i < TOTALOBJECTS; i++)
    	{
    		cache_get_string(i, "Name", ObjInfo[i][objName]);
			cache_get_int(i, "Model", ObjInfo[i][objModel]);
			cache_get_float(i, "PosX", ObjInfo[i][objPosX]);
			cache_get_float(i, "PosY", ObjInfo[i][objPosY]);
			cache_get_float(i, "PosZ", ObjInfo[i][objPosZ]);
			cache_get_float(i, "RotX", ObjInfo[i][objRotX]);
			cache_get_float(i, "RotY", ObjInfo[i][objRotY]);
			cache_get_float(i, "RotZ", ObjInfo[i][objRotZ]);
			cache_get_string(i, "Creater", ObjInfo[i][objCreater]);

    		ObjInfo[i][objID] = CreateDynamicObject(ObjInfo[i][objModel], ObjInfo[i][objPosX], ObjInfo[i][objPosY], ObjInfo[i][objPosZ], ObjInfo[i][objRotX], ObjInfo[i][objRotY], ObjInfo[i][objRotZ]);
    	}
    	printf("[Objects]: Объектов загружено: %d", TOTALOBJECTS);
    }
	cache_delete(result);
}
stock SaveOwnable_Object(number)
{
	static tun[7][100];
	for(new i; i < 7; i++)
	{
		tun[i][0] = EOS;
	}
	for(new i; i < 9; i++)
	{
		f(tun[0], 100, "%s%i,", tun[0], CarData[number][cObjectModel][i]);
		f(tun[1], 100, "%s%.2f,", tun[1], CarData[number][cObjectPos_X][i]);
		f(tun[2], 100, "%s%.2f,", tun[2], CarData[number][cObjectPos_Y][i]);
		f(tun[3], 100, "%s%.2f,", tun[3], CarData[number][cObjectPos_Z][i]);
		f(tun[4], 100, "%s%.2f,", tun[4], CarData[number][cObjectPos_rX][i]);
		f(tun[5], 100, "%s%.2f,", tun[5], CarData[number][cObjectPos_rY][i]);
		f(tun[6], 100, "%s%.2f,", tun[6], CarData[number][cObjectPos_rZ][i]);
	}
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET \
		`ObjectModel` = '%s', `ObjectPos_X` = '%s', `ObjectPos_Y` = '%s', \
		`ObjectPos_Z` = '%s', `ObjectPos_rX` = '%s', `ObjectPos_rY` = '%s', `ObjectPos_rZ` = '%s' WHERE ID = '%i' LIMIT 1;", \
		tun[0], \
		tun[1], tun[2], tun[3],\
		tun[4], tun[5], tun[6], CarData[number][cID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
stock SaveOwnable_StageObject(number, slot)
{
	switch(slot)
	{
		case 0: //радиатор
		{
			str_1[0] = EOS;
			for(new i; i < 6; i++)
			{
				f(str_1, sizeof(str_1), "%s%.2f,", str_1, CarData[number][cStage_RadPos][i]);
			}
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Stage_RadPos` = '%s' WHERE ID = '%i' LIMIT 1;", \
				str_1, CarData[number][cID]);
			mysql_tquery(mysql, str_q);
		}
		case 1:
		{
			str_1[0] = EOS;
			for(new i; i < 6; i++)
			{
				f(str_1, sizeof(str_1), "%s%.2f,", str_1, CarData[number][cStage_ExhPos][i]);
			}
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Stage_ExhPos` = '%s' WHERE ID = '%i' LIMIT 1;", \
				str_1, CarData[number][cID]);
			mysql_tquery(mysql, str_q);
		}
		case 2:
		{
			str_1[0] = EOS;
			for(new i; i < 6; i++)
			{
				f(str_1, sizeof(str_1), "%s%.2f,", str_1, CarData[number][cStage_TurPos][i]);
			}
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Stage_TurPos` = '%s' WHERE ID = '%i' LIMIT 1;", \
				str_1, CarData[number][cID]);
			mysql_tquery(mysql, str_q);
		}
		case 3:
		{
			str_1[0] = EOS;
			for(new i; i < 6; i++)
			{
				f(str_1, sizeof(str_1), "%s%.2f,", str_1, CarData[number][cStage_SupPos][i]);
			}
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Stage_SupPos` = '%s' WHERE ID = '%i' LIMIT 1;", \
				str_1, CarData[number][cID]);
			mysql_tquery(mysql, str_q);
		}
	}
	return 1;
}
stock UpdateInvCell(playerid)
{
	str_2[0] = EOS, GetInvCellData(playerid);
	str_1[0] = EOS, f(str_1, sizeof(str_1), "interface('InventoryNew').setItems([%s])", str_2);
	ExecutePacket(playerid, webUpdate, str_1);
	return 1;
}
stock ChangeHouseOwner(id, const name[])
{
	//player_addNotif(BizData[id][bOwner], "{ff0000}Изъятие имущества", (str_f("Ваш бизнес №%i, был изъят.\\nКомпенсация была начислена на ваш счет!", id)), "0,10000000,0");
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Дом/Квартира %i, Владелец %s, Новый владелец %s.", id, HouseData[id][hOwner], name);
	SendLog(2, str_log);
	//printf("changehouseowner -> [id: %i] [old: %s] [new: %s]", id, HouseData[id][hOwner], name);
	SetString(HouseData[id][hOwner], name);
	UpdateDataStr("Houses", "Owner", HouseData[id][hOwner], HouseData[id][hID]);

	HouseData[id][hNalog] = global_time+(86400*3);
	UpdateDataInt("Houses", "Nalog", HouseData[id][hNalog], HouseData[id][hID]);
	UpdateHouse(id, false);
	if(HouseData[id][hEntrance_ID] != -1)
	{
		UpdateEntrance(HouseData[id][hEntrance_ID], false);
	}
}
stock ChangeFamilyOwner(id, const name[])
{
	//printf("ChangeFamilyOwner -> [id: %i] [old: %s] [new: %s]", id, FamilyData[id][fOwner], name);
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Семья %s[id: %i, u id: %i], Владелец %s, Новый владелец %s.", FamilyData[id][fName], id, FamilyData[id][fID], FamilyData[id][fOwner], name);
	SendLog(6, str_log);
	SetString(FamilyData[id][fOwner], name);
	UpdateDataStr("Familys", "Owner", FamilyData[id][fOwner], FamilyData[id][fID]);
}
stock EnterPlayerToHouse(playerid, id)
{
	SetPlayerPosEx(playerid, HouseStaticData[HouseData[id][hInterior]][hsExit][0], HouseStaticData[HouseData[id][hInterior]][hsExit][1], HouseStaticData[HouseData[id][hInterior]][hsExit][2], HouseStaticData[HouseData[id][hInterior]][hsExit][3], \
		HouseStaticData[HouseData[id][hInterior]][hsInterior], id+5, false);
	player_HouseEntered[playerid] = id;
	player_EnterHouse[playerid] = -1;
	if(GetString(PN(playerid), HouseData[id][hOwner]))
	{
		
	}
}
stock SellHouse(id)
{
	str_1[0] = EOS;
	for(new i; i < 10; i++)
	{
		HouseData[id][hObject_Model][i] = 0;
		f(str_1, sizeof(str_1), "%s%i,", str_1, HouseData[id][hObject_Model][i]);
		UpdateHouse_Object(id, i);
	}
	UpdateDataStr("Houses", "Object_Model", str_1, HouseData[id][hID]);
	HouseData[id][hLevel] = 0;
	HouseData[id][hLock] = true;
	UpdateDataInt("Houses", "Level", HouseData[id][hLevel], HouseData[id][hID]);
	UpdateDataInt("Houses", "Lock", HouseData[id][hLock], HouseData[id][hID]);
	ChangeHouseOwner(id, "The State");
}
CMD:house(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_house(playerid);
	return 1;
}
alias:house("home")
stock cmd_house(playerid, dialogid=20236)
{
	str_1[0] = EOS;
	str_1 = "{FFFFFF}Номер дома\t{FFFFFF}Расстояние\n";
	new count;
	memset(player_ShowID[playerid], -1);
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(!GetString(HouseData[i][hOwner], PN(playerid))) continue;
		new Float:dist = GetPlayerDistanceFromPoint(playerid, HouseData[i][hEnter][0], HouseData[i][hEnter][1], HouseData[i][hEnter][2]);
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{FFFFFF}%s №%i\t{ffffff}%.2f\n", (HouseData[i][hEntrance_ID] == -1 ? "Дом" : "Квартира"), i, dist);
		strcat(str_1, str_2);
		player_ShowID[playerid][count] = i;
		count++;
	}
	switch(count)
	{
		case 0: SCM(playerid, 0x999999FF, !"У вас не одного дома во владении.");
		case 1: 
		{
			if(dialogid == 20236) ShowPlayerHouseData(playerid, player_ShowID[playerid][0]);
			else SPD(playerid, dialogid, DIALOG_STYLE_TABLIST_HEADERS, "{FFCD00}Выберите дом", str_1, "Выбрать", "Закрыть");
		}
		default: SPD(playerid, dialogid, DIALOG_STYLE_TABLIST_HEADERS, "{FFCD00}Выберите дом", str_1, "Выбрать", "Закрыть");
	}
	return 1;
}
stock ShowPlayerHouseData(playerid, id)
{
	if(!GetString(PN(playerid), HouseData[id][hOwner])) return SCM(playerid, 0x999999FF, !"Это не ваш дом!");
	player_ShowID[playerid][80] = id;
	str_1[0] = EOS, f(str_1, sizeof(str_1), "\
			{FFFFFF}Тип / название:\t\t\t{339999}%s\n\
			{FFFFFF}Номер дома:\t\t\t\t%i\n\
			Город / поселок:\t\t\t[нет данных]\n\
			Район:\t\t\t\t\t[нет данных]\n\
			Стоимость:\t\t\t\t%i руб\n\
			Дом оплачен на:\t\t\t%i/15 дней\n\
			Уровень улучшений:\t\t\t%i\n\
			Модель домашнего авто:\t\t{FF3333}Нет\n\
			{FFFFFF}Квартплата:\t\t\t\t%i руб в день\n\
			Тип квартплаты: Обычная\n\
			Статус:\t\t\t\t\t%s\n\n\
			{669966}Для открытия панели управления вашим домом\n\
			нажмите кнопку Изменить", \
				HouseStaticData[HouseData[id][hInterior]][hsName],\
				id, HouseData[id][hCost], ((HouseData[id][hNalog]-global_time) / 86400), HouseData[id][hLevel],\
				HouseStaticData[HouseData[id][hInterior]][hsNalog],\
				!HouseData[id][hLock] ? ("{CC3333}Дом закрыт") : ("{66CC33}Дом открыт"));
	SPD(playerid, 20237, DIALOG_STYLE_MSGBOX, "{33AACC}Информация о доме", str_1, "Изменить", "Отмена");
	return 1;
}
CMD:sellhouse(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_house(playerid, 20240);
	return 1;
}
alias:sellhouse("sellhome")
CMD:makestore(playerid)
{
	new id = player_HouseEntered[playerid];
	if(id == -1) return SCM(playerid, 0x999999FF, "Вы должны находиться у себя в доме");
	if(!GetString(PN(playerid), HouseData[id][hOwner])) return SCM(playerid, 0x999999FF, "Вы должны находиться у себя в доме");
	if(!IsValidHouse_Store(id)) SCM(playerid, 0x999999FF, "Необходим 4 уровень улучшений для дома");
	else SPD(playerid, 20242, DIALOG_STYLE_MSGBOX, "{FFCD00}Шкаф","{FFFFFF}Вы хотите разместить шкаф в этом месте?", "Да", "Нет");
	return 1;
}
stock IsValidHouse_Store(id)
{
	if(HouseData[id][hLevel] < 4) return 0; //запрещено
	if(HouseData[id][hStore][0] == 0.0) return 1; //разрешено, но не стоит
	if(DistancePointToPoint(\
		HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2], \
		HouseStaticData[HouseData[id][hInterior]][hsExit][0], HouseStaticData[HouseData[id][hInterior]][hsExit][1], HouseStaticData[HouseData[id][hInterior]][hsExit][2]) > 50)
	{
		//разрешено, стоит, но не в этом интерьере
		return 2;
	}
	return 3;
}
stock ShowHouseLevelUP(playerid, id)
{
	if(id != player_HouseEntered[playerid]) return SCM(playerid, COLOR_RED, "Вы должны находиться в доме!");
	str_1[0] = EOS;
	new bool:next;
	for(new i; i < sizeof(House_improvements); i++)
	{
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{CC3344}%i уровень:\t{FFFFFF}%s\t\t", i, House_improvements[i][I_NAME]);
		switch(i)
		{
			case 1,4,5: strcat(str_2, "\t");
			default: strcat(str_2, "\t\t");
		}
		if(HouseData[id][hLevel] < i) 
		{
			if(!next)
			{
				player_ShowID[playerid][i] = 1;
				next = true;
			}
			else player_ShowID[playerid][i] = 2;
			f(str_2, sizeof(str_2), "%s%i руб\n", str_2, House_improvements[i][I_PRICE]);
		}
		else player_ShowID[playerid][i] = 0, f(str_2, sizeof(str_2), "%s{2277AA}Куплено\n", str_2, House_improvements[i][I_PRICE]);
		strcat(str_1, str_2);
	}
	SPD(playerid, 20243, DIALOG_STYLE_LIST, "Улучшение для дома", str_1, "Выбрать", "Назад");
	return 1;
}
stock DistancePointToPoint(Float: x, Float: y, Float: z, Float: fx, Float:fy, Float: fz) return floatround(floatsqroot(floatpower(fx - x, 2) + floatpower(fy - y, 2) + floatpower(fz - z, 2)));
CMD:use(playerid, params[])
{
	new id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
	if(id == -1) return SCM(playerid, 0x999999FF, !"Вы должны находиться у себя в доме!");
	if(id == -2) return SCM(playerid, 0x999999FF, !"Вы не владелец этого дома!");
	if(HouseData[id][hLevel] < 4) return SCM(playerid, 0x999999FF, !"Необходим 4 уровень улучшений для дома");
	if(!IsPlayerInRangeOfPoint(playerid, 3.0, HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2])) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться у своего шкафа");
	OpenInterface[playerid][7] = !OpenInterface[playerid][7];
	OnPlayerInventory(playerid, 1);
	return 1;
}
stock IsPlayerHouseOwner(playerid, id)
{
	if(id == -1) return -1;
	if(HouseData[id][hGang_FamilyID] != -1)
	{
		new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
		if(idEx >= 0)
		{
			if(FamilyData[idEx][fGang_BaseID] == id) 
			{
				return id;
			}
		}
	}
	if(!GetString(PN(playerid), HouseData[id][hOwner])) return -2;
	return id;
}
stock IsPlayerBagUsed(playerid)
{
	for(new i; i < 10; i++)
	{
		if(InventoryAks[playerid][0][i] == 222 && InventoryAks_Used[playerid][i] != false) return 1;
	}
	return 0;
}
CMD:addhouse(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new interior, cost; else return cmd_addhouse(playerid);
	if(interior < 0 || interior >= sizeof(HouseStaticData)) return cmd_addhouse(playerid);
	if(cost < 0 || cost > 2000000000) return cmd_addhouse(playerid);
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] создал дом [№%i, int %i, cost %i]", PN(playerid), playerid, TOTAL_HOUSES, interior, cost);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	GetPlayerFacingAngle(playerid, position[3]);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `Houses` (`Interior`, `Cost`, `Enter`, `VirtualWorld_ID`, `Interior_ID`, `Entrance_ID`, `Entrance_List`) VALUES ('%i', '%i', '%.2f,%.2f,%.2f,%.2f,', '%i', '%i', '%i', '%i');", interior, cost, position[0], position[1], position[2], position[3], GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), player_EntranceEntered[playerid], player_EntranceList[playerid]);
	mysql_tquery(mysql, str_q, "func_AddHouse");
	return 1;
}
public: func_AddHouse()
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `Houses` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadHouseMySQL", "i", 0);
	return 1;
}
stock cmd_addhouse(playerid)
{
	SCM(playerid, 0xCECECEFF, !"Используйте: /addhouse [interior] [cost]");
	str_2 = "ID interior\n";
	for(new i; i < sizeof(HouseStaticData); i++)
	{
		str_1[0] = EOS, f(str_1, sizeof(str_1), "%i - %s\n", i, HouseStaticData[i][hsName]);
		strcat(str_2, str_1);
	}
	SPD(playerid, 0, 0, "addhouse", str_2, "Закрыть", "");
	return 1;
}
CMD:addcar(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new string:name[24], model; else return SCM(playerid, 0xCECECEFF, !"Используйте: /addcar [NickName] [model]");
	if(IsValidCarModel(model) == -1) return SCM(playerid, -1, !"Машина с такой моделью не добавлена на сервер!");
	SendAdminsMessagef(COLOR_RED, "Админ %s[%i] создал машину [NickName: %s, model: %i]", PN(playerid), playerid, name, model);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	position[3] = 180.0;
	CreateOwnableCar(name, model, position, 1, 1);
	return 1;
}
stock CreateOwnableCar(const name[], model, Float:position[], color_0, color_1)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `OwnableCars`(`Owner`, `Model`, `Position`, `Color`) VALUES ('%s', '%i', '%.2f,%.2f,%.2f,%.2f,', '%i,%i')", name, model, position[0], position[1], position[2], position[3], color_0, color_1);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:sellcar(playerid)
{
	return 1;
}
CMD:key(playerid)
{
	new 
		carid = GetPlayerVehicleID(playerid),
		number = GetVehicleID(carid);

	if(carid < 1) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

	if(number == INVALID_VEHICLE_ID) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");
	if(!GetString(CarData[number][cOwner], PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");

	CarData[number][cKeyIN] = !CarData[number][cKeyIN];
	UpdateDataInt("OwnableCars", "KeyIN", CarData[number][cKeyIN], CarData[number][cID]);

	if(!CarData[number][cKeyIN]) //nety
	{
		if(GetVehicleParam(carid, V_ENGINE) == VEHICLE_PARAM_ON)
		{
			SetVehicleParam(carid, V_ENGINE, VEHICLE_PARAM_OFF);
		}
	}
	Action(playerid, (!CarData[number][cKeyIN] ? "вытащил ключ из замка зажигания" : "вставил ключ в замок зажигания"), _, false);
	GameTextForPlayerEx(playerid, (!CarData[number][cKeyIN] ? "~w~Ключ ~r~вытащен" : "~w~Ключ ~g~вставлен"), 4000, 1);
	return 1;
}
CMD:park(playerid)
{
	new 
		carid = GetPlayerVehicleID(playerid),
		number = GetVehicleID(carid);

	if(carid < 1) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

	if(number == INVALID_VEHICLE_ID) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");
	if(!GetString(CarData[number][cOwner], PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");

	new id = player_InGreenZone[playerid];
	if(id != -1)
	{
		if(!gzData[id][gzAllowPark]) return SCM(playerid, 0xCECECEFF, !"В этом месте нельзя парковаться!");
	}
	if(CarData[number][cOwner_Type] == 2)
	{
		new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
		if(idEx >= 0)
		{
			new base_id = FamilyData[idEx][fGang_BaseID];
			if(base_id == -1) return SCM(playerid, 0xCECECEFF, !"Для этого у банды должна быть база");
			if(GetPlayerDistanceFromPoint(playerid, HouseData[base_id][hEnter][0], HouseData[base_id][hEnter][1], HouseData[base_id][hEnter][2]) > 40.0)
			{
				SCM(playerid, COLOR_RED, !"Вы должны быть рядом с базой");
				return 1;
			}
		}
		else
		{
			SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
			return 1;
		}
	}
	emulationPark(playerid, number);
	SCM(playerid, 0x66CC00FF, !"Транспорт припаркован");
	return 1;
}
stock emulationPark(playerid, number)
{
	GetVehiclePos(OwnableCar[number], CarData[number][cPos][0], CarData[number][cPos][1], CarData[number][cPos][2]);
	GetVehicleZAngle(OwnableCar[number], CarData[number][cPos][3]);
	
	CarData[number][cInterior] = GetPlayerInterior(playerid);
	UpdateDataInt("OwnableCars", "Interior", CarData[number][cInterior], CarData[number][cID]);
	
	CarData[number][cVirtualWorld] = GetPlayerVirtualWorld(playerid);
	UpdateDataInt("OwnableCars", "VirtualWorld", CarData[number][cVirtualWorld], CarData[number][cID]);

	str_1[0] = EOS;
	for(new i; i < 4; i++) f(str_1, sizeof(str_1), "%s%.2f,", str_1, CarData[number][cPos][i]);
	UpdateDataStr("OwnableCars", "Position", str_1, CarData[number][cID]);
}
CMD:e(playerid)
{
	new 
		carid = GetPlayerVehicleID(playerid),
		number = GetVehicleID(carid);
	if(carid < 1) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");
	if(IsABike(carid)) return 1;
	if(GetVehicleData(carid, V_FUEL) <= 0.0) return GameTextForPlayerEx(playerid, "~r~нет бензина", 4000, 2);

	if(number == INVALID_VEHICLE_ID)
	{

	}
	else
	{
		//if(!GetString(CarData[number][cOwner], PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");
		if(!CarData[number][cKeyIN]) return GameTextForPlayerEx(playerid, "~r~КЛЮЧИ НЕ ВСТАВЛЕНЫ", 1200, 6);
		UpdateCarData_Sync(number, true);
		if(CarData[number][cWear] > 90)
		{
			GameTextForPlayerEx(playerid, "~r~ДВИГАТЕЛЬ ИЗНОШЕН~n~~r~ЗАВЕСТИ ЕГО НЕ ПОЛУЧИТСЯ", 2000, 3);
			return 1;
		}
	}

	g_vehicle_params[carid][V_ENGINE] = !g_vehicle_params[carid][V_ENGINE];
	SetVehicleParam(carid, V_ENGINE, g_vehicle_params[carid][V_ENGINE]);

	if(GetVehicleParam(carid, V_ENGINE) != VEHICLE_PARAM_OFF)
	{
		//"playSound('sounds/car/start_engine_truck.wav', 0, 1)"
		ExecutePacket(playerid, webUpdate, "playSound('sounds/car/start_engine_car.wav', 0, 1)");
		GameTextForPlayerEx(playerid, "~g~ДВИГАТЕЛЬ ЗАВОДИТСЯ...", 1000, 3);
	}
	return 1;
}
alias:e("engine")
CMD:lock(playerid, const params[])
{
	extract params -> new type; else return SCM(playerid,-825307393, "Используйте: /lock [тип] (1-Личный, 2-Арендованный, 3-Рабочий, 4-Доверенный, 5-Фракционный транспорт)");
	new vehicleid = INVALID_VEHICLE_ID;
	switch(type)
	{
		case 1:
		{
			vehicleid = SearchNearestOwnablePlayer(playerid);
			if(vehicleid == -1) return SCM(playerid, 0x808080FF, "Вы далеко от своего транспорта");
		}
		case 2:
		{
			if(vehicleid == INVALID_VEHICLE_ID) return SCM(playerid, 0x999999FF, !"У Вас нет арендованной машины");
		}
		case 3:
		{
			if(vehicleid == INVALID_VEHICLE_ID)
				return SCM(playerid, 0x999999FF, !"Вы не можете использовать эту функцию");
		}
		case 5:
		{
			new Float:Distance, Float:Distance_ = 100000.0, useid = -1;
			foreach(new i: OWNABLECARS)
			{
				if(VehicleData[i][V_ACTION_TYPE] == 2 && VehicleData[i][V_ACTION_ID] == PI[playerid][pMember_ID])
				{
					static Float:position[3];
					GetVehiclePos(i, position[0], position[1], position[2]);
					Distance = GetPlayerDistanceFromPoint(playerid, position[0], position[1], position[2]);
					if(Distance < Distance_) useid = i, Distance_ = Distance;
				}
			}
			if(useid == -1) return 1;
			vehicleid = useid;
		}
		default: return SCM(playerid, 0xCECECEFF, !"Используйте: /lock [тип] (1-Личный транспорт 2-Арендованная машина 3-Рабочий транспорт 4-Доверенный транспорт)");
	}
	
	static Float:position[3];
	GetVehiclePos(vehicleid, position[0], position[1], position[2]);

	if(IsPlayerInRangeOfPoint(playerid, 5.0, position[0], position[1], position[2]))
	{
		g_vehicle_params[vehicleid][V_LOCK] = !g_vehicle_params[vehicleid][V_LOCK];
		SetVehicleParam(vehicleid, V_LOCK, g_vehicle_params[vehicleid][V_LOCK]);
		ExecutePacket(playerid, webUpdate, (str_f("playSound('sounds/car/key_%s.wav', 0, 1)", (!g_vehicle_params[vehicleid][V_LOCK] ? "unlock" : "lock"))));
		if(type == 1) Action(playerid, !g_vehicle_params[vehicleid][V_LOCK] ? "открыл личный транспорт" : "закрыл личный транспорт", _, true);
		GameTextForPlayerEx(playerid, !g_vehicle_params[vehicleid][V_LOCK] ? "~w~Транспорт ~g~открыт" : "~w~Транспорт ~r~закрыт", 4000, 1);
	}
	else SCM(playerid, 0x999999FF, !"Вы должны стоять рядом с транспортом");
	return 1;
}
CMD:getmycar(playerid)
{
	str_2[0] = EOS;
	new count;
	foreach(new i: OWNABLECARS)
	{
		if(!GetString(CarData[i][cOwner], PN(playerid))) continue;
		new uid = IsValidCarModel(CarData[i][cModel]);
		if(uid != -1)
		{
			player_ShowID[playerid][count] = i;
			str_1[0] = EOS, f(str_1, sizeof(str_1), "\
							{FFFFFF}- %s (%i)\n", VehicleStaticData[uid][vsName], CarData[i][cModel]);
			strcat(str_2, str_1);
			count++;
		}
	}
	if(!count) SCM(playerid, 0x999999FF, !"Ваш личный транспорт не загружен на сервер");
	else SPD(playerid, 20249, DIALOG_STYLE_LIST,"{FFCD00}Выберите транспорт",str_2,"Выбрать","Закрыть");
	return 1;
}
///i — заправить автомобиль.
///ic — заправить электрический автомобиль.
///washing — помыть автомобиль на автомойке.
///alarm — включить/выключить сигнализацию.
///l — включить/выключить фары.
///cm_price — изменить цену на автомобиль (на БУ рынке).
///cm_test_drive — предложить тест драйв (на БУ рынке).
///carmusic — меню сабвуфера.
stock GetVehicleShiftPos(vehicleid, style, &Float:x, &Float:y, &Float:z, Float:distance)
{
    static Float:a;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);
	switch(style)
	{
	    case 0:
	    {
	        x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
	    }
	    case 1:
		{
		    x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		case 2:
	    {
	        a += 90.0;
	        x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
	    }
	    case 3:
		{
		    a -= 90.0;
      		x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		default: return 0;
	}
	return 1;
}
