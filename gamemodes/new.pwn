stock SendMessageInChat(playerid, text[], Float: radius = 30.0)
{
	static Float: x, Float: y, Float: z;

	GetPlayerPos(playerid, x, y, z);
	SetPlayerChatBubble(playerid, text, 0x00CCFFFF, 30.0, 8000);
	if(!IsPlayerDriver(playerid))
	{
		if(GetPlayerData(playerid, pTemp_AnimType) == USE_ANIM_TYPE_NONE)
		{
			ApplyAnimation(playerid, "PED", "IDLE_chat", 4.100, 0, 1, 1, 1, 1, 0);
			SetTimerEx("ClearPlayerChatAnim", strlen(text) * 400, false, "i", playerid);
		}
	}
	new team_id;
	if(PI[playerid][pMember_ID] > 0 && PI[playerid][pMember_Duty] != false) team_id = PI[playerid][pMember_ID];
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s- %s {%s}(%s)[%i]", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{FFFFFF} " : ""), text, FractionStaticData[team_id][frColor], PN(playerid), playerid);
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(FamilyData[id][fGang] != false)
		{
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s- %s {%s}(%s)[%i]", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{FFFFFF} " : ""), text, FamilyColorData[FamilyData[id][fColor]], PN(playerid), playerid);
		}
	}
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerLogged(i) || !IsPlayerInRangeOfPoint(i, radius, x, y, z)) continue;
		SCM(i, -1, str_mes);
	}
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Игрок %s написал в чат: \"%s\"", str_log, text);
	SendLog(8, str_log);
	return 1;
}
