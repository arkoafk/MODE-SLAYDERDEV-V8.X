CMD:addgz(playerid, get[])
{
	//if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new allow, string:name[24], radius; else return cmd_addgz(playerid);
	if(allow > 1 || allow < 0) return cmd_addgz(playerid);
	if(radius < 20 || radius > 500) return cmd_addgz(playerid);
	str_1[0] = EOS, mysql_escape_string(name, str_1);
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] создал зеленую зону [id: %i, name: %s, парковка: %s]", PN(playerid), playerid, TOTAL_GREENZONES, str_1, allow == 1 ? "разрешена" : "запрещена");
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	GetPlayerFacingAngle(playerid, position[3]);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `GreenZones` (`Position`, `Name`, `AllowPark`, `Radius`) VALUES ('%.2f,%.2f,%.2f,%.2f,','%s','%i','%i.0')", position[0], position[1], position[2], position[3], str_1, allow, radius);
	mysql_tquery(mysql, str_q, "func_AddGZ");
	return 1;
}
public: func_AddGZ()
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `GreenZones` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadGreenZoneMySQL", "i", 0);
	return 1;
}
stock cmd_addgz(playerid)
{
	SCM(playerid, 0xCECECEFF, !"Используйте: /addgz [isallowpark(0/1)] [name] [radius(20-500)]");
	return 1;
}
new
	player_LastWeapID[MAX_PLAYERS char],
	player_LastHitTicks[MAX_PLAYERS];
public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	//SCMf(playerid, -1, "%i %i", playerid, weaponid);
	OnPlayerInventory_WeaponShot(playerid, weaponid);
	if(!IsPlayerWeaponShot(playerid, weaponid, hittype, hitid, fX, fY, fZ)) return 0;
	if(hittype == BULLET_HIT_TYPE_PLAYER)
	{
		if(IsPlayerStreamedIn(playerid, hitid))
		{
			if(!OnPlayerDamage(playerid, hitid, weaponid, true)) return 0;
		}
	}
	/*else if(hittype == BULLET_HIT_TYPE_VEHICLE)
	{
		if(IsVehicleStreamedIn(playerid, hitid))
		{
			//if(!OnPlayerDamage(playerid, hitid, weaponid, true)) return 0;
			GetVehicleHealth(vehicleid, &Float:health);
		}
	}*/
	player_LastWeapID{playerid} = weaponid;
	player_LastHitTicks[playerid] = GetTickCount();
	return 1;
}
stock IsPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	if(hittype==BULLET_HIT_TYPE_PLAYER)
	{
		if(fX>=10 || fY>=10 || fZ>=10 || fX<=-10 || fY<=-10 || fZ<=-10) return 0;
		new Float:x, Float:y, Float:z;
		GetPlayerPos(playerid, x, y, z);

		if (GetPlayerDistanceFromPoint(hitid, x, y, z) > s_WeaponRange[weaponid] + 2.0) 
		{
			return 0;
		}
	}
	new
		Float: GUARD_START_X,
		Float: GUARD_START_Y,
		Float: GUARD_START_Z,
		Float: GUARD_POS_NONE;

	GetPlayerLastShotVectors(playerid, GUARD_START_X, GUARD_START_Y, GUARD_START_Z, GUARD_POS_NONE, GUARD_POS_NONE, GUARD_POS_NONE);
			
	if(!IsPlayerInRangeOfPoint(playerid, 8.0, GUARD_START_X, GUARD_START_Y, GUARD_START_Z))
	{
		KickWithCode(playerid, 4, (str_f("packet: %i, type: %i", 0, 0)));
		return 0;
	}
	if(player_LastWeapID{playerid} == weaponid)
	{
		//SCMf(playerid, -1, "%i %i = %i", GetTickCount()-player_LastHitTicks[playerid], s_MaxWeaponShootRate[weaponid], s_MaxWeaponShootRate[weaponid] - (GetTickCount()-player_LastHitTicks[playerid]));
		if (s_MaxWeaponShootRate[weaponid] - (GetTickCount()-player_LastHitTicks[playerid]) > 20)
		{
			return 0;
		}
	}
	return 1;
}
stock OnPlayerDamage(playerid, issuerid, weaponid, bool:type)
{
	//playerid наносит урон
	//issuerid получает урон
	if(issuerid != INVALID_PLAYER_ID)
	{
		if(player_GoodMode{issuerid} != false && PI[issuerid][pAdmin] > 0)
		{
			SCM(playerid, -1, "Данный администратор включил режима бога, урон не засчитан.");
			return 0;
		}
		//if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_Duty] != false)
		if(PI[playerid][pMember_ID] != 2 && PI[playerid][pMember_Duty] != true)
		{
			new id = player_InGreenZone[issuerid];
			if(id != -1)
			{
				if(gzData[id][gzStatus] == true)
				{
					ApplyAnimation(playerid, "ped", "handscower", 3.0, 0, 0, 0, 0, 0, 1);
					SetPlayerArmedWeapon(playerid, 0);
					TogglePlayerControllable(playerid, false);
					SetTimerEx("player_UnFreeze", 2000, false, "i", playerid);
					return 0;
				}
			}
		}
		if(!PI[issuerid][pTemp_Stun])
		{
			if(PI[playerid][pMember_Duty] != false)
			{
				if(PI[playerid][pMember_ID] == 2 || PI[playerid][pMember_ID] == 8)
				{
					if(weaponid == 3 || weaponid == 23)
					{
						RemovePlayerFromVehicle(issuerid);
						ApplyAnimation(issuerid, "CRACK", "crckdeth2", 4.0999999046326, 128, 0, 0, 0, 0, 1);
						TogglePlayerControllable(issuerid, false);
						PI[issuerid][pTemp_Stun] = true;
						SetTimerEx("player_UnFreeze", 15000, false, "i", issuerid);
						SCMf(playerid, 0x3399FFFF, "Вы оглушили %s на 15 секунд", PN(issuerid));
						SCMf(issuerid, 0x3399FFFF, "%s оглушил Вас на 15 секунд", PN(playerid));
						return 0;
					}
				}
			}
		}
		if(s_DamageType[weaponid] == type)
		{
			new Float:amount = s_WeaponDamage[weaponid];
			//init damage
			OnPlayerDamage_SetData(playerid, issuerid, weaponid, amount);

			OnPlayerViability_Damage(issuerid, amount);
		}
	}
	//SCMf(playerid, -1, "%i, %f, %i, %i, %i", playerid, Float:amount, issuerid, WEAPON:weapon, bodypart);
	return 1;
}
stock OnPlayerDamage_SetData(playerid, issuerid, weaponid, Float:amount)
{
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "-%.2f HP по %s", amount, PN(issuerid));
	SetPlayerChatBubble(playerid, str_mes, -155188993, 15.0, 3000);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "-%.2f HP от %s", amount, PN(playerid));
	SetPlayerChatBubble(issuerid, str_mes, -159186689, 15.0, 3000);
	player_GetDamage_TargetID[issuerid] = playerid;
	player_GetDamage_WeaponID{issuerid} = weaponid;
	player_GetDamage_Tick{issuerid} = 0;
}
stock OnPlayerViability_Set(playerid)
{
	if(PI[playerid][pHealth] < 1)
	{
		PI[playerid][pHealth] = 15.0;
		PI[playerid][pArmour] = 0.0;
		SetPlayerHealth(playerid, 0.0); //sends to death 
	}
	else OnPlayerViability_Update(playerid);
}
stock OnPlayerViability_Damage(issuerid, Float:amount)
{
	new Float:arm = PI[issuerid][pArmour];

	if(arm > 0.0)
	{
		if(amount > PI[issuerid][pArmour])
		{
			PI[issuerid][pHealth] = (PI[issuerid][pHealth] - (amount - PI[issuerid][pArmour]));
			PI[issuerid][pArmour] = 0.0;
			OnPlayerViability_Set(issuerid);
		}
		else
		{
			PI[issuerid][pArmour] -= amount;
			OnPlayerViability_Set(issuerid);
		}
	}
	else
	{
		PI[issuerid][pHealth] -= amount;
		OnPlayerViability_Set(issuerid);
	}
}
stock OnPlayerViability_Update(playerid)
{
	SetPlayerArmour(playerid, PI[playerid][pArmour]);
	SetPlayerHealth(playerid, PI[playerid][pHealth]);
}
public OnPlayerTakeDamage(playerid, issuerid, Float:amount, weaponid, bodypart)
{
	player_GetDamage_TargetID[playerid] = issuerid;
	player_GetDamage_WeaponID{playerid} = weaponid;
	if(issuerid == INVALID_PLAYER_ID)
	{
		OnPlayerViability_Damage(playerid, amount);
	}
	else
	{
		//наносит урон issuerid
		//получает урон playerid
		OnPlayerDamage(issuerid, playerid, weaponid, GetPlayerState(playerid) != PLAYER_STATE_ONFOOT ? true : false);
	}
	return 1;
}
stock player_SettingsGZ(playerid)
{
	if(PI[playerid][pAdmin] < 8) return callcmd::apanel(playerid);
	str_1[0] = EOS;
	str_1 = "№\tНаименование\tРадиус\tРасстояние от вас\n";
	for(new i; i < TOTAL_GREENZONES; i++)
	{
		strcat(str_1, (str_f("%s%i\t%s\t%.2f\t%.2f\n", \
			(gzData[i][gzStatus] != false ? "{FFFFFF}" : "{999999}"), i+1, gzData[i][gzName], gzData[i][gzRadius],\
			GetPlayerDistanceFromPoint(playerid, gzData[i][gzPosition][0], gzData[i][gzPosition][1], gzData[i][gzPosition][2]))));
	}
	SPD(playerid, 20303, DIALOG_STYLE_TABLIST_HEADERS, "Настройка GZ", str_1, "Выбрать", "Назад");
	return 1;
}
CMD:eatall(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	new Float:ps;

	if(sscanf(params, "f", ps)) SCM(playerid, COLOR_GREY, "Используйте: /eatall [радиус]");

	if(ps < 20 || ps > 200) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 200");

	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, ps, pos[0], pos[1], pos[2])) continue;
		SetPlayerHunger(i, 100.0);
		SCMf(i, COLOR_WHITE, "Администратор %s изменил Вам уровень голода", PN(playerid));
	}

	SCM(playerid, COLOR_WHITE, !"Вы успешно изменили голод игрокам в радиусе");

	return 1;
}
CMD:ban(playerid, get[])
{
	extract get -> new id, days, string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /ban [id игрока] [срок в дняй] [причина]");

	if(!IsPlayerConnected(id) || !IsPlayerLogged(id)) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");

	new max_days = PI[playerid][pAdmin] > 6 ? 365 : 30;

	if(!(1 <= days <= max_days)) return SCMf(playerid, 0xCECECEFF, "Срок бана может быть от 1 до %i дней", max_days);
	if(NameIsFullDostup(PN(id))) return SCM(playerid, COLOR_RED, "С данным игроком нельзя взаимодействовать!");
	if(PI[id][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, "Нельзя забанить администратора выше по рангу");
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "Администратор %s забанил игрока %s на %i дней", PN(playerid), PN(id), days);
	if(strlen(reason) > 0) f(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);
	if(!strlen(reason)) reason = "none";
	player_addAList(PN(id), "Бан", PN(playerid), reason);
	AddBan_List(PN(id), PN(playerid), reason, days);
	Kick(id);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminBan_ForDay`=`adminBan_ForDay`+1, `adminBan`=`adminBan`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:sban(playerid, get[])
{
	extract get -> new id, days, string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /ban [id игрока] [срок в дняй] [причина]");

	if(!IsPlayerConnected(id) || !IsPlayerLogged(id)) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");

	new max_days = PI[playerid][pAdmin] > 6 ? 365 : 30;

	if(!(1 <= days <= max_days)) return SCMf(playerid, 0xCECECEFF, "Срок бана может быть от 1 до %i дней", max_days);

	if(PI[id][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, !"Нельзя забанить администратора выше по рангу");
    str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[A] %s [%i] забанил игрока %s без лишнего шума. Причина: %s", PN(playerid), playerid, PN(id), reason);
	SendAdminsMessage(COLOR_GREY, str_mes);

	AddBan_List(PN(id), PN(playerid), reason, days);
	Kick(id);
	return 1;
}
CMD:unban(playerid, get[])
{
	extract get -> new string:name[24], string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /unban [name] [причина]");

	str_1[0] = EOS, mysql_escape_string(name, str_1);
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "[A] %s разбанил игрока %s. Причина: %s", PN(playerid), str_1, reason);
	SendAdminsMessage(COLOR_GREY, str_mes);

	mysql_tqueryf(mysql, "DELETE FROM `Ban_List` WHERE `Owner` = '%s'", str_1);
	return 1;
}
stock AddBan_List(owner[], const admin[], reason[], days)
{
	str_mes[0] = EOS, mysql_escape_string(owner, str_mes);
	str_format[0] = EOS, mysql_escape_string(reason, str_format);
	mysql_tqueryf(mysql, "INSERT INTO `Ban_List`(\
				`Owner`, `Admin`, `Reason`, `timeout`,`timeban`) VALUES (\
					'%s','%s','%s','%i','%i')", str_mes, admin, str_format, global_time+(days*86400), global_time);
	
	//str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	str_log[0] = EOS;
	f(str_log, sizeof(str_log), "Админ %s заблокировал игрока %s на %i дней. Причина: %s", str_log, admin, owner, days, reason);
	SendLog(0, str_log);
}
