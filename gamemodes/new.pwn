stock IsBusinessOwned(id)
{
	if(GetString(BizData[id][bOwner], "The State")) return 0;
	return 1;
}
stock IsHouseOwned(id)
{
	if(GetString(HouseData[id][hOwner], "The State")) return 0;
	return 1;
}
stock IsStallOwned(id)
{
	if(GetString(StallData[id][sOwner], "The State")) return 0;
	return 1;
}
stock IsGarageOwned(id)
{
	if(GetString(GarageData[id][gOwner], "The State")) return 0;
	return 1;
}
