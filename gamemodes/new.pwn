stock Float:abs_float(Float:value) return value = -value;
stock player_Casino_SetChipPos(playerid, const name[])
{
	if(player_Casino_Type{playerid} != 1 || player_UpdateCasino[playerid] != -1) return 0;
	new uid = -1;
	for(new i; i < sizeof(CasinoRoll_Chips); i++)
	{
		if(!GetString(CasinoRoll_Chips[i][crName], name))
		{
			continue;
		}
		uid = i;
		break;
	}
	if(uid != -1)
	{
		player_Casino_Position{playerid} = uid;
		new 
			id = player_Casino_ID{playerid},
			Float:x = CasinoRoulette[id][prPos][0], 
			Float:y = CasinoRoulette[id][prPos][1];
		if(CasinoRoulette[id][prPos][3] == -180.0)
		{
			x += CasinoRoll_Chips[uid][crPos][0];
			y += CasinoRoll_Chips[uid][crPos][1];
		}
		else if(CasinoRoulette[id][prPos][3] == -90.0)
		{
			x -= CasinoRoll_Chips[uid][crPos][1];
			y += CasinoRoll_Chips[uid][crPos][0];
		}
		else
		{
			x -= CasinoRoll_Chips[uid][crPos][0];
			y -= CasinoRoll_Chips[uid][crPos][1];
		}
		//update object
		if(player_TempObject[playerid] == -1)
		{
			player_TempObject[playerid] = CreatePlayerObject(playerid, 10889, x, y, CasinoRoulette[id][prPos][2], 0.0, 0.0, 0.0, 100.0);
		}
		else
		{
			SetPlayerObjectPos(playerid, player_TempObject[playerid], x, y, CasinoRoulette[id][prPos][2]);
		}
	}
	return 1;
}
new object_CasinoRoulette[sizeof(CasinoRoulette)];
stock LoadCasino()
{
	CreateInteractionMenu("[[39,\"Обменять фишки\"]]", 222.16400146484, -324.17440795898, 1011.015625, 2.0, interMenu_CasinoExchange, 0, -1, 5);
	CreateDynamic3DTextLabel("{FFBE5C}Кассир{FFFFFF}\nПодойдите для обмена фишек", -1, 222.16400146484, -324.17440795898, 1011.015625, 5);
	CreateDynamic3DTextLabel("Меню бара:\n\n{6699FF}1. Пиво\n2. Вино\n3. Водка\n4. Коньяк\n5. Виски\n{00CC66}6. Закуска\n7. Сигара", -52, 215.60600280762, -301.75009155273, 1012.671875, 9);
	CreateDynamic3DTextLabel("{E7D63E}Информация\n{FFFFFF}Кости", 13408767, 204.17269897461, -290.7532043457, 1011.715637207, 9.5);
	CreatePickup(1239, 23, 204.17269897461, -290.7532043457, 1010.715637207, -1, pickupDice_Data);
	for(new i; i < sizeof(CasinoMachine); i++)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{E7D63E}Игровые автоматы\n\
			{FFFFFF}Размер ставки: {E7D63E}%i {FFFFFF}фишек", CasinoMachine[i][pmSizeLimit]);
		CreateDynamic3DTextLabel(str_mes, -1, CasinoMachine[i][pmPos][0], CasinoMachine[i][pmPos][1], 1010.8600463867, 5.0);
		CreateInteractionMenu("[[10,\"Играть в автомат\"]]", CasinoMachine[i][pmPos][0], CasinoMachine[i][pmPos][1], 1012.1699829102, 1.5, interMenu_CasinoAuto, i, -1, 5);
	}
	for(new i; i < sizeof(CasinoRoulette); i++)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Игра в рулетку\n\
			{FFFFFF}Максимальная ставка: %i фишек", CasinoRoulette[i][prSizeLimit]);
		CreateDynamic3DTextLabel(str_mes, -405389569, CasinoRoulette[i][prPos][0], CasinoRoulette[i][prPos][1], CasinoRoulette[i][prPos][2]+1.099975586, 3.0);
		CreateInteractionMenu("[[10,\"Играть в рулетку\"]]", CasinoRoulette[i][prPos][0], CasinoRoulette[i][prPos][1], CasinoRoulette[i][prPos][2]+1.099975586, 2.5, interMenu_CasinoRoulette, i, -1, 5);
		object_CasinoRoulette[i] = CreateDynamicObject(10879, CasinoRoulette[i][prPos][0], CasinoRoulette[i][prPos][1], CasinoRoulette[i][prPos][2]-0.4000273242, 0.000000, 0.000000, CasinoRoulette[i][prPos][3], -1, 5, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD); // 0
	}
	for(new i; i < sizeof(Casino_Dice); i++)
	{
		CreateDynamic3DTextLabel("{E7D63E}Игра в кости\n{FFFFFF}Свободно", -54984449, Casino_Dice[i][0], Casino_Dice[i][1], 1011.8900146484, 5.0);
		CreateInteractionMenu("[[9,\"Играть в кости\"]]", Casino_Dice[i][0], Casino_Dice[i][1], 1011.8900146484, 2.5, interMenu_CasinoDice, i, -1, 5);
	}
}
