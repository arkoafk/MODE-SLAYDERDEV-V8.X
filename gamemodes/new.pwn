stock GenVehicleNumber(vehicleid, type)
{
	static const 
			chars[] = {'A','B','E','K','M','X','O','P','C','H','T','Y'};
	VehicleData[vehicleid][vNumber_Type] = type;
	SetString(VehicleData[vehicleid][vNumber_String], "eos");
	f(VehicleData[vehicleid][vNumber_String], 30, "%c%c%c%c%c%c %i", chars[random(sizeof chars)], random('9' - '0') + '0', random('9' - '0') + '0', random('9' - '0') + '0', chars[random(sizeof chars)], chars[random(sizeof chars)], 70);
	//f(VehicleData[vehicleid][vNumber_String], 15, "%s 52", VehicleData[vehicleid][vNumber_String]);
	//printf("%s", VehicleData[vehicleid][vNumber_String]);
}
stock IsValidNumber(const number[], const region[], type)
{
	//number
	if(region[0] == '0' || number[0] == '0') return 0;
	new Regex:regex, data;
	if(strlen(number) > 0)
	{
		switch(type)
		{
			case 1,6,7,8: //russia
			{
				regex = Regex_New("^[ABEKMXOPCHTY]{1}[0-9]{3}[ABEKMXOPCHTY]{2}$");
				//printf("test 2");
			}
			case 2: //kz
			{
				regex = Regex_New("^[0-9]{3}[ABDEKMXOPCHTY]{3}$");
			}
			case 3: //br
			{
				regex = Regex_New("^\\d{4}$");
			}
			case 4: //uk
			{
				regex = Regex_New("^\\d{4}$");
			}
			case 5:
			{
				regex = Regex_New("^[A-Z0-9]{1,6}$");
			}
			default: return 0;
		}
		data = Regex_Check(number, regex); //ex
		//printf("data 1 [%i]", data);
		if(!data) 
		{
			Regex_Delete(regex);
			return 0;
		}
		Regex_Delete(regex);
	}
	//region
	if(strlen(region) > 0)
	{
		switch(type)
		{
			case 1,6,7,8: //russia
			{
				regex = Regex_New("^[0-9]+$");
			}
			case 2: //kz
			{
				regex = Regex_New("^[0-9]+$");
			}
			case 3: //br
			{
				regex = Regex_New("^[ABEKMXOPCHTY]{2}-[0-9]{1}$");
				//ba-1
			}
			case 4: //uk
			{
				regex = Regex_New("^[ABEKMXOPCHTY]{4}$");
			}
			case 5:
			{
				//Regex_Delete(regex);
				return 1;
			}
			default: return 0;
		}
		data = Regex_Check(region, regex);
		//printf("data 2 [%i]", data);
		if(!data) 
		{
			Regex_Delete(regex);
			return 0;
		}
		Regex_Delete(regex);
	}
	return data;
}
stock player_Case_Open(playerid, type){
	if(GetPlayerState(playerid) != 1) return SCM(playerid,-825307393, "Кейсы нельзя использовать в транспорте");
	if(type < 0 || type > sizeof(CaseStaticData)-1) return 0;
	OpenInterface[playerid][42] = false;
	player_Case_Type{playerid} = type;
	str_2[0] = EOS;
	new bool:firstItem = true;
	for(new i; i < 25; i++){
		if(strlen(ItemsCaseData[type][i][icName]) < 2) continue;
		new size = 3;
		switch(ItemsCaseData[type][i][icType]){
			case 3: size = 3;
			case 4: size = 4;
			case 1: size = 6;
			case 2: size = 7;
		}
		if(!firstItem) strcat(str_2, ",");
		else firstItem = false;
		strcat(str_2, (str_f("[%i,%i,\"%s\",%i]", ItemsCaseData[type][i][icColor], i, ItemsCaseData[type][i][icName], size)));
	}
	new expiryTime = 3600;
	str_1[0] = EOS;
	strcat(str_1, (str_f("[%i,\"%s\",%i,%i,%i,%i,%i,%i,[%s]]", type, CaseStaticData[type][csName], CaseStaticData[type][csCost], player_Case_FastOpen{playerid}, GetInvCount(playerid, 259) > 0 ? 1 : 0, expiryTime, GetInvCount(playerid, CaseStaticData[type][csItemUID]), GetInvCount(playerid, 259), str_2)));
	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	ExecutePacket(playerid, webOpen, "Case", str_1);
	return true;
}
stock player_Case_Close(playerid, params_0)
{
	if(!OpenInterface[playerid][43]) return 0;
	OpenInterface[playerid][42] = false;
	OpenInterface[playerid][43] = false;
	new type = player_Case_Type{playerid};
	if(type == 255) return 0;
	if(!params_0) GivePlayerMoneyEx(playerid, ItemsCaseData[type][player_Case_Present[playerid]][icCost], "Кейсы");
	else
	{
		SCMf(playerid, 0x6495EDFF, "Вы успешно открыли {ffffff}кейс '%s' {6495ED}и получили {ffffff}'%s'", CaseStaticData[type][csName], ItemsCaseData[type][player_Case_Present[playerid]][icName]);
		SCM(playerid, 0x6495EDFF, !"Приз был добавлен в ваши награды {ffffff}(Меню -> мои награды)");
		mysql_tqueryf(mysql, "INSERT INTO `player_PresentCases` \
			(`pID`, `Type`, `UID`) VALUES ('%i','%i','%i')", PI[playerid][pID], type, player_Case_Present[playerid]);
	}
	player_DestroyCaseObject(playerid);
	ExecutePacket(playerid, webClose, "CaseResult");
	player_Case_Open(playerid, player_Case_Type{playerid});
	player_Case_Present[playerid] = 0;
	SetCameraBehindPlayer(playerid);
	return 1;
}
stock player_Case_Update(playerid, params_1)
{
	if(player_UpdateEx_2[playerid] != -1) return 0;
	OpenInterface[playerid][7] = false;
	OnPlayerInventory(playerid, 0);
	player_DestroyCaseObject(playerid);
	OpenInterface[playerid][42] = false;
	ExecutePacket(playerid, webClose, "Case");
	new type = player_Case_Type{playerid};
	if(type != 255)
	{
		if(!GetInvCount(playerid, 259)) //если ключи есть
		{
			SCM(playerid, 0xCECECEFF, !"* У вас нет ключа для открытия кейса");
			if(PI[playerid][pCash_Donate] < CaseStaticData[type][csCost]) //если есть донат
			{
				GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
				SCM(playerid, 0x6495EDFF, !"* Недостаточно средств для открытия кейса");
				return 1;
			}
		}
		if(!InvRemoveEx(playerid, CaseStaticData[type][csItemUID], 1, -1, -1, "", "Открытие кейсов(inventory)"))
		{
			SCM(playerid, 0xCECECEFF, "* У вас недостаточно кейсов");
			return 1;
		}
		//
		if(!GetInvCount(playerid, 259)) //если ключи есть
		{
			GivePlayerDonate(playerid, -CaseStaticData[type][csCost]);
		}
		else
		{
			InvRemoveEx(playerid, 259, 1, -1, -1, "", "Открытие кейсов(inventory)");
		}
		//
		new randPresent = player_Case_ItemRandom(playerid);
		player_Case_FastOpen{playerid} = bool:params_1;
		if(!params_1) //!fast case
		{
			static
				Float:X,
				Float:Y,
				Float:Z,
				Float:angle;
			GetPlayerPos(playerid, X, Y, Z);
			GetPlayerFacingAngle(playerid, angle);

			new 
				Float: case_x = X + (1.4 * floatsin(-angle, degrees)),
				Float: case_y = Y + (1.4 * floatcos(-angle, degrees)),
				Float: cam_x = X + (1.3 * floatsin(-angle + 90.0, degrees)),
				Float: cam_y = Y + (1.3 * floatcos(-angle + 90.0, degrees)),
				Float: cam_z = Z + 0.3;
			
			ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, false, 0, 0, 0, 0);
			ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.0, false, 0, 0, 0, 0);
			new itemInside_Model = -1;
			/*
				0 - прочее
				1 - акс
				2 - випка
				3 - машина
				4 - скины
				5 - деньги
			*/
			switch(ItemsCaseData[type][randPresent][icType])
			{
				case 1:
				{
					itemInside_Model = ItemsCaseData[type][randPresent][icModel];
				}
				case 2,3: itemInside_Model = 14535;
				case 4: itemInside_Model = 10816;
				default: itemInside_Model = 15313;
			}
			//itemInside[ItemsCaseData[type][randPresent][icType]]
			player_Case_ObjectID[playerid][2] = CreateDynamicObject(itemInside_Model, case_x, case_y, Z-0.8, 0.0, 0.0, angle);
			player_Case_ObjectID[playerid][1] = CreateDynamicObject(CaseStaticData[type][csBonnetID], case_x, case_y, Z-0.8 + (!CaseStaticData[type][csSetForBonnet] ? 0.0 : 0.2), 0.0, 0.0, angle);
			player_Case_ObjectID[playerid][0] = CreateDynamicObject(CaseStaticData[type][csCaseID], case_x, case_y, Z-0.8, 0.0, 0.0, angle);
			Streamer_Update(playerid);
			InterpolateCameraPos(playerid, cam_x, cam_y, cam_z, X + (0.95 * floatsin(-angle, degrees)), Y + (0.95 * floatcos(-angle, degrees)), Z + 0.2, 5000, CAMERA_MOVE);
			InterpolateCameraLookAt(playerid, X + (0.5 * floatsin(-angle, degrees)), Y + (0.5 * floatcos(-angle, degrees)), Z - 0.5, case_x, case_y, Z - 0.85, 5000, CAMERA_MOVE);
			//InterpolateCameraPos(playerid, cam_x, cam_y, cam_z, X + (0.65 * floatsin(-angle, degrees)), Y + (0.65 * floatcos(-angle, degrees)), Z - 0.1, 5000, CAMERA_MOVE);
			//InterpolateCameraLookAt(playerid, X + (0.5 * floatsin(-angle, degrees)), Y + (0.5 * floatcos(-angle, degrees)), Z - 0.5, case_x, case_y, Z - 0.85, 5000, CAMERA_MOVE);

			ExecutePacket(playerid, webClose, "CaseResult");
			if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
			player_UpdateEx_2[playerid] = SetTimerEx("player_Case_Opened", 6000, false, "i", playerid);
		}
		else player_Case_PresentRandom(playerid);
	}
	return 1;
}
public: player_Case_Opened(playerid)
{
    new Float:X,
		Float:Y,
		Float:Z,
		Float:angle;

	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, angle);
	new Float: case_x = X + (1.2 * floatsin(-angle, degrees)),
	Float: case_y = Y + (1.2 * floatcos(-angle, degrees));
	MoveDynamicObject(player_Case_ObjectID[playerid][1], case_x, case_y, Z-0.700000000000000001, 0.2, -75.00000000, 0, angle);
	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	player_UpdateEx_2[playerid] = SetTimerEx("player_Case_PresentRandom", 1000, false, "i", playerid);
	return 1;
}
stock player_Case_ItemRandom(playerid)
{
	new type = player_Case_Type{playerid},
		slot;
	for(new i; i < 25; i++)
	{
		if(ItemsCaseData[type][i][icModel] < 2) continue;
		slot = i;
	}
	new arraySlot[25];
	for(new i; i < slot; i++)
	{
		arraySlot[i] = ItemsCaseData[type][i][icChance];
	}
	player_Case_Present[playerid] = randomfear(arraySlot, slot);
	if(ItemsCaseData[type][player_Case_Present[playerid]][icHide] != false && random(100) > 50) player_Case_Present[playerid] = random(3);
	return player_Case_Present[playerid];
}
stock randomfear(const array[], size_w = sizeof(array)) 
{ 
    if(size_w < 1) return 0;
    for(new i = size_w - 1; i > -1; i--)
    {
        if(random(1300) <= array[i]) return i;
    }
    return 0;
} 
public: player_Case_PresentRandom(playerid)
{
	if(OpenInterface[playerid][43]) return 1;
	new type = player_Case_Type{playerid},
		randPresent = player_Case_Present[playerid];

	OpenInterface[playerid][43] = true;
	ExecutePacket(playerid, webOpen, "CaseResult", (str_f("\
		[%i,\"%s\",\"%s\",%i,%i,%i,[], 0]", \
			ItemsCaseData[type][randPresent][icCost], ItemsCaseData[type][randPresent][icName], CaseStaticData[type][csName],\
			ItemsCaseData[type][randPresent][icColor], randPresent, type)));
	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	return 1;
}
/*
	propertySlots
		0 => house
		1 => biz
		2 => garage
		3 => car
		4 => kiosk
*/
stock player_HouseSlotsCount(playerid)
{
	new count = 1 + PI[playerid][pPropertySlots][0] + PI[playerid][pLevel_VIP],
		countGarages = GetPlayerGarages(playerid);

	if(countGarages > 1) countGarages = 1;
	count += countGarages;
	return count;
}
stock player_BusinessSlotsCount(playerid)
{
	new count = 1 + PI[playerid][pPropertySlots][1] + PI[playerid][pLevel_VIP];
	return count;
}
stock player_GarageSlotsCount(playerid)
{
	new count = 1 + PI[playerid][pPropertySlots][2] + PI[playerid][pLevel_VIP];
	return count;
}
stock player_StallSlotsCount(playerid)
{
	new count = 1 + PI[playerid][pPropertySlots][4];
	return count;
}
stock player_CarSlotsCount(playerid)
{
	new count = 2 + PI[playerid][pPropertySlots][3] + PI[playerid][pLevel_VIP],
		countHouse = GetPlayerHouses(playerid);
		//countGarage = GetPlayerGarages(playerid);
	
	if(countHouse > 1) countHouse = 1;
	count += countHouse;
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(!GetString(GarageData[i][gOwner], PN(playerid))) continue;
		count += GarageStaticData[GarageData[i][gInterior]][gsCarLimit];
		if(count > 20)
		{
			break;
		}
	}
	//if(countGarage > 10) countGarage = 10;
	//count += countGarage;
	return count;
}
CMD:vr(playerid, get[])
{
	if(!PI[playerid][pLevel_VIP]) return SCM(playerid, 0xFF6600FF, !"Вы не владеете уникальным VIP");
	if(PI[playerid][pVMuteTime] > 0) return SCM(playerid, COLOR_RED, "У вас имеется блокировка VIP чата, посмотреть оставшееся время /time");
	if(!(player_AntiFlood[playerid][13]-global_time > 0))
	{
		player_AntiFlood[playerid][13] = global_time+7;
		if(strlen(get) > 100 || strlen(get) < 1) return SCM(playerid, 0xCECECEFF, !"Используйте: /vr [текст]");
		if(IsPlayerMuted(playerid)) return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");
		str_mes[0] = EOS;
		if(!PI[playerid][pAdmin])
		{
			f(str_mes, sizeof(str_mes), "{5cc480}[Игрок] %s[%i]: %s", \
					PN(playerid), playerid, get);
		}
		else
		{
			f(str_mes, sizeof(str_mes), "{5cc480}[%s] %s[%i]: %s", \
					(PI[playerid][pAdmin] == 1 ? "Support" : "Администратор"), PN(playerid), playerid, get);
		}
		//SendClientMessageToAll(color, const message[])
		str_1[0] = EOS, f(str_1, sizeof(str_1), "0x%sFF", VIP_Data[PI[playerid][pLevel_VIP]][vColor]);
		SCMAll(HexStr(str_1), str_mes);
	}
	else SCM(playerid, -1, "Можно раз в 15 секунд!");
	return 1;
}
alias:vr("vipchat")
CMD:sms(playerid, get[])
{
	if(IsPlayerMuted(playerid)) return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");
	extract get -> new number, string:text[144]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /sms [номер телефна] [сообщение]");
	if(!PI[playerid][pPhone_Number]) return SCM(playerid, 0x999999FF, !"У Вас нет телефона. Его можно купить в сотовом салоне");
	if(number < 100 || number > 999999) return SCM(playerid,-1717986817, !"Данный номер не обслуживается");
	if(PI[playerid][pPhone_Cash] > 4)
	{
		foreach(new i: Player)
		{
			if(PI[i][pPhone_Number] == number)
			{
				SCMf(playerid, -65281, "SMS: %s | Получатель: %s [т.%i] {btn:0:0:%i} {btn:1:0:%i}", text, PN(i), number, number, number);
				SCMf(i, -65281, "SMS: %s | Отправитель: %s [т.%i] {btn:0:0:%i} {btn:1:0:%i}", text, PN(playerid), PI[playerid][pPhone_Number], PI[playerid][pPhone_Number], PI[playerid][pPhone_Number]);
				GameTextForPlayerEx(playerid, "SMS ~n~~y~-5 рублей", 4000, 2);
				PI[playerid][pPhone_Cash] -= 5;
				UpdatePlayerDataInt(playerid, "Phone_Cash", PI[playerid][pPhone_Cash]);
				SetPlayerChatBubble(playerid, "SMS >>", 0xffff00FF, 15.0, 1500);
				SetPlayerChatBubble(i, "SMS <<", 0xffff00FF, 15.0, 1500);
				return 1;
			}
		}
		SCM(playerid,-1717986817, !"Данный номер не обслуживается (Игрок не в сети или такого номера нет!)");
	}
	else
	{
		SCM(playerid, 0xCECECEFF, !"На счету недостаточно средств");
		SCM(playerid, 0xCECECEFF, !"Пополнить мобильный телефон можно в любом банкомате");
	}
	return 1;
}
CMD:findhouse(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /fh [номер дома]");
	if(id < 0 || id > TOTAL_HOUSES-1) return SCM(playerid, 0xCECECEFF, !"Данного дома не существует на сервере");
	//if(player_Cash[playerid] < 50000) return SCM(playerid, 0xCECECEFF, !"Для того чтобы поставить метку дома, нужно иметь 50000 руб.");
	if(CompareInt64(playerid, "<", 50000)) return SCM(playerid, 0xCECECEFF, !"Для того чтобы поставить метку дома, нужно иметь 50000 руб.");
	GivePlayerMoneyEx(playerid, -50000, "/findhouse");
	GiveBusinessMoney(playerid, player_SearchBiz(playerid, 29), 30000, -1);
	EnablePlayerGPS(playerid, 56, HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2],"Место отмечено у Вас на GPS");
	return 1;
}
alias:findhouse("fh","findhome")

