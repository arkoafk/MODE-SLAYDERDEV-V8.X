stock OnPlayerTintingParams(playerid, const params[])
{
	if(!OpenInterface[playerid][17]) return 1;
	new carid = GetPlayerVehicleID(playerid), glass[9];
	if(carid < 1) return 1;
	//printf("OnPlayerTintingParams -> [%s]", params);
	sscanf(params, "P<,,|,,|,,>a<i>[9]",glass);
	//SCMf(playerid, -1, "params 1.%i 2.%i 3.%i 4.%i 5.%i 6.%i 7.%i 8.%i 9.%i", glass[0], glass[1], glass[2], glass[3], glass[4], glass[5], glass[6], glass[7], glass[8]);
	new id;
	for(new i; i < 3; i++)
	{
		id = i*3;
		if(!glass[id]) SetTintingParams(carid, i, -1, -1);
		else
		{
			SetTintingParams(carid, i, glass[id+1], glass[id+2]);
			player_ShowID[playerid][6] = (i+1)*5000000;
			str_1[0] = EOS, f(str_1, sizeof str_1, "interface('TintingOrder').getPrice(%i)",player_ShowID[playerid][6]);
			ExecutePacket(playerid, webUpdate, str_1);
		}
	}
	UpdateVehicleTinting(carid, playerid);
	return 1;
}
stock SetTintingParams(vehicleid, select, color, percent)
{
	VehicleTinted[vehicleid][0][select] = color;
	VehicleTinted[vehicleid][1][select] = percent*3-30;
}
stock OnPlayerTuningTinting(playerid, buttons)
{
	if(!OpenInterface[playerid][17]) return 1;
	new 
		vehicleid = GetPlayerVehicleID(playerid),
		number = GetVehicleID(vehicleid);
	if(number == INVALID_VEHICLE_ID) return 0;
	switch(buttons)
	{
		case 1: //покупка тонера
		{
			SPD(playerid, 20431, 0, "{F6B600}Установка тонировки", (str_f("{C5C5C6}Вы хотите приобрести выбранную тонировку за {EDAC00}%i руб{C5C5C6}?", player_ShowID[playerid][6])), "Да","Отмена");
		}
	    case 2: //снять тонер
		{
			SPD(playerid, 20432, 0, "{F6B600}Снятие тонировки", "{C5C5C6}Вы хотите снять старую тонировку за {EDAC00}5000000 руб{C5C5C6}?", "Да","Отмена");
		}
	    case 3:
		{
			for(new i; i < 3; i++) 
			{
				VehicleTinted[vehicleid][0][i] = CarTinted[number][0][i];
				VehicleTinted[vehicleid][1][i] = CarTinted[number][1][i];
			}
			TogglePlayerControllable(playerid, true);
			SetCameraBehindPlayer(playerid);
			player_TintingMenu_Hide(playerid);
			UpdateVehicleTinting(vehicleid, playerid);
	    }
	}
	return 1;
}
stock IsVehicleDrifting(vehicleid)
{
	new Float:direction, Float:driftAngle, Float:angle, speed;
	GetVehicleVelocity(vehicleid, direction, driftAngle, angle);
	speed = floatround(136.0*((direction*direction)+(driftAngle*driftAngle)));
	direction = atan2(driftAngle, angle);
	GetVehicleZAngle(vehicleid, angle);
	direction -= 10.0;
	if(direction < 0) direction += 360.0;
	driftAngle = angle - floatabs(direction);
	if(driftAngle > 270.0) driftAngle -= 270.0;
	if(driftAngle < -270.0) driftAngle += 270.0;
	driftAngle = floatabs(driftAngle);
	if(12.0 < driftAngle < 60.0 && speed > 30) return 1;
	return 0;
}
