public: LoadEntrance()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++)
	{
		stat = LoadEntranceMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[Entrance]: Подъездов загружено -> %i", TOTAL_ENTRANCE);
	else printf("[Entrance]: UNKNOWN ( all stat -> %i)", TOTAL_ENTRANCE);

	CreateDynamic3DTextLabel("- Лифт -", 0x3399FFFF, 2768.9192, 1700.8345, 998.5250, 8.0000);
	CreatePickup(19134, 23, 2768.9192, 1700.8345, 997.5250, -1);
	
	CreateDynamic3DTextLabel("- Лифт -", 0x3399FFFF, 2778.1733, 1700.8654, 998.5250, 8.0000);
	CreatePickup(19134, 23, 2778.1733, 1700.8654, 997.5250, -1);

	CreateInteractionMenu("[[7,\"Взаимодействовать\"]]", 2768.9192, 1700.8345, 997.5250, 2.0, interMenu_Entrance_List, 0, -1, 5);
	CreateInteractionMenu("[[7,\"Взаимодействовать\"]]", 2778.1733, 1700.8654, 997.5250, 2.0, interMenu_Entrance_List, 0, -1, 5);

	//
	CreateDynamic3DTextLabel("- Лифт -", 0x3399FFFF, 3022.9468, 1700.9133, 998.5250, 8.0000);
	CreatePickup(19134, 23, 3022.9468, 1700.9133, 997.5250, -1);

	CreateDynamic3DTextLabel("- Лифт -", 0x3399FFFF, 3031.8955, 1700.7266, 998.5250, 8.0000);
	CreatePickup(19134, 23, 3031.8955, 1700.7266, 997.5250, -1);

	CreateInteractionMenu("[[7,\"Взаимодействовать\"]]", 3022.9468, 1700.9133, 997.5250, 2.0, interMenu_Entrance_List, 0, -1, 5);
	CreateInteractionMenu("[[7,\"Взаимодействовать\"]]", 3031.8955, 1700.7266, 997.5250, 2.0, interMenu_Entrance_List, 0, -1, 5);

	//
	CreatePickup(1318, 23, 2773.5068, 1694.6337, 997.5322, -1);
	Entrance_EnterStatic[1] = CreateDynamicSphere(2773.5068, 1694.6337, 997.5322, 1.4, -1, 5);
	
	//
	//
	return 1;
}
public: LoadEntranceMySQL(id)
{
	cache_get_int(id, "ID", EntranceData[TOTAL_ENTRANCE][ehID]);
	cache_get_string(id, !"Enter", str_2), sscanf(str_2, "p<,>a<f>[4]", EntranceData[TOTAL_ENTRANCE][ehEnter]);
	cache_get_int(id, "Type", EntranceData[TOTAL_ENTRANCE][ehType]);
	//
	UpdateEntrance(TOTAL_ENTRANCE, true);
	TOTAL_ENTRANCE++;
	return 1;
}
stock UpdateEntrance(id, bool:set)
{
	//delete old data
	//Text3D:Entrance_EnterLabel[MAX_ENTHOUSE] = {Text3D:-1, ...},
	//Entrance_EnterPickup[MAX_ENTHOUSE] = {-1, ...},
	//Entrance_EnterMapIcon[MAX_ENTHOUSE] = {-1, ...};
	if(IsValidDynamicMapIcon(Entrance_EnterMapIcon[id]) || Entrance_EnterMapIcon[id] != -1) DestroyDynamicMapIcon(Entrance_EnterMapIcon[id]), Entrance_EnterMapIcon[id] = -1;
	Entrance_EnterMapIcon[id] = CreateDynamicMapIcon(EntranceData[id][ehEnter][0], EntranceData[id][ehEnter][1], EntranceData[id][ehEnter][2], (IsEntranceOwned(id) > 0 ? 31 : 32), 0, -1, -1, -1, 100.0);
	if(set != false)
	{
		if(IsValidDynamicPickup(Entrance_EnterPickup[id]) && Entrance_EnterPickup[id] != -1) DestroyDynamicPickup(Entrance_EnterPickup[id]), Entrance_EnterPickup[id] = -1;
		if(IsValidDynamicArea(Entrance_EnterArea[id]) && Entrance_EnterArea[id] != -1) DestroyDynamicArea(Entrance_EnterArea[id]), Entrance_EnterArea[id] = -1;
		if(IsValidDynamic3DTextLabel(Entrance_EnterLabel[id]) && Entrance_EnterLabel[id] != Text3D:-1) DestroyDynamic3DTextLabel(Entrance_EnterLabel[id]), Entrance_EnterLabel[id] = Text3D:-1;
		
		//create
		Entrance_EnterPickup[id] = CreateDynamicPickup(1272, 64, EntranceData[id][ehEnter][0], EntranceData[id][ehEnter][1], EntranceData[id][ehEnter][2]);
		Entrance_EnterArea[id] = CreateDynamicSphere(EntranceData[id][ehEnter][0], EntranceData[id][ehEnter][1], EntranceData[id][ehEnter][2], 1.4, 0, 0);
		Entrance_EnterLabel[id] = CreateDynamic3DTextLabel((str_f("- Подъезд -\n{FFFFFF}Номер подъезда: %i", id)), 0x3399FFFF, EntranceData[id][ehEnter][0], EntranceData[id][ehEnter][1], EntranceData[id][ehEnter][2]+1.0, 15.0000);
	}
	return 1;
}
