public OnPlayerPickUpDynamicPickup(playerid, pickupid)
{
	if(player_AntiFlood[playerid][20]-global_time > 0) return 0;
	player_AntiFlood[playerid][20] = global_time+2;
	SCMD(playerid, "OnPlayerPickUpDynamicPickup -> (1, i)");
	if(!IsPlayerLogged(playerid)) return 1;
	SCMD(playerid, "OnPlayerPickUpDynamicPickup -> (2, i)");
	if(!OpenInterface[playerid][7])
	{
		for(new i; i < TOTAL_HOUSES; i++)
		{
			if(HouseData[i][hGang_FamilyID] == -1) continue;
			if(House_StorePickup[i] == pickupid)
			{
				new id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
				if(id == -1) return SCM(playerid, 0x999999FF, !"Вы должны находиться у себя в доме!");
				if(id == -2) return SCM(playerid, 0x999999FF, !"Вы не владелец этого дома!");
				if(HouseData[id][hLevel] < 4) return SCM(playerid, 0x999999FF, !"Необходим 4 уровень улучшений для дома");
				if(!IsPlayerInRangeOfPoint(playerid, 3.0, HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2])) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться у своего шкафа");
				
				OpenInterface[playerid][7] = true;
				OnPlayerInventory(playerid, 1);
			}
		}
	}
	for(new i; i < sizeof(HouseStaticData); i++)
	{
		if(House_HealthPickup[i] == pickupid)
		{
			new id = player_HouseEntered[playerid];
			if(id != -1)
			{
				if(HouseData[id][hLevel] > 0)
				{
					GameTextForPlayerEx(playerid, "~w~Вы успешно вылечились", 3000, 2);
					PI[playerid][pHealth] = 100;
					SetPlayerHealth(playerid, 100.0);
				}
			}
		}
	}
	return 1;
}
#define IsValidPickupID(%0)			(0 <= %0 < MAX_PICKUPS)
public OnPlayerPickUpPickup(playerid, pickupid)
{
	if(g_pickup_flood[playerid] <= GetTickCount())
	{
		g_pickup_flood[playerid] = GetTickCount() + 2500;

		new 
			action_type = PICKUP_ACTION_TYPE_NONE, 
			action_id = PICKUP_ACTION_ID_NONE;
		if(IsValidPickupID(pickupid))
		{
			action_type = GetPickupInfo(pickupid, P_ACTION_TYPE);
			action_id = GetPickupInfo(pickupid, P_ACTION_ID);
		}
		//SCMD(playerid, "OnPlayerPickUpDynamicPickup -> (3, i)");
		return OnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id);
	}
	return 1;
}
public OnGameModeExit()
{
	mysql_close();
	return 1;
}
