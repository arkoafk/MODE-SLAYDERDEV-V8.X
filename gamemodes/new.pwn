stock player_CasinoDice_Update(playerid)
{
	new id = player_Casino_ID{playerid};
	if(id != 255)
	{
		str_1[0] = EOS;
		if(CasinoDice_Data[id][cdicePlayers] > 0)
		{
			new bool:count;
			foreach(new i: cDice_Players[id])
			{
				if(!IsPlayerLogged(i)) continue;
				if(!count) count = true;
				else strcat(str_1, ",");
				strcat(str_1, (str_f("\"%s\"", PN(i))));
			}
			f(str_1, sizeof(str_1), "%i,%i,0,%i,0,[%s]", CasinoDice_Data[id][cdiceType], CasinoDice_Data[id][cdiceRate], CasinoDice_Data[id][cdicePlayers], str_1);
		}
		ExecutePacket(playerid, webUpdate, (str_f("interface('CasinoDice').updateListGame('[[%s]]')", str_1)));
		//SCMf(playerid, -1, "%i", CasinoDice_Data[id][cdicePlayers]);
	}
	return 1;
}
stock player_CasinoDice_Create(playerid, type, rate, players)
{
	/*
		type - тип игры обычная/профи
		rate - ставка
		players - количество игроков
	*/
	new id = player_Casino_ID{playerid};
	if(id != 255)
	{
		if(rate < 1 || rate > 1000) return SCM(playerid, -111665921, !"Ошибка: {FFFFFF}Ставка должна быть в диапозоне от 1 до 1 000 фишек");
		if(CasinoDice_Data[id][cdicePlayers] != 0)
		{
			SPD(playerid, 0, 0, "{FFCD00}Информация", "{FFFFFF}На данный момент нельзя создать новый запрос", "Закрыть");
			return 1;
		}
		//SCMf(playerid, -1, "%i %i", GetInvCount(playerid, 293), rate);
		if(GetInvCount(playerid, 293) < rate)
		{
			SPD(playerid, 0, 0, "{FFCD00}Подсказка", "{FFFFFF}У вас недостаточно фишек для такой ставки", "Закрыть");
			return 1;
		}
		if(CasinoDice_Data[id][cdiceStart] != false) return SCM(playerid, -825307393, !"* Игра уже началась. Дождитесь окончания");
		ExecutePacket(playerid, webUpdate, "interface('CasinoDice').closeModalCreateQueries()");
		CasinoDice_Data[id][cdiceType] = type;
		CasinoDice_Data[id][cdiceRate] = rate;
		CasinoDice_Data[id][cdicePlayers] = players;
		CasinoDice_Data[id][cdiceTimeOut] = 12;
		CasinoDice_Data[id][cdiceStart] = false;
		CasinoDice_PlayerConnect(playerid);
	}
	return 1;
}
stock CasinoDice_PlayerConnect(playerid)
{
	new id = player_Casino_ID{playerid};
	//SCMf(playerid, -1, "1 -> %i %i", id, CasinoDice_Data[id][cdicePlayers]);
	if(id != 255 || CasinoDice_Data[id][cdicePlayers] != 0)
	{
		//SCMf(playerid, -1, "2 -> %i %i", id, CasinoDice_Data[id][cdicePlayers]);
		if(CasinoDice_Data[id][cdiceStart] != false) return 0; //игра уже начата
		if(GetInvCount(playerid, 293) < CasinoDice_Data[id][cdiceRate])
		{
			SPD(playerid, 0, 0, "{FFCD00}Подсказка", "{FFFFFF}У вас недостаточно фишек для такой ставки", "Закрыть");
			return 1;
		}
		new count;
		foreach(new i: cDice_Players[id])
		{
			if(!IsPlayerLogged(i)) continue;
			if(i == playerid)
			{
				return 1;
			}
			count++;
		}
		Iter_Add(cDice_Players[id], playerid);
		foreach(new i: PlayerPlayersStream[playerid])
		{
			if(player_Casino_Type{i} != 2 || player_Casino_ID{i} != player_Casino_ID{playerid}) continue;
			player_CasinoDice_Update(i);
		}
		player_CasinoDice_RandomOne{playerid} = 0;
		player_CasinoDice_RandomTwo{playerid} = 0;
		if(count+1 >= CasinoDice_Data[id][cdicePlayers]) CasinoDice_Start(id);
	}
	return 1;
}
stock CasinoDice_Start(id)
{
	if(CasinoDice_Data[id][cdiceStart]) return 0;
	CasinoDice_Data[id][cdiceBalance] = 0;
	str_1[0] = EOS;
	str_while[0] = EOS;
	new count;
	foreach(new i: cDice_Players[id])
	{
		if(!IsPlayerLogged(i)) continue;
		str_while[count] = i;
		count++;
	}
	new bool:closeDice;
	for(new j; j < count; j++)
	{
		new i = str_while[j];
		if(GetInvCount(i, 293) < CasinoDice_Data[id][cdiceRate])
		{
			CasinoDice_PlayerDisconnect(i);
			SCM(i, COLOR_ORANGE, !"У вас недостаточно фишек для ставки.");
			closeDice = true;
			continue;
		}
	}
	if(!closeDice)
	{
		for(new j; j < count; j++)
		{
			new i = str_while[j];
			InvRemoveEx(i, 293, CasinoDice_Data[id][cdiceRate], -1, -1, "", "Вход в игру /dice");
			CasinoDice_Data[id][cdiceBalance] += CasinoDice_Data[id][cdiceRate];
			player_CasinoDice_RandomOne{i} = 0;
			player_CasinoDice_RandomTwo{i} = 0;
			ExecutePacket(i, webUpdate, "interface('CasinoDice').windows.queries = false");
			ExecutePacket(i, webUpdate, "interface('CasinoDice').windows.game = true");
			//ExecutePacket(i, webUpdate, "interface('CasinoDice').startGameTimer()");
		}
		CasinoDice_Data[id][cdiceStart] = true;
		CasinoDice_Data[id][cdiceTimeOut] = 12;
		//CasinoDice_Data[id][cdiceBalance] = 0;
		CasinoDice_UpdateGame(id);
	}
	return 1;
}
stock CasinoDice_UpdateGame(id)
{
	if(!CasinoDice_Data[id][cdiceStart]) return 0;
	str_1[0] = EOS;
	new bool:count,
		PlayersCount,
		PlayersCountEx;
	foreach(new i: cDice_Players[id])
	{
		if(!IsPlayerLogged(i)) continue;
		if(!count) count = true;
		else strcat(str_1, ",");
		strcat(str_1, (str_f("[\"%s\", %i, %i]", PN(i), player_CasinoDice_RandomOne{i}+player_CasinoDice_RandomTwo{i}, CasinoDice_Data[id][cdiceRate])));
		if(player_CasinoDice_RandomOne{i} != 0) PlayersCountEx++;
		PlayersCount++;
	}
	foreach(new i: cDice_Players[id])
	{
		if(!IsPlayerLogged(i)) continue;
		ExecutePacket(i, webUpdate, (str_f("interface('CasinoDice').updateGame('[%i,%i,0,%i,%i,%i,[%s]]')",\
			CasinoDice_Data[id][cdiceType], CasinoDice_Data[id][cdiceBalance], player_CasinoDice_RandomOne{i}, player_CasinoDice_RandomTwo{i}, CasinoDice_Data[id][cdiceTimeOut], str_1)));
	}
	if(PlayersCountEx == PlayersCount)
	{
		CasinoDice_DefineWinner(id);
	}
	return 1;
}
stock CasinoDice_DefineWinner(id)
{
	new higher = -1;
	foreach(new i: cDice_Players[id]) //определяем самое большое число
	{
		if(!IsPlayerLogged(i)) continue;
		if(higher < (player_CasinoDice_RandomOne{i}+player_CasinoDice_RandomTwo{i})) higher = (player_CasinoDice_RandomOne{i}+player_CasinoDice_RandomTwo{i});
	}
	new playersDefine[5], count;
	foreach(new i: cDice_Players[id]) //кикаем всех тех, у кого число меньше higher
	{
		if(!IsPlayerLogged(i)) continue;
		if(higher > (player_CasinoDice_RandomOne{i}+player_CasinoDice_RandomTwo{i})) 
		{
			playersDefine[count] = i;
			count++;
		}
	}
	for(new i; i < count; i++)
	{
		SCMf(playersDefine[i], -4374017, "Уведомление:{FFFFFF} К сожалению, Вы {FF8B1D}проиграли. {FFFFFF}Вам выпало {FF6833}%i", player_CasinoDice_RandomOne{playersDefine[i]}+player_CasinoDice_RandomTwo{playersDefine[i]});
		player_CasinoDice_Close(playersDefine[i]);
	}
	count = 0;
	foreach(new i: cDice_Players[id]) //определяем сколько игроков
	{
		if(!IsPlayerLogged(i)) continue;
		playersDefine[count] = i;
		count++;
	}
	if(count > 1)
	{
		for(new i; i < count; i++)
		{
			if(!IsPlayerLogged(playersDefine[i])) continue;
			player_CasinoDice_RandomOne{playersDefine[i]} = 0;
			player_CasinoDice_RandomTwo{playersDefine[i]} = 0;
			SCM(playersDefine[i], -4374017, "Уведомление:{FFFFFF} Игра закончилась ничьей, перекидывайте кости!");
		}
		CasinoDice_Data[id][cdiceTimeOut] = 12;
		CasinoDice_UpdateGame(id);
	}
	else if(count == 1)
	{
		for(new i; i < count; i++)
		{
			if(!IsPlayerLogged(playersDefine[i])) continue;
			CasinoDice_Winner(playersDefine[i]);
			break;
		}
	}
	return 1;
}
stock CasinoDice_PlayerDisconnect(playerid)
{
	if(player_Casino_Type{playerid} == 2)
	{
		new id = player_Casino_ID{playerid};
		if(id != 255)
		{
			static next;
			next = playerid;
			if(Iter_SafeRemove(cDice_Players[id], next, next) == 1)
			{
				new count;
				foreach(new i: cDice_Players[id])
				{
					if(!IsPlayerConnected(i)) continue;
					if(!IsPlayerLogged(i)) continue;
					count++;
				}
				if(!count)
				{
					CasinoDice_Clear(id);
				}
				else if(count == 1 && CasinoDice_Data[id][cdiceStart] != false)
				{
					//этот чел вин
					foreach(new i: cDice_Players[id])
					{
						if(!IsPlayerConnected(i)) continue;
						if(!IsPlayerLogged(i)) continue;
						CasinoDice_Winner(i);
						break;
					}
				}
				foreach(new i: PlayerPlayersStream[playerid])
				{
					if(!IsPlayerConnected(i)) continue;
					if(player_Casino_Type{i} != 2 || player_Casino_ID{i} != player_Casino_ID{playerid}) continue;
					player_CasinoDice_Update(i);
				}
			}
		}
	}
	return 1;
}
stock CasinoDice_Winner(playerid)
{
	if(player_Casino_Type{playerid} == 2)
	{
		new id = player_Casino_ID{playerid};
		if(id != 255)
		{
			SCM(playerid, -4374017, "Уведомление:{FFFFFF} Поздравляем, Вы {83F05D}выиграли");
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "~g~+%i фишек", CasinoDice_Data[id][cdiceBalance]);
			GameTextForPlayerEx(playerid, str_mes, 4000, 2);
			InvAdd(playerid, 293, CasinoDice_Data[id][cdiceBalance], "", 0, 0, "", "выиграл в казино /dice");
			player_CasinoDice_Close(playerid);
			CasinoDice_Clear(id);
		}
		return 1;
	}
	return 0;
}
stock player_CasinoDice_Load(playerid)
{
	new id = player_Casino_ID{playerid};
	if(id != 255)
	{
		if(CasinoDice_Data[id][cdicePlayers] != 0)
		{
			SPD(playerid, 0, 0, "{FFCD00}Информация", "{FFFFFF}На данный момент нельзя создать новый запрос", "Закрыть");
			return 1;
		}
		ExecutePacket(playerid, webUpdate, "interface('CasinoDice').toggleModal(\"createGame\", true)");
	}
	return 1;
}
stock player_CasinoDice_Close(playerid)
{
	//ExecutePacket(playerid, webClose, "CasinoDice");
	CasinoDice_PlayerDisconnect(playerid);
	//player_Casino_Type{playerid} = 255;
	return 1;
}
stock player_CasinoRoulSetBet(playerid, count)
{
	if(player_UpdateCasino[playerid] != -1) return 1;
	new id = player_Casino_ID{playerid};
	if(id != 255)
	{
		if(count < 10 || count > CasinoRoulette[id][prSizeLimit])
		{
			SCMf(playerid,-2127958, "Сумма ставки должна быть от 10 до %i фишек.", CasinoRoulette[id][prSizeLimit]);
			return 1;
		}

		new position = player_Casino_Position{playerid},
			countEx = GetInvCount(playerid, 293);
		if(position != 255)
		{
			if(countEx < count) return SCM(playerid,-2127958, "У вас нет столько фишек.");
			SCMf(playerid,-1412567126, "Вы успешно сделали ставку на сектор {FFFFFF}\"%s\" {ABCDEF}в размере {FFFFFF}%i {ABCDEF}фишек.", CasinoRoll_Chips[position][crName], count);
			SCM(playerid,-1412567126, !"Ваша ставка принята, игра начата.");
			ExecutePacket(playerid, webUpdate, "interface('CasinoRullet').setBetState(false)");
			ExecutePacket(playerid, webUpdate, "playSound('sounds/casino/rulette/moved.wav', false)");
			ExecutePacket(playerid, webUpdate, "interface('CasinoRullet').startTimer()");
			//
			player_Casino_Rate[playerid] = count;
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "~r~-%i фишек", count);
			GameTextForPlayerEx(playerid, str_mes, 4000, 2);
			InvRemoveEx(playerid, 293, count, -1, -1, "", "Сделал ставку в рулетке");
			//
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "interface('CasinoRullet').setBalance(%i)", countEx-count);
			ExecutePacket(playerid, webUpdate, str_mes);
			//if(player_UpdateCasino[playerid] != -1) KillTimer(player_UpdateCasino[playerid]), player_UpdateCasino[playerid] = -1;
			player_UpdateCasino[playerid] = SetTimerEx("player_CasinoUpdate", randomEx(4000,9000), false, "i", playerid);
			SetPlayerCameraPos(playerid, CasinoRoulette[id][prCamPos][0], CasinoRoulette[id][prCamPos][1], CasinoRoulette[id][prCamPos][2]);
			SetPlayerCameraLookAt(playerid, CasinoRoulette[id][prCamLookAt][0], CasinoRoulette[id][prCamLookAt][1], CasinoRoulette[id][prCamLookAt][2], 1);
		}
		else player_DisplayText(playerid, "Необходимо выбрать позицию", 2);
	}
	else SCM(playerid, -1, "error casino 23909");
	return 1;
}
public: player_CasinoUpdate(playerid)
{
	new rand = random(37),
		position = player_Casino_Position{playerid},
		win;
	if(position == rand) //попадание по числу
	{
		if(random(10) > 6)
		{
			if(!position) win = 36;
			else win = 33;
		}
		else 
		{
			rand = position-1;
			if(rand < 0) rand = 4;
		}
	}
	else
	{
		switch(position)
		{
			/*case 0:
			{
				if(random(100) > 70) win = 35, rand = random(36)+1;
			}*/
			case 37: //2 TO 1 (1+)
			{
				switch(rand)
				{
					case 1,4,7,10,13,16,19,22,25,28,31,34:
					{
						if(random(10) > 2) win = 2;
						else rand = 0;
					}
				}
			}
			case 38: //2 TO 1 (2+)
			{
				switch(rand)
				{
					case 2,5,8,11,14,17,20,23,26,29,32,35:
					{
						if(random(10) > 2) win = 2;
						else rand = 3;
					}
				}
			}
			case 39: //2 TO 1 (3+)
			{
				switch(rand)
				{
					case 3,6,9,12,15,18,21,24,27,30,33,36:
					{
						if(random(10) > 2) win = 2;
						else rand = 4;
					}
				}
			}
			case 40: //1 ST 12
			{
				switch(rand)
				{
					case 1..12:
					{
						if(random(10) > 2) win = 3;
						else rand = 13;
					}
				}
			}
			case 41: //2 ND 12
			{
				switch(rand)
				{
					case 13..24:
					{
						if(random(10) > 2) win = 3;
						else rand = 12;
					}
				}
			}
			case 42: //3 RD 12
			{
				switch(rand)
				{
					case 25..36:
					{
						if(random(10) > 2) win = 3;
						else rand = 11;
					}
				}
			}
			case 43: //1 TO 18
			{
				switch(rand)
				{
					case 1..18:
					{
						if(random(10) > 2) win = 2;
						else rand = 24;
					}
				}
			}
			case 44: //EVEN
			{
				if(rand % 2 == 0)
				{
					//win
					if(random(10) > 2) win = 2;
					else rand = 1;
				}
			}
			case 45: //red
			{
				switch(rand)
				{
					case 1,3,5,7,9,12,14,16,18,21,19,23,25,27,30,32,34,36:
					{
						if(random(10) > 2) win = 2;
						else rand = 2;
					}
				}
			}
			case 46: //black
			{
				switch(rand)
				{
					case 2,4,6,8,11,10,13,15,17,20,22,24,26,29,28,31,33,35:
					{
						if(random(10) > 2) win = 2;
						else rand = 3;
					}
				}
			}
			case 47: //0DD
			{
				if(rand % 2 != 0)
				{
					//win
					if(random(10) > 2) win = 2;
					else rand = 2;
				}
			}
			case 48: //19 TO 36
			{
				switch(rand)
				{
					case 19..36:
					{
						if(random(10) > 2) win = 2;
						else rand = 3;
					}
				}
			}
		}
	}
	if(rand < 0) rand = 4;
	else if(rand > 36) rand = 33;
	//clear data
	player_UpdateCasino[playerid] = -1;
	KillTimer(player_UpdateCasino[playerid]);
	if(win > 0)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "~g~+%i фишек", player_Casino_Rate[playerid]*win);
		GameTextForPlayerEx(playerid, str_mes, 2, 4000);
		InvAdd(playerid, 293, player_Casino_Rate[playerid]*win, "", 0, 0, "", "выиграл казино рулетка");
	}
	ExecutePacket(playerid, webUpdate, (str_f("interface('CasinoRullet').setBalance(%i)", GetInvCount(playerid, 293))));
	ExecutePacket(playerid, webUpdate, (str_f("interface('CasinoRullet').stopTimer(%i)", rand)));
	ExecutePacket(playerid, webUpdate, (str_f("playSound('sounds/casino/rulette/%s.wav', false)", (win < 1 ? "loose" : "win"))));
	ExecutePacket(playerid, webUpdate, (str_f("interface('CasinoRullet').showAlert(%i, %i, %i, %i)", (win < 1 ? 0 : 1), rand, (win < 1 ? -player_Casino_Rate[playerid] : player_Casino_Rate[playerid]*win), GetInvCount(playerid, 293))));
	SCMf(playerid, -6750038, "Выпало число %i. Вы %s {FFFFFF}%i {FF9900}фишек.", rand, (win < 1 ? "проиграли" : "выиграли"), player_Casino_Rate[playerid]);
	return 1;
}
stock player_CasinoRoulClose(playerid)
{
	player_Casino_Rate[playerid] = 0;
	player_Casino_Type{playerid} = 255;
	player_Casino_Position{playerid} = 255;
	player_Casino_ID{playerid} = 255;
	ExecutePacket(playerid, webClose, "CasinoRullet");
	SetCameraBehindPlayer(playerid);
	if(player_TempObject[playerid] != -1) DestroyPlayerObject(playerid, player_TempObject[playerid]), player_TempObject[playerid] = -1;
}
stock player_CasinoExchange(playerid, type, count)
{
	if(count < 1 || count > 150)
	{
		GameTextForPlayerEx(playerid, "Обменять можно ~n~от 1 до 1_50 фишек", 1500, 2);
		return 1;
	}
	if(!type)
	{
		//(player_BizEntered[playerid] == -1 ? 1300000 : 1000000), (player_BizEntered[playerid] == -1 ? 810000 : 910000)
		new price = player_BizEntered[playerid] == -1 ? 13000000 : 10000000;
		if(CompareInt64(playerid, "<", count*price))
		//if(player_Cash[playerid] < count*price)
		{
			GameTextForPlayerEx(playerid, "У Вас нет столько денег", 1500, 2);
			return 1;
		}
		if(TryInvAdd(playerid, 293) == -1)
		{
			return 1;
		}
		GivePlayerMoneyEx(playerid, -count*price, "Покупка фишек");
		GiveBusinessMoney(playerid, player_BizEntered[playerid], (count*price)/20, 0);
		InvAdd(playerid, 293, count, "", 0, 0, "", "Покупка фишек");
		SCMf(playerid,-4301654, "Вы обменяли {FFFFFF}%i{FFBE5C} рублей на %i фишек. Всего: {FFFFFF}%i{FFBE5C} фишек.", count*price, count, GetInvCount(playerid, 293));
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "~g~+%i фишек~n~~r~-%i рублей", count, count*price);
		GameTextForPlayerEx(playerid, str_mes, 4000, 2);
	}
	else
	{
		if(GetInvCount(playerid, 293) < count)
		{
			GameTextForPlayerEx(playerid, "У Вас нет столько фишек", 1500, 2);
			return 1;
		}
		new price = player_BizEntered[playerid] == -1 ? 8100000 : 9100000;
		GivePlayerMoneyEx(playerid, count*price, "Продажа фишек");
		GiveBusinessMoney(playerid, player_BizEntered[playerid], count*720, 0);
		//InvAdd(playerid, 293, -count, false, 0, 0, "", "Продажа фишек");
		InvRemoveEx(playerid, 293, count, -1, -1, "", "Продажа фишек");
		SCMf(playerid,-4301654, "Вы обменяли {FFFFFF}%i{FFBE5C} фишек на %i рублей. Всего: {FFFFFF}%i{FFBE5C} фишек.", count, count*price, GetInvCount(playerid, 293));
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "~r~-%i фишек~n~~g~+%i рублей", count, count*price);
		GameTextForPlayerEx(playerid, str_mes, 4000, 2);
	}
	new actorid = SearchNearestActor(playerid);
	if(actorid != -1)
	{
		ClearActorAnimations(actorid);
		ApplyDynamicActorAnimation(actorid, "INT_SHOP", "shop_shelf", 4.0, 0, 0, 0, 0, 0);
		SetTimerEx("Casino_ActorAnimBack", 5000, false, "i", actorid);
	}
	GiveBusinessMoney(playerid, player_BizEntered[playerid], 10000, 0);
	OpenInterface[playerid][79] = false;
	ExecutePacket(playerid, webClose, "CasinoExchange");
	return 1;
}
stock player_SearchBiz(playerid, type)
{
	new Float:Distance, Float:Distance_ = 100000.0, useid = -1;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(BizData[i][bType] != type) continue;
		Distance = GetPlayerDistanceFromPoint(playerid, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2]);
		if(Distance < Distance_) useid = i, Distance_ = Distance;
	}
	//SCMf(playerid, -1, "%i %i %f %i", playerid, type, Distance_, useid);
	return useid;
}
public: Casino_ActorAnimBack(actorid)
{
	ApplyDynamicActorAnimation(actorid, "COP_AMBIENT", "Coplook_loop", 4.0, 176, 0, 0, 0, 0);
	return 1;
}
stock SearchNearestActor(playerid)
{
	new Float:Distance, Float:Distance_ = 100000.0, id = -1;

	for(new i = 1; i < Streamer_CountItems(STREAMER_TYPE_ACTOR, true) + 1; i++)
	{
		new Float:x, Float:y, Float:z;
		GetDynamicActorPos(i, x, y, z);
		Distance = GetPlayerDistanceFromPoint(playerid, x,y,z);
		if(Distance < Distance_ && Distance < 50) id = i, Distance_ = Distance;
	}
	return id;
}
stock OnPlayerInventoryEdit(playerid, type, slot)
{
	if(type == 0)
	{
		if(!InventoryAks_Used[playerid][slot]) return SCM(playerid,-825307393, "Этот аксессуар не надет, либо у Вас его нет");
		SCM(playerid,-5373697, "Вы начали изменять расположение аксессуара, для этого используйте редактор");
		SCM(playerid,-5373697, "Напоминание, чтобы переместить камеру зажмите пробел");
		//SetPlayerAttachedObject(playerid, index, modelid, bone, Float:fOffsetX = 0.0, Float:fOffsetY = 0.0, Float:fOffsetZ = 0.0, Float:fRotX = 0.0, Float:fRotY = 0.0, Float:fRotZ = 0.0, Float:fScaleX = 1.0, Float:fScaleY = 1.0, Float:fScaleZ = 1.0, materialcolor1 = 0, materialcolor2 = 0)
		//new bone = GetBoneAks(InventoryAks[playerid][0][slot]);
		//RemovePlayerAttachedObject(playerid, slot);
		//SetPlayerAttachedObject(playerid, slot, InventoryAks[playerid][2][slot], bone);
		//
		EditAttachedObject(playerid, slot);
	}
	return 1;
}
stock IsValidAuthCode(const code[])
{
	static Regex:regex;
	if(!regex) regex = Regex_New("^[0-9]{6}$");
	return Regex_Check(code, regex);
}
stock player_AuthCode(playerid, const code[])
{
	if(IsValidAuthCode(code))
	{
		if(GetString(code, player_TempStrCode[playerid]))
		{
			str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin`, `Reason`, FROM_UNIXTIME(timeout, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date_out`, FROM_UNIXTIME(timeban, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date_ban`, `timeout` FROM `Ban_List` WHERE `Owner` = '%s' ORDER BY `timeout` DESC LIMIT 1;", PN(playerid));
			mysql_tquery(mysql, str_q, "player_CheckPlayerBan", "i", playerid);
			return 1;
		}
	}
	SPD(playerid, 0, 0, "{FF6600}Неверный код", "\
		{FFFFFF}Код с приложения Telegram Authenticator введён\n\
		неправильно. Попробуйте выполнить следующее:\n\n\
		1. Введите {FFCD00}/q {FFFFFF}для выхода из игры.\n\n\
		2. Попробуйте синхронизировать время на Вашем\n\
		устройстве. Допустимое отклонение - {FF66A3}не более 3 секунд.\n\
		{FFFFFF}Для проверки используйте сайт {6699FF}www.time.is\n\n\
		{FFFFFF}3. Зайдите в игру и введите код с приложения ещё раз.", "Закрыть");
	Kick(playerid);
	return 1;
}
stock GetInventoryFreeCell(playerid)
{
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] != -1) continue;
		return i;
	}
	return -1;
}
stock OnPlayerInventoryTake(playerid, type, slot_old, count)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID)
	{
		OpenInterface[playerid][7] = false;
		SCM(playerid,-5963521, "Уведомление:{FFFFFF} Во время обмена невозможно!");
		ExecutePacket(playerid, webClose, "InventoryNew");
		return 1;
	}
	if(count < 1 || count > 2000000000) return 0;
	new slot_new = GetInventoryFreeCell(playerid);
	if(slot_new == -1) SCM(playerid, COLOR_RED, "[Ошибка] {FFFFFF}У вас нет места в инвентаре");
	else if(type == 2)
	{
		if(InventoryBag[playerid][1][slot_old] < count || count < 1) return 0;
		InvAdd(playerid, InventoryBag[playerid][0][slot_old], count, "", InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old], "Взял с рюкзака");
		OnPlayerInventory_WeaponSet(playerid, InventoryBag[playerid][0][slot_old]);

		InventoryBag[playerid][1][slot_old] -= count;
		if(InventoryBag[playerid][1][slot_old] <= 0) RefreshInvBag(playerid, slot_old);
		UpdateInvCell(playerid);
		SaveInvPlayer(playerid);
	}
	else if(type == 3)
	{
		new id = -1;
		if(player_InvType{playerid} == 1) //shkaf
		{
			id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
			if(id != -1 && id != -2)
			{
				if(InventoryHouse[id][1][slot_old] < count) return 0;
				if(!RemoveFamilyMoneyEx(playerid, count)) return UpdateInvCell(playerid);
				InvAdd(playerid, InventoryHouse[id][0][slot_old], count, "", InventoryHouse[id][2][slot_old], InventoryHouse[id][3][slot_old], InventoryHouseString[id][slot_old], "Взял с дома");
				OnPlayerInventory_WeaponSet(playerid, InventoryHouse[id][0][slot_old]);
				
				InventoryHouse[id][1][slot_old] -= count;
				if(InventoryHouse[id][1][slot_old] <= 0) RefreshInvHouse(id, slot_old);
				UpdateInvCell(playerid);
				SaveInvHouse(id);
			}
		}
		else if(player_InvType{playerid} == 2) //trunk
		{
			id = IsTrunkDostup(playerid);
			if(id != -1 && id != -2)
			{
				if(InventoryTrunk[id][1][slot_old] < count) return 0;
				InvAdd(playerid, InventoryTrunk[id][0][slot_old], count, "", InventoryTrunk[id][2][slot_old], InventoryTrunk[id][3][slot_old], InventoryTrunkString[id][slot_old], "Взял с багажника");
				OnPlayerInventory_WeaponSet(playerid, InventoryTrunk[id][0][slot_old]);
				
				InventoryTrunk[id][1][slot_old] -= count;
				if(InventoryTrunk[id][1][slot_old] <= 0) RefreshInvTrunk(id, slot_old);
				UpdateInvCell(playerid);
				SaveInvTrunk(id);
			}
		}
		else
		{
			UpdateInvCell(playerid);
			return 1;
		}
		foreach(new i: Player)
		{
			if(!OpenInterface[i][7]) continue;
			if(player_InvType{i} == 1) //shkaf
			{
				id = IsPlayerHouseOwner(i, player_HouseEntered[playerid]);
				if(id != -1 && id != -2) UpdateInvCell(i);
			}
			else if(player_InvType{i} == 2)
			{
				id = IsTrunkDostup(i);
				if(id == -2) GameTextForPlayerEx(i, "Владелец авто заблокировал багажник", 2000, 0);
				else if(id != -1) UpdateInvCell(i);
			}
		}
	}
	player_SaveInv{playerid} = 3;
	return 1;
}
stock OnPlayerInventoryDrop(playerid, type, slot, count)
{
	if(PI[playerid][pLevel] < 2) return player_DisplayText(playerid, "Выбрасывать предметы можно с 2 уровня!");
	if(GetPlayerVirtualWorld(playerid) != 0) return player_DisplayText(playerid, "В виртуальном мире нельзя выбрасывать предметы!");
	if(type != 1) return player_DisplayText(playerid, "Выбрасывать предметы можно только с инвентаря!");
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID)
	{
		OpenInterface[playerid][7] = false;
		SCM(playerid,-5963521, "Уведомление:{FFFFFF} Во время обмена невозможно!");
		ExecutePacket(playerid, webClose, "InventoryNew");
		return 1;
	}
	if(player_AntiFlood[playerid][0]-global_time > 0)
	{
		SCMf(playerid, -1, "[Ошибка] Подождите %i секунд.", player_AntiFlood[playerid][0]-global_time);
		return 0;
	}
	if(Inventory[playerid][0][slot] == 293)
	{
		GameTextForPlayerEx(playerid, "Вы не сможете это сделать: данный предмет является временным", 3000, 0);
		return 1;
	}
	if(count < 1 || count > 1000000) count = 1;
	if(GetInvCount(playerid, Inventory[playerid][0][slot], Inventory[playerid][2][slot], Inventory[playerid][3][slot], InventoryString[playerid][slot]) < count)
	{
		SCM(playerid, -1, "Ошибка: Этот предмет нельзя выбросить! (Недостаточно его)");
		return 1;
	}
	player_AntiFlood[playerid][0] = global_time+10;
	new id = Iter_Free(TrashData);
	if(id == -1) return SCM(playerid, -1, !"[Ошибка] В данный момент нельзя выбрасывать предметы!");
	SafeDestroyTrash(id);
	for(new i; i < 4; i++) InventoryTrash[i][id] = Inventory[playerid][i][slot];
	InventoryTrash[1][id] = count;
	SetString(InventoryTrashString[id], InventoryString[playerid][slot]);
	if(Inventory[playerid][0][slot] == 0)
	{
		//if(player_Cash[playerid] < count) return SCM(playerid, -1, "Ошибка: У вас недостаточно денег!");
		if(CompareInt64(playerid, "<", count)) return SCM(playerid, -1, "Ошибка: У вас недостаточно денег!");
		GivePlayerMoneyEx(playerid, -count, "Выбросил");
	}
	else
	{
		if(!InvRemoveEx(playerid, Inventory[playerid][0][slot], count, Inventory[playerid][2][slot], Inventory[playerid][3][slot], InventoryString[playerid][slot], "Выкинул предмет"))
		{
			SCM(playerid, -1, "Ошибка: Этот предмет нельзя выбросить!");
			return 1;
		}
	}
	static Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);

	TrashUpdate{id} = 90;
	//3d label
	Trash3DLabel[id] = CreateDynamic3DTextLabel(ItemsData[InventoryTrash[0][id]][ItemName], 0x3399FFFF, x-1.0, y+0.7, z-0.55, 10.0);

	//object
	TrashObject[id] = CreateDynamicObject(2969, x-1.0, y+0.7, z-0.55, 0.000000, 0.000000, 0.000000);
	//Streamer_Update(playerid, type = -1);

	//area
	TrashArea[id] = CreateDynamicSphere(x, y, z, 3.5);
	Iter_Add(TrashData, id);
	return 1;
}
stock SafeDestroyTrash(id)
{
	if(IsValidDynamic3DTextLabel(Trash3DLabel[id]))
	{
		DestroyDynamic3DTextLabel(Trash3DLabel[id]);
		Trash3DLabel[id] = Text3D:-1;
	}
	if(IsValidDynamicObject(TrashObject[id]))
	{
		DestroyDynamicObject(TrashObject[id]);
		TrashObject[id] = -1;
	}
	if(IsValidDynamicArea(TrashArea[id]))
	{
		DestroyDynamicArea(TrashArea[id]);
		TrashArea[id] = -1;
	}
	InventoryTrash[0][id] = -1;
	InventoryTrash[1][id] = 0;
	InventoryTrash[2][id] = 0;
	InventoryTrash[3][id] = 0;
	SetString(InventoryTrashString[id], "");
}
stock player_ChangeItemPosition(playerid, const desc[], counts, &data_old_0, &data_old_1, &data_old_2, &data_old_3, data_old_str[24], &data_new_0, &data_new_1, &data_new_2, &data_new_3, data_new_str[24])
{
	if(data_old_1 < counts || counts < 1) return 0;
	if(data_new_0 != -1 && data_new_0 != data_old_0) return 0;
	if(!GetString(desc, "trade"))
	{
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "Игрок %s %s [nameUID: %s, uid: %i, count: %i, model: %i, wear: %i, name: %s]", str_log, desc, ItemsData[data_old_0][ItemName], data_old_0, counts, data_old_2, data_old_3, data_old_str);
		SendLog(0, str_log);
	}
	//SCM(playerid, -1, "start changeItemPos");
	/*

	*/
	printf("start changeItemPos %s[%i] & data_old_1 => %i", PN(playerid), playerid, data_old_1);
	if(data_old_1 < 1) data_old_1 = 1;
	if(data_new_0 == -1)
	{
		data_new_1 = 0;
	}
	new count = (data_old_1-counts);
	data_new_0 = data_old_0;
	data_new_1 += counts;
	data_new_2 = data_old_2;
	data_new_3 = data_old_3;
	SetString(data_new_str, data_old_str);
	//2 -1 -1 99
	printf("%i %i %i %i %i", count, data_new_1, counts, data_new_0, data_old_1);
	printf("%i, %i, %i, %i, [%s|%s]", data_new_0, data_new_1, data_new_2, data_new_3, data_new_str, data_old_str);

	//clear data
	if(count < 1)
	{
		data_old_0 = -1;
		data_old_1 = 0;
		data_old_2 = 0;
		data_old_3 = 0;
		SetString(data_old_str, "");
		//SCM(playerid, -1, "count <= 0");
		print("count <= 0");
	}
	else 
	{
		data_old_1 = count;
		print("data_old_1 = count");
		//SCM(playerid, -1, "data_old_1 = count");
	}
	if(data_new_1 <= 0)
	{
		data_new_0 = -1;
		data_new_1 = 0;
		data_new_2 = 0;
		data_new_3 = 0;
		SetString(data_new_str, "");
		print("data_new_1 <= 0");
		//SCM(playerid, -1, "data_new_1 <= 0");
	}
	printf("stop changeItemPos %s[%i]", PN(playerid), playerid);
	//SCMf(playerid, -1, "result changeItemPos -> playerid: %i, reason: \"%s\", counts: %i, data_old: %i, %i, %i, %i, \"%s\", data_new: %i, %i, %i, %i, \"%s\"", playerid, desc, counts, data_old_0, data_old_1, data_old_2, data_old_3, data_old_str, data_new_0, data_new_1, data_new_2, data_new_3, data_new_str);
	return 1;
}
stock OnPlayerInventoryMove(playerid, type_old, slot_old, type_new, slot_new, count)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID)
	{
		OpenInterface[playerid][7] = false;
		SCM(playerid,-5963521, "Уведомление:{FFFFFF} Во время обмена невозможно!");
		ExecutePacket(playerid, webClose, "InventoryNew");
		return 1;
	}
	if(type_old == type_new && slot_old == slot_new) return 1;
	if(count < 1 || count > 2000000000)
	{
		UpdateInvCell(playerid);
		return 1;
	}
	//#pragma unused count
	if(type_old == 2 || type_new == 2)
	{
		if(!IsPlayerBagUsed(playerid))
		{
			GameTextForPlayerEx(playerid, "Наденьте рюкзак", 3000, 0);
			UpdateInvCell(playerid);
			return 1;
		}
	}
	if(type_old == 1 && type_new != 1)
	{
		if(Inventory[playerid][0][slot_old] == 293)
		{
			GameTextForPlayerEx(playerid, "Вы не сможете это сделать: данный предмет является временным", 3000, 0);
			UpdateInvCell(playerid);
			return 1;
		}
		else if(Inventory[playerid][0][slot_old] == 100 && Inventory[playerid][2][slot_old] == PI[playerid][pSkin]) SetPlayerSkinEx(playerid, 252);
		else if(Inventory[playerid][0][slot_old] == 0)
		{
			GameTextForPlayerEx(playerid, "Этот предмет нельзя положить сюда", 3000, 0);
			UpdateInvCell(playerid);
			return 1;
		}
	}
	//SCMf(playerid, -1, "%i, %i, %i, %i, %i", type_old, slot_old, type_new, slot_new, count);
	new id;
	if(type_old == 3 || type_new == 3)
	{
		if(player_InvType{playerid} == 1)
		{
			id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
			if(id == -1 || id == -2 || player_HouseEntered[playerid] == -1)
			{
				GameTextForPlayerEx(playerid, "Шкаф заблокирован", 3000, 0);
				OpenInterface[playerid][7] = false;
				OnPlayerInventory(playerid, 0);
				return 1;
			}
		}
		else if(player_InvType{playerid} == 2)
		{
			id = IsTrunkDostup(playerid);
			if(id == -2 || id == -1) 
			{
				GameTextForPlayerEx(playerid, "Владелец авто заблокировал багажник", 2000, 0);
				OpenInterface[playerid][7] = false;
				OnPlayerInventory(playerid, 0);
				return 1;
			}
		}
	}
	new 
		bool:move,
		bool:sync;
	//SCMf(playerid, -1, "%i %i %i", player_InvType{playerid}, IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]), player_HouseEntered[playerid]);
	if(type_old == type_new) //если в одном и том же инве все происходит
	{
		switch(type_old)
		{
			case 0: //player_aks
			{
				if(!InventoryAks_Used[playerid][slot_old])
				{
					player_ChangeItemPosition(playerid, "сменил слот аксессуарах",count,\
						InventoryAks[playerid][0][slot_old], InventoryAks[playerid][1][slot_old], InventoryAks[playerid][2][slot_old], InventoryAks[playerid][3][slot_old], InventoryAksString[playerid][slot_old],\
						InventoryAks[playerid][0][slot_new], InventoryAks[playerid][1][slot_new], InventoryAks[playerid][2][slot_new], InventoryAks[playerid][3][slot_new], InventoryAksString[playerid][slot_new]);
					move = true;
				}
				else GameTextForPlayerEx(playerid, "Этот аксессуар сейчас используется", 3000, 0);
			}
			case 1: //player_inv
			{
				player_ChangeItemPosition(playerid, "сменил слот инвентаре", count,\
					Inventory[playerid][0][slot_old], Inventory[playerid][1][slot_old], Inventory[playerid][2][slot_old], Inventory[playerid][3][slot_old], InventoryString[playerid][slot_old],\
					Inventory[playerid][0][slot_new], Inventory[playerid][1][slot_new], Inventory[playerid][2][slot_new], Inventory[playerid][3][slot_new], InventoryString[playerid][slot_new]);
				

				move = true;
			}
			case 2: //player_bag
			{
				if(IsPlayerBagUsed(playerid) == 1)
				{
					player_ChangeItemPosition(playerid, "сменил слот рюкзаке(или складе банды)",count,\
						InventoryBag[playerid][0][slot_old], InventoryBag[playerid][1][slot_old], InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old],\
						InventoryBag[playerid][0][slot_new], InventoryBag[playerid][1][slot_new], InventoryBag[playerid][2][slot_new], InventoryBag[playerid][3][slot_new], InventoryBagString[playerid][slot_new]);


					move = true;
				}
			}
			case 3: //3 inv
			{
				if(player_InvType{playerid} == 1) //shkaf
				{
					player_ChangeItemPosition(playerid, "сменил слот шкафе(или складе банды)",count,\
						InventoryHouse[id][0][slot_old], InventoryHouse[id][1][slot_old], InventoryHouse[id][2][slot_old], InventoryHouse[id][3][slot_old], InventoryHouseString[id][slot_old],\
						InventoryHouse[id][0][slot_new], InventoryHouse[id][1][slot_new], InventoryHouse[id][2][slot_new], InventoryHouse[id][3][slot_new], InventoryHouseString[id][slot_new]);
					SaveInvHouse(id);
					move = true;
					sync = true;
				}
				else if(player_InvType{playerid} == 2) //trunk
				{

					player_ChangeItemPosition(playerid, "сменил слот багажнике",count,\
						InventoryTrunk[id][0][slot_old], InventoryTrunk[id][1][slot_old], InventoryTrunk[id][2][slot_old], InventoryTrunk[id][3][slot_old], InventoryTrunkString[id][slot_old],\
						InventoryTrunk[id][0][slot_new], InventoryTrunk[id][1][slot_new], InventoryTrunk[id][2][slot_new], InventoryTrunk[id][3][slot_new], InventoryTrunkString[id][slot_new]);

					SaveInvTrunk(id);
					move = true;
					sync = true;
				}
			}
		}
	}
	else if(type_old != type_new)
	{
		if(type_new == 2 && type_old == 3) //с багажника/шкафа в рюкзак
		{
			if(player_InvType{playerid} == 1) //shkaf
			{
				//ChangeItemPosition(\
				//	InventoryHouse[id], InventoryHouseString[id], \
				//	InventoryBag[playerid], InventoryBagString[playerid], slot_old, slot_new);
				player_ChangeItemPosition(playerid, "шкафа(или склада банды) в рюкзак",count,\
					InventoryHouse[id][0][slot_old], InventoryHouse[id][1][slot_old], InventoryHouse[id][2][slot_old], InventoryHouse[id][3][slot_old], InventoryHouseString[id][slot_old],\
					InventoryBag[playerid][0][slot_new], InventoryBag[playerid][1][slot_new], InventoryBag[playerid][2][slot_new], InventoryBag[playerid][3][slot_new], InventoryBagString[playerid][slot_new]);

				//RefreshInvHouse(id, slot_old);
				SaveInvHouse(id);
				move = true;
				sync = true;
			}
			else if(player_InvType{playerid} == 2) //trunk
			{
				player_ChangeItemPosition(playerid, "багажника в рюкзак",count,\
					InventoryTrunk[id][0][slot_old], InventoryTrunk[id][1][slot_old], InventoryTrunk[id][2][slot_old], InventoryTrunk[id][3][slot_old], InventoryTrunkString[id][slot_old],\
					InventoryBag[playerid][0][slot_new], InventoryBag[playerid][1][slot_new], InventoryBag[playerid][2][slot_new], InventoryBag[playerid][3][slot_new], InventoryBagString[playerid][slot_new]);

				SaveInvTrunk(id);
				move = true;
				sync = true;
			}
		}
		else if(type_new == 3 && type_old == 2) //с рюкзака в шкаф или багажник
		{
			if(player_InvType{playerid} == 1) //shkaf
			{
				player_ChangeItemPosition(playerid, "рюкзака в шкаф(или склад банд)",count,\
					InventoryBag[playerid][0][slot_old], InventoryBag[playerid][1][slot_old], InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old],\
					InventoryHouse[id][0][slot_new], InventoryHouse[id][1][slot_new], InventoryHouse[id][2][slot_new], InventoryHouse[id][3][slot_new], InventoryHouseString[id][slot_new]);

				SaveInvHouse(id);
				move = true;
				sync = true;
			}
			else if(player_InvType{playerid} == 2) //trunk
			{
				player_ChangeItemPosition(playerid, "рюкзака в багажник",count,\
					InventoryBag[playerid][0][slot_old], InventoryBag[playerid][1][slot_old], InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old],\
					InventoryTrunk[id][0][slot_new], InventoryTrunk[id][1][slot_new], InventoryTrunk[id][2][slot_new], InventoryTrunk[id][3][slot_new], InventoryTrunkString[id][slot_new]);

				SaveInvTrunk(id);
				move = true;
				sync = true;
			}
		}
		else if(type_new == 3 && type_old == 1) //с инва в шкаф или багажник
		{
			if(player_InvType{playerid} == 1) //shkaf
			{
				player_ChangeItemPosition(playerid, "с инвентаря в шкаф(или склад банд)",count,\
					Inventory[playerid][0][slot_old], Inventory[playerid][1][slot_old], Inventory[playerid][2][slot_old], Inventory[playerid][3][slot_old], InventoryString[playerid][slot_old],\
					InventoryHouse[id][0][slot_new], InventoryHouse[id][1][slot_new], InventoryHouse[id][2][slot_new], InventoryHouse[id][3][slot_new], InventoryHouseString[id][slot_new]);
				OnPlayerInventory_WeaponSet(playerid, InventoryHouse[id][0][slot_new]);
				SaveInvHouse(id);
				move = true;
				sync = true;
			}
			else if(player_InvType{playerid} == 2) //trunk
			{
				player_ChangeItemPosition(playerid, "с инвентаря в багажник",count,\
					Inventory[playerid][0][slot_old], Inventory[playerid][1][slot_old], Inventory[playerid][2][slot_old], Inventory[playerid][3][slot_old], InventoryString[playerid][slot_old],\
					InventoryTrunk[id][0][slot_new], InventoryTrunk[id][1][slot_new], InventoryTrunk[id][2][slot_new], InventoryTrunk[id][3][slot_new], InventoryTrunkString[id][slot_new]);
				OnPlayerInventory_WeaponSet(playerid, InventoryTrunk[id][0][slot_new]);
				SaveInvTrunk(id);
				move = true;
				sync = true;
			}
		}
		else if(type_old == 3 && type_new == 1) //в инв со шкафа или багажника
		{
			if(id >= 0)
			{
				if(player_InvType{playerid} == 1) //shkaf
				{
					if(!RemoveFamilyMoneyEx(playerid, count)) return UpdateInvCell(playerid);
					player_ChangeItemPosition(playerid, "шкафа(или склада банды) в инвентарь",count,\
						InventoryHouse[id][0][slot_old], InventoryHouse[id][1][slot_old], InventoryHouse[id][2][slot_old], InventoryHouse[id][3][slot_old], InventoryHouseString[id][slot_old],\
						Inventory[playerid][0][slot_new], Inventory[playerid][1][slot_new], Inventory[playerid][2][slot_new], Inventory[playerid][3][slot_new], InventoryString[playerid][slot_new]);
					OnPlayerInventory_WeaponSet(playerid, Inventory[playerid][0][slot_new]);
					SaveInvHouse(id);
					move = true;
					sync = true;
				}
				else if(player_InvType{playerid} == 2) //trunk
				{
					player_ChangeItemPosition(playerid, "багажника в инвентарь",count,\
						InventoryTrunk[id][0][slot_old], InventoryTrunk[id][1][slot_old], InventoryTrunk[id][2][slot_old], InventoryTrunk[id][3][slot_old], InventoryTrunkString[id][slot_old],\
						Inventory[playerid][0][slot_new], Inventory[playerid][1][slot_new], Inventory[playerid][2][slot_new], Inventory[playerid][3][slot_new], InventoryString[playerid][slot_new]);
					OnPlayerInventory_WeaponSet(playerid, Inventory[playerid][0][slot_new]);
					SaveInvTrunk(id);
					move = true;
					sync = true;
				}
			}
		}
		else if(type_new == 0 && type_old == 1) //с инва в акс
		{
			if(Inventory[playerid][0][slot_old] != -1)
			{
				if(ItemsData[Inventory[playerid][0][slot_old]][ItemType] == 1) //triazov
				{
					player_ChangeItemPosition(playerid, "с инвентаря в аксессуары",count,\
						Inventory[playerid][0][slot_old], Inventory[playerid][1][slot_old], Inventory[playerid][2][slot_old], Inventory[playerid][3][slot_old], InventoryString[playerid][slot_old],\
						InventoryAks[playerid][0][slot_new], InventoryAks[playerid][1][slot_new], InventoryAks[playerid][2][slot_new], InventoryAks[playerid][3][slot_new], InventoryAksString[playerid][slot_new]);
					RefreshInvPlayer(playerid, slot_old);
					move = true;
				}
			}
		}
		else if(type_new == 0 && type_old == 2) //с рюкзака в акс
		{
			if(InventoryBag[playerid][0][slot_old] != -1)
			{
				if(ItemsData[InventoryBag[playerid][0][slot_old]][ItemType] == 1) //triazov
				{
					player_ChangeItemPosition(playerid, "рюкзака в аксессуары",count,\
						InventoryBag[playerid][0][slot_old], InventoryBag[playerid][1][slot_old], InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old],\
						InventoryAks[playerid][0][slot_new], InventoryAks[playerid][1][slot_new], InventoryAks[playerid][2][slot_new], InventoryAks[playerid][3][slot_new], InventoryAksString[playerid][slot_new]);

					RefreshInvBag(playerid, slot_old);
					move = true;
				}
			}
		}
		else if(type_new == 1 && type_old == 0) //c акса в инв
		{
			if(!InventoryAks_Used[playerid][slot_old])
			{
				player_ChangeItemPosition(playerid, "аксессуаров в инвентарь",count,\
					InventoryAks[playerid][0][slot_old], InventoryAks[playerid][1][slot_old], InventoryAks[playerid][2][slot_old], InventoryAks[playerid][3][slot_old], InventoryAksString[playerid][slot_old],\
					Inventory[playerid][0][slot_new], Inventory[playerid][1][slot_new], Inventory[playerid][2][slot_new], Inventory[playerid][3][slot_new], InventoryString[playerid][slot_new]);
				//RefreshAksInv(playerid, slot_old);
				move = true;
			}
			else GameTextForPlayerEx(playerid, "Этот аксессуар сейчас используется", 3000, 0);
		}
		else if(type_old == 1 && type_new == 2) //с инва в рюкзак
		{
			player_ChangeItemPosition(playerid, "с инвентаря в рюкзак",count,\
				Inventory[playerid][0][slot_old], Inventory[playerid][1][slot_old], Inventory[playerid][2][slot_old], Inventory[playerid][3][slot_old], InventoryString[playerid][slot_old],\
				InventoryBag[playerid][0][slot_new], InventoryBag[playerid][1][slot_new], InventoryBag[playerid][2][slot_new], InventoryBag[playerid][3][slot_new], InventoryBagString[playerid][slot_new]);
			OnPlayerInventory_WeaponSet(playerid, InventoryBag[playerid][0][slot_new]);
			move = true;
		}
		else if(type_old == 2 && type_new == 1) //с рюкзака в инв
		{
			player_ChangeItemPosition(playerid, "рюкзака в инвентарь",count,\
				InventoryBag[playerid][0][slot_old], InventoryBag[playerid][1][slot_old], InventoryBag[playerid][2][slot_old], InventoryBag[playerid][3][slot_old], InventoryBagString[playerid][slot_old],\
				Inventory[playerid][0][slot_new], Inventory[playerid][1][slot_new], Inventory[playerid][2][slot_new], Inventory[playerid][3][slot_new], InventoryString[playerid][slot_new]);
			OnPlayerInventory_WeaponSet(playerid, Inventory[playerid][0][slot_new]);
			move = true;
		}
	}
	if(!move) GameTextForPlayerEx(playerid, "Этот предмет нельзя положить сюда", 3000, 0);
	//GameTextForPlayerEx(playerid, "Вы не сможете это сделать: данный предмет является временным", 3000, 0);
	if(sync)
	{
		foreach(new i: Player)
		{
			if(!OpenInterface[i][7]) continue;
			if(player_InvType{i} == 1) //shkaf
			{
				id = IsPlayerHouseOwner(i, player_HouseEntered[playerid]);
				if(id != -1 && id != -2) UpdateInvCell(i);
			}
			else if(player_InvType{i} == 2)
			{
				id = IsTrunkDostup(i);
				if(id == -2) GameTextForPlayerEx(i, "Владелец авто заблокировал багажник", 2000, 0);
				else if(id != -1) UpdateInvCell(i);
			}
		}
	}
	else UpdateInvCell(playerid);
	player_AntiFlood[playerid][12] = global_time+15;
	player_SaveInv{playerid} = 3;
	return 1;
}
stock SearchCefPublic(const call[])
{
	for(new i; i < sizeof CefPublic; i++) if(GetString(call, CefPublic[i][uname])) return CefPublic[i][uide];
	return -1;
}
CMD:invis(playerid)
{	
	IsPlayerInvis{playerid} = !IsPlayerInvis{playerid};
	SCMf(playerid, -1, "Вы %s невидимость", (!IsPlayerInvis{playerid} ? "выключили" : "включили"));
}
stock IsVehicleUpsideDown(vehicleid)
{
    new Float:quat_w,Float:quat_x,Float:quat_y,Float:quat_z;
    GetVehicleRotationQuat(vehicleid,quat_w,quat_x,quat_y,quat_z);
    new Float:y = atan2(2*((quat_y*quat_z)+(quat_w*quat_x)),(quat_w*quat_w)-(quat_x*quat_x)-(quat_y*quat_y)+(quat_z*quat_z));
    return (y > 90 || y < -90);
}
public OnIncomingPacket(playerid, packetid, BitStream:bs)
{
	switch(packetid)
	{
		case 200:
		{
			new onVehicleData[PR_InCarSync];
			BS_IgnoreBits(bs, 8);
			BS_ReadInCarSync(bs, onVehicleData);
			if(!IsUniqueCar(VehicleData[ onVehicleData[PR_vehicleId] ][V_MODELID]) && IsVehicleUpsideDown(onVehicleData[PR_vehicleId]))
			{
				new Float:A;
				GetVehicleZAngle(onVehicleData[PR_vehicleId], A);
				SetVehicleZAngle(onVehicleData[PR_vehicleId], A);
			}
		}
		case 207:
		{
			if(IsPlayerInvis{playerid} != false)
			{
				static Float: X,
					Float: Y,
					Float: Z;

				BS_SetReadOffset(bs, 56);
				BS_ReadFloat(bs, X);
				BS_ReadFloat(bs, Y);
				BS_ReadFloat(bs, Z);


				BS_SetWriteOffset(bs, 0);

				BS_WriteUint8(bs, 212);
				BS_WriteUint16(bs, 0);
				BS_WriteUint16(bs, 0);
				BS_WriteUint16(bs, 0);
				BS_WriteFloat(bs, X);
				BS_WriteFloat(bs, Y);
				BS_WriteFloat(bs, Z);
			}
			else
			{
				new onFootData[PR_OnFootSync];
		
				BS_IgnoreBits(bs, 8); // ignore packetid (byte)
				BS_ReadOnFootSync(bs, onFootData);
		
				if (onFootData[PR_surfingVehicleId] != 0 &&
					onFootData[PR_surfingVehicleId] != INVALID_VEHICLE_ID
				) {
					if ((onFootData[PR_surfingOffsets][0] <= 0.0) 
						|| (onFootData[PR_surfingOffsets][1] <= 0.0) 
						|| (onFootData[PR_surfingOffsets][2] <= 0.0))
					{
						return 0; // ignore bad packet
					} 
				}
			}
		}
		case 215:
		{
			new bytes;
			BS_GetNumberOfBytesUsed(bs, bytes);
			if (bytes < 6) return 0;
			new style;
			BS_IgnoreBits(bs, 8); //215
			BS_ReadUint16(bs, style);
			if(style == 3) //voice chat
			{
				if(!IsPlayerLogged(playerid)) return 1;
				new size = bytes - 3;
				str_1[0] = EOS;
				for(new i; i < size; i++)
				{
					BS_ReadValue(bs, PR_UINT8, str_1[i]);
				}
				//SCMf(playerid, -1, "%i|%i|%i", size, bytes, strlen(str_1));
				ExecutePacket_Voice(playerid, str_1, size);
			}
			else if(style == 1) //ban for hwid
			{
				if(player_UpdateEx[playerid] == -1)
				{
					//215, 1, 0, 51, 0, 0, 0, 0, 30, 0, 0, 0, 83, 55, 52, 90, 78, 88, 48, 87, 50, 52, 49, 49, 52, 54, 68, 49, 57, 49, 50, 54, 51, 48, 52, 56, 57, 48, 55, 55, 51, 51, 40, 0, 0, 0, 57, 57, 70, 49, 53, 68, 53, 51, 57, 53, 52, 56, 69, 49, 54, 69, 70, 52, 51, 69, 49, 57, 49, 54, 55, 65, 52, 52, 53, 56, 50, 70, 65, 57, 54, 69, 65, 67, 53, 68, 0
					BS_IgnoreBits(bs, 32); //51
					new data;
					BS_ReadUint8(bs, data);
					printf("client %i", data);
					IsPlayerMobile{playerid} = data;

					BS_ReadString32(bs, str_1);
					SetString(player_Hardware_SerialID[playerid], str_1);

					BS_ReadString32(bs, str_1);
					SetString(player_Hardware_HashID[playerid], str_1);

					ExecutePacket(playerid, webUpdate, "confirmBrowserInitialize()");
					player_PLoadConnect{playerid} = 3;
					player_UpdateEx[playerid] = SetTimerEx("OnPlayerUpdateEx", 950, true, "i", playerid);
				}
			}
			else if(style == 29) 
			{
				BS_ReadUint32(bs, style);
				foreach(new i: PlayerPlayersStream[playerid])
				{
					if(i == playerid) continue;
					ExecutePacket_Chat(i, playerid, style);
				}
			}
			else
			{
				BS_IgnoreBits(bs, 32);
				if(style == 2) 
				{
					str_mes[0] = EOS;
					BS_ReadString32(bs, str_mes);
					ShowCefPublic(playerid, SearchCefPublic(str_mes), bs);
				}
			}
		}
	}
	return 1;
}
stock player_SendVoice(playerid, to_player, size, const buffer[], BitStream:bs)
{
	new
		BitStream:bsn = BS_New();
	BS_WriteValue(bsn,
				PR_UINT8, 215,
				PR_UINT16, 3,
				PR_UINT32, to_player,
				PR_UINT32, strlen(buffer),
				PR_STRING, buffer, strlen(buffer)); 
    PR_SendPacket(bsn, playerid);
	if(IsPlayerDebug[to_player]) PR_SendPacket(bsn, to_player);
	BS_Delete(bsn);
}
stock ExecutePacket_Voice(playerid, const string[], bytes)
{
	if(bytes < 70) return 0;
	if(GetPlayerData(playerid, pVC_muteTime) > 0) return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать голосовой чат во время мута");
	new
		BitStream:bsn = BS_New();
	BS_WriteValue(bsn,
				PR_INT8, 215,
				PR_INT16, 3,
				PR_UINT32, playerid,
				PR_UINT32, bytes-1); 
	for(new i; i < bytes-1; i++)
	{
		BS_WriteValue(bsn, PR_UINT8, string[i]);
	}
    foreach(new i: PlayerPlayersStream[playerid]) 
	{
		if(i == playerid || GetDistanceBetweenPlayers(playerid, i) > 30) continue;
		PR_SendPacket(bsn, i);
	}
	if(IsPlayerDebug[playerid]) PR_SendPacket(bsn, playerid);
	BS_Delete(bsn);
	return 1;
}
stock ExecutePacket_Chat(forplayerid, playerid, states)
{
    new
        BitStream:bsn = BS_New();

    BS_WriteValue(bsn, 
				PR_UINT8, 215,
				PR_UINT16, 29,
    			PR_UINT32, playerid,
    			PR_UINT32, states);
    PR_SendPacket(bsn, forplayerid);
    BS_Delete(bsn);
}
stock OnPlayerWeaponShop(playerid, get, count)
{
	if(!OpenInterface[playerid][27]) return 1;
	//OpenInterface[playerid][27] = true;
	//player_ShowData[playerid][88] = 0;
	switch(get)
	{
		case 0: //назад
		{
			if(!player_ShowData[playerid][88]) player_ShowData[playerid][88] = sizeof(GunShop_Data)-1;
			else player_ShowData[playerid][88]--;
		}
		case 1: //вперед
		{
			if(player_ShowData[playerid][88] == sizeof(GunShop_Data)-1) player_ShowData[playerid][88] = 0;
			else player_ShowData[playerid][88]++;
		}
		case 2: //хз
		{
        	ExecutePacket(playerid, webUpdate, (str_f("interface('WeaponShop').balance = %s", GetStrMoney(playerid))));
		}
		case 3: //опт
		{
			if(count < 1 || count > 1000) return GameTextForPlayerEx(playerid, "~r~Введите корректное значение", 2000, 5);
			new 
				bizid = player_BizEntered[playerid],
				price = (GunShop_Data[ player_ShowData[playerid][88] ][a_price]*count)*BizData[bizid][bProductEx];
            //if(GetStrMoney(playerid) < price) return SCM(playerid, 0xCECECEFF, "У вас недостаточно средств!");
			if(CompareInt64(playerid, "<", price)) return SCM(playerid, 0xCECECEFF, "У вас недостаточно средств!");

            GivePlayerMoneyEx(playerid, -price, (str_f("Магазин оружия №%i", bizid)), false, true);
			GiveBusinessMoney(playerid, bizid, price/8, -random(200));
			//GivePlayerWeapon(playerid, GunShop_Data[ player_ShowData[playerid][88] ][a_gunid], count);
			OnPlayerInventory_WeaponAdd(playerid, GunShop_Data[ player_ShowData[playerid][88] ][a_gunid], count);
			SCMf(playerid, 0x66CC00FF, "Вы успешно приобрели {3399FF}%s", GunShop_Data[ player_ShowData[playerid][88] ][a_name]);
		}
		case 4: //закрыть
		{
			ExecutePacket(playerid, webClose, "WeaponShop");
			OpenInterface[playerid][27] = false;
		}
	}
	if(get < 2)
	{
		new id = player_ShowData[playerid][88];
		str_1[0] = EOS, f(str_1, sizeof(str_1),"\
			interface('WeaponShop').setWeapon('[\"%s\", \"%s\", %i, %i, %i, %i, \"%s\"]')", \
			GunShop_Data[id][a_name], GunShop_Data[id][a_info], \
			GunShop_Data[id][a_price], \
			GunShop_Data[id][a_count], GunShop_Data[id][a_gunid], \
			GunShop_Data[id][a_type], GunShop_Data[id][a_country]);
		ExecutePacket(playerid, webUpdate, str_1);
	}
	return 1;
}
public OnPlayerEditAttachedObject(playerid, response, index, modelid, boneid, Float:fOffsetX, Float:fOffsetY, Float:fOffsetZ, Float:fRotX, Float:fRotY, Float:fRotZ, Float:fScaleX, Float:fScaleY, Float:fScaleZ)
{
//	InventoryAks_Pos[playerid][slot][i]
	if(GetPVarInt(playerid, "player_Inv_EditAks") == 1)
	{
		DeletePVar(playerid, "player_Inv_EditAks");
		new slot = player_ShowID[playerid][8];
		if(!response)
		{
			if(IsPlayerAttachedObjectSlotUsed(playerid, slot)) RemovePlayerAttachedObject(playerid, slot);
		}
		else
		{
			InventoryAks_Pos[playerid][slot][0] = fOffsetX;
			InventoryAks_Pos[playerid][slot][1] = fOffsetY;
			InventoryAks_Pos[playerid][slot][2] = fOffsetZ;
			InventoryAks_Pos[playerid][slot][3] = fRotX;
			InventoryAks_Pos[playerid][slot][4] = fRotY;
			InventoryAks_Pos[playerid][slot][5] = fRotZ;
			InventoryAks_Pos[playerid][slot][6] = fScaleX;
			InventoryAks_Pos[playerid][slot][7] = fScaleY;
			InventoryAks_Pos[playerid][slot][8] = fScaleZ;
			if(InventoryAks_Pos[playerid][slot][6] > 1.5) InventoryAks_Pos[playerid][slot][6] = 1.5;
			else if(InventoryAks_Pos[playerid][slot][6] < 0.5) InventoryAks_Pos[playerid][slot][6] = 0.5;

			if(InventoryAks_Pos[playerid][slot][7] > 1.5) InventoryAks_Pos[playerid][slot][7] = 1.5;
			else if(InventoryAks_Pos[playerid][slot][7] < 0.5) InventoryAks_Pos[playerid][slot][7] = 0.5;

			if(InventoryAks_Pos[playerid][slot][8] > 1.5) InventoryAks_Pos[playerid][slot][8] = 1.5;
			else if(InventoryAks_Pos[playerid][slot][8] < 0.5) InventoryAks_Pos[playerid][slot][8] = 0.5;
			if(InventoryAks_Used[playerid][slot]) SCM(playerid,1724645631, "Позиция аксессуара сохранена!");
			InventoryAks_Used[playerid][slot] = true;
			SaveInvPlayer_AksUsed(playerid, slot);
		}
	}
	return 1;
}
stock SaveInvPlayer_AksUsed(playerid, slot)
{
	if(!IsPlayerLogged(playerid)) return 0;
	str_1[0] = EOS;
	for(new i; i < 10; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryAks_Used[playerid][i]);
	UpdatePlayerDataStr(playerid, "InventoryAks_Used", str_1);

	str_1[0] = EOS;
	for(new i; i < 9; i++) //i слот
	{
		f(str_1, sizeof(str_1), "%s%.6f,", str_1, InventoryAks_Pos[playerid][slot][i]);
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "InventoryAks_Pos_%i", slot);
	UpdatePlayerDataStr(playerid, str_mes, str_1);
	return 1;
}
stock GetBoneAks(itemid)
{
	switch(itemid)
	{
		case 181..185: return 2;
		case 219: return 15;
		case 225: return 6;
		case 220: return 1;
		case 221: return 6;
		case 289: return 6;
		case 98: return 2;
		case 260: return 17;
	}
	return 1;
}
stock ownable_SearchFreeObjectCell(number)
{
	for(new i; i < 9; i++)
	{
		if(IsValidAcsPerson(CarData[number][cObjectModel][i]) != -1) continue;
		return i;
	}
	return -1;
}
stock OnPlayerInventoryUse(playerid, type, slot)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID)
	{
		OpenInterface[playerid][7] = false;
		SCM(playerid,-5963521, "Уведомление:{FFFFFF} Во время обмена невозможно!");
		ExecutePacket(playerid, webClose, "InventoryNew");
		return 1;
	}
	switch(type)
	{
		case 0: //aks
		{
			if(InventoryAks[playerid][0][slot] == -1) return 0;
			if(!ItemsData[InventoryAks[playerid][0][slot]][ItemUse]) return 0;
			switch(ItemsData[InventoryAks[playerid][0][slot]][ItemType])
			{
				case 1:
				{
					if(InventoryAks_Used[playerid][slot] != false)
					{
						SCM(playerid, -5373697, !"Вы успешно сняли данный аксессуар");
						InventoryAks_Used[playerid][slot] = false;
						SaveInvPlayer_AksUsed(playerid, slot);
						RemovePlayerAttachedObject(playerid, slot);
					}
					else
					{
						SetPVarInt(playerid, "player_Inv_EditAks", 1);
						player_ShowID[playerid][8] = slot;
						new bone = GetBoneAks(InventoryAks[playerid][0][slot]);
						//RemovePlayerAttachedObject(playerid, slot);
						SetPlayerAttachedObject(playerid, slot, InventoryAks[playerid][2][slot], bone);
						EditAttachedObject(playerid, slot);
						SCM(playerid, -5373697, !"Вы успешно надели данный аксессуар, чтобы исправить расположение используйте редактор");
						SCM(playerid, -5373697, !" Напоминание, чтобы переместить камеру зажмите пробел");
					}
				}
			}
		}
		case 1: //in inv
		{
			if(Inventory[playerid][0][slot] == -1) return 0;
			if(!ItemsData[Inventory[playerid][0][slot]][ItemUse]) return 0;
			switch(Inventory[playerid][0][slot])
			{
				case 280:
				{
					InvRemoveEx(playerid, 280, 1, -1, -1, "", "inventory use");
					SetPlayerHealthEx(playerid, 25.0);
				}
				case 2:
				{
					callcmd::healme(playerid);
				}
				case 41:
				{
					if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) return SCM(playerid, -1, "Вы уже начали установку украшения!");
					OpenInterface[playerid][7] = false;
					OnPlayerInventory(playerid, 0);
					new uid = player_HouseEntered[playerid];
					if(uid != -1)
					{
						if(GetString(HouseData[uid][hOwner], PN(playerid)))
						{
							return player_House_InstallObject(playerid, uid, Inventory[playerid][2][slot]);
						}
					}
					for(new i; i < TOTAL_HOUSES; i++)
					{
						if(!GetString(HouseData[i][hOwner], PN(playerid)) || !IsPlayerInRangeOfPoint(playerid, 6.0, HouseData[i][hEnter][0], HouseData[i][hEnter][1], HouseData[i][hEnter][2])) continue;
						return player_House_InstallObject(playerid, i, Inventory[playerid][2][slot]);
					}

					uid = player_BizEntered[playerid];
					if(uid != -1)
					{
						if(GetString(BizData[uid][bOwner], PN(playerid)))
						{
							return player_Business_InstallObject(playerid, uid, Inventory[playerid][2][slot]);
						}
					}
					for(new i; i < TOTAL_BUSINESSES; i++)
					{
						if(!GetString(BizData[i][bOwner], PN(playerid)) || !IsPlayerInRangeOfPoint(playerid, 6.0, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2])) continue;
						return player_Business_InstallObject(playerid, i, Inventory[playerid][2][slot]);
					}
					SCM(playerid,-825307393, "* Вы не находитесь возле своего дома или бизнеса");
				}
			}
			switch(ItemsData[Inventory[playerid][0][slot]][ItemType])
			{
				case 99:
				{
					foreach(new i: PlayerVehiclesStream[playerid])
					{
						new number = GetVehicleID(i);
						if(number == INVALID_VEHICLE_ID) continue;
						static Float:x, Float:y, Float:z;
						GetVehicleShiftPos(i, 1, x, y, z, 4.0);
						static Float:Rx, Float:Ry, Float:Rz;
						GetVehicleShiftPos(i, 0, Rx, Ry, Rz, 4.0);
						if(IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z) || IsPlayerInRangeOfPoint(playerid, 2.0, Rx, Ry, Rz))
						{
							if(!GetString(CarData[number][cOwner], PN(playerid)) || strlen(CarData[number][cNumber_String]) > 3)
							{
								SCM(playerid,-825307393, "* На этот транспорт нельзя установить номер");
							}
							else
							{
								static string[10], region[5];
								string[0] = EOS, region[0] = EOS;
								sscanf(InventoryString[playerid][slot], "s[10]s[5]", string, region);
								//SCMf(playerid, -1, "[%s], [%s], [%s] [%i]", InventoryString[playerid][slot], string, region, CarData[number][cNumber_Type]);
								if(IsValidNumber(string, region, Inventory[playerid][2][slot]) <= 0)
								{
									SCM(playerid,1724645631, "Этот номер невалидный, его невозможно установить на ТС");
									return 1;
								}
								player_Install_Number{playerid} = 4;
								ApplyAnimation(playerid, "BOMBER", "BOM_Plant_Loop", 4.0999999046326, 128, 0, 0, 0, 0, 1);
								SCM(playerid,1724645631, "Вы успешно установили новый номер на транспорт");
								CarData[number][cNumber_Type] = Inventory[playerid][2][slot];
								SetString(CarData[number][cNumber_String], InventoryString[playerid][slot]);
								UpdateDataInt("OwnableCars", "Number_Type", CarData[number][cNumber_Type], CarData[number][cID]);
								UpdateDataStr("OwnableCars", "Number_String", CarData[number][cNumber_String], CarData[number][cID]);
								
								VehicleData[i][vNumber_Type] = Inventory[playerid][2][slot];
								SetString(VehicleData[i][vNumber_String], InventoryString[playerid][slot]);
								UpdateVehicleNumber(i);
								RefreshInvPlayer(playerid, slot);
								OpenInterface[playerid][7] = false;
								OnPlayerInventory(playerid, 0);
								return 1;
							}
						}
					}
					SCM(playerid,-825307393, "* Вы не находитесь рядом с номером транспорта");
				}
				case 285:
				{
					if(IsValidAcsPerson(Inventory[playerid][2][slot]) == -1) return SCM(playerid, -1, "ошибка, это не украшение!!");
					new vehicleid = GetNearestVehicleID(playerid, 6.0),
						number = GetVehicleID(vehicleid);

					if(vehicleid == -1 || number == INVALID_VEHICLE_ID) GameTextForPlayerEx(playerid, "Рядом с вами~n~~r~нет личного транспорта", 4000, 3);
					else if(!GetString(CarData[number][cOwner], PN(playerid))) GameTextForPlayerEx(playerid, "Рядом с вами~n~~r~нет личного транспорта", 4000, 3);
					else
					{
						if(EditObjectToVehicle[playerid] != -1) return SCM(playerid, -1, "Вы уже устанавливаете");
						new ownable_slot = ownable_SearchFreeObjectCell(number);
						if(ownable_slot == -1) return SCM(playerid, 0xCECECEFF, !"На этом ТС установлено максимальное кол-во украшений");
						SCMf(playerid, 0x3399FFFF, "Вы начали установку украшения \"%s\" на свой ТС", PersonAcsData[IsValidAcsPerson(Inventory[playerid][2][slot])][accName]);
						CarData[number][cObjectModel][ownable_slot] = Inventory[playerid][2][slot];
						SetPVarInt(playerid, "InstallVehTun", ownable_slot + 1);
						player_EditVehicleObject(playerid, number, Inventory[playerid][2][slot]);
					}
				}
				case 100:
				{
					if(!PI[playerid][pMember_Duty])
					{
						if(!IsValidSkin(Inventory[playerid][2][slot])) return SCM(playerid, 0xCECECEFF, !"Неверный ID скина.");
						Action(playerid, "переодевается в другую одежду");
						SetPlayerSkinEx(playerid, Inventory[playerid][2][slot]);
						UpdateInvCell(playerid);
					}
					else SCM(playerid,-159121238, "Вы не можете переодеваться так как состоите в организации или находитесь сейчас на работе.");
				}
				case 2:
				{
					for(new i; i < sizeof(CaseStaticData); i++)
					{
						if(CaseStaticData[i][csItemUID] == Inventory[playerid][0][slot]) player_Case_Open(playerid, i);
					}
					return 1;
				}
				case 254:
				{
					callcmd::diagnostics(playerid);
				}
				case 255:
				{
					callcmd::mask(playerid);
				}
				case 44:
				{
					if(GetInvCount(playerid, 44) < 1) return SCM(playerid, 0xCECECEFF, !"* У вас отсутствует рем. комплект, его можно приобрести в любом магазине 24/7");
					if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, 0x999999FF, !"Вы должны находиться в транспорте");

					new vehicleid = GetPlayerVehicleID(playerid);

					RepairVehicle(vehicleid);
					SetVehicleData(vehicleid, V_HEALTH, 1000.0);
					SCM(playerid, 0xAA3333AA, !"Вы починили свой транспорт!");
					//InvAdd(playerid, 44, -1, false, 0, 0, "", "use item 44");
					InvRemoveEx(playerid, 44, 1, -1, -1, "", "use item 44");
				}
				case 25: callcmd::drugs(playerid, "");
			}
		}
	}
	OpenInterface[playerid][7] = false;
	OnPlayerInventory(playerid, 0);
	return 1;
}
public: OnClickQuests(playerid, click)
{
	switch(click)
	{
		case -1: ExecutePacket(playerid, webUpdate, "closeInterface('Quests')"),SetCameraBehindPlayer(playerid);
		default: SCMDf(playerid,"%i", click);
	}
}
stock OnPlayerInteractionMenu(playerid)
{
	if(OpenInterface[playerid][12])
	{
		player_SetCursorStatus(playerid, true);
		if(player_TargetID[playerid] == INVALID_PLAYER_ID) ExecutePacket(playerid, webOpen, "PlayerInteraction", "[\"\",[[1,\"Персонаж\",\"Character\",1],[1,\"Организация\",\"Organization\",2],[1,\"Семья\",\"Family\",3],[1,\"Транспорт\",\"Vehicle\",4],[1,\"Другое\",\"Other\",6]]]");
		else if(IsPlayerConnected(player_TargetID[playerid]) && IsPlayerLogged(player_TargetID[playerid]))
		{
			player_TargetStaticID[playerid] = player_TargetID[playerid];
			ExecutePacket(playerid, webOpen, "PlayerInteraction", (str_f("[\"%s\",[[1,\"Персонаж\",\"Character\",1],[1,\"Организация\",\"Organization\",2]]]", PN(player_TargetID[playerid]))));
		}
		else ExecutePacket(playerid, webOpen, "PlayerInteraction", "[\"\",[[1,\"Персонаж\",\"Character\",1],[1,\"Организация\",\"Organization\",2],[1,\"Семья\",\"Family\",3],[1,\"Транспорт\",\"Vehicle\",4],[1,\"Другое\",\"Other\",6]]]");
	}
	else 
	{
		player_TargetStaticID[playerid] = INVALID_PLAYER_ID;
		player_SetCursorStatus(playerid, false), ExecutePacket(playerid, webClose, "PlayerInteraction");
	}
}
