stock player_Accessories_Open(playerid, id)
{
	player_ShowUID[playerid][77] = id;
	GetAccessoriesData(playerid, 0);
	ExecutePacket(playerid, webOpen, "Accessories", (str_f("[[[\"Очки\",0],[\"Банданы\",1],[\"Маски\",2],[\"Береты\",3],[\"Шляпы\",4],[\"Сумка\",5],[\"Аксессуар на пояс\",6],[\"Часы\",7],[\"Рюкзак\",8],[\"Чокер\",10]],[%s]]", str_2)));
