	SaveInvPlayer_Aks(playerid);
	SaveInvPlayer_Inv(playerid);
	SaveInvPlayer_Bag(playerid);
	player_SaveInv{playerid} = 255;
	return 1;
}
stock sscanf_string(const source[], dest[][], const delimiter = '|', const maxlength = sizeof(dest[]), const size = sizeof(dest)){
    new pos = -1, count = 0, offset = 0;

    if (source[0] == EOS) {
        dest[0][0] = EOS;
        return;
    }

    while (source[++pos] != EOS) {
        if (source[pos] == delimiter) {
            if (count >= size) break;
            strmid(dest[count], source, offset, pos, maxlength);
            count++;
            offset = pos + 1;
        }
    }
    if (count < size) {
        strmid(dest[count], source, offset, pos, maxlength);
    }
}
stock player_UpdateAcs(playerid, forplayerid, slot = -1, bool:remove = false)
{
	for(new i; i < 10; i++)
	{
		if(slot != -1 && slot != i) continue;
		if(!InventoryAks_Used[playerid][i]) continue;
		if(!remove)
		{
			if(IsValidAcsPerson(InventoryAks[playerid][2][i]) == -1)
			{
				if(playerid == forplayerid)
				{
					SCMf(playerid, COLOR_RED, "[Ошибка] {FFFFFF}Аксессуар на слоте %i, не сможет отобразиться (модель %i)", i, InventoryAks[playerid][2][i]);
				}
				continue;
			}
			new bone = GetBoneAks(InventoryAks[playerid][0][i]);
			if(!bone) bone = 1;
			player_SetAttachedObject(playerid, forplayerid, i, InventoryAks[playerid][2][i], bone, \
				InventoryAks_Pos[playerid][i][0], InventoryAks_Pos[playerid][i][1], InventoryAks_Pos[playerid][i][2], \
				InventoryAks_Pos[playerid][i][3], InventoryAks_Pos[playerid][i][4], InventoryAks_Pos[playerid][i][5], \
				InventoryAks_Pos[playerid][i][6], InventoryAks_Pos[playerid][i][7], InventoryAks_Pos[playerid][i][8]);
		}
		else player_RemoveAttachedObject(playerid, forplayerid, i);
	}
}
