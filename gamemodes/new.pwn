//#include system
stock player_Stall_Menu(playerid, click)
{
	new id = player_EnterStall[playerid];
	if(id == -1)
	{
		ExecutePacket(playerid, webClose, "StallManage");
		SCM(playerid, -1, "Вы не рядом с киоском");
	}
	else if(!GetString(StallData[id][sOwner], PN(playerid)))
	{
		ExecutePacket(playerid, webClose, "StallManage");
		SCM(playerid, -1, "Вы не владелец этого киоска");
	}
	else
	{
		switch(click)
		{
			case 0..2:
			{
				if(StallData[id][sLevel] >= click+1)
				{
					SCM(playerid,0xFFDE7AFF,"Это улучшение уже куплено.");
				}
				else
				{
					new cost = (100000000*(click+1));
					//if(GetStrMoney(playerid) < cost)
					if(CompareInt64(playerid, "<", cost))
					{
						SCMf(playerid, -1, "У вас недостаточно средств. Необходимо %i руб", cost);
					}
					else
					{
						GivePlayerMoneyEx(playerid, -cost);
						StallData[id][sLevel]++;
						UpdateDataInt("Stalls", "Level", StallData[id][sLevel], StallData[id][sID]);
						SCMf(playerid,0xFFA500FF,"Вы приобрели улучшение киоска {FFFFFF}%i {FFA500}уровня за {FFFFFF}%i {FFA500}руб.", StallData[id][sLevel], cost);
					}
				}
			}
			case 3:
			{
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Текущая минимальная цена: %i руб.", StallData[id][sMinPrice]);
				SPD(playerid, 20433, DIALOG_STYLE_INPUT, str_mes, "\
					{FFDE7A}Введите новое значение, если хотите изменить\n\
					Имейте в виду, что вы устанавливаете минимальную цену\n\
					не на одну единицу товара, а на само предложение.","Далее", "Назад");
			}
			//sMinPrice
			case 4:
			{
				SPD(playerid, 20434, DIALOG_STYLE_INPUT, "Установка налога", "\
					{FFDE7A}Введите процент налога на продажу (от {42B02C}1 {FFDE7A}до {42B02C}25).","Далее", "Назад");
			}
			case 5:
			{
				ExecutePacket(playerid, webClose, "StallManage", str_1);
				str_1[0] = EOS;
				GetStallCellData(id);
				ExecutePacket(playerid, webOpen, "Stall", str_1);
				SetPVarInt(playerid, "stallManage_removeItem", 1228);
			}
			case 7:
			{
				StallData[id][sLock] = !StallData[id][sLock];
				SCM(playerid, (!StallData[id][sLock] ? 0x66CC00FF : 0xFF6600FF), (!StallData[id][sLock] ? "Киоск открыт" : "Киоск закрыт"));
			}
			case 8:
			{
				callcmd::sellstall(playerid);
			}
			case 9:
			{
				str_1[0] = EOS, f(str_1, sizeof(str_1), "\
					{ffffff}Текущее название: '%s'\n\
					Если хотите изменить его, введите новое название в поле ниже.", StallData[id][sName]);
				SPD(playerid, 20437, DIALOG_STYLE_INPUT,"Название киоска", str_1, "Готово", "Закрыть");
			}
			default:
			{
				ExecutePacket(playerid, webClose, "StallManage");
			}
		}
	}
	return 1;
}
CMD:sellstall(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_stall(playerid, 20435);
	return 1;
}
stock cmd_stall(playerid, dialogid)
{
	str_1[0] = EOS;
	str_1 = "{FFFFFF}Номер киоска\n";
	new count;
	memset(player_ShowID[playerid], -1);
	for(new i; i < sizeof(StallStaticData); i++)
	{
		if(!GetString(StallData[i][sOwner], PN(playerid))) continue;
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{FFFFFF}№%i\n", i);
		strcat(str_1, str_2);
		player_ShowID[playerid][count] = i;
		count++;
	}
	if(count > 0) SPD(playerid, dialogid, DIALOG_STYLE_TABLIST_HEADERS, "{FFCD00}Выберите киоск", str_1, "Выбрать", "Закрыть");
	else SCM(playerid, 0x999999FF, !"У вас не одного киоска во владении.");
}
CMD:trade(playerid, get[])
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID || player_TradeItems_ID[playerid] != INVALID_PLAYER_ID) return SCM(playerid,-5963521, "Уведомление:{FFFFFF} Вы уже обмениваетесь!");
	extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /trade [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SCM(playerid,-111665921, "Ошибка:{FFFFFF} Игрок слишком далеко от Вас");
	if(player_TradeID[to_player] != INVALID_PLAYER_ID || player_TradeItems_ID[to_player] != INVALID_PLAYER_ID) SCM(playerid,-5963521, "Уведомление:{FFFFFF} Игрок уже обменивается!");
	if(PI[playerid][pLevel] < 2 || PI[to_player][pLevel] < 2) return SCM(playerid,-5963521, "Уведомление:{FFFFFF} У игрока или у вас недостаточен уровень для проведения сделки. (Необходим 2 уровень)");
	//SCM(playerid,-5963521, "Уведомление:{FFFFFF} Вы согласились на обмен. Ждём подтверждения второго игрока");
	player_TradeItems_ID[playerid] = to_player;
	player_TradeItems_ID[to_player] = playerid;
	player_TradeItemsClear(playerid);
	player_TradeItemsClear(to_player);
	player_TradeItems_Open(playerid);
	player_TradeItems_Open(to_player);
	return 1;
}
alias:trade("give_item")
stock player_TradeItems_Open(playerid)
{
	ExecutePacket(playerid, webClose, "TradeItems");
	player_TradeItems_Timer[playerid] = 0;
	player_TradeItems_Accept{playerid} = false;
	//"TradeItems", "["Maxim_Hokae",["0",0],[[0,"inv1"],[0,"inv1"],[0,"inv1"]],[]]"
	str_2[0] = EOS;
	trade_GetInvCellData(playerid);
	str_1[0] = EOS, f(str_1, sizeof(str_1), "[\"%s\",[\"0\",0],[[0,\"inv1\"],[0,\"inv1\"],[0,\"inv1\"]],[%s]]", PN(player_TradeItems_ID[playerid]), str_2);
	ExecutePacket(playerid, webOpen, "TradeItems", str_1);
	return 1;
}
stock trade_GetInvCellData(playerid)
{
	if(!player_TradeItemIsValid(playerid))
	{
		return 1;
	}
	str_2[0] = EOS;
	for(new i; i < 20; i++)
	{
		if(Inventory_Visual[playerid][0][i] == -1) continue;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[0,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
			i, Inventory_Visual[playerid][0][i], Inventory_Visual[playerid][2][i],\
			InventoryString_Visual[playerid][i], i, Inventory_Visual[playerid][1][i],\
			ItemsData[Inventory_Visual[playerid][0][i]][ItemHeft],\
			Inventory_Visual[playerid][3][i]);
		strcat(str_2, str_1);
	}
	for(new i; i < 12; i++)
	{
		if(Inventory_TradeItems[playerid][0][i] == -1) continue;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[1,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
			i, Inventory_TradeItems[playerid][0][i], Inventory_TradeItems[playerid][2][i],\
			InventoryString_TradeItems[playerid][i], i, Inventory_TradeItems[playerid][1][i],\
			ItemsData[Inventory_TradeItems[playerid][0][i]][ItemHeft],\
			Inventory_TradeItems[playerid][3][i]);
		strcat(str_2, str_1);
	}
	for(new i, to_player = player_TradeItems_ID[playerid]; i < 12; i++)
	{
		if(Inventory_TradeItems[to_player][0][i] == -1) continue;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[2,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
			i, Inventory_TradeItems[to_player][0][i], Inventory_TradeItems[to_player][2][i],\
			InventoryString_TradeItems[to_player][i], i, Inventory_TradeItems[to_player][1][i],\
			ItemsData[Inventory_TradeItems[to_player][0][i]][ItemHeft],\
			Inventory_TradeItems[to_player][3][i]);
		strcat(str_2, str_1);
	}
	strdel(str_2, strlen(str_2)-1, strlen(str_2));
	return 1;
}
stock player_TradeItemMove(playerid, type_old, slot_old, type_new, slot_new, count)
{
	if(!player_TradeItemIsValid(playerid) || (type_old == type_new && slot_old == slot_new) || count < 1 || count > 10000)
	{
		return 1;
	}
	player_TradeItems_Timer[playerid] = 5;
	if(!player_TradeItems_Accept{playerid})
	{
		player_TradeItemAccept(playerid, 0, player_TradeItems_Money[playerid]);
	}
	if(type_old == 1 && type_new == 0) //с трейда в инв
	{
		if(Inventory_TradeItems[playerid][0][slot_old] >= count)
		{
			player_ChangeItemPosition(playerid, "trade", count,\
				Inventory_TradeItems[playerid][0][slot_old], Inventory_TradeItems[playerid][1][slot_old], Inventory_TradeItems[playerid][2][slot_old], Inventory_TradeItems[playerid][3][slot_old], InventoryString_TradeItems[playerid][slot_old],\
				Inventory_Visual[playerid][0][slot_new], Inventory_Visual[playerid][1][slot_new], Inventory_Visual[playerid][2][slot_new], Inventory_Visual[playerid][3][slot_new], InventoryString_Visual[playerid][slot_new]);
		}
	}
	else if(type_old == 0 && type_new == 1) //с инва в трейд
	{
		if(Inventory_Visual[playerid][0][slot_old] == 0 || Inventory_Visual[playerid][0][slot_old] == 293)
		{
			GameTextForPlayerEx(playerid, "Нельзя выставить ~n~этот предмет", 2000, 0);
		}
		else
		{
			if(Inventory_Visual[playerid][0][slot_old] == 100 && Inventory_Visual[playerid][2][slot_old] == PI[playerid][pSkin]) SetPlayerSkinEx(playerid, 252);
			player_ChangeItemPosition(playerid, "trade", count, \
				Inventory_Visual[playerid][0][slot_old], Inventory_Visual[playerid][1][slot_old], Inventory_Visual[playerid][2][slot_old], Inventory_Visual[playerid][3][slot_old], InventoryString_Visual[playerid][slot_old],\
				Inventory_TradeItems[playerid][0][slot_new], Inventory_TradeItems[playerid][1][slot_new], Inventory_TradeItems[playerid][2][slot_new], Inventory_TradeItems[playerid][3][slot_new], InventoryString_TradeItems[playerid][slot_new]);
		}
		//SCMf(playerid, -1, "old %i, %i & new %i, %i & count %i", type_old, slot_old, type_new, slot_new, count);
	}
	str_2[0] = EOS;
	trade_GetInvCellData(playerid);
	ExecutePacket(playerid, webUpdate, (str_f("interface('TradeItems').setItems([%s])", str_2)));

	new to_player = player_TradeItems_ID[playerid];
	str_2[0] = EOS;
	trade_GetInvCellData(to_player);
	ExecutePacket(to_player, webUpdate, (str_f("interface('TradeItems').setItems([%s])", str_2)));
	return 1;
}
stock player_TradeItemAccept(playerid, type, cash)
{
	if(!player_TradeItemIsValid(playerid))
	{
		return 1;
	}
	player_TradeItems_Timer[playerid] = 5;
	player_TradeItems_Accept{playerid} = bool:type;
	if(player_TradeItems_Accept{playerid} != false)
	{
		if(cash > 0)
		{
			if((cash < 1000000 || cash > 1500000000) && type != 0)
			{
				GameTextForPlayerEx(playerid, "У одного из участников не достигнута ~n~минимальная сумма доплаты 1000000 руб", 2500, 0);
				return 1;
			}
			player_TradeItems_Money[playerid] = cash;
		}
		else player_TradeItems_Money[playerid] = 0;
		if(player_TradeItems_Money[playerid] > 999999)
		{
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Комиссия ~n~~g~%i руб", (player_TradeItems_Money[playerid] / 100) * 20);
			GameTextForPlayerEx(playerid, str_mes, 2500, 2);
		}
	}
	else player_TradeItems_Money[playerid] = 0;
	new target = player_TradeItems_ID[playerid];
	ExecutePacket(playerid, webUpdate, (str_f("interface('TradeItems').setTargetPlayer('[\"%i\", %i]')", player_TradeItems_Money[target], player_TradeItems_Accept{target})));
	ExecutePacket(target, webUpdate, (str_f("interface('TradeItems').setTargetPlayer('[\"%i\", %i]')", player_TradeItems_Money[playerid], player_TradeItems_Accept{playerid})));
	return 1;
}
stock player_TradeItemClose(playerid, text[])
{
	if(playerid == INVALID_PLAYER_ID) return 0;
	new to_player = player_TradeItems_ID[playerid];
	player_TradeItemHide(playerid, text);
	if(to_player != INVALID_PLAYER_ID)
	{
		if(IsPlayerConnected(to_player))
		{
			if(IsPlayerLogged(to_player))
			{
				player_TradeItemHide(to_player, text);
			}
		}
	}
	return 1;
}
stock player_TradeItemHide(playerid, text[])
{
	GameTextForPlayerEx(playerid, text, 3000, 0);
	player_TradeItems_ID[playerid] = INVALID_PLAYER_ID;
	player_TradeItems_Accept{playerid} = false;
	player_TradeItems_Money[playerid] = 0;
	ExecutePacket(playerid, webClose, "TradeItems");
}
stock player_TradeItemIsValid(playerid)
{
	new to_player = player_TradeItems_ID[playerid];
	if(to_player == playerid || !IsPlayerConnected(to_player) || !IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
	{
		player_TradeItemClose(playerid, "Обмен был прерван ~n~одним из участников");
		return 0;
	}
	return 1;
}
stock player_TradeItemFinished(playerid)
{
	if(!player_TradeItemIsValid(playerid))
	{
		return 1;
	}
	new to_player = player_TradeItems_ID[playerid];
	if(!player_TradeItems_Accept{playerid})
	{
		GameTextForPlayerEx(playerid, "Вы не утвердили ~n~готовность", 2500, 0);
	}
	else if(!player_TradeItems_Accept{to_player})
	{
		GameTextForPlayerEx(playerid, "Не все игроки готовы ~n~к обмену", 2500, 0);
	}
	else if(player_TradeItems_Timer[playerid] > 0 || player_TradeItems_Timer[to_player] > 0)
	{
		GameTextForPlayerEx(playerid, "Подождите 5 сек.. Только что ~n~была объявлена готовность", 5000, 0);
		GameTextForPlayerEx(to_player, "Подождите 5 сек.. Только что ~n~была объявлена готовность", 5000, 0);
	}
	else
	{
		new 
			player_money = ((player_TradeItems_Money[playerid] / 100) * 20) + player_TradeItems_Money[playerid],
			target_money = ((player_TradeItems_Money[to_player] / 100) * 20) + player_TradeItems_Money[to_player];
		//SCMf(playerid, -1, "%i/%i", player_money, target_money);
		if(CompareInt64(playerid, "<", player_money) || CompareInt64(to_player, "<", target_money))
		{
			GameTextForPlayerEx(playerid, "Не у всех игроков имеется ~n~сверхлимит денег", 2500, 0);
		}
		/*if(!IsIntEx(player_Cash[playerid], (-player_money)) || !IsIntEx(player_Cash[to_player], (-target_money)) ||
			!IsIntEx(player_Cash[playerid], player_TradeItems_Money[to_player]) || !IsIntEx(player_Cash[to_player], player_TradeItems_Money[playerid]))
		{
			GameTextForPlayerEx(playerid, "Не у всех игроков имеется ~n~сверхлимит денег", 2500, 0);
		}*/
		else
		{
			new 
				player_TradeCounts,
				target_TradeCounts;
			for(new i; i < 12; i++)
			{
				if(Inventory_TradeItems[playerid][0][i] != -1)
				{
					new count = GetInvCount(playerid, Inventory_TradeItems[playerid][0][i], Inventory_TradeItems[playerid][2][i], Inventory_TradeItems[playerid][3][i], InventoryString_TradeItems[playerid][i]);
					//SCMf(playerid, -1, "%i %i [%i, %i, %i, %i, '%s']", i, count, Inventory_TradeItems[playerid][0][i], Inventory_TradeItems[playerid][1][i], Inventory_TradeItems[playerid][2][i], Inventory_TradeItems[playerid][3][i], InventoryString_TradeItems[playerid][i]);
					if(count < Inventory_TradeItems[playerid][1][i])
					{
						GameTextForPlayerEx(playerid, "У вас нет одного из предметов", 2500, 0);
						GameTextForPlayerEx(to_player, "У игрока нет одного из предметов", 2500, 0);
						return 1;
					}
					player_TradeCounts++;
				}
				if(Inventory_TradeItems[to_player][0][i] != -1)
				{
					new count = GetInvCount(to_player, Inventory_TradeItems[to_player][0][i], Inventory_TradeItems[to_player][2][i], Inventory_TradeItems[to_player][3][i], InventoryString_TradeItems[to_player][i]);
					//SCMf(playerid, -1, "%i %i [%i, %i, %i, %i, '%s']", i, count, Inventory_TradeItems[to_player][0][i], Inventory_TradeItems[to_player][1][i], Inventory_TradeItems[to_player][2][i], Inventory_TradeItems[playerid][3][i], InventoryString_TradeItems[to_player][i]);

					if(count < Inventory_TradeItems[to_player][1][i])
					{
						GameTextForPlayerEx(playerid, "У игрока нет одного из предметов", 2500, 0);
						GameTextForPlayerEx(to_player, "У вас нет одного из предметов", 2500, 0);
						return 1;
					}
					target_TradeCounts++;
				}
			}
			new 
				player_InvCounts = GetInvCounts(playerid),
				target_InvCounts = GetInvCounts(to_player);
			if(player_TradeCounts > player_InvCounts || target_TradeCounts > target_InvCounts)
			{
				GameTextForPlayerEx(playerid, "Не у всех игроков имеется ~n~свободное место для предметов", 2500, 0);
				return 1;
			}
			GivePlayerMoneyEx(playerid, player_TradeItems_Money[to_player] + (-player_money), "/trade");
			GivePlayerMoneyEx(to_player, player_TradeItems_Money[playerid] + (-target_money), "/trade");
			for(new i; i < 12; i++)
			{
				if(Inventory_TradeItems[to_player][0][i] != -1)
				{
					InvRemoveEx(to_player, Inventory_TradeItems[to_player][0][i], Inventory_TradeItems[to_player][1][i], Inventory_TradeItems[to_player][2][i], Inventory_TradeItems[to_player][3][i], InventoryString_TradeItems[to_player][i], "/trade");
					InvAdd(playerid, Inventory_TradeItems[to_player][0][i], Inventory_TradeItems[to_player][1][i], "", Inventory_TradeItems[to_player][2][i], Inventory_TradeItems[to_player][3][i], InventoryString_TradeItems[to_player][i]);
				}
				if(Inventory_TradeItems[playerid][0][i] != -1)
				{
					InvRemoveEx(playerid, Inventory_TradeItems[playerid][0][i], Inventory_TradeItems[playerid][1][i], Inventory_TradeItems[playerid][2][i], Inventory_TradeItems[playerid][3][i], InventoryString_TradeItems[playerid][i], "/trade");
					InvAdd(to_player, Inventory_TradeItems[playerid][0][i], Inventory_TradeItems[playerid][1][i], "", Inventory_TradeItems[playerid][2][i], Inventory_TradeItems[playerid][3][i], InventoryString_TradeItems[playerid][i]);
				}
			}
			player_TradeItemClose(playerid, "Обмен успешно завершен");
		}
	}
	return 1;
}
stock GetInvCounts(playerid)
{
	new count;
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] == -1) continue;
		count++;
	}
	return count;
}
stock GetInvFreeSlot(playerid)
{
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] == -1) continue;
		return i;
	}
	return -1;
}
stock player_TradeItemsClear(playerid)
{
	for(new i; i < 20; i++)
	{
		if(i < 12)
		{
			Inventory_TradeItems[playerid][0][i] = -1;
			Inventory_TradeItems[playerid][1][i] = 0;
			Inventory_TradeItems[playerid][2][i] = 0;
			Inventory_TradeItems[playerid][3][i] = 0;
			InventoryString_TradeItems[playerid][i] = "";
		}
		Inventory_Visual[playerid][0][i] = Inventory[playerid][0][i];
		Inventory_Visual[playerid][1][i] = Inventory[playerid][1][i];
		Inventory_Visual[playerid][2][i] = Inventory[playerid][2][i];
		Inventory_Visual[playerid][3][i] = Inventory[playerid][3][i];
		InventoryString_Visual[playerid][i] = InventoryString[playerid][i];
	}
	return 1;
}
stock player_LoadInventory(playerid)
{
	cache_get_string(0, "InventoryAks_0", str_1), sscanf(str_1, "p<,>a<i>[10]", InventoryAks[playerid][0]);
	cache_get_string(0, "InventoryAks_1", str_1), sscanf(str_1, "p<,>a<i>[10]", InventoryAks[playerid][1]);
	cache_get_string(0, "InventoryAks_2", str_1), sscanf(str_1, "p<,>a<i>[10]", InventoryAks[playerid][2]);
	cache_get_string(0, "InventoryAks_3", str_1), sscanf(str_1, "p<,>a<i>[10]", InventoryAks[playerid][3]);
	//cache_get_string(0, "InventoryAks_String", str_1);
	//sscanf_string(str_1, InventoryAksString[playerid], ',');

	cache_get_string(0, "Inventory_0", str_1), sscanf(str_1, "p<,>a<i>[20]", Inventory[playerid][0]);
	cache_get_string(0, "Inventory_1", str_1), sscanf(str_1, "p<,>a<i>[20]", Inventory[playerid][1]);
	cache_get_string(0, "Inventory_2", str_1), sscanf(str_1, "p<,>a<i>[20]", Inventory[playerid][2]);
	cache_get_string(0, "Inventory_3", str_1), sscanf(str_1, "p<,>a<i>[20]", Inventory[playerid][3]);
	cache_get_string(0, "Inventory_String", str_1);
	sscanf_string(str_1, InventoryString[playerid], ',');

	cache_get_string(0, "InventoryBag_0", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryBag[playerid][0]);
	cache_get_string(0, "InventoryBag_1", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryBag[playerid][1]);
	cache_get_string(0, "InventoryBag_2", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryBag[playerid][2]);
	cache_get_string(0, "InventoryBag_3", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryBag[playerid][3]);
	cache_get_string(0, "InventoryBag_String", str_1);
	sscanf_string(str_1, InventoryBagString[playerid], ',');

	str_1[0] = EOS, cache_get_string(0, "InventoryAks_Used", str_1), sscanf(str_1, "p<,>a<i>[10]", InventoryAks_Used[playerid]);
	
	for(new i; i < 10; i++)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "InventoryAks_Pos_%i", i);
		str_1[0] = EOS, cache_get_string(0, str_mes, str_1), sscanf(str_1, "p<,>a<f>[9]", InventoryAks_Pos[playerid][i]);
	}
	for(new i; i < 20; i++)
	{
		if(i < 20)
		{
			if(strlen(InventoryString[playerid][i]) > 2 && Inventory[playerid][0][i] != 99)
			{
				InventoryString[playerid][i] = "";
			}
		}
		if(strlen(InventoryBagString[playerid][i]) > 2 && InventoryBag[playerid][0][i] != 99)
		{
			InventoryBagString[playerid][i] = "";
		}
	}
}
CMD:asellstall(playerid, get[])
{
    extract get -> new id, string:reason[25]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /asellstall [id] [reason]");
	if(id < 0 || id > sizeof(StallStaticData)-1) return 0;
	if(GetString(StallData[id][sOwner], "Sell Nalog") && !NameIsFullDostup(PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Данный киоск нельзя продать, он выставлен на слёт.");
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "Админ %s[%i] продал киоск, владелец %s. Причина: %s", PN(playerid), playerid, StallData[id][sOwner], reason);
	SendAdminsMessage(COLOR_GREY, str_mes);
	ChangeStallOwner(id, "The State");
	return 1;
}
public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat) 
{
    new Float:healthVeh;
    GetVehicleHealth(vehicleid, healthVeh);
    if(!passenger_seat && healthVeh < 300.0) SetVehicleToRespawn(vehicleid);
    return 1;
}
stock player_CasinoDice_RandomBet(playerid, dataId)
{
	if(!player_CasinoDice_RandomOne{playerid} || !player_CasinoDice_RandomTwo{playerid})
	{
		if(random(100) > 50)
		{
			player_CasinoDice_RandomOne{playerid} = randomEx(2,7);
			player_CasinoDice_RandomTwo{playerid} = randomEx(2,7);
		}
		else
		{
			player_CasinoDice_RandomOne{playerid} = random(5)+1;
			player_CasinoDice_RandomTwo{playerid} = random(6)+1;
		}
		if((player_CasinoDice_RandomOne{playerid}+player_CasinoDice_RandomTwo{playerid}) > 7 && player_CasinoDice_Last{playerid} > 8)
		{
			player_CasinoDice_RandomOne{playerid} = random(4)+1;
			player_CasinoDice_RandomTwo{playerid} = random(3)+1;
		}
		player_CasinoDice_Last{playerid} = (player_CasinoDice_RandomOne{playerid}+player_CasinoDice_RandomTwo{playerid});
		CasinoDice_UpdateGame(dataId);
	}
}
stock IsNums(const string[])
{
    for(new i = 0, j = strlen(string); i < j; i++)
    {
        if(string[i] > '9' || string[i] < '0') return 0;
    }
    return 1;
}
CMD:id(playerid, get[])
{
	if(!IsNums(get)) //по нику
	{
		if(strlen(get) < 3) return SCM(playerid,-825307393, "Используйте: /id [имя или часть имени/id игрока]");
		new count;
		foreach(new i: Player)
		{
			SetString(str_mes, PN(i));
			new insert_pos = strfind(str_mes, get, true);
			if(!(insert_pos == -1))
			{
				strins(str_mes, "{ffffff}", strlen(get) + insert_pos);
				strins(str_mes, "{E8D592}", insert_pos);
				f(str_mes, 128, "%i. %s, ID: %i, уровень: %i, PING: %i, клиент: RADMIR (PC)", count+1, str_mes, i, PI[i][pLevel], GetPlayerPing(i));
				SCM(playerid, -1, str_mes);
				count++;
			}
		}
		if(!count)
		{
			SCM(playerid,-825307393, "Такого игрока нет");
			return 1;
		}
	}
	else
	{
		new i = strval(get);
		if(!IsPlayerLogged(i))
		{
			SCM(playerid,-825307393, "Такого игрока нет");
		}
		else
		{
			f(str_mes, 128, "%s, ID: %i, уровень: %i, PING: %i, клиент: RADMIR (PC)", PN(i), i, PI[i][pLevel], GetPlayerPing(i));
			SCM(playerid, -1, str_mes);
		}
	}
	return 1;
}
CMD:carmusic(playerid)
{
	new 
		vehicleid = GetPlayerVehicleID(playerid);
	if(!Iter_Contains(Vehicles, vehicleid)) return 0;
	str_mes = "[\"https://music.radmir.online/\", [[],[],0,false,0,50]]";
	if(vehicle_MusicPlayer_AreaID[vehicleid] != -1)
	{
		f(str_mes, sizeof(str_mes), "[\"https://music.radmir.online/\", [[[\"%s\", 230]],[],%i,false,0,%i]]", vehicle_MusicPlayer_Name[vehicleid], vehicle_MusicPlayer_StartTime[vehicleid], vehicle_MusicPlayer_Volume[vehicleid]);
	}
	ExecutePacket(playerid, webOpen, "Music", str_mes);
	//ExecutePacket(playerid, webUpdate, (str_f("interface('Music').srv_onReceiveData(%i,2)", 50)));
	return 1;
}
stock vehicle_MusicPlayer_Play(vehicleid, playerid)
{
	ExecutePacket(playerid, webClose, "MusicPlayer");
	new Float:x, Float:y, Float:z;
	//SCMf(playerid, -1, "%i", vehicleid);
	GetVehiclePos(vehicleid, x, y, z);
	ExecutePacket(playerid, webOpen, "MusicPlayer", (str_f("\
		[\"https://music.radmir.online/audio/%s.mp3\",%i,230,[%.6f,%.6f,%.6f],%.6f,0.%i0000,[%.6f,%.6f,%.6f]]", vehicle_MusicPlayer_Name[vehicleid], vehicle_MusicPlayer_StartTime[vehicleid], x, y, z, (((GetPlayerVehicleID(playerid) == vehicleid) || GetVehicleSpeed(vehicleid) > 20) ? 50000.0 : 12.0), vehicle_MusicPlayer_Volume[vehicleid], x, y, z)));
}
stock player_Music_SendData(playerid, type, const name[], track_id, volume)
{
	//SCMf(playerid, -1, "%i. %s", type, name);
	#pragma unused track_id
	new 
		vehicleid = GetPlayerVehicleID(playerid);
	//	number = GetVehicleID(vehicleid);
	{
		//SCMf(playerid, -1, "%i|%s|%i|%i", type, name, track_id, volume);
		switch(type)
		{
			case 0: //ADD: 0,
			{
				player_MusicPlayer_Start(playerid, name);
			}
			case 1,2: //REMOVE: 1, //STOP: 2,
			{
				ExecutePacket(playerid, webUpdate, (str_f("interface('Music').srv_onReceiveData([],0)", name, global_time)));
				vehicle_MusicPlayer_Destroy(vehicleid);
			}
			//case 3: //NEXT: 3,
			//case 4: //CLOSE: 4,
			//case 5: //RESUME: 5,
			//case 6: //ADD_VISITOR: 6,
			case 7: //VOLUME: 7
			{
				if(volume > 99) vehicle_MusicPlayer_Volume[vehicleid] = 99;
				else if(volume < 5) vehicle_MusicPlayer_Volume[vehicleid] = 5;
				else vehicle_MusicPlayer_Volume[vehicleid] = volume;

				foreach(new i: VehiclePlayersStream[vehicleid])
				{
					if(vehicle_MusicPlayer_AreaID[vehicleid] == player_MusicPlayer_AreaID[i])
					{
						vehicle_MusicPlayer_Play(vehicleid, i);
					}
				}
				ExecutePacket(playerid, webUpdate, (str_f("interface('Music').srv_onReceiveData(%i,2)", volume)));
			}
		}
	}
	return 1;
}
//#include	modules/groups_mp.pwn
CMD:carpass(playerid, get[])
{
	extract get -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /carpass [id]");
	if(!IsPlayerConnected(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0))
		return SCM(playerid, 0x999999FF, !"* Игрок слишком далеко");
	
	player_ShowUID[playerid][111] = to_player;
	cmd_cars(playerid, 20446);
	return 1;
}
stock cmd_carpass(playerid, number)
{
	new uid = IsValidCarModel(CarData[number][cModel]),
		cost = addcars_SearchUID(CarData[number][cModel]);
	if(cost == -1) cost = 25000000;
	else cost = AddCarsData[cost][acCost]*2;
	UpdateCarData_Sync(number, true);
	ExecutePacket(playerid, webOpen, "Docs", (str_f("[[5,[\"%s\",\"%s\",\"[- %s]\",%i,\"92-95-98-DIESEL\",\"-\",%i]],[6,[\"%s\",[]]]]", VehicleStaticData[uid][vsName], PN(playerid), CarData[number][cRegNumber_String], cost, floatround(CarData[number][cWear]), VehicleStaticData[uid][vsName])));
}
