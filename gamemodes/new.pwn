public: LoadFamilys()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++) 
	{
		stat = LoadFamilyMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[Familys]: Семей загружено -> %i", TOTAL_FAMILYS);
	else printf("[Familys]: UNKNOWN ( all stat -> %i)", TOTAL_FAMILYS);
	mysql_tquery(mysql, "SELECT * FROM `Businesses` ORDER BY `ID` ASC ", "LoadBusinesses", "");
	server_UpdateGang_Label();
}
public: LoadFamilyMySQL(id)
{
	cache_get_int(id, "ID", FamilyData[TOTAL_FAMILYS][fID]);
	cache_get_string(id, "Name", FamilyData[TOTAL_FAMILYS][fName]);
	cache_get_string(id, "Owner", FamilyData[TOTAL_FAMILYS][fOwner]);
	cache_get_int(id, "Balance", FamilyData[TOTAL_FAMILYS][fBalance]);
	cache_get_int(id, "Gang", FamilyData[TOTAL_FAMILYS][fGang]);
	cache_get_string(id, "Register_Date", FamilyData[TOTAL_FAMILYS][fRegister_Date]);
	cache_get_int(id, !"MemberCount", FamilyData[TOTAL_FAMILYS][fMemberCount]);
	cache_get_int(id, !"Gang_Warn", FamilyData[TOTAL_FAMILYS][fGang_Warn]);
	cache_get_int(id, !"Gang_Reputation", FamilyData[TOTAL_FAMILYS][fGang_Reputation]);
	str_1[0] = EOS, cache_get_string(id, !"Gang_Improve", str_1), sscanf(str_1, "p<,>a<i>[8]", FamilyData[TOTAL_FAMILYS][fGang_Improve]);
	cache_get_int(id, !"Color", FamilyData[TOTAL_FAMILYS][fColor]);
	cache_get_string(id, "Rang_Name", str_1);
	sscanf_string(str_1, FamilyRang_Name[TOTAL_FAMILYS], ',');
	cache_get_int(id, !"Gang_Walking", FamilyData[TOTAL_FAMILYS][fGang_Walking]);
	cache_get_int(id, !"Gang_BaseID", FamilyData[TOTAL_FAMILYS][fGang_BaseID]);
	cache_get_string(id, !"Rang_Deputy", str_1), sscanf(str_1, "p<,>a<i>[10]", FamilyRang_Deputy[TOTAL_FAMILYS]);
	FamilyRang_Deputy[TOTAL_FAMILYS][9] = true;
	cache_get_string(id, !"Rang_Wage", str_1), sscanf(str_1, "p<,>a<i>[10]", FamilyRang_Wage[TOTAL_FAMILYS]);

	str_2[0] = EOS, f(str_2, sizeof(str_2), "p<,>a<i>[%i]", sizeof(ItemsData));
	for(new i; i < 9; i++)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Rang_Dostup_%i", i);
		cache_get_string(id, str_mes, str_1), sscanf(str_1, str_2, FamilyRang_Dostup[TOTAL_FAMILYS][i]);
	}
	Family_BizFlood[TOTAL_FAMILYS] = global_time;
	Biz_FamilyAttack{TOTAL_FAMILYS} = false;
	new idEx = FamilyData[TOTAL_FAMILYS][fGang_BaseID];
	if(!(idEx < 0 || idEx > TOTAL_HOUSES-1))
	{
		family_UpdateHouse(FamilyData[TOTAL_FAMILYS][fID], idEx);
	}
	TOTAL_FAMILYS++;
	return 1;
}
CMD:cars(playerid) 
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_cars(playerid, 20244);
	return 1;
}
CMD:getv(playerid, get[])
{
	player_ShowID[playerid][33] = -1;
	extract get -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /getv [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0x999999FF, !"Такого игрока нет");
	cmd_getv(playerid, to_player, 20310);
	return 1;
}
stock cmd_getv(playerid, to_player, dialogid) //to_player владелец авто
{
	str_1[0] = EOS;
	player_ShowID[playerid][33] = to_player;
	memset(player_ShowData[playerid], -1);
	new count;
	foreach(new i: OWNABLECARS)
	{
		if(!GetString(CarData[i][cOwner], PN(to_player))) continue;
		new uid = IsValidCarModel(CarData[i][cModel]);
		if(uid != -1)
		{
			strcat(str_1, (str_f("{FFFFFF}- %s (%i)\n", VehicleStaticData[uid][vsName], CarData[i][cModel])));
			player_ShowData[playerid][count] = i;
			count++;
		}
	}
	if(!count) SCM(playerid, 0x999999FF, !"У игрока нет загруженных авто");
	else SPD(playerid, dialogid, DIALOG_STYLE_LIST, "{0099FF}Выберите транспорт", str_1, "Выбрать", "Закрыть");
	return 1;
}
CMD:flip(playerid, params[])
{
	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /flip [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0x999999FF, !"Такого игрока нет");
	if(GetPlayerState(to_player) != 2) return SCM(playerid, 0x999999FF, !"Игрок не на водительском сидении!");
	new vehicleid = GetPlayerVehicleID(to_player);
	vehicle_Flip(vehicleid);
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] флип'нул машину игрока %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	return 1;
}
stock vehicle_Flip(vehicleid)
{
	static Float:X,Float:Y,Float:Z,Float:A;
	GetVehiclePos(vehicleid,X,Y,Z);
	SetVehiclePos(vehicleid,X,Y,Z);
	GetVehicleZAngle(vehicleid, A);
	SetVehicleZAngle(vehicleid, A);
	RepairVehicle(vehicleid);
}
