		7. Безналичный перевод\n\
		8. Оплатить штраф\n\
		9. Благотворительность\n\
		10. Снять со счета киоска\n\
		11. Снять со счета нефтяного насоса", "Выбрать","Выйти");
	return 1;
}
public: player_BankTransfer(playerid)
{
	player_ShowData[playerid][100] = -1;
	player_ShowData[playerid][101] = -1;
	if(!cache_num_rows()) return SCM(playerid, 0xFF6600FF, !"Счета с таким номером не существует");
	if(!Iter_Contains(Player, playerid)) return 1;

	static id;
	cache_get_int(0, !"ID", id);
	player_ShowData[playerid][100] = id;

	cache_get_int(0, !"pID", player_ShowData[playerid][101]);
	str_1[0] = EOS, cache_get_string(0, !"Name", str_1);

	f(str_1, sizeof(str_1), "\
						{FFFFFF}Исходный счет:\t\t%i\n\
						Назначение:\t\t\'%s\', №%i\n\n\
						Комиссии:\n\
						1%% - до 100.000\n\
						2%% - от 100.000 до 1.000.000\n\
						5%% - от 1.000.000\n\n\
						Введите сумму для перевода:", id, str_1, id);
	SPD(playerid, 20274, DIALOG_STYLE_INPUT, "{FFCD00}Перевод средств", str_1, "Перевести","Отмена");
	return 1;
}
public OnPlayerObjectMoved(playerid, objectid)
{
	//MovePlayerObject(playerid, camera[playerid], 225.80000305176, 2774.1298828125, 13.89999961853, 1.2000000476837, 1.2000000476837);
	if(objectid == player_registerCamera[playerid])
	{
		static Float:Position[3];
		GetPlayerObjectPos(playerid, player_registerCamera[playerid], Position[0], Position[1], Position[2]);
		//printf("%f", Position[0]);
		if(Position[0] >= 229.80000305176)
		{
			//print("конец");
			StopPlayerObject(playerid, player_registerCamera[playerid]);
			DestroyPlayerObject(playerid, player_registerCamera[playerid]), player_registerCamera[playerid] = -1;
			InterpolateCameraPos(playerid, 230.8000, 2774.1299, 13.9000, 238.8000, 2774.1299, 13.9000, 3000, CAMERA_MOVE);
			InterpolateCameraLookAt(playerid, 230.8000, 2772.3301, 13.9000, 238.2000, 2772.3301, 13.9000, 3000, CAMERA_MOVE);
			register_SetPlayerSkin(playerid, 78);
			register_CreateActor(playerid);
			//MovePlayerObject(playerid, player_registerCamera[playerid], 230.80000305176, 2774.1298828125, 13.89999961853, 0.40000000596046);
		}
		else if(Position[0] >= 227.80000305176)
		{
			StopPlayerObject(playerid, player_registerCamera[playerid]);
			MovePlayerObject(playerid, player_registerCamera[playerid], 230.80000305176, 2774.1298828125, 13.89999961853, 0.40000000596046);
		}
		else if(Position[0] >= 224.80000305176)
		{
			StopPlayerObject(playerid, player_registerCamera[playerid]);
			MovePlayerObject(playerid, player_registerCamera[playerid], 228.80000305176, 2774.1298828125, 13.89999961853, 0.80000001192093);
		}
	}
	else if(objectid == player_TempObject[playerid])
	{
		static Float:Position[3];
		GetPlayerObjectPos(playerid, player_TempObject[playerid], Position[0], Position[1], Position[2]);
		//printf("%f", Position[0]);
		if(Position[0] >= 230.0)
		{
			//print("конец train");
			StopPlayerObject(playerid, player_TempObject[playerid]);
		}
		else if(Position[0] >= 228.0)
		{
			StopPlayerObject(playerid, player_TempObject[playerid]);
			MovePlayerObject(playerid, player_TempObject[playerid], 231.0, 2773.2299804688, 13.39999961853, 0.40000000596046);
		}
		else if(Position[0] >= 225.0)
		{
			StopPlayerObject(playerid, player_TempObject[playerid]);
			MovePlayerObject(playerid, player_TempObject[playerid], 229.0, 2773.2299804688, 13.39999961853, 0.80000001192093);
		}
	}
	return 1;
}
stock register_SetPlayerSkin(playerid, skinid)
{
	PI[playerid][pSkin] = skinid;

	if(player_registerSkin[playerid] != -1) DestroyDynamicActor(player_registerSkin[playerid]), player_registerSkin[playerid] = -1;
	player_registerSkin[playerid] = CreateDynamicActor(skinid, 237.75390625, 2772.2973632813, 13.392200469971, 332.50869750977, 1, 100.0, 1000+playerid, -1, playerid);
	ApplyDynamicActorAnimation(player_registerSkin[playerid], "COP_AMBIENT", "COPLOOK_NOD", 4.0999999046326, true, true, true, true, 0);
	return 1;
}
stock register_CreateActor(playerid)
{
	for(new i; i < 5; i++)
	{
		if(player_registerActor[playerid][i] != -1) DestroyDynamicActor(player_registerActor[playerid][i]), player_registerActor[playerid][i] = -1;
	}
	player_registerActor[playerid][0] = CreateDynamicActor(59, 232.45919799805, 2769.0559082031, 12.978400230408, 356.56329345703, 1, 100.0, 1000+playerid, 0, playerid);
	ApplyDynamicActorAnimation(player_registerActor[playerid][0], "PLAYIDLES", "SHIFT", 4.0999999046326, true, false, false, true, 1);
	
	player_registerActor[playerid][1] = CreateDynamicActor(63, 230.22230529785, 2767.7995605469, 12.978400230408, 357.80670166016, 1, 100.0, 1000+playerid, 0, playerid);
	ApplyDynamicActorAnimation(player_registerActor[playerid][1], "ON_LOOKERS", "wave_loop", 4.0999999046326, true, false, false, true, 1);

	player_registerActor[playerid][2] = CreateDynamicActor(44, 234.16529846191, 2771.73828125, 13.392200469971, 269.26779174805, 1, 100.0, 1000+playerid, 0, playerid);
	ApplyDynamicActorAnimation(player_registerActor[playerid][2], "MISC", "SEAT_LR", 4.0999999046326, true, false, false, true, 1);

	player_registerActor[playerid][3] = CreateDynamicActor(8, 235.93530273438, 2771.73828125, 13.392200469971, 268.39041137695, 1, 100.0, 1000+playerid, 0, playerid);
	ApplyDynamicActorAnimation(player_registerActor[playerid][3], "MISC", "SEAT_LR", 4.0999999046326, true, false, false, true, 1);

	player_registerActor[playerid][4] = CreateDynamicActor(21, 234.20989990234, 2772.4831542969, 13.392200469971, 86.635597229004, 1, 100.0, 1000+playerid, 0, playerid);
	ApplyDynamicActorAnimation(player_registerActor[playerid][4], "MISC", "SEAT_LR", 4.0999999046326, true, false, false, true, 1);
	return 1;
}
stock player_RegisterCharacter(playerid, eventid, defaultid, &skinid)
{
	if(strlen(PI[playerid][pPassword]) < 6) return 0;
	if(eventid == 0) //change skin
	{
		PI[playerid][pSex] = (defaultid == 0 ? false : true);
		if(defaultid == 0)
		{
			static const skin_data[] = {78,135,137,212,213,230,15327,15353,15354,15355,15524,15525};
			ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setSkins(\"[78,135,137,212,213,230,15327,15353,15354,15355,15524,15525]\")");
			register_SetPlayerSkin(playerid, skin_data[skinid]);
		}
		else 
		{
			static const skin_data[] = {89,15345,15352,88,39,38,75,15522};
			ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setSkins(\"[89,15345,15352,88,39,38,75,15522]\")");
			register_SetPlayerSkin(playerid, skin_data[skinid]); //triazov
		}
	}
	else //accept register
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setRegistrationStage(3)");
	}
	return 1;
}
//"interface("Authorization").setError("referral", "Такой игрок не зарегистрирован")"
stock CheckStringOnWhiteSpace(const string[])
{
	for(new i; i < strlen(string); i++)
	{
		switch(string[i])
		{
			case ' ': return 0;
		}
	}
	return 1;
}
stock player_RegisterData(playerid, email[], password_first[], const password_second[])
{
	//printf("%i", strlen(password_first));
	//"interface("Authorization").setError("password", "Некорректный пароль")"
	if(!CheckStringOnWhiteSpace(password_first))
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"password\", \"Некорректный пароль\")");
	}
	else if(!CheckStringOnWhiteSpace(email))
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"email\", \"Некорректный емайл\")");
	}
	else if(!GetString(password_first, password_second))
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"password\", \"Пароли не совпадают\")");
	}
	else if(strlen(password_first) < 6)
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"password\", \"В пароле меньше 6 символов\")");
	}
	else if(strlen(password_first) > 24)
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"password\", \"В пароле больше 24 символов\")");
	}
	else if(strlen(email) < 6)
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"email\", \"Некорректный емайл\")");
	}
	else if(strlen(email) > 59)
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"email\", \"Некорректный емайл\")");
	}
	else
	{
		if(player_AntiFlood[playerid][1]-global_time > 0) return 0;
		player_AntiFlood[playerid][1] = global_time+3;
		mysql_escape_string(email, PI[playerid][pEmail], 61);

		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) FROM `players` WHERE `Email` = '%s' LIMIT 1;", PI[playerid][pEmail]);
		new Cache:result = mysql_query(mysql, str_q);
		static count;
		cache_get_int(0, "COUNT(*)", count);
		cache_delete(result);
		if(!count)
		{
			mysql_escape_string(password_first, PI[playerid][pPassword], 25);
			ExecutePacket(playerid, webUpdate, "interface('Authorization').setRegistrationStage(2)");
		}
		else
		{
			SetString(PI[playerid][pEmail], "");
			ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"email\", \"Этот email уже используется\")");
		}
	}
	return 1;
}
stock player_RegisterEnd(playerid, name[])
{
	if(!CheckStringOnWhiteSpace(name))
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"referral\", \"Такой игрок не зарегистрирован\")");
	}
	else
	{
		if(strlen(name) > 4 && strlen(name) < 24)
		{
			mysql_escape_string(name, PI[playerid][pNickName_Referal], 24);
		}
		if(player_AntiFlood[playerid][1]-global_time > 0) return 0;
		if(strlen(PI[playerid][pNickName_Referal]) > 4)
		{
			player_AntiFlood[playerid][1] = global_time+6;
			str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) FROM `players` WHERE `NickName` = '%s' LIMIT 1;", PI[playerid][pNickName_Referal]);
			new Cache:result = mysql_query(mysql, str_q);
			static count;
			cache_get_int(0, "COUNT(*)", count);
			cache_delete(result);
			if(!count)
			{
				//тут выводить ошибку
				ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").setError(\"referral\", \"Некорректный ник пригласившего игрока\")");
				return 1;
			}
		}
		player_AntiFlood[playerid][1] = global_time+60;
		//insert acc
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) FROM `players` WHERE `NickName` = '%s' LIMIT 1;", PN(playerid));
		mysql_tquery(mysql, str_q, "player_RegisterFinished", "i", playerid);
	}
	return 1;
}
public: player_RegisterFinished(playerid)
{
	static count;
	cache_get_int(0, "COUNT(*)", count);

	if(!count)
	{
		if(strlen(PI[playerid][pPassword]) < 6 || strlen(PI[playerid][pPassword]) > 25)
		{
			printf("%s[%i] при регистрации аккаунта ошибка с паролем. [%s]", PN(playerid), playerid, PI[playerid][pPassword]);
		}
		else
		{
			ExecutePacket(playerid, webOpen, "Overlay", "[1000, 2300]");
			str_q[0] = EOS, f(str_q, sizeof(str_q), "\
						INSERT INTO `players` (`NickName`, `NickName_Referal`, `Sex`, `Password`, `Register_IP`, `Last_IP`, `Accept_IP`, `Email`, `Skin`, `Register_Time`) VALUES \
						('%s', '%s', '%i', '%s', '%s', '%s', '%s', '%s', '%i', '%i')", PN(playerid), PI[playerid][pNickName_Referal], PI[playerid][pSex], \
							PI[playerid][pPassword], PI[playerid][pIP], PI[playerid][pIP], PI[playerid][pIP], PI[playerid][pEmail], PI[playerid][pSkin], global_time);
			mysql_tquery(mysql, str_q, "player_registerDataEnd", "i", playerid);
			count_register++;
		}
	}
	else
	{
		SCM(playerid, -1, !"При загрузке аккаунта произошла ошибка! #2931Af");
		ExecutePacket(playerid, webClose, "Authorization");
		Kick(playerid);
	}
	return 1;
}
public: player_registerDataEnd(playerid)
{
	PI[playerid][pID] = cache_insert_id();

	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	player_UpdateEx_2[playerid] = SetTimerEx("player_Loading", 2700, false, "ii", playerid, 1);
	return 1;
}
stock player_LoadAccoutMySQL(playerid, IsRegister)
{
	Iter_Add(PlayerPlayersStream[playerid], playerid);
	ExecutePacket(playerid, webClose, "MusicPlayer");
	PI[playerid][pLogged] = true;
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `players` WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q, "player_LoadAccount", "ii", playerid, IsRegister);
	return 1;
}
public: player_LoadAccount(playerid, IsRegister)
{
	if(!player_LoadStaticData(playerid)) return SCM(playerid, -1, !"ПРОИЗОШЛА ОШИБКА ПРИ ЗАГРУЗКЕ АККАУНТА");
	UpdatePlayerDataInt(playerid, "PlayerID", playerid);
	SetPlayerHealth(playerid, PI[playerid][pHealth]);
	SetPlayerArmour(playerid, PI[playerid][pArmour]);
	SetPlayerSkillsInit(playerid);
	SetPlayerScore(playerid, GetPlayerLevel(playerid));
	SetPlayerSuspectInit(playerid);
	ResetPlayerMoney(playerid);
	//GivePlayerMoney(playerid, player_Cash[playerid]);
	//spawn
	player_Spawn(playerid);
	//ExecutePacket(playerid, webUpdate, "stopSound(1)");
	ExecutePacket(playerid, webUpdate, "stopSound()");
	ExecutePacket(playerid, webUpdate, "client.setChatStatus(true)");
	ExecutePacket(playerid, webUpdate, "showInterface('Hud')");
	ExecutePacket(playerid, webUpdate, "window.setPlayerConnectedStatus(1);");
	ExecutePacket(playerid, webUpdate, "interface('Phone').clearContacts()");
	ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerVipStatus(%i)", GetPlayerPremium(playerid))));
	new xpaydayEx = xpayday;
	if(xpaydayEx > 3) xpaydayEx = 3;
	new Chips;
	Chips = GetInvCount(playerid, 293);
	ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerNickName('%s') || window.setPlayerLevel('%i') || window.setPlayerPassedHours('0') || window.setPlayerMoney('%s') || window.setPlayerBankMoney('%i') || window.setPlayerDonate('%i') || window.setGameVersion('%s') || window.setPlayerSkinId('%i') || window.setCurrentServer('%i') || window.setTelegramBotConnectUrl('https://t.me/HasslePlusBot') || window.setActionRedirectUri('https://radmir.online/login?server=14&username=Stas_Podkovka&password=') || window.setDonatePaymentUrl('https://radmir.online/shop?server=14&username=Stas_Podkovka') || window.setPlayerCasinoChips('%i') || window.setPlayerVipStatus(%i) || window.setVKBotConnectUrl('https://vk.me/radmircrmp')", PN(playerid), GetPlayerLevel(playerid), GetStrMoney(playerid), GetPlayerBankMoney(playerid), PI[playerid][pCash_Donate], VERSION_SERVER, PI[playerid][pSkin], NUMBER_SERVER, Chips, GetPlayerPremium(playerid))));
	ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').setBonus(%i)", xpaydayEx)));
	ExecutePacket(playerid, webUpdate, "window.updateConfigurationBannedMessage(1)");
	ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').updateHungerLevel(%i)", floatround(PI[playerid][pHunger]))));
	//else
	if(IsRegister == 1)
	{
		SPD(playerid, 0, 0, "{C0D897}Подсказка", "\
				{EBEBEB}Неподалеку от Вас находится {F6C092}квестовый персонаж\n\
				{EBEBEB}у которого Вы можете получить специальные\n\
				{F6C092}обучающие задания{EBEBEB}.\n\n\
				Квесты не только познакомят Вас с сервером но и\n\
				наделят игровыми ценностями, для старта.", "Понял","");
		
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "Игрок %s зарегистрировался на сервере. IP: %s", str_log, PI[playerid][pIP]);
		SendLog(0, str_log);
	}
	else
	{
		GameTextForPlayerEx(playerid, (str_f("~y~Добро пожаловать~n~~b~%s", PN(playerid))), 3000, 2);

		//DailyRewards_SetData();
		//ExecutePacket(playerid, webOpen, "DailyRewards", (str_f("[0,-1,\"2 часа \",[%s]]", str_1)));
		UpdatePlayerDataStr(playerid, "Last_IP", PI[playerid][pIP]);
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) AS CountNotif FROM `player_Notification` WHERE `Owner` = '%s' LIMIT 1;", PN(playerid));
		mysql_tquery(mysql, str_q, "player_CheckPlayerNotif", "i", playerid);
		if(GetString(PI[playerid][pID_Telegram], "-1")) SCM(playerid,-6274817, "Привяжите {40A0FF}Telegram{FFA040} к аккаунту (Главное меню -> Настройки) и получите {F7CD10}VIP GOLD{FFA040} бесплатно");
		if(PI[playerid][pReturnMoney] > 0) 
		{
			//609f78
			SCM(playerid, 0xf8f738FF, "Вашу собственность забрали за неуплату");
			SCM(playerid, 0xf8f738FF, "Используйте {609f78}/returnmoney {f8f738}чтобы вернуть деньги");
		}
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "Игрок %s авторизовался на сервере. old IP: [%s], new IP: [%s], serialId: [%s], hashID: [%s]", str_log, PI[playerid][pIP], PI[playerid][pAccept_IP], player_Hardware_SerialID[playerid], player_Hardware_HashID[playerid]);
		SendLog(0, str_log);

		if(PI[playerid][pWarn] > 0)
		{
			if(global_time > PI[playerid][pWarnTime])
			{
				PI[playerid][pWarn] = 0;
				PI[playerid][pWarnTime] = 0;
			}
			else
			{
				SCMf(playerid, 0xFF6600FF, "Количество предупреждений: %d из 3", PI[playerid][pWarn]);
				SCM(playerid, 0xFF6600FF, "После 3 предупреждения аккаунт будет заблокирован");
				fraction_InvitePlayer(playerid, 0);
			}
		}
		//увед на финку
		new bool:count;
		for(new i; i < TOTAL_BUSINESSES; i++)
		{
			if(!GetString(BizData[i][bOwner], PN(playerid)) || BizData[i][bProducts] > 0) continue;
			SCMf(playerid, 0xc7dae8FF, "Уведомление: {ffffff}В вашем бизнесе №%i не хватает товаров, поэтому прибыль не будут поступать.", i);
			count = true;
		}
		if(count != false)
		{
			SCM(playerid, 0xc7dae8FF, "Уведомление: {ffffff}Для поддержания работы бизнесов закупите необходимые продукты в меню ( /business ).");
		}
		player_LoadAks{playerid} = 3;
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) AS count FROM `player_Fines` WHERE `NickName` = '%s' AND (UNIX_TIMESTAMP(NOW())-`time` > 259200) LIMIT 1;", PN(playerid));
		mysql_tquery(mysql, str_q, "player_CheckFines", "i", playerid);
		//SCM(playerid, 0xffa500FF, "Компенсация за наши косяки, начислена на ваш аккаунт, приятной игры!");
	}
	player_Connect_FamilyCapture(playerid);
	player_UpdateFamily(playerid);
	player_FractionInit(playerid, PI[playerid][pMember_ID]);
	for(new i; i < 16; i++) player_Setting_Apply(playerid, i);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) AS CountHash FROM `BanHWID_List` WHERE `Serial` = '%s' AND `Hash` = '%s' LIMIT 1;", player_Hardware_SerialID[playerid], player_Hardware_HashID[playerid]);
	mysql_tquery(mysql, str_q, "player_CheckPlayerHwid", "i", playerid);
	UpdatePlayerDataInt(playerid, "Last_LoginTime", global_time);
	player_AntiFlood[playerid][10] = global_time+600;
	PI[playerid][pLevel_VIP] = 1;
	SCM(playerid, 0x1683FFFF, "[АВТОДОНАТ] {FFFFFF}Задонатить на сервер можно через основателя проекта! "SITE_SERVER"");
	TogglePlayerControllable(playerid,true);
	//if((global_time-PI[playerid][pLast_LoginTime]) < 600)
	
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) AS CountBanIP FROM `BanIp_List` WHERE `IP` = '%s' LIMIT 1;", PI[playerid][pIP]);
	mysql_tquery(mysql, str_q, "player_CheckPlayerIp", "i", playerid);
	player_GangZone_Show(playerid);
	player_Hud_MoneyUpdate(playerid);
	return 1;
}
public: player_CheckPlayerNotif(playerid)
{
	static count;
	cache_get_int(0, "CountNotif", count);
	if(count > 0) ExecutePacket(playerid, webOpen, "Notification", (str_f("[0, %i]", count)));
	return 1;
}
stock player_UpdateFamily(playerid)
{
	if(player_Family3DLabel[playerid] != Text3D:-1) DestroyDynamic3DTextLabel(player_Family3DLabel[playerid]);
	player_Family3DLabel[playerid] = Text3D:-1;
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		Iter_Add(PlayersFamily, playerid);
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{%s}%s", FamilyColorData[FamilyData[id][fColor]], FamilyData[id][fName]);
		//0.8700
		player_Family3DLabel[playerid] = CreateDynamic3DTextLabel(str_mes, 0xFDE910FF, 0.000000, 0.000000, 0.4700, 7.5000, playerid);
	}
	else Iter_Remove(PlayersFamily, playerid);
	player_UpdatePerson(playerid);
	return 1;
}
stock player_UpdatePerson(playerid)
{
	player_UpdateVisuals(playerid);
	//player_UpdateAcs(playerid);
	return 1;
}
stock player_UpdateVisuals(playerid)
{
	new bool:add;
	if(PI[playerid][pFamily_ID] != -1)
	{
		new id = GetFamilyID(PI[playerid][pFamily_ID]);
		if(id >= 0)
		{
			if(FamilyData[id][fGang] != false)
			{
				SetPlayerSkin(playerid, PI[playerid][pSkin]);
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "0x%s80", FamilyColorData[FamilyData[id][fColor]]);
				SetPlayerColor(playerid, HexStr(str_mes));
				add = true;
			}
		}
	}
	else if(PI[playerid][pMember_ID] != 0)
	{
		if(PI[playerid][pMember_Duty] != false)
		{
			SetPlayerSkin(playerid, PI[playerid][pMember_Skin]);
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "0x%s80", FractionStaticData[PI[playerid][pMember_ID]][frColor]);
			SetPlayerColor(playerid, HexStr(str_mes));
			add = true;
		}
	}
	if(!add)
	{
		SetPlayerSkin(playerid, PI[playerid][pSkin]);
		SetPlayerColor(playerid, 0xFFFFFF11);
	}
	return 1;
}
public: player_LoadStaticData(playerid)
{
	if(!cache_num_rows()) return 0;
	cache_get_int(0, "ID", PI[playerid][pID]); //-1; //id в бд
	//SetString(PI[playerid][pNickName], "");
	cache_get_string(0, "NickName_Referal", PI[playerid][pNickName_Referal]); //-1; //реферал
	cache_get_int(0, "Sex", PI[playerid][pSex]); //false; //psex == false ? мужик : женск
	cache_get_string(0, "Password", PI[playerid][pPassword]);
	//SetString(PI[playerid][pIP], "");
	cache_get_string(0, "Register_IP", PI[playerid][pRegister_IP]);
	cache_get_string(0, "Accept_IP", PI[playerid][pAccept_IP]);
	cache_get_string(0, "Email", PI[playerid][pEmail]);
	cache_get_int(0, "Email_Accept", PI[playerid][pEmail_Accept]); //false;
	cache_get_int(0, "Skin", PI[playerid][pSkin]); //0; //скин на игроке
	//cache_get_int(0, "Cash", PI[playerid][pCash]); //0;		// деньги игрока
	cache_get_bigint(0, "Cash", player_Cash[playerid]);
	cache_get_int(0, "Bank", PI[playerid][pBank]); //0;			// деньги в банке
	cache_get_int(0, "Admin", PI[playerid][pAdmin]); //0;		// уровень админки
	cache_get_int(0, "Level_RP", PI[playerid][pLevel_RP]); //0;        // уровень рп
	cache_get_int(0, "ArmyTicket", PI[playerid][pArmyTicket]); //false; //военный билет
	cache_get_int(0, "MedCard", PI[playerid][pMedCard]); //false;
	cache_get_int(0, "MedCard_Status", PI[playerid][pMedCard_Status]); //0;
	cache_get_int(0, "Family_ID", PI[playerid][pFamily_ID]); //-1;
	cache_get_int(0, "Family_Rang", PI[playerid][pFamily_Rang]); //0;
	cache_get_int(0, "License_Driving", PI[playerid][pLicense_Driving]); //0;	// лицензия на управление авто
	cache_get_int(0, "License_Weapon", PI[playerid][pLicense_Weapon]); //0;	// лицензия на оружие
	cache_get_int(0, "Level", PI[playerid][pLevel]); //0;		// уровень игрока
	cache_get_int(0, "Exp", PI[playerid][pExp]); //0;			// очки опыта игрока
	cache_get_int(0, "Level_Suspect", PI[playerid][pLevel_Suspect]); //0;		// уровень розыска
	cache_get_int(0, "Phone_Number", PI[playerid][pPhone_Number]); //0;		// номер телефона
	cache_get_int(0, "Phone_Cash", PI[playerid][pPhone_Cash]); //0;// на счету телефона
	cache_get_int(0, "Wanted", PI[playerid][pWanted]); //0;	// законопослушность
	cache_get_int(0, "Improvements", PI[playerid][pImprovements]); //0; // улучшения
	cache_get_string(0, "NickName_Wife", PI[playerid][pNickName_Wife]);
	cache_get_int(0, "Member_ID", PI[playerid][pMember_ID]); //0;			// организация
	cache_get_int(0, "Member_Rang", PI[playerid][pMember_Rang]); //0;
	cache_get_int(0, "Member_Skin", PI[playerid][pMember_Skin]); //0;		// скин организации
	//cache_get_int(0, "", PI[playerid][pMember_Duty]); //false;
	//jobs
	str_1[0] = EOS;
	cache_get_string(0, "Job_ID", str_1);
	sscanf(str_1, "p<,>a<i>[3]", PI[playerid][pJob_ID]);

	str_1[0] = EOS;
	cache_get_string(0, "Job_BizID", str_1);
	sscanf(str_1, "p<,>a<i>[3]", PI[playerid][pJob_BizID]);

	str_1[0] = EOS;
	cache_get_string(0, "Job_Style", str_1);
	sscanf(str_1, "p<,>a<i>[3]", PI[playerid][pJob_Style]);

	cache_get_int(0, "FWarn", PI[playerid][pFWarn]); //0;        // выговоры
	// -------------------------
	cache_get_int(0, "Last_LoginTime", PI[playerid][pLast_LoginTime]); //0;	// время последнего входа\выхода
	// -------------------------
	cache_get_int(0, "GameTime_forHour", PI[playerid][pGameTime_forHour]); //0;	// время игры за час
	cache_get_int(0, "GameTime_forAll", PI[playerid][pGameTime_forAll]); //0;	// время игры за час
	cache_get_int(0, "GameTime_forDay_0", PI[playerid][pGameTime_forDay][0]);
	cache_get_int(0, "GameTime_forDay_1", PI[playerid][pGameTime_forDay][1]);
	cache_get_int(0, "GameTime_forDay_2", PI[playerid][pGameTime_forDay][2]);
	cache_get_int(0, "GameTime_forDay_3", PI[playerid][pGameTime_forDay][3]);
	cache_get_int(0, "GameTime_forDay_4", PI[playerid][pGameTime_forDay][4]);
	cache_get_int(0, "GameTime_forDay_5", PI[playerid][pGameTime_forDay][5]);
	cache_get_int(0, "GameTime_forDay_6", PI[playerid][pGameTime_forDay][6]);
	cache_get_float(0, "Health", PI[playerid][pHealth]); //0.0;// хп игрока
	if(PI[playerid][pHealth] < 10) PI[playerid][pHealth] = 25;
	else if(PI[playerid][pHealth] > 100) PI[playerid][pHealth] = 100;

	cache_get_float(0, "Hunger", PI[playerid][pHunger]); //0.0;
	if(PI[playerid][pHunger] < 1) PI[playerid][pHunger] = 0;
	else if(PI[playerid][pHunger] > 100) PI[playerid][pHunger] = 100;
	// -------------------------
	//cache_get_int(0, "", PI[playerid][pLogged]); //false;				// статус авторизации
	cache_get_int(0, "Warn", PI[playerid][pWarn]); //0;             // варны
	cache_get_int(0, "WarnTime", PI[playerid][pWarnTime]); //0;        // время варнов
	cache_get_int(0, "MuteTime", PI[playerid][pMuteTime]); //0;             // время мута

	//pLevel_Skill
	str_1[0] = EOS;
	cache_get_string(0, "Level_Skill", str_1);
	sscanf(str_1, "p<,>a<i>[12]", PI[playerid][pLevel_Skill]);
	for(new i; i < 12; i++) PI[playerid][pLevel_Skill][i] = 100;
	
	cache_get_int(0, "Spawn_Type", PI[playerid][pSpawn_Type]); //0; //тип где спавниться
	cache_get_int(0, "Spawn_UID", PI[playerid][pSpawn_UID]); //-1;	//spawn
	// -------------------------
	cache_get_int(0, "Cash_Donate", PI[playerid][pCash_Donate]); //0;	// текущий баланс донат-очков
	// -------------------------
	cache_get_int(0, "Hospital", PI[playerid][pHospital]); //false;	// лежит ли в больнице
	//cache_get_int(0, "", PI[playerid][pTemp_Cuffed]); //false;		// наручники на игроке
	cache_get_int(0, "JailTime", PI[playerid][pJailTime]); //0;				// время заключения
	cache_get_int(0, "Level_VIP", PI[playerid][pLevel_VIP]); //0;			// уровень премиум аккаунта
	cache_get_int(0, "Level_VIP_Time", PI[playerid][pLevel_VIP_Time]); //0;		// время действия премиум аккаунта
	cache_get_int(0, "Charity", PI[playerid][pCharity]); //0;
	cache_get_string(0, "Password_Admin", PI[playerid][pPassword_Admin]);
	//
	str_1[0] = EOS;
	cache_get_string(0, "PropertySlots", str_1);
	sscanf(str_1, "p<,>a<i>[5]", PI[playerid][pPropertySlots]);
	//
	cache_get_int(0, "RewardTime", PI[playerid][pRewardTime]); //0;
	//
	str_1[0] = EOS;
	cache_get_string(0, "Settings", str_1);
	sscanf(str_1, "p<,>a<i>[16]", PI[playerid][pSettings]);
	//
	cache_get_int(0, "Voice_Volume", PI[playerid][pVoice_Volume]); //100;
	cache_get_int(0, "Level_Tatto", PI[playerid][pLevel_Tatto]); //0;
	if(PI[playerid][pLevel_Tatto] > sizeof(TattoStaticData)-1) PI[playerid][pLevel_Tatto] = sizeof(TattoStaticData)-1;
	else if(PI[playerid][pLevel_Tatto] < 0) PI[playerid][pLevel_Tatto] = 0;

	cache_get_int(0, "JailTime_Gen", PI[playerid][pJailTime_Gen]); //0;
	cache_get_string(0, "ID_Telegram", PI[playerid][pID_Telegram]); //-1;
	cache_get_string(0, "NickName_Telegram", PI[playerid][pNickName_Telegram]);
	cache_get_int(0, "ReturnMoney", PI[playerid][pReturnMoney]);

	cache_get_float(0, "Armour", PI[playerid][pArmour]); //0.0;
	if(PI[playerid][pArmour] < 0) PI[playerid][pArmour] = 0;
	else if(PI[playerid][pArmour] > 100) PI[playerid][pArmour] = 100;
	cache_get_int(0, "YouTube", PI[playerid][pYouTube]);
	cache_get_int(0, "RMuteTime", PI[playerid][pRMuteTime]); //0;             // время мута
	cache_get_int(0, "VMuteTime", PI[playerid][pVMuteTime]); //0;             // время мута
	cache_get_int(0, "VC_muteTime", PI[playerid][pVC_muteTime]); //0;             // время мута

	cache_get_int(0, "Jail_Arrest", PI[playerid][pJail_Arrest]); //0;
	cache_get_int(0, "Radio_Channel", PI[playerid][pRadio_Channel]); //0;
	cache_get_int(0, "Phone_Sounds", PI[playerid][pPhone_Sounds]); //0;
	cache_get_int(0, "Reputation", PI[playerid][pRep]);
	cache_get_int(0, "RepInfo", PI[playerid][pRepInfo]);
	player_LoadInventory(playerid);
	return 1;
}
stock player_GetSpawnInfo(playerid, bool:set=true)
{
	//SCMf(playerid, -1, "%i playerid, %i set", playerid, set);
	static Float:Position[4];
	new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
	if(OpenInterface[playerid][128] != false)
	{
		SetSpawnInfoEx(playerid, player_ChangeWheel_Pos[playerid][0], player_ChangeWheel_Pos[playerid][1], player_ChangeWheel_Pos[playerid][2], player_ChangeWheel_Pos[playerid][3]);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
		return 1;
	}
	if((PI[playerid][pLast_Position][0] + PI[playerid][pLast_Position][1] + PI[playerid][pLast_Position][2]) > 0)
	{
		SetSpawnInfo(playerid, 1, GetSkinEx(playerid), PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2], PI[playerid][pLast_Position][3], 0, 0, 0, 0, 0, 0);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerInterior(playerid, 0);
		if(set != false)
		{
			player_LastPosition_Clear{playerid} = 3;
		}
		return 1;
	}
	if(noclipdata[playerid][FLYOFF] == true)
	{
		CancelEdit(playerid);
		DestroyPlayerObject(playerid, noclipdata[playerid][flyobject]);
		noclipdata[playerid][cameramode] = CAMERA_MODE_NONE;
		Position[0] = noclipdata[playerid][APOSX];
		Position[1] = noclipdata[playerid][APOSY];
		Position[2] = noclipdata[playerid][APOSZ];
		Position[3] = 0.0;
		SetSpawnInfo(playerid, 1, GetSkinEx(playerid), Position[0], Position[1], Position[2], Position[3], 0, 0, 0, 0, 0, 0);
		if(set != false)
		{
			noclipdata[playerid][FLYOFF_timeOut] = 3;
		}
		return 1;
	}
	if(PI[playerid][pSpawn_Type] == 1) //дом
	{
		new id = PI[playerid][pSpawn_UID];
		if(id == -1) 
		{
			PI[playerid][pSpawn_Type] = 0;
			UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
		}
		else if(!GetString(HouseData[id][hOwner], PN(playerid))) 
		{
			PI[playerid][pSpawn_Type] = 0;
			PI[playerid][pSpawn_UID] = -1;
			SCM(playerid, 0xADCEEAFF, !"Ваш дом больше не является вашим местом проживания, и место возрождения было изменено.");
			UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
			UpdatePlayerDataInt(playerid, "Spawn_UID", -1);
		}
	}
	else if(PI[playerid][pSpawn_Type] == 6) //гараж
	{
		new id = PI[playerid][pSpawn_UID];
		if(id == -1)
		{
			PI[playerid][pSpawn_Type] = 0;
			UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
		}
		else if(!GetString(GarageData[id][gOwner], PN(playerid))) 
		{
			PI[playerid][pSpawn_Type] = 0;
			PI[playerid][pSpawn_UID] = -1;
			SCM(playerid, 0xADCEEAFF, !"Ваш гараж больше не является вашим местом проживания, и место возрождения было изменено.");
			UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
			UpdatePlayerDataInt(playerid, "Spawn_UID", -1);
		}
	}
	else if(PI[playerid][pSpawn_Type] == 3 && !PI[playerid][pMember_ID]) //орг
	{
		new bool:setEx;
		if(idEx >= 0)
		{
			if(FamilyData[idEx][fGang] != false)
			{
				if(FamilyData[idEx][fGang_BaseID] != -1)
				{
					PI[playerid][pSpawn_UID] = FamilyData[idEx][fGang_BaseID];
					setEx = true;
				}
			}
		}
		if(!setEx)
		{
			PI[playerid][pSpawn_Type] = 0;
			SCM(playerid, 0xADCEEAFF, !"База вашей фракции больше не является вашим местом возрождения, и место было изменено.");
			UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
		}
	}
	if(PI[playerid][pSpawn_Type] == 3 && PI[playerid][pSpawn_UID] == -1)
	{
		if(idEx >= 0)
		{
			if(FamilyData[idEx][fGang] != false)
			{
				if(FamilyData[idEx][fGang_BaseID] != -1)
				{
					PI[playerid][pSpawn_Type] = 0;
					SCM(playerid, 0xADCEEAFF, !"База вашей банды больше не является вашим местом возрождения, и место было изменено.");
					UpdatePlayerDataInt(playerid, "Spawn_Type", 0);
				}
			}
		}
	}

	//set data
	if(player_SpectateData[playerid][sdPlayerID] != -1)
	{
		for(new i; i < 4; i++)
		{
			Position[i] = player_SpectateData[playerid][sdPosition][i];
		}
		if(set)
		{
			player_SpectateData[playerid][sdTimeOut] = 2;
		}
	}
	else if(PI[playerid][pJailTime] > 0)
	{
		if(!PI[playerid][pJail_Arrest])
		{
			Position[0] = 833.6302+random(4);
			Position[1] = 1319.9875+random(4);
			Position[2] = 517.7500+random(2);
			Position[3] = 248.0000;
			if(set)
			{
				SetPlayerVirtualWorld(playerid, 1290);
				SetPlayerInterior(playerid, 5);
			}
		}
		else
		{
			static const Float:posX[] = {2488.0, 2493.2595, 2498.9465};
			Position[0] = posX[random(sizeof(posX))];
			Position[1] = 1378.5+random(2);
			Position[2] = 1000.5;
			Position[3] = 0.0000;
			if(set)
			{
				SetPlayerVirtualWorld(playerid, 6);
				SetPlayerInterior(playerid, 4);
			}
		}
	}
	else
	{
		switch(PI[playerid][pSpawn_Type])
		{
			case 1: //дома
			{
				new id = PI[playerid][pSpawn_UID];
				for(new i; i < 4; i++)
				{
					Position[i] = HouseStaticData[HouseData[id][hInterior]][hsExit][i];
				}
				if(set)
				{
					SetPlayerVirtualWorld(playerid, id+5);
					SetPlayerInterior(playerid, HouseStaticData[HouseData[id][hInterior]][hsInterior]);
					player_HouseEntered[playerid] = id;
					player_EnterHouse[playerid] = -1;
				}
			}
			case 3: //в организации
			{
				new bool:setEx;
				if(idEx >= 0)
				{
					if(FamilyData[idEx][fGang] != false)
					{
						if(FamilyData[idEx][fGang_BaseID] != -1)
						{
							new id = PI[playerid][pSpawn_UID];
							for(new i; i < 4; i++)
							{
								Position[i] = HouseStaticData[HouseData[id][hInterior]][hsExit][i];
							}
							if(set)
							{
								SetPlayerVirtualWorld(playerid, id+5);
								SetPlayerInterior(playerid, HouseStaticData[HouseData[id][hInterior]][hsInterior]);
								player_HouseEntered[playerid] = id;
								player_EnterHouse[playerid] = -1;
							}
							setEx = true;
						}
					}
				}
				if(!setEx)
				{
					new team_id = PI[playerid][pMember_ID];

					for(new i; i < 4; i++)
					{
						Position[i] = FractionStaticData[team_id][frSpawn][i];
					}
					if(set)
					{
						SetPlayerVirtualWorld(playerid, FractionStaticData[team_id][frWorld]);
						SetPlayerInterior(playerid, FractionStaticData[team_id][frInterior]);
					}
				}
			}
			case 6: //гараж
			{
				new id = PI[playerid][pSpawn_UID];
				for(new i; i < 4; i++)
				{
					Position[i] = GarageStaticData[GarageData[id][gInterior]][gsExit][i];
				}
				SetPlayerVirtualWorld(playerid, id+7);
				SetPlayerInterior(playerid, GarageStaticData[GarageData[id][gInterior]][gsInterior]);
				if(set)
				{
					player_GarageEntered[playerid] = id;
					player_EnterGarage[playerid] = -1;
				}
			}
			default:
			{
				static const Float:positionDefault[][] = {
					{436.6064, 1549.3479, 12.3021, 170.0},
					{435.8731, 1539.7163, 12.3021, 170.0},
					{435.9339, 1542.0549, 12.3021, 360.0},
					{451.2428, 1539.0403, 12.3943, 170.0},
					{451.6640, 1548.5179, 12.3943, 170.0},
					{456.1251, 1547.7271, 12.3865, 170.0},
					{455.4001, 1540.1635, 12.3865, 360.0},
					{455.2005, 1538.0597, 12.3865, 180.0},
					{861.3931, 596.8341, 15.9697, 90.0},
					{861.4194, 591.4937, 15.9697, 90.0},
					{861.3803, 602.7628, 15.9697, 90.0},
					{-2459.7266, 2840.4258, 38.5, 90.0},
					{-2460.8936, 2834.1628, 38.5, 0.0}
				};
				new id = random(sizeof(positionDefault));
				for(new i; i < 4; i++)
				{
					Position[i] = positionDefault[id][i];
				}
				if(set)
				{
					SetPlayerVirtualWorld(playerid, 0);
					SetPlayerInterior(playerid, 0);
				}
			}
		}
	}
	if(PI[playerid][pHospital] != false && PI[playerid][pHealth] > 70) PI[playerid][pHospital] = false;
	if(PI[playerid][pHospital] != false)
	{
		new id = random(sizeof(g_med_bed_pos));
		for(new i; i < 3; i++)
		{
			Position[i] = g_med_bed_pos[id][i];
		}
		if(set)
		{
			UpdatePlayerDataInt(playerid, "Hospital", 1);
		}
		SetPlayerVirtualWorld(playerid, 3);
		SetPlayerInterior(playerid, 3);
	}
	if(IsPlayerMobile{playerid} != 0 && set == true) 
	{
		SetPlayerPos(playerid, Position[0], Position[1], Position[2]);
		SetCameraBehindPlayer(playerid);
	}
	SetSpawnInfo(playerid, 1, GetSkinEx(playerid), Position[0], Position[1], Position[2], Position[3], 0, 0, 0, 0, 0, 0);
	return 1;
}
stock player_Spawn(playerid)
{
	if(!player_Paintball_Death(playerid)) return 1;
	if(player_Paintball_DeathEx{playerid} > 0) return 1;
	player_GetSpawnInfo(playerid, false);
	TogglePlayerSpectating(playerid, false);
	SpawnPlayer(playerid);
	OnPlayerInventory_WeaponUpdate(playerid);
	player_GetSpawnInfo(playerid, true);
	player_LoadAks{playerid} = 3;
	return 1;
}
stock player_AuthEnd(playerid, const password[])
{
	if(strlen(PI[playerid][pPassword]) < 6 || strlen(password) < 6) return 0;
	if(!GetString(password, PI[playerid][pPassword]))
	{
		ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").$refs.auth.setError(\"password\", \"Неправильный пароль\")");
		if(PI[playerid][pTemp_PassAttemps] >= 3)
		{
			ExecutePacket(playerid, webClose, "Authorization");
			SPD(playerid, 0, 0, "{FF9933}Лимит попыток авторизации", "{FFFFFF}Вы ввели неправильный пароль 3 раза подряд", "Закрыть", "");
			Kick(playerid);
			return 1;
		}
		PI[playerid][pTemp_PassAttemps]++;
	}
	else 
	{
		if(player_AntiFlood[playerid][1]-global_time > 0) return 0;
		player_AntiFlood[playerid][1] = global_time+60;
		printf("player_AuthEnd(%s[%i], %s)", PN(playerid), playerid, password);
		if(!GetString(PI[playerid][pIP], PI[playerid][pLast_IP]) && !GetString(PI[playerid][pID_Telegram], "-1"))
		{
			printf("player_AuthEnd(%s[%i], %s) code tg", PN(playerid), playerid, password);
			ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").$refs.auth.setStage(3)");
			return 1;
		}
		/*else if(!GetString(PI[playerid][pIP], PI[playerid][pLast_IP]) && !GetString(PI[playerid][pID_Telegram], "-1")) //google
		{
			ExecutePacket(playerid, webUpdate, "interface(\"Authorization\").$refs.auth.setStage(2)");
			return 1;
		}*/
		else if(!GetString(PI[playerid][pIP], PI[playerid][pLast_IP])) //сюда еще гугл можно
		{
			printf("player_AuthEnd(%s[%i], %s) accept yees", PN(playerid), playerid, password);
			SCM(playerid,-196003073, "Ваш аккаунт подозревается во взломе злоумышленниками");
			SCM(playerid,-196003073, "Некоторый функционал будет требовать дополнительное подтверждение по Telegram");
		}
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin`, `Reason`, FROM_UNIXTIME(timeout, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date_out`, FROM_UNIXTIME(timeban, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date_ban`, `timeout` FROM `Ban_List` WHERE `Owner` = '%s' AND `timeout` <= CURRENT_TIMESTAMP() ORDER BY `timeout` DESC LIMIT 1;", PN(playerid));
		mysql_tquery(mysql, str_q, "player_CheckPlayerBan", "i", playerid);
	}
	return 1;
}
public: player_CheckPlayerBan(playerid)
{
	if(cache_num_rows() > 0)
	{
		static timeout;
		cache_get_int(0, "timeout", timeout);
		if(global_time > timeout) player_PreloadAccount(playerid);
		else
		{
			static 
					admin[24],
					reason[24],
					data_out[24],
					data_ban[24];
			
			cache_get_string(0, "Admin", admin);
			cache_get_string(0, "Reason", reason);

			cache_get_string(0, "date_out", data_out);
			cache_get_string(0, "date_ban", data_ban);
			SPD(playerid, 0, 0, "{3399FF}"NAME_SERVERRP"", (str_f("\
						{FFFFFF}Этот аккаунт заблокирован\n\n\
						{FFFFFF}Ник администратора: %s\n\
						Причина блокировки: %s\n\
						Дата и время: %s\n\
						Дата и время разблокировки: %s\n\n\
						Если Вы не согласны с наказанием, обратитесь\n\
						в тех. поддержку {FFCD00}"VK_SERVER"{FFFFFF} для более\n\
						подробного выяснения сложившейся ситуации.\n\n\
						Введите {FFCD00}/q (/quit) {FFFFFF}чтобы выйти", admin, reason, data_ban, data_out)),\
						 "Закрыть", "");
			Kick(playerid);
		}
	}
	else player_PreloadAccount(playerid);
	return 1;
}
stock player_PreloadAccount(playerid)
{
	ExecutePacket(playerid, webClose, "Authorization");
	count_connect++;
	printf("player_AuthEnd(%s[%i]) accept player_PreloadAccount", PN(playerid), playerid);
	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	player_UpdateEx_2[playerid] = SetTimerEx("player_Loading", 2700, false, "ii", playerid, 0);
	ExecutePacket(playerid, webOpen, "Loading", "[3000]");
	return 1;
}
public: player_Loading(playerid, IsRegister)
{
	ExecutePacket(playerid, webClose, "Authorization");
	if(player_UpdateEx_2[playerid] != -1) KillTimer(player_UpdateEx_2[playerid]), player_UpdateEx_2[playerid] = -1;
	if(!IsRegister)
	{
		if((global_time-PI[playerid][pLast_LoginTime]) < 600)
		{
			if((PI[playerid][pLast_Position][0] + PI[playerid][pLast_Position][1] + PI[playerid][pLast_Position][2]) > 0 && PI[playerid][pLast_Position][2] < 150)
			{
				SPD(playerid, 20375, 0, "{FFCD00}Восстановление позиции", "{FFFFFF}Хотите вернуться на место последнего выхода из игры?", "Да","Нет");
				return 1;
			}
		}
	}
	for(new i; i < 4; i++) PI[playerid][pLast_Position][i] = 0.0;
	player_LoadAccoutMySQL(playerid, IsRegister);
	return 1;
}
CMD:setspawn(playerid)
{
	if(OpenInterface[playerid][21]) return 1;
	OpenInterface[playerid][21] = true;
	ExecutePacket(playerid, webUpdate, "hideInterface('Hud')");
	ExecutePacket(playerid, webOpen, "SelectSpawn", "[[[\"На ЖД вокзале, автостанции\",1,34],[\"В личном доме\",0,24],[\"В гостиничном номере\",0,52],[\"На базе организации (банды)\",0,101],[\"В гостях (совместное проживание)\",0,24],[\"В доме на колесах\",0,8],[\"В личном гараже\",0,39]]]");
	return 1;
}
stock player_SetSpawn(playerid, listitem)
{
	if(!OpenInterface[playerid][21]) return 1;
	if(listitem == PI[playerid][pSpawn_Type] && PI[playerid][pSpawn_Type] != 1) GameTextForPlayerEx(playerid, "Вы уже выбрали это место в качестве спавна.", 3000, 3);
	else
	{
		switch(listitem)
		{
			case 0: //вокзал
			{
				PI[playerid][pSpawn_Type] = 0;
				UpdatePlayerDataInt(playerid, "Spawn_Type", PI[playerid][pSpawn_Type]);
			}
			case 1: //house
			{
				if(GetPlayerHouses(playerid) <= 0) GameTextForPlayerEx(playerid, "У Вас нет дома.", 3000, 3);
				else
				{
					cmd_house(playerid, 20297);
				}
				return 1;
			}
			case 2: //hotel
			{
				GameTextForPlayerEx(playerid, "Вы не проживаете в гостиничном номере", 3000, 3);
			}
			case 3: //банда или орг
			{
				if(!PI[playerid][pMember_ID])
				{
					new id = GetFamilyID(PI[playerid][pFamily_ID]),
						bool:set;
					if(id >= 0)
					{
						if(FamilyData[id][fGang] != false)
						{
							if(FamilyData[id][fGang_BaseID] != -1)
							{
								PI[playerid][pSpawn_Type] = 3;
								UpdatePlayerDataInt(playerid, "Spawn_Type", PI[playerid][pSpawn_Type]);

								PI[playerid][pSpawn_UID] = FamilyData[id][fGang_BaseID];
								UpdatePlayerDataInt(playerid, "Spawn_UID", PI[playerid][pSpawn_UID]);
								set = true;
							}
							else GameTextForPlayerEx(playerid, "У вашей банды нет базы", 3000, 3);
						}
					}
					if(!set) GameTextForPlayerEx(playerid, "Вы не состоите в организации или банде.", 3000, 3);
				}
				else 
				{
					//FamilyData[id][fGang_BaseID]
					PI[playerid][pSpawn_Type] = 3;
					UpdatePlayerDataInt(playerid, "Spawn_Type", PI[playerid][pSpawn_Type]);
				}
			}
			case 4: //house rooms
			{
				GameTextForPlayerEx(playerid, "Вы не проживаете ни у кого в гостях.", 3000, 3);
			}
			case 6:
			{
				if(!GetPlayerGarages(playerid)) GameTextForPlayerEx(playerid, "У Вас нет гаража.", 3000, 3);
				else cmd_garage(playerid, 20298);
			}
		}
	}
	ExecutePacket(playerid, webClose, "SelectSpawn");
	OpenInterface[playerid][21] = false;
	ExecutePacket(playerid, webUpdate, "showInterface('Hud')");
	SCM(playerid,1973670570, "Место появления в игре изменено.");
	return 1;
}
stock player_SetSpawn_Close(playerid)
{
	if(!OpenInterface[playerid][21]) return 1;
	OpenInterface[playerid][21] = false;
	ExecutePacket(playerid, webClose, "SelectSpawn");
	ExecutePacket(playerid, webUpdate, "showInterface('Hud')");
	return 1;
}
stock player_Main_Close(playerid)
{
	//if(!OpenInterface[playerid][22]) return 1;
	OpenInterface[playerid][22] = false;
	//ExecutePacket(playerid, webClose, "MainMenu");
	return 1;
}
stock player_GetStatusUpdate(playerid)
{
	static const global_playerStatus[][] = {
		{"Новичок"}, //0
		{"Развивающийся"}, //1
		{"Освоившийся"}, //2
		{"Опытный игрок"}, //3
		{"Активный игрок"}, //4
		{"Легендарный"}, //5
		{"Лидер"}, //6
		{"Администратор"} //7
	};
	if(PI[playerid][pAdmin] > 0) f(str_1, sizeof(str_1), "%s(%i уровня)", global_playerStatus[7], PI[playerid][pAdmin]);
	else if(PI[playerid][pMember_Rang] == 10) f(str_1, sizeof(str_1), "%s", global_playerStatus[6]);
	else
	{
		switch(GetPlayerLevel(playerid))
		{
			case 1..5: f(str_1, sizeof(str_1), "%s", global_playerStatus[0]);
			case 6..9: f(str_1, sizeof(str_1), "%s", global_playerStatus[1]);
			case 10..14: f(str_1, sizeof(str_1), "%s", global_playerStatus[2]);
			case 15..19: f(str_1, sizeof(str_1), "%s", global_playerStatus[3]);
			case 20..29: f(str_1, sizeof(str_1), "%s", global_playerStatus[4]);
			default: f(str_1, sizeof(str_1), "%s", global_playerStatus[5]);
		}
	}
}
