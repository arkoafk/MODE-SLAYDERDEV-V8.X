stock player_Main_SettingRequest(playerid, eventid, defaultid)
{
	printf("player_Main_SettingRequest(%i, %i, %i)", playerid, eventid, defaultid);
	switch(eventid)
	{
		case 13: 
		{
			PI[playerid][pVoice_Volume] = defaultid;
			UpdatePlayerDataInt(playerid, "Voice_Volume", PI[playerid][pVoice_Volume]);
		}
		default: 
		{
			PI[playerid][pSettings][eventid] = !PI[playerid][pSettings][eventid];
			player_SaveSettings{playerid} = 3;
		}
	}
	player_Setting_Apply(playerid, eventid);
	return 1;
}
stock player_Setting_Apply(playerid, id)
{
	switch(id)
	{
		//case 0: //[\"Чат организации\",0,%i,0,0,4],
		case 1: //[\"Ники над игроками\",1,%i,0,0,4],
		{
			for(new i; i < GetMaxPlayers(); i++) ShowPlayerNameTagForPlayer(playerid, i, PI[playerid][pSettings][id]);
		}
		//case 2: //[\"Ники в чате\",2,%i,0,0,5],
		//case 3: //[\"ID игроков в чате\",3,%i,0,0,5],
		case 4: //[\"Музыка бумбокса/сабвуфера\",4,%i,0,0,6],
		{
			player_MusicPlayer_Hide(playerid);
		}
		//case 5: //[\"Старый инвентарь\",5,%i,0,0,6],
		//case 6: //[\"Музыка в казино\",6,%i,0,0,7],
		//case 7: //[\"Классический Kill-List\",7,%i,0,0,7],
		case 8: //[\"Подсказка кнопок управления\",8,%i,0,0,8],
		{
			ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').setShowControls(%i)", PI[playerid][pSettings][id])));
		}
		case 9: //[\"Эффекты изменения здоровья\",9,%i,0,0,8],
		{
			ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').setEffectEnabled(%i)", PI[playerid][pSettings][id])));
		}
		//case 10: //[\"Информация о недвижимости\",10,%i,0,0,9],
		case 13: //[\"Громкость голосового чата\",13,%i,1,0,9],
		{
			UpdateExecutePacket(playerid, 6, PI[playerid][pVoice_Volume]);
		}
		case 14: //[\"Затухание чата\",14,%i,0,0,10],
		{
			ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').setCanChatFadeout(%i)", PI[playerid][pSettings][id])));
		}
		case 15: //[\"Отображение чисел в худе\",15,%i,0,0,10]
		{
			ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').setInfoValuesVisible(%i)", PI[playerid][pSettings][id])));
		}
	}
	return 1;
}
stock UpdateExecutePacket(playerid, id, status)
{
    new BitStream:bsn = BS_New();
    BS_WriteValue(bsn, \
			PR_UINT8, 215,
			PR_UINT16, id,
			PR_UINT32, status);
    PR_SendPacket(bsn, playerid);
    BS_Delete(bsn);
}
stock player_Main_ImproveBuy(playerid, eventid)
{
	if(eventid < 0 || eventid > 3) return 0;
	if(PI[playerid][pImprovements] != eventid)
		return SCM(playerid, -1, "Сначала купите предыдущее улучшение.");

	new cost, requiredLevel;
	switch(eventid)
	{
		case 0: cost = 50000, requiredLevel = 5;
		case 1: cost = 75000, requiredLevel = 8;
		case 2: cost = 100000, requiredLevel = 11;
		case 3: cost = 125000, requiredLevel = 15;
	}

	if(PI[playerid][pLevel] < requiredLevel)
		return SCMf(playerid, -1, "Для покупки требуется %i уровень.", requiredLevel);
	if(CompareInt64(playerid, "<", cost))
		return SCM(playerid, -1, "У вас недостаточно средств.");

	GivePlayerMoneyEx(playerid, -cost, "None", true, false);
	PI[playerid][pImprovements]++;
	UpdatePlayerDataInt(playerid, "Improvements", PI[playerid][pImprovements]);
	playerImproveMenu(playerid);
	return 1;
}
enum e_dialog_fMenu
{
	dialog_fName[30],
	dialog_fID,
	bool:dialog_fDostup,
	bool:dialog_fGang
};
static const dialog_fMenu[][e_dialog_fMenu] = {
	{"Состав в игре", 0, false, false},
	{"Полный состав", 1, false, false},
	{"Информация", 2, false, false},
	{"Улучшение банды", 9, true, true},
	{"Статистика", 3, false, false},
	{"Цвет", 4, true, true},
	{"Бизнесы", 5, false, true},
	{"Транспорт", 6, false, true},
	{"История склада", 7, false, true},
	{"Настройка рангов", 10, false, true},
	{"Настройка увольнений", -1, false, true},
	{"История криминального влияния", -1, false, true},
	{"Предупреждения", 8, false, true}
};
CMD:fmenu(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		str_1[0] = EOS;
		new count;
		for(new i; i < sizeof(dialog_fMenu); i++)
		{
			new bool:add;
			if(dialog_fMenu[i][dialog_fGang] != false)
			{
				if(FamilyData[id][fGang] != false) add = true;
			}
			else if(dialog_fMenu[i][dialog_fDostup] != false)
			{
				if(GetString(FamilyData[id][fOwner], PN(playerid))) add = true;
			}
			else add = true;

			//добавляем
			if(add)
			{
				strcat(str_1, (str_f("%i. %s\n", count+1, dialog_fMenu[i][dialog_fName])));
				player_ShowID[playerid][count] = dialog_fMenu[i][dialog_fID];
				count++;
			}
		}
		SPD(playerid, 20312, DIALOG_STYLE_LIST, "{FFCD00}Меню семьи", str_1, "Выбрать","Выйти");
	}
	else SCM(playerid, 0xCECECEFF, "Вы не состоите в семье");
	return 1;
}
stock player_FamilyList(playerid, list = 0)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID`, `NickName` FROM `players` WHERE `Family_ID` = '%i' LIMIT %i, 25", PI[playerid][pFamily_ID], 25*list);
	mysql_tquery(mysql, str_q, "player_FamilyListMySQL", "ii", playerid, list);
	return 1;
}
public: player_FamilyListMySQL(playerid, list)
{
	player_ShowID[playerid][20] = list;
	new count = cache_num_rows();
	str_1[0] = EOS;
	for(new i; i < 25; i++)
	{
		if(i < count)
		{
			cache_get_int(i, "ID", player_ShowData[playerid][i]);
			str_mes[0] = EOS, cache_get_string(i, "NickName", str_mes);
			strcat(str_1, (str_f("%i. %s\n", 1+i+(list*25), str_mes)));
		}
	}
	if(count == 25 && list) strcat(str_1, ">>\n<<");
	else if(count == 25) strcat(str_1, ">>");
	else if(!count) return SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FFCD00}Состав семьи", "{FFFFFF}Пуст", "", "Назад");
	SPD(playerid, 20313, DIALOG_STYLE_LIST, "{FFCD00}Состав семьи", str_1, "Выбрать", "Назад");
	return 1;
}
public: player_Family_CheckOff(playerid)
{
	if(!cache_num_rows())
	{
		player_FamilyList(playerid, player_ShowID[playerid][20]);
		SCM(playerid, COLOR_RED, !"ПРОИЗОШЛА ОШИБКА!!! (Family_CheckOff-2)");
	}
	else
	{
		new id = GetFamilyID(PI[playerid][pFamily_ID]);
		if(id == -1) return 1;
		str_1[0] = EOS;
		str_mes[0] = EOS, cache_get_string(0, !"NickName", str_mes);
		strcat(str_1, (str_f("{FFFFFF}Игрок: %s\n", str_mes)));

		cache_get_int(0, !"Family_Rang", str_mes[0]);
		strcat(str_1, (str_f("{FFFFFF}Положение: %s\n", FamilyRang_Name[id][str_mes[0]-1])));
		
		cache_get_int(0, !"Level_Tatto", str_mes[0]);
		strcat(str_1, (str_f("Наколка: %s\n", TattoStaticData[str_mes[0]][tsName])));

		str_mes[0] = EOS, cache_get_string(0, !"Family_InviteNickName", str_mes);
		strcat(str_1, (str_f("Принял: %s\n", str_mes)));

		str_mes[0] = EOS, cache_get_string(0, !"invite_time", str_mes);
		strcat(str_1, (str_f("Когда принят: %s\n", str_mes)));

		str_mes[0] = EOS, cache_get_string(0, !"last_logintime", str_mes);
		strcat(str_1, (str_f("Был в игре: %s", str_mes)));
		//Выгнать / Назад
		SPD(playerid, 20314, DIALOG_STYLE_MSGBOX, "{FFCD00}Информация об игроке", str_1, "Назад","");
	}
	return 1;
}
CMD:p_checkitem(playerid, get[])
{
	extract get -> new to_player; else return SCM(playerid, COLOR_GREY, "Используйте: /p_checkitem [ид игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	player_ShowData[playerid][66] = to_player;
	player_GetInvItem(playerid, Inventory[to_player], InventoryString[to_player], 20);
	SPD(playerid, 20315, DIALOG_STYLE_TABLIST_HEADERS, (str_f("%s[id %i, uid %i]",PN(to_player), to_player, PI[to_player][pID])), str_1, "Удалить", "Закрыть");
	return 1;
}
CMD:h_checkitem(playerid, get[])
{
	extract get -> new id; else return SCM(playerid, COLOR_GREY, "Используйте: /h_checkitem [ид дома]");
	if(id < 0 || id > TOTAL_HOUSES-1) return 0;
	player_ShowData[playerid][66] = id;
	player_GetInvItem(playerid, InventoryHouse[id], InventoryHouseString[id], 24);
	SPD(playerid, 20412, DIALOG_STYLE_TABLIST_HEADERS, (str_f("%s[id %i, uid %i]", HouseData[id][hOwner], id, HouseData[id][hID])), str_1, "Удалить", "Закрыть");
	return 1;
}
CMD:t_checkitem(playerid, get[])
{
	extract get -> new vehicleid; else return SCM(playerid, COLOR_GREY, "Используйте: /t_checkitem [ид машины] (/dl)");
	new number = GetVehicleID(vehicleid);
	if(!IsAOwnableCar(number)) return SCM(playerid, -1, "Это не личная машина!!");
	player_ShowData[playerid][66] = number;
	player_ShowData[playerid][67] = CarData[number][cID];
	player_GetInvItem(playerid, InventoryTrunk[number], InventoryTrunkString[number], 24);
	SPD(playerid, 20413, DIALOG_STYLE_TABLIST_HEADERS, (str_f("%s[number %i, uid %i]", CarData[number][cOwner], number, CarData[number][cID])), str_1, "Удалить", "Закрыть");
	return 1;
}
CMD:b_checkitem(playerid, get[])
{
	extract get -> new to_player; else return SCM(playerid, COLOR_GREY, "Используйте: /b_checkitem [ид игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	player_ShowData[playerid][66] = to_player;
	player_GetInvItem(playerid, InventoryBag[to_player], InventoryBagString[to_player], 24);
	SPD(playerid, 20414, DIALOG_STYLE_TABLIST_HEADERS, (str_f("%s[id %i, uid %i]",PN(to_player), to_player, PI[to_player][pID])), str_1, "Удалить", "Закрыть");
	return 1;
}
stock player_GetInvItem(playerid, data[][], str_data[][], size_data)
{
	str_1 = "Слот\tНазвание\tСпецификатор\n";
	memset(player_ShowID[playerid], -1);
	new count;
	for(new i; i < size_data; i++)
	{
		new itemid = data[0][i];
		if(itemid == -1) continue;
		switch(itemid)
		{
			case 99: strcat(str_1, (str_f("%i\t%s(%s)\t%i модель\n", i, ItemsData[itemid][ItemName], str_data[i], data[2][i])));
			case 100, 181..185,219..222,246,260,263,275,277,287,289,291,292,324,285:
			{
				strcat(str_1, (str_f("%i\t%s\t%i модель\n", i, ItemsData[itemid][ItemName], data[2][i])));
			}
			default: strcat(str_1, (str_f("%i\t%s\t%i шт.\n", i, ItemsData[itemid][ItemName], data[1][i])));
		}
		player_ShowID[playerid][count] = i;
		count++;
	}
	return 1;
}
CMD:removeallinv(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return 1;
	extract get -> new to_player; else return SCM(playerid, COLOR_GREY, "Используйте: /removeallinv [id player]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	for(new i; i < 20; i++) RefreshInvPlayer(to_player, i);
	SCMf(to_player, COLOR_RED, "Ваш инвентарь был полностью очищен администратором %s[%i]", PN(playerid), playerid);
	str_1[0] = EOS, f(str_1, sizeof str_1, "Админ %s[%i] удалил игроку %s[%i] ВЕСЬ инвентарь!!!", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(COLOR_RED, str_1);
	return 1;
}
stock family_InvitePlayer(playerid, id, const name[], rang = 1)
{
	PI[playerid][pFamily_ID] = id;
	PI[playerid][pFamily_Rang] = rang;
	PI[playerid][pFamily_InviteTime] = global_time;
	SetString(PI[playerid][pFamily_InviteNickName], name, strlen(name));
	UpdateDataInt("players", "Family_ID", PI[playerid][pFamily_ID], PI[playerid][pID]);
	UpdateDataInt("players", "Family_Rang", PI[playerid][pFamily_Rang], PI[playerid][pID]);
	UpdateDataInt("players", "Family_InviteTime", PI[playerid][pFamily_InviteTime], PI[playerid][pID]);
	UpdateDataStr("players", "Family_InviteNickName", PI[playerid][pFamily_InviteNickName], PI[playerid][pID]);
	player_UpdateFamily(playerid);
	mysql_tqueryf(mysql, "UPDATE `Familys` SET `MemberCount`=`MemberCount`+1 WHERE `ID` = '%i' LIMIT 1;", id);
}
stock family_UnInvitePlayer(playerid, const text[], bool:save)
{
	SCM(playerid, -3211094, text);
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	SafeBackFamilyCar(playerid);
	PI[playerid][pFamily_ID] = -1;
	if(save)
	{
		UpdateDataInt("players", "Family_ID", -1, PI[playerid][pID]);
		mysql_tqueryf(mysql, "UPDATE `Familys` SET `MemberCount`=`MemberCount`-1 WHERE `ID` = '%i' LIMIT 1;", id);
	}
	player_UpdateFamily(playerid);
}
stock SafeBackFamilyCar(playerid)
{
	foreach(new number: OWNABLECARS)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid))) continue;
		if(CarData[number][cOwner_Type] == 2)
		{
			CarData[number][cFamily_ID] = -1;
			CarData[number][cOwner_Type] = 0;
			SafeRemoveCar(number, number);
		}
	}
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `OwnableCars` SET `Family_ID` = '-1', `Owner_Type` = '0' WHERE `Owner` = '%s'", PN(playerid));
	mysql_tquery(mysql, str_q);
}
CMD:family_backcar(playerid)
{
	if(!(player_AntiFlood[playerid][21]-global_time > 0))
	{
		player_AntiFlood[playerid][21] = global_time+200;
		SafeBackFamilyCar(playerid);
		SCM(playerid, -1, "Вы успешно вернули свои машины, которые были привязаны к банде!");
	}
}
stock GetBusinessGangRoof(id)
{
	new count;
	for(new i; i < TOTAL_BUSINESSES; i++) if(BizData[i][bGangRoof_ID] == id) count++;
	return count;
}
stock player_Family_ChangeColor(playerid, list = 0)
{
	player_ShowID[playerid][20] = list;
	new 
		start = list*24,
		end = (list+1)*24,
		bool:count;
	str_1[0] = EOS;
	for(new i=start; i < end; i++)
	{
		if(i < sizeof(FamilyColorData))
		{
			if(!count) count = true;
			else strcat(str_1, ",");
			strcat(str_1, (str_f("\"%s\"", FamilyColorData[i])));
		}
	}
	if(!OpenInterface[playerid][71])
	{
		new id = GetFamilyID(PI[playerid][pFamily_ID]);
		if(id != -1)
		{
			new bool:status;
			if(OpenInterface[playerid][74] == true) status = true;
			else status = FamilyData[id][fGang];
			ExecutePacket(playerid, webOpen, "GangColor", (str_f("[\"Выберите цвет %s\",[%s],%i]", (!status ? "семьи" : "банды"), str_1, player_ShowID[playerid][20]+1)));
			OpenInterface[playerid][71] = true;
		}
	}
	else
	{
		ExecutePacket(playerid, webUpdate, (str_f("interface('GangColor').updateData('[[%s],%i]')", str_1, player_ShowID[playerid][20]+1)));
	}
	//OpenInterface[playerid][71] = !OpenInterface[playerid][71];
}
CMD:fm(playerid, get[])
{
	//SCM(playerid,-3211094, "%s %s %s [%i]: %s");
	if(IsPlayerMuted(playerid)) return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		if(strlen(get) < 1) return SCM(playerid,-825307393, "Используйте: /fm [текст]");
		foreach(new i: PlayersFamily)
		{
			if(PI[playerid][pFamily_ID] != PI[i][pFamily_ID]) continue;
			SCMf(i,-3211094, "%s %s %s [%i]: %s", FamilyData[id][fName], FamilyRang_Name[id][PI[playerid][pFamily_Rang]-1], PN(playerid), playerid, get);
		}
	}
	else SCM(playerid, 0xCECECEFF, "Вы не состоите в семье");
	return 1;
}
CMD:nfm(playerid, get[])
{
	//SCM(playerid,-3211094, "%s %s %s [%i]: %s");
	if(IsPlayerMuted(playerid)) return SCM(playerid, 0xFF6600FF, !"Вы не можете использовать это");
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		if(strlen(get) < 1) return SCM(playerid,-825307393, "Используйте: /nfm [текст]");
		foreach(new i: PlayersFamily)
		{
			if(PI[playerid][pFamily_ID] != PI[i][pFamily_ID]) continue;
			SCMf(i,-3211094, "(( %s %s %s [%i]: %s ))", FamilyData[id][fName], "Глава", PN(playerid), playerid, get);
		}
	}
	else SCM(playerid, 0xCECECEFF, "Вы не состоите в семье");
	return 1;
}
stock player_Family_UpdateColor(playerid, eventid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		new color_id = (player_ShowID[playerid][20]*24)+eventid;
		if(color_id >= sizeof(FamilyColorData)) color_id = sizeof(FamilyColorData)-1;
		FamilyData[id][fColor] = color_id;
		UpdateDataInt("Familys", "Color", color_id, FamilyData[id][fID]);
		new bool:change_color;
		if(OpenInterface[playerid][74] != false)
		{
			OpenInterface[playerid][74] = false;
			if(!PI[playerid][pMember_ID])
			{
				SCMf(playerid,-3211094, "%s Ваша семья стала бандой! Чтобы установить базу, введите команду /gang_spawn в доме", FamilyData[id][fName]);
				//Level_Tatto
				mysql_tqueryf(mysql, "UPDATE `players` SET `Family_ID` = '-1' WHERE `Family_ID` = '%i' AND `Level_Tatto` < '3' AND `Member_ID` != '0';", \
						FamilyData[id][fID]);
				foreach(new player_id: PlayersFamily)
				{
					if(!IsPlayerLogged(player_id) || PI[playerid][pFamily_ID] != PI[player_id][pFamily_ID] || PI[player_id][pLevel_Tatto] >= 3 || PI[player_id][pMember_ID] != 0) continue;
					SCMf(player_id,-3211094, "%s Ваша семья стала бандой! Вы были исключены, так как не подходите требованиям банды!", FamilyData[id][fName]);
					PI[player_id][pFamily_ID] = -1; //сохран общим запросом выше
					Iter_SafeRemove(PlayersFamily, player_id, player_id);
				}
				FamilyData[id][fGang] = true;
				UpdateDataInt("Familys", "Gang", 1, FamilyData[id][fID]);

				if(player_ShowData[playerid][299] < 0) player_ShowData[playerid][299] = 0;
				else if(player_ShowData[playerid][299] > 3) player_ShowData[playerid][299] = 3;
				FamilyData[id][fGang_Walking] = player_ShowData[playerid][299];
				UpdateDataInt("Familys", "Gang_Walking", FamilyData[id][fGang_Walking], FamilyData[id][fID]);
			}
			else SCM(playerid,-825307393, !"* Вы не должны состоять ни в какой организации!");
			change_color = true;
		}
		else 
		{
			SCM(playerid, 865730559, !"Вы изменили цвет банды");
			change_color = true;
		}
		if(change_color)
		{
			foreach(new i: PlayersFamily)
			{
				if(PI[playerid][pFamily_ID] != PI[i][pFamily_ID]) continue;
				player_UpdateFamily(i);
			}
		}
	}
	else SCM(playerid, 0xCECECEFF, "Вы не состоите в семье");
	return 1;
}
public: player_PresentCases_Update(playerid, list)
{
	player_ShowID[playerid][20] = list;
	new count = cache_num_rows();
	if(!count)
	{
		ExecutePacket(playerid, webUpdate, "interface('MainMenu').onServerResponse(9, '[0,0,[]]')");
	}
	else
	{
		//"interface('MainMenu').onServerResponse(9, '[0,2,[[4,217,217,1,"Одежда",0,2],[11,2,0,12,"BONUS 2X [12 часов]",1,0],[4,91,91,1,"Одежда",2,2],[11,2,1,2,"BONUS 2X [2 часа]",3,0],[4,117,117,1,"Одежда",4,2],[0,1001,3,1,"Интересное (VIP Silver)",5,0],[11,3,0,2,"BONUS 3X [2 часа]",6,0],[4,295,295,0,"Одежда",7,2],[8,39,15,0,"Предмет Камера: 15 шт",8,0],[11,3,0,2,"BONUS 3X [2 часа]",9,0]]]')"
		//"interface('MainMenu').onServerResponse(9, '[1,2,[[3,542,542,1,"Транспорт (LUAZ 969)",10,1],[8,39,15,0,"Предмет Камера: 15 шт",11,0],[8,132,2,0,"Предмет Улучшенная удочка",12,0],[8,293,30,0,"Предмет Фишка: 30 шт",13,0]]]')"
		player_ShowID[playerid][21] = (count > 8 ? 2024 : 0);
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,[", player_ShowID[playerid][20], (count >= 9 ? player_ShowID[playerid][20]+2 : player_ShowID[playerid][20]+1));
		new bool:countEx;
		for(new i; i < count; i++)
		{
			if(!countEx) countEx = true;
			else strcat(str_1, ",");
			cache_get_int(i, "ID", player_ShowData[playerid][i]);
			static type, UID;
			cache_get_int(i, "Type", type);
			cache_get_int(i, "UID", UID);
			strcat(str_1, (str_f("[%i,%i,11,12,\"%s\",%i,%i]", \
				ItemsCaseData[type][UID][icType], ItemsCaseData[type][UID][icModel], \
				ItemsCaseData[type][UID][icName], player_ShowData[playerid][i], ItemsCaseData[type][UID][icColor])));
		}
		strcat(str_1, "]]");
		ExecutePacket(playerid, webUpdate, (str_f("interface('MainMenu').onServerResponse(9, '%s')", str_1)));
	}
	return 1;
}
stock player_PresentCases_List(playerid, list = 0)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID`, `Type`, `UID` FROM `player_PresentCases` WHERE `pID` = '%i' ORDER BY `ID` DESC LIMIT %i, 10;", PI[playerid][pID], 10*list);
	mysql_tquery(mysql, str_q, "player_PresentCases_Update", "ii", playerid, list);
	return 1;
}
stock player_PresentCases_Select(playerid, id)
{
	if(!(player_AntiFlood[playerid][17]-global_time > 0))
	{
		player_AntiFlood[playerid][17] = global_time+2;
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID`, `Type`, `UID` FROM `player_PresentCases` WHERE `ID` = '%i' LIMIT 1;", id);
		mysql_tquery(mysql, str_q, "player_PresentCases_Give", "i", playerid);
	}
	return 1;
}
public: player_PresentCases_Give(playerid)
{
	if(cache_num_rows())
	{
		cache_get_int(0, "ID", player_ShowData[playerid][100]);
		cache_get_int(0, "Type", player_ShowData[playerid][101]);
		cache_get_int(0, "UID", player_ShowData[playerid][102]);
		/*
			0 - прочее
			1 - акс
			2 - випка
			3 - машина
			4 - скины
			5 - деньги
		*/
		SPD(playerid, 20316, 0, "Информация", (str_f("{EEEEEE}Вы хотите забрать {F6C300}%s {EEEEEE}из списка?", \
			ItemsCaseData[player_ShowData[playerid][101]][player_ShowData[playerid][102]][icName])), "Забрать","Отмена");
	}
	return 1;
}
CMD:tplist(playerid, get[])
{
	cmd_tplist(playerid, get);
	return 1;
}
stock cmd_tplist(playerid, get[])
{
	if(player_Paintball_ID{playerid} != 255 || PI[playerid][pHospital] != false)
	{
		return SCM(playerid, COLOR_RED, !"В данный момент невозможно");
	}
	SCM(playerid, COLOR_GREY, !"Используйте: /tplist [id]");
	extract get -> new id; else
	{
		str_1[0] = EOS;
		for(new i; i < sizeof(tplist_Data); i++)
		{
			strcat(str_1, (str_f("%i. %s\n", i, tplist_Data[i][tlName])));
		}
		SPD(playerid, 20317, DIALOG_STYLE_LIST, "{FFD83D}Список глобальных телепортов", str_1, "Выбрать", "Закрыть");
		return 1;
	}
	if(id < 0 || id > sizeof(tplist_Data)-1) return SCM(playerid, COLOR_GREY, !"Используйте: /tplist ![id]");
	SetPlayerPosEx(playerid, tplist_Data[id][tlPosition][0], tplist_Data[id][tlPosition][1], tplist_Data[id][tlPosition][2], 0.0, 0, 0, false);
	return 1;
}
public: player_FamilyNameUsed(playerid, name[])
{
	if(cache_num_rows())
	{
		SCM(playerid, 0xCECECEFF, !"Данное имя уже используется");
		SPD(playerid, 20318, DIALOG_STYLE_INPUT,
			"Создание семьи",
			"{808080}- Цена: 150000000 руб.\n\
			- Только русские или английские символы\n\
			- Используйте от 6 до 36 символов\n\n\
			{FFFFFF}Введите название Вашей семьи:",
			"Создать", "Отмена");
	}
	else
	{
		mysql_tquery(mysql, (str_f("INSERT INTO `Familys` (`Name`, `Owner`, `MemberCount`) VALUES ('%s', '%s', '1')", name, PN(playerid))), "player_CreateFamily", "i", playerid);
	}
	return 1;
}
public: player_CreateFamily(playerid)
{
	new id = cache_insert_id();
	FamilyData[TOTAL_FAMILYS][fID] = id;
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `Familys` WHERE `ID` = '%i' LIMIT 1;", id);
	mysql_tquery(mysql, str_q, "LoadFamilyMySQL", "i", 0);

	GivePlayerMoneyEx(playerid, -150000000, "Создание семьи");
	SCM(playerid, 0x33AA33FF, !"Вы успешно создали семью! {FFD700}Используйте /fmenu для информации");
	family_InvitePlayer(playerid, id, "system", 10);
}
CMD:world_info(playerid)
{
	SCMf(playerid, -1, "vw %i, int %i", GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid));
}
CMD:family_leave(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(GetString(FamilyData[id][fOwner], PN(playerid)))
		{
			SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
			return 1;
		}
		mysql_tqueryf(mysql, "UPDATE `Familys` SET `MemberCount`=`MemberCount`-1 WHERE `ID` = '%i' LIMIT 1;", FamilyData[id][fID]);
		family_UnInvitePlayer(playerid, "Вы покинули семью по собственному желанию", true);
	}
	else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	return 1;
}
CMD:settatto(playerid, get[])
{
	extract get -> new to_player, level; else
	{
		SCMf(playerid, COLOR_GREY, "Используйте: /settatto [ид игрока] [0-%i]", sizeof(TattoStaticData)-1);
		return 1;
	}
	if(level < 0 || level > sizeof(TattoStaticData)-1) return 0;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] изменил наколку игроку %s[%i] на %s(%i)", PN(playerid), playerid, PN(to_player), to_player, TattoStaticData[level][tsName], level);
	SCMf(to_player, -1, "Администратор %s[%i] обновил вашу наколку на %s(%i), предыдущая %s(%i).", PN(playerid), playerid, TattoStaticData[level][tsName], level, TattoStaticData[PI[to_player][pLevel_Tatto]][tsName], PI[to_player][pLevel_Tatto]);
	PI[to_player][pLevel_Tatto] = level;
	UpdateDataInt("players", "Level_Tatto", PI[to_player][pLevel_Tatto], PI[to_player][pID]);
	return 1;
}
stock player_GangCreate_Open(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(!PI[playerid][pMember_ID] && !FamilyData[id][fGang])
		{
			if(GetString(FamilyData[id][fOwner], PN(playerid)))
			{
				if(PI[playerid][pLevel_Tatto] > 6)
				{
					OpenInterface[playerid][74] = true;
					ExecutePacket(playerid, webOpen, "GangCreate", "[30000000]");
				}
				else SCM(playerid,-825307393, !"* Вы должны иметь ранг-наколку 'Пахан' или выше");
			}
			else SCM(playerid,-825307393, !"* Для создания банды у вас должна быть своя семья");
		}
		else SCM(playerid,-825307393, !"* Вы состоите уже в какой то организации!");
	}
	else SCM(playerid,-825307393, !"* Для создания банды у вас должна быть своя семья");
}
stock player_CreateGang(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(GetString(FamilyData[id][fOwner], PN(playerid)))
		{
			if(PI[playerid][pLevel_Tatto] > 6)
			{
				if(!PI[playerid][pMember_ID])
				{
					player_Family_ChangeColor(playerid);
				}
				else SCM(playerid,-825307393, !"* Вы не должны состоять ни в какой организации!");
			}
			else SCM(playerid,-825307393, !"* Вы должны иметь ранг-наколку 'Пахан' или выше");
		}
		else SCM(playerid,-825307393, "* Для создания банды у вас должна быть своя семья");
	}
	else SCM(playerid,-825307393, "* Для создания банды у вас должна быть своя семья");
}
CMD:family_delete(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(GetString(FamilyData[id][fOwner], PN(playerid)))
		{
			SPD(playerid, 20320, DIALOG_STYLE_MSGBOX, "Удаление семьи", "\
					Вы действительно хотите удалить семью?\n\
					Все участники семьи будут исключены без возможности восстановления.", "Удалить", "Отменить");
		}
		else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	}
	else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	return 1;
}
CMD:finvite(playerid, get[])
{
	if(!strlen(get)) return SCM(playerid, 0xCECECEFF, !"Используйте: /finvite [id игрока]");

	extract get -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(!FamilyRang_Deputy[id][PI[playerid][pFamily_Rang]-1]) return SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
		if(GetPlayerData(to_player, pWarn)) return SCM(playerid, 0xCECECEFF, !"У игрока есть предупреждения");

		if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SCM(playerid, 0xCECECEFF, !"* Игрок слишком далеко");
		if(GetFamilyID(PI[to_player][pFamily_ID]) != -1) return SCM(playerid, 0xCECECEFF, !"Этот игрок уже состоит в семье");
		if(FamilyData[id][fGang] != false && PI[to_player][pMember_ID] != 0) return SCM(playerid, 0xCECECEFF, !"Этот игрок уже состоит в другой организации");
		SendPlayerOffer(playerid, to_player, OFFER_TYPE_FINVITE);
	}
	else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	return 1;
}
CMD:funinvite(playerid, get[])
{
	if(!strlen(get)) return SCM(playerid, 0xCECECEFF, !"Используйте: /funinvite [id игрока] [причина]");

	extract get -> new to_player, string:reason[30]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /funinvite [id игрока] [причина]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new id = GetFamilyID(PI[playerid][pFamily_ID]),
		id_2 = GetFamilyID(PI[to_player][pFamily_ID]);
	if(id >= 0)
	{
		if(!FamilyRang_Deputy[id][PI[playerid][pFamily_Rang]-1]) return SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
		if(PI[to_player][pFamily_Rang] >= PI[playerid][pFamily_Rang]) return SCM(playerid, 0xCECECEFF, !"Нельзя уволить уволить игрока такого же или ранга выше");
		if(id != id_2) return SCM(playerid,-825307393, !"* Игрок не в вашей семье");
		family_UnInvitePlayer(to_player, (str_f("{CECECE}%s[%d] уволил Вас из семьи \"%s\". Причина: %s", PN(playerid), playerid, FamilyData[id][fName], reason)), true);
		SCMf(playerid, 0xCECECEFF, "Вы уволили %s[%d] из своей семьи", PN(to_player), to_player);
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s %s[%i] Уволил %s[%i] из семьи. Причина: %s", FamilyData[id][fName], FamilyRang_Name[id][PI[playerid][pFamily_Rang]-1], PN(playerid), playerid, PN(to_player), to_player, reason);
		SendFamilyMessage(playerid, str_mes, COLOR_RED);
	}
	else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	return 1;
}
alias:funinvite("unfinvite")
CMD:family_rank(playerid, get[])
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(!FamilyRang_Deputy[id][PI[playerid][pFamily_Rang]-1]) return SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
		extract get -> new to_player; else return SCM(playerid,-825307393, "Используйте: /frank [id]");
		if(!IsPlayerConnected(to_player) || to_player == playerid || !IsPlayerLogged(to_player)) return SCM(playerid,-825307393, "* Вы не можете повысить себя или такого игрока нет");
		if(!IsPlayerInRangeOfPlayer(playerid, to_player, 10.0)) return SCM(playerid, 0xCECECEFF, !"* Игрок слишком далеко");
		if(PI[playerid][pFamily_ID] != PI[to_player][pFamily_ID]) return SCM(playerid,-825307393, !"* Игрок не в вашей семье");
		if(PI[to_player][pFamily_Rang] >= PI[playerid][pFamily_Rang]) return SCM(playerid, 0xCECECEFF, !"Нельзя уволить уволить игрока такого же или ранга выше");
		player_ShowData[playerid][123] = to_player;
		str_1[0] = EOS;
		for(new i; i < PI[playerid][pFamily_Rang]-1; i++)
		{
			f(str_1, sizeof(str_1), "%s%i. %s\n", str_1, i+1, FamilyRang_Name[id][i]);
		}
		SPD(playerid, 20333, DIALOG_STYLE_LIST, "Изменение ранга игрока", str_1, "Изменить", "Закрыть");
	}
	else SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	return 1;
}
alias:family_rank("frank")
stock player_SafeSave(playerid)
{
	if(!IsPlayerLogged(playerid)) return 0;
	if(player_SaveInv{playerid} != 255)
	{
		player_SaveInv{playerid}--;
		if(player_SaveInv{playerid} == 1)
		{
			player_SaveEx(playerid, 0);
		}
	}
	if(player_SaveJail{playerid} != 255)
	{
		player_SaveJail{playerid}--;
		if(player_SaveJail{playerid} == 1)
		{
			player_SaveEx(playerid, 1);
		}
	}
	if(player_SaveMute{playerid} != 255)
	{
		player_SaveMute{playerid}--;
		if(player_SaveMute{playerid} == 1)
		{
			player_SaveEx(playerid, 2);
		}
	}
	if(player_SaveSettings{playerid} != 255)
	{
		player_SaveSettings{playerid}--;
		if(player_SaveSettings{playerid} == 1)
		{
			player_SaveEx(playerid, 3);
		}
	}
	if(player_SaveHealth{playerid} != 255)
	{
		player_SaveHealth{playerid}--;
		if(player_SaveHealth{playerid} == 1)
		{
			player_SaveEx(playerid, 4);
		}
	}
	if(player_SaveArmour{playerid} != 255)
	{
		player_SaveArmour{playerid}--;
		if(player_SaveArmour{playerid} == 1)
		{
			player_SaveEx(playerid, 5);
		}
	}
	if(player_SaveCash{playerid} != 255)
	{
		player_SaveCash{playerid}--;
		if(player_SaveCash{playerid} == 1)
		{
			player_SaveEx(playerid, 6);
		}
	}
	if(player_SaveCash_Donate{playerid} != 255)
	{
		player_SaveCash_Donate{playerid}--;
		if(player_SaveCash_Donate{playerid} == 1)
		{
			player_SaveEx(playerid, 7);
		}
	}
	return 1;
}
stock player_SaveEx(playerid, type)
{
	if(!IsPlayerLogged(playerid)) return 0;
	switch(type)
	{
		case 0:
		{
			SaveInvPlayer(playerid);
			player_SaveInv{playerid} = 255;
		}
		case 1:
		{
			UpdatePlayerDataInt(playerid, "JailTime", PI[playerid][pJailTime]);
			UpdatePlayerDataInt(playerid, "JailTime_Gen", PI[playerid][pJailTime_Gen]);
			player_SaveJail{playerid} = 255;
		}
		case 2:
		{
			UpdatePlayerDataInt(playerid, "MuteTime", PI[playerid][pMuteTime]);
			UpdatePlayerDataInt(playerid, "RMuteTime", PI[playerid][pRMuteTime]);
			UpdatePlayerDataInt(playerid, "VMuteTime", PI[playerid][pVMuteTime]);
			UpdatePlayerDataInt(playerid, "VC_muteTime", PI[playerid][pVC_muteTime]);
			player_SaveMute{playerid} = 255;
		}
		case 3:
		{
			str_1[0] = EOS;
			for(new i; i < 16; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, PI[playerid][pSettings][i]);
			UpdatePlayerDataStr(playerid, "Settings", str_1);
			player_SaveSettings{playerid} = 255;
		}
		case 4:
		{
			UpdatePlayerDataFloat(playerid, "Health", PI[playerid][pHealth]);
			player_SaveHealth{playerid} = 255;
		}
		case 5:
		{
			UpdatePlayerDataFloat(playerid, "Armour", PI[playerid][pArmour]);
			player_SaveArmour{playerid} = 255;
		}
		case 6:
		{
			//UpdatePlayerDataInt(playerid, "Cash", player_Cash[playerid]);
			player_SaveCash{playerid} = 255;
		}
		case 7:
		{
			UpdatePlayerDataInt(playerid, "Cash_Donate", PI[playerid][pCash_Donate]);
			player_SaveCash_Donate{playerid} = 255;
		}
	}
	return 1;
}
stock player_fImprove(playerid, id)
{
	if(PI[playerid][pFamily_Rang] < 10) return SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
	str_1[0] = EOS;
	for(new i; i < sizeof(FamilySettingsData); i++)
	{
		str_mes[0] = EOS;
		if(!GetString(FamilySettingsData[i][fsLimit], "-"))
		{
			f(str_mes, sizeof(str_mes), "%i", FamilyData[id][fGang_Improve][i]);
		}
		else f(str_mes, sizeof(str_mes), "%s", (!FamilyData[id][fGang_Improve][i] ? "{F77C3A}Запрещено" : "{9BF73A}Разрешено"));
		strcat(str_1, (str_f("%s\t%s\t%s\t%s\n", FamilySettingsData[i][fsName], FamilySettingsData[i][fsLimit], str_mes, FamilySettingsData[i][fsReputation])));
	}
	str_2[0] = EOS, f(str_2, sizeof(str_2), "Криминальное влияние вашей банды: %i", FamilyData[id][fGang_Reputation]);
	SPD(playerid, 20321, 5, "{FFCD00}Контролирование лимитов", (str_f("\
		Название ограничения\tВозможное количество\tСтатус\tТребуемый рейтинг для повышения\n\
		%s", str_1)), "Выбрать","Закрыть", str_2);
	return 1;
}
stock SendFamilyMessage(playerid, const msg[], color = -3211094)
{
	foreach(new i: PlayersFamily)
	{
		if(PI[playerid][pFamily_ID] != PI[i][pFamily_ID]) continue;
		SCM(i, color, msg);
	}
	return 1;
}
CMD:selldrugs(playerid, get[])
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		if(FamilyData[id][fGang] != false)
		{
			if(!FamilyData[id][fGang_Improve][1]) 
			{
				SCM(playerid,-825307393, "* Ваша банда не имеет улучшения для продажи наркотиков. Улучшить банду можно в меню банды (/fmenu)");
				return 1;
			}
			extract get -> new to_player, count, price; else return SCM(playerid,-825307393, "* Использование: /selldrugs [id игрока] [кол-во] [цена]");
		}
		else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	}
	else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	return 1;
}
CMD:sellgun(playerid, get[])
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id != -1)
	{
		if(FamilyData[id][fGang] != false)
		{
			if(!FamilyData[id][fGang_Improve][0]) 
			{
				SCM(playerid,-825307393, "* Ваша банда не имеет улучшения для продажи оружия. Улучшить банду можно в меню банды (/fmenu)");
				return 1;
			}
			extract get -> new to_player, count, price; else return SCM(playerid,-825307393, "* Использование: /sellgun [id игрока] [кол-во] [цена]");
		}
		else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	}
	else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	return 1;
}
CMD:gang_car(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(!GetString(FamilyData[id][fOwner], PN(playerid)) || !FamilyData[id][fGang])
		{
			return SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
		}
		new 
			carid = GetPlayerVehicleID(playerid),
			number = GetVehicleID(carid);

		if(carid < 1) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

		if(number == INVALID_VEHICLE_ID) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");
		if(!GetString(CarData[number][cOwner], PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться в личном транспорте");
		if(CarData[number][cOwner_Type] == 2) return SCM(playerid, 0xCECECEFF, !"Эта машина уже принадлежит какой то из банд");
		new idEx = FamilyData[id][fGang_BaseID];
		if(idEx == -1) return SCM(playerid, 0xCECECEFF, !"Для этого у банды должна быть база");
		if(GetPlayerDistanceFromPoint(playerid, HouseData[idEx][hEnter][0], HouseData[idEx][hEnter][1], HouseData[idEx][hEnter][2]) > 40.0)
		{
			SCM(playerid, COLOR_RED, !"Вы должны быть рядом с базой");
			return 1;
		}
		SPD(playerid, 20324, DIALOG_STYLE_MSGBOX, "Подтверждение", "Вы действительно хотите использовать данный транспорт для своей банды?", "Да", "Нет");
	}
	else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	return 1;
}
CMD:gang_cars(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(FamilyData[id][fGang] != true)
		{
			return SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
		}
		str_q[0] = EOS, f(str_q, sizeof str_q, "SELECT `ID`,`Model`,`VehicleID` FROM `OwnableCars` WHERE `Owner_Type` = '2' AND `Family_ID` = '%i' LIMIT 20;", PI[playerid][pFamily_ID]);
		mysql_tquery(mysql, str_q, "LoadOwnableCar_List", "ii", playerid, 20325);
	}
	else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	return 1;
}
stock player_FamilyCarMenu(playerid, number)
{
	if(IsAOwnableCar(number)) //loaded
	{
		if(PI[playerid][pFamily_ID] == CarData[number][cFamily_ID])
		{
			new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
			SPD(playerid, 20327, DIALOG_STYLE_LIST,"{FFCD00}Система управления транспортом",(str_f("\
				{FFFFFF}1. Вернуть на базу [100000 руб]\n\
				2. Доступ с ранга: %s", FamilyRang_Name[idEx][CarData[number][cFamily_Rang]-1])),"Выбрать","Закрыть");
		}
		else
		{
			SCM(playerid, COLOR_RED, "[Ошибка] При загрузке семейного авто произошла ошибка - f#93131F");
			printf("[Ошибка] При загрузке семейного авто произошла ошибка - f#93131F(%i,%i) [%s] [%s]", number, CarData[number][cOwner], PN(playerid));
		}
	}
	else
	{
		SPD(playerid, 20326, DIALOG_STYLE_LIST,"{FFCD00}Система управления транспортом","\
				{FFFFFF}1. Загрузить","Выбрать","Закрыть");
	}
}
CMD:gang_spawn(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		if(!GetString(FamilyData[id][fOwner], PN(playerid)))
		{
			return SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
		}
		if(!FamilyData[id][fGang])
		{
			return SCM(playerid, 0xCECECEFF, !"* Ваша семья должна быть бандой");
		}
		new houseid = player_HouseEntered[playerid];
		new idEx = IsPlayerHouseOwner(playerid, houseid);
		if(idEx == -1) return SCM(playerid, 0x999999FF, !"Вы должны находиться у себя в доме!");
		if(idEx == -2) return SCM(playerid, 0x999999FF, !"Вы не владелец этого дома!");
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "\
			%s Новая база находится в доме №%i", \
				FamilyData[id][fName], houseid);
		SendFamilyMessage(playerid, str_mes);
		family_UpdateHouse(PI[playerid][pFamily_ID], houseid);
		UpdateDataInt("Familys", "Gang_BaseID", houseid, FamilyData[id][fID]);
		SCM(playerid, 0x808080FF, "Для появления склада, напишите команду /makestore, в удобном для вас месте.");
	}
	else SCM(playerid, 0xCECECEFF, !"* Вам недоступна данная функция");
	return 1;
}
stock family_UpdateHouse(id, houseid)
{
	new idEx = GetFamilyID(id);
	new base_old = FamilyData[idEx][fGang_BaseID];
	if(!(base_old < 0 || base_old > TOTAL_HOUSES-1)) //проверка на валидность дома
	{
		if(HouseData[base_old][hGang_FamilyID] == id)
		{
			HouseData[base_old][hGang_FamilyID] = -1;
			UpdateHouse_Store(base_old, false);
		}
	}
	HouseData[houseid][hGang_FamilyID] = id;
	FamilyData[idEx][fGang_BaseID] = houseid;
	if(!GetString(HouseData[houseid][hOwner], FamilyData[idEx][fOwner]))
	{
		HouseData[houseid][hGang_FamilyID] = -1;
		FamilyData[idEx][fGang_BaseID] = -1;
		UpdateDataInt("Familys", "Gang_BaseID", -1, FamilyData[idEx][fID]);
	}
	UpdateHouse_Store(houseid, false);
}
stock player_MultiDialog(playerid, bool:eventid)
{
	if(!player_MultiDialog_Back{playerid} && !eventid) return 0;
	if(!player_MultiDialog_Next{playerid} && eventid != false) return 0;
	player_MultiDialog_Back{playerid} = false;
	player_MultiDialog_Next{playerid} = false;
	/*
		eventid =>
			0 - назад
			1 - вперед
	*/
	switch(player_DialogID[playerid])
	{
		case 20476:
		{
			cmd_wanted(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20416:
		{
			player_YTList(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20300:
		{
			player_AdminsList(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20309:
		{
			cmd_itemsinfo(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20308:
		{
			cmd_skinsinfo(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20307:
		{
			cmd_carsinfo(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20331:
		{
			family_itemsinfo(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20389:
		{
			player_Donate_Cars(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20391:
		{
			player_Donate_Skins(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20403:
		{
			player_Donate_CarsAks(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		case 20406:
		{
			player_Donate_PersonAks(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		}
		//case 20406:
		//{
		//	player_SetCMD_Options(playerid, player_ShowID[playerid][20]+(!eventid ? -1 : 1));
		//}
	}
	return 1;
}
stock family_itemsinfo(playerid, list = 1)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		new idEx = player_ShowData[playerid][111];
		if(list < 1) list = 1;
		player_ShowID[playerid][20] = list;
		str_1[0] = EOS;
		new 
			start = (list-1)*25,
			end = list*25,
			bool:next = true;

		str_1 = "{FFCD00}Предмет\t{FFCD00}Лимит\n\n\t\n";
		if(end >= sizeof(ItemsData)-1) end = sizeof(ItemsData)-1, next = false;
		for(new i=start; i < end; i++)
		{
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s", FamilyRang_Dostup[id][idEx][i] <= 0 ? "{24C927}[Неограниченно]" : (str_f("{FFCD00}[%i]", FamilyRang_Dostup[id][idEx][i])));
			strcat(str_1, (str_f("{FFFFFF}%s\t%s\n", ItemsData[i][ItemName], str_mes)));
		}
		SPD(playerid, 20331, 5, "{FFCD00}Настройка лимитов", str_1, "Далее","Закрыть", "", (list > 1 ? true : false), next);
	}
}
cmd:capture_biz(playerid)
{
	new id = GetFamilyID(PI[playerid][pFamily_ID]);
	if(id >= 0)
	{
		//if(Family_BizFlood{PI[playerid][pFamily_ID]} != false) return SCM(playerid, 0xCECECEFF, !"Нельзя так часто захватывать бизнеса (Возможно после PayDay).");
		if(Family_BizFlood[PI[playerid][pFamily_ID]] > global_time)
		{
			SCMf(playerid, 0xCECECEFF, "Нельзя так часто захватывать бизнеса (До разморозки осталось %i сек).", Family_BizFlood[PI[playerid][pFamily_ID]]-global_time);
			return 1;
		}
		if(Family_Capture_FamID != -1 || Family_Capture_BizID != -1) return SCM(playerid, 0xCECECEFF, !"* У одной из банд уже проводится захват бизнеса.");
		if(!FamilyRang_Deputy[id][PI[playerid][pFamily_Rang]-1]) return SCM(playerid, 0xCECECEFF, !"Вы можете начать захват бизнеса только с ранга заместителя.");
		if(!FamilyData[id][fGang]) return SCM(playerid, 0xCECECEFF, !"Начать захват может только банда.");
		new bizid = GetNearestBusinesses(playerid, 10.0);
		if(global_hour < 12 || global_hour > 22) return SCM(playerid, 0xCECECEFF, !"* Захваты проводить можно с 12:00 по 22:00");
		if(bizid == -1) return SCM(playerid, 0xCECECEFF, !"Вы должны находиться около бизнеса, который хотите крышевать.");
		if(Biz_FamilyAttack{bizid} != false) return SCM(playerid, 0xCECECEFF, !"На этот бизнес уже проводится захват.");
		if(BizData[bizid][bGangRoof_ID] == PI[playerid][pFamily_ID]) return SCM(playerid, 0xCECECEFF, "Ваша семья уже крышует этот бизнес.");
		SPD(playerid, 20334, DIALOG_STYLE_MSGBOX, "Захват бизнеса", "Вы действительно хотите начать захват этого бизнеса?", "Да", "Нет");
	}
	return 1;
}
stock biz_ChangeGangRoof(bizid, famid)
{
	BizData[bizid][bGangRoof_ID] = famid;
	UpdateBiz(bizid, false);
	UpdateDataInt("Businesses", "GangRoof_ID", BizData[bizid][bGangRoof_ID], BizData[bizid][bID]);
	new id = GetFamilyID(famid);
	foreach(new i: PlayersFamily)
	{
		SCMf(i, -10092289, "%s захватили новый бизнес", FamilyData[id][fName]);
		if(PI[i][pFamily_ID] == famid) SCMf(i,-3211094, "%s Ваше криминальное влияние было повышено на 15 очков 'Победа за крышу'", FamilyData[id][fName]);
	}
	FamilyData[id][fGang_Reputation] += 15;
	UpdateDataInt("Familys", "Gang_Reputation", FamilyData[id][fGang_Reputation], FamilyData[id][fID]);
}
alias:capture_biz("bizwar")
stock GetNearestBusinesses(playerid, Float:dist)
{
	new Float:Distance, Float:Distance_ = 100000.0, id = -1;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		Distance = GetPlayerDistanceFromPoint(playerid, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2]);
		if(Distance < Distance_ && Distance < dist) id = i, Distance_ = Distance;
	}
	return id;
}
stock player_Connect_FamilyCapture(playerid)
{
	if(Family_Capture_BizID == -1 || player_IsFamilyCapture{playerid} != false || !Family_Capture_Timeout) return 0;
	GangZoneHideForPlayer(playerid, Family_Capture_gzID);
	new id = GetFamilyID(Family_Capture_FamID),
		id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);

	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "0x%s80", FamilyColorData[FamilyData[id_2][fColor]]);
	GangZoneShowForPlayer(playerid, Family_Capture_gzID, HexStr(str_mes));

	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "0x%s80", FamilyColorData[FamilyData[id][fColor]]);
	GangZoneFlashForPlayer(playerid, Family_Capture_gzID, HexStr(str_mes));
	new famid = GetFamilyID(PI[playerid][pFamily_ID]);
	if(famid >= 0)
	{
		if(!FamilyData[famid][fGang]) return 0;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "openInterface('Capture', '[\"%s\", %i, \"%s\", %i, %i]')", FamilyData[id_2][fName], Family_Capture_BizKill, FamilyData[id][fName], Family_Capture_FamKill, Family_Capture_Timeout);
		ExecutePacket(playerid, webUpdate, str_1);
		player_IsFamilyCapture{playerid} = true;
	}
	return 1;
}
CMD:capture_timer(playerid)
{
	//player_Connect_FamilyCapture(playerid);
	return 1;
}
stock Update_FamilyCapture()
{
	if(Family_Capture_BizID == -1 || Family_Capture_FamID == -1) return 0;
	new id = GetFamilyID(Family_Capture_FamID),
		id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "interface('Capture').getCaptureInfo('[\"%s\", %i, \"%s\", %i, %i]')", FamilyData[id_2][fName], Family_Capture_BizKill, FamilyData[id][fName], Family_Capture_FamKill, Family_Capture_Timeout);
	foreach(new i: PlayersFamily)
	{
		if(!player_IsFamilyCapture{i}) continue;
		ExecutePacket(i, webUpdate, str_mes);
	}
	Family_Capture_Timeout--;
	if(!Family_Capture_Timeout) player_Disconnect_FamilyCapture();
	return 1;
}
stock player_Disconnect_FamilyCapture()
{
	if(Family_Capture_BizID == -1 || Family_Capture_gzID == -1 || Family_Capture_FamID == -1) return 0;
	foreach(new i: PlayersFamily)
	{
		if(!player_IsFamilyCapture{i}) continue;
		ExecutePacket(i, webUpdate, "closeInterface('Capture')");
		player_IsFamilyCapture{i} = false;
	}
	if(Family_Capture_BizKill > Family_Capture_FamKill)
	{
		foreach(new i: PlayersFamily)
		{
			new id = GetFamilyID(Family_Capture_FamID),
				id_2 = GetFamilyID(BizData[Family_Capture_BizID][bGangRoof_ID]);
			SCMf(i, -10092289, "Попытка %s захватить бизнес %s провалилась", FamilyData[id][fName], FamilyData[id_2][fName]);
		}
	}
	else
	{
		biz_ChangeGangRoof(Family_Capture_BizID, Family_Capture_FamID);
	}
	Biz_FamilyAttack{Family_Capture_BizID} = false;
	//Family_BizFlood[Family_Capture_FamID] = true;
	Family_Capture_FamID = -1;
	Family_Capture_BizID = -1;
	Family_Capture_Timeout = 0;
	Family_Capture_FamKill = 0;
	Family_Capture_BizKill = 0;
	GangZoneDestroy(Family_Capture_gzID);
	Family_Capture_gzID = -1;
	
	DestroyDynamicArea(Family_Capture_areaID);
	Family_Capture_areaID = -1;
	return 1;
}
