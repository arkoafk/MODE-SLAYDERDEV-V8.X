				if(GetString(name_table[listitem], "Cash"))
				{
					mysql_tquery(mysql, (str_f("ALTER TABLE `players` CHANGE `Cash` `Cash` BIGINT(20) NOT NULL DEFAULT '%i';", count)));
				}
				else
				{
					mysql_tquery(mysql, (str_f("ALTER TABLE `players` CHANGE `%s` `%s` INT(11) NOT NULL DEFAULT '%i';", name_table[listitem], name_table[listitem], count)));
				}
			}
