CMD:warn(playerid, params[])
{
	//if(CheckAdmin(playerid, 3)) return 1;
	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /warn [id игрока] [причина (необязательно)]");

	extract params -> new to_player, string:reason[66];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid))
		return SCM(playerid, 0xCECECEFF, !"Нельзя выдать предупреждение админу выше по рангу");

	AddPlayerData(to_player, pWarn, +, 1);
	SetPlayerData(to_player, pWarnTime, global_time + (86400 * 3));

	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s выдал предупреждение игроку %s [%i|3]", PN(playerid), PN(to_player), GetPlayerData(to_player, pWarn));

	if(strlen(reason) > 0)
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	fraction_InvitePlayer(to_player, 0);

	new uid = GetPlayerAccountID(to_player);
	new warns = GetPlayerData(to_player, pWarn);
	new warns_time = GetPlayerData(to_player, pWarnTime);

	format(str_mes, sizeof str_mes, "Выдал варн %s[acc:%i] (%i/3). Причина: %i", PN(to_player), uid, warns, reason);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);
	static	year, month, day;

	getdate(year, month, day);

	str_1[0] = EOS, f(str_1, sizeof str_1, "Дата: %i %s %i г.\nВаш ник: %s\nНик администратора: %s\nПричина: %s\n\nЕсли Вы не согласны с наказанием, сделайте скриншот (F8)\n\
		И оставьте жалобу на форуме "FORUM_SERVER"",day,GetMonthName(month),year,PN(to_player), PN(playerid), reason);

	SPD(to_player, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FF6600}Предупреждение", str_1, "Закрыть", "");
	player_addAList(PN(to_player), "Предупреждение", PN(playerid), reason);
	if(warns >= 3)
	{
		SCM(to_player, -11521793, "Аккаунт заблокирован на 10 дней, получение 3 из 3 предупреждений.");
		AddBan_List(PN(to_player), PN(playerid), "warn 3/3 onl", 10);
	}
	Kick(to_player);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminWarn_ForDay`=`adminWarn_ForDay`+1, `adminWarn`=`adminWarn`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	mysql_pqueryf(mysql, "UPDATE players SET `Warn`='%i',`WarnTime`='%i' WHERE `ID`=%i LIMIT 1;", warns, warns_time, uid);
	return 1;
}

CMD:unwarn(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 2) return 1;
	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /warn [id игрока] [причина (необязательно)]");

	extract params -> new to_player, string: reason[66];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	SetPlayerData(to_player, pWarn, 		0);
	SetPlayerData(to_player, pWarnTime, 	0);

	UpdatePlayerDataInt(to_player, "Warn", 		0);
	UpdatePlayerDataInt(to_player, "WarnTime", 	0);

	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s снял все предупреждения с игрока %s", PN(playerid), PN(to_player));

	if(strlen(reason) > 0)
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	format(str_mes, sizeof str_mes, "Снял все варны %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}

CMD:spawn(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new player:to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /spawn [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	player_Spawn(to_player);
	f(str_mes, sizeof str_mes, "[A] %s[%i] зареспавнил %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);
	SCMf(to_player,1724645631, "Администратор %s зареспавнил вас", PN(playerid));
	return 1;
}
CMD:todo(playerid, params[])
{
	if(strlen(params) > 95) return SCM(playerid, 0xFF6600FF, !"Слишком длинный текст");
	static message[48], action[49];

	if(!(strfind(params, "*") != -1))
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /todo [действие]*[текст]");
		SCM(playerid, 0xFF6600FF, !"Вам необходимо использовать символ-разделитель {3399FF}* (звёздочку)");
		return 1;
	}

	if(sscanf(params, "p<*>s[47]s[48]", action, message))
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /todo [действие]*[текст]");
		SCM(playerid, 0xFF6600FF, !"Вам необходимо использовать символ-разделитель {3399FF}* (звёздочку)");
	    return 1;
	}

	if(strlen(message) < 2 || strlen(action) < 2)
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /todo [действие]*[текст]");
		SCM(playerid, 0xFF6600FF, !"Вам необходимо использовать символ-разделитель {3399FF}* (звёздочку)");
		return 1;
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s%s, %s сказал: {66CCFF}%s", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{DD90FF} " : ""), action, PN(playerid), message);
	SendMessageInLocal(playerid, str_mes, 0xDD90FFFF, 37.0);
	return 1;
}

CMD:goto(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /goto [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(PI[to_player][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, "Нельзя взаимодействовать с администратором выше по рангу");
	if(player_Paintball_ID{playerid} != 255 || PI[playerid][pHospital] != false)
	{
		return SCM(playerid, COLOR_RED, "В данный момент невозможно");
	}
	new Float: x, Float: y, Float: z;
	GetPlayerPos(to_player, x, y, z);
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER && !GetPlayerVirtualWorld(to_player))
	{
		SetVehiclePos(GetPlayerVehicleID(playerid), x+1, y+2, z);
		PutPlayerInVehicle(playerid, GetPlayerVehicleID(playerid), 0);
	}
	else
	{
		SetPlayerPos(playerid, x+1, y+2, z);
	}
	SCM(playerid, -1, !"Вы были телепортированы");
	player_FracGarageEntered[playerid] = player_FracGarageEntered[to_player];
	player_HouseEntered[playerid] = player_HouseEntered[to_player];
	player_BizEntered[playerid] = player_BizEntered[to_player];
	player_GarageEntered[playerid] = player_GarageEntered[to_player];
	player_EntranceEntered[playerid] = player_EntranceEntered[to_player];
	player_EntranceList[playerid] = player_EntranceList[to_player];
	str_mes[0] = EOS; ////new105];
	SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(to_player));
	SetPlayerInterior(playerid, GetPlayerInterior(to_player));

	format(str_mes, sizeof str_mes, "[A] %s[%i] телепортировался к %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);

	format(str_mes, sizeof str_mes, "Телепортировался к %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
CMD:gethere(playerid, params[])
{
	//if(CheckAdmin(playerid, 3)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /gethere [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(PI[to_player][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, "Нельзя взаимодействовать с администратором выше по рангу");
	static Float: x, Float: y, Float: z;
	GetPlayerPos(playerid, x, y, z);
	SetPlayerPosEx(to_player, x + 1, y + 1, z, 0.0, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid), false);

	player_FracGarageEntered[to_player] = player_FracGarageEntered[playerid];
	player_HouseEntered[to_player] = player_HouseEntered[playerid];
	player_BizEntered[to_player] = player_BizEntered[playerid];
	player_GarageEntered[to_player] = player_GarageEntered[playerid];
	player_EntranceEntered[to_player] = player_EntranceEntered[playerid];
	player_EntranceList[to_player] = player_EntranceList[playerid];
	SetPlayerVirtualWorld(to_player, GetPlayerVirtualWorld(playerid));
	SetPlayerInterior(to_player, GetPlayerInterior(playerid));
	str_mes[0] = EOS;
	format(str_mes, sizeof str_mes, "Администратор %s[%i] телепортивал Вас к себе", PN(playerid), playerid);
	SCM(to_player, -1, str_mes);

	format(str_mes, sizeof str_mes, "Вы телепортивали %s к себе", PN(to_player));
	SCM(playerid, -1, str_mes);

	format(str_mes, sizeof str_mes, "[A] %s[%i] телепортировал к себе %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}
CMD:setfuel(playerid, params[])
{
	extract params -> new vehicleid, fuel; else return SCM(playerid, 0xCECECEFF, !"Используйте: /setfuel [id транспорта] [кол-во топлива]");
	if(!IsValidVehicle(vehicleid)) return SCM(playerid, 0xCECECEFF, !"Данного транспорта не существует на сервере");
	if(!(0 <= fuel <= 150)) return SCM(playerid, 0x999999FF, !"Количество топлива от 0 до 150");
	SetVehicleData(vehicleid, V_FUEL, fuel);
	format(str_mes, sizeof str_mes, "Вы установили %i топлива в ТС №%i", fuel, vehicleid);
	SCM(playerid, -1, str_mes);
	format(str_mes, sizeof str_mes, "[A] %s[%i] установил %i топлива в ТС №%i", PN(playerid), playerid, fuel, vehicleid);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}
CMD:settime(playerid, params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	extract params -> new time; else return SCM(playerid, 0xCECECEFF, !"Используйте: /st [время (0-23)]");

	if(!(0 <= time <= 23)) return SCM(playerid, 0x999999FF, !"Время от 0 до 23 часов");
	SetWorldTime(time);
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] установил время на сервере на %02d:00", PN(playerid), playerid, time);
	return 1;
}
CMD:setweather(playerid, params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	extract params -> new weather; else return SCM(playerid, 0xCECECEFF, !"Используйте: /sw [погода (0-20)]");

	if(!(-1 <= weather <= 20))
	{
		SCM(playerid, 0x999999FF, !"Погода от 0 до 20 (-1 - случайная смена погоды)");
		SCM(playerid, 0x999999FF, !"Рекомендовано: 1, 3, 8, 9, 18");

		return 1;
	}

	if(weather != -1)
		SetWeather(weather);
	else
		SetRandomWeather();

	//new70];

	if(weather != -1)
		format(str_mes, sizeof str_mes, "Вы установили погоду %i", weather);
	else
		format(str_mes, sizeof str_mes, "Вы установили случайную погоду");

	SCM(playerid, -1, str_mes);

	if(weather != -1)
		format(str_mes, sizeof str_mes, "[A] %s[%i] установил погоду на сервере на %i", PN(playerid), playerid, weather);
	else
		format(str_mes, sizeof str_mes, "[A] %s[%i] установил случайную погоду на сервере", PN(playerid), playerid);

	SendAdminsMessage(0x999999FF, str_mes);

	format(str_mes, sizeof str_mes, "Установил погоду №%i на сервере", weather);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
alias:setweather("sw")
alias:settime("st")
CMD:payday(playerid, params[])
{
	PayDay();
	SCM(playerid, -1, !"Вы включили PayDay");

	format(str_mes, sizeof str_mes, "[A] %s[%i] инициировал PayDay", PN(playerid), playerid);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}
CMD:slap(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 2) return 1;

	extract params -> new to_player, string:name[2]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /slap [id игрока] [+/- | + подбросить вверх, - в низ]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(!GetString(name, "+") && !GetString(name, "-")) return SCM(playerid, 0xCECECEFF, !"Используйте: /slap [id игрока] [+/- | + подбросить вверх, - в низ]");
	new Float: x, Float: y, Float: z;//, str_mes[85];
	GetPlayerPos(to_player, x, y, z);
	if(GetString(name, "+")) z += 5.0;
	else z -= 5.0;
	SetPlayerPos(to_player, x, y, z);
	PlayerPlaySound(to_player, 1130, 0.0, 0.0, 0.0);

	format(str_mes, sizeof str_mes, "Вы подбросили игрока %s", PN(to_player));
	SCM(playerid, -1, str_mes);

	format(str_mes, sizeof str_mes, "Администратор %s[%i] подбросил Вас", PN(playerid), playerid);
	SCM(to_player, -1, str_mes);

	//if(GetPlayerAdminEx(playerid) <= 5)
	//{
	format(str_mes, sizeof str_mes, "[A] %s[%i] подбросил игрока %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);
	//}

	format(str_mes, sizeof str_mes, "Подбросил %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
CMD:sethp(playerid, params[])
{
	extract params -> new to_player, health; else
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /sethp [id игрока] [количество здоровья]");
		return 0;
	}

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
	{
		SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
		return 0;
	}

	else if(GetPlayerAdminEx(playerid) == 1 && to_player != playerid)
	{
		SCM(playerid, 0x999999FF, !"Администраторам 1-го уровня доступно изменение только своего уровня здоровья");
		return 0;
	}

	else if(!(0 <= health <= 100))
	{
		SCM(playerid, 0x999999FF, !"Уровень здоровья от 0 до 100");
		return 0;
	}
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Админ %s изменил уровень HP на %i, игроку %s[playerid:%i]", str_log, health, PN(to_player), to_player);
	SendLog(1, str_log);
	SetPlayerData(to_player, pHealth, health);
	SetPlayerHealth(to_player, health);

	if(GetPlayerData(to_player, pHospital))
		SetPlayerData(to_player, pHospital, false);

	str_mes[0] = EOS; ////new105];
	format(str_mes, sizeof str_mes, "Администратор %s изменил Вам уровень здоровья", PN(playerid));
	SCM(to_player, -1, str_mes);

	format(str_mes, sizeof str_mes, "Вы изменили %s уровень здоровья", PN(to_player));
	SCM(playerid, -1, str_mes);

	//if(GetPlayerAdminEx(playerid) <= 5)
	//{
	format(str_mes, sizeof str_mes, "[A] %s[%i] изменил уровень здоровья %s[%i] на %i", PN(playerid), playerid, PN(to_player), to_player, health);
	SendAdminsMessage(0x999999FF, str_mes);
	return 2;
}
alias:sethp("hp")
CMD:spcars(playerid)
{
	//if(CheckAdmin(playerid, 4)) return 1;
	str_1[0] = EOS;
	new vehicles_count;
	foreach(new i: Vehicles)
	{
		new player;
		foreach(new idx: PlayerInVehicle[i]) player++;
		if(!player)
		{
			str_1[vehicles_count] = i;
			vehicles_count++;
		}
	}
	for(new i; i < vehicles_count; i++)
	{
		new j = str_1[i];
		if(!IsValidVehicle(j)) continue;
		SetVehicleToRespawn(j);
	}
	//new90];

	format(str_mes, sizeof str_mes, "Вы зареспавнили весь незанятый транспорт. Всего зареспавнено: %i шт.", vehicles_count);
	SCM(playerid, 0x3399FFFF, str_mes);

	format(str_mes, sizeof str_mes, "[A] %s[%i] зареспавнил весь незанятый транспорт", PN(playerid), playerid);
	SendAdminsMessage(0x999999FF, str_mes);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, "Зареспавнил весь незанятый транспорт");

	return 1;
}

CMD:givegun(playerid, params[])
{
	//if(CheckAdmin(playerid, 5)) return 1;

	extract params -> new to_player, weapon_id, weapon_ammo; else return SCM(playerid, 0xCECECEFF, !"Используйте: /givegun [id игрока] [id оружия] [кол-во патронов]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(!(1 <= weapon_ammo <= 1000)) return SCM(playerid, 0x999999FF, !"Количество патронов от 1 до 1000");

	OnPlayerInventory_WeaponAdd(to_player, weapon_id, weapon_ammo);

	//new128];

	format(str_mes, sizeof str_mes, "Администратор %s[%i] выдал Вам %s и %i патр.", PN(playerid), playerid, weapon_names[weapon_id], weapon_ammo);
	SCM(to_player, -1, str_mes);

	format(str_mes, sizeof str_mes, "Вы выдали игроку %s[%i] %s и %i патр.", PN(to_player), to_player, weapon_names[weapon_id], weapon_ammo);
	SCM(playerid, -1, str_mes);

	//if(GetPlayerAdminEx(playerid) <= 5)
	//{
	format(str_mes, sizeof str_mes, "[A] %s[%i] выдал %s[%i] %s [%i патр]", PN(playerid), playerid, PN(to_player), to_player, weapon_names[weapon_id], weapon_ammo);
	SendAdminsMessage(0x999999FF, str_mes);
	//}

	//format(str_mes, sizeof str_mes, "Выдал %s[acc:%i] %s[%i патр]", PN(to_player), GetPlayerAccountID(to_player), weapon_names[weapon_id], weapon_ammo);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
CMD:makeadmin(playerid, get[])
{
	extract get -> new string:name[24], rang; else
	{
		SCM(playerid, 0xCECECEFF, !"Используйте: /makeadmin [nickname] [rang]");
		return 0;
	}
	new data = GetName_Admin(name);
	if(data == -1)
	{
		SCM(playerid, 0x999999FF, "Игрок с таким именем не зарегистрирован!");
		return 0;
	}
	new to_player = GetPlayerID(name);
	if(!data && (!IsPlayerLogged(to_player) || to_player == playerid)) 
	{
		SCM(playerid, COLOR_RED, "Нельзя изменить тому, у кого уровень админки равен 0");
		return 0;
	}
	if(rang > 8 || rang < 0) return 0;
	if(PI[playerid][pAdmin] < data)
	{
		SCM(playerid, 0x999999FF, "Нельзя взаимодействовать с администратором выше по рангу.");
		return 0;
	}
	if(NameIsFullDostup(name)) return 0;
	str_1[0] = EOS, f(str_1, sizeof str_1, "Админ %s[%i] изменил уровень админ-прав %s[%i] на %i уровень", PN(playerid), playerid, name, to_player, rang);
	SendAdminsMessage(-11521793, str_1);

	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Админ %s изменил уровень администрирования на %i, игроку %s[playerid:%i]", str_log, rang, name, to_player);
	SendLog(1, str_log);
	mysql_tqueryf(mysql, "UPDATE `players` SET `SetAdmin_Time` = '%i', `Admin`= '%i' WHERE `NickName` = '%s' LIMIT 1;", global_time, rang, name);
	if(!IsPlayerLogged(to_player))
	{

	}
	else 
	{
		if(!PI[to_player][pAdmin] && rang > 0)
		{
			//поставлен
			UpdatePlayerDataInt(to_player, "MakeAdmin_Time", global_time);
			UpdatePlayerDataStr(to_player, "MakeAdmin_Name", PN(playerid));
		}
		PI[to_player][pAdmin] = rang;
	}
	return 2;
}
stock SetPlayerAdmin(playerid, level)
{
	SetPlayerData(playerid, pAdmin, level);
	UpdatePlayerDataInt(playerid, "Admin", level);
}
CMD:givemoney(playerid, params[])
{
	//if(CheckAdmin(playerid, 5)) return 1;

	extract params -> new to_player, cash; else return SCM(playerid, 0xCECECEFF, !"Используйте: /givemoney [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	if(!(-250000000 <= cash <= 250000000)) return SCM(playerid, 0xCECECEFF, !"Можно выдавать от -250.000.000 до 250.000.000 рублей за один раз");

	f(str_mes, sizeof str_mes, "Выдача денег от админа %s", PN(playerid));
	GivePlayerMoneyEx(to_player, cash, str_mes, true, true);

	format(str_mes, sizeof str_mes, "Администратор %s выдал Вам %i рублей", PN(playerid), cash);
	SCM(to_player, 0xFFFFFFFF, str_mes);

	format(str_mes, sizeof str_mes, "[A] %s[%i] выдал деньги %s[%i] кол-во %i руб, в итоге у игрока (%s + %i) руб", PN(playerid), playerid, PN(to_player), to_player, cash, GetStrMoney(to_player), cash);
	SendAdminsMessage(0xFFFF00FF, str_mes);
	SCM(playerid, -1, "Готово");

	format(str_mes, sizeof str_mes, "Выдал %s[acc:%i] %i руб", PN(to_player), GetPlayerAccountID(to_player), cash);
	//SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

	return 1;
}

CMD:givedonate(playerid, params[])
{
	//if(CheckAdmin(playerid, 5)) return 1;

	extract params -> new to_player, donate; else return SCM(playerid, 0xCECECEFF, !"Используйте: /givedonate [id игрока] [cумма]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	if(!(-5000 <= donate <= 5000)) return SCM(playerid, 0xCECECEFF, !"Можно выдавать от -5000 до 5000 доната за один раз");

	format(str_mes, sizeof str_mes, "Выдача доната от админа %s", PN(playerid));
	GivePlayerDonate(to_player, donate, str_mes, true, true);

	format(str_mes, sizeof str_mes, "Администратор %s выдал Вам %i доната", PN(playerid), donate);
	SCM(to_player, 0xFFFFFFFF, str_mes);

	format(str_mes, sizeof str_mes, "[A] %s[%i] выдал донат %s[%i] кол-во %i руб, в итоге у игрока %i руб",
	PN(playerid), playerid, PN(to_player), to_player, donate, GetPlayerCashDonate(to_player));
	SendAdminsMessage(0xFFFF00FF, str_mes);

	format(str_mes, sizeof str_mes, "Выдал %s[acc:%i] %i руб доната", PN(to_player), GetPlayerAccountID(to_player), donate);
	//SendLog(playerid, LOG_TYPE_SUPERADMIN_ACTION, reason);

	return 1;
}
alias:setstats("setstat")
CMD:setstats(playerid, params[])
{
	//if(CheckAdmin(playerid, 8)) return 1;
	extract params -> new to_player, set_code, set_value; else {

		SCM(playerid, 0xCECECEFF, !"Использование: /setstats [id игрока] [код] [значение]");
		SCM(playerid, 0xCECECEFF, !"Код: 1 - Уровень 2 - РП");
		return 1;
	}
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	str_mes[0] = EOS; ////new128];

	switch(set_code)
	{
		case 1:
		{
			if(!(1 <= set_value <= 25)) return SCM(playerid, 0xFF6600FF, !"Уровень от 1 до 25");

			SetPlayerData(to_player, pLevel, set_value);

			SetPlayerScore(to_player, set_value);

			format(str_mes, sizeof str_mes, "Администратор %s изменил Вам уровень на %i", PN(playerid), set_value);
			SCM(to_player, 0x3399FFFF, str_mes);

			format(str_mes, sizeof str_mes, "Вы изменили игроку %s уровень на %i", PN(to_player), set_value);
			SCM(playerid, 0x66CC00FF, str_mes);
			UpdatePlayerDataInt(to_player, "Level", PI[to_player][pLevel]);
		}
        case 2:
		{
			SetPlayerData(to_player, pLevel_RP, set_value);
			UpdatePlayerDataInt(to_player, "Level_RP", set_value);
    		format(str_mes, sizeof str_mes, "Вы установили %s [%i] %i очков уровня RolePlay", PN(to_player), to_player, set_value);
    		SCM(playerid, -1, str_mes);
		}
		default: return SCM(playerid, 0xFF6600FF, !"Ошибка: Неверно введен код");
	}
	return 1;
}

CMD:rp(playerid, params[])
{
	if(!(2 <= GetPlayerLevel(playerid) <= 100)) return SCM(playerid, 0xFF6600FF, !"Доступно с 2-го уровня");

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /rp [ID игрока] [+/-]");
	extract params -> new to_player, string:level_rp[2];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(to_player == playerid) return SCM(playerid, 0xFF6600FF, !"Нельзя изменять уровень RolePlay самому себе");
	if(level_rp[0] == '+') SCMf(to_player, 0x66CC00FF, "Игрок %s повысил Ваш уровень RolePlay", PN(playerid));
	else if(level_rp[0] == '-') SCMf(to_player, 0xFF6600FF, "Игрок %s понизил Ваш уровень RolePlay", PN(playerid));
	else return SCM(playerid, 0xFF6600FF, !"Введите действие: '+' чтобы повысить или '-' чтобы понизить");
	SCMf(playerid, 0x66CC00FF, !"Вы %s уровень RolePlay игроку %s [%i]", (level_rp[0] == '+') ? ("повысили") : ("понизили"),  PN(to_player), to_player);
	SetPlayerData(to_player, pLevel_RP, GetPlayerLevelRpEx(to_player) + 1);
 	UpdatePlayerDataInt(to_player, "Level_RP", GetPlayerLevelRpEx(to_player) + 1);
	return 1;
}
CMD:pay(playerid, params[])
{
	extract params -> new to_player, cash; else return SCM(playerid, 0xCECECEFF, !"Используйте: /pay [id игрока] [сумма]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 6.0)) return SCM(playerid, 0x999999FF, !"Игрок находится далеко от Вас");
	new max_money;
	if(GetPlayerAdminEx(playerid) < 2){
		max_money = GetPlayerLevel(playerid) > 2 ? 40000 : 20000;
	}
	if(GetPlayerAdminEx(playerid) > 2){
	    max_money = GetPlayerAdminEx(playerid) > 6 ? 500000 : 250000;
	}
	if(!(1 <= cash <= max_money)){
		format(str_mes, sizeof str_mes, "Сумма должна быть от 1 до %i рублей", max_money);
		SCM(playerid, 0xCECECEFF, str_mes);
		return 1;
	}
	if(CompareInt64(playerid, "<", cash)) return SCM(playerid, 0x999999FF, !"Недостаточно денег");

	format(str_mes, sizeof str_mes, "+%i", cash);
	SetPlayerChatBubble(to_player, str_mes, 0x00CC00FF, 10.0, 5000);

	format(str_mes, sizeof str_mes, "-%i", cash);
	SetPlayerChatBubble(playerid, str_mes, 0xFF6600FF, 10.0, 5000);

	format(str_mes, sizeof str_mes, "Передача денег от %s", PN(playerid));
	GivePlayerMoneyEx(to_player, cash, str_mes, true, true);

	format(str_mes, sizeof str_mes, "Передача денег игроку %s", PN(to_player));
	GivePlayerMoneyEx(playerid, -cash, str_mes, true, true);

	format(str_mes, sizeof str_mes, "%s передал Вам деньги %i руб", PN(playerid), cash);
	SCM(to_player, 0x3399FFFF, str_mes);

	format(str_mes, sizeof str_mes, "Вы передали игроку %s деньги %i руб", PN(to_player), cash);
	SCM(playerid, 0x3399FFFF, str_mes);

	Action(playerid, "достал кошелёк и передал деньги", _, false);
	return true;
}
CMD:eject(playerid, params[])
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!vehicleid || !IsPlayerDriver(playerid))
		return SCM(playerid, 0x999999FF, !"Вы должны сидеть за рулем транспорта");

	if(!strlen(params))
		return SCM(playerid, 0x999999FF, !"Используйте: /eject [id игрока]");

	extract params -> new to_player;

	if(vehicleid != GetPlayerVehicleID(to_player) || playerid == to_player)
		return SCM(playerid, 0x999999FF, !"Игрок должен сидеть в Вашем транспорте");

	RemovePlayerFromVehicle(to_player);

	format(str_mes, sizeof str_mes, "%s выкинул Вас из своего транспорта", PN(playerid));
	SCM(to_player, 0x3399FFFF, str_mes);

	format(str_mes, sizeof str_mes, "Вы выкинули %s из своего транспорта", PN(to_player));
	SCM(playerid, 0x3399FFFF, str_mes);

	return 1;
}
CMD:healme(playerid)
{
	if(GetInvCount(playerid, 2) <= 0)
		return SCM(playerid, 0xCECECEFF, !"У Вас нет с собой аптечки");

	InvRemoveEx(playerid, 2, 1, -1, -1, "", "/healme");
	//InvAdd(playerid, 2, -1, false, 0, 0, "", "/healme");
	SetPlayerHealthEx(playerid, 60.0);

	GameTextForPlayerEx(playerid, "~b~+60 hp", 4000, 1);
	SCM(playerid, 0x3399FFFF, !"Вы использовали аптечку. Здоровье пополнено на 60 единиц");

	ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 0);

	return 1;
}

CMD:present(playerid, params[])
{
	if(!IsPlayerHaveWeapon(playerid, WEAPON_FLOWER))
		return SCM(playerid, 0xCECECEFF, !"У Вас нет цветов");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /present [id игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	if(!IsPlayerInRangeOfPlayer(playerid, to_player, 3.0))
		return SCM(playerid, 0xCECECEFF, !"Игрок слишком далеко");

	if(IsPlayerHaveWeapon(to_player, WEAPON_FLOWER))
		return SCM(playerid, 0xCECECEFF, !"У этого игрока уже есть букет цветов");

	new Float: angle;
	new Float: to_x, Float: to_y;
	new Float: x, Float: y, Float: z;

	GetPlayerPos(playerid, x, y, z);
	GetPlayerPos(to_player, to_x, to_y, z);

	angle = GetAngleToPoint(to_x, to_y, x, y);

	SetPlayerFacingAngle(playerid, angle);
	SetPlayerFacingAngle(to_player, angle + 180.0);

	ApplyAnimation(playerid, "DEALER", "DEALER_DEAL", 4.0, 0, 0, 0, 0, 0, 0);
	ApplyAnimation(to_player, "DEALER", "DEALER_DEAL", 4.0, 0, 0, 0, 0, 0, 0);

	format(str_mes, sizeof str_mes, "%s получил(а) от Вас цветы", PN(to_player));
	SCM(playerid, 0x3399FFFF, str_mes);

	format(str_mes, sizeof str_mes, "%s подарил(а) Вам цветы", PN(playerid));
	SCM(to_player, 0x3399FFFF, str_mes);

	SetTimerEx("PresentFlowersToPlayer", 1500, false, "ii", playerid, to_player);
	return 1;
}

CMD:mask(playerid)
{
	if(PI[playerid][pTemp_Mask] != 0)
	{
		PI[playerid][pTemp_Mask] = 0;
		ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 0);
		SetPlayerChatBubble(playerid, "Снимает маску", 0xFF9900FF, 15.0, 5000);
		GameTextForPlayerEx(playerid, "~b~~h~invisible off", 2500, 4);
		player_UpdatePerson(playerid);
		return 1;
	}
	if(GetInvCount(playerid, 255) < 1) return SCM(playerid, 0xCECECEFF, !"У Вас нет с собой маски");
	//InvAdd(playerid, 255, -1, false, 0, 0, "", "/mask");
	InvRemoveEx(playerid, 255, 1, -1, -1, "", "/mask");
	new id = GetFamilyID(PI[playerid][pFamily_ID]),
		time = 600;
	if(id != -1)
	{
		if(FamilyData[id][fGang] != false && FamilyData[id][fGang_Improve][0] != 0) time += 600;
	}
	SetPlayerData(playerid, pTemp_Mask, time);
	SetPlayerColor(playerid, 0x000000AA);

	ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0, 0);
	SetPlayerChatBubble(playerid, "Надевает маску", 0xFF9900FF, 15.0, 5000);

	GameTextForPlayerEx(playerid, "~b~~h~invisible on", 2500, 4);
	SCMf(playerid, 0x3399FFFF, "Ваше месторасположение на GPS скрыто на %i минут", time/60);

	return 1;
}
CMD:exit(playerid)
{
	if(player_HouseExited{playerid} != false)
	{
		new id = player_HouseEntered[playerid];
		if(id != -1)
		{
			if(HouseData[id][hVirtualWorld_ID] > 0)
			{
				player_EntranceEntered[playerid] = HouseData[id][hEntrance_ID];
				player_EntranceList[playerid] = HouseData[id][hEntrance_List];
			}
			SetPlayerPosEx(playerid, HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], HouseData[id][hEnter][3], HouseData[id][hInterior_ID], HouseData[id][hVirtualWorld_ID], false);
			player_HouseEntered[playerid] = -1;
		}
		else SCM(playerid, 0xCECECEFF, !"Вы не в помещении");
	}
	return 1;
}
stock SearchNearestOwnablePlayer(playerid)
{
	new carid = GetPlayerVehicleID(playerid);
	if(carid > 0)
	{
		new number = GetVehicleID(carid);
		if(number == INVALID_VEHICLE_ID) return -1;
		if(!GetString(CarData[number][cOwner], PN(playerid))) return -1;
	}
	new Float:Distance, Float:Distance_ = 100000.0, useid = -1;
	foreach(new i: OWNABLECARS)
	{
		if(!GetString(CarData[i][cOwner], PN(playerid))) continue;
		static Float:position[3];
		GetVehiclePos(OwnableCar[i], position[0], position[1], position[2]);
		Distance = GetPlayerDistanceFromPoint(playerid, position[0], position[1], position[2]);
		if(Distance < Distance_) useid = i, Distance_ = Distance;
	}
	if(useid != -1) return OwnableCar[useid];
	return -1;
}
CMD:kiss(playerid, params[])
{
	if(IsPlayerInAnyVehicle(playerid))
		return SCM(playerid, 0x999999FF, !"Нельзя использовать в машине");

	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /kiss [ID игрока]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player) || to_player == playerid)
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(OpenInterface[to_player][6] != false) return SCM(playerid, 0x999999FF, !"Вы находитесь слишком далеко от игрока");
	if(GetPlayerSex(playerid) == GetPlayerSex(to_player)) return SCM(playerid, 0x999999FF, !"Вы не можете поцеловать игрока того же пола как и Вы");

	new Float: to_x, Float: to_y, Float: z;
	GetPlayerPos(to_player, to_x, to_y, z);

	new Float: dist = GetPlayerDistanceFromPoint(playerid, to_x, to_y, z);
	if(0.5 <= dist <= 2.5)
	{
		SendPlayerOffer(playerid, to_player, OFFER_TYPE_KISS);
	}
	else SCM(playerid, 0x999999FF, !"Вы находитесь слишком далеко от игрока");
	return 1;
}

CMD:drugs(playerid, const params[])
{
	if(GetPVarInt(playerid,!"DrugsTime") > global_time) return SCM(playerid, 0x999999FF, !"Вы недавно употребляли наркотики.. Подождите немного");
	if(sscanf(params, "i", params[0])) return SCM(playerid, 0xCECECEFF, !"Информация: /drugs [кол-во грамм]");
	if(GetInvCount(playerid, 25) < params[0]) return SCM(playerid, 0x999999FF, !"У Вас нет наркотиков");
	if(params[0] > 5)
	{
	    str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "Количество от 1 до 5, сейчас У Вас %i грамм", GetInvCount(playerid, 25));
		SCM(playerid, COLOR_GREY, str_mes);
		return 1;
	}

	SetPlayerHealthEx(playerid, params[0]*20);

	if(PI[playerid][pHealth] > 99) return SCM(playerid, COLOR_GREY, "Вам плохо от наркотиков, пожалуйста подождите");

	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid,"SMOKING","M_smk_drag",4.1,0,0,0,0,0,1);
	f(str_mes, sizeof(str_mes), "Вы употребили %i гр. наркотиков. Ваше здоровье: %3.1f", params[0], PI[playerid][pHealth]);
	SCM(playerid, COLOR_GOLD, str_mes);
	//InvAdd(playerid, 25, -params[0], false, 0, 0, "", "/drugs");
	InvRemoveEx(playerid, 25, -params[0], -1, -1, "", "/drugs");

	//drug_effect_gone_timer[playerid] = 6;

	SetPVarInt(playerid, !"DrugsTime", global_time + 60);

	format(str_mes, sizeof str_mes, "%s употребил(a) %i грамм наркотиков", PN(playerid), params[0]);
	SendMessageInLocal(playerid, str_mes, 0xDD90FFFF, 25.0);

	SetPlayerTime(playerid,17,0);
	SetPlayerDrunkLevel(playerid, 3000);
	SetPlayerWeather(playerid, -68);

	return 1;
}
CMD:tp(playerid)
{
	if(number_mp_player < 1 || mp_status == 2) return SCM(playerid, 0x808080FF, "В данный момент точки телепорта нету");
    if(GetPlayerData(playerid, pJailTime) > 0) return SCM(playerid, 0xFFFFFFAA, "Заключённым нельзя телепортироваться");
	if(player_Paintball_ID{playerid} != 255 || PI[playerid][pHospital] != false)
	{
		return SCM(playerid, COLOR_RED, "В данный момент невозможно");
	}
	SCM(playerid, 0x99CC00FF, "[МП] Вы были телепортированы");
	SetPlayerPos(playerid, mpPos[0], mpPos[1], mpPos[2]);
    SetPlayerInterior(playerid, mpWorld[0]);
	SetPlayerVirtualWorld(playerid, mpWorld[1]);
	number_mp_player--;
	SetPVarInt(playerid, !"statusMP", 1);
	return 1;
}

CMD:mp_tp(playerid, params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;
	extract params -> new to_number, tp_status; else return SCM(playerid, 0x808080FF, "Используйте: /mp_tp [количество участников] [1 (открыть) / 2 (закрыть)]");
	if(!(1 <= to_number <= 500)) return SCM(playerid, 0x808080FF, "Вы указали не правильное кол-во участников [Min - 1] [Max - 500]");
	if(!(1 <= tp_status <= 2)) return SCM(playerid, 0x808080FF, "Укажите 1 - для открытия телепорта | 2 - закрытие");
	if(mp_status == tp_status) return SCM(playerid, 0x808080FF, "Телепорт на мероприятие уже открыт!");
	switch(tp_status)
	{
		case 1:
		{
			SCM(playerid, 0x3399FFFF, !"Точка телепорта установлена");
            f(str_mes, sizeof(str_mes), "{FFFFFF}Максимальное Кол-во игроков %i", to_number);
			number_mp_player = to_number;
			mp_status = 1;
			GetPlayerPos(playerid, mpPos[0], mpPos[1], mpPos[2]);
			mpWorld[0] = GetPlayerInterior(playerid);
			mpWorld[1] = GetPlayerVirtualWorld(playerid);
		}
		case 2:
		{
			f(str_mes, sizeof(str_mes), "{FF4500}Точка телепорта удалена");
			for(new i = 0; i < 3; i++) mpPos[i] = 0;
			for(new i = 0; i < 2; i++) mpWorld[i] = 0;
			number_mp_player = 0;
			mp_status = 2;
			foreach(new i: Player) DeletePVar(i, !"statusMP");
		}
	}
	SCM(playerid, -1, str_mes);
	return 1;
}

CMD:window(playerid, params[])
{
	if(!IsPlayerInAnyVehicle(playerid) || GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;

	extract params -> new type; else return SCM(playerid, 0xCECECEFF, !"Используйте: {ffffff} /window [тип] < Типы: 1 - водительское | 2 - пассажирское (спереди) | 3 - заднее (левое) | 4 - заднее (правое) >");

	new vehicleid = GetPlayerVehicleID(playerid),
		driver,
		passenger,
		backleft,
		backright;

	GetVehicleParamsCarWindows(vehicleid, driver, passenger, backleft, backright);

	switch(type)
	{
		case 1: driver = !driver ? (1) : (0);
		case 2: passenger = !passenger ? (1) : (0);
		case 3: backleft = !backleft ? (1) : (0);
		case 4: backright = !backright ? (1) : (0);
	}

	SetVehicleParamsCarWindows(vehicleid, driver, passenger, backleft, backright);

	return 1;
}
CMD:setarm(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	extract params -> new to_player, armour; else return SCM(playerid, COLOR_GREY, "Используйте: /setarm [ID игрока] [количество брони]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");

	else if(!(0 <= armour <= 100)) return SCM(playerid, 0xFF6600FF, !"Уровень брони от 0 до 100");


	SetPlayerArmourEx(to_player, armour);

	str_mes[0] = EOS; ////new105];
	format(str_mes, sizeof str_mes, "Администратор %s изменил Вам уровень брони", PN(playerid));
	SCM(to_player, -1, str_mes);

	format(str_mes, sizeof str_mes, "Вы изменили %s уровень брони", PN(to_player));
	SCM(playerid, -1, str_mes);

	return 1;
}
alias:setarm("setarmour")
// ------------------------------система-мп---------------------------
CMD:hpall(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	new Float:ps;

	if(sscanf(params, "f", ps)) SCM(playerid, COLOR_GREY, "Используйте: /hpall [радиус]");

	if(ps < 20 || ps > 200) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 200");

	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, ps, pos[0], pos[1], pos[2])) continue;
		SetPlayerHealth(i, 100);
		SetPlayerData(i, pHealth, 100);
		PI[i][pHospital] = false;
		UpdatePlayerDataInt(i, "Hospital", PI[i][pHospital]);
		SCMf(i, COLOR_WHITE, "Администратор %s изменил Вам уровень здоровья", PN(playerid));
	}

	SCM(playerid, COLOR_WHITE, "Вы успешно изменили HP игрокам в радиусе");

	return 1;
}
CMD:armall(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	new Float:ps;

	if(sscanf(params, "f", ps)) SCM(playerid, COLOR_GREY, "Используйте: /armall [радиус]");

	if(ps < 20 || ps > 200) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 200");

	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, ps, pos[0], pos[1], pos[2])) continue;
		SetPlayerArmourEx(i, 100.0);
		UpdatePlayerDataFloat(i, "Armour", PI[i][pArmour]);
		SCMf(i, COLOR_WHITE, "Администратор %s изменил Вам уровень бронежилета", PN(playerid));
	}

	SCM(playerid, COLOR_WHITE, "Вы успешно изменили HP игрокам в радиусе");

	return 1;
}
alias:armall("armourall")
CMD:mp_gun(playerid,params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	new gun, ammo, radius;

	if(sscanf(params, "iii", radius, gun, ammo)) return SCM(playerid, COLOR_GREY, "Используйте: /mp_gun [радиус] [id оружия] [патроны]");
	if(radius < 1 || radius > 200) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 200");

	if(gun < 1 || gun > 46 || gun == 38 || gun == 36 || gun == 35 || gun == 37) return SCM(playerid, 0xFF6600FF, !"Неверный ID оружия");

	if(ammo < 1 || ammo > 999) return SCM(playerid, 0xFF6600FF, !"Патронов может быть от 1 до 999");

	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	new players;
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, radius, pos[0], pos[1], pos[2])) continue;
		GivePlayerWeapon(i, gun, ammo);
		SCMf(i, COLOR_GOLD, "[MP]: Вы получили оружие %s [%i] и %i пт от %s", weapon_names[gun], gun, ammo, PN(playerid));
		players++;
	}
	SCMf(playerid, COLOR_WHITE,"Оружие выдано %i игрокам в радиусе %i метров", players, radius);
	return 1;
}

CMD:mp_skin(playerid,params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	new skin, radius;

	if(sscanf(params, "iii", radius, skin)) return SCM(playerid, COLOR_GREY, "Используйте: /mp_skin [радиус] [id скина]");
	if(radius < 1 || radius > 200) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 200");
	if(!IsValidSkin(skin)) return SCM(playerid, 0xCECECEFF, !"Неверный ID скина.");
	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	new players;
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, radius, pos[0], pos[1], pos[2])) continue;
		SetPlayerSkin(i, skin);
	}
	SCMf(playerid, COLOR_WHITE, "Скин выдан %i игрокам в радиусе %i метров", players + 1, radius);
	return 1;
}

CMD:mp_spawn(playerid, params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	extract params -> new radius; else return SCM(playerid, COLOR_GREY, "Используйте: /mp_spawn [радиус]");

	if(radius < 1 || radius > 100) return SCM(playerid, 0xFF6600FF, !"Радиус от 1 до 100");

	new Float:pos[3];

	GetPlayerPos(playerid,pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, radius, pos[0], pos[1], pos[2])) continue;
		player_Spawn(i);
		SCM(i, COLOR_WHITE, "Администратор заспавнил Вас");
	}

	SCM(playerid, COLOR_WHITE, "Вы успешно засвнили игроков в радиусе");

	return 1;
}

CMD:mp_freeze(playerid,params[])
{
	//if(CheckAdmin(playerid, 4)) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Используйте: /mp_freeze [радиус]");

	extract params -> new radius;

	if(radius < 1 || radius > 100) return SCM(playerid, 0xFF6600FF, !"Радиус от 1 до 100");

	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, radius, pos[0], pos[1], pos[2])) continue;
		TogglePlayerControllable(i, false);
		SCM(i, COLOR_WHITE, "Администратор заморозил Вас");
	}

	SCM(playerid, COLOR_WHITE, "Вы успешно заморозили игроков в радиусе");

	return 1;
}

CMD:freeze(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Используйте: /freeze [id player]");

	extract params -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	TogglePlayerControllable(to_player,false);
	
	SCMf(to_player, COLOR_WHITE, "Администратор %s[%i] заморозил Вас", PN(playerid), playerid);

	SCM(playerid, COLOR_WHITE, "Вы успешно заморозили игрока");
	format(str_mes, sizeof str_mes, "[A] %s[%i] заморозил игрока %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}


CMD:unfreeze(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Используйте: /freeze [id player]");

	extract params -> new to_player;
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	TogglePlayerControllable(to_player,true);
	SCMf(to_player, COLOR_WHITE, "Администратор %s разморозил Вас", PN(playerid));

	SCM(playerid, COLOR_WHITE, "Вы успешно разморозили игрока");
	format(str_mes, sizeof str_mes, "[A] %s[%i] разморозил игрока %s[%i]", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}

CMD:mp_unfreeze(playerid,params[])
{
	//if(GetPlayerAdminEx(playerid) < 4) return 1;

	if(!strlen(params)) return SCM(playerid, COLOR_GREY, "Используйте: /mp_unfreeze [радиус]");

	extract params -> new radius;

	if(radius < 1 || radius > 100) return SCM(playerid, 0xFF6600FF, !"Радиус от 1 до 100");

	new Float:pos[3];

	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		if(!IsPlayerInRangeOfPoint(i, radius, pos[0], pos[1], pos[2])) continue;
		TogglePlayerControllable(i, true);
		SCMf(i, COLOR_WHITE, "Администратор %s разморозил Вас", PN(playerid));
	}

	SCM(playerid, COLOR_WHITE, "Вы успешно разморозили игроков в радиусе");

	return 1;
}
// ------------------------------------------------------------
CMD:divorce(playerid, params[])
{
	if(!IsPlayerInRangeOfPoint(playerid, 35.0, -1293.4110, 717.4692, 2002.0000)) return SCM(playerid, 0xFF6600FF, !"Вы должны находиться в церкви");

	if(GetPlayerBrakEx(playerid) < 1)
 		return SCM(playerid, 0xFF6600FF, !"Вы не состоите в браке");
	SCMf(playerid, COLOR_GOLD, "Вы развелись своим супругом (супругой)", GetPlayerBrakEx(playerid));
	mysql_tqueryf(mysql, "UPDATE `players` SET `NickName_Wife` = ' ' WHERE `ID`='%i' LIMIT 1", GetPlayerAccountID(playerid));
	return 1;
}
// -------------------------система еды епта---------------------
stock ProxDetector(Float:radi, playerid, const str[],col1,col2,col3,col4,col5)
{
	static Float:oldposx, Float:oldposy, Float:oldposz;
	GetPlayerPos(playerid, oldposx, oldposy, oldposz);
	foreach(new i: PlayerPlayersStream[playerid])
	{
		static 
			Float:tempposx, Float:tempposy, Float:tempposz,
			Float:posx, Float:posy, Float:posz;
		GetPlayerPos(i, posx, posy, posz);
		tempposx = (oldposx -posx);
		tempposy = (oldposy -posy);
		tempposz = (oldposz -posz);
		if (((tempposx < radi/16) && (tempposx > -radi/16)) && ((tempposy < radi/16) && (tempposy > -radi/16)) && ((tempposz < radi/16) && (tempposz > -radi/16))) SCM(i, col1, str);
		else if (((tempposx < radi/8) && (tempposx > -radi/8)) && ((tempposy < radi/8) && (tempposy > -radi/8)) && ((tempposz < radi/8) && (tempposz > -radi/8))) SCM(i, col2, str);
		else if (((tempposx < radi/4) && (tempposx > -radi/4)) && ((tempposy < radi/4) && (tempposy > -radi/4)) && ((tempposz < radi/4) && (tempposz > -radi/4))) SCM(i, col3, str);
		else if (((tempposx < radi/2) && (tempposx > -radi/2)) && ((tempposy < radi/2) && (tempposy > -radi/2)) && ((tempposz < radi/2) && (tempposz > -radi/2))) SCM(i, col4, str);
		else if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) SCM(i, col5, str);
	}
	return true;
}
stock GetDistanceBetweenPoints(Float: X, Float: Y, Float: Z, Float: PointX, Float: PointY, Float: PointZ)
{
	new Float: Distance;

	Distance = floatabs(floatsub(X, PointX)) + floatabs(floatsub(Y, PointY)) + floatabs(floatsub(Z, PointZ));

	return floatround(Distance);
}
stock SetString(param_1[], const param_2[], size = 300)
{
	return strmid(param_1, param_2, 0, strlen(param_2), size);
}
new
	RETURN_STRING[2048];
stock String_PackMassive_return(Data[][], len = sizeof Data)
{
	RETURN_STRING[0] = EOS;
	
	for(new i; i < len; i++)
	{
		strcat(RETURN_STRING, ( str_f("%s%s", Data[i], (len-1) == i ? "":",") ) );
	}
}

#define String_PackMassive(%1) (String_PackMassive_return(%1), RETURN_STRING)
public: OnPlayerTintingSelectGlass(playerid, glass)
{
	SCMDf(playerid,"glass %i",glass);
	return 1;
}
stock ExecutePacket_CarTurn(type, playerid, vehicleid, id, status=0)
{
    if(!type)
	{
		new
			BitStream:bsn = BS_New();

		BS_WriteValue(bsn, PR_UINT8, 215);
		BS_WriteValue(bsn, PR_UINT16, 15);
		BS_WriteValue(bsn, PR_UINT32, vehicleid);
		BS_WriteValue(bsn, PR_UINT8, id);
		BS_WriteValue(bsn, PR_UINT8, status);
		foreach(new i: VehiclePlayersStream[vehicleid]) PR_SendPacket(bsn, i);
		BS_Delete(bsn);
	}
	else 
	{
		new
			BitStream:bsn = BS_New();

		BS_WriteValue(bsn, PR_UINT8, 215);
		BS_WriteValue(bsn, PR_UINT16, 17);
		BS_WriteValue(bsn, PR_UINT32, vehicleid);
		BS_WriteValue(bsn, PR_UINT32, id);
		BS_WriteValue(bsn, PR_UINT32, 0);

		PR_SendPacket(bsn, playerid);
		BS_Delete(bsn);
	}
}
stock ExecutePacket(playerid, webTypes:type, const string[], const string2[]="")
{
    new BitStream:bsn = BS_New(),
		bool:sPacket;

	if(type == webOpen || type == webClose) sPacket = true;
    BS_WriteValue(bsn, 
			PR_UINT8, 215,
			PR_UINT16, 2,
			PR_UINT32, _:type,
			PR_UINT8, (!sPacket ? 1 : 2),
			PR_STRING32, string);
	if(sPacket != false) BS_WriteValue(bsn, PR_STRING32, string2);

    PR_SendPacket(bsn, playerid);
    BS_Delete(bsn);
	return 1;
}
stock ShowCefPublic(playerid, id, BitStream:bs)
{
	if(id == -1) return 1;
	if(!IsPlayerLogged(playerid))
	{
		//printf("%s[%i]", CefPublic[id][uname], id);
		if(PI[playerid][pID] == -1)
		{
			switch(id)
			{
				case 2,3,36:
				{
					
				}
				default:
				{
					printf("%s[%i] ShowCefPublic(%s[%i]) pID = -1", PN(playerid), playerid, CefPublic[id][uname], id);
					return 1;
				}
			}
		}
		else
		{
			switch(id)
			{
				case 4,77,5,142:
				{
					
				}
				default:
				{
					printf("%s[%i] ShowCefPublic(%s[%i]) pID = %i", PN(playerid), playerid, CefPublic[id][uname], id, PI[playerid][pID]);
					return 1;
				}
			}
		}
	}
	else
	{
		switch(id)
		{
			case 4,2,3,36,77:
			{
				printf("%s[%i] ShowCefPublic(%s[%i]) pID = %i && IsPlayerLogged == true", PN(playerid), playerid, CefPublic[id][uname], id, PI[playerid][pID]);
				return 1;
			}
			default:
			{

			}
		}
	}
	printf("%s[%i] ShowCefPublic(%s[%i]) pID = %i", PN(playerid), playerid, CefPublic[id][uname], id, PI[playerid][pID]);
	new eventid, defaultid;
	switch(id)
	{
		case -1: return 1; //hide
		case 0: //Tuning_OnStageMenuEvent
		{
			if(!OpenInterface[playerid][66]) return 1;
			BS_IgnoreBits(bs, 40);
			BS_ReadUint32(bs, eventid);
			BS_IgnoreBits(bs, 8);
			BS_ReadUint32(bs, defaultid);
			player_StageTuning_Click(playerid, eventid, defaultid);
		}
		case 1: //OnPlayerTintingOrder
		{
			BS_IgnoreBits(bs, 40);
			BS_ReadUint32(bs, eventid);
			OnPlayerTuningTinting(playerid, eventid);
		}
		case 2: //OnRegistrationData
		{
			BS_IgnoreBits(bs, 40);
			str_mes[0] = EOS, BS_ReadString32(bs, str_mes);

			BS_IgnoreBits(bs, 8);

			str_1[0] = EOS, BS_ReadString32(bs, str_1);

			BS_IgnoreBits(bs, 8);
			str_2[0] = EOS, BS_ReadString32(bs, str_2);

			static
				email[64 + 1],

				password_first[64 + 1],
				password_second[64 + 1];
			mysql_escape_string(str_mes, email, 65);
			mysql_escape_string(str_1, password_first, 65);
			mysql_escape_string(str_2, password_second, 65);
			player_RegisterData(playerid, email, password_first, password_second);
		}
		case 3: //OnRegistrationCharacter
		{
			if(IsPlayerLogged(playerid) || PI[playerid][pID] != -1) return 1;
			static skinid;
			BS_IgnoreBits(bs, 40);
			BS_ReadUint32(bs, eventid);
			BS_IgnoreBits(bs, 8);
			BS_ReadUint32(bs, defaultid);
			BS_IgnoreBits(bs, 8);
			BS_ReadUint32(bs, skinid);

			player_RegisterCharacter(playerid, eventid, defaultid, skinid);
		}
		case 36: //OnRegistrationBonuses
		{
			if(IsPlayerLogged(playerid) || PI[playerid][pID] != -1) return 1;
			BS_IgnoreBits(bs, 40);
			str_mes[0] = EOS, BS_ReadString32(bs, str_mes);
			static nickname[24];
			mysql_escape_string(str_mes, nickname, 24);
			player_RegisterEnd(playerid, nickname);
		}
		case 4: //OnAuthorizationStart
		{
			if(IsPlayerLogged(playerid) || PI[playerid][pID] == -1) return 1;
			BS_IgnoreBits(bs, 40);
			str_mes[0] = EOS, BS_ReadString32(bs, str_mes);
			static password[25];
			mysql_escape_string(str_mes, password, 25);
			player_AuthEnd(playerid, password);
		}
		case 5:
		{
			str_1[0] = EOS;
			BS_IgnoreBits(bs, 80); //40+32
			if(player_DialogID[playerid] != 20375 && !IsPlayerLogged(playerid)) return 1;
			BS_ReadUint32(bs, eventid);
			BS_IgnoreBits(bs, 8);
			BS_ReadUint32(bs, defaultid);
			BS_IgnoreBits(bs, 8);
			str_1[0] = EOS, str_mes[0] = EOS, BS_ReadString32(bs, str_1);
			if(strlen(str_1) < 128) mysql_escape_string(str_1, str_mes, 144);

			str_2[0] = EOS, f(str_2, sizeof(str_2), "%s", (isnull(str_mes)) ? ("\1") : (str_mes));
			OnDialogResponseEx(playerid, eventid, defaultid, str_2);
		}
		case 6://OnSelectSpectateMenu
		{
			if(!OpenInterface[playerid][id]) return 0;
			BS_IgnoreBits(bs, 40);
			BS_ReadUint32(bs, eventid);
			player_SelectSpectateMenu(playerid, eventid);
		}
		case 7: //OnInventoryDisplayChange
