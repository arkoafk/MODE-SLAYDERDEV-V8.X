stock UpdateVehicleNumber(vehicleid, forplayerid = INVALID_VEHICLE_ID, bool:newdata = false)
{
	if(vehicleid < 1 || vehicleid > MAX_VEHICLES-1) return 0;
	if(IsAMoto(vehicleid) || IsABike(vehicleid) || IsANumber(vehicleid)) return 0;
	static number[10], region[5];
	number[0] = EOS, region[0] = EOS;
	sscanf(VehicleData[vehicleid][vNumber_String], "s[10]s[5]", number, region);

	for(new i; i < 10; i++)
	{
		number[i] = toupper(number[i]);
		if(i < 5) region[i] = toupper(region[i]);
	}
	
	new style = VehicleData[vehicleid][vNumber_Type];
	if(IsValidNumber(number, region, style) <= 0)
	{
		SetString(number, "");
		SetString(region, "");
		style = 0;
		if(newdata != false) return 0;
	}
	switch(style)
	{
		case 1,2,4,6,7:
		{

		}
		case 3,5:
		{
			//SetString(region, "");
		}
		default:
		{
			SetString(number, "");
			SetString(region, "");
			VehicleData[vehicleid][vNumber_Type] = 0;
			style = 0;
		}
	}
	new
        BitStream:bsn = BS_New();
	//0 256
	BS_WriteValue(bsn, \
					PR_UINT8, 215,
					PR_UINT16, 32,
					PR_UINT32, vehicleid,
					PR_UINT32, 0,
					PR_UINT16, 256,
					PR_UINT32, style,
					PR_STRING32, number,
					PR_STRING32, region);
	if(forplayerid == INVALID_PLAYER_ID) 
	{
		foreach(new i: VehiclePlayersStream[vehicleid]) 
		{
			PR_SendPacket(bsn, i);
		}
	}
	else PR_SendPacket(bsn, forplayerid);
    BS_Delete(bsn);
	return 1;
}
CMD:vec(playerid, get[])
{
	//if(CheckAdmin(playerid, 4)) return 1;
	extract get -> new player:to_player = -1, model_id = 462, color_1 = 1, color_2 = 1;
	SCM(playerid, 0xCECECEFF, !"Используйте: /vec [to_player] [model_id] [color_1] [color_2]");
	if(IsValidCarModel(model_id) == -1) return SCM(playerid, -1, !"Машина с такой моделью не добавлена на сервер!");
	if(!PI[playerid][pAdmin] && to_player != playerid) return 0;
	if(to_player == -1) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	cmd_vec(to_player, model_id, color_1, color_2);

	SendAdminsMessagef(0x999999FF, "[A] %s[%i] выдал транспорт игроку %s[%i], model_id: %i", PN(playerid), playerid, PN(to_player), to_player, model_id);
	return 1;
}
alias:vec("veh", "plveh")
stock cmd_vec(to_player, model_id, color_1, color_2)
{
	static Float:Position[4];
	GetPlayerPos(to_player, Position[0], Position[1], Position[2]);
	GetPlayerFacingAngle(to_player, Position[3]);
	
	player_TempVehicleID[to_player] = CreateVehicle(model_id, Position[0], Position[1], Position[2], Position[3], color_1, color_2, -1, 0);
	g_vehicle_params[player_TempVehicleID[to_player]][V_LOCK] = 0;
	VehicleData[player_TempVehicleID[to_player]][V_PLAYERID] = to_player;
	SetVehicleNumber(player_TempVehicleID[to_player], 5, ""NAME_PROJECT"", "");
}
CMD:setvehnumber(playerid, get[]){
	extract get -> new type, string:num[10], string:reg[5]; else return SCM(playerid, -1, "/setvehnumber [type] [num] [reg]");
	SetVehicleNumber(GetPlayerVehicleID(playerid), type, num, reg);
	SCM(playerid, -1, "Готово");
	return 1;
}
stock SetVehicleNumber(vehicleid, type, const number[], const region[])
{
	if(IsAMoto(vehicleid) || IsABike(vehicleid) || IsANumber(vehicleid)) return 0;
	VehicleData[vehicleid][vNumber_Type] = type;
	f(VehicleData[vehicleid][vNumber_String], 15, "%s %s", number, region);
	UpdateVehicleNumber(vehicleid, INVALID_PLAYER_ID);
	return 1;
}
