stock SetPlayerPosEx(playerid, Float: x, Float: y, Float: z, Float: angle, interior = -1, virtual_world = -1, bool:freeze = true, bool:camera = false)
{
	if(gangCapture_HackerID == playerid) player_HackMenu_Hide(playerid);
	SetPlayerPos(playerid, x, y, z);

	SetPlayerFacingAngle(playerid, angle);
	if(!camera) SetCameraBehindPlayer(playerid);

	if(interior != -1 && GetPlayerInterior(playerid) != interior)
	{
		SetPlayerInterior(playerid, interior);
	}
	if(virtual_world != -1 && GetPlayerVirtualWorld(playerid) != virtual_world)
	{
		SetPlayerVirtualWorld(playerid, virtual_world);
	}
	if(GetPlayerData(playerid, pLast_Pickup_ID) != -1)
	{
		SetPlayerData(playerid, pLast_Pickup_ID, -1);
	}
	if(freeze)
	{
		TogglePlayerControllable(playerid, false);
		SetTimerEx("player_UnFreeze", 2000, false, "i", playerid);
	}
	player_CasinoRoulClose(playerid);
	//Streamer_Update(playerid);
	return 1;
}
stock JailPlayer(playerid, jail_time, bool:type)
{
	SetPlayerSuspectLevel(playerid, -100);

	PI[playerid][pJail_Arrest] = type;
	UpdatePlayerDataInt(playerid, "Jail_Arrest", type);

	SetPlayerData(playerid, pJailTime, jail_time);
	UpdatePlayerDataInt(playerid, "JailTime", jail_time);

	player_Spawn(playerid);
}

stock UnjailPlayer(playerid)
{
	SetPlayerPosEx
	(
		playerid,
  		223.9667,1408.2072,12.1993,260.0,
		0, 0
	);
	SetPlayerSuspectLevel(playerid, -100);
	PI[playerid][pJailTime] = 0;
	UpdatePlayerDataInt(playerid, "JailTime", 0);
}

stock UpdatePlayerDataInt(playerid, field[], value)
{
	if(!IsPlayerLogged(playerid)) return 0;
	mysql_pqueryf(mysql, "UPDATE `players` SET `%s` = '%i' WHERE `ID`= '%i' LIMIT 1;", field, value, GetPlayerAccountID(playerid));
	return 1;
}

stock UpdatePlayerDataFloat(playerid, field[], Float:value)
{
	if(!IsPlayerLogged(playerid)) return 0;
	mysql_pqueryf(mysql, "UPDATE `players` SET `%s`= '%f' WHERE `ID`='%i' LIMIT 1;", field, value, GetPlayerAccountID(playerid));
	return 1;
}

stock UpdatePlayerDataStr(playerid, field[], value[])
{
	if(!IsPlayerLogged(playerid)) return 0;
	mysql_pqueryf(mysql, "UPDATE `players` SET `%s`= '%s' WHERE `ID`='%i' LIMIT 1", field, value, GetPlayerAccountID(playerid));
	return 1;
}
