			player_SPanelTuning_Click(playerid, 6);
			if(player_Casino_Type{playerid} == 1)
			{
				ExecutePacket(playerid, webUpdate, "stopSound(1)");
				player_CasinoRoulClose(playerid);
			}
		}
		case 87: 
		{
			if(player_Casino_Type{playerid} == 1)
			{
				new uid = player_Casino_Position{playerid};
				if(uid != 255)
				{
					if(!GetString(CasinoRoll_ChipsDostup[uid][crk_W], "-1"))
					{
						player_Casino_SetChipPos(playerid, CasinoRoll_ChipsDostup[uid][crk_W]);
					}
				}
			}
		}
		case 65:
		{
			if(player_Casino_Type{playerid} == 1)
			{
				new uid = player_Casino_Position{playerid};
				if(uid != 255)
				{
					if(!GetString(CasinoRoll_ChipsDostup[uid][crk_A], "-1"))
					{
						player_Casino_SetChipPos(playerid, CasinoRoll_ChipsDostup[uid][crk_A]);
					}
				}
			}
		}
		case 83:
		{
			if(player_Casino_Type{playerid} == 1)
			{
				new uid = player_Casino_Position{playerid};
				if(uid != 255)
				{
					if(!GetString(CasinoRoll_ChipsDostup[uid][crk_S], "-1"))
					{
						player_Casino_SetChipPos(playerid, CasinoRoll_ChipsDostup[uid][crk_S]);
					}
				}
			}
		}
		case 68:
		{
			if(player_Casino_Type{playerid} == 1)
			{
				new uid = player_Casino_Position{playerid};
				if(uid != 255)
				{
					if(!GetString(CasinoRoll_ChipsDostup[uid][crk_D], "-1"))
					{
						player_Casino_SetChipPos(playerid, CasinoRoll_ChipsDostup[uid][crk_D]);
					}
				}
			}
		}
		case 77:
		{
			if(!IsPlayerLogged(playerid) || OpenInterface[playerid][22]) return 1;
			mainmenu(playerid);
		}
		case 69: //e
		{
			if(OpenInterface[playerid][23] != false && player_DeathTimeOut[playerid] > 1) player_DeathMenu_Close(playerid);
		}
		case 32: //пробел
		{
			player_CursorRecon(playerid);
			if(OpenInterface[playerid][23] && player_DeathTimeOut[playerid] > 1)
			{
				if(CompareInt64(playerid, "<", 5000000)) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
				//if(player_Cash[playerid] < 5000000) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
				GivePlayerMoneyEx(playerid, -5000000, "Поднялся за бабки");
				OpenInterface[playerid][23] = false;
				PI[playerid][pHospital] = false;
				UpdatePlayerDataInt(playerid, "Hospital", PI[playerid][pHospital]);
				player_DeathTimeOut[playerid] = 0;
				SetPlayerHealthEx(playerid, 40.0);
				SetPlayerPos(playerid, player_DeathPos[playerid][0], player_DeathPos[playerid][1], player_DeathPos[playerid][2]);
				ExecutePacket(playerid, webClose, "Death");
				for(new i; i < 4; i++)
				{
					player_DeathPos[playerid][i] = 0.0;
				}
				ClearPlayerAnim(playerid);
				SetCameraBehindPlayer(playerid);
				TogglePlayerControllable(playerid, true);
			}
		}
		case 18: //alt
		{
			player_ClientSideALT(playerid);
		}
	}
	return 1;
}
stock player_ClientSideALT(playerid)
{
	if(OpenInterface[playerid][128] && GetPlayerCameraMode(playerid) == 3) 
	{
		GetPlayerCameraPos(playerid, player_ChangeWheel_CamPos[playerid][0], player_ChangeWheel_CamPos[playerid][1], player_ChangeWheel_CamPos[playerid][2]);
		GetPlayerCameraFrontVector(playerid, player_ChangeWheel_CamLook[playerid][0], player_ChangeWheel_CamLook[playerid][1], player_ChangeWheel_CamLook[playerid][2]);
		player_ChangeWheel_CamLook[playerid][0] = player_ChangeWheel_CamPos[playerid][0] + floatmul(player_ChangeWheel_CamLook[playerid][0], 5.0);
		player_ChangeWheel_CamLook[playerid][1] = player_ChangeWheel_CamPos[playerid][1] + floatmul(player_ChangeWheel_CamLook[playerid][1], 5.0);
		player_ChangeWheel_CamLook[playerid][2] = player_ChangeWheel_CamPos[playerid][2] + floatmul(player_ChangeWheel_CamLook[playerid][2], 5.0);
		//GetPlayerCameraFrontVector(playerid, player_ChangeWheel_CamLook[playerid][0], player_ChangeWheel_CamLook[playerid][1], player_ChangeWheel_CamLook[playerid][2]);
		player_GetSpawnInfo(playerid, true);
		TogglePlayerSpectating(playerid, false);
		player_ChangeWheel_Camera(playerid);
	}
	if(player_Detailing{playerid} != 255) 
	{
		player_SetCursorStatus(playerid, !player_CursorData{playerid});
	}
	else if(player_EatTrash{playerid} != false) 
	{
		player_SetCursorStatus(playerid, !player_CursorData{playerid});
	}
	else if(OpenInterface[playerid][6] != false) // если уже открыт
	{
		player_SetCursorStatus(playerid, !player_CursorData{playerid});
	}
	new id = player_EnterTrash[playerid];
	if(Iter_Contains(TrashData, id))
	{
		str_1[0] = EOS, f(str_1, sizeof(str_1), "\
			{FFFFFF}Вы хотите подобрать предмет \'{FFCD00}%s{FFFFFF}\' в количестве {FFCD00}%i шт?", ItemsData[InventoryTrash[0][id]][ItemName], InventoryTrash[1][id]);
		SPD(playerid, 23245, 0, "{FFCD00}Подобрать предмет", str_1, "Да", "Нет");
	}
	else if(Iter_Contains(Eat_TrashData, player_Enter_EatTrash[playerid]))
	{
		player_PickEat(playerid);
	}
	else if(player_MedBed_Enter{playerid} != false)
	{
		callcmd::med(playerid);
	}
	else if(player_GarageExited{playerid} != false)
	{
		id = player_GarageEntered[playerid];
		if(id != -1)
		{
			SetPlayerPosEx(playerid, GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2], GarageData[id][gEnter][3], 0, 0, false);
			player_GarageEntered[playerid] = -1;
		}
	}
	else if(player_HouseExited{playerid} != false)
	{
		id = player_HouseEntered[playerid];
		if(id != -1)
		{
			callcmd::exit(playerid);
		}
	}
	else if(player_BizExited{playerid} != false)
	{
		//если стоит на выходе
		id = player_BizEntered[playerid];
		if(id != -1)
		{
			if(BizData[id][bType] == 16)
			{
				ExecutePacket(playerid, webUpdate, "stopSound(1)");
				ExecutePacket(playerid, webUpdate, "setCurrentVolume(1.00, 1)");
			}
			SetPlayerPosEx(playerid, BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], 0.0, 0, 0, false);
			player_BizEntered[playerid] = -1;
		}
	}
	else if(player_BizBuyed{playerid} != false)
	{
		id = player_BizEntered[playerid];
		if(id != -1) player_BusinessBuyed(playerid);
	}
	else if(player_BizHealthed{playerid} != false)
	{
		id = player_BizEntered[playerid];
		if(id != -1)
		{
			if(BizData[id][bLevel] < 1) SCM(playerid, COLOR_RED, !"У бизнеса нет данного улучшения!");
			else SPD(playerid, 20256, 0, "{FFCD00}Услуги медпункта", "\
					{FFFFFF}Услуги медпункта стоят {66CC00}10000 рублей\n\
					{FFFFFF}Вы хотите ими воспользоваться?", "Далее","Отмена");
		}
	}
	if(player_Canister{playerid} != false)
	{
		new vehicleid = GetNearestVehicleID(playerid, 5.0);
		if(vehicleid != INVALID_VEHICLE_ID)
		{
			SPD(playerid, 912, 0, "{6699FF}Канистра", "{FFFFFF}Вы хотите заправить этот транспорт с канистры?", "Да","Нет");
		}
	}
	if(player_EnterBiz[playerid] != -1)
	{
		//если стоит на входе
		PreEnterPlayerToBiz(playerid, player_EnterBiz[playerid]);
	}
	else if(player_Casino_Type{playerid} == 1)
	{
		if(player_TempObject[playerid] == -1)
		{
			id = player_Casino_ID{playerid};
			SetPlayerCameraPos(playerid, CasinoRoulette[id][prCamPos_Select][0], CasinoRoulette[id][prCamPos_Select][1], CasinoRoulette[id][prCamPos_Select][2]);
			SetPlayerCameraLookAt(playerid, CasinoRoulette[id][prCamLookAt_Select][0], CasinoRoulette[id][prCamLookAt_Select][1], CasinoRoulette[id][prCamLookAt_Select][2], 1);
			ExecutePacket(playerid, webUpdate, (str_f("interface('CasinoRullet').setBalance(%i)", GetInvCount(playerid, 293))));
			SCM(playerid,-6750038, "Чтобы сделать ставку используйте клавиши {FFFFFF}W-A-S-D {FF9900}и {FFFFFF}ENTER{FF9900}.");
			player_Casino_SetChipPos(playerid, "17");
		}
	}
	if(player_PressInteraction[playerid] != -1) //CreateInteractionMenu
	{
		id = player_PressInteraction[playerid];
		new type = InteractionMenu_ActionType[id];
		switch(InteractionMenu_ActionID[id])
		{
			case interMenu_Gate, interMenu_Stall, interMenu_Wash, interMenu_CaseRandom, interMenu_GatePolice:
			{
				//то что скрывать при нажатии не нужно
			}
			default:
			{
				player_Interaction_Hide(playerid);
			}
		}
		switch(InteractionMenu_ActionID[id])
		{
			case interMenu_GatePolice:
			{
				police_GateStatus = !police_GateStatus;
				Action(playerid, "взаимодействует со шлагбаумом", 25.0, true, -577699841);
				PlayerPlaySound(playerid, 1138, 0.0, 0.0, 0.0);
				if(!police_GateStatus)
				{
					MoveDynamicObject(police_GateObject, 188.43255615234, 1405.0718994141, 11.066471099854, 1.0, 0.0, 0.0, -9.8568601608276);
				}
				else
				{
					MoveDynamicObject(police_GateObject, 179.03338623047, 1406.7036132813, 11.066471099854, 1.0, 0.0, 0.0, -9.8568601608276);
				}
			}
			case interMenu_CaseRandom:
			{
				SPD(playerid, 20458, DIALOG_STYLE_MSGBOX, "{99cc00}Секретный сундук", "{FFFFFF}Вы действительно хотите открыть этот сундук?", "Готово", "Отмена");
			}
			case interMenu_Entrance_List:
			{
				if(player_EntranceEntered[playerid] != -1)
				{
					str_1[0] = EOS;
					if(player_EntranceList[playerid] == -1) 
					{
						player_ShowUID[playerid][0] = 0;
						for(new i, count; i < 3; i++)
						{
							if(player_EntranceList[playerid] == i) continue;
							f(str_1, sizeof(str_1), "%s%i этаж\n", str_1, i+1);
							player_ShowUID[playerid][count] = i;
							count++;
						}
					}
					else
					{
						str_1 = "Подъезд\n";
						player_ShowUID[playerid][0] = -1;
						for(new i, count = 1; i < 3; i++)
						{
							if(player_EntranceList[playerid] == i) continue;
							f(str_1, sizeof(str_1), "%s%i этаж\n", str_1, i+1);
							player_ShowUID[playerid][count] = i;
							count++;
						}
					}
					SPD(playerid, 20451, 2, "{FFCD00}Выберите этаж", str_1, "Выбрать","Отмена");
				}
			}
			case interMenu_GangCapture:
			{
				player_GangCapture_Hack(playerid, type);
			}
			case interMenu_Wash:
			{
				//тут когда нажал на альт
				new number = GetVehicleID(GetPlayerVehicleID(playerid));
				if(number != INVALID_VEHICLE_ID)
				{
					UpdateCarData_Sync(number, true);
					if(CarData[number][cWash] < 5.0)
					{
						SCM(playerid,-825307478, "Мойка не требуется. У Вашего транспорта сейчас меньше 5.0 процентов загрязнения.");
						return 1;
					}
					new cost = addcars_SearchUID(CarData[number][cModel]);
					if(cost == -1) cost = 50000;
					else cost = AddCarsData[cost][acCost] / 100 * floatround(CarData[number][cWash]);
					new bizid = player_SearchBiz(playerid, 3);
					if(bizid != -1)
					{
						cost = cost*(BizData[bizid][bProductEx]/2);
					}
					if(cost > 1500000000 || cost < 1) cost = 1500000000;
					cost = cost/4;
					SPD(playerid, 20447, 0, "Автомойка", (str_f("\
						{FFFFFF}Вы хотите помыть свой транспорт?\n\
						Стоимость услуги на данной автомойке составляет: {FFBE5C} %i руб", cost)), "Далее","Отмена");
				}
			}
			case interMenu_Stall:
			{
				player_Stall_Open(playerid);
			}
			case interMenu_Gate:
			{
				for(new i, bool:count, bool:stop; i < sizeof(GateStaticData); i++)
				{
					if(GateStaticData[i][gtID] == type)
					{
						if(GateStaticData[i][gtMember] >= 0)
						{
							if(!GetString(HouseData[ GateStaticData[i][gtMember] ][hOwner], PN(playerid)))
							{
								new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
								if(idEx >= 0)
								{
									if(FamilyData[idEx][fGang_BaseID] == GateStaticData[i][gtMember])
									{

									}
									else return 1;
								}
								else return 1;
							}
						}
						PlayerPlaySound(playerid, 1138, 0.0, 0.0, 0.0);
						GateOpen[i] = !GateOpen[i];
						//StopDynamicObject(GateObject[i]);
						switch(GateStaticData[i][gtModel])
						{
							case 10898, 10919: //открытие внутрь на 90 градусов
							{
								new Float:rotZ;
								if(!count)
								{
									count = true;
									rotZ = (!GateOpen[i] ? GateStaticData[i][gtPos_rZ] : GateStaticData[i][gtPos_rZ]+90.0);
								}
								else
								{
									rotZ = (!GateOpen[i] ? GateStaticData[i][gtPos_rZ] : GateStaticData[i][gtPos_rZ]-90.0);
								}
								//SetDynamicObjectRot(GateObject[i], 0.000000, 0.000000, rotZ);
								
								new 
									Float:x = GateStaticData[i][gtPos_X], 
									Float:y = GateStaticData[i][gtPos_Y];
								if(GateOpen[i] != false)
								{
									x += 0.13232421875;
									y += 0.0456542968;
								}
								MoveDynamicObject(GateObject[i], x, y, GateStaticData[i][gtPos_Z], 0.050000000745058, 0.000000, 0.000000, rotZ);
							}
							case 16036, 10900, 15965, 14584:
							{
								new Float:rotZ;
								if(!count)
								{
									count = true;
									rotZ = (!GateOpen[i] ? GateStaticData[i][gtPos_rZ] : GateStaticData[i][gtPos_rZ]+270.0);
								}
								else
								{
									rotZ = (!GateOpen[i] ? GateStaticData[i][gtPos_rZ] : GateStaticData[i][gtPos_rZ]-270.0);
								}
								//SetDynamicObjectRot(GateObject[i], 0.000000, 0.000000, rotZ);
								
								new 
									Float:x = GateStaticData[i][gtPos_X], 
									Float:y = GateStaticData[i][gtPos_Y];
								if(GateOpen[i] != false)
								{
									x += 0.13232421875;
									y += 0.0456542968;
								}
								MoveDynamicObject(GateObject[i], x, y, GateStaticData[i][gtPos_Z], 0.050000000745058, 0.000000, 0.000000, rotZ);
							}
							case 16038, 16039, 16037, 16041, 16040: //открытие вниз
							{
								MoveDynamicObject(GateObject[i], GateStaticData[i][gtPos_X], GateStaticData[i][gtPos_Y], (!GateOpen[i] ? GateStaticData[i][gtPos_Z] : GateStaticData[i][gtPos_Z]-2.7), 0.5, 0.000000, 0.000000, GateStaticData[i][gtPos_rZ]);
								break;
							}
						}
						if(!stop) stop = true;
						else
						{
							return 1;
						}
					}
				}
			}
			case interMenu_PropertyStats:
			{
				switch(type)
				{
					case 0:
					{
						SPD(playerid, 20408, 2, "{99CC00}Информация о доме/гараже", "Список домов\nСписок гаражей<n>", "Далее","Отмена");
					}
					case 1:
					{
						SCM(playerid, -1, "Будет в ближайшем будущем!!");
					}
					case 2:
					{
						str_1[0] = EOS;
						for(new i; i < TOTAL_BUSINESSES; i++)
						{
							if(!GetString(BizData[i][bOwner], "The State")) continue;
							strcat(str_1, (str_f("%i\n", i)));
						}
						SPD(playerid, 0, 0, "{66FF99}Номера свободных бизнесов", str_1, "Закрыть");
					}
				}
			}
			case interMenu_ContPresent:
			{
				if(!GetString(cont_Owner[type], PN(playerid)))
				{
					SCM(playerid,-825307393, "Этот контейнер Вам не принадлежит.");
				}
				else
				{
					player_ContTakeUID[playerid] = type;
					if(cont_PresentType[type] == 7)
					{
						player_Container_TakeCar(playerid);
					}
					else
					{
						player_Container_Take(playerid);
					}
				}
			}
			case interMenu_ContAuction:
			{
				if(PI[playerid][pLevel] < 4)
				{
					return SCM(playerid, -825307393, !"* Для ставки необходимо иметь 4 уровень");
				}
				if(!(player_AntiFlood[playerid][19]-global_time > 0))
				{
					player_ContUID[playerid] = type;
					SPD(playerid, 20417, DIALOG_STYLE_MSGBOX, "{99cc00}Аукцион за контейнер", "{FFFFFF}Вы хотите войти в режим аукциона за этот контейнер?", "Готово", "Отмена");
				}
				else 
				{
					SCMf(playerid, COLOR_RED, "У вас имеется ограничение на участие в аукционе. До снятия осталось %i сек", player_AntiFlood[playerid][19]-global_time);
				}
			}
			case interMenu_FractionWareHouse:
			{
				player_pickupWareHouse(playerid);
			}
			case interMenu_Paintball:
			{
				player_Paintball_Open(playerid);
			}
			case interMenu_BizAccessories:
			{
				player_Accessories_Open(playerid, type);
			}
			case interMenu_LiftHospital:
			{
				if(type == 2)
				{
					SetPlayerPos(playerid, 440.10549926758, 1705.2197265625, 1001);
					SetPlayerFacingAngle(playerid, 90.0);
				}
				else
				{
					SetPlayerPos(playerid, 439.70669555664, 1732.822265625, 1301);
					SetPlayerFacingAngle(playerid, 90.0);
				}
				TogglePlayerControllable(playerid, true);
			}
			case interMenu_BuyNumber:
			{
				cmd_cars(playerid, 20384);
			}
			case interMenu_Sawmill:
			{
				if(player_DefaultJob_ID[playerid] == 1)
				{
					player_Sawmill_Point(playerid, type);
				}
			}
			case interMenu_Mayor:
			{
				SPD(playerid, 0, DIALOG_STYLE_LIST, "Выберите действие", "\
							- Подать заявление на трудоустройство\n\
							- Просмотреть поданное заявление", "Выбрать","Закрыть");
			}
			case interMenu_CreateFamily:
			{
				if(PI[playerid][pLevel] < 3) return SCM(playerid, -825307393, !"* Необходимо иметь 3 уровень");
				if(GetFamilyID(PI[playerid][pFamily_ID]) >= 0) return SCM(playerid, -825307393, !"Вы уже состоите в семье");
				SPD(playerid, 20318, DIALOG_STYLE_INPUT,
					"Создание семьи",
					"{808080}- Цена: 15000000 руб.\n\
					- Только русские или английские символы\n\
					- Используйте от 6 до 36 символов\n\n\
					{FFFFFF}Введите название Вашей семьи:",
					"Создать", "Отмена");
			}
			case interMenu_CreateGang:
			{
				//gang_create
				player_GangCreate_Open(playerid);
				player_ShowData[playerid][299] = type;
			}
			case interMenu_MafiaHouse:
			{
				SPD(playerid, 0, DIALOG_STYLE_LIST, "Список банд", "\
					1. Топ по null особняк\n\
					2. Общий топ<n>", "Далее","Отмена");
			}
			case interMenu_CasinoExchange:
			{
				//
				player_CasinoExchange_Open(playerid);
			}
			case interMenu_CasinoRoulette:
			{
				if(player_Casino_Type{playerid} != 1)
				{
					player_Casino_Type{playerid} = 1;
					player_Casino_ID{playerid} = type;
					SPD(playerid, 20340, 0, "{FFCD00}Рулетка", "{FFFFFF}Хотите присоединиться к игре?", "Да","Нет");
				}
			}
			case interMenu_CasinoAuto:
			{
				SPD(playerid, 0, 0, "Подтверждение", "{FFFFFF}Вы действительно хотите начать игру в игровые автоматы?", "Начать","Отмена");
			}
			case interMenu_CasinoDice:
			{
				cmd_dice(playerid, type);
			}
			case interMenu_DriftFix:
			{
				SPD(playerid, 20343, 0, "{FFCD00}Починка", "{FFFFFF}Хотите мы починим ваш транспорт за {FF9900}2024 {FFFFFF}руб?", "Да","Нет");
			}
		}
	}
	if(PI[playerid][pTemp_AnimUsed] != false)
	{
		player_Interaction_Hide(playerid);
		PI[playerid][pTemp_AnimUsed] = false;
		ClearPlayerAnim(playerid);
		ClearAnimations(playerid);
		SetPlayerData(playerid, pTemp_AnimType, USE_ANIM_TYPE_NONE);
	}
	return true;
}
stock player_FuelMenu_Open(playerid)
{
	//if(OpenInterface[playerid][4]) return 1;
	ExecutePacket(playerid, webClose, "Fuel");
	OpenInterface[playerid][4] = true;
	new carid = GetPlayerVehicleID(playerid),
		model = IsValidCarModel(VehicleData[carid][V_MODELID]);
	if(model != -1)
	{
		new bizid = player_EnterBiz[playerid];
		if(bizid != -1)
		{
			player_ShowData[playerid][77] = (VehicleStaticData[model][vsType] == 2 ? 2 : -1);
			ExecutePacket(playerid, webOpen, "Fuel",\
				(str_f("[%i,%i,%i,%i]", (VehicleStaticData[model][vsType] == 2 ? 1 : 0), floatround(VehicleData[carid][V_FUEL]), VehicleStaticData[model][vsMaxFuel],\
					global_GetShopPrice(fuelTypeName[5])*BizData[bizid][bProductEx])));
		}
	}
	//printf("fuel [%s]", str_format);
	return 1;
}
stock player_SelectFuelClass(playerid, select)
{
	if(!OpenInterface[playerid][4]) return 0;
	new carid = GetPlayerVehicleID(playerid);
	if(carid > 0)
	{
		new bizid = player_EnterBiz[playerid];
		if(bizid != -1)
		{
			new model = IsValidCarModel(VehicleData[carid][V_MODELID]);
			if(model != -1)
			{
				new uid = addcars_SearchUID(VehicleData[carid][V_MODELID]);
				select++;
				player_ShowData[playerid][77] = select;
				if(uid < 0) 
				{
					if(VehicleStaticData[model][vsType] != player_ShowData[playerid][77])
					{
						SCM(playerid, 0xCECECEFF, !"Выбранный тип топлива не подходит к Вашему ТС.");
					}
				}
				else if(AddCarsData[uid][acF_Type] != player_ShowData[playerid][77])
				{
					SCM(playerid, 0xCECECEFF, !"Выбранный тип топлива не подходит к Вашему ТС.");
				}
				ExecutePacket(playerid, webUpdate, (str_f("interface('Fuel').setFillInfo([%i,%i,%i,%i])", \
					(VehicleStaticData[model][vsType] == 2 ? 1 : 0), floatround(VehicleData[carid][V_FUEL]), \
					VehicleStaticData[model][vsMaxFuel], \
					global_GetShopPrice(fuelTypeName[ select ])*BizData[bizid][bProductEx])));
			}
		}
	}
	return 1;
}
stock player_FuelMenu_Close(playerid)
{
	if(!OpenInterface[playerid][4]) return 0;
	OpenInterface[playerid][4] = false;
	ExecutePacket(playerid, webClose, "Fuel");
	return 1;
}
stock player_FuelMenu_Start(playerid, count)
{
	if(count == 91234561)
	{
		/*new i;
		do
		{

		}
		while(i < 10); */
	}
	if(!OpenInterface[playerid][4]) return 0;
	new carid = GetPlayerVehicleID(playerid);
	if(carid > 0)
	{
		new model = IsValidCarModel(VehicleData[carid][V_MODELID]);
		if(model != -1)
		{
			new uid = addcars_SearchUID(VehicleData[carid][V_MODELID]);
			//SCMf(playerid, -1, "1 -> %i %i", VehicleStaticData[model][vsType], player_ShowData[playerid][77]);
			//SCMf(playerid, -1, "2 -> %i %i", AddCarsData[uid][acF_Type], player_ShowData[playerid][77]);
			if(uid < 0) 
			{
				if(VehicleStaticData[model][vsType] != player_ShowData[playerid][77]) return player_FuelMenu_Close(playerid);
			}
			else if(AddCarsData[uid][acF_Type] != player_ShowData[playerid][77]) return player_FuelMenu_Close(playerid); //triazov

			new bizid = player_EnterBiz[playerid];
			if(bizid != -1)
			{
				SCM(playerid,-4301654, "Заправка начата, ожидайте окончания.");
				new Fuel = count-floatround(VehicleData[carid][V_FUEL]);
				if(Fuel > 0)
				{
					if(VehicleStaticData[model][vsMaxFuel]-2 >= floatround(VehicleData[carid][V_FUEL]))
					{
						new type = player_ShowData[playerid][77],
							price = Fuel*(global_GetShopPrice(fuelTypeName[type])*BizData[bizid][bProductEx]);
						if(VehicleStaticData[model][vsType] == 2)
						{
							price = Fuel*(global_GetShopPrice(fuelTypeName[5])*BizData[bizid][bProductEx]);
						}
						//if(player_Cash[playerid] < price)
						if(CompareInt64(playerid, "<", price))
						{
							SCM(playerid, 0xCECECEFF, !"У Вас недостаточно средств для оплаты.");
							player_FuelMenu_Close(playerid);
							return 1;
						}
						ExecutePacket(playerid, webUpdate, "interface('Fuel').stopFilling()");
						GiveBusinessMoney(playerid, bizid, price*3, 0);
						GivePlayerMoneyEx(playerid, -price, (str_f("Заправился на АЗС №%i", bizid)), true, false);
						GameTextForPlayerEx(playerid, (str_f("~b~+%i л~n~~r~-%i руб", Fuel, price)), 4000, 2);
						VehicleData[carid][V_FUEL] = count;
						UpdateCarData_Sync(GetVehicleID(carid), true);
						SetVehicleParam(carid, V_ENGINE, false);
						return 1;
					}
					else SCM(playerid, 0xCECECEFF, "Бак полон");
				}
				else SCM(playerid, 0xCECECEFF, "Нельзя заправить 0 литров");
			}
		}
	}
	player_FuelMenu_Close(playerid);
	return 1;
}
stock player_HideSpeed(playerid)
{
	ExecutePacket(playerid, webUpdate, "interface('Hud').hideSpeedometer()");
	return 1;
}
stock player_UpdateSpeed(playerid)
{
	//printf("player_UpdateSpeed(%i)", playerid);
	if(playerid == INVALID_PLAYER_ID || playerid == -1) return 0;
	if(GetPlayerState(playerid) == 2)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid > 0)
		{
			new 
				IsKey = 1,
				number = GetVehicleID(vehicleid);
			
			if(number != INVALID_VEHICLE_ID) IsKey = CarData[number][cKeyIN];
			ExecutePacket(playerid, webUpdate, \
				(str_f("interface('Hud').updateSpeedometer([\
					%i,%i,%i,%i,%.2f,%.2f,150.0,%i,0,%.2f])",\
					g_vehicle_params[vehicleid][V_LIGHTS], g_vehicle_params[vehicleid][V_ENGINE], Helmet[playerid],\
					g_vehicle_params[vehicleid][V_LOCK], VehicleData[vehicleid][V_MILEAGE], VehicleData[vehicleid][V_FUEL],\
					IsKey, VehicleData[vehicleid][vWash])));
		}
	}
	return 1;
}
stock player_ShowSpeed(playerid, vehicleid)
{
	if(vehicleid < 1) return 0;
	new Float:max_speed = 400.0,
		uid = vehicle_SearchHandling(vehicleid);
	if(uid >= 0) 
	{
		max_speed = (Handling_StaticData[uid][E_MAXGEAR_VELOCITY] + Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY]);
		if(max_speed > 600.0) max_speed = 600.0;
	}
	new model = IsValidCarModel(VehicleData[vehicleid][V_MODELID]);
	if(model != -1)
	{
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "interface('Hud').showSpeedometer(1,%1.f,%i)", max_speed, (VehicleStaticData[model][vsType] == 2 ? 1 : 0));
		ExecutePacket(playerid, webUpdate, str_mes);
		player_UpdateSpeed(playerid);
	}
	return 1;
}
CMD:gotohouse(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /gotohouse [id]");
	if(id < 0 || id > TOTAL_HOUSES-1) return 0;
	SetPlayerPos(playerid, HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2]);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SCMf(playerid, -1, "Вы телепортировались к дому ID: %i", id);
	return 1;
}
CMD:gotobiz(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /gotobiz [id]");
	if(id < 0 || id > TOTAL_BUSINESSES-1) return 0;
	SetPlayerPos(playerid, BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2]);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SCMf(playerid, -1, "Вы телепортировались к бизу ID: %i", id);
	return 1;
}
CMD:gotogarage(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /gotogarage [id]");
	if(id < 0 || id > TOTAL_GARAGES-1) return 0;
	SetPlayerPos(playerid, GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2]);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, 0);
	SCMf(playerid, -1, "Вы телепортировались к гаражу ID: %i", id);
	return 1;
}
CMD:gotoveh(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /gotoveh [id]");
	if(!Iter_Contains(Vehicles, id)) return 1;

	static Float:Pos[3];
	GetVehiclePos(id, Pos[0], Pos[1], Pos[2]);
	SetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
	new vv = GetVehicleVirtualWorld(id);
	SetPlayerInterior(playerid, 0);
	SetPlayerVirtualWorld(playerid, vv);
	SCMf(playerid, -1, "Вы телепортировались к машине ID: %i (vv: %i)", id, vv);
	return 1;
}
alias:gotoveh("gotocar", "vtp")
CMD:getherecar(playerid, get[])
{
    extract get -> new id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /getherecar [id]");
	if(!Iter_Contains(Vehicles, id)) return 1;

	static Float:Pos[3];
	GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);

	SetVehiclePos(id, Pos[0]+3, Pos[1]+3, Pos[2]);
	SetVehicleVirtualWorld(id, GetPlayerVirtualWorld(playerid));
	LinkVehicleToInterior(id, GetPlayerInterior(playerid));

    SCMf(playerid, -1, "Вы телепортировали к себе авто [ id: %i ]", id);
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] Телепортировал к себе авто. №%i", PN(playerid), playerid, id);
	return 1;
}
alias:getherecar("vget")
stock TextFind(const text[], const findtext[]) return (strfind(text, findtext, false) != -1);
cmd:diagnostics(playerid)
{
	new vehicleid = GetNearestVehicleID(playerid, 6.0),
		number = GetVehicleID(vehicleid);

	if(vehicleid == -1 || number == INVALID_VEHICLE_ID) return GameTextForPlayerEx(playerid, "Рядом с вами~n~~r~нет личного транспорта", 4000, 3);
	if(!g_vehicle_params[vehicleid][V_BONNET]) return GameTextForPlayerEx(playerid, "Капот автомобиля~n~~r~должен быть открыт", 4000, 3);

	static Float:POS[5];
    GetCoordVehicle(vehicleid, VEHICLE_COORD_TYPE_BOOT, POS[0], POS[1], POS[2], POS[3], POS[4]);
	if(!IsPlayerInRangeOfPoint(playerid, 4.0, POS[0], POS[1], POS[2])) return SCM(playerid, 0xCECECEFF, "* Вы должны находится около капота");

	if(GetInvCount(playerid, 254) < 1) return SCM(playerid, 0xCECECEFF, "У вас нет набора для диагностики. Он есть в магазине 24/7");

	new uid = IsValidCarModel(VehicleData[vehicleid][V_MODELID]);

	ExecutePacket(playerid, webOpen, "Diagnostics", (str_f("\
			[\"%s\", \"\", \"Неопределенный\", %i, \"%s\", %i, \"%s\", 3]", \
			VehicleStaticData[uid][vsName], \
			30000, \
			CarData[number][cOwner], GetVehicleData(vehicleid, V_MILEAGE), VehicleStaticData[uid][vsName])));

	InvRemoveEx(playerid, 254, 1, -1, -1, "", "use item 254");
	SCM(playerid, 0xCECECEFF, !"Вы начали диагностику автомобиля. С вас было снято 1 использование набора");

	return 1;
}
CMD:re(playerid, get[])
{
	extract get -> new player:id; else return SCM(playerid, 0xCECECEFF, "Используйте: /sp [id игрока]");
	if(!Iter_Contains(Player, id) || !IsPlayerLogged(id)) return SCM(playerid, 0x999999FF, !"Такого игрока нет");
	if(PI[id][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, "Нельзя взаимодействовать с администратором выше по рангу");
	if(!OpenInterface[playerid][6]) // если уже открыт
	{
		SCM(playerid, 0xc7dae8FF, !"Используйте команду \"/spinfo\" если вам понадобится информация об управлении.");
		TogglePlayerSpectating(playerid, true);
		ExecutePacket(playerid, webUpdate, "interface('Hud').hideInfo()");
		OpenInterface[playerid][6] = true;
		ExecutePacket(playerid, webUpdate, "openInterface('AdminSpectate')");
		GetPlayerPos(playerid, player_SpectateData[playerid][sdPosition][0], player_SpectateData[playerid][sdPosition][1], player_SpectateData[playerid][sdPosition][2]);
		GetPlayerFacingAngle(playerid, player_SpectateData[playerid][sdPosition][3]);
		player_SpectateData[playerid][sdInterior] = GetPlayerInterior(playerid);
		player_SpectateData[playerid][sdVirtualWorld] = GetPlayerVirtualWorld(playerid);
		player_SpectateData[playerid][sdMemberID] = PI[playerid][pMember_ID];
	}
	player_EnterRecon(playerid, id);
	return 1;
}
alias:re("spec", "sp")

//
CMD:reoff(playerid)
{
	player_ExitRecon(playerid);
	//SCM(playerid, 0xc7dae8FF, "Вы покинули режим");
	return 1;
}
alias:reoff("specoff", "spoff")
stock player_EnterRecon(playerid, id)
{
	if(!OpenInterface[playerid][6]) return 0;
	if(!Iter_Contains(Player, id) || !IsPlayerLogged(id)) return SCM(playerid, 0x999999FF, !"Такого игрока нет");
	if(PI[id][pAdmin] > PI[playerid][pAdmin]) return SCM(playerid, 0xCECECEFF, "Нельзя взаимодействовать с администратором выше по рангу");
	player_SpectateData[playerid][sdPlayerID] = id;
	//PI[playerid][pMember_ID] = PI[id][pMember_ID];

	player_CursorRecon(playerid);
	player_UpdateRecon(playerid);
	return 1;
}
stock player_CursorRecon(playerid)
{
	if(!OpenInterface[playerid][6]) return 0;
	new id = player_SpectateData[playerid][sdPlayerID];
	if(id != -1)
	{
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(id));
		SetPlayerInterior(playerid, GetPlayerInterior(id));
		player_SetCursorStatus(playerid, true);
		if(IsPlayerInAnyVehicle(id)) PlayerSpectateVehicle(playerid, GetPlayerVehicleID(id));
		else PlayerSpectatePlayer(playerid, id);
	}
	return 1;
}
stock player_ExitRecon(playerid)
{
	if(!OpenInterface[playerid][6]) return 0;
	ExecutePacket(playerid, webUpdate, "closeInterface('AdminSpectate')");
	ExecutePacket(playerid, webUpdate, "interface('Hud').openInfo()");
	player_SetCursorStatus(playerid, false);
	//ExecutePacket(playerid, webUpdate, "interface('Hud').showTime()");
	OpenInterface[playerid][6] = false;
	player_Spawn(playerid);
	//player_SpectateData[playerid][sdPlayerID] = -1;
	//SetPlayerPosEx(playerid, player_SpectateData[playerid][sdPosition][0], player_SpectateData[playerid][sdPosition][1], player_SpectateData[playerid][sdPosition][2], player_SpectateData[playerid][sdPosition][3], player_SpectateData[playerid][sdInterior], player_SpectateData[playerid][sdVirtualWorld], false);
	return 1;
}
stock player_UpdateRecon(playerid)
{
	if(PI[playerid][pAdmin] < 1 || player_SpectateData[playerid][sdPlayerID] == -1) return 0;
	new id = player_SpectateData[playerid][sdPlayerID];
	if(!IsPlayerLogged(id))
	{
		//игрок отключился
		SCMf(playerid, 0xc7dae8FF, "Игрок {FFFFFF}%s {c7dae8}за которым вы наблюдали покинул игру.", PN(id));
		player_ExitRecon(playerid);
		return 1;
	}
	//get date
	new day, month, year;
	getdate(year, month, day);
	
	//get hp
	new Float:hp;
	GetPlayerHealth(id, hp);

	//get armour
	new Float:armour;
	GetPlayerHealth(id, armour);

	//get rank

	new family_id = GetFamilyID(PI[id][pFamily_ID]),
		weapon_id = GetPlayerWeapon(id),
		vehicle_id = GetPlayerVehicleID(id),
		Float:hp_vehicle,
		speed = GetPlayerSpeed(id);
	if(vehicle_id > 0) 
	{
		GetVehicleHealth(vehicle_id, hp_vehicle);
		speed = GetVehicleSpeed(vehicle_id);
	}
	if(family_id >= 0) f(str_1, sizeof(str_1), "%s", FamilyData[family_id][fName]);
	else str_1 = "Отсутствует";
	ExecutePacket(playerid, webUpdate, (str_f("\
		interface('AdminSpectate').setInfo('[\
			\"%02i.%02i.%i %02i:%02i:%02i\", [%i, \"%s\", %i, %i, %i, %i, %i, %.1f, \"%s\", \"%s\", \"%s\", \
			 \"%i\", \"%s\", [%i, %i, %i], %i, %i, %i, %i, 0, 0]]')",\
				day, month, year, global_hour, global_minute, global_second, id, PN(id), PI[id][pLevel], PI[id][pLevel_RP],\
				floatround(hp), PI[id][pWarn], GetPlayerPing(id), NetStats_PacketLossPercent(id),\
				FractionStaticData[PI[id][pMember_ID]][frName], FractionRName[PI[id][pMember_ID]][PI[id][pMember_Rang]], str_1,\
				floatround(armour), (weapon_id == 0 ? "Отсутствует" : weapon_names[weapon_id]),\
				PI[id][pLevel_Skill][2], PI[id][pLevel_Skill][9], PI[id][pLevel_Skill][8],\
				floatround(hp_vehicle), speed, (vehicle_id > 0 ? g_vehicle_params[vehicle_id][V_ENGINE] : 0),\
				PI[id][pTemp_Mask])));
	//printf(str_format);
	return 1;
}
CMD:stats(playerid) player_ShowStats(playerid, playerid);
stock player_ShowStats(id, playerid)
{
	str_2[0] = EOS;
	if(PI[playerid][pSpawn_Type] == 1) f(str_2, sizeof(str_2), "Дом №%i", PI[playerid][pSpawn_UID]);
	else if(PI[playerid][pSpawn_Type] == 6) f(str_2, sizeof(str_2), "Гараж №%i", PI[playerid][pSpawn_UID]);
	else strcat(str_2, "Бездомный");
	SetString(player_ShowData[id], PN(playerid), 24);
	player_ShowID[id][55] = PI[playerid][pID];
	str_1[0] = EOS, player_GetStatusUpdate(playerid);
	SPD(id, 20353, 0, "Статистика игрока", (str_f("\
		{FFFFFF}Имя:\t\t\t\t{0099FF}%s\n\
		{FFFFFF}Уровень:\t\t\t%i\n\
		Очки опыта:\t\t\t%i из %i\n\
		Уровень RolePlay:\t\t\t%i\n\
		Номер телефона:\t\t%i\n\
		На счету телефона:\t\t%i руб\n\
		Законопослушность:\t\t%i\n\
		Уровень розыска:\t\t%i\n\
		Уровень улучшений:\t\t%i\n\
		Сила:\t\t\t\t%i\n\
		Выносливость:\t\t\t0\n\
		Наркотики:\t\t\t%i\n\
		Патроны:\t\t\t%i\n\
		Металл:\t\t\t%i\n\
		Пол:\t\t\t\t%s\n\
		%s:\t\t\t%s\n\
		Военный билет:\t\t\t%s\n\
		\n\
		Организация:\t\t\t%s\n\
		Работа / должность:\t\t%s\n\
		Ранг:\t\t\t\t%i\n\
		\n\
		Наколка:\t\t\t%s\n\
		\n\
		Проживание:\t\t\t%s\n\
		Бизнесов:\t\t\t%i\n\
		Игровой статус:\t\t\t%s\n\
		Отыгранно за неделю:\t\t%s",\
			PN(playerid), PI[playerid][pLevel], PI[playerid][pExp], (PI[playerid][pLevel] + 1)*6, PI[playerid][pLevel_RP], PI[playerid][pPhone_Number],\
			PI[playerid][pPhone_Cash], PI[playerid][pWanted], PI[playerid][pLevel_Suspect], PI[playerid][pImprovements],\
			PI[playerid][pLevel_Skill][11], GetInvCount(playerid, 25), GetInvCount(playerid, 26), GetInvCount(playerid, 27),\
			GetPlayerSexName(playerid), GetPlayerSex(playerid) ? ("Замужем за") : ("Женат на"),\
			PI[playerid][pNickName_Wife], PI[playerid][pArmyTicket] != false ? ("Есть") : ("{A9A9A9}Нет{FFFFFF}"),\
			FractionStaticData[PI[playerid][pMember_ID]][frName], FractionRName[PI[playerid][pMember_ID]][PI[playerid][pMember_Rang]], PI[playerid][pMember_Rang], TattoStaticData[PI[playerid][pLevel_Tatto]][tsName],\
			str_2, GetPlayerBusinesses(playerid), str_1, "0 ч 0 мин (из них AFK: 0 ч 0 мин)")), "Имущество", "Закрыть");
	return 1;
}
stock HexStr(const string[]) 
{
    if(!string[0]) return 0;
    new cur = 1, res = 0;
    for(new i = strlen(string); i > 0; i--)
    {
        res += cur * (string[i - 1] - ((string[i - 1] < 58) ? (48) : (55)));
        cur = cur * 16;
    }
    return res;
}
