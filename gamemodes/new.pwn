						if(!GetString(CarData[number][cOwner], PN(playerid)))
						{
							SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
							return 1;
						}
					}
					new E_VEHICLE_PARAMS_STRUCT: param = V_BOOT;
					new set_status = GetVehicleParam(vehicleid, param) ^ VEHICLE_PARAM_ON;
					SetVehicleParam(vehicleid, param, set_status);
