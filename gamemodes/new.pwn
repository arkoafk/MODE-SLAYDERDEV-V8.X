							return 1;
						}
						str_1[0] = EOS;
						new count;
						for(new i; i < 9; i++)
						{
							new uid = IsValidAcsPerson(CarData[number][cObjectModel][i]);
							if(uid == -1) continue;
							strcat(str_1, (str_f("%i. %s\n", count+1, PersonAcsData[uid][accName])));
							player_ShowData[playerid][count] = i;
							count++;
						}
						if(count) SPD(playerid, 20337, DIALOG_STYLE_LIST, "Список украшений", str_1, "Снять", "Выйти");
						else SCM(playerid, 0x808080FF, "На этом ТС нет украшений");
					}
				}
			}
			case 121:
			{
				callcmd::take_number(playerid);
