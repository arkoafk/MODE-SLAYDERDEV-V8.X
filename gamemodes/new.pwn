			if(!count) count = true;
			else strcat(str_2, ",");
			f(str_1, sizeof(str_1), "[%i,\"%s\",%i,%i,%i]", AccessoriesData[i][acsModel], AccessoriesData[i][acsName], AccessoriesData[i][acsCost]*BizData[bizid][bProductEx], AccessoriesData[i][acsSlots], i);
