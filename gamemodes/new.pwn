new gangZone_Data[sizeof(gangZone_StaticData)];
stock GangZone_Create()
{
	for(new i; i < sizeof(gangZone_StaticData); i++)
	{
		gangZone_Data[i] = GangZoneCreate(gangZone_StaticData[i][gzMin_x], gangZone_StaticData[i][gzMin_y], gangZone_StaticData[i][gzMax_x], gangZone_StaticData[i][gzMax_y]);
	}
}
stock player_GangZone_Show(playerid)
{
	for(new i; i < sizeof(gangZone_StaticData); i++)
	{
		GangZoneShowForPlayer(playerid, gangZone_Data[i], gangZone_StaticData[i][gzColor]);
	}
}
