// ------------------------------------------
stock Float: GetAngleToPoint(Float:x1, Float:y1, Float:x2, Float:y2)
{
	return atan2(y1-y2, x1-x2)-90.0;
}
// ------------------------------------------
stock GetVehicleSpeed(vehicleid)
{
	if(vehicleid <= 0) return 0;
    new Float:ST[4];
    GetVehicleVelocity(vehicleid, ST[0], ST[1], ST[2]);
    ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 200.0;
    return floatround(ST[3]);
}

