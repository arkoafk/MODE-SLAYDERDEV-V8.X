	return 1;
}

public OnPlayerUpdate(playerid)
{
	if(!IsPlayerAFK{playerid}) PI[playerid][pAFKTime] = 0;
	if(noclipdata[playerid][cameramode] == CAMERA_MODE_FLY)
	{
		new keys,ud,lr;
		GetPlayerKeys(playerid,keys,ud,lr);
		if(noclipdata[playerid][mode] && (GetTickCount() - noclipdata[playerid][lastmove] > 100))
		{
			MoveCamera(playerid);
		}
		if(noclipdata[playerid][udold] != ud || noclipdata[playerid][lrold] != lr)
		{
			if((noclipdata[playerid][udold] != 0 || noclipdata[playerid][lrold] != 0) && ud == 0 && lr == 0)
			{
				StopPlayerObject(playerid, noclipdata[playerid][flyobject]);
				noclipdata[playerid][mode]      = 0;
				noclipdata[playerid][accelmul]  = 0.0;
			}
			else
			{  
				noclipdata[playerid][mode] = GetMoveDirectionFromKeys(ud, lr);
				MoveCamera(playerid);
			}
		}
		noclipdata[playerid][udold] = ud; noclipdata[playerid][lrold] = lr;
		return 0;
	}
	return 1;
}

public OnPlayerStreamIn(playerid, forplayerid)
{
	player_UpdateAcs(playerid, forplayerid);
	player_Voice_Enter(playerid, forplayerid, 4);
	return 1;
}
stock player_Voice_Enter(playerid, forplayerid, packetid)
{
	new
		BitStream:bsn = BS_New(),
		Float:dist = GetDistanceBetweenPlayers(playerid, forplayerid);
	//SCMf(to_player, -1, "%f", dist);
	BS_WriteValue(bsn, 
				PR_UINT8, 215,
				PR_UINT16, packetid,
				PR_UINT32, forplayerid,
				PR_FLOAT, dist);
    PR_SendPacket(bsn, playerid);
	BS_Delete(bsn);
	//SCMf(to_player, -1, "onplayerstream %i", playerid);
}
public OnPlayerStreamOut(playerid, forplayerid)
{
	player_UpdateAcs(playerid, forplayerid, -1, true);
	player_Voice_Enter(playerid, forplayerid, 5);
	return 1;
}
