CMD:myjobs(playerid)
{
	if(player_CountNullJobID(playerid) != 0)
	{
		str_1 = "{DADAD9}Специальность <t>{DADAD9}Должность\n";
		for(new i, count; i < 3; i++)
		{
			new job_id = PI[playerid][pJob_ID][i];
			if(job_id == -1) continue;

			if(PI[playerid][pJob_Style][i] == 1) str_mes = "Штатный дальнобойщик";
			else if(PI[playerid][pJob_Style][i] == 0) str_mes = "Внештатный дальнобойщик";
			else str_mes = "Обычный";

			f(str_1, sizeof(str_1), "%s%i. {DADAD9}%s\t%s\n", str_1, count + 1, JobsStaticData[job_id], str_mes);
			player_ShowUID[playerid][count] = i;
			count++;
		}
		SPD(playerid, 20456, 5, "{B3CA5A}Мои профессии", str_1, "Уволиться","Закрыть");
	}
	else
	{
		SCM(playerid,-456493910, "Вы не владеете рабочими профессиями.");
		SCM(playerid,-456493910, "Воспользуйтесь центром занятости или предложениями частных предпринимателей.");
	}
	return 1;
}
