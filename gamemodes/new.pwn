stock player_BuyCarEvent(playerid, type, current, model)
{
	if(!OpenInterface[playerid][9]) return 1;
	#pragma unused current
	switch(type)
	{
	    case 1: //buy
		{
			if(!(player_AntiFlood[playerid][15]-global_time > 0))
			{
				player_AntiFlood[playerid][15] = global_time+5;
				new count = player_CarSlotsCount(playerid);
				if(count <= GetPlayerCarsSQL(playerid))
				{
					SCMf(playerid, 0x3399FFFF, "Все слоты для машин заняты. Всего у вас слотов для покупки машин: %i", count);
					player_DisplayText(playerid, "Все слоты заняты!");
					return 1;
				}
				ExecutePacket(playerid, webUpdate, "interface('CarsShop').showResult = false");
				new j = IsValidCarModel(model),
					uid = addcars_SearchUID(model);
				if(j == -1) player_DisplayText(playerid, "ID -1; сообщите разработчику");
				else if(!CountSale[uid]) player_DisplayText(playerid, "В наличии нет данной модели");
				else ExecutePacket(playerid, webUpdate, "interface('CarsShop').showResult = true");
			}
		}
		case 3: //exit
	    {
			new id = player_AddCars_Type[playerid];
			if(id != -1)
			{
				if(!player_AddCars[playerid][id]) return 0;
			}
			TogglePlayerControllable(playerid, true);
			ExecutePacket(playerid, webClose, "CarsShop");
			player_SetCursorStatus(playerid, false);
			player_HideBuyCar(playerid);
			OpenInterface[playerid][9] = false;
	    }
		case 6: //buy accept
		{
			ExecutePacket(playerid, webUpdate, "interface('CarsShop').showResult = false");
			new j = IsValidCarModel(model),
				uid = addcars_SearchUID(model);
			if(j == -1 || uid == -1) return player_HideBuyCar(playerid);
			if(!CountSale[uid])
			{
				player_DisplayText(playerid, "В наличии нет данной модели");
				return 1;
			}
			new car_price = AddCarsData[uid][acCost]*2;
			if(CompareInt64(playerid, "<", car_price)) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
			//if(player_Cash[playerid] < car_price) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
			GivePlayerMoneyEx(playerid, -car_price, "Покупка машины");
			GiveBusinessMoney(playerid, player_BizEntered[playerid], car_price/9, -random(200));
			new rand = random(7);
			static const
