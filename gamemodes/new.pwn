		case 104: //{104, "CarSiren_OnPlayerBeepEnable"},
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid > 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
				if(GetVehicleData(vehicleid, V_ACTION_TYPE) == 4)
				{
					new uid = player_SearchJobID(playerid, 0);
					if(uid != -1)
					{
						new bizid = PI[playerid][pJob_BizID][uid];
						if(bizid != -1)
						{
							if(bizid == VehicleData[vehicleid][V_ACTION_ID])
							{
								if(vehicleid == PI[playerid][pTemp_JobCarID][uid]) 
								{
									for(new i; i < sizeof(Carriers_PickupPos); i++)
									{
										if(IsPlayerInDynamicArea(playerid, Carriers_Area[i]))
										{
											SPD(playerid, 20480, 2, "{FFCD00}Гараж транспортной компании", "\
												1. {ffc386}Поместить транспорт {ffffff}на парковку\n\
												2. {ffc386}Поместить прицеп{ffffff} в гараж\n\
												3. {fff486}Вывезти из гаража{ffffff} прицеп для груза\n\
												4. {fff486}Вывезти из гаража{ffffff} цистерну для топлива\n\
												5. Информация о транспорте", "Далее","Закрыть");
											break;
										}
									}
								}
							}
						}
					}
				}
				if(IsPlayerInRangeOfPoint(playerid, 4.0, 2346.1768,-2609.9480,21.7944)) player_StageTuning_Open(playerid, 0);
				else if(IsPlayerInRangeOfPoint(playerid, 4.0, 258.6929, 703.7468, 11.9881)) player_StageTuning_Open(playerid, 1);
				else if(IsPlayerInRangeOfPoint(playerid, 4.0, -397.4985, 1009.9011, 12.1381)) player_SPanelTuning_Open(playerid);
				else OnVehicleHornSound_Enable(vehicleid);
			}
		}
		case 105: //{105, "CarSiren_OnPlayerBeepDisable"}
