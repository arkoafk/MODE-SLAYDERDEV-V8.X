	{
		
	}
}
CMD:addgarage(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new interior; else return cmd_addgarage(playerid);
	if(interior < 0 || interior >= sizeof(GarageStaticData)) return cmd_addgarage(playerid);
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] создал гараж [id: %i, interior: %i]", PN(playerid), playerid, TOTAL_GARAGES, interior);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	GetPlayerFacingAngle(playerid, position[3]);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `Garages` (`Interior`, `Enter`) VALUES ('%i', '%.2f,%.2f,%.2f,%.2f,')", interior, position[0], position[1], position[2], position[3]);
	mysql_tquery(mysql, str_q, "func_AddGarage");
	return 1;
}
public: func_AddGarage()
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `Garages` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadGarageMySQL", "i", 0);
	return 1;
}
stock cmd_addgarage(playerid)
{
	SCM(playerid, 0xCECECEFF, !"Используйте: /addgarage [interior]");
	SCM(playerid, COLOR_RED, "ВЫСТАВИ ПЕРСОНАЖА В ТУ СТОРОНУ, В КОТОРОЙ БУДЕТ СПАВНИТЬСЯ АВТО!!");
	str_2 = "interior type\n";
	for(new i; i < sizeof(GarageStaticData); i++)
	{
		str_1[0] = EOS, f(str_1, sizeof(str_1), "%i - %s\n", i, GarageStaticData[i][gsName]);
		strcat(str_2, str_1);
	}
	SPD(playerid, 0, 0, "addgarage", str_2, "Закрыть", "");
	return 1;
}
CMD:garage(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_garage(playerid);
	return 1;
}
alias:garage("garages")
stock cmd_garage(playerid, dialogid=20262)
{
	if(player_GarageEntered[playerid] != -1)
	{
		if(GetString(HouseData[player_GarageEntered[playerid]][hOwner], PN(playerid))) 
		{
			ShowPlayerGarageData(playerid, player_GarageEntered[playerid]);
			return 1;
		}
	}
	str_1[0] = EOS;
	str_1 = "{FFFFFF}Номер гаража\t{FFFFFF}Расстояние\n";
	new count;
	memset(player_ShowID[playerid], -1);
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(!GetString(GarageData[i][gOwner], PN(playerid))) continue;
		new Float:dist = GetPlayerDistanceFromPoint(playerid, GarageData[i][gEnter][0], GarageData[i][gEnter][1], GarageData[i][gEnter][2]);
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{FFFFFF}Гараж №%i\t{ffffff}%.2f\n", i, dist);
		strcat(str_1, str_2);
		player_ShowID[playerid][count] = i;
		count++;
	}
	switch(count)
	{
		case 0: SCM(playerid, 0x999999FF, !"У Вас нет гаража");
		case 1: 
		{
			if(dialogid == 20262) ShowPlayerGarageData(playerid, player_ShowID[playerid][0]);
			else SPD(playerid, dialogid, DIALOG_STYLE_TABLIST_HEADERS, "{FFCD00}Выберите гараж", str_1, "Выбрать", "Закрыть");
		}
		default: SPD(playerid, dialogid, DIALOG_STYLE_TABLIST_HEADERS, "{FFCD00}Выберите гараж", str_1, "Выбрать", "Закрыть");
	}
	return 1;
}
stock ShowPlayerGarageData(playerid, id)
{
	if(!GetString(PN(playerid), GarageData[id][gOwner])) return SCM(playerid, 0x999999FF, !"Это не ваш гараж!");
	player_ShowID[playerid][80] = id;


	new count;
	str_2 = "{999999}Транспорт в гараже:\n";

	foreach(new i: OWNABLECARS)
	{
		if(!GetString(CarData[i][cOwner], PN(playerid)) || GetVehicleVirtualWorld(OwnableCar[i]) != id+7) continue;
		new uid = IsValidCarModel(CarData[i][cModel]);
		f(str_2, sizeof(str_2), "%s\n%i. %s (%i)", str_2, count+1, VehicleStaticData[uid][vsName], CarData[i][cModel]);
		count++;
	}
	if(!count) str_2 = "{CC3333}Транспорт в гараже: {ff0000}Нет";

	str_1[0] = EOS;
	switch(GarageData[id][gInterior])
	{
		case 0: str_1 = "Гаражи эконом класса";
		case 1: str_1 = "Гаражи среднего класса";
		case 2: str_1 = "Гаражи высокого класса";
		default: str_1 = "[нет данных]";
	}
	f(str_1, sizeof(str_1), "\
			{FFFFFF}Владелец:\t\t\t\t{339999}%s\n\
			{FFFFFF}Номер гаража:\t\t\t\t%i\n\
			Город / поселок:\t\t\t[нет данных]\n\
			Район:\t\t\t\t\t%s\n\
			Уровень улучшений:\t\t\t%i\n\
			Гараж оплачен на:\t\t%i/15 дней\n\
			Гос. стоимость:\t\t%i\n\
			Арендная плата:\t\t%i руб в день\n\
			Статус:\t\t\t\t\t%s\n\n\
			%s\n\
			{669966}Для открытия панели управления вашим домом\n\
			нажмите кнопку Изменить", \
				GarageData[id][gOwner],\
				id, str_1,
				GarageData[id][gLevel],\
				((GarageData[id][gNalog]-global_time) / 86400),\
				GarageStaticData[GarageData[id][gInterior]][gsCost],\
				GarageStaticData[GarageData[id][gInterior]][gsNalog],\
				!GarageData[id][gLock] ? ("{CC3333}Гараж закрыт") : ("{66CC33}Гараж открыт"), str_2);
	SPD(playerid, 20263, DIALOG_STYLE_MSGBOX, "{33AACC}Информация о гараже", str_1, "Изменить", "Отмена");
	return 1;
}
CMD:buygarage(playerid)
{
	new id = player_EnterGarage[playerid];
	if(id == -1) return SCM(playerid, 0xCECECEFF, !"Вы должны быть рядом с гаражем, который хотите купить.");
	
	new bindID = GarageData[id][gbindID];
	if(bindID != -1)
	{
		if(!GetString(HouseData[bindID][hOwner], PN(playerid)))	
		{
			SCM(playerid, 0xCECECEFF, !"* Данный гараж может купить только владелец дома");
			return 1;
		}
	}

	player_GetTickCount[playerid] = GetTickCount();
	SPD(playerid, 20265, 0, "{33AACC}Покупка нового гаража", (str_f("\
		{FFFFFF}Название:\t\t\t{339999}%s\n\
		{FFFFFF}Стоимость:\t\t\t{6699FF}%i руб\n\
		{FFFFFF}Плата за аренду:\t\t{6699FF}%i руб в день\n\n\
		{669966}Вы уверены что хотите купить этот бизнес?", \
		GarageStaticData[GarageData[id][gInterior]][gsName],\
		GarageStaticData[GarageData[id][gInterior]][gsCost],\
		GarageStaticData[GarageData[id][gInterior]][gsNalog])), "Да", "Нет");
	return 1;
}
CMD:setgaragehouse(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return 1;
	extract get -> new garageID, houseID; else
	{
		SCM(playerid, COLOR_RED, !"Используй: /setgaragehouse [garage ID] [house ID]");
		SCM(playerid, COLOR_RED, !"garage ID: пишется в 3D тексте!!!!");
		SCM(playerid, COLOR_RED, !"house ID: пишется в ЦЕФ МЕНЮ!!!");
		SCM(playerid, COLOR_RED, !"house ID: Если хочешь убрать привязку к дому пиши \"-1\"");
		return 1;
	}
	if(houseID != -1)
	{
		if(DistancePointToPoint(\
			HouseData[houseID][hEnter][0], HouseData[houseID][hEnter][1], HouseData[houseID][hEnter][2], \
			GarageData[garageID][gEnter][0], GarageData[garageID][gEnter][1], GarageData[garageID][gEnter][2]) > 100) return SCM(playerid, COLOR_RED, !"Дистанция между домом и гаражем велика!!");
	}
	GarageData[garageID][gbindID] = houseID;
	UpdateDataInt("Garages", "bindID", GarageData[garageID][gbindID], GarageData[garageID][gID]);
	return 1;
}
stock ChangeGarageOwner(id, const name[])
{
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Гараж %i, Владелец %s, Новый владелец %s.", id, GarageData[id][gOwner], name);
	SendLog(5, str_log);
	//printf("ChangeGarageOwner -> [id: %i] [old: %s] [new: %s]", id, GarageData[id][gOwner], name);
	SetString(GarageData[id][gOwner], name);
	UpdateDataStr("Garages", "Owner", GarageData[id][gOwner], GarageData[id][gID]);

	GarageData[id][gNalog] = global_time+(86400*3);
	UpdateDataInt("Garages", "Nalog", GarageData[id][gNalog], GarageData[id][gID]);
	UpdateGarage(id, false);
}
stock ShiftCords(style, &Float:x, &Float:y, Float:a, Float:distance)
{
	switch(style)
	{
	    case 0:
	    {
	        x += (distance * floatsin(-a, degrees));
			y += (distance * floatcos(-a, degrees));
	    }
	    case 1:
		{
		    x -= (distance * floatsin(-a, degrees));
			y -= (distance * floatcos(-a, degrees));
		}
		default: return 0;
	}
	return 1;
}
stock PreEnterPlayerToBiz(playerid, id)
{
	//SCMf(playerid, -1, "1. %i", BizStaticData[BizData[id][bType]][bsType]);
	if(!BizData[id][bLock]) GameTextForPlayerEx(playerid, "~r~Закрыто", 3000, 2);
	else if(BizStaticData[BizData[id][bType]][bsType] == 1) //АЗС
	{
		//SCMf(playerid, -1, "2. %i", BizStaticData[BizData[id][bType]][bsType]);
		if(GetPlayerVehicleID(playerid) < 1) player_ShopDialog(playerid, id);
		else 
		{
			if(GetPlayerState(playerid) == 2) player_FuelMenu_Open(playerid);
			else SCM(playerid, -1, "Вы должны быть на водительском месте!");
		}
	}
	else if(BizStaticData[BizData[id][bType]][bsType] == 42) //АЗС
	{
		if(!GetString(BizData[id][bOwner], PN(playerid)))
		{
			SCM(playerid,1940848127, "Вход только для сотрудников ветровой станции");
			GameTextForPlayerEx(playerid, "~r~Вход только~n~для сотрудников", 4000, 2);
		}
		EnterPlayerToBiz(playerid, id);
	}
	else if(BizStaticData[BizData[id][bType]][bsType] == 5) //Автосалон
	{
		if(GetString(BizData[id][bName], "эконом")) player_DialogBuyCar(playerid, 0);
		else if(GetString(BizData[id][bName], "мото-вело")) player_DialogBuyCar(playerid, 4);
		else if(GetString(BizData[id][bName], "премиум")) player_DialogBuyCar(playerid, 2);
	}
	else if(BizStaticData[BizData[id][bType]][bsExit][0] != 0.0)
	{
		if(BizStaticData[BizData[id][bType]][bsType] == 16 && PI[playerid][pLevel] < 2) return SCM(playerid, 0x999999FF, !"Зайти в казино можно с 2 уровня!");
		if(BizData[id][bEnterPrice] > 0)
		{
			if(!player_IsEnterBiz[playerid][id])
			{
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s %s", BizStaticData[BizData[id][bType]][bsName], BizData[id][bName]);
				SPD(playerid, 20250, 0, str_mes, (str_f("\
					{FFFFFF}Вход платный и составляет {FF9900}%i руб\n\
					{99FF00}Вы уверены что хотите войти сюда?", BizData[id][bEnterPrice])), "Да","Нет");
				return 1;
			}
		}
		EnterPlayerToBiz(playerid, id);
	}
	//else SCM(playerid, COLOR_RED, "Входа нет!");
	return 1;
}
stock gc_SetSuspectLook(suspectid, Float: look_x, Float: look_y)
{
	new 
		Float: x,
		Float: y,
		Float: a;

	GetPlayerPos(suspectid, x, y, a);
	a = atan2(look_y - y, look_x - x) - 90.0;
	SetPlayerFacingAngle(suspectid, a);
	return 1;
}
new player_UpdateInVehicle[MAX_PLAYERS],
	player_GlobalMinute[MAX_PLAYERS char];
public: OnPlayerUpdateEx(playerid)
{
	if(!IsPlayerLogged(playerid))
	{
		if(player_PLoadConnect{playerid} > 0)
		{
			player_PLoadConnect{playerid}--;
			if(player_PLoadConnect{playerid} == 0)
			{
				str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID`, `Password`, `Last_IP`, `ID_Telegram`, `Last_Position`, `Last_LoginTime` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", PN(playerid));
				mysql_tquery(mysql, str_q, "GetPlayerDataMySQL", "i", playerid);
			}
		}
		else if(PI[playerid][pID] != -1)
		{
			PI[playerid][pTemp_AuthTime]++;
			if(PI[playerid][pTemp_AuthTime] > 90)
			{
				Kick(playerid, "Время на авторизацию истекло!");
				ExecutePacket(playerid, webClose, "Authorization");
			}
		}
	}
	else
	{
		opat_OnPlayerUpdate(playerid);
		Carriers_UpdateDuty(playerid);
		if(player_GlobalMinute{playerid} != global_minute)
		{
			player_GlobalMinute{playerid} = global_minute;
			if(OpenInterface[playerid][88] != false)
			{
				GetPhoneData(playerid);
				ExecutePacket(playerid, webUpdate, (str_f("interface('Phone').updateTime('%s')", str_1)));
			}
		}
		if(GetPlayerVirtualWorld(playerid) == 0 && GetPlayerInterior(playerid) == 0)
		{
			if(!PI[playerid][pAdmin] && (PI[playerid][pGameTime_forDay] % 180) == 0)
			{
				GetPlayerPos(playerid, player_TempPosition[playerid][0], player_TempPosition[playerid][1], player_TempPosition[playerid][2]);
			}
		}
		player_Pursuit_Update(playerid);
		if(player_SpectateData[playerid][sdTimeOut] > 0)
		{
			player_SpectateData[playerid][sdTimeOut]--;
			if(player_SpectateData[playerid][sdTimeOut] == 1)
			{
				SetPlayerVirtualWorld(playerid, player_SpectateData[playerid][sdVirtualWorld]);
				SetPlayerInterior(playerid, player_SpectateData[playerid][sdInterior]);
				player_SpectateData[playerid][sdPlayerID] = -1;
				PI[playerid][pMember_ID] = player_SpectateData[playerid][sdMemberID];
				player_SpectateData[playerid][sdMemberID] = 0;
				player_SpectateData[playerid][sdTimeOut] = 0;
			}
		}
		if(player_LastPosition_Clear{playerid} > 0)
		{
			player_LastPosition_Clear{playerid}--;
			if(player_LastPosition_Clear{playerid} == 1)
			{
				for(new i; i < 4; i++) 
				{
					PI[playerid][pLast_Position][i] = 0.0;
				}
				mysql_tquery(mysql, (str_f("UPDATE `players` SET `Last_Position` = '%f,%f,%f,%f' WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2], PI[playerid][pLast_Position][3], PI[playerid][pID])));
				player_LastPosition_Clear{playerid} = 0;
			}
		}
		if(noclipdata[playerid][FLYOFF_timeOut] > 0)
		{
			noclipdata[playerid][FLYOFF_timeOut]--;
			if(noclipdata[playerid][FLYOFF_timeOut] == 1)
			{
				noclipdata[playerid][FLYOFF] = false;
				noclipdata[playerid][FLYOFF_timeOut] = 0;
			}
		}
		if(player_LoadAks{playerid} > 0)
		{
			player_LoadAks{playerid}--;
			if(player_LoadAks{playerid} == 0)
			{
				player_UpdateAcs(playerid, playerid);
			}
		}
		if(player_Paintball_DeathEx{playerid} > 0)
		{
			player_Paintball_DeathEx{playerid}--;
			if(player_Paintball_DeathEx{playerid} == 0)
			{
				player_Paintball_Spawn(playerid);
			}
		}
		anticheat_OnPlayerUpdateEx(playerid);
		//шахта
		//SCMDf(playerid, "onplayerupdateex %i", player_UpdateEx[playerid]);
	//		if(PI[to_player][pTemp_Cuffed] != false) return SCM(playerid, 0xCECECEFF, !"* Игрок должен быть в наручниках");
	//if(PI[to_player][pTemp_Escort] != -1) return SCM(playerid, 0xCECECEFF, !"* Этот игрока уже кто то ведет");
		if(PI[playerid][pTemp_Cuffed] != false)
		{
			if(PI[playerid][pTemp_Escort] != -1)
			{
				new to_player = PI[playerid][pTemp_Escort];
				if(!IsPlayerLogged(to_player))
				{
					cmd_uncuff(playerid);
				}
				else
				{
					if(!(GetPlayerVehicleID(to_player) > 0))
					{
						if(GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(to_player))
						{
							SetPlayerVirtualWorld(to_player, GetPlayerVirtualWorld(playerid));
							SetPlayerInterior(to_player, GetPlayerInterior(playerid));
						}
						if(GetDistanceBetweenPlayers(playerid, to_player) > 1.5) 
						{
							new Float: a, Float:x, Float:y, Float:z;
							GetPlayerPos(to_player, x, y, z);
							GetPlayerFacingAngle(to_player, a);
							TogglePlayerControllable(playerid, 1);
							gc_SetSuspectLook(playerid, x, y);
						}
						if(GetDistanceBetweenPlayers(playerid, to_player) < 1.5) ClearAnimationsSync(playerid), TogglePlayerControllable(playerid, false);
						else if(GetDistanceBetweenPlayers(playerid, to_player) > 30.0)
						{
							static Float:x, Float:y, Float:z;
							GetPlayerPos(to_player, x, y, z);
							SetPlayerPos(playerid, x+1, y+1, z);
						}
						else if(GetDistanceBetweenPlayers(playerid, to_player) > 8.0)
						{
							ApplyAnimation(playerid, "ped", "RUN_civi", 4.1, 1, 1, 1, 0, 0, 1);
						}
						else if(GetDistanceBetweenPlayers(playerid, to_player) > 2.0)
						{	
							ApplyAnimation(playerid, "ped", "WALK_civi", 4.1, 1, 1, 1, 0, 0, 1);
						}	
						else if(GetDistanceBetweenPlayers(playerid, to_player) < 2.0) ClearAnimationsSync(playerid), TogglePlayerControllable(playerid, false);
					}
				}
			}
		}
		if(player_DefaultJob_ID[playerid] == 2)
		{
			new vehicleid = GetPlayerVehicleID(playerid);
			if(vehicleid > 0)
			{
				if(VehicleData[vehicleid][V_MODELID] == 538)
				{
					player_Machinist_Update(playerid);
				}
			}
			if(player_DefaultJob_Timer{playerid} > 0)
			{
				player_DefaultJob_Timer{playerid}--;
				if(player_DefaultJob_Timer{playerid} == 1)
				{
					player_DestroyVehicle(playerid), print("debug vehicle destroy 211");
					SCM(playerid,-825307393, "* Вы не успели сесть в локомотив");
					player_DefaultJob_Timer{playerid} = 0;
					player_DefaultJob_ID[playerid] = -1;
				}
				else GameTextForPlayerEx(playerid, (str_f("~r~САДИТЕСЬ В ПОЕЗД~n~~g~%i сек.", player_DefaultJob_Timer{playerid})), 1300, 1);
			}
		}
		if(player_TradeItems_Timer[playerid] > 0) player_TradeItems_Timer[playerid]--;
		if(player_Trade_Timer[playerid] > 0) player_Trade_Timer[playerid]--;
		if(player_DefaultJob_ID[playerid] == 0)
		{
			if(player_DefaultJob_Progress[playerid][0] > 1)
			{
				//SCMf(playerid, -1, "progress %i", player_DefaultJob_Progress[playerid][0]);
				switch(player_DefaultJob_Progress[playerid][0])
				{
					case 4:
					{
						RemovePlayerAttachedObject(playerid, 3);
						ApplyAnimation(playerid, "CARRY", "liftup", 8, 0, 0, 0, 0, 0, 1);
					}
					case 3:
					{
						RemovePlayerAttachedObject(playerid, 3);
						ApplyAnimation(playerid, "GHANDS", "gsign3LH", 4.0999999046326, 0, 160, 128, 0, 0, 1);
						SetPlayerAttachedObject(playerid, 3, 1303, 5, 0.10000000149012, 0.050000000745058, -0.10000000149012, 0, 90, 0, 0.16199900209904, 0.14300000667572, 0.15399900078773);
						SetPlayerAttachedObject(playerid, 4, 2936, 6, 0.10000000149012, 0.050000000745058, 0.10000000149012, 0, 90, 0, 0.20000000298023, 0.20000000298023, 0.20000000298023);
					}
					case 2:
					{
						RemovePlayerAttachedObject(playerid, 3);
						RemovePlayerAttachedObject(playerid, 4);
						SetPlayerAttachedObject(playerid, 0, 1458, 1, -0.89999997615814, 0.69999998807907, 0.019999999552965, 0, 90, 0, 0.5799999833107, 0.60000002384186, 0.40000000596046);
						SetPlayerAttachedObject(playerid, 1, 816, 1, -0.62999999523163, 1.2999999523163, 0, 270, 75, 0, 0.5, 0.40000000596046, 0.80000001192093);
						player_DefaultJob_Progress[playerid][0] = 2;
					}
				}
				player_DefaultJob_Progress[playerid][0]--;
			}
		}
		player_TargetID[playerid] = (!GetPlayerWeapon(playerid) ? GetPlayerTargetPlayer(playerid) : INVALID_PLAYER_ID);
		if(player_TargetID[playerid] != INVALID_PLAYER_ID)
		{
			if(IsPlayerConnected(player_TargetID[playerid]) && IsPlayerLogged(player_TargetID[playerid]))
			{
				if(!(player_AntiFlood[playerid][8]-global_time > 0))
				{
					player_AntiFlood[playerid][8] = global_time+120;
					SCM(playerid, -1, !"{F9B82E}[Взаимодействие с человеком] {FFFFFF}Для взаимодействия используйте клавишу {FF5B1D}R");
					ExecutePacket(playerid, webUpdate, "interface('ScreenNotification').add\
						('[\
							1,\"Взаимодействие с человеком\",\
							\"Для взаимодействия используйте клавишу {FF5B1D}R\",\"F9B82E\",5000\
						]')");
				}
			}
			else player_TargetID[playerid] = INVALID_PLAYER_ID;
		}
		//else if(GetPlayerTargetPlayer(playerid))
		//{
		//	player_GZ_Warning
		//}
		if(player_GetDamage_Tick{playerid} < 254) player_GetDamage_Tick{playerid}++;
		if(PI[playerid][pRewardTime] < 7200) PI[playerid][pRewardTime]++;
		if(GetPlayerState(playerid) == 2)
		{
			if(player_UpdateInVehicle[playerid] > 4)
			{
				player_UpdateSpeed(playerid);
				player_UpdateInVehicle[playerid] = 0;
			}
			else player_UpdateInVehicle[playerid]++;
		}
		player_CheckRentVehicle(playerid);

		player_UpdateRecon(playerid);

		if(PI[playerid][pHunger] < 1 && PI[playerid][pHealth] > 20)
		{
			if(!(player_AntiFlood[playerid][3]-global_time > 0))
			{
				player_AntiFlood[playerid][3] = global_time+random(89);
				SetPlayerHealthEx(playerid, GetPlayerSpeed(playerid) > 4 ? -0.6 : -0.1);
			}
		}
		else 
		{
			if(!(player_AntiFlood[playerid][4]-global_time > 0))
			{
				player_AntiFlood[playerid][4] = global_time+5+random(10);
				SetPlayerHunger(playerid, -0.03);
			}
		}
		if(PI[playerid][pHospital] != false)
		{
			if(GetPlayerData(playerid, pTemp_BedID) != -1)
			{
				GameTextForPlayerEx(playerid, "~g~+ 2 здоровье", 1000, 2);
				SetPlayerHealthEx(playerid, 2);
			}
		}
		if(player_Install_Number{playerid} != 255)
		{
			player_Install_Number{playerid}--;
			if(player_Install_Number{playerid} == 1)
			{
				ClearPlayerAnim(playerid);
				player_Install_Number{playerid} = 255;
			}
		}
		//safe saveInv
		player_SafeSave(playerid);
		//

		//
		PI[playerid][pAFKTime]++;
		if(IsPlayerAFK{playerid} || PI[playerid][pAFKTime] > 1)
		{
			new afk_minutes = ConvertUnixTime(GetPlayerAFKTime(playerid), CONVERT_TIME_TO_MINUTES),
				afk_seconds = ConvertUnixTime(GetPlayerAFKTime(playerid));

			if(afk_minutes > 0) str_2[0] = EOS, f(str_2, sizeof str_2, "На паузе %i:%02d", afk_minutes, afk_seconds);
			else str_2[0] = EOS, f(str_2, sizeof str_2, "На паузе %i сек.", afk_seconds);
			SetPlayerChatBubble(playerid, str_2, 0xFF0000FF, 15.0, 1500);
		}
		else
		{
			PI[playerid][pGameTime_forHour]++;
			PI[playerid][pGameTime_forAll]++;
			PI[playerid][pGameTime_forDay][0]++;
		}

		if(PI[playerid][pMuteTime] > 0)
		{
			PI[playerid][pMuteTime]--;
			player_SaveMute{playerid} = 5;
			if(!PI[playerid][pMuteTime]) SCM(playerid, 0x66CC00FF, !"Срок действия бана чата закончился");
		}
		if(PI[playerid][pRMuteTime] > 0)
		{
			PI[playerid][pRMuteTime]--;
			player_SaveMute{playerid} = 5;
			if(!PI[playerid][pRMuteTime]) SCM(playerid, 0x66CC00FF, !"Срок действия бана репорта закончился");
		}
		if(PI[playerid][pVMuteTime] > 0)
		{
			PI[playerid][pVMuteTime]--;
			player_SaveMute{playerid} = 5;
			if(!PI[playerid][pVMuteTime]) SCM(playerid, 0x66CC00FF, !"Срок действия бана VIP чата закончился");
		}
		if(PI[playerid][pVC_muteTime] > 0)
		{
			PI[playerid][pVC_muteTime]--;
			player_SaveMute{playerid} = 5;
			if(!PI[playerid][pVC_muteTime]) SCM(playerid, 0x66CC00FF, !"Срок действия бана VOICE чата закончился");
		}
		if(PI[playerid][pJailTime] > 0)
		{
			PI[playerid][pHospital] = false;
			if(!IsPlayerInRangeOfPoint(playerid, 50.0, 833.6302, 1319.9875, 517.7500) && !IsPlayerInRangeOfPoint(playerid, 100.0, 2493.2595,1378.5850,1000.0214)) player_Spawn(playerid);
			PI[playerid][pJailTime]--;
			PI[playerid][pJailTime_Gen]++;
			if(PI[playerid][pJail_Arrest] == true)
			{
				new idEx = PI[playerid][pLevel_Tatto];
				for(new i=idEx+1; i < sizeof(TattoStaticData); i++)
				{
					if(TattoStaticData[i][tsTime] <= PI[playerid][pJailTime_Gen])
					{
						PI[playerid][pLevel_Tatto]++;
						UpdatePlayerDataInt(playerid, "Level_Tatto", PI[playerid][pLevel_Tatto]);
						SCMf(playerid, COLOR_GREY, "Ваша новая наколка %s(%i)", TattoStaticData[idEx+1][tsName], idEx+1);
						break;
					}
				}
			}
			player_SaveJail{playerid} = 10;
			if(!PI[playerid][pJailTime])
			{
				SCM(playerid, 0x66CC00FF, !"Срок заключения закончился"),UnjailPlayer(playerid);
			}
		}
		if(GetPlayerData(playerid, pTemp_Mask) >= 2)
		{
			AddPlayerData(playerid, pTemp_Mask, -, 1);
			if(GetPlayerData(playerid, pTemp_Mask) <= 2)
			{
				GameTextForPlayerEx(playerid, "~y~invisible off", 2500, 4);

				player_UpdatePerson(playerid);
				SetPlayerData(playerid, pTemp_Mask, 0);
			}
		}
	}
	return 1;
}
stock PayDay()
{
	//Profiler_Dump();
	//for(new i; i < TOTAL_FAMILYS; i++) Family_BizFlood{i} = false;
	foreach(new playerid: Player)
	{
		SetPlayerTime(playerid,global_hour,global_minute);
		if(!IsPlayerLogged(playerid)) continue;
		SCM(playerid, 0xFFD54AFF, !"=========== [БАНКОВСКИЙ ЧЕК] ===========");
		if(player_Pursuit_ID[playerid] == -1 && !PI[playerid][pTemp_Cuffed])
		{
			SetPlayerSuspectLevel(playerid, -1);
		}
		if(GetPlayerAFKTime(playerid) < 60)
		{
			new team_wage;
			//AddPlayerData(playerid, pTemp_Wage, +, team_wage);
			team_wage = FractionStaticData[PI[playerid][pMember_ID]][frWage]*10;
			SCMf(playerid, -1, "Зарплата: {FFD54A}%i руб", team_wage*xpayday);
			//SCMf(playerid, -1, "Зарплата: {66CC00}%i руб", team_wage);
			if(PI[playerid][pAdmin] > 0)
			{
				new admin_pay = 100000*PI[playerid][pAdmin];
				team_wage += admin_pay;
				SCMf(playerid, -1, "Админ зарплата: {FFD54A}%i руб", admin_pay*xpayday);
			}
			AddPlayerData(playerid, pBank, +, team_wage*xpayday);
			ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerBankMoney('%i')", PI[playerid][pBank])));
			SCMf(playerid, 0xFFFFFFFF, "Текущий баланс счета: {FFD54A}%i руб", GetPlayerBankMoney(playerid));
			UpdatePlayerDataInt(playerid, "Bank", PI[playerid][pBank]);
		}
		else SCM(playerid, 0xFFBB00FF, !"Вы не должны находиться на паузе для получения зарплаты");
		new
			hour, 
			minutes, 
			second;
		gettime(hour, minutes, second);
		SCMf(playerid, 0xFFD54AFF, "=============== [%02d:%02d:%02d] ================", hour, minutes, second);
		PI[playerid][pExp] += 1*xpayday;
		CheckNextLevel(playerid);
		player_Save_Other(playerid);
	}
	UpdateStats_Business();
	UpdateStats_Property();
	return 1;
}
stock SavePlayerData(playerid)
{
	if(!IsPlayerLogged(playerid)) return 0;
	player_Save_Other(playerid);
	for(new i; i < 8; i++)
	{
		player_SaveEx(playerid, i);
	}
	return 1;
}
stock player_Save_Other(playerid)
{
	mysql_tqueryf(mysql, "UPDATE `players` SET `Hospital`= '%i', `Health`='%f', `Armour`='%f',`Hunger` ='%f', `RewardTime`= '%i', `GameTime_forDay_0` = '%i', `GameTime_forAll` = '%i' WHERE `ID` = '%i' LIMIT 1",\
	PI[playerid][pHospital], PI[playerid][pHealth], PI[playerid][pArmour], GetPlayerData(playerid, pHunger), PI[playerid][pRewardTime], PI[playerid][pGameTime_forDay][0], PI[playerid][pGameTime_forAll], PI[playerid][pID]);
}
stock CheckNextLevel(playerid){
	if(PI[playerid][pExp] >= (PI[playerid][pLevel] + 1)*6){
		while(PI[playerid][pExp] >= (PI[playerid][pLevel] + 1)*6){
			PI[playerid][pLevel]++;
			PI[playerid][pExp] -= PI[playerid][pLevel]*6;
			if(PI[playerid][pLevel] == 2){
				SCM(playerid,1724645631, "Вы начали второй год своей жизни в нашей области.");
				SCM(playerid,1724645631, "Ознакомьтесь со списком подходящих профессий в центре занятости.");
			}
			else if(PI[playerid][pLevel] == 4){
				if(strlen(PI[playerid][pNickName_Referal]) > 3){
					str_q[0] = EOS;
					f(str_q, sizeof(str_q), "SELECT `NickName` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", PI[playerid][pNickName_Referal]);
					mysql_tquery(mysql, str_q, "player_CheckReferal", "i", playerid);
				}
			}
		}
		SetPlayerScore(playerid, PI[playerid][pLevel]);
		SCM(playerid,865730559, "Поздравляем! Ваш уровень повышен!");
		UpdatePlayerDataInt(playerid, "Level", PI[playerid][pLevel]);
	}
	UpdatePlayerDataInt(playerid, "Exp", PI[playerid][pExp]);
	return true;
}
stock player_BankNalog(playerid) 
{
