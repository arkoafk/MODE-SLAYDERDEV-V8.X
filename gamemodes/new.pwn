stock player_EnterBizToBuy(playerid)
{
	new id; //id biza
	switch(BizStaticData[id][bsType])
	{
		case 11:
		{
			SPD(playerid, 0, 0, "{99CC00}Гостиницы и отели", "\
			{FFFFFF}В гостиницах можно снять один из номеров. Вам будет выделено\n\
			место для парковки автомобиля, который можно купить на любом\n\
			авторынке или подержанный с рук.\n\n\
			Информацию о свободных номерах можно узнать в окошке рядом с Вами.", "Закрыть","");
		}
	}
	return 1;
}
