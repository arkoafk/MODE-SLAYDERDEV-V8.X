stock GetPlayerCarsSQL(playerid)
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) FROM `OwnableCars` WHERE `Owner` = '%s' AND `Owner_Type` = '0' LIMIT 1;", PN(playerid));
	new Cache:result = mysql_query(mysql, str_q);
	static count;
	cache_get_int(0, "COUNT(*)", count);
	cache_delete(result);
	return count;
}
