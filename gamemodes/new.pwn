stock player_ChangeWheel_Open(playerid)
{
	if(OpenInterface[playerid][128]) return 1;
	new vehicleid = player_LastVehicleID[playerid];
	if(vehicleid == INVALID_VEHICLE_ID) return 1;
	new number = GetVehicleID(vehicleid);
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			return 1;
		}
		OpenInterface[playerid][128] = true;
		TogglePlayerControllable(playerid, false);
		player_ChangeWheel_Interface(playerid);
		player_ChangeWheel_CameraOpen(playerid, vehicleid);
		player_ChangeWheel_Camera(playerid);
	}
	return 1;
}
stock player_ChangeWheel_Interface(playerid)
{
	str_1 = "[0,[[\"Стоковые\",-1,50000],";
	player_ShowData[playerid][0] = -1;
	new count = 1;
	for(new i; i < sizeof(TuningStaticData); i++)
	{
		if(TuningStaticData[i][gtType] != 0) continue;
		new 
			cost = TuningStaticData[i][gtCost],
			biz = player_SearchBiz(playerid, 40);
		if(biz != -1) cost = cost*BizData[biz][bProductEx];
		//if(player_BizEntered[playerid] != -1) cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
		if(cost > 1500000000 || cost < 1000) cost = 1500000000;
		str_2[0] = EOS, f(str_2, sizeof(str_2), "[\"%s\",%i,%i],", TuningStaticData[i][gtName], TuningStaticData[i][gtModelID], cost);
		strcat(str_1, str_2);
		player_ShowData[playerid][count] = i;
		count++;
	}
	strdel(str_1, strlen(str_1)-1, strlen(str_1));
	strcat(str_1, "]]");
	ExecutePacket(playerid, webOpen, "TuningStyling", str_1);
}
stock player_ChangeWheel_CameraOpen(playerid, vehicleid)
{
	static Float:x, Float:y, Float:z, Float:a;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, a);
	player_ChangeWheel_CamPos[playerid][0] = x;
	player_ChangeWheel_CamPos[playerid][1] = y+4.0;
	player_ChangeWheel_CamPos[playerid][2] = z;
	ShiftCords(0, x, y, a, 4.2);
	player_ChangeWheel_CamLook[playerid][0] = x;
	player_ChangeWheel_CamLook[playerid][0] = y;
	player_ChangeWheel_CamLook[playerid][1] = z;
}
stock player_ChangeWheel_Close(playerid)
{
	SetCameraBehindPlayer(playerid);
	OpenInterface[playerid][128] = false;
	TogglePlayerControllable(playerid, true);
	new vehicleid = player_LastVehicleID[playerid];
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		new number = GetVehicleID(vehicleid);
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				return 0;
			}
			if(VehicleData[vehicleid][vTuning][0] > 0)
			{
				RemoveVehicleTuningEx(vehicleid, TuningStaticData[ VehicleData[vehicleid][vTuning][0] ][gtObjectID], playerid);
			}
			VehicleData[vehicleid][vTuning][0] = CarData[number][cTuning][0];
			UpdateVehicleTuning(vehicleid, playerid, 0);
		}
	}
	return 1;
}
stock player_ChangeWheel_Click(playerid, click)
{
	if(OpenInterface[playerid][128])
	{
		new vehicleid = player_LastVehicleID[playerid];
		if(vehicleid == INVALID_VEHICLE_ID) return 1;
		new number = GetVehicleID(vehicleid);
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				return 1;
			}
			new item = player_ShowData[playerid][click];
			if(item == -1)
			{
				if(VehicleData[vehicleid][vTuning][0] > 0)
				{
					RemoveVehicleTuningEx(vehicleid, TuningStaticData[ VehicleData[vehicleid][vTuning][0] ][gtObjectID], playerid);
				}
				VehicleData[vehicleid][vTuning][0] = -1;
			}
			else
			{
				VehicleData[vehicleid][vTuning][0] = item;
			}
			UpdateVehicleTuningEx(vehicleid, playerid, 0);
		}
	}
	return 1;
}
stock player_ChangeWheel_Buy(playerid, click)
{
	if(OpenInterface[playerid][128])
	{
		new vehicleid = player_LastVehicleID[playerid];
		if(vehicleid == INVALID_VEHICLE_ID) return 1;
		new number = GetVehicleID(vehicleid);
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				return 1;
			}
			new item = player_ShowData[playerid][click],
				cost = 50000,
				biz = player_SearchBiz(playerid, 40);
			player_ShowUID[playerid][55] = item;
			if(item != -1)
			{
				cost = TuningStaticData[item][gtCost];
				if(biz != -1) cost = cost*BizData[biz][bProductEx];
				if(cost > 1500000000 || cost < 1000) cost = 1500000000;
				SPD(playerid, 20429, 0, "Подтверждение заказа", (str_f("\
					{FFFFFF}Модель: {FF9900}\'%s\'\n\
					{FFFFFF}Стоимость: {FF9900}%i руб.", TuningStaticData[ item ][gtName], cost)), "Да","Нет");
			}
			else
			{
				if(biz != -1) cost = cost*BizData[biz][bProductEx];
				if(cost > 1500000000 || cost < 1000) cost = 1500000000;
				SPD(playerid, 20429, 0, "Подтверждение заказа", (str_f("\
					{FFFFFF}Модель: {FF9900}\'%s\'\n\
					{FFFFFF}Стоимость: {FF9900}%i руб.", "STOCK", 50000)), "Да","Нет");
			}
		}
	}
	return 1;
}
stock player_ChangeWheel_Camera(playerid)
{
	if(OpenInterface[playerid][128])
	{
		new vehicleid = player_LastVehicleID[playerid];
		if(vehicleid == INVALID_VEHICLE_ID) return 1;
		new number = GetVehicleID(vehicleid);
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				return 1;
			}
			if(GetPlayerCameraMode(playerid) == 15) 
			{
				GetPlayerPos(playerid, player_ChangeWheel_Pos[playerid][0], player_ChangeWheel_Pos[playerid][1], player_ChangeWheel_Pos[playerid][2]);
				GetPlayerFacingAngle(playerid, player_ChangeWheel_Pos[playerid][3]);
				TogglePlayerSpectating(playerid, true);
				ExecutePacket(playerid, webClose, "TuningStyling");
				ExecutePacket(playerid, webClose, "Interactions");
				ExecutePacket(playerid, webOpen, "Interactions", "[[220,\"Сохранить камеру\"]]");
				PlayerSpectateVehicle(playerid, vehicleid);
			}
			else
			{
				ExecutePacket(playerid, webClose, "Interactions");
				SetPlayerCameraPos(playerid, player_ChangeWheel_CamPos[playerid][0], player_ChangeWheel_CamPos[playerid][1], player_ChangeWheel_CamPos[playerid][2]);
				SetPlayerCameraLookAt(playerid, player_ChangeWheel_CamLook[playerid][0], player_ChangeWheel_CamLook[playerid][1], player_ChangeWheel_CamLook[playerid][2], CAMERA_MOVE);
				player_ChangeWheel_Interface(playerid);
			}
		}
	}
	return 1;
}
CMD:a_tuning(playerid, get[])
{
	extract get -> new objectid; else return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid > 0)
	{
		new
			BitStream:bsn = BS_New();

		BS_WriteValue(bsn, 	
					PR_UINT8, 215,
					PR_UINT16, 17,
					PR_UINT32, vehicleid,
					PR_UINT32, objectid,
					PR_UINT32, 0);
		PR_SendPacket(bsn, playerid);
		BS_Delete(bsn);
		SCM(playerid, -1, "+++");
	}
	return 1;
}
stock player_detVinyls_Open(playerid, id)
{
	if(OpenInterface[playerid][17]) return 1;
	OpenInterface[playerid][17] = true;
	player_TintingEntered[playerid] = id;
	player_BizEntered[playerid] = player_SearchNearestBusiness(playerid);
	TogglePlayerControllable(playerid, false);
	player_HideSpeed(playerid);
	ExecutePacket(playerid, webClose, "TuningStyling");
	player_detVinyls_Interface(playerid);
	new vehicleid = GetPlayerVehicleID(playerid);
	LinkVehicleToInterior(vehicleid, 3);
	SetPlayerInterior(playerid, 3);

	SetPlayerVirtualWorld(playerid, playerid+1000);
	SetVehicleVirtualWorld(vehicleid, playerid+1000);

	SetVehiclePos(vehicleid, -6.6451997756958, 503.99349975586, 1000.6854248047);
	SetVehicleZAngle(vehicleid, 178.81390380859);
	
	SetPlayerCameraPos(playerid, -3.6451997756958, 498.79733276367, 1001.8854370117);
	SetPlayerCameraLookAt(playerid, -6.6451997756958, 501.99349975586, 1001.2854003906, 2);
	return 1;
}
