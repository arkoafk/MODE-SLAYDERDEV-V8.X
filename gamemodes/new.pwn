CMD:limit(playerid, get[])
{
	extract get -> new limit; else return SCM(playerid,-1717986817, "Используйте: /limit [ макс. скорость] ( 0 - выключить скоростной лимит )");
	new vehicleid = GetPlayerVehicleID(playerid);
	if(GetPlayerState(playerid) != 2 || !(vehicleid > 0)) return 0;
	new model = IsValidCarModel(VehicleData[vehicleid][V_MODELID]);
	if(model != -1)
	{
		new uid = vehicle_SearchHandling(vehicleid);
		if(uid >= 0) 
		{
			new max_speed = floatround(Handling_StaticData[uid][E_MAXGEAR_VELOCITY]);
			if(limit == 0)
			{
				SCM(playerid,-1497104385, "Вы успешно сняли скоростной лимит");
				Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = 0.0;
				new number = GetVehicleID(vehicleid);
				if(number != INVALID_VEHICLE_ID) 
				{
					ownableCars_SetStage(number);
				}
			}
			else if(limit < 20 || limit > max_speed)
			{
				SCMf(playerid,-1717986817, "Допустимый скоростной лимит: От 20 до %i", max_speed);
			}
			else
			{
				Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = -(Handling_StaticData[uid][E_MAXGEAR_VELOCITY]-float(limit));
				SCMf(playerid,-1497104385, "Вы успешно установили скоростной лимит в {FFFFFF}%i км/ч", limit);
			}
		}
	}
	//SCMf(playerid, -1, "%f", Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY]);
	UpdateVehicleHadling(vehicleid, playerid);
	return 1;
}
stock player_WheelService_Dialog(playerid)
{
	if(!OpenInterface[playerid][128])
	{
		SPD(playerid, 20428, 2, "{FFCD00}Шиномонтаж", "\
			{FFFFFF}1. Информация о сотрудниках\n\
			2. Переодеться\n\
			3. Заказать смену дисков", "Далее","Закрыть");
