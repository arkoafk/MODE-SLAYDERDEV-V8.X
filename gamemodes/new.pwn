stock GameTextForPlayerEx(playerid, const string[], time, style)
{
	str_2[0] = EOS, f(str_2, sizeof(str_2), "interface('GameText').add('[%i,\"%s\",%i,0,-1,1,0,3.00]')", style, string, time);
