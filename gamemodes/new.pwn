stock GetVehicleRot(vehicleid,&Float:rx,&Float:ry,&Float:rz)
{
	new Float:qw,Float:qx,Float:qy,Float:qz;
	GetVehicleRotationQuat(vehicleid,qw,qx,qy,qz);
	rx = asin(2*qy*qz-2*qx*qw);
	ry = -atan2(qx*qz+qy*qw,0.5-qx*qx-qy*qy);
	rz = -atan2(qx*qy+qz*qw,0.5-qx*qx-qz*qz);
}
stock OnPlayerInteractionClick(playerid, click, type)
{
	if(player_TargetStaticID[playerid] != INVALID_PLAYER_ID)
	{
		if(IsPlayerConnected(player_TargetStaticID[playerid]) && IsPlayerLogged(player_TargetStaticID[playerid]))
