	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /try [текст]");

	f(str_mes, sizeof str_mes, "%s%s %s %s", (PI[playerid][pAdmin] > 0 ? "{FFB808}[A]{DD90FF} " : ""), PN(playerid), params, !random(3) ? ("{66CC00}| Удачно") : ("{FF6600}| Неудачно"));
	SendMessageInLocal(playerid, str_mes, 0xDD90FFFF, 25.0);

