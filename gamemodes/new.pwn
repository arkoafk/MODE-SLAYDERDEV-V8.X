					1. Заплатить за дом\n\
					2. Оплатить аренду гаража\n\
					3. Оплатить аренду бизнеса\n\
					4. Оплатить аренду киоска\n\
					5. Уплата налоговых квитанций\n\
					6. Ранний запрос налоговых квитанций\n\
					7. Оплатить аренду огорода\n\
					8. Оплатить аренду нефтяного насоса", "Далее","Отмена");
	return 1;
}
stock player_BankMenu(playerid)
{
	new id = player_BizEntered[playerid];
	if(id == -1) return SCM(playerid, 0xCECECEFF, !"Вы не в банке");
	if(BizData[id][bType] != 8) return SCM(playerid, 0xCECECEFF, !"Вы не в банке");

	SPD(playerid, 20267, DIALOG_STYLE_LIST, "{FFCD00}Банковские операции", "\
					Список моих счетов\n\
					Открыть новый счет\n\
					{858585}Восстановление доступа к счету", "Выбрать","Отмена");
	return 1;
}
CMD:bank(playerid)
{
	player_BankMenu(playerid);
	return 1;
}
public: player_ShowBankCards(playerid)
{
	if(!Iter_Contains(Player, playerid)) return 1;
	player_ShowData[playerid][50] = -1;
	memset(player_ShowID[playerid], -1);
	str_1 = "{99CC00}Основной счет\n";
	new count = 1;
	for(new i, end = cache_num_rows(); i < end; i++)
	{
		static id;
		cache_get_int(i, !"ID", id);
		player_ShowID[playerid][count] = id;
		count++;
		str_2[0] = EOS, cache_get_string(i, !"Name", str_2);
		f(str_2, sizeof(str_2), "%s - №%i\n", str_2, id);
		strcat(str_1, str_2);
	}
	SPD(playerid, 20268, DIALOG_STYLE_LIST, "{FFCD00}Ваши счета", str_1, "Операции","Назад");
	return 1;
}
public: player_BankCardData(playerid)
{
	if(!Iter_Contains(Player, playerid)) return 1;
	new id = player_ShowData[playerid][50];
	if(id == -1) return SCM(playerid, -1, !"player_bankcard -> '321lda'");
	str_1[0] = EOS;
	cache_get_string(0, !"Name", str_1);

	static cash;
	cache_get_int(0, !"Cash", cash);

	f(str_1, sizeof(str_1), "\
						{FFFFFF}Номер счета:\t\t%i\n\
						Наименование:\t\'%s\'\n\
						Баланс:\t\t{00CC66}%i руб", id, str_1, cash);
	SPD(playerid, 20270, DIALOG_STYLE_MSGBOX, "{FFCD00}Информация", str_1, "Вернуться","");
	return 1;
}
stock player_ShowBankMenu(playerid, id)
{
	player_ShowData[playerid][50] = id;
	if(id == -1) return 0; //check is valid

	SPD(playerid, 20269, DIALOG_STYLE_LIST, "{0099FF}Список операций", "\
					1. Информация о счете\n\
					2. История операций\n\
					3. Снять деньги\n\
					4. Положить деньги\n\
					5. Перевести на другой счет\n\
					6. Переименовать счет\n\
					7. Изменить PIN-код\n\
					{C83F4F}8. Удалить счёт", "Выбрать","Назад");
	return 1;
}
stock player_ShowAtmMenu(playerid)
{
	SPD(playerid, 20281, DIALOG_STYLE_LIST, "{FFCD00}Основной счет", "\
		1. {FFFFFF}Снять с банковского счета\n\
		2. Положить на банковский счет\n\
		3. Баланс банковского счета\n\
