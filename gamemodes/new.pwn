CMD:b(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(IsModelHasBootAndBonnet(GetVehicleModel(vehicleid)))
	{
		if(!IsPlayerDriver(playerid)) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");
		SPD(playerid, 20248, DIALOG_STYLE_MSGBOX," ", "\t{CC9900}Управления авто", "Капот", "Багажник");
	}
	return 1;
}
CMD:i(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid)) return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

		new id = player_EnterBiz[playerid];
		if(id != -1)
		{
			if(BizStaticData[BizData[id][bType]][bsType] == 1)
			{
				player_FuelMenu_Open(playerid);
				return 1;
			}
		}
		SCM(playerid, 0xCECECEFF, !"Поблизости нет заправочных станций");
	}
	return 1;
}

CMD:alarm(playerid)
{
	new vehicleid = GetPlayerVehicleID(playerid);

	if(!IsABike(vehicleid))
	{
		if(!IsPlayerDriver(playerid))
			return SCM(playerid, 0xCECECEFF, !"Вы не за рулем");

		new alarm = (GetVehicleData(vehicleid, V_ALARM) ^ VEHICLE_PARAM_ON);
		SetVehicleData(vehicleid, V_ALARM, alarm);
	}
	return 1;
}
CMD:charity(playerid, params[])
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `NickName`, `charity` FROM `players` ORDER BY `charity` DESC LIMIT 25;");
	mysql_tquery(mysql, str_q, "player_ShowCharity", "i", playerid);
	return 1;
}
public: player_ShowCharity(playerid)
{
	str_1 = "Сумма\t\tИмя\n\n";
	for(new i, end = cache_num_rows(); i < end; i++) 
	{
		str_2[0] = EOS, cache_get_string(0, "NickName", str_2);
		static charity;
		cache_get_int(i, "charity", charity);
		strcat(str_1, (str_f("%i руб\t\t%s\n", charity, str_2)));
	}
	strcat(str_1, (str_f("\n{999999}Сумма Ваших пожертвований: %i руб", PI[playerid][pCharity])));
	SPD(playerid, 0, 0, "{00CC00}Топ 25 благотворителей", str_1, "Закрыть","");
	return 1;
}
CMD:time(playerid, params[])
{
	if(PI[playerid][pAdmin] > 0)
	{
		extract params -> new player:id; else return SCM(playerid, 0xCECECEFF, !"Используйте: /time [id игрока]");
		cmd_time(playerid, id);
		return 1;
	}
	else cmd_time(playerid, playerid);
	SCM(playerid, -1, !"Используйте {6699FF}/c 060 {FFFFFF}(служба точного времени)");
	return 1;
}
stock cmd_time(id, playerid)
{
	if(!IsPlayerConnected(playerid) || !IsPlayerLogged(playerid)) return SCM(playerid, -1, !"Такого игрока нет.");
	str_mes[0] = EOS;
	new count;
	if(GetPlayerData(playerid, pWarnTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до снятия предупреждения: %i дней", ((GetPlayerData(playerid, pWarnTime) - global_time) / 86400) + 1);
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(GetPlayerData(playerid, pMuteTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до разблокировки чата: %i:%02d", floatround(GetPlayerData(playerid, pMuteTime) / 60) /* % 60 */, (GetPlayerData(playerid, pMuteTime) % 60));
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(GetPlayerData(playerid, pRMuteTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до разблокировки report: %i:%02d", floatround(GetPlayerData(playerid, pRMuteTime) / 60) /* % 60 */, (GetPlayerData(playerid, pRMuteTime) % 60));
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(GetPlayerData(playerid, pVMuteTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до разблокировки report: %i:%02d", floatround(GetPlayerData(playerid, pVMuteTime) / 60) /* % 60 */, (GetPlayerData(playerid, pVMuteTime) % 60));
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(GetPlayerData(playerid, pVC_muteTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до разблокировки voice: %i:%02d", floatround(GetPlayerData(playerid, pVC_muteTime) / 60) /* % 60 */, (GetPlayerData(playerid, pVC_muteTime) % 60));
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(GetPlayerData(playerid, pJailTime) > 0)
	{
		format(str_mes, sizeof str_mes, "Время до конца заключения: %i:%02d", floatround(GetPlayerData(playerid, pJailTime) / 60) /* % 60 */, (GetPlayerData(playerid, pJailTime) % 60));
		SCM(id, 0x66CC00FF, str_mes);
		count++;
	}
	if(!count) SCM(playerid, -1, !"Используйте {6699FF}/c 060 {FFFFFF}(служба точного времени)");
	return 1;
}
CMD:msg(playerid, params[])
{
	if(!strlen(params))
		return SCM(playerid, 0xCECECEFF, !"Используйте: /msg [текст]");

	f(str_mes, sizeof str_mes, "Администратор %s: %s", PN(playerid), params);
	SendClientMessageToAll(0xFFCD00FF, str_mes);
	return 1;
}
alias:msg("o")
CMD:ans(playerid, params[])
{
	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /ans [id игрока] [текст]");
	extract params -> new to_player, string: message[144 + 1];
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xFF6600FF, !"Такого игрока нет");
	if(!strlen(message)) return SCM(playerid, 0x999999FF, !"Введите сообщение");
	f(str_mes, sizeof str_mes, "%s %s[%i] для %s[%i]: %s", GetPlayerAdminEx(playerid) > 1 ? "Администратор" : "Агент поддержки", PN(playerid), playerid, PN(to_player), to_player, message);
	SCM(to_player, 0xFF9945FF, str_mes);
	PlayerPlaySound(to_player, 1085, 0.0, 0.0, 0.0);
	SendAdminsMessage(0xFF9945FF, str_mes);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminAns_ForDay`=`adminAns_ForDay`+1, `adminAns`=`adminAns`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
alias:ans("pm")
