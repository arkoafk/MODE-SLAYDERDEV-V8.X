stock bool:IsPlayerLogged(playerid)
{
	if(playerid > MAX_PLAYERS-1 || playerid < 0) return false;
	return PI[playerid][pLogged];
}
stock player_DestroyRentVehicle(playerid)
{
	if(player_RentVehicle_ID[playerid] != -1) 
	{
		new next = player_RentVehicle_ID[playerid];
		DestroyVehicle(player_RentVehicle_ID[playerid], next, "scoter"), print("debug vehicle destroy 111");
	}
	player_RentVehicle_ID[playerid] = -1;
	player_RentVehicle_Timeout[playerid] = 0;
	Iter_Remove(PlayersRentVehicle, playerid);
	return 1;
}
stock player_DestroyVehicle(playerid)
{
	new vehicleid = player_TempVehicleID[playerid];
	if(vehicleid > 0)
	{
		//SCMf(playerid, -1, "%i, %i, %i", vehicleid, VehicleData[vehicleid][V_PLAYERID], playerid);
		if(VehicleData[vehicleid][V_PLAYERID] == playerid)
		{
			DestroyVehicle(vehicleid, vehicleid, "player car"), print("debug vehicle destroy 112");
			VehicleData[vehicleid][V_PLAYERID] = -1;
			player_TempVehicleID[playerid] = -1;
			if(player_DefaultJob_ID[playerid] == 3)
			{
				player_Pilot_Exit(playerid, true);
			}
		}
	}
}
stock player_Pilot_Exit(playerid, bool:delete=false)
{
	SetPlayerPosEx(playerid, 2777.0417,-2034.9119,22.0, 145.0, 0, 0);
	player_DefaultJob_Timer{playerid} = 0;
	player_DefaultJob_Progress[playerid][0] = -1;
	player_DutyDefaultJobs_Exit(playerid);
	player_DefaultJob_ID[playerid] = -1;
	player_DefaultJob_Type{playerid} = 0;
	PI[playerid][pTemp_Wage] = 0;
	SCM(playerid,-1, " ");
	SCM(playerid,866792362, "Вы закончили рабочий день.");
	if(!delete)
	{
		player_DestroyVehicle(playerid), print("debug vehicle destroy 113");
	}
	return 1;
}
stock player_CheckRentVehicle(playerid)
{
	if(player_RentVehicle_ID[playerid] != -1)
	{
		if(player_RentVehicle_Timeout[playerid] > 0) player_RentVehicle_Timeout[playerid]--;
		else
		{
			player_DestroyRentVehicle(playerid);
			//
			SCM(playerid, 0xE4BC43FF, !"Срок действия аренды скутера закончился.");
		}
	}
	return 1;
}
stock IsCheckRentVehicle(vehicleid)
{
	if(GetVehicleData(vehicleid, V_ACTION_TYPE) == 1)
	{
		foreach(new playerid: PlayersRentVehicle)
		{
			if(player_RentVehicle_ID[playerid] == vehicleid)
			{
				SCM(playerid, 0xE4BC43FF, !"Срок действия Вашего транспорта истёк или он был уничтожен.");
				player_DestroyRentVehicle(playerid);
				return 1;
			}
		}
	}
	return 1;
}
