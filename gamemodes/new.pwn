CMD:modellimit_set(playerid, get[])
{
	//if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new str; else return SCM(playerid, 0xCECECEFF, !"Используй: /modellimit_set [count]");
	new set;
	for(new i; i < sizeof(AddCarsData); i++) 
	{
		CountSale[i] += str;
		if(CountSale[i] > 20) CountSale[i] = 20, set++;
	}
	SaveModelLimit();
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] пополнил автосалоны [add: %i, set: %i, total: %i]", PN(playerid), playerid, str, set, sizeof(AddCarsData));
	SCMf(playerid,-1,"limit_set: добавлено %i, изменено %i, total %i", str, set, sizeof(AddCarsData));
	return 1;
}
stock SaveModelLimit()
{
	str_1[0] = EOS;
	for(new i; i < sizeof AddCarsData; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, CountSale[i]);
	mysql_tqueryf(mysql, "UPDATE `Config` SET `countsale` = '%s' WHERE 1;", str_1);
}
public: LoadConfig()
{
    str_2[0] = EOS, f(str_2, sizeof(str_2), "p<,>a<i>[%i]", sizeof(AddCarsData));
    str_1[0] = EOS, cache_get_string(0, "countsale", str_1), sscanf(str_1, str_2, CountSale);
	cache_get_int(0, "xpayday", xpayday);
	//cache_get_string(0, !"password", SERVER_PASSWORD);
	cache_get_int(0, "disableNalog", disableNalog);
    str_2[0] = EOS, f(str_2, sizeof(str_2), "p<,>a<i>[%i]", sizeof(ac_Name));
    str_1[0] = EOS, cache_get_string(0, "ac_config", str_1), sscanf(str_1, str_2, ac_Type);

    str_2[0] = EOS, f(str_2, sizeof(str_2), "p<,>a<i>[%i]", sizeof(fWalking));
    str_1[0] = EOS, cache_get_string(0, "fWalking", str_1), sscanf(str_1, str_2, fWalking_FamilyID);

	cache_get_int(0, "typeEvent", typeEvent);
	cache_get_int(0, "xdonate", xdonate);
	cache_get_string(0, "carsRang", str_1), sscanf(str_1, "p<,>a<i>[128]", team_CarRang);
	for(new i; i < sizeof(mafiaCarData); i++)
	{
		mafia_CarData[i] = AddStaticVehicleEx(mafiaCarData[i][fcModel], mafiaCarData[i][fcX], mafiaCarData[i][fcY], mafiaCarData[i][fcZ], mafiaCarData[i][fcA], mafiaCarData[i][fcColor_0], mafiaCarData[i][fcColor_1], 300);
		VehicleData[mafia_CarData[i]][V_ACTION_TYPE] = 3;
		VehicleData[mafia_CarData[i]][V_ACTION_ID] = fWalking_FamilyID[mafiaCarData[i][fcID]];
		OnVehicleSpawn(mafia_CarData[i]);
	}
	server_UpdateGang();
	server_UpdateHostname();
}
stock server_UpdateGang_Label()
{
	static const Float:position_Data[][] = {
		{1949.5757, 20.4882, 8.9148},
		{4052.6272, 3812.7136, 9.9047},
		{-3239.1474609375, 830.29071044922, 8.6700000762939},
		{2320.2651, 1539.7065, 12.1457}
	};
	for(new i; i < sizeof(position_Data); i++)
	{
		if(IsValidDynamic3DTextLabel(fWalking_Label[i]) || fWalking_Label[i] != Text3D:-1)
		{
			DestroyDynamic3DTextLabel(fWalking_Label[i]);
			fWalking_Label[i] = Text3D:-1;
		}

		str_mes = "-";
		if(fWalking_FamilyID[i] != -1)
		{
			f(str_mes, sizeof(str_mes), "%s", FamilyData[fWalking_FamilyID[i]][fName]);
		}
		fWalking_Label[i] = CreateDynamic3DTextLabel((str_f("%s\n{FFFFFF}Контролирует: {BBBBBB}%s", fWalking[i][fwName], str_mes)), 0xFF6600FF, position_Data[i][0], position_Data[i][1], position_Data[i][2], 7.0000);
	}
	return 1;
}
