	CreateInteractionMenu("[[7,\"Поговорить\"]]", 4007.9751, 3860.7585, 8.0706, 2.0, interMenu_CreateGang, 1);

	CreateDynamicActor(111, -3180.8489,825.0446,7.4200, 270.80157470703, true, 100.0);
	CreateDynamic3DTextLabel(!"{EBD34D}Западный особняк\n{ffffff}Создание банды", 0xff9500FF, -3180.8489,825.0446,7.4200, 9.0);
	CreateInteractionMenu("[[7,\"Поговорить\"]]", -3180.0666503906, 825.59918212891, 6.4273428916931, 2.0, interMenu_CreateGang, 2);

	CreateDynamicActor(111, 2346.4395, 1462.2736, 11.3581, 183.6544, true, 100.0);
	CreateDynamic3DTextLabel(!"{336699}База Пэла{FFFFFF}\nСоздание банды", 0xff9500FF, 2346.4395, 1462.2736, 12.4581, 9.0);
	CreateInteractionMenu("[[7,\"Поговорить\"]]", 2346.4395, 1462.2736, 11.3581, 2.0, interMenu_CreateGang, 3);
