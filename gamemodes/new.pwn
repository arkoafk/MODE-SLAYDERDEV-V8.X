	window.KEY_CODE_N = 78

	*/
	switch(keys)
	{
		case 80:
		{
			callcmd::phone(playerid);
		}
		case 67: //c
		{
			//"Machinist"
			if(player_DefaultJob_ID[playerid] == 2)
			{
				SPD(playerid, 20382, 0, "{FFCD00}Работа машиниста", "{FFFFFF}Вы хотите закончить работу машиниста?", "Да","Нет");
