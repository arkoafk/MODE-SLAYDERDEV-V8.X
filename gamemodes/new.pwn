stock UpdateVehicleHadlingEx(vehicleid, forplayerid = INVALID_PLAYER_ID)
{
	new Float:count = (Handling_VehicleData[vehicleid][E_MASS] +
		Handling_VehicleData[vehicleid][E_TURNMASS] +
		Handling_VehicleData[vehicleid][E_DRAGMULT] +
		Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][0] +
		Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][1] +
		Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][2] +
		Handling_VehicleData[vehicleid][E_PERCENT_SUBMERGED] +
		Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER] +
		Handling_VehicleData[vehicleid][E_DRIVE_TYPE] +
		Handling_VehicleData[vehicleid][E_ENGINE_TYPE] +
		Handling_VehicleData[vehicleid][E_NUMBER_OF_GEARS] +
		Handling_VehicleData[vehicleid][E_TRANSIMISSION_HANDLING_FLAGS] +
		Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] +
		Handling_VehicleData[vehicleid][E_ENGINE_INERT] +
		Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] +
		Handling_VehicleData[vehicleid][E_BRAKE_DECELERATION] +
		Handling_VehicleData[vehicleid][E_BRAKE_BIAS] +
		Handling_VehicleData[vehicleid][E_STEERING_LOCK] +
		Handling_VehicleData[vehicleid][E_TRACTION_LOSS] +
		Handling_VehicleData[vehicleid][E_TRACTION_BIAS] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_FORCE_LEVEL] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_DAMPING_LEVEL] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_HIGH] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_UPPER] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_LOWER] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_BIAS] +
		Handling_VehicleData[vehicleid][E_SUSPENSION_ANTI_DRIVE] +
		Handling_VehicleData[vehicleid][E_COLLISION_DAMAGE] +
		Handling_VehicleData[vehicleid][E_MODEL_FLAGS] +
		Handling_VehicleData[vehicleid][E_HANDLING_FLAGS] +
		Handling_VehicleData[vehicleid][E_SEAT_OFFSET] +
		Handling_VehicleData[vehicleid][E_MONETARY_VALUE] +
		Handling_VehicleData[vehicleid][E_FRONT_LIGHTS] +
		Handling_VehicleData[vehicleid][E_REAR_LIGHTS] +
		Handling_VehicleData[vehicleid][E_ANIM_GROUP]);
	if(count != 0.0) 
	{
		UpdateVehicleHadling(vehicleid, forplayerid);
	}
}
public OnVehicleStreamOut(vehicleid, forplayerid)
{
	//UpdateVehicleNumber(vehicleid, forplayerid, true, true);
	for(new i; i < 12; i++)
	{
		if(VehicleData[vehicleid][vTuning][i] > 0) 
		{
			RemoveVehicleTuningEx(vehicleid, TuningStaticData[ VehicleData[vehicleid][vTuning][i] ][gtObjectID], forplayerid);
		}
	}
	if(player_StrobSees[forplayerid][vehicleid] != false && VehicleData[vehicleid][vStrob] != false)
	{
		f(str_2, sizeof str_2, "delStroboscopes(\"[[%i],[%i]]\")", vehicleid, vehicleid + 1000);
		ExecutePacket(forplayerid, webUpdate, str_2);
	}
	OnVehicleHornSound_Disable(vehicleid, forplayerid);
	return 1;
}
