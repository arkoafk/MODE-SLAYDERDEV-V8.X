CMD:pa_edit(playerid)
{
	if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) return SCM(playerid, -1, "Вы уже начали установку украшения!");
	OpenInterface[playerid][7] = false;
	OnPlayerInventory(playerid, 0);
	new uid = player_HouseEntered[playerid];
	if(uid != -1)
	{
		if(GetString(HouseData[uid][hOwner], PN(playerid)))
		{
			return player_House_MenuObject(playerid, uid);
		}
	}
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(!GetString(HouseData[i][hOwner], PN(playerid)) || !IsPlayerInRangeOfPoint(playerid, 6.0, HouseData[i][hEnter][0], HouseData[i][hEnter][1], HouseData[i][hEnter][2])) continue;
		return player_House_MenuObject(playerid, i);
	}

	uid = player_BizEntered[playerid];
	if(uid != -1)
	{
		if(GetString(BizData[uid][bOwner], PN(playerid)))
		{
			return player_Business_MenuObject(playerid, uid);
		}
	}
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(!GetString(BizData[i][bOwner], PN(playerid)) || !IsPlayerInRangeOfPoint(playerid, 6.0, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2])) continue;
		return player_Business_MenuObject(playerid, i);
	}
	SCM(playerid,-825307393, "* Вы не находитесь возле своего дома или бизнеса");
	return 1;
}
stock player_House_MenuObject(playerid, id)
{
	str_1[0] = EOS;
	new count;
	for(new i; i < 10; i++)
	{
		new item = IsValidAcsProperty(HouseData[id][hObject_Model][i]);
		if(item == -1) continue;
		strcat(str_1, (str_f("%i. %s\t%.2f\n", count+1, PropertyAcsData[item][accName], GetPlayerDistanceFromPoint(playerid, HouseData[id][hObject_Position_X][i], HouseData[id][hObject_Position_Y][i], HouseData[id][hObject_Position_Z][i]))));
		player_ShowData[playerid][count] = i;
		count++;
	}
	player_ShowUID[playerid][77] = 20376;
	player_ShowUID[playerid][76] = id;
	if(!count) SCM(playerid, -1, !"Ничего нет");
	else SPD(playerid, 20376, DIALOG_STYLE_LIST, (str_f("Украшения дома №%i", id)), str_1, "Далее", "Закрыть");
	return 1;
}
stock player_Business_MenuObject(playerid, id)
{
	str_1[0] = EOS;
	new count;
	for(new i; i < 10; i++)
	{
		new item = IsValidAcsProperty(BizData[id][bObject_Model][i]);
		if(item == -1) continue;
		strcat(str_1, (str_f("%i. %s\t%.2f\n", count+1, PropertyAcsData[item][accName], GetPlayerDistanceFromPoint(playerid, BizData[id][bObject_Position_X][i], BizData[id][bObject_Position_Y][i], BizData[id][bObject_Position_Z][i]))));
		player_ShowData[playerid][count] = i;
		count++;
	}
	player_ShowUID[playerid][77] = 20377;
	player_ShowUID[playerid][76] = id;
	if(!count) SCM(playerid, -1, !"Ничего нет");
	else SPD(playerid, 20376, DIALOG_STYLE_LIST, (str_f("Украшения бизнеса №%i", id)), str_1, "Далее", "Закрыть");
	return 1;
}
CMD:offban(playerid, get[])
{
	extract get -> new string:name[24], days, string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /offban [name] [срок в дняй] [причина]");
	if(NameIsFullDostup(name)) return SCM(playerid, COLOR_RED, "С данным игроком нельзя взаимодействовать!");
	if(IsPlayerConnected(GetPlayerID(name))) return SCM(playerid, 0x999999FF, "Игрок с таким именем находится на сервере");
	new max_days = PI[playerid][pAdmin] > 6 ? 365 : 30;
	if(!(1 <= days <= max_days)) return SCMf(playerid, 0xCECECEFF, "Срок бана может быть от 1 до %i дней", max_days);
	new data = GetName_Admin(name);
	if(data == -1) return SCM(playerid, 0x999999FF, "Игрок с таким именем не зарегистрирован!");
	if(PI[playerid][pAdmin] < data) return SCM(playerid, 0x999999FF, "Нельзя взаимодействовать с администратором выше по рангу.");
	
	//check ban
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT COUNT(*) AS CountBan FROM `Ban_List` WHERE `Owner` = '%s' LIMIT 1;", name);
	new 
		Cache:result = mysql_query(mysql, str_q),
		count;
	cache_get_int(0, "CountBan", count);
	cache_delete(result);
	if(!count) 
	{
		player_addAList(name, "Бан", PN(playerid), reason);
		AddBan_List(name, PN(playerid), reason, days);
		SCMAllf(-11521793, "Администратор %s забанил оффлайн игрока %s на %d дней. Причина: %s", PN(playerid), name, days, reason);
	}
	else SCM(playerid, 0x999999FF, "Аккаунт игрока уже заблокирован");
	return 1;
}
CMD:offwarn(playerid, get[])
{
	extract get -> new string:name[24], string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /offwarn [name] [причина]");
	if(NameIsFullDostup(name)) return SCM(playerid, COLOR_RED, "С данным игроком нельзя взаимодействовать!");
	if(IsPlayerConnected(GetPlayerID(name))) return SCM(playerid, 0x999999FF, "Игрок с таким именем находится на сервере");
	new data = GetName_Admin(name);
	if(data == -1) return SCM(playerid, 0x999999FF, "Игрок с таким именем не зарегистрирован!");
	if(PI[playerid][pAdmin] < data) return SCM(playerid, 0x999999FF, "Нельзя взаимодействовать с администратором выше по рангу.");
	
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Warn` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", name);
	new 
		Cache:result = mysql_query(mysql, str_q),
		warn;
	cache_get_int(0, "Warn", warn);
	cache_delete(result);
	if(warn > 2) SCM(playerid, 0x999999FF, "Аккаунт игрока уже имеет максимально предупреждений");
	else
	{
		if(warn > 1)
		{
			AddBan_List(name, PN(playerid), "warn 3/3", 10);
		}
		mysql_tqueryf(mysql, "UPDATE `players` SET `Warn`=`Warn`+1, `WarnTime` = '%i', `Member_ID` = '0' WHERE `NickName` = '%s' LIMIT 1;", global_time + (86400 * 3), name);
		SCMAllf(-11521793, "Администратор %s оффлайн выдал предупреждение игроку %s [%i|3]. Причина: %s", PN(playerid), name, warn+1, reason);
	}
	player_addAList(name, "Предупреждение", PN(playerid), reason);
	return 1;
}
stock GetName_Admin(const name[])
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin` FROM `players` WHERE `NickName` = '%s' LIMIT 1;", name);
	new 
		Cache:result = mysql_query(mysql, str_q),
		admin;
	if(cache_num_rows()) cache_get_int(0, "Admin", admin);
	else admin = -1;
	cache_delete(result);
	return admin;
}
CMD:offmute(playerid, get[])
{
	extract get -> new string:name[24], minute, string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /offmute [name] [минут] [причина]");
	if(NameIsFullDostup(name)) return SCM(playerid, COLOR_RED, "С данным игроком нельзя взаимодействовать!");
	if(IsPlayerConnected(GetPlayerID(name))) return SCM(playerid, 0x999999FF, "Игрок с таким именем находится на сервере");
	new data = GetName_Admin(name);
	if(data == -1) return SCM(playerid, 0x999999FF, "Игрок с таким именем не зарегистрирован!");
	if(PI[playerid][pAdmin] < data) return SCM(playerid, 0x999999FF, "Нельзя взаимодействовать с администратором выше по рангу.");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 120;
	if(!(1 <= minute <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от 1 до %i минут", max_minute);
	mysql_tqueryf(mysql, "UPDATE `players` SET `MuteTime`=`MuteTime`+%i WHERE `NickName` = '%s' LIMIT 1;", minute*60, name);
	SCMAllf(-11521793, "Администратор %s оффлайн выдал мут игроку %s на %i минут. Причина: %s", PN(playerid), name, minute, reason);
	player_addAList(name, "Мут", PN(playerid), reason);
	return 1;
}
CMD:offjail(playerid, get[])
{
	extract get -> new string:name[24], minute, string:reason[24]; else return SCM(playerid, 0xCECECEFF, "Используйте: /offjail [name] [минут] [причина]");
	if(NameIsFullDostup(name)) return SCM(playerid, COLOR_RED, "С данным игроком нельзя взаимодействовать!");
	if(IsPlayerConnected(GetPlayerID(name))) return SCM(playerid, 0x999999FF, "Игрок с таким именем находится на сервере");
	new data = GetName_Admin(name);
	if(data == -1) return SCM(playerid, 0x999999FF, "Игрок с таким именем не зарегистрирован!");
	if(PI[playerid][pAdmin] < data) return SCM(playerid, 0x999999FF, "Нельзя взаимодействовать с администратором выше по рангу.");
	new max_minute = (PI[playerid][pAdmin] > 6 ? 10000 : 120);
	if(!(-max_minute <= minute <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от %i до %i минут", -max_minute, max_minute);
	mysql_tqueryf(mysql, "UPDATE `players` SET `JailTime`=`JailTime`+%i WHERE `NickName` = '%s' LIMIT 1;", minute*60, name);
	SCMAllf(-11521793, "Администратор %s оффлайн посадил игрока %s на %i минут. Причина: %s", PN(playerid), name, minute, reason);
	player_addAList(name, "Тюрьма", PN(playerid), reason);
	return 1;
}
public: player_LoadCarsShop(playerid, type)
{
	new count,
		bool:countEx,
		load;
	str_2[0] = EOS;
	for(new i; i < sizeof(AddCarsData); i++)
	{
		if(AddCarsData[i][acType] == type)
		{
			load++;
			if(load >= 4)
			{
				if(!countEx) countEx = true;
				else strcat(str_2, ",");
				GetCarsShopData(i);
				count++;
				if(count == 14) 
				{
					print(str_2);
					ExecutePacket(playerid, webUpdate, (str_f("interface('CarsShop').addCars('[%s]')", str_2)));
					count = 0;
					countEx = false;
					str_2[0] = EOS;
				}
			}
		}
	}
	if(count > 0)
	{
		ExecutePacket(playerid, webUpdate, (str_f("interface('CarsShop').addCars('[%s]')", str_2)));
		count = 0;
		countEx = false;
		str_2[0] = EOS;
	}
}
stock GetCarsShopData(i)
{
	str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,\"%s\",%i,%i,%i,%i,%i,%i,%.2f,%i,%i,%i]", \
		AddCarsData[i][acModel], AddCarsData[i][acName], AddCarsData[i][acCost]*2, 
		AddCarsData[i][acRentCost], AddCarsData[i][acF_Type], AddCarsData[i][acP_2], AddCarsData[i][acP_3],
		AddCarsData[i][acP_4], AddCarsData[i][acP_5], AddCarsData[i][acP_6], AddCarsData[i][acP_7],
		AddCarsData[i][acP_8]);
	strcat(str_2, str_1);
}
stock CarsShop_Add()
{
	if(random(100) > 50)
	{
		new set;
		for(new i; i < sizeof(AddCarsData); i++) 
		{
			if(!CountSale[i])
			{
				if(random(100) > 50)
				{
					CountSale[i] = 2;
					set++;
				}
			}
		}
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "\
			[Информация] {FFFFFF}В автосалоны были пополнены {c7dae8}%i новых моделей {FFFFFF}автомобилей, на различные позиции.", set);
		SCMAll(0xc7dae8FF, str_mes);
		SaveModelLimit();
	}
}
CMD:auction(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid, 50.0, -137.63192749023, 2426.0209960938, 1001.140625)) return SCM(playerid,-2127958, "Вы должны находиться в здании аукциона.");
	cmd_auction(playerid);
	return 1;
}
CMD:exchange_chip(playerid)
{
	if(!IsPlayerInRangeOfPoint(playerid, 50.0, -137.63192749023, 2426.0209960938, 1001.140625)) return SCM(playerid,-2127958, "Вы должны находиться в здании аукциона.");
	player_CasinoExchange_Open(playerid);
	return 1;
}
stock cmd_auction(playerid)
{
	if(OpenInterface[playerid][100]) return 1;
	SCM(playerid, -1, "Результаты аукциона будут выдвинуты перед массовым слета имущества.");
	OpenInterface[playerid][100] = true;
	player_AuctionType{playerid} = 0;
	player_AuctionPage{playerid} = 0;
	player_AuctionFilter{playerid} = 0;
	GetAuctionData(playerid);
	ExecutePacket(playerid, webOpen, "Auction", str_2);
	return 1;
}
stock GetAuctionData(playerid)
{
	str_2[0] = EOS, str_1[0] = EOS, str_while[0] = EOS;
	new 
		type = player_AuctionType{playerid},
		page = player_AuctionPage{playerid},
		bool:count,
		iteration,
		next = page*4,
		con_tinue,
		count_chip = GetInvCount(playerid, 293);
	switch(type)
	{
		case 0: //house
		{
			for(new i; i < TOTAL_HOUSES; i++)
			{
				if(!GetString(HouseData[i][hOwner], "Sell Nalog")) continue;
				con_tinue++;
				if(next < con_tinue)
				{
					str_while[iteration] = i;
					iteration++;
					if(iteration == 4)
					{
						break;
					}
				}
			}
			for(new j; j < iteration; j++)
			{
				new i = str_while[j];
				if(!count) count = true;
				else strcat(str_2, ",");
				new data;
				if(GetString(HouseData[i][hAuction_Owner], PN(playerid))) data = HouseData[i][hAuction_Bet];
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Жильё\",\"%s №%i\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, type, (HouseData[i][hEntrance_ID] == -1 ? "Дом" : "Квартира"), i, HouseData[i][hAuction_Bet], count_chip, data, HouseData[i][hAuction_Bet]+15);
				strcat(str_2, str_1);
			}
		}
		case 1: //biz
		{
			for(new i; i < TOTAL_BUSINESSES; i++)
			{
				if(!GetString(BizData[i][bOwner], "Sell Nalog")) continue;
				con_tinue++;
				if(next < con_tinue)
				{
					str_while[iteration] = i;
					iteration++;
					if(iteration == 4)
					{
						break;
					}
				}
			}
			for(new j; j < iteration; j++)
			{
				new i = str_while[j];
				if(!count) count = true;
				else strcat(str_2, ",");
				new data;
				if(GetString(BizData[i][bAuction_Owner], PN(playerid))) data = BizData[i][bAuction_Bet];
				str_d[0] = EOS, GetBusinessName(i, str_d);
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Бизнес\",\"%s (№%i)\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, type, str_d, i, BizData[i][bAuction_Bet], count_chip, data, BizData[i][bAuction_Bet]+15);
				strcat(str_2, str_1);
			}
		}
		case 2: //garage
		{
			for(new i; i < TOTAL_GARAGES; i++)
			{
				if(!GetString(GarageData[i][gOwner], "Sell Nalog")) continue;
				con_tinue++;
				if(next < con_tinue)
				{
					str_while[iteration] = i;
					iteration++;
					if(iteration == 4)
					{
						break;
					}
				}
			}
			for(new j; j < iteration; j++)
			{
				new i = str_while[j];
				if(!count) count = true;
				else strcat(str_2, ",");
				new data;
				if(GetString(GarageData[i][gAuction_Owner], PN(playerid))) data = GarageData[i][gAuction_Bet];
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Имущество\",\"Гараж №%i\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, type, i, GarageData[i][gAuction_Bet], count_chip, data, GarageData[i][gAuction_Bet]+15);
				strcat(str_2, str_1);
			}
		}
	}
	f(str_2, sizeof(str_2), "[[%s],1]", str_2);
	ExecutePacket(playerid, webUpdate, (str_f("interface('Auction').setPage('%i')", page+1)));
}
stock player_Auction_Action(playerid, type, item)
{
	switch(type)
	{
		case 1: //
		{
			player_AuctionPage{playerid} += (!item ? -1 : 1);
			if(player_AuctionFilter{playerid} == 1) player_Auction_MyBet(playerid);
			else player_Auction_Update(playerid);
		}
		case 2:
		{
			player_AuctionFilter{playerid} = item;
			switch(item)
			{
				case 0: //дефолт
				{

				}
				case 1: //ваши ставки
				{
					player_Auction_MyBet(playerid);
				}
				case 2: //горящие лоты
				{
					player_Auction_HotBet(playerid);
				}
			}
		}
		case 4: //
		{
			player_AuctionType{playerid} = item;
			player_AuctionPage{playerid} = 0;
			player_Auction_Update(playerid);
		}
	}
	return 1;
}
stock player_Auction_HotBet(playerid)
{
	#pragma unused playerid
}
stock player_Auction_MyBet(playerid)
{
	new 
		page = player_AuctionPage{playerid},
		bool:count,
		iteration,
		next = page*4,
		con_tinue,
		count_chip = GetInvCount(playerid, 293);
	str_2[0] = EOS;
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(!GetString(HouseData[i][hAuction_Owner], PN(playerid)) || !GetString(HouseData[i][hOwner], "Sell Nalog")) continue;
		con_tinue++;
		if(next < con_tinue)
		{
			str_while[iteration] = i;
			iteration++;
			if(iteration == 4)
			{
				break;
			}
		}
	}
	for(new j; j < iteration; j++)
	{
		new i = str_while[j];
		if(!count) count = true;
		else strcat(str_2, ",");
		new data;
		if(GetString(HouseData[i][hAuction_Owner], PN(playerid))) data = HouseData[i][hAuction_Bet];
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Жильё\",\"%s №%i\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, 0, (HouseData[i][hEntrance_ID] == -1 ? "Дом" : "Квартира"), i, HouseData[i][hAuction_Bet], count_chip, data, HouseData[i][hAuction_Bet]+15);
		strcat(str_2, str_1);
	}
	con_tinue = 0;
	iteration = 0;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(!GetString(BizData[i][bAuction_Owner], PN(playerid)) || !GetString(BizData[i][bOwner], "Sell Nalog")) continue;
		con_tinue++;
		if(next < con_tinue)
		{
			str_while[iteration] = i;
			iteration++;
			if(iteration == 4)
			{
				break;
			}
		}
	}
	for(new j; j < iteration; j++)
	{
		new i = str_while[j];
		if(!count) count = true;
		else strcat(str_2, ",");
		new data;
		if(GetString(BizData[i][bAuction_Owner], PN(playerid))) data = BizData[i][bAuction_Bet];
		str_d[0] = EOS, GetBusinessName(i, str_d);
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Бизнес\",\"%s\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, 1, str_d, BizData[i][bAuction_Bet], count_chip, data, BizData[i][bAuction_Bet]+15);
		strcat(str_2, str_1);
	}
	//
	con_tinue = 0;
	iteration = 0;
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(!GetString(GarageData[i][gAuction_Owner], PN(playerid)) || !GetString(GarageData[i][gOwner], "Sell Nalog")) continue;
		con_tinue++;
		if(next < con_tinue)
		{
			str_while[iteration] = i;
			iteration++;
			if(iteration == 4)
			{
				break;
			}
		}
	}
	for(new j; j < iteration; j++)
	{
		new i = str_while[j];
		if(!count) count = true;
		else strcat(str_2, ",");
		new data;
		if(GetString(GarageData[i][gAuction_Owner], PN(playerid))) data = GarageData[i][gAuction_Bet];
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[%i,%i,\"Имущество\",\"Гараж №%i\",\"ГОСУДАРСТВО\",%i,%i,%i,[\"-\", \"5\", \"-\"],0,%i]", i, 2, i, GarageData[i][gAuction_Bet], count_chip, data, GarageData[i][gAuction_Bet]+15);
		strcat(str_2, str_1);
	}
	f(str_2, sizeof(str_2), "[[%s],1]", str_2);
	ExecutePacket(playerid, webUpdate, (str_f("interface('Auction').setLots('%s')", str_2)));
	ExecutePacket(playerid, webUpdate, (str_f("interface('Auction').setPage('%i')", page+1)));
}
stock player_Auction_Update(playerid)
{
	str_2[0] = EOS;
	GetAuctionData(playerid);
	ExecutePacket(playerid, webUpdate, (str_f("interface('Auction').setLots('%s')", str_2)));
}
stock player_Auction_Close(playerid)
{
	OpenInterface[playerid][100] = false;
	return 1;
}
stock player_Auction_SetBet(playerid, id, count)
{
	//SCMf(playerid, -1, "player_Auction_SetBet(%i,%i,%i)", playerid, id, count);
	player_ShowUID[playerid][88] = id;
	player_ShowUID[playerid][89] = count;
	SPD(playerid, 20379, 0, "Аукцион", (str_f("\n\
			Вы действительно хотите поставить %i фишек?\n\
			Ваша ставка будет %i фишек", count, count)), "Да", "Нет");
	return 1;
}
stock player_Auction_CreateBet(playerid)
{
	#pragma unused playerid
	//SCMf(playerid, -1, "player_Auction_CreateBet(%i)", playerid);
	return 1;
}
