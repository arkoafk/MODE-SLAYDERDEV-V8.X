CMD:kick(playerid, params[])
{
	//if(GetPlayerAdminEx(playerid) < 2) return 1;

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /kick [id игрока] [причина (необязательно)]");

	extract params -> new to_player;

	if(!IsPlayerConnected(to_player)) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя кикнуть администратора выше по рангу");

	static reason[31];
	sscanf(params, "{d}s[30]", reason);

	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s кикнул игрока %s", PN(playerid), PN(to_player));

	if(strlen(reason) > 0)
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	format(str_mes, sizeof str_mes, "Кикнул %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);
	new	year, month, day;

	getdate(year, month, day);

	str_1[0] = EOS, f(
	    str_1,
	    sizeof(str_1),
	    "Дата: %i %s %i г.\n\
		Ваш ник: %s\n\
	    Ник администратора: %s\n\
	    Причина: %s\n\n\
	    Если Вы не согласны с наказанием, сделайте скриншот (F8)\n\
	    И оставьте жалобу на форуме "FORUM_SERVER"\n\
	    ",
   		day,
		GetMonthName(month),
		year,
		PN(to_player),
		PN(playerid),
		reason
	);
	SPD(to_player, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX, "{FF6600}Отключение от сервера", str_1, "Закрыть", "");
	//mysql_pqueryf(mysql, "INSERT INTO alogs (acc_id,type,name_adm,time,reason) VALUES (%i,'%s','%s',%i,'%s')", GetPlayerAccountID(to_player), "Кик", PN(playerid), global_time, reason);
	Kick(to_player);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminKick_ForDay`=`adminKick_ForDay`+1, `adminKick`=`adminKick`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}

CMD:skick(playerid, params[])
{
	//if(CheckAdmin(playerid, 3)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /skick [id игрока]");

	if(!IsPlayerConnected(to_player)) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	else if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя кикнуть администратора выше по рангу");

	str_mes[0] = EOS; ////new128];

	format(str_mes, sizeof str_mes, "[A] %s[%i] кикнул %s[%i] без лишнего шума", PN(playerid), playerid, PN(to_player), to_player);
	SendAdminsMessage(0x999999FF, str_mes);

	format(str_mes, sizeof str_mes, "Без шума кикнул %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	Kick(to_player);
	return 1;
}
CMD:report(playerid, const get[]) 
{
	if(!strlen(get)) 
	{
		SCM(playerid,-825307393, "Используйте: /report [текст (вопроса/жалобы)]");
		ShowPlayerReportSPD(playerid);
	}
	else player_ReportInput(playerid, get);
	return 1;
}
stock player_ReportInput(playerid, const input[])
{
	new len = strlen(input);
	if(3 <= len <= 80)
	{
		if(GetPVarInt(playerid,!"antiflood_rep") > global_time) return SCM(playerid,-1,!"Отправлять сообщение можно раз в 30 секунд");
		SetPVarInt(playerid,"antiflood_rep",global_time+30);
		SetString(player_InputData[playerid], input);
		SPD(playerid, 20363, DIALOG_STYLE_LIST, "{FFCD00}Выберите тип запроса", "1. Жалоба на игрока<n>2. Задать вопрос", "Отправить","Назад");
		return 1;
	}
	else if(len > 80)
	{
		SCM(playerid, 0x999999FF, !"Слишком длинное сообщение");
	}
	ShowPlayerReportSPD(playerid);
	return 1;
}
cmd:faq(playerid){
	if(OpenInterface[playerid][13]) return 1;
	OpenInterface[playerid][13] = true;
    ExecutePacket(playerid, webUpdate, "interface('Report').loadPopularity('[[\"Как открыть меню сервера?\", \"Для того чтобы открыть меню сервера используйте команду /menu или более сокращенный вариант /mn\", \"\"],[\"Где можно купить транспорт?\", \"Купить транспорт можно в автосалоне (ищите в /gps), или купить с рук у другого игрока на рынке\", \"\"],[\"Как найти ближайший банкомат?\", \"Для того чтобы найти ближайший банкомат используйте команду (/gps > найти ближайший банкомат)\", \"\"],[\"Когда проводятся мероприятия?\", \"Мероприятия проводятся после 21:00 по МСК времени.\", \"\"],[\"Как показать паспорт?\", \"Чтобы показать паспорт введите /pass <ID игрока>\", \"\"]]')");
    ExecutePacket(playerid, webOpen, "Report");
	return 1;
}
public:OnPlayerClosedTicketInterface(playerid){
	if(!OpenInterface[playerid][13]) return 1;
	OpenInterface[playerid][13] = false;
    ExecutePacket(playerid, webUpdate, "interface('Report').setChatData('[]')");
    ExecutePacket(playerid, webUpdate, "interface('Report').loadAppeals('[]')");
    ExecutePacket(playerid, webUpdate, "interface('Report').loadChatMessages('[]')");
	return 1;
}
CMD:mute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /mute [id игрока] [время в минутах] [причина (необязательно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 120;
	if(!(1 <= mute_time <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от 1 до %i минут", max_minute);
	if(GetPlayerData(to_player, pMuteTime) > 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока уже есть мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя поставить затычку администратору выше по рангу");
	//else if(to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Нельзя поставить затычку самому себе");

	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s поставил затычку игроку %s на %i мин", PN(playerid), PN(to_player), mute_time);

	if(strlen(reason))
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pMuteTime, mute_time * 60);
	UpdatePlayerDataInt(to_player, "MuteTime", mute_time * 60);

	SCM(to_player, 0xCECECEFF, !"Время до окончания бана чата: {CCCC00}/time");

	format(str_mes, sizeof str_mes, "Выдал %s[acc:%i] блокировку чата на %i мин. Причина: %s", PN(to_player), GetPlayerAccountID(to_player), mute_time, reason);
	player_addAList(PN(to_player), "Мут", PN(playerid), reason);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminMute_ForDay`=`adminMute_ForDay`+1, `adminMute`=`adminMute`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:rmute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	if(!strlen(params)) return SCM(playerid, 0xCECECEFF, !"Используйте: /rmute [id игрока] [время в минутах] [причина (необязательно)]");

	extract params -> new to_player, mute_time, string: reason[30];

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 120;
	if(!(1 <= mute_time <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок мута может быть от 1 до %i минут", max_minute);
	if(GetPlayerData(to_player, pRMuteTime) > 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока уже есть мут");
	if(GetPlayerAdminEx(to_player) > GetPlayerAdminEx(playerid)) return SCM(playerid, 0xCECECEFF, !"Нельзя поставить затычку администратору выше по рангу");
	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s заблокировал репорт игроку %s на %i мин", PN(playerid), PN(to_player), mute_time);

	if(strlen(reason))
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pRMuteTime, mute_time * 60);
	UpdatePlayerDataInt(to_player, "RMuteTime", mute_time * 60);

	SCM(to_player, 0xCECECEFF, !"Время до окончания бана репорта: {CCCC00}/time");
	player_addAList(PN(to_player), "Мут репорта", PN(playerid), reason);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminMute_ForDay`=`adminMute_ForDay`+1, `adminMute`=`adminMute`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	return 1;
}
CMD:unmute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /unmute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	else if(GetPlayerData(to_player, pMuteTime) <= 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока нет мута");
	//else if(to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Нельзя снять затычку с самого себя");

	str_mes[0] = EOS; ////new80];
	format(str_mes, sizeof str_mes, "Администратор %s снял затычку с игрока %s", PN(playerid), PN(to_player));
	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pMuteTime, 0);
	UpdatePlayerDataInt(to_player, "MuteTime", 0);

	SCM(to_player, 0x66CC00FF, "Доступ в чат восстановлен");

	format(str_mes, sizeof str_mes, "Снял блокировку чата у %s[acc:%i]", PN(to_player), GetPlayerAccountID(to_player));
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}
CMD:unrmute(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /unmute [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	else if(GetPlayerData(to_player, pRMuteTime) <= 0) return SCM(playerid, 0xCECECEFF, !"У этого игрока нет мута репорта");
	//else if(to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Нельзя снять затычку с самого себя");

	str_mes[0] = EOS; ////new80];
	format(str_mes, sizeof str_mes, "Администратор %s снял блокировку репорта игроку %s", PN(playerid), PN(to_player));
	SendClientMessageToAll(-11521793, str_mes);

	SetPlayerData(to_player, pRMuteTime, 0);
	UpdatePlayerDataInt(to_player, "RMuteTime", 0);

	SCM(to_player, 0x66CC00FF, "Доступ в чат восстановлен");
	return 1;
}

CMD:jail(playerid, params[])
{
	//if(CheckAdmin(playerid, 2)) return 1;
	extract params -> new player:to_player, jail_time, string: reason[30]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /jail [id игрока] [время в минутах] [причина (необязательно)]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	new max_minute = PI[playerid][pAdmin] > 6 ? 10000 : 180;
	if(!(1 <= jail_time <= max_minute)) return SCMf(playerid, 0xCECECEFF, "Срок джайла может быть от 1 до %i минут", max_minute);
	if(GetPlayerData(to_player, pJailTime) > 0) return SCM(playerid, 0xCECECEFF, !"Этот игрок уже сидит в тюрьме");
	str_mes[0] = EOS; ////new128];
	format(str_mes, sizeof str_mes, "Администратор %s посадил в деморган игрока %s на %i мин", PN(playerid), PN(to_player), jail_time);

	if(strlen(reason))
		format(str_mes, sizeof str_mes, "%s. Причина: %s", str_mes, reason);

	SendClientMessageToAll(-11521793, str_mes);

	SCM(to_player, 0xCECECEFF, !"Время до окончания заключения: {CCCC00}/time");
	JailPlayer(to_player, jail_time*60, false);

	str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `adminJail_ForDay`=`adminJail_ForDay`+1, `adminJail`=`adminJail`+1 WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pID]);
	mysql_tquery(mysql, str_q);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);
	player_addAList(PN(to_player), "Тюрьма", PN(playerid), reason);
	return 1;
}

CMD:unjail(playerid, params[])
{
	//if(CheckAdmin(playerid, 3)) return 1;

	extract params -> new to_player; else return SCM(playerid, 0xCECECEFF, !"Используйте: /unjail [id игрока]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	else if(GetPlayerData(to_player, pJailTime) <= 0) return SCM(playerid, 0xCECECEFF, !"Этот игрок не сидит в деморгане");
	//else if(to_player == playerid) return SCM(playerid, 0xCECECEFF, !"Нельзя снять затычку с самого себя");

	str_mes[0] = EOS; ////new80];
	format(str_mes, sizeof str_mes, "Администратор %s выпустил из деморгана игрока %s", PN(playerid), PN(to_player));
	SendClientMessageToAll(-11521793, str_mes);

	SCM(to_player, 0x66CC00FF, "Вы были выпущены на свободу");

	UnjailPlayer(to_player);
	return 1;
}
CMD:alock(playerid, params[])
{
	extract params -> new vehicleid; else return SCM(playerid, -1, !"Используйте: /alock [id транспорта]");
	if(!IsValidVehicle(vehicleid)) return SCM(playerid, 0xFF6600FF, !"Данного транспорта не существует на сервере");
	new status = GetVehicleParam(vehicleid, V_LOCK);
	SetVehicleParam(vehicleid, V_LOCK, status ^ VEHICLE_PARAM_ON);
	return 1;
}
CMD:setskin(playerid, params[])
{
	extract params -> new to_player, skin_id; else return SCM(playerid, COLOR_GREY, "Используйте: /setskin [ID игрока] [ID скина]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player)) return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");
	if(!IsValidSkin(skin_id)) return SCM(playerid, 0xCECECEFF, !"Неверный ID скина.");
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Админ %s изменил скин на %i, игроку %s[playerid:%i]", str_log, skin_id, PN(to_player), to_player);
	SendLog(1, str_log);
    SetPlayerSkinEx(to_player, skin_id);
	SCMf(to_player, -1, "Администратор %s выдал Вам постоянный скин №%i", PN(playerid), skin_id);
	str_1[0] = EOS, f(str_1, sizeof str_1, "Вы выдали игроку %s постоянный скин №%i", PN(to_player), skin_id);
	SCM(playerid, -1, str_1);
	//str_1[0] = EOS, f(str_1, sizeof str_1, "Выдал %s[acc:%i] скин %i", PN(to_player), GetPlayerAccountID(to_player), skin_id);
	return 2;
}
CMD:inter(playerid, params[])
{
	extract params -> new to_player, interior; else return SCM(playerid, 0xCECECEFF, !"Используйте: /inter [id игрока] [интерьер]");

	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, !"Такого игрока нет");

	SetPlayerInterior(to_player, interior);

	format(str_mes, sizeof str_mes, "Вы установили %s[%i] интерьер %i", PN(to_player), to_player, interior);
	SCM(playerid, -1, str_mes);

	format(str_mes, sizeof str_mes, "%s[%i] установил Вам интерьер %i", PN(playerid), playerid, interior);
	SCM(to_player, -1, str_mes);

	format(str_mes, sizeof str_mes, "[A] %s[%i] установил %s[%i] интерьер №%i", PN(playerid), playerid,
		PN(to_player), to_player, interior);
	SendAdminsMessage(0x999999FF, str_mes);

	format(str_mes, sizeof str_mes, "Установил %s[acc:%i] интерьер %i", PN(to_player), GetPlayerAccountID(to_player), interior);
	//SendLog(playerid, LOG_TYPE_ADMIN_ACTION, str_mes);

	return 1;
}

