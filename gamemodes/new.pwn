stock player_SearchNearestBusiness(playerid)
{
	new Float:Distance, Float:Distance_ = 100000.0, bizid;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		Distance = GetPlayerDistanceFromPoint(playerid, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2]);
		if(Distance < Distance_) bizid = i, Distance_ = Distance;
	}
	return bizid;
}
new bool:turn[MAX_PLAYERS];
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(!IsPlayerLogged(playerid)) return 1;
	if(newkeys & 1024)
	{
		if(player_EnterHouse[playerid] != -1)
		{
			new id = player_EnterHouse[playerid];
			if(!IsHouseOwned(id))
			{
				player_GetTickCount[playerid] = GetTickCount();
				str_1[0] = EOS, f(str_1, sizeof(str_1), "\
					{FFFFFF}Тип:\t\t\t\t%s\n\
					Номер дома:\t\t%i\n\n\
					Количество комнат:\t\t%i\n\
					Стоимость:\t\t\t%i руб\n\
					Ежедневная квартплата:\t%i руб", \
					HouseStaticData[HouseData[id][hInterior]][hsName], id, HouseStaticData[HouseData[id][hInterior]][hsRoomsCount], \
					HouseData[id][hCost], HouseStaticData[HouseData[id][hInterior]][hsNalog]);
				SPD(playerid, 20235, 0, "{33CC00}Дом свободен", str_1, "Купить","Отмена");
			}
			else if(!HouseData[id][hLock]) GameTextForPlayerEx(playerid, "~r~Закрыто", 3000, 2);
			else EnterPlayerToHouse(playerid, id);
		}
	}
	if(player_DefaultJob_Progress[playerid][0] == 2 && player_DefaultJob_ID[playerid] == 1)
	{
		if(newkeys & KEY_YES)
		{
			player_DefaultJob_Progress[playerid][1] += 25;
			if(player_DefaultJob_Progress[playerid][1] > 99)
			{
				player_Sawmill_Point(playerid, 3);
				return 1;
			}
			ExecutePacket(playerid, webUpdate, (str_f("interface('ProgressBar').setFill(0, %i)", player_DefaultJob_Progress[playerid][1])));
			return 1;
		}
	}
	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid > 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		if(newkeys & 4)
		{
			//2346.1768,-2609.9480,21.7944
			if(player_HundredArea{playerid} != 255)
			{
				new number = GetVehicleID(vehicleid);
				if(number != INVALID_VEHICLE_ID)
				{
					if(!GetString(CarData[number][cOwner], PN(playerid)))
					{
						SCM(playerid, 0x999999FF, !"Это не ваша машина!");
						return 1;
					}
					EnterPlayerToTuningGarage(playerid, player_HundredArea{playerid});
				}
			}
			else LeavePlayerToTuningGarage(playerid);
		}
		else if(PRESSED(KEY_ANALOG_LEFT))
		{
			if(!turn[playerid]) ExecutePacket_CarTurn(0, playerid, vehicleid, 0, 1);
			else if(turn[playerid]) ExecutePacket_CarTurn(0, playerid, vehicleid, 0, 0);
			turn[playerid] = !turn[playerid];
		}
		else if(PRESSED(KEY_ANALOG_DOWN))
		{
			if(!turn[playerid])
			{
				ExecutePacket_CarTurn(0, playerid, vehicleid, 0, 1);
				ExecutePacket_CarTurn(0, playerid, vehicleid, 1, 1);
			}
			else if(turn[playerid])
			{
				ExecutePacket_CarTurn(0, playerid, vehicleid, 0, 0);
				ExecutePacket_CarTurn(0, playerid, vehicleid, 1, 0);
			}
			turn[playerid] = !turn[playerid];
		}
		else if(PRESSED(KEY_ANALOG_RIGHT)) // num 6
		{
			if(!turn[playerid]) ExecutePacket_CarTurn(0, playerid, vehicleid, 1, 1);
			else if(turn[playerid]) ExecutePacket_CarTurn(0, playerid, vehicleid, 1, 0);
			turn[playerid] = !turn[playerid];
		}
	}
	if(!IsPlayerInAnyVehicle(playerid))
	{
		if(newkeys & 262144)
		{
			foreach(new i: PlayerVehiclesStream[playerid])
			{
				new number = GetVehicleID(i);
				if(number == INVALID_VEHICLE_ID) continue;
				if(TrunkOpen{number} == true)
				{
					if(!CarData[number][cBagAll] && !GetString(CarData[number][cOwner], PN(playerid)))
					{
						SCM(playerid, 0x999999FF, !"Багажник закрыт");
						continue;
					}
					static Float:x, Float:y, Float:z;
					GetVehicleShiftPos(i, 1, x, y, z, 4.0);
					if(IsPlayerInRangeOfPoint(playerid, 4.0, x, y, z))
					{
						player_TrunkOpen[playerid] = number;
						OpenInterface[playerid][7] = !OpenInterface[playerid][7];
						OnPlayerInventory(playerid, 2);
					}
				}
			}
		}
	}
	if(PRESSED(KEY_YES)) callcmd::yes(playerid);
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			if(PRESSED(KEY_HANDBRAKE | KEY_FIRE)) callcmd::lock(playerid, "1");
			else if(PRESSED(KEY_ACTION)) callcmd::e(playerid);
			else if(PRESSED(KEY_FIRE)) callcmd::l(playerid);
			else if(PRESSED(KEY_ANALOG_UP)) callcmd::b(playerid);
			else if(PRESSED(KEY_ANALOG_DOWN)) callcmd::i(playerid);
			else if(PRESSED(KEY_ANALOG_LEFT)) callcmd::sl(playerid);
			else if(PRESSED(KEY_ANALOG_RIGHT)) callcmd::alarm(playerid);
		}
	}
	if(newkeys & KEY_JUMP && newkeys & KEY_SPRINT && GetPlayerState(playerid) != 2) ClearAnimations(playerid), ApplyAnimation(playerid,"PED","KO_SKID_BACK",4.0, 0, 1, 0, 0, 0,0);

	if(newkeys & 1024)
	{
	    if(IsPlayerInRangeOfPoint(playerid, 2.0, 2577.5649,-2377.6558,22.9376))
	    {
		  SCM(playerid, -1, !"{d2c364}Чтобы продать антиквариант, используйте: /inv");
	    }
	}
	return 1;
}

