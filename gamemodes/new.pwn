stock ClearMedBed(playerid, bedid)
{
	if(GetPlayerData(playerid, pTemp_BedID) != -1)
	{
		SetPlayerData(playerid, pTemp_BedID, -1);
	}
	g_med_bed_used[bedid] = false;
	UpdateDynamic3DTextLabelTextf(g_med_bed_label[bedid], 0xFFFFFFFFFFFFFFEE, "Койка №%i\n{00CC00}Свободна", bedid + 1);
	return 1;
}
stock OnPlayerPickUpPickupEx(playerid, pickupid, action_type, action_id)
{
	#pragma unused pickupid
	//SCMD(playerid, "OnPlayerPickUpDynamicPickup -> (4, i)");
	if(!IsPlayerLogged(playerid) || player_DialogID[playerid] != -1) return 1;
	//SCMD(playerid, "OnPlayerPickUpDynamicPickup -> (5, i)");
	//if(GetPlayerData(playerid, pLast_Pickup_ID) == pickupid) return 1;
	//SetPlayerData(playerid, pLast_Pickup_ID, pickupid);
	switch(action_type)
	{
		case pickupInvCarriers:
		{
			new id = player_SearchJobID(playerid, 0);
			if(id == -1 && player_SearchJobID(playerid, -1) != -1)
			{
				SPD(playerid, 20459, 0, "{FFCD00}Трудоустройство в компанию", "\
					{ffffff}Критерии для вступления в транспортную компанию:\n\n\
					- {cefb6a}10{ffffff} игровой уровень\n\
					- Водительское удостоверение\n\
					- Опыт работы и репутация не имеют значения\n\n\
					Желаете посмотреть список вакантных мест?", "Далее","Закрыть");
			}
			else SCM(playerid,-1717986817, "Можно работать только в одной транспортной компании");
		}
		case pickupWheelService:
		{
			player_WheelService_Dialog(playerid);
		}
		case 1000:
		{
			SPD(playerid, 0, 0, "Информация о организации", "\
						Правительство - это главная организация области. \n\
						Она занимается контролем и оборотом денежных средств региона, спонсированием других организаций, \n\
						рассмотрением и принятием законов в области, но преимущественная задача - это выселение должников \nза неуплату того или иного имущества.\n\nЗдесь Вы можете приобрести любой вид лицензии, а адвокаты смогут оспорить Ваше дело и выпустить вас из тюрьмы.\n\nДополнительная информация:\nПосмотреть активных лицензеров: /liclist\nПосмотреть активных адвокатов: /adlist\n\nБюджет организации: {31DD3C}428.345.938 руб{FFFFFF}\n\nДолжность<t>Зарплата\n{FFFFFF}Водитель<t>{31DD3C}32.380 руб\n{FFFFFF}Охранник<t>{31DD3C}40.390 руб\n{FFFFFF}Нач. Охраны<t>{31DD3C}46.465 руб\n{FFFFFF}Секретарь<t>{31DD3C}52.550 руб\n{FFFFFF}Старший Секретарь<t>{31DD3C}58.625 руб\n{FFFFFF}Лицензёр<t>{31DD3C}60.730 руб\n{FFFFFF}Адвокат<t>{31DD3C}74.820 руб\n{FFFFFF}Депутат<t>{31DD3C}86.985 руб\n{FFFFFF}Вице-губернатор<t>{31DD3C}104.220 руб\n{FFFFFF}Губернатор<t>{31DD3C}128.540 руб\n", "Хорошо","");
		}
		case pickupSvalka:
		{
			cmd_cars(playerid, 20373);
		}
		case pickupTruckSalon:
		{
			player_DialogBuyCar(playerid, 3);
		}
		case pickupMediumSalon:
		{
			player_DialogBuyCar(playerid, 1);
		}
		case pickupMiningWork:
		{
			//SCMf(playerid, -1, "%i %i", player_DefaultJob_ID[playerid], player_DefaultJob_Progress[playerid][0]);
			if(GetPlayerState(playerid) != 1) return 0;
			if(player_DefaultJob_ID[playerid] == 0 && player_DefaultJob_Progress[playerid][0] == 1)
			{
				player_DefaultJob_Progress[playerid][0] = 0;
				for(new i; i < 5; i++) 
				{
					RemovePlayerAttachedObject(playerid, i);
				}
				SetPlayerAttachedObject(playerid, 3, 18634, 6, 0.070000000298023, 0.029999999329448, 0.03999999910593, 0, 270, 270, 1.5, 2.0999999046326, 1.7999999523163);
				ApplyAnimation(playerid, "CARRY", "putdwn", 4.1, 0, 0, 0, 0, 0, 1);
				new count = randomEx(40,110);
				SCMf(playerid,1724645631, "Вы доставили в вагонетку {FF9900}%i кг {66CC00}руды", count);
				PI[playerid][pTemp_Wage] += count;
				SCMf(playerid,865730559, "Общее количество добытого сырья: {FF9900}%i кг", PI[playerid][pTemp_Wage]);
			}
		}
		case pickupDice_Data:
		{
			//ExecutePacket(playerid, webUpdate, "window.addDialogInQueue('[0,0,\"{FFCD00}Игра \'Кости\'\",\"\",\"Закрыть\",\"\",0,0]', \"{FFCD00}Как начать играть?<n>{FFFFFF}Найдите стол, где есть игроки и введите команду /dice.\n{FFCD00}Правила игры:<n>{FFFFFF}Каждый участник делает ставку и бросает игральные кости (кубики).<n>Тот, у кого выпало самое большое значение, побеждает.<n>Если у кого-то из участников совпало значение, они кидают кости повторно.\n\В профессиональном режиме основные правила такие же, но есть дополнения.<n>Каждая игра состоит из трёх раундов. После каждого раунда игроки выбирают действие.<n>Некоторые действия имеют стоимость, которая списывается с вашего баланса и зачисляется в банк.<n>Действие \'повторить бросок\' позволяет перебросить кости в следующем раунде.<n>Действие \'продолжить\' позволяет пропустить раунд без действий.<n>Действие \'пас\' показывает счёт всем игрокам и запрещает действия в следующих раундах.<n>В конце игры остатки баланса возвращаются всем игрокам.\", 0)");
		}
		case PICKUP_ACTION_TYPE_RENT_VEHICLE:
		{
			SPD(playerid, 20305, DIALOG_STYLE_MSGBOX,
				"{E9E602}Аренда скутера", "\
					{FFFFFF}Вы хотите арендовать скутер? \n\n\
					\t{FFFFFF}Стоимость: {E9BA02}300000 руб \n\
					\t{FFFFFF}Длительность аренды: {E9E602}60 мин \n\n\
					{FFFFFF}Данное транспортное средство предназначено для выгодного \n\
					использования на начальных уровнях.", "Аренда", "Отмена");      
		}
		case pickupParking:
		{
			if(PI[playerid][pMember_ID] != action_id) return 0;
			player_FracGarageEntered[playerid] = action_id;
			if(!GetPlayerInterior(playerid))
			{
				SPD(playerid, 20400, 0, "{FFCD00}Парковка", "Желаете посетить парковку автотранспорта?", "Да","Отмена");
			}
			else
			{
				SetPlayerVirtualWorld(playerid, 0);
				SetPlayerInterior(playerid, 0);
				new id = player_FracGarageEntered[playerid];
				SetPlayerPosEx(playerid, FractionParking[id][fpExited][0], FractionParking[id][fpExited][1], FractionParking[id][fpExited][2], FractionParking[id][fpExited][3], 0, 0);
			}
		}
		case pickupDuty:
		{
			if(!PI[playerid][pMember_ID]) return 0;
			player_pickupDuty(playerid);
		}
		case pickupFreeEat:
		{
			if(!player_EatTrash{playerid}) 
			{
				str_mes[0] = EOS;
				if(!action_id)
				{
					if(PI[playerid][pLevel] < 4)
					{
						f(str_mes, sizeof(str_mes), "%s взял(а) бесплатную еду для бедных", PN(playerid));
					}
					else SCM(playerid,-825307393, "Это можно использовать только до 4 уровня");
				}
				else if(action_id != PI[playerid][pMember_ID])
				{
					f(str_mes, sizeof(str_mes), "%s взял(а) еду", PN(playerid));
				}
				if(strlen(str_mes) > 0) player_PickAdapt(playerid, str_mes);
			}
		}
		case MAIN_BOLKA: SPD(playerid, 0, 0, "{FFCD00}Городская больница", "{FFFFFF}Государство бесплатно предоставляет медицинские услуги в\nгородских больницах. Однако бесплатный курс может занять\nвремя, поэтому за определенную сумму медперсонал готов\nпровести для Вас экспресс-лечение.", "Закрыть", "");
		case INFO_BOLKA: SPD(playerid, 0, 0, "Информация о организации", "Министерство здравоохранения - одна из самых важных организаций в области. \nОна занимается лечением людей, обеспечение крепкого здоровья гражданам, проведением медосмотров \nи выдачей медицинских карт с установленным в ней состоянием пациента, выездами на места происшествий\nи оказанием там помощи, а также операциями по смене пола.\n\nДополнительная информация:\nНомер телефона для связи с МЗ: 03\n\nБюджет организации: {31DD3C}237.170 руб{FFFFFF}\n\nДолжность<t>Оклад<t>Премия<t>Зарплата\n{FFFFFF}Интерн<t>{31DD3C}2.250 руб<t>1.000 руб<t>3.250 руб\n{FFFFFF}Фельдшер<t>{31DD3C}3.150 руб<t>2.500 руб<t>5.650 руб\n{FFFFFF}Участковый врач<t>{31DD3C}3.750 руб<t>4.000 руб<t>7.750 руб\n{FFFFFF}Терапевт<t>{31DD3C}4.500 руб<t>6.000 руб<t>10.500 руб\n{FFFFFF}Проктолог<t>{31DD3C}5.400 руб<t>8.000 руб<t>13.400 руб\n{FFFFFF}Нарколог<t>{31DD3C}6.600 руб<t>10.000 руб<t>16.600 руб\n{FFFFFF}Хирург<t>{31DD3C}7.395 руб<t>12.000 руб<t>19.395 руб\n{FFFFFF}Зав. отделом<t>{31DD3C}8.802 руб<t>15.000 руб<t>23.802 руб\n{FFFFFF}Зам Глав Врача<t>{31DD3C}12.893 руб<t>18.500 руб<t>31.393 руб\n{FFFFFF}Глав Врач<t>{31DD3C}20.000 руб<t>22.000 руб<t>42.000 руб\n", "Хорошо", "");
		case EXPRESS_BOLKA: SPD(playerid, 902, 0, "{FFCD00}Экспресс лечение", "{FFFFFF}Курс экспресс-лечения стоит 2.500 руб. и воспоолняет здоровье до 70%%\n\nХотите пройти его?", "Да", "Нет");
		case PICKUP_ACTION_TYPE_INFO_PICKUP:
		{
			Dialog
			(
				playerid, INVALID_DIALOG_ID, DIALOG_STYLE_MSGBOX,
				GetInfoPickupData(action_id, IP_TITLE),
				GetInfoPickupData(action_id, IP_INFO),
				"Ок", ""
			);
		}
	}
	return 1;
}
