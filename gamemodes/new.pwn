stock player_ItemStore_Open(playerid)
{
	new bizid = player_BizEntered[playerid];
	if(bizid != -1)
	{
		SetPlayerCameraPos(playerid, -502.6637878418, 1507.0875244141, 1002.2135620117);
		SetPlayerCameraLookAt(playerid, -501.24166870117, 1511.2796630859, 999.88903808594, 2);
		player_ItemStore_Click(playerid, 7);
		str_1[0] = EOS;
		new bool:count;
		for(new i; i < sizeof(ItemStore_Property); i++)
		{
			if(!count) count = true;
			else strcat(str_1, ",");
			strcat(str_1, (str_f("[\"/poperty_accessories/%i\",\"%s\",\"%i\",%i]", ItemStore_Property[i][isModel], ItemStore_Property[i][isName], ItemStore_Property[i][isCost]*BizData[bizid][bProductEx], ItemStore_Property[i][isUID])));
		}
		ExecutePacket(playerid, webOpen, "ItemStore", (str_f("[\"Продуктовый магазин\",[\"Украшения для недвижимости\"],[%s],1]", str_1)));
		OpenInterface[playerid][107] = true;
	}
	else player_ItemStore_Close(playerid), SCM(playerid, -1, "Перезайдите в бизнес!!");
	return 1;
}
stock player_ItemStore_Click(playerid, click)
{
	new uid = ItemStore_SearchClick(click);
	if(uid != -1)
	{
		if(player_TempObject[playerid] != -1) DestroyPlayerObject(playerid, player_TempObject[playerid]), player_TempObject[playerid] = -1;
		player_TempObject[playerid] = CreatePlayerObject(playerid, ItemStore_Property[uid][isModel], -500.66360473633, 1509.5268554688, 1000.4899902344, 0, 0, -160.37899780273, 300);
		printf("player_ItemStore_Click %i", click);
	}
	return 1;
}
stock player_ItemStore_Buy(playerid, click)
{
	new bizid = player_BizEntered[playerid];
	if(bizid != -1)
	{
		new uid = ItemStore_SearchClick(click);
		if(uid != -1)
		{
			ExecutePacket(playerid, webUpdate, "interface('ItemStore').closePayment()");
			new cost = ItemStore_Property[uid][isCost]*BizData[bizid][bProductEx];
			if(CompareInt64(playerid, "<", cost))
			{
				return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
			}
			GivePlayerMoneyEx(playerid, -cost, (str_f("Продуктовый магазин itemstore -> №%i", bizid)));
			GiveBusinessMoney(playerid, player_BizEntered[playerid], cost/10, 0);
			str_log[0] = EOS;
			f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
			strcat(str_log, "24/7");
			InvAdd(playerid, 41, 1, "", ItemStore_Property[uid][isModel], 0, "", str_log);
			//printf("player_ItemStore_Buy %i", click);
		}
	}
	else player_ItemStore_Close(playerid), SCM(playerid, -1, "Перезайдите в бизнес!!");
	return 1;
}
stock ItemStore_SearchClick(click)
{
	for(new i; i < sizeof(ItemStore_Property); i++)
	{
		if(ItemStore_Property[i][isUID] == click) return i;
	}
	return -1;
}
stock player_ItemStore_Category(playerid, click)
{
	printf("player_ItemStore_Category(%i, %i)", playerid, click);
	return 1;
}
stock player_ItemStore_Close(playerid)
{
	if(player_TempObject[playerid] != -1) DestroyPlayerObject(playerid, player_TempObject[playerid]), player_TempObject[playerid] = -1;
	print("player_ItemStore_Close");
	OpenInterface[playerid][107] = false;
	SetCameraBehindPlayer(playerid);
	return 1;
}
stock player_ItemStore_Camera(playerid)
{
	printf("player_ItemStore_Camera(%i)", playerid);
	return 1;
}
stock player_House_InstallObject(playerid, id, model)
{
	new slot = -1;
	for(new i; i < 10; i++)
	{
		if(IsValidAcsProperty(HouseData[id][hObject_Model][i]) == -1)
		{
			slot = i;
			break;
		}
	}
	if(slot != -1)
	{
		SetPVarInt(playerid, "propertyObject_type", 1);
		SetPVarInt(playerid, "propertyObject_id", id);
		SetPVarInt(playerid, "propertyObject_model", model);
		player_Property_EditObject(playerid);
	}
	else SCM(playerid, -1, "Все слоты для установки объектов закончились в данном имуществе.");
	return 1;
}
stock player_Business_InstallObject(playerid, id, model)
{
	new slot = -1;
	for(new i; i < 10; i++)
	{
		if(IsValidAcsProperty(BizData[id][bObject_Model][i]) == -1)
		{
			slot = i;
			break;
		}
	}
	if(slot != -1)
	{
		SetPVarInt(playerid, "propertyObject_type", 2);
		SetPVarInt(playerid, "propertyObject_id", id);
		SetPVarInt(playerid, "propertyObject_model", model);
		player_Property_EditObject(playerid);
	}
	else SCM(playerid, -1, "Все слоты для установки объектов закончились в данном имуществе.");
	return 1;
}
stock player_Property_EditObject(playerid)
{
	SCM(playerid,-3342081, "Вы установили новый предмет интерьера. Используйте /pa_edit, чтобы редактировать");
	if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) DestroyDynamicObject(EditObjectPlayer[playerid]);
	EditObjectPlayer[playerid] = INVALID_OBJECT_ID;
	static Float:x, Float:y, Float:z;
	GetPlayerPos(playerid, x, y, z);
	EditObjectPlayer[playerid] = CreateDynamicObject(GetPVarInt(playerid, "propertyObject_model"), x+2, y+2, z, 0.0, 0.0, 0.0, GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), -1, 70.0, 70.0);
	EditDynamicObject(playerid, EditObjectPlayer[playerid]);
}
stock player_EditObject_Cancel(playerid)
{
	if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) DestroyDynamicObject(EditObjectPlayer[playerid]);
	EditObjectPlayer[playerid] = INVALID_OBJECT_ID;
	if(GetPVarInt(playerid, "propertyObject_type") == 1 || GetPVarInt(playerid, "propertyObject_type") == 2)
	{
		DeletePVar(playerid, "propertyObject_type");
		DeletePVar(playerid, "propertyObject_id");
		DeletePVar(playerid, "propertyObject_model");
	}
	else if(GetPVarInt(playerid, "InstallVehTun"))
	{
		DeletePVar(playerid, "InstallVehTun");
		EditObjectToVehicle[playerid] = -1;
	}
	else if(GetPVarInt(playerid, "InstallVehStage"))
	{
		DeletePVar(playerid, "InstallVehStage");
		EditObjectToVehicle[playerid] = -1;
	}
	else if(GetPVarInt(playerid, "objedit")){
		DestroyDynamicObject(ObjInfo[ListMap][objID]);
		DeletePVar(playerid, "objedit");
	}
	else if(GetPVarInt(playerid, "obj_edit"))
	{
		DestroyDynamicObject(EditObjectPlayer[playerid]);
		DeletePVar(playerid, "obj_edit");
	}
	CancelEdit(playerid);
	Streamer_Update(playerid);
	return 1;
}
stock UpdateHouse_Object(id, slot)
{
	if(HouseObject[id][slot] != INVALID_OBJECT_ID) DestroyDynamicObject(HouseObject[id][slot]);
	HouseObject[id][slot] = INVALID_OBJECT_ID;

	if(IsValidAcsProperty(HouseData[id][hObject_Model][slot]) == -1) return -1;
	HouseObject[id][slot] = CreateDynamicObject(HouseData[id][hObject_Model][slot], \
		HouseData[id][hObject_Position_X][slot], HouseData[id][hObject_Position_Y][slot], HouseData[id][hObject_Position_Z][slot],\
		 HouseData[id][hObject_Position_rX][slot], HouseData[id][hObject_Position_rY][slot], HouseData[id][hObject_Position_rZ][slot], HouseData[id][hObject_VirtualWorld][slot], HouseData[id][hObject_Interior][slot]);
	//printf("UpdateHouse_Object++ %i", HouseObject[id][slot]);
	return 1;
}
stock UpdateBiz_Object(id, slot)
{
	if(BizObject[id][slot] != INVALID_OBJECT_ID) DestroyDynamicObject(BizObject[id][slot]);
	BizObject[id][slot] = INVALID_OBJECT_ID;

	if(IsValidAcsProperty(BizData[id][bObject_Model][slot]) == -1) return -1;
	BizObject[id][slot] = CreateDynamicObject(BizData[id][bObject_Model][slot], \
		BizData[id][bObject_Position_X][slot], BizData[id][bObject_Position_Y][slot], BizData[id][bObject_Position_Z][slot], \
		BizData[id][bObject_Position_rX][slot], BizData[id][bObject_Position_rY][slot], BizData[id][bObject_Position_rZ][slot], BizData[id][bObject_VirtualWorld][slot], BizData[id][bObject_Interior][slot]);
	return 1;
}
