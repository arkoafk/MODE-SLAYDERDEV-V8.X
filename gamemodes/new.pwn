CMD:hand_default(playerid)
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	new vehicleid = GetPlayerVehicleID(playerid);
	Handling_ClearData(vehicleid);
	UpdateVehicleHadling(vehicleid);
	return 1;
}
CMD:hand_inst(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new str; else return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	Handling_VehicleData[vehicleid][E_MODEL_INDEX] = str;
	return 1;
}
CMD:hand_set(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new str, Float:str2, str3; else return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	SCMf(playerid, -1, "%i", Handling_VehicleData[vehicleid][E_MODEL_INDEX]);
	switch(str)
	{
		case 1://Float:E_MASS,
		{
			Handling_VehicleData[vehicleid][E_MASS] += str2;
		}
		case 2://Float:E_TURNMASS,
		{
			Handling_VehicleData[vehicleid][E_TURNMASS] += str2;
		}
		case 3://Float:E_DRAGMULT,
		{
			Handling_VehicleData[vehicleid][E_DRAGMULT] += str2;
		}
		case 4://Float:E_CENTRE_OF_MASS_X,
		{
			Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][2] += str2;
		}
		case 5://Float:E_CENTRE_OF_MASS_Y,
		{
			Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][2] += str2;
		}
		case 6://Float:E_CENTRE_OF_MASS_Z,
		{
			Handling_VehicleData[vehicleid][E_CENTRE_OF_MASS][2] += str2;
		}
		case 7://E_PERCENT_SUBMERGED,
		{
			Handling_VehicleData[vehicleid][E_PERCENT_SUBMERGED] += str2;
		}
		case 8://Float:E_TRACTION_MULTIPLIER,
		{
			Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER] += str2;
		}
		case 9://E_DRIVE_TYPE,
		{
			Handling_VehicleData[vehicleid][E_DRIVE_TYPE] = str3;
		}
		case 10://E_ENGINE_TYPE,
		{
			Handling_VehicleData[vehicleid][E_ENGINE_TYPE] = str3;
		}
		//case 11://E_NUMBER_OF_GEARS,
		//case 12://E_TRANSIMISSION_HANDLING_FLAGS,
		case 13://Float:E_ENGINE_ACCELERATION,
		{
			Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] += str2;
		}
		case 14://Float:E_ENGINE_INERT,
		{
			Handling_VehicleData[vehicleid][E_ENGINE_INERT] += str2;
		}
		case 15://Float:E_MAXGEAR_VELOCITY,
		{
			Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] += str2;
		}
		case 16://Float:E_BRAKE_DECELERATION,
		{
			Handling_VehicleData[vehicleid][E_BRAKE_DECELERATION] += str2;
		}
		case 17://Float:E_BRAKE_BIAS,
		{
			Handling_VehicleData[vehicleid][E_BRAKE_BIAS] += str2;
		}
		case 18://Float:E_STEERING_LOCK,
		{
			Handling_VehicleData[vehicleid][E_STEERING_LOCK] += str2;
		}
		case 19://Float:E_TRACTION_LOSS,
		{
			Handling_VehicleData[vehicleid][E_TRACTION_LOSS] += str2;
		}
		case 20://Float:E_TRACTION_BIAS,
		{
			Handling_VehicleData[vehicleid][E_TRACTION_BIAS] += str2;
		}
		case 21://Float:E_SUSPENSION_FORCE_LEVEL,
		{
			Handling_VehicleData[vehicleid][E_SUSPENSION_FORCE_LEVEL] += str2;
		}
		//case 22://Float:E_SUSPENSION_DAMPING_LEVEL,
		//case 23://Float:E_SUSPENSION_HIGH,
		//case 24://Float:E_SUSPENSION_UPPER,
		//case 25://Float:E_SUSPENSION_LOWER,
		case 26://Float:E_SUSPENSION_BIAS,
		{
			Handling_VehicleData[vehicleid][E_SUSPENSION_BIAS] += str2;
		}
		/*case 27://Float:E_SUSPENSION_ANTI_DRIVE,
		case 28://Float:E_COLLISION_DAMAGE,
		case 29://E_MODEL_FLAGS,
		case 30://E_HANDLING_FLAGS,
		case 31://Float:E_SEAT_OFFSET,
		case 32://E_MONETARY_VALUE,
		case 33://E_FRONT_LIGHTS,
		case 34://E_REAR_LIGHTS,
		case 35://E_ANIM_GROUP*/
	}
	UpdateVehicleHadling(vehicleid);
	return 1;
}
stock player_StageTuning_Open(playerid, style)
{
	ExecutePacket(playerid, webClose, "TuningStage");
	new number = GetVehicleID(GetPlayerVehicleID(playerid));
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
			return 1;
		}
		player_ShowUID[playerid][66] = style;
		ExecutePacket(playerid, webOpen, "TuningStage", (str_f("[[70,1.4],[[\"Уровень 1\",%i,10,10.00],[\"Уровень 2\",%i,20,20.00],[\"Уровень 3\",%i,30,30.00],[\"Остальное\",%i,0,0.00]]]", cost_stage[0], cost_stage[1], cost_stage[2], cost_stage[3])));
		ExecutePacket(playerid, webUpdate, "interface('Hud').hideSpeedometer()");
		TogglePlayerControllable(playerid, false);
		SetPlayerVirtualWorld(playerid, 1000+playerid);
		new vehicleid = GetPlayerVehicleID(playerid);
		SetVehicleVirtualWorld(vehicleid, 1000+playerid);
		SetVehiclePos(vehicleid, 2339.8786621094, -2611.8869628906, 1002.2899780273);
		SetVehicleZAngle(vehicleid, 270.23791503906);
		SetPlayerCameraPos(playerid, 2345.9262695313, -2608.3618164063, 1003.2899780273);
		SetPlayerCameraLookAt(playerid, 2340.3786621094, -2611.884765625, 1002.2899780273, CAMERA_CUT);
		OpenInterface[playerid][66] = true;
	}
	return 1;
}
stock player_SPanelTuning_Open(playerid)
{
	new number = GetVehicleID(GetPlayerVehicleID(playerid));
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
			return 1;
		}
		ExecutePacket(playerid, webOpen, "TuningPneuma", (str_f("[%i, %i]", CarData[number][cPneuma], cost_spanel[CarData[number][cPneuma]])));
		ExecutePacket(playerid, webUpdate, "interface('Hud').hideSpeedometer()");
		TogglePlayerControllable(playerid, false);
		SetPlayerVirtualWorld(playerid, 1000+playerid);
		new vehicleid = GetPlayerVehicleID(playerid);
		SetVehicleVirtualWorld(vehicleid, 1000+playerid);

		SetVehiclePos(vehicleid, -432.15469360352, 580.87310791016, 1000.8021240234);
		SetVehicleZAngle(vehicleid, 269.52398681641);
		SetPlayerCameraPos(playerid, -426.06365966797, 584.32263183594, 1001.8021240234);
		SetPlayerCameraLookAt(playerid, -431.65472412109, 580.86895751953, 1000.8021240234, CAMERA_CUT);
		OpenInterface[playerid][114] = true;
	}
	return 1;
}
stock player_SPanelTuning_Click(playerid, click)
{
	if(!OpenInterface[playerid][114]) return 0;
	new number = GetVehicleID(GetPlayerVehicleID(playerid));
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
			return 1;
		}
		switch(click)
		{
			case 0: SCM(playerid,-411631446, "Тест-драйв доступен при не установленной пневматической подвески.");
			case 4,5:
			{
				if(!CarData[number][cPneuma]) 
				{
					SPD(playerid, 20385, 0, "{E7BF60}Подтверждение", (str_f("\
						{E7E7E8}Вы хотите установить пневмоподвеску? <n><n>\
						<t>Цена покупки: {E79500}%i RUB", cost_spanel[0])), "Да","Отмена");
				}
				else 
				{
					SPD(playerid, 20385, 0, "{E7BF60}Подтверждение", (str_f("\
						{E7E7E8}Вы хотите продать установленную пневмоподвеску? <n><n>\
						<t>Ожидаемая сумма с продажи: {E79500}%i RUB", cost_spanel[1])), "Да","Отмена");
				}
			}
			case 6:
			{
				ExecutePacket(playerid, webClose, "TuningPneuma");
				TogglePlayerControllable(playerid, true);
				new vehicleid = GetPlayerVehicleID(playerid);
				player_ShowSpeed(playerid, vehicleid);
				SetPlayerVirtualWorld(playerid, 0);
				SetVehicleVirtualWorld(vehicleid, 0);
				SetVehiclePos(vehicleid, -413.06900024414, 1007.5983276367, 11.773599624634);
				SetVehicleZAngle(vehicleid, 0.92369997501373);
				SetCameraBehindPlayer(playerid);
				OpenInterface[playerid][114] = false;
			}
		}
	}
	return 1;
}
stock player_StageTuning_Close(playerid)
{
	ExecutePacket(playerid, webClose, "TuningStage");
	TogglePlayerControllable(playerid, true);
	new vehicleid = GetPlayerVehicleID(playerid);
	player_ShowSpeed(playerid, vehicleid);
	SetPlayerVirtualWorld(playerid, 0);
	SetVehicleVirtualWorld(vehicleid, 0);
	if(player_ShowUID[playerid][66] == 1)
	{
		SetVehiclePos(vehicleid, 283.77563476563, 696.28088378906, 11.742188453674);
		SetVehicleZAngle(vehicleid, 159.38116455078);
	}
	else
	{
		SetVehiclePos(vehicleid, 2350.9150,-2611.5911,21.7873);
		SetVehicleZAngle(vehicleid, 180);
	}
	SetCameraBehindPlayer(playerid);
	OpenInterface[playerid][66] = false;
	return 1;
}
stock player_StageTuning_Click(playerid, type, item)
{
	//SCMf(playerid, -1, "%i %i", type, item);
	if(player_DialogID[playerid] != -1) return 0;
	switch(type)
	{
		case 0:
		{
			new number = GetVehicleID(GetPlayerVehicleID(playerid));
			if(number != INVALID_VEHICLE_ID)
			{
				//"interface('GameText').add('[2,"~r~Вы должны устанавливать все улучшения по-порядку",3000,0,-1,1,0,3.00]')"
				if((!CarData[number][cStage_RadUsed] && item > 0) ||
					(!CarData[number][cStage_ExhUsed] && item > 0) ||
					(!CarData[number][cStage_TurUsed] && item > 2))
				{
					GameTextForPlayerEx(playerid, "~r~Вы должны устанавливать все улучшения по-порядку", 3000, 2);
					return 1;
				}
				player_Stage_DialogOpen(playerid, item);
			}
		}
		case 1: player_StageTuning_Close(playerid);
	}
	return 1;
}
stock ownableCars_SetStage(number)
{
	new vehicleid = OwnableCar[number];
	static const Float:hand_data[][] = {
		{35.0, 22.0, 50.0},
		{45.0, 35.0, 80.0},
		{85.0, 55.0, 105.0},
		{150.0, 90.0, 174.0}
	};
	Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER] = 0.0;
	Handling_VehicleData[vehicleid][E_STEERING_LOCK] += CarData[number][cStage_Inversion];
	new count;
	for(new i; i < 4; i++)
	{
		if((CarData[number][cStage_RadUsed] != false && i == 0) ||
			(CarData[number][cStage_ExhUsed] != false && i == 1) ||
			(CarData[number][cStage_TurUsed] != false && i == 2) ||
			(CarData[number][cStage_SupUsed] != false && i == 3))
		{
			Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] = hand_data[i][0];
			Handling_VehicleData[vehicleid][E_ENGINE_INERT] = hand_data[i][1];
			Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = hand_data[i][2];
			Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER] += 0.11;
			count++;
			//printf("ownableCars_SetStage -> %i", i);
		}
	}
	if(count < 1)
	{
		Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] = 0.0;
		Handling_VehicleData[vehicleid][E_ENGINE_INERT] = 0.0;
		Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = 0.0;
		Handling_VehicleData[vehicleid][E_TRACTION_MULTIPLIER] = 0.0;
	}
	return 1;
}
CMD:spanel(playerid)
{
	//if(OpenInterface[playerid][77]) return 0;
    if(!IsPlayerInAnyVehicle(playerid)) return SCM(playerid, 0xCECECEFF, "Вы должны находиться в транспорте");
	new number = GetVehicleID(GetPlayerVehicleID(playerid));
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			SCM(playerid,-825307393, "Управление пневмо-подвеской доступно только на Вашем личном транспорте.");
			return 1;
		}
		if(GetVehicleSpeed(OwnableCar[number]) > 2) return SCM(playerid,-825307393, "Транспорт должен быть остановлен.");
		if(CarData[number][cPneuma] != false)
		{
			ExecutePacket(playerid, webOpen,"TuningPlayerPneuma");
			OpenInterface[playerid][77] = true;
		}
		else SCM(playerid,-825307393, "Управление пневмо-подвеской доступно только на транспорте где он установлен.");
	}
	else SCM(playerid,-825307393, "Управление пневмо-подвеской доступно только на Вашем личном транспорте.");
	return 1;
}
stock player_PneumaTuning_Click(playerid, click)
{
	//cPneuma
	//"interface('GameText').add('[1,"~r~Максимальный наклон",2000,0,-1,1,0,3.00]')"
	//"interface('GameText').add('[1,"~w~Наклон ~n~~y~0.59",2000,0,-1,1,0,3.00]')"
	//"interface('GameText').add('[1,"~w~Завышение ~n~~y~2.79",2000,0,-1,1,0,3.00]')"
	//2 высота макс
	//0.39 мин
	//0.89 макс
	if(OpenInterface[playerid][114] != false || OpenInterface[playerid][77] != false)
	{
		if(player_AntiFlood[playerid][14]-global_time > 0)
		{
			GameTextForPlayerEx(playerid, "Не флуди", 2000, 2);
			return 1;
		}
		new number = GetVehicleID(GetPlayerVehicleID(playerid));
		if(number != INVALID_VEHICLE_ID)
		{
			if(!GetString(CarData[number][cOwner], PN(playerid)))
			{
				SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
				return 1;
			}
			//SCMf(playerid, -1, "%f %f", CarData[number][cPneuma_far], CarData[number][cPneuma_fr]);
			player_AntiFlood[playerid][14] = global_time+1;
			switch(click)
			{
				case 0:
				{
					if(CarData[number][cPneuma_fr] > 0.28)
					{
						GameTextForPlayerEx(playerid, "~r~Максимальный наклон", 2000, 1);
						return 1;
					}
					CarData[number][cPneuma_fr] += 0.15;
				}
				case 1:
				{
					if(CarData[number][cPneuma_fr] < -0.28)
					{
						GameTextForPlayerEx(playerid, "~r~Максимальный наклон", 2000, 1);
						return 1;
					}
					CarData[number][cPneuma_fr] -= 0.15;
				}
				case 2:
				{
					if(CarData[number][cPneuma_far] > 1.39)
					{
						GameTextForPlayerEx(playerid, "~r~Максимальный наклон", 2000, 1);
						return 1;
					}
					CarData[number][cPneuma_far] += 0.15;
				}
				case 3:
				{
					if(CarData[number][cPneuma_far] < -0.40)
					{
						GameTextForPlayerEx(playerid, "~r~Максимальный наклон", 2000, 1);
						return 1;
					}
					CarData[number][cPneuma_far] -= 0.15;
				}
				case 4:
				{
					UpdateDataFloat("OwnableCars", "Pneuma_far", CarData[number][cPneuma_far], CarData[number][cID]);
					UpdateDataFloat("OwnableCars", "Pneuma_fr", CarData[number][cPneuma_fr], CarData[number][cID]);
					ExecutePacket(playerid, webClose, "TuningPlayerPneuma");
					OpenInterface[playerid][77] = false;
					return 1;
				}
				default:
				{
					return 1;
				}
			}
			if(click < 2) GameTextForPlayerEx(playerid, (str_f("~w~Наклон ~n~~y~%.2f", CarData[number][cPneuma_far])), 2000, 1);
			else GameTextForPlayerEx(playerid, (str_f("~w~Завышение ~n~~y~%.2f", CarData[number][cPneuma_far])), 2000, 1);
			ownableCars_SetPneuma(number);
			UpdateVehicleHadling(OwnableCar[number]);
		}
	}
	return 1;
}
stock ownableCars_SetPneuma(number)
{
	new vehicleid = OwnableCar[number];
	if(!CarData[number][cPneuma])
	{
		CarData[number][cPneuma_far] = 0.0;
		CarData[number][cPneuma_fr] = 0.0;
	}
	if(CarData[number][cPneuma_fr] > 0.28) CarData[number][cPneuma_fr] = 0.28;
	if(CarData[number][cPneuma_fr] < -0.28) CarData[number][cPneuma_fr] = -0.28;

	if(CarData[number][cPneuma_far] < -0.40) CarData[number][cPneuma_far] = -0.40;
	if(CarData[number][cPneuma_far] > 1.39) CarData[number][cPneuma_far] = 1.39;
	Handling_VehicleData[vehicleid][E_SUSPENSION_FORCE_LEVEL] = CarData[number][cPneuma_far];
	Handling_VehicleData[vehicleid][E_SUSPENSION_BIAS] = CarData[number][cPneuma_fr];
	return 1;
}
CMD:unloadcars(playerid, get[])
{
	new radius;
	if(sscanf(get, "i", radius)) return SCM(playerid, COLOR_GREY, "Используйте: /unloadcars [радиус]");
	if(radius < 20 || radius > 100) return SCM(playerid, 0xFF6600FF, !"Радиус от 20 до 100");
	str_1[0] = EOS;
	new vehicles_count;
	foreach(new i: PlayerVehiclesStream[playerid])
	{
		new number = GetVehicleID(i);
		if(number == INVALID_VEHICLE_ID) continue;
		new Float:x, Float:y, Float:z;
		GetVehiclePos(i, x, y, z);
		if(IsPlayerInRangeOfPoint(playerid, radius, x, y, z))
		{//triazov
			new player;
			foreach(new vehicleid: PlayerInVehicle[i]) 
			{
				str_1[player] = vehicleid;
				player++;
			}
			if(!player)
			{
				str_1[vehicles_count] = number;
				vehicles_count++;
			}
		}
	}
	for(new i; i < vehicles_count; i++)
	{
		new j = str_1[i];
		if(!IsValidVehicle(OwnableCar[j])) continue;
		SCMf(GetPlayerID(CarData[j][cOwner]), -1, "Уведомление: Ваш транспорт модель %i, был выгружен администратором %s[%i].", CarData[j][cModel], PN(playerid), playerid);
		SafeRemoveCar(j, j);
	}
	format(str_mes, sizeof str_mes, "[A] %s[%i] выгрузил весь незанятый транспорт в радиусе. Всего выгружено %i шт.", PN(playerid), playerid, vehicles_count);
	SendAdminsMessage(0x999999FF, str_mes);
	return 1;
}
public: player_GetProperty(playerid, const name[], uid)
{
	str_1[0] = EOS;
	strcat(str_1, "Бизнесы:\n");
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(!GetString(BizData[i][bOwner], name)) continue;
		new type = BizData[i][bType];
		strcat(str_1, (str_f("№%i ( %s %s )\n", i, BizStaticData[type][bsName], BizData[i][bName])));
	}
	strcat(str_1, "\n Киоски:\n");
	for(new i; i < sizeof(StallStaticData); i++)
	{
		if(!GetString(StallData[i][sOwner], name)) continue;
		strcat(str_1, (str_f("№%i\n", i)));
	}
	strcat(str_1, "\n Дома/квартиры:\n");
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(!GetString(HouseData[i][hOwner], name)) continue;
		strcat(str_1, (str_f("№%i\n", i)));
	}
	strcat(str_1, "\n Гаражи:\n");
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(!GetString(GarageData[i][gOwner], name)) continue;
		strcat(str_1, (str_f("№%i\n", i)));
	}
	strcat(str_1, "\n Машины:\n");
	for(new i, count = cache_num_rows(); i < count; i++)
	{
		static id, model, type, number[24];
		cache_get_int(i, "ID", id);
		cache_get_int(i, "Model", model);
		cache_get_int(i, "Number_Type", type);
		cache_get_string(i, "Number_String", number);
		new uid_ = IsValidCarModel(model);
		if(uid_ != -1)
		{
			strcat(str_1, (str_f("%s(model %i, uid %i, number %s(%i))\n", VehicleStaticData[uid_][vsName], model, uid, number, type)));
		}
	}
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, (str_f("%s(UID: %i)", name, uid)), str_1, "Закрыть");
	player_ShowData[playerid][0] = EOS;
	return 1;
}
CMD:saveserver(playerid)
{
	SaveServer();
	SendAdminsMessagef(0x999999FF, "[A] %s[%i] сделал сохранение сервера", PN(playerid), playerid);
	return 1;
}
stock SaveServer()
{
	foreach(new playerid: Player)
	{
		if(!IsPlayerLogged(playerid)) continue;
		SavePlayerData(playerid);
		for(new i; i < 8; i++)
		{
			player_SaveEx(playerid, i);
		}
		GetPlayerPos(playerid, PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2]);
		GetPlayerFacingAngle(playerid, PI[playerid][pLast_Position][3]);
		mysql_tquery(mysql, (str_f("UPDATE `players` SET `Last_Position` = '%f,%f,%f,%f' WHERE `ID` = '%i' LIMIT 1;", PI[playerid][pLast_Position][0], PI[playerid][pLast_Position][1], PI[playerid][pLast_Position][2], PI[playerid][pLast_Position][3], PI[playerid][pID])));
		UpdatePlayerDataInt(playerid, "Last_LoginTime", global_time);
	}
	for(new i; i < TOTAL_HOUSES; i++)
	{
		SaveInvHouse(i);
	}
	foreach(new i: OWNABLECARS)
	{
		SaveInvTrunk(i);
	}
}
CMD:unloadcar(playerid, get[])
{
	new vehicleid;
	if(sscanf(get, "i", vehicleid)) return SCM(playerid, COLOR_GREY, "Используйте: /unloadcar [vehicleid]");
	new number = GetVehicleID(vehicleid);
	if(number != INVALID_VEHICLE_ID)
	{
		SafeRemoveCar(number, number);
		SCMf(GetPlayerID(CarData[number][cOwner]), -1, "Уведомление: Ваш транспорт модель %i, был выгружен администратором %s[%i].", CarData[number][cModel], PN(playerid), playerid);
		format(str_mes, sizeof str_mes, "[A] %s[%i] выгрузил личное авто. [carid: %i]", PN(playerid), playerid, vehicleid);
		SendAdminsMessage(0x999999FF, str_mes);
	}
	else SCM(playerid, -1, "Это не личное авто игрока");
	return 1;
}
CMD:fixcar(playerid)
{
	if(GetPlayerState(playerid) != 2) return SCM(playerid, COLOR_GREY, "Вы должны быть за рулем!");
	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid > 0)
	{
		static Float:hp;
		GetVehicleHealth(vehicleid, hp);
		if(hp > 800) return SCM(playerid, 0xFF6600FF, !"Ваша машина достаточно в хорошем состоянии.");
		if(CompareInt64(playerid, "<", 700000)) return SCM(playerid, 0xFF6600FF, !"У Вас недостаточно средств. Необходимо 600000 рублей.");
		//if(GetStrMoney(playerid) < 700000) return SCM(playerid, 0xFF6600FF, !"У Вас недостаточно средств. Необходимо 600000 рублей.");
		GivePlayerMoneyEx(playerid, -700000, "/fixcar");
		RepairVehicle(vehicleid);
		SCM(playerid, -1, "Вы починили авто!");
		f(str_mes, sizeof str_mes, "Игрок %s[%i] починил своё авто через /fixcar", PN(playerid), playerid);
		SendAdminsMessage(COLOR_GOLD, str_mes);
		GiveBusinessMoney(playerid, player_SearchBiz(playerid, 31), 400000, -1);
	}
	else SCM(playerid, COLOR_GREY, "Вы должны быть за рулем!");
	return 1;
}
CMD:flipcar(playerid)
{
	if(GetPlayerState(playerid) != 2) return SCM(playerid, COLOR_GREY, "Вы должны быть за рулем!");
	new vehicleid = GetPlayerVehicleID(playerid);
	if(vehicleid > 0)
	{
		static Float:hp;
		GetVehicleHealth(vehicleid, hp);
		if(hp > 800) return SCM(playerid, 0xFF6600FF, !"Ваша машина достаточно в хорошем состоянии.");
		if(CompareInt64(playerid, "<", -1100000))
		{
			SCM(playerid, 0xFF6600FF, !"У Вас недостаточно средств. Необходимо 700000 рублей.");
			return 1;
		}
		GivePlayerMoneyEx(playerid, -1100000, "/flipcar");
		vehicle_Flip(vehicleid);
		SCM(playerid, -1, "Вы починили авто!");
		f(str_mes, sizeof str_mes, "Игрок %s[%i] флипнул своё авто через /flipcar", PN(playerid), playerid);
		SendAdminsMessage(COLOR_GOLD, str_mes);
		GiveBusinessMoney(playerid, player_SearchBiz(playerid, 31), 600000, -1);
	}
	else SCM(playerid, COLOR_GREY, "Вы должны быть за рулем!");
	return 1;
}
