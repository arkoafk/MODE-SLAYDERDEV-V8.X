stock global_GetShopPrice(const name[])
{
	for(new i; i < sizeof(ShopStaticData); i++) 
	{
		if(!GetString(ShopStaticData[i][shopName], name)) continue;
		return ShopStaticData[i][shopPrice];
	}
	return 0;
} 
stock ShowBusinessLevelUP(playerid, id)
{
	if(id != player_BizEntered[playerid]) return SCM(playerid, COLOR_RED, "Вы должны находиться в бизнесе!");
	str_1[0] = EOS;
	new bool:next;
	for(new i; i < sizeof(Business_improvements); i++)
	{
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{CC3344}%i уровень:\t{FFFFFF}%s\t\t", i, Business_improvements[i][I_NAME]);
		switch(i)
		{
			case 1,4,5: strcat(str_2, "\t");
			default: strcat(str_2, "\t\t");
		}
		if(BizData[id][bLevel] < i) 
		{
			if(!next)
			{
				player_ShowID[playerid][i] = 1;
				next = true;
			}
			else player_ShowID[playerid][i] = 2;
			f(str_2, sizeof(str_2), "%s%i руб\n", str_2, Business_improvements[i][I_PRICE]);
		}
		else player_ShowID[playerid][i] = 0, f(str_2, sizeof(str_2), "%s{2277AA}Куплено\n", str_2, Business_improvements[i][I_PRICE]);
		strcat(str_1, str_2);
	}
	SPD(playerid, 20258, DIALOG_STYLE_LIST, "Улучшение для бизнеса", str_1, "Выбрать", "Назад");
	return 1;
}
public: player_BusinessProfit(playerid)
{
	new count = cache_num_rows();
	str_q[0] = EOS, str_1[0] = EOS;
	if(!count)
	{
		str_q = "{FFFFFF}Финансовая статистика Вашего бизнеса еще не сформирована";
	}
	else
	{
		new total_all;
		for(new i; i < count; i ++)
		{
			str_2 = "{FFFFFF}", cache_get_string(i, "date", str_2);
			strcat(str_1, str_2);

			static total;
			cache_get_int(i, "total", total);
			total_all += total;
			strcat(str_1, (str_f("\t\t{81cb8f}%i руб\t\t{efd08f}1 человек\n", total)));
		}
		str_q[0] = EOS, f(str_q, sizeof(str_q), "\
				Количество посетителей за последнее время:\t\t1 чел.\n\
				Общее количество уникальных клиентов:\t\t\t1 человек.\n\
				Заработок за последнее время:\t\t\t\t%i руб.\n\n\
				Дата\t\tПрибыль\t\tУникальных клиентов\n\n\
				%s", total_all, str_1);
	}
	SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{33AADD}Доход бизнеса за 20 дней", str_q, "<< Назад", "Закрыть");
	return 1;
}
CMD:sellbiz(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_business(playerid, 20259);
	return 1;
}
stock SellBiz(id)
{
	str_1[0] = EOS;
	for(new i; i < 10; i++)
	{
		BizData[id][bObject_Model][i] = 0;
		f(str_1, sizeof(str_1), "%s%i,", str_1, BizData[id][bObject_Model][i]);
		UpdateBiz_Object(id, i);
	}
	UpdateDataStr("Businesses", "Object_Model", str_1, BizData[id][bID]);
	BizData[id][bLevel] = 0;
	BizData[id][bLock] = true;
	UpdateDataInt("Businesses", "Level", BizData[id][bLevel], BizData[id][bID]);
	UpdateDataInt("Businesses", "Lock", BizData[id][bLock], BizData[id][bID]);
	ChangeBusinessOwner(id, "The State");
}
stock EnterPlayerToTuningGarage(playerid, id) //СТО
{
	player_BizEntered[playerid] = player_SearchBiz(playerid, 31);
	player_EnterBiz[playerid] = -1;
	player_HundredEntered[playerid] = id;
	new vehicleid = GetPlayerVehicleID(playerid);
	LinkVehicleToInterior(vehicleid, 4);
	SetPlayerInterior(playerid, 4);

	SetPlayerVirtualWorld(playerid, playerid+1000);
	SetVehicleVirtualWorld(vehicleid, playerid+1000);

	SetVehiclePos(vehicleid, -2498.8835449219, -597.75592041016, 1002.0);
	SetVehicleZAngle(vehicleid, 89.99210357666);
	ExecutePacket(playerid, webOpen, "Interactions", "[[50,\"Выехать из гаража\"]]");
	return 1;
}
stock LeavePlayerToTuningGarage(playerid)
{
	new id = player_HundredEntered[playerid];
	if(id != -1)
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(vehicleid > 0)
		{
			LinkVehicleToInterior(vehicleid, 0);
			SetPlayerInterior(playerid, 0);

			SetPlayerVirtualWorld(playerid, 0);
			SetVehicleVirtualWorld(vehicleid, 0);

			SetVehiclePos(vehicleid, HundredList[id][3], HundredList[id][4], HundredList[id][5]);
			SetVehicleZAngle(vehicleid, HundredList[id][6]);
			player_HundredEntered[playerid] = -1;
			UpdateVehicleTuning(vehicleid, playerid);
			player_Interaction_Hide(playerid);
		}
	}
	return 1;
}
stock player_HundredMenu_Open(playerid)
{
	if(OpenInterface[playerid][13]) return 1;
	new vehicleid = player_LastVehicleID[playerid];
	if(vehicleid != INVALID_VEHICLE_ID)
	{
		OpenInterface[playerid][13] = true;
		player_ShowData[playerid][111] = 0;
		TogglePlayerControllable(playerid, false);
		ExecutePacket(playerid, webOpen, "TuningMenu", (str_f("[%s, []]", GetStrMoney(playerid))));
		ExecutePacket(playerid, webUpdate, (str_f("interface('TuningMenu').setItems('[350000, -1, %i]')", VehicleData[vehicleid][V_COLOR_1])));
		SetPlayerCameraPos(playerid, -2502.4226074219, -601.29376220703, 1004.279296875);
		SetPlayerCameraLookAt(playerid, -2498.8903808594, -597.75500488281, 1000.779296875);
	}
	return 1;
}
stock player_HundredMenu_Switch(playerid, style, category, itemID)
{
	if(!OpenInterface[playerid][13]) return 1;
	new vehicleid = player_LastVehicleID[playerid];
	if(vehicleid == INVALID_VEHICLE_ID) return 1;
	new number = GetVehicleID(vehicleid);
	if(number != INVALID_VEHICLE_ID)
	{
		new type = player_ShowUID[playerid][11];
		if(type >= 0 && type <= 11)
		{
			if(VehicleData[vehicleid][vTuning][type] > 0) 
			{
				RemoveVehicleTuningEx(vehicleid, TuningStaticData[ VehicleData[vehicleid][vTuning][type] ][gtObjectID], playerid);
			}
			for(new i; i < 12; i++) VehicleData[vehicleid][vTuning][i] = CarData[number][cTuning][i];
			UpdateVehicleTuning(vehicleid, playerid);
		}
		switch(style)
		{
			case 0: //выбор
			{
				player_HundredMenu_Install(playerid, category, itemID);
			}
			case 1: //покупка
			{
				player_HundredMenu_Buy(playerid, category, itemID);
			}
			case 2: //клик
			{
				player_HundredMenu_Update(playerid, category);
			}
			case 4: //change color
			{
				if(player_ShowData[playerid][111] == 0) player_ShowData[playerid][111] = 1;
				else player_ShowData[playerid][111] = 0;
			}
			default:
			{
				SetCameraBehindPlayer(playerid);
				TogglePlayerControllable(playerid, true);
				ExecutePacket(playerid, webUpdate, "closeInterface('TuningMenu')");
				OpenInterface[playerid][13] = false;
			}
		}
	}
	return 1;
}
stock player_HundredMenu_Update(playerid, category)
{
	new 
		carid = player_LastVehicleID[playerid],
		number = GetVehicleID(carid);
	str_1[0] = EOS, str_2[0] = EOS;
	switch(category)
	{
		case 0: //покраска
		{
			f(str_1, sizeof(str_1), "interface('TuningMenu').setItems('[1350000, -1, %i]')", GetVehicleData(GetPlayerVehicleID(playerid), V_COLOR_1));
			player_ShowID[playerid][2] = -1;
		}
		case 1: //выхлоп
		{
			str_1 = "interface('TuningMenu').setItems('[[\"Стоковый выхлоп\", 1000000, 0, 0]";
			player_ShowData[playerid][0] = -2;
			for(new i, count = 1; i < sizeof(TuningStaticData); i++)
			{
				if(TuningStaticData[i][gtModelID] != CarData[number][cModel]) continue;
				
				new id = strfind(TuningStaticData[i][gtName], "Выхлоп", false);
				//printf("[%s][%i][%i %i]", TuningStaticData[i][gtName], id, TuningStaticData[i][gtModelID], GetVehicleModel(GetPlayerVehicleID(playerid)));
				if(id == -1) continue;
		
				new cost = TuningStaticData[i][gtCost];
				if(player_BizEntered[playerid] != -1) cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
				str_2[0] = EOS, f(str_2, sizeof(str_2), ",[\"%s\", %i, 0, 0]", TuningStaticData[i][gtName], cost);
				strcat(str_1, str_2);
				player_ShowData[playerid][count] = i;
				count++;
			}
			strcat(str_1, "]')");
		}
		case 2: //гидравлика
		{
			//new count = 1;
			str_1 = "interface('TuningMenu').setItems('[[\"Cтоковая гидравливка\", 10000, 0, 0],[\"Гидравлика\", 500000, 0, 0]";
			player_ShowData[playerid][0] = -2;
			player_ShowData[playerid][1] = tsd_GetName("Гидравлика");
			strcat(str_1, "]')");
		}
		case 3: //остальное
		{
			str_1 = "interface('TuningMenu').setItems('[";
			for(new i, count, bool:count_2; i < sizeof(TuningStaticData); i++)
			{
				if(TuningStaticData[i][gtModelID] != CarData[number][cModel]) continue;
				if(TuningStaticData[i][gtType] == 3) continue;
				if(strfind(TuningStaticData[i][gtName], "Выхлоп", false) != -1 ||
					strfind(TuningStaticData[i][gtName], "Спойлер", false) != -1 || TuningStaticData[i][gtModelID] < 1) continue;

				if(!count_2) count_2 = true;
				else strcat(str_1, ",");

				new cost = TuningStaticData[i][gtCost];
				if(player_BizEntered[playerid] != -1) cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
				str_2[0] = EOS, f(str_2, sizeof(str_2), "[\"%s\", %i, 0, 0]", TuningStaticData[i][gtName], cost);
				strcat(str_1, str_2);
				player_ShowData[playerid][count] = i;
				count++;
			}
			strcat(str_1, "]')");
		}
		case 4: //спойлер
		{
			str_1 = "interface('TuningMenu').setItems('[[\"Стоковый спойлер\", 1000000, 0, 0]";
			player_ShowData[playerid][0] = -2;
			for(new i, count = 1; i < sizeof(TuningStaticData); i++)
			{
				if(TuningStaticData[i][gtModelID] != CarData[number][cModel]) continue;

				if(strfind(TuningStaticData[i][gtName], "Спойлер", false) == -1) continue;
				new cost = TuningStaticData[i][gtCost];
				if(player_BizEntered[playerid] != -1) cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
				str_2[0] = EOS, f(str_2, sizeof(str_2), ",[\"%s\", %i, 0, 0]", TuningStaticData[i][gtName], cost);
				strcat(str_1, str_2);
				player_ShowData[playerid][count] = i;
				count++;
			}
			strcat(str_1, "]')");
		}
		case 5: //гудок
		{
			new count, bool:count_2;
			//player_ShowData[playerid][0] = -2;
			str_1 = "interface('TuningMenu').setItems('[";
			for(new i; i < sizeof(TuningStaticData); i++)
			{
				if(TuningStaticData[i][gtType] != 10) continue;
				str_mes[0] = EOS, sscanf(TuningStaticData[ i ][gtName],"p<|>s[24]i", str_mes, str_d[0]);

				if(!count_2) count_2 = true;
				else strcat(str_1, ",");
				new cost = TuningStaticData[i][gtCost];
				if(player_BizEntered[playerid] != -1) cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
				str_2[0] = EOS, f(str_2, sizeof(str_2), "[\"%s %i\", %i, 0, 0]", str_mes, count+1, cost);
				strcat(str_1, str_2);
				player_ShowData[playerid][count] = i;
				count++;
			}
			strcat(str_1, "]')");
		}
		default: 
		{
			ExecutePacket(playerid,webUpdate, "interface('TuningMenu').setItems('[]')");
			return 1;
		}
	}
	static const
			Float:camPos[][] = {
				{-2504.3356933594, -595.22424316406, 1001.6888427734}, //покраска
				//{-2502.4226074219, -601.29376220703, 1001.279296875}, //диски
				{-2503.4907226563, -593.16296386719, 1002.779296875}, //наклейки
				{-2493.2124023438, -597.25305175781, 1000.3792724609}, //выхлоп
				{-2502.4226074219, -601.29376220703, 1004.279296875}, //гидраливка
				{-2503.8903808594, -597.75952148438, 1004.279296875}, //остальное
				{-2493.3833007813, -599.22528076172, 1002.479309082}, //спойлер
				{-2502.427734375, -601.29376220703, 1004.1888427734} //клаксоны
	},
			Float:camLookAt[][] = {
				{-2498.8955078125, -597.75500488281, 1001.0888671875}, //покраска
				//{-2498.8903808594, -597.75500488281, 1000.779296875}, //диски
				{-2498.8903808594, -597.75500488281, 1001.3792724609}, //наклейки
				{-2498.8903808594, -597.75500488281, 1000.779296875}, //выхлоп
				{-2498.8903808594, -597.75500488281, 1000.779296875}, //гидраливка
				{-2498.8903808594, -597.75500488281, 1000.779296875}, //остальное
				{-2498.8903808594, -597.75500488281, 1000.779296875}, //спойлер
				{-2498.8955078125, -597.75500488281, 1000.6888427734} //клаксоны
	};
	ExecutePacket(playerid,webUpdate, str_1);
	SetPlayerCameraPos(playerid, camPos[category][0], camPos[category][1], camPos[category][2]);
	SetPlayerCameraLookAt(playerid, camLookAt[category][0], camLookAt[category][1], camLookAt[category][2], CAMERA_MOVE);
	return 1;
}
stock player_HundredMenu_Install(playerid, category, itemID)
{
	//UpdateVehicleTuningEx(vehicleid, playerid, 0);
	new 
		carid = player_LastVehicleID[playerid],
		type = player_ShowUID[playerid][11];

	player_ShowID[playerid][0] = category;
	player_ShowID[playerid][1] = itemID;
	if(itemID == -1 || category == -1) return 0;
	switch(category)
	{
		case 0: //покраска
		{
			if(player_ShowData[playerid][111] == 0) ChangeVehicleColor(carid, itemID, VehicleData[carid][V_COLOR_2]);
			else ChangeVehicleColor(carid, VehicleData[carid][V_COLOR_1], itemID);
		}
		case 1: //выхлоп
		{
			if(player_ShowData[playerid][itemID] == -2 || player_ShowData[playerid][itemID] == -1)
			{
				return 1;
			}
			type = TuningStaticData[player_ShowData[playerid][itemID]][gtType];
			VehicleData[carid][vTuning][type] = player_ShowData[playerid][itemID];
			player_ShowUID[playerid][11] = type;
			UpdateVehicleTuningEx(carid, playerid, type);
		}
		case 2: //гидравлика
		{
			if(player_ShowData[playerid][itemID] == -2)
			{
				type = 8;
				if(VehicleData[carid][vTuning][type] > 0)
				{
					RemoveVehicleTuningEx(carid, TuningStaticData[ VehicleData[carid][vTuning][type] ][gtObjectID], playerid);
				}
				VehicleData[carid][vTuning][type] = -1;
			}
			else
			{
				type = TuningStaticData[player_ShowData[playerid][itemID]][gtType];
				VehicleData[carid][vTuning][type] = player_ShowData[playerid][itemID];
			}
			player_ShowUID[playerid][11] = type;
			UpdateVehicleTuningEx(carid, playerid, type);
		}
		case 3: //остальное
		{
			if(player_ShowData[playerid][itemID] == -2)
			{
				return 1;
			}
			if(strfind(TuningStaticData[player_ShowData[playerid][itemID]][gtName], "Задний", false) != -1)
			{
				SetPlayerCameraPos(playerid, -2493.3833007813, -599.22528076172, 1002.479309082);
				SetPlayerCameraLookAt(playerid, -2498.8903808594, -597.75500488281, 1000.779296875, CAMERA_MOVE);
			}
			else
			{
				SetPlayerCameraPos(playerid, -2503.8903808594, -597.75952148438, 1004.279296875);
				SetPlayerCameraLookAt(playerid, -2498.8903808594, -597.75500488281, 1000.779296875, CAMERA_MOVE);
			}

			type = TuningStaticData[player_ShowData[playerid][itemID]][gtType];
			VehicleData[carid][vTuning][type] = player_ShowData[playerid][itemID];
			player_ShowUID[playerid][11] = type;
			UpdateVehicleTuningEx(carid, playerid, type);
		}
		case 4: //спойлер
		{
			if(player_ShowData[playerid][itemID] == -2)
			{
				type = 1;
				if(VehicleData[carid][vTuning][type] > 0)
				{
					RemoveVehicleTuningEx(carid, TuningStaticData[ VehicleData[carid][vTuning][type] ][gtObjectID], playerid);
				}
				VehicleData[carid][vTuning][type] = -1;
			}
			else
			{
				type = TuningStaticData[player_ShowData[playerid][itemID]][gtType];
				VehicleData[carid][vTuning][type] = player_ShowData[playerid][itemID];
			}
			player_ShowUID[playerid][11] = type;
			UpdateVehicleTuningEx(carid, playerid, type);
		}
		case 5: //гудок
		{
			str_mes[0] = EOS, sscanf(TuningStaticData[ player_ShowData[playerid][itemID] ][gtName],\
				"p<|>s[24]i", str_mes, str_d[0]);

			str_1[0] = EOS, f(str_1, sizeof(str_1), "interface('TuningMenu').playClarcson(%i)", str_d[0]);
			ExecutePacket(playerid,webUpdate, str_1);
		}
		default: return 0;
	}
	return 1;
}
stock UpdateVehicleTuning(vehicleid, playerid = INVALID_PLAYER_ID, view = -1)
{
	if(view == -1 || view == -1) 
	{
		new number = GetVehicleID(vehicleid),
			bool:change;
		if(number != INVALID_VEHICLE_ID)
		{
			if(CarData[number][cOwner_Type] == 2)
			{
				new id = GetFamilyID(CarData[number][cFamily_ID]);
				if(id >= 0)
				{
					player_SendVehicleEvent(playerid, 3, vehicleid, FamilyData[id][fColor], FamilyData[id][fColor]);
					change = true;
				}
			}
		}
		if(!change) 
		{
			player_SendVehicleEvent(playerid, 3, vehicleid, VehicleData[vehicleid][V_COLOR_1], VehicleData[vehicleid][V_COLOR_2]);
		}
		//UpdateVehicleTinting(vehicleid, playerid);
	}
	if(view == 0 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 0);
	if(view == 1 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 1);
	if(view == 2 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 2);
	if(view == 3 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 3);
	if(view == 4 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 4);
	if(view == 5 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 5);
	if(view == 6 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 6);
	if(view == 7 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 7);
	if(view == 8 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 8);
	if(view == 9 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 9);
	//if(view == 10 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 9);
	if(view == 11 || view == -1) UpdateVehicleTuningEx(vehicleid, playerid, 11);
	return 1;
}
stock UpdateVehicleTuningEx(vehicleid, playerid = INVALID_PLAYER_ID, type = 0)
{
	if(!Iter_Contains(Vehicles, vehicleid)) return 0;
	if(type == 3)
	{
		if(VehicleData[vehicleid][vTuning][3] < 1 || VehicleData[vehicleid][vTuning][3] >= sizeof(TuningStaticData)) 
		{
			//printf("3 type & %i id & clear", VehicleData[vehicleid][vTuning][3]);
			if(playerid == INVALID_PLAYER_ID) 
			{
				foreach(new i: VehiclePlayersStream[vehicleid]) 
				{
					ExecutePacket(i, webUpdate, (str_f("resetVehiclePaintJob(%i)", vehicleid)));
				}
			}
			else ExecutePacket(playerid, webUpdate, (str_f("resetVehiclePaintJob(%i)", vehicleid)));
		}
		else
		{
			str_1[0] = EOS, str_2[0] = EOS;
			sscanf(TuningStaticData[ VehicleData[vehicleid][vTuning][3] ][gtName],\
				"p<|>s[64]s[64]s[24]", str_1, str_1, str_2);
			
			if(strlen(str_1) < 2) return printf("debug vinyl [%s] [%s] [%i]", str_1, str_2, VehicleData[vehicleid][vTuning][3]);
			//new modelId = TuningStaticData[ VehicleData[vehicleid][vTuning][3] ][gtModelID];

			if(playerid == INVALID_PLAYER_ID) 
			{
				foreach(new i: VehiclePlayersStream[vehicleid]) 
				{
					ExecutePacket(i,webUpdate, (str_f("\
								setVehiclePaintJob(%i, \"%s\", \"%s\")", \
								vehicleid, str_1, str_2)));
				}
			}
			else ExecutePacket(playerid,webUpdate, (str_f("\
							setVehiclePaintJob(%i, \"%s\", \"%s\")", \
							vehicleid, str_1, str_2)));
		}
	}
	else if(type == 11)
	{
		RemoveVehicleComponent(vehicleid, 1087);
		if(VehicleData[vehicleid][vTuning][type] < 1 || VehicleData[vehicleid][vTuning][type] >= sizeof(TuningStaticData)) return 0;
		new objectid = TuningStaticData[ VehicleData[vehicleid][vTuning][type] ][gtObjectID];
		if(objectid == 1087) AddVehicleComponent(vehicleid, 1087);
	}
	else
	{
		if(VehicleData[vehicleid][vTuning][type] < 1 || VehicleData[vehicleid][vTuning][type] >= sizeof(TuningStaticData)) return 0;
		new objectid = TuningStaticData[ VehicleData[vehicleid][vTuning][type] ][gtObjectID];
		if(objectid != 0)
		{
			if(!SearchObjectTuningData(objectid)) return 0;
			new
				BitStream:bsn = BS_New();

			BS_WriteValue(bsn, 	
						PR_UINT8, 215,
						PR_UINT16, 17,
						PR_UINT32, vehicleid,
						PR_UINT32, objectid,
						PR_UINT32, 0);
			if(playerid == INVALID_PLAYER_ID) 
			{
				foreach(new i: VehiclePlayersStream[vehicleid]) 
				{
					PR_SendPacket(bsn, i);
				}
			}
			else PR_SendPacket(bsn, playerid);
			BS_Delete(bsn);
		}
	}
	return 1;
}
stock RemoveVehicleTuningEx(vehicleid, itemID, playerid = INVALID_PLAYER_ID)
{
	if(itemID > 0)
	{
		if(!SearchObjectTuningData(itemID)) return 0;
		new
			BitStream:bsn = BS_New();

		BS_WriteValue(bsn, 	
					PR_UINT8, 215,
					PR_UINT16, 17,
					PR_UINT32, vehicleid,
					PR_UINT32, itemID,
					PR_UINT32, 1);

		if(playerid == INVALID_PLAYER_ID) 
		{
			foreach(new i: VehiclePlayersStream[vehicleid]) 
			{
				PR_SendPacket(bsn, i);
			}
		}
		else PR_SendPacket(bsn, playerid);
		BS_Delete(bsn);
	}
	return 1;
}
stock SearchObjectTuningData(objectid)
{
	for(new i; i < sizeof(TuningStaticData); i++) 
	{
		if(TuningStaticData[i][gtType] == -1 || TuningStaticData[i][gtObjectID] <= 1) continue;
		if(TuningStaticData[i][gtObjectID] == objectid) return 1;
	}
	return 0;
}
stock player_HundredMenu_Buy(playerid, category, itemID)
{
	new 
		carid = player_LastVehicleID[playerid],
		number = GetVehicleID(carid);
	if(number == INVALID_VEHICLE_ID) return 1;
	player_ShowID[playerid][0] = category;
	player_ShowID[playerid][1] = itemID;


	new type = -1;

	switch(category)
	{
		case 0: //покраска
		{
			type = -1;
			//if(GetStrMoney(playerid) < 1350000)
			if(CompareInt64(playerid, "<", 1350000))
			{
				GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
				return SCM(playerid, 0x999999FF, !"Недостаточно денег");
			}
			GivePlayerMoneyEx(playerid, -1350000, "tuning center");
			if(player_BizEntered[playerid] != -1)
			{
				GiveBusinessMoney(playerid, player_BizEntered[playerid], 135000, -10);
			}

			if(player_ShowData[playerid][111] == 0) 
			{
				VehicleData[carid][V_COLOR_1] = itemID;
				CarData[number][cColor][0] = itemID;
			}
			else 
			{
				VehicleData[carid][V_COLOR_2] = itemID;
				CarData[number][cColor][1] = itemID;
			}
			// save data
			str_1[0] = EOS;
			for(new i; i < 2; i++)
			{
				f(str_1, sizeof(str_1), "%s%i,", str_1, CarData[number][cColor][i]);
			}
			UpdateDataStr("OwnableCars", "Color", str_1, CarData[number][cID]);
		}
		case 1: //выхлоп
		{
			type = 2;
		}
		case 2: //гидравлика
		{
			type = 8;
		}
		case 3: //остальное
		{
			if(player_ShowData[playerid][itemID] == -2)
			{
				type = 5;
			}
			else
			{
				for(new i; i < sizeof(TuningStaticData); i++)
				{
					if(TuningStaticData[i][gtModelID] != CarData[number][cModel]) continue;

					if(strfind(TuningStaticData[i][gtName], "Выхлоп", false) != -1 ||
						strfind(TuningStaticData[i][gtName], "Спойлер", false) != -1 || TuningStaticData[i][gtModelID] < 1) continue;

					if(i == player_ShowData[playerid][itemID])
					{
						type = TuningStaticData[i][gtType];
						break;
					}
				}
			}
		}
		case 4: //спойлер
		{
			type = 1;
		}
		case 5: //гудок
		{
			type = -1;
			str_mes[0] = EOS, sscanf(TuningStaticData[ player_ShowData[playerid][itemID] ][gtName],"p<|>s[24]i", str_mes, str_d[0]);
			VehicleData[carid][vTuning][10] = str_d[0];
			CarData[number][cTuning][10] = str_d[0];
		}
		default: return 1;
	}
	if(type != -1 && carid != -1)
	{
		if(player_ShowData[playerid][itemID] == -2)
		{
			VehicleData[carid][vTuning][type] = -1;
			CarData[number][cTuning][type] = -1;
			//if(GetStrMoney(playerid) < 15000000)
			if(CompareInt64(playerid, "<", 15000000))
			{
				GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
				return SCM(playerid, 0x999999FF, !"Недостаточно денег");
			}
			GivePlayerMoneyEx(playerid, -15000000, "tuning center");
			SaveOwnableCars_Tuning(number);
		}
		else if(!(player_ShowData[playerid][itemID] < 1 || player_ShowData[playerid][itemID] >= sizeof(TuningStaticData)))
		{
			new cost = TuningStaticData[player_ShowData[playerid][itemID]][gtCost];
			if(player_BizEntered[playerid] != -1)
			{
				cost = cost*BizData[player_BizEntered[playerid]][bProductEx];
				GiveBusinessMoney(playerid, player_BizEntered[playerid], cost/5, -1);
			}
			if(CompareInt64(playerid, "<", cost))
			//if(GetStrMoney(playerid) < cost)
			{
				GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
				return SCM(playerid, 0x999999FF, !"Недостаточно денег");
			}
			GivePlayerMoneyEx(playerid, -cost, "tuning center");
			CarData[number][cTuning][type] = player_ShowData[playerid][itemID];
			SaveOwnableCars_Tuning(number);
		}
	}
	for(new i; i < 12; i++) VehicleData[carid][vTuning][i] = CarData[number][cTuning][i];
	UpdateVehicleTuning(carid, playerid);
	return 1;
}
stock SaveOwnableCars_Tuning(number)
{
	if(!Iter_Contains(OWNABLECARS, number)) return 0;
	str_1[0] = EOS;
	for(new i; i < 12; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, CarData[number][cTuning][i]);
	}
	UpdateDataStr("OwnableCars", "Tuning", str_1, CarData[number][cID]);
	return 1;
}
stock OnVehicleHornSound_Enable(vehicleid, playerid = INVALID_PLAYER_ID)
{
	if(!Iter_Contains(Vehicles, vehicleid)) return 0;
	static Float:x, Float:y, Float:z;
	GetVehiclePos(vehicleid, x, y, z);
	str_1[0] = EOS, f(str_1, sizeof(str_1), "\
		window.createSound(%i, 'car/horn/sound_%i.mp3', \
		%.2f, %.2f, %.2f, 0.80, 5.00, 90.00, true, true) || \
		window.attachSoundToVehicle(%i, %i, 0.00, 0.00, 0.00, 0.00)", \
			vehicleid, VehicleData[vehicleid][vTuning][10], \
			x, y, z, vehicleid, vehicleid);

	if(playerid == INVALID_PLAYER_ID)
	{
		foreach(new i: VehiclePlayersStream[vehicleid]) 
		{
			ExecutePacket(i, webUpdate, str_1);
		}
	}
	else ExecutePacket(playerid, webUpdate, str_1);
	return 1;
}
stock OnVehicleHornSound_Disable(vehicleid, playerid = INVALID_PLAYER_ID)
{
	if(!Iter_Contains(Vehicles, vehicleid)) return 0;
	str_1[0] = EOS, f(str_1, sizeof(str_1), "window.destroySound(%i, 30)", vehicleid);
	if(playerid == INVALID_PLAYER_ID)
	{
		foreach(new i: VehiclePlayersStream[vehicleid]) 
		{
			ExecutePacket(i, webUpdate, str_1);
		}
	}
	else ExecutePacket(playerid, webUpdate, str_1);
	return 1;
}
stock tsd_GetName(const name[])
{
	for(new i; i < sizeof(TuningStaticData); i++)
	{
		if(GetString(TuningStaticData[i][gtName], name)) return i;
	}
	return 0;
}
stock player_TintingGarage_Open(playerid, id)
{
	if(OpenInterface[playerid][17]) return 1;
	OpenInterface[playerid][17] = true;
	player_TintingEntered[playerid] = id;
	TogglePlayerControllable(playerid, false);
	ExecutePacket(playerid, webClose, "TintingOrder");
	ExecutePacket(playerid, webOpen, "TintingOrder");
	ExecutePacket(playerid, webUpdate, "interface('TintingOrder').getPrice(0)");

	player_BizEntered[playerid] = player_SearchNearestBusiness(playerid);
	player_EnterBiz[playerid] = -1;
	new vehicleid = GetPlayerVehicleID(playerid);
	LinkVehicleToInterior(vehicleid, 3);
	SetPlayerInterior(playerid, 3);

	SetPlayerVirtualWorld(playerid, playerid+1000);
	SetVehicleVirtualWorld(vehicleid, playerid+1000);

	SetVehiclePos(vehicleid, -6.6451997756958, 503.99349975586, 1000.6854248047);
	SetVehicleZAngle(vehicleid, 178.81390380859);
	
	SetPlayerCameraPos(playerid, -3.6451997756958, 498.79733276367, 1001.8854370117);
	SetPlayerCameraLookAt(playerid, -6.6451997756958, 501.99349975586, 1001.2854003906, 2);
	return 1;
}
stock player_TintingMenu_Hide(playerid)
{
	if(!OpenInterface[playerid][17]) return 1;
	//player_TintingEntered
	new id = player_TintingEntered[playerid];
	if(id != -1)
	{
		ExecutePacket(playerid, webClose, "TintingOrder");
		OpenInterface[playerid][17] = false;
		player_BizEntered[playerid] = -1;
		player_EnterBiz[playerid] = -1;
		player_TintingEntered[playerid] = -1;
		new vehicleid = GetPlayerVehicleID(playerid);
		LinkVehicleToInterior(vehicleid, 0);
		SetPlayerInterior(playerid, 0);

		SetPlayerVirtualWorld(playerid, 0);
		SetVehicleVirtualWorld(vehicleid, 0);
		static const Float:TintingList_Leave[][] = {
			{-2516.7180175781, 1138.5734863281, 8.4455003738403, 70.207496643066},
			{1793.76953125, 2360.1450195313, 15.04640007019, 302.70059204102},
			{2222.9389648438, -2574.169921875, 21.648599624634, 359.37350463867}
		};
		SetVehiclePos(vehicleid, TintingList_Leave[id][0], TintingList_Leave[id][1], TintingList_Leave[id][2]);
		SetVehicleZAngle(vehicleid, TintingList_Leave[id][3]);
		SetCameraBehindPlayer(playerid);
		TogglePlayerControllable(playerid, true);
	}
	return 1;
}

stock ExecutePacket_CarTinted(playerid, vehicleid, id_glass, color, color1, color2, procent)
{
    new
        BitStream:bsn = BS_New();

    BS_WriteValue(bsn, 
			PR_UINT8, 215,
			PR_UINT16, 12,
			PR_UINT32, vehicleid,
			PR_UINT32, id_glass,
			PR_UINT8, color,
			PR_UINT8, color1,
			PR_UINT8, color2,
			PR_UINT8, procent);

    PR_SendPacket(bsn, playerid);
    BS_Delete(bsn);
	return 1;
}
stock UpdateVehicleTinting(vehicleid, playerid = INVALID_PLAYER_ID, bool:newdata = false)
{
	if(!Iter_Contains(Vehicles, vehicleid)) return 0;
	for(new i; i < 3; i++)
	{
		//check color
		if(VehicleTinted[vehicleid][0][i] < 1 || VehicleTinted[vehicleid][0][i] > 8) 
		{
			if(!newdata) ExecutePacket_CarTinted(playerid, vehicleid, i, 0, 0, 0, 10);
			continue;
		}
		//check percent
		if(VehicleTinted[vehicleid][1][i] < 10) VehicleTinted[vehicleid][1][i] = 10;
		else if(VehicleTinted[vehicleid][1][i] > 254) VehicleTinted[vehicleid][1][i] = 255;
		//
		if(playerid == INVALID_PLAYER_ID) 
		{
			foreach(new id: VehiclePlayersStream[vehicleid]) 
			{
				ExecutePacket_CarTinted(id, vehicleid, i, \
						InfoRGB[VehicleTinted[vehicleid][0][i]][0], \
						InfoRGB[VehicleTinted[vehicleid][0][i]][1], \
						InfoRGB[VehicleTinted[vehicleid][0][i]][2], VehicleTinted[vehicleid][1][i]);
			}
		}
		else ExecutePacket_CarTinted(playerid, vehicleid, i, \
					InfoRGB[VehicleTinted[vehicleid][0][i]][0], \
					InfoRGB[VehicleTinted[vehicleid][0][i]][1], \
					InfoRGB[VehicleTinted[vehicleid][0][i]][2], VehicleTinted[vehicleid][1][i]);
	}
	return 1;
}
stock ClearVehicleParams(vehicleid)
{
	if(!IsValidVehicleID(vehicleid)) return 0;
	ClearTintingParams(vehicleid);
	return 1;
}
stock SaveOwnableCars_Tinted(number)
{
	if(!Iter_Contains(OWNABLECARS, number)) return 0;
	str_1[0] = EOS, str_2[0] = EOS;
	for(new i; i < 3; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, CarTinted[number][0][i]);
		f(str_2, sizeof(str_2), "%s%i,", str_2, CarTinted[number][1][i]);
	}
	UpdateDataStr("OwnableCars", "Tinted_0", str_1, CarData[number][cID]);
	UpdateDataStr("OwnableCars", "Tinted_1", str_2, CarData[number][cID]);
	return 1;
}
stock EnterPlayerToGarage(playerid, id)
{
	SetPlayerPosEx(playerid, \
		GarageStaticData[GarageData[id][gInterior]][gsExit][0], GarageStaticData[GarageData[id][gInterior]][gsExit][1], GarageStaticData[GarageData[id][gInterior]][gsExit][2], GarageStaticData[GarageData[id][gInterior]][gsExit][3], \
		GarageStaticData[GarageData[id][gInterior]][gsInterior], id+7, false);
	player_GarageEntered[playerid] = id;
	player_EnterGarage[playerid] = -1;
