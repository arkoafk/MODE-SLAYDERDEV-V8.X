	cache_get_string(id, "ObjectPos_rX", str_1), sscanf(str_1, "p<,>a<f>[9]", CarData[uid][cObjectPos_rX]);
	str_1[0] = EOS;
	cache_get_string(id, "ObjectPos_rY", str_1), sscanf(str_1, "p<,>a<f>[9]", CarData[uid][cObjectPos_rY]);
	str_1[0] = EOS;
	cache_get_string(id, "ObjectPos_rZ", str_1), sscanf(str_1, "p<,>a<f>[9]", CarData[uid][cObjectPos_rZ]);
	cache_get_int(id, !"Pneuma", CarData[uid][cPneuma]);
	cache_get_float(id, !"Pneuma_far", CarData[uid][cPneuma_far]);
	cache_get_float(id, !"Pneuma_fr", CarData[uid][cPneuma_fr]);
	cache_get_string(id, "RegNumber_String", CarData[uid][cRegNumber_String]);

	cache_get_int(id, !"Stage_RadUsed", CarData[uid][cStage_RadUsed]);
	str_1[0] = EOS;
	cache_get_string(id, "Stage_RadPos", str_1), sscanf(str_1, "p<,>a<f>[6]", CarData[uid][cStage_RadPos]);
	//
	cache_get_int(id, !"Stage_ExhUsed", CarData[uid][cStage_ExhUsed]);
	str_1[0] = EOS;
	cache_get_string(id, "Stage_ExhPos", str_1), sscanf(str_1, "p<,>a<f>[6]", CarData[uid][cStage_ExhPos]);
	//
	cache_get_int(id, !"Stage_TurUsed", CarData[uid][cStage_TurUsed]);
	str_1[0] = EOS;
	cache_get_string(id, "Stage_TurPos", str_1), sscanf(str_1, "p<,>a<f>[6]", CarData[uid][cStage_TurPos]);
	//
	cache_get_int(id, !"Stage_SupUsed", CarData[uid][cStage_SupUsed]);
	str_1[0] = EOS;
	cache_get_string(id, "Stage_SupPos", str_1), sscanf(str_1, "p<,>a<f>[6]", CarData[uid][cStage_SupPos]);
	cache_get_float(id, !"Stage_Inversion", CarData[uid][cStage_Inversion]);
	trunk_LoadInventory(id, uid);
	Iter_Add(OWNABLECARS, uid);
	return 1;
}
public: LoadOwnableCar(last_exit)
{
	for(new i, end = cache_num_rows(); i < end; i++) 
	{
		new uid = Iter_Free(OWNABLECARS);
		if(uid != -1)
		{
			if(!LoadOwnableCarMySQL(i, uid))
			{
				printf("[LoadOwnableCar] error -> LoadOwnableMySQL(%i,%i)", i, uid);
				return 0;
			}
			mysql_query(mysql, (str_f("UPDATE `OwnableCars` SET `VehicleID` = '%i' WHERE `ID` = '%i' LIMIT 1;", uid, CarData[uid][cID])), false);
			if(!last_exit)
			{
				OwnableCar[uid] = AddStaticVehicleEx(CarData[uid][cModel], \
						CarData[uid][cPos][0], CarData[uid][cPos][1], CarData[uid][cPos][2], CarData[uid][cPos][3], \
						CarData[uid][cColor][0], CarData[uid][cColor][1], -1);
			}
			else
			{
				new Float:position[4];
				for(new j; j < 4; j++)
				{
					position[j] = CarData[uid][cPos][j];
				}
				str_1[0] = EOS, cache_get_string(i, "Last_Position", str_1), sscanf(str_1, "p<,>a<f>[4]", position);
				OwnableCar[uid] = AddStaticVehicleEx(CarData[uid][cModel], \
						position[0], position[1], position[2], position[3], \
						CarData[uid][cColor][0], CarData[uid][cColor][1], -1);
			}
			UpdateCarData(OwnableCar[uid]);
			if(CarData[uid][cOwner_Type] == 0)
			{
				for(new j; j < 9; j++) 
				{
					UpdateCarObject(uid, j);
					if(j < 4)
					{
						UpdateCarObject_Stage(uid, j);
					}
				}
			}
		}
		else
		{
			printf("[LoadOwnableCar] error -> LoadOwnableMySQL == -1(%i)", i);
			return 0;
		}
	}
	return 1;
}
stock UnLoadOwnableCars(const name[])
{
	foreach(new i: OWNABLECARS)
	{
		if(GetString(CarData[i][cOwner], name)) SafeRemoveCar(i, i, true);
	}
	return 1;
}
stock SafeRemoveCar(number, &next, bool:hard = false)
{
	if(IsAOwnableCar(number))
	{
		for(new i; i < 9; i++) 
		{
			SafeDestroyCarObject(number, i);
			if(i < 4)
			{
				SafeDestroyCarObject_Stage(number, i);
			}
		}
		UpdateCarData_Sync(number, true);
		new Float:x, Float:y, Float:z, Float:a, time;
		if(hard != false)
		{
			GetVehiclePos(OwnableCar[number], x, y, z);
			GetVehicleZAngle(OwnableCar[number], a);
			time = global_time;
		}
		mysql_query(mysql, (str_f("UPDATE `OwnableCars` SET `VehicleID` = '-1', `Fuel` = '%f', `Wash` = '%f', `Wear` = '%f', `Mileage` = '%f', `Last_Position` = '%.2f,%.2f,%.2f,%.2f,', `Last_LoginTime` = '%i' WHERE `ID` = '%i' LIMIT 1;", \
				VehicleData[OwnableCar[number]][V_FUEL], VehicleData[OwnableCar[number]][vWash], VehicleData[OwnableCar[number]][vWear],\
				VehicleData[OwnableCar[number]][V_MILEAGE], x, y, z, a, time, CarData[number][cID])), false);
		DestroyVehicle(OwnableCar[number], OwnableCar[number], "unloadcar"), print("destroy vehicle SafeRemoveCar aa");
		ResetCarArrays(number);
		Iter_SafeRemove(OWNABLECARS, number, next);
	}
	return 1;
}
stock ResetCarArrays(number)
{
	CarData[number][cID] = -1;
	SetString(CarData[number][cOwner], "The State");
	SetString(CarData[number][cNumber_String], "-");
	SetString(CarData[number][cRegNumber_String], "-");
	CarData[number][cNumber_Type] = -1;
	CarData[number][cModel] = 400;
	for(new i; i < 2; i++) CarData[number][cColor][i] = 0;
	CarData[number][cAlarmON] = false;
	CarData[number][cKeyIN] = false;
	OwnableCar[number] = INVALID_VEHICLE_ID;
	return 1;
}
stock UpdateCarData(vehicleid, bool:sync=false)
{
	new number = GetVehicleID(vehicleid);
    if(IsAOwnableCar(number))
	{
		if(IsValidDynamic3DTextLabel(NumberCar[number]) || NumberCar[number] != Text3D:-1)
		{
			DestroyDynamic3DTextLabel(NumberCar[number]);
			NumberCar[number] = Text3D:-1;
		}
		if(GetString(CarData[number][cOwner], "The State"))
		{
			NumberCar[number] = CreateDynamic3DTextLabel(!"РОЗЫГРЫШ\nСядь в машину, чтобы забрать её!", 0xd62515FF, 0.0000, 0.0000, 1.3000, 20.0, INVALID_PLAYER_ID, vehicleid);
		}
		else if(IsAMoto(vehicleid) || IsABike(vehicleid)) 
		{
			NumberCar[number] = CreateDynamic3DTextLabel(!"[номера нет]", 0xFFFF00EE, 0.0000, 0.0000, 1.3000, 20.0, INVALID_PLAYER_ID, vehicleid);
		}
		for(new i; i < 12; i++) 
		{
			VehicleData[vehicleid][vTuning][i] = CarData[number][cTuning][i];
			if(i < 3)
			{
				VehicleTinted[vehicleid][0][i] = CarTinted[number][0][i];

				if(CarTinted[number][1][i] < 10) CarTinted[number][1][i] = 10;
				else if(CarTinted[number][1][i] > 255) CarTinted[number][1][i] = 255;
				VehicleTinted[vehicleid][1][i] = CarTinted[number][1][i];
			}
		}
		UpdateCarData_Sync(number, sync);
		ownableCars_SetStage(number);
		ownableCars_SetPneuma(number);
		SetVehicleVirtualWorld(vehicleid, CarData[number][cVirtualWorld]);
		LinkVehicleToInterior(vehicleid, CarData[number][cInterior]);
		sync_UpdateVehicle(vehicleid);
	}
	return number;
}
stock UpdateCarData_Sync(number, bool:sync)
{
	if(number == INVALID_VEHICLE_ID) return 0;
	new vehicleid = OwnableCar[number];
	if(!sync)
	{
		VehicleData[vehicleid][vNumber_Type] = CarData[number][cNumber_Type];
		SetString(VehicleData[vehicleid][vNumber_String], CarData[number][cNumber_String]);
		VehicleData[vehicleid][V_FUEL] = CarData[number][cFuel];
		VehicleData[vehicleid][vWash] = CarData[number][cWash];
		VehicleData[vehicleid][vWear] = CarData[number][cWear];
		VehicleData[vehicleid][V_MILEAGE] = CarData[number][cMileage];
	}
	else
	{
		CarData[number][cFuel] = VehicleData[vehicleid][V_FUEL];
		CarData[number][cWash] = VehicleData[vehicleid][vWash];
		CarData[number][cWear] = VehicleData[vehicleid][vWear];
		CarData[number][cMileage] = VehicleData[vehicleid][V_MILEAGE];
		UpdateDataFloat("OwnableCars", "Fuel", VehicleData[vehicleid][V_FUEL], CarData[number][cID]);
	}
	return 1;
}
stock sync_UpdateVehicle(vehicleid, bool:newdata=false, playerid = INVALID_PLAYER_ID)
{
	if(IsAMoto(vehicleid) || IsABike(vehicleid) || IsANumber(vehicleid)) return 0;
	UpdateVehicleTinting(vehicleid, playerid, newdata);
	UpdateVehicleNumber(vehicleid, playerid, newdata);
	UpdateVehicleTuning(vehicleid, playerid);
	UpdateVehicleHadlingEx(vehicleid, playerid);
	UpdateVehicleStrob(vehicleid, playerid);
	return 1;
}
stock GetVehicleID(carid) 
{
	if(carid == INVALID_VEHICLE_ID) return INVALID_VEHICLE_ID; 
	foreach(new i: OWNABLECARS) if(OwnableCar[i] == carid) return i; 
	return INVALID_VEHICLE_ID;
}
stock IsAOwnableCar(number)
{
	if(number == INVALID_VEHICLE_ID || number == -1) return 0;
	if(Iter_Contains(OWNABLECARS, number)) return 1;
    return 0;
}
public: LoadHouseMySQL(id)
{
	for(new j; j < 24; j++) RefreshInvHouse(id, j);
	cache_get_int(id, "ID", HouseData[TOTAL_HOUSES][hID]);
	cache_get_string(id, "Owner", HouseData[TOTAL_HOUSES][hOwner]);

	cache_get_int(id, "Cost", HouseData[TOTAL_HOUSES][hCost]);
	cache_get_int(id, "Level", HouseData[TOTAL_HOUSES][hLevel]);
	cache_get_int(id, "Interior", HouseData[TOTAL_HOUSES][hInterior]);
	cache_get_int(id, "Lock", HouseData[TOTAL_HOUSES][hLock]);

	cache_get_string(id, !"Enter", str_2), sscanf(str_2, "p<,>a<f>[3]", HouseData[TOTAL_HOUSES][hEnter]);
	cache_get_string(id, !"Store", str_2), sscanf(str_2, "p<,>a<f>[3]", HouseData[TOTAL_HOUSES][hStore]);
	house_LoadInventory(id, TOTAL_HOUSES);
	cache_get_int(id, "Nalog", HouseData[TOTAL_HOUSES][hNalog]);
	
	cache_get_string(id, "Object_Model", str_2), sscanf(str_2, "p<,>a<i>[10]", HouseData[TOTAL_HOUSES][hObject_Model]);

	cache_get_string(id, "Object_Position_X", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_X]);
	cache_get_string(id, "Object_Position_Y", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_Y]);
	cache_get_string(id, "Object_Position_Z", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_Z]);

	cache_get_string(id, "Object_Position_rX", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_rX]);
	cache_get_string(id, "Object_Position_rY", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_rY]);
	cache_get_string(id, "Object_Position_rZ", str_2), sscanf(str_2, "p<,>a<f>[10]", HouseData[TOTAL_HOUSES][hObject_Position_rZ]);
	
	cache_get_string(id, "Object_Interior", str_2), sscanf(str_2, "p<,>a<i>[10]", HouseData[TOTAL_HOUSES][hObject_Interior]);
	cache_get_string(id, "Object_VirtualWorld", str_2), sscanf(str_2, "p<,>a<i>[10]", HouseData[TOTAL_HOUSES][hObject_VirtualWorld]);
	cache_get_int(id, "Auction_Bet", HouseData[TOTAL_HOUSES][hAuction_Bet]);
	cache_get_string(id, "Auction_Owner", HouseData[TOTAL_HOUSES][hAuction_Owner]);
	HouseData[TOTAL_HOUSES][hGang_FamilyID] = -1;
	cache_get_int(id, "VirtualWorld_ID", HouseData[TOTAL_HOUSES][hVirtualWorld_ID]);
	cache_get_int(id, "Interior_ID", HouseData[TOTAL_HOUSES][hInterior_ID]);

	cache_get_int(id, "Entrance_ID", HouseData[TOTAL_HOUSES][hEntrance_ID]);
	cache_get_int(id, "Entrance_List", HouseData[TOTAL_HOUSES][hEntrance_List]);
	//
	for(new i; i < 10; i++)
	{
		UpdateHouse_Object(TOTAL_HOUSES, i);
	}
	UpdateHouse(TOTAL_HOUSES, true);
	UpdateHouse_Store(TOTAL_HOUSES, false);
	TOTAL_HOUSES++;
	return 1;
}
stock UpdateHouse(id, bool:set)
{
	//delete old data
	/*
	cache_get_int(id, "VirtualWorld_ID", HouseData[TOTAL_HOUSES][hVirtualWorld_ID]);
	cache_get_int(id, "Interior_ID", HouseData[TOTAL_HOUSES][hInterior_ID]);
	*/
	if(IsValidDynamicMapIcon(House_EnterMapIcon[id]) || House_EnterMapIcon[id] != -1) DestroyDynamicMapIcon(House_EnterMapIcon[id]), House_EnterMapIcon[id] = -1;
	if(IsValidDynamicPickup(House_EnterPickup[id]) && House_EnterPickup[id] != -1) DestroyDynamicPickup(House_EnterPickup[id]), House_EnterPickup[id] = -1;
	else if(IsValidDynamicCP(House_EnterPickup[id]) && House_EnterPickup[id] != -1) DestroyDynamicCP(House_EnterPickup[id]), House_EnterPickup[id] = -1;
	if(HouseData[id][hEnter][0] > 3990.0 || HouseData[id][hEnter][0] < -3990.0 || HouseData[id][hEnter][1] > 3990.0 || HouseData[id][hEnter][1] < -3990.0)
	{
		House_EnterPickup[id] = CreateDynamicCP(HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], 1.5, HouseData[id][hVirtualWorld_ID], HouseData[id][hInterior_ID], -1, 15.0);
	}
	else
	{
		if(HouseData[id][hVirtualWorld_ID] == 0)
		{
			House_EnterPickup[id] = CreateDynamicPickup((!IsHouseOwned(id) ? 1273 : 1272), 64, HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], HouseData[id][hVirtualWorld_ID], HouseData[id][hInterior_ID]);
		}
		else
		{
			House_EnterPickup[id] = CreateDynamicPickup(19197, 64, HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], HouseData[id][hVirtualWorld_ID], HouseData[id][hInterior_ID]);
		}
	}
	if(set)
	{
		if(IsValidDynamicArea(House_EnterArea[id])) DestroyDynamicArea(House_EnterArea[id]), House_EnterArea[id] = -1;
		House_EnterArea[id] = CreateDynamicSphere(HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], 2.0, HouseData[id][hVirtualWorld_ID], HouseData[id][hInterior_ID]);
	}
	if(HouseData[id][hVirtualWorld_ID] == 0)
	{
		House_EnterMapIcon[id] = CreateDynamicMapIcon(HouseData[id][hEnter][0], HouseData[id][hEnter][1], HouseData[id][hEnter][2], (!IsHouseOwned(id) ? 31 : 32), 0, 0, 0, -1, 300.0);
	}
	return 1;
}
stock UpdateHouse_Store(id, bool:save=false)
{
	if(id < 0 || id > TOTAL_HOUSES-1) return 0;
	if(IsValidDynamic3DTextLabel(House_Store[id])) DestroyDynamic3DTextLabel(House_Store[id]), House_Store[id] = Text3D:-1;
	if(IsValidDynamicPickup(House_StorePickup[id])) DestroyDynamicPickup(House_StorePickup[id]), House_StorePickup[id] = -1;
	if(IsValidHouse_Store(id) == 3)
	{
		if(HouseData[id][hGang_FamilyID] == -1)
		{
			House_Store[id] = CreateDynamic3DTextLabel(!"{F0DF00}Домашний шкаф \n{FFFFFF}Используйте {F0DF00}/use {FFFFFF}для использования", -1, HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2], 10.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, id+5, -1);
		}
		else
		{
			new idEx = GetFamilyID(HouseData[id][hGang_FamilyID]);
			if(idEx >= 0)
			{
				if(FamilyData[idEx][fGang_BaseID] == id)
				{
					str_1[0] = EOS, f(str_1, sizeof(str_1), "\
						Склад\n\
						{%s}%s\n\n\
						{FFFFFF}Наркотики:   {FF9900}0 из 20000 г\n\
						{FFFFFF}Патроны:   {FF9900}0 из 50000 шт\n\
						{FFFFFF}Материалы:   {FF9900}0 из 50000 кг\n\
						{FFFFFF}Деньги:   {3366FF}%i руб", FamilyColorData[FamilyData[idEx][fColor]], FamilyData[idEx][fName], FamilyData[idEx][fBalance]);
					House_Store[id] = CreateDynamic3DTextLabel(str_1, 0xFFCD00FF, HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2]+1.5, 10.0000, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, id+5, -1);
					House_StorePickup[id] = CreateDynamicPickup(1239, 64, HouseData[id][hStore][0], HouseData[id][hStore][1], HouseData[id][hStore][2], id+5);
				}
				else HouseData[id][hGang_FamilyID] = -1;
			}
			else HouseData[id][hGang_FamilyID] = -1;
		}
		if(save)
		{
			str_1[0] = EOS;
			for(new i; i < 3; i++) f(str_1, sizeof(str_1), "%s%.2f,", str_1, HouseData[id][hStore][i]);
			UpdateDataStr("Houses", "Store", str_1, HouseData[id][hID]);
		}
	}
	return 1;
}
public: LoadHouses()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++)
	{
		stat = LoadHouseMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[Houses]: Домов загружено -> %i", TOTAL_HOUSES);
	else printf("[Houses]: UNKNOWN ( all stat -> %i)", TOTAL_HOUSES);

	if(!IsValidDynamicArea(House_ExitArea[0]))
	{
		for(new i; i < sizeof(HouseStaticData); i++)
		{
			House_ExitArea[i] = CreateDynamicSphere(HouseStaticData[i][hsExit][0], HouseStaticData[i][hsExit][1], HouseStaticData[i][hsExit][2], 2.0, -1, HouseStaticData[i][hsInterior]);
			House_HealthPickup[i] = CreateDynamicPickup(1240, 23, HouseStaticData[i][hsHealth][0], HouseStaticData[i][hsHealth][1], HouseStaticData[i][hsHealth][2], -1, HouseStaticData[i][hsInterior]);
		}
	}
	LoadGates();
	mysql_tquery(mysql, "SELECT * FROM `Familys` ORDER BY `ID` ASC", "LoadFamilys", ""); //next load business
	mysql_tquery(mysql, "SELECT * FROM `Entrance` ORDER BY `ID` ASC", "LoadEntrance", ""); //iter -> family -> business
	return 1;
}
//businesses
public: LoadBusinesses()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++)
	{
		stat = LoadBusinessMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[Businesses]: Бизнесов загружено -> %i", TOTAL_BUSINESSES);
	else printf("[Businesses]: UNKNOWN ( all stat -> %i)", TOTAL_BUSINESSES);
	if(!IsValidDynamicArea(Biz_ExitArea[0]))
	{
		for(new i; i < TOTAL_BUSINESSES; i++)
		{
			if(BizData[i][bType] == 16)
			{
				ApplyDynamicActorAnimation(CreateDynamicActor(141, 222.16400146484, -324.17440795898, 1011.015625, 127.55110168457, 100, 1, i+5, 5), "COP_AMBIENT", "Coplook_loop", 4.0, 176, 0, 0, 0, 0);
			}
		}
		for(new i; i < sizeof(BizStaticData); i++)
		{
			//exit
			if(BizStaticData[i][bsExit][0] != 0.0)
			{
				Biz_ExitArea[i] = CreateDynamicSphere(BizStaticData[i][bsExit][0], BizStaticData[i][bsExit][1], BizStaticData[i][bsExit][2], 3.0, -1, BizStaticData[i][bsInterior]);
				CreateDynamicPickup(19132, 23, BizStaticData[i][bsExit][0], BizStaticData[i][bsExit][1], BizStaticData[i][bsExit][2], -1, BizStaticData[i][bsInterior]);
			}
			//buy
			if(BizStaticData[i][bsBuy][0] != 0.0 && BizStaticData[i][bsBuyID] != 0)
			{
				Biz_BuyArea[i] = CreateDynamicSphere(BizStaticData[i][bsBuy][0], BizStaticData[i][bsBuy][1], BizStaticData[i][bsBuy][2], 1.5, -1, BizStaticData[i][bsInterior]);
				CreateDynamicPickup(BizStaticData[i][bsBuyID], 23, BizStaticData[i][bsBuy][0], BizStaticData[i][bsBuy][1], BizStaticData[i][bsBuy][2], -1, BizStaticData[i][bsInterior]);
			}
			//health
			if(BizStaticData[i][bsHealth] != 0.0) 
			{
				Biz_HealthArea[i] = CreateDynamicSphere(BizStaticData[i][bsHealth][0], BizStaticData[i][bsHealth][1], BizStaticData[i][bsHealth][2], 1.5, -1, BizStaticData[i][bsInterior]);
				CreateDynamicPickup(1240, 23, BizStaticData[i][bsHealth][0], BizStaticData[i][bsHealth][1], BizStaticData[i][bsHealth][2], -1, BizStaticData[i][bsInterior]);
			}
		}
	}

	//bank static data
	if(!IsValidDynamicArea(BankStaticData[0]))
	{
		CreateDynamic3DTextLabel(!"/bank", 0xCC00FF, 301.5029, 304.1625, 1001.8000, 8.0000);
		CreateDynamicPickup(1274, 64, 301.5029, 304.1625, 1001.0000);
		BankStaticData[0] = CreateDynamicSphere(301.5029, 304.1625, 1001.0000, 1.4, -1, 5);

		CreateDynamic3DTextLabel(!"Оплата\n{CCCC00}дома\nгаража\nбизнеса\nналогов\nкиоска\nогорода\nнефтенасоса", 0x66CC66FF, 294.7615, 304.1995, 1001.8000, 8.0000);
		CreateDynamicPickup(1274, 64, 294.7615, 304.1995, 1001.0000);
		BankStaticData[1] = CreateDynamicSphere(294.7615, 304.1995, 1001.0000, 1.4, -1, 5);
	}
	LoadCarriers();
	return 1;
}
stock iter_SearchNearestBusiness(type, Float:x, Float:y, Float:z)
{
	new Float:Distance, Float:Distance_ = 100000.0, bizid;
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(BizData[i][bType] != type) continue;
		Distance = DistancePointToPoint(x, y, z, BizData[i][bEnter][0], BizData[i][bEnter][1], BizData[i][bEnter][2]);
		if(Distance < Distance_) bizid = i, Distance_ = Distance;
	}
	return bizid;
}
public: LoadBusinessMySQL(id)
{
	cache_get_int(id, !"ID", BizData[TOTAL_BUSINESSES][bID]);
	cache_get_string(id, !"Owner", BizData[TOTAL_BUSINESSES][bOwner]);
	cache_get_string(id, !"Name", BizData[TOTAL_BUSINESSES][bName]);
	if(GetString(BizData[TOTAL_BUSINESSES][bName], "null")) SetString(BizData[TOTAL_BUSINESSES][bName], "");
	cache_get_string(id, !"Enter", str_2), sscanf(str_2, "p<,>a<f>[3]", BizData[TOTAL_BUSINESSES][bEnter]);
	cache_get_int(id, !"EnterMusic", BizData[TOTAL_BUSINESSES][bEnterMusic]);
	cache_get_int(id, !"Energy", BizData[TOTAL_BUSINESSES][bEnergy]);
	cache_get_int(id, !"Cost", BizData[TOTAL_BUSINESSES][bCost]);
	cache_get_int(id, !"Nalog", BizData[TOTAL_BUSINESSES][bNalog]);
	cache_get_int(id, !"Type", BizData[TOTAL_BUSINESSES][bType]);
	cache_get_int(id, !"Products", BizData[TOTAL_BUSINESSES][bProducts]);
	cache_get_int(id, !"ProductEx", BizData[TOTAL_BUSINESSES][bProductEx]);
	cache_get_int(id, !"Balance", BizData[TOTAL_BUSINESSES][bBalance]);
	BizData[TOTAL_BUSINESSES][bBalance_ForDay] = 0;
	cache_get_int(id, !"Level", BizData[TOTAL_BUSINESSES][bLevel]);
	cache_get_int(id, !"Lock", BizData[TOTAL_BUSINESSES][bLock]);
	cache_get_int(id, !"EnterPrice", BizData[TOTAL_BUSINESSES][bEnterPrice]);
	cache_get_int(id, !"GangRoof_ID", BizData[TOTAL_BUSINESSES][bGangRoof_ID]);

	cache_get_string(id, "Object_Model", str_2), sscanf(str_2, "p<,>a<i>[10]", BizData[TOTAL_BUSINESSES][bObject_Model]);

	cache_get_string(id, "Object_Position_X", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_X]);
	cache_get_string(id, "Object_Position_Y", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_Y]);
	cache_get_string(id, "Object_Position_Z", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_Z]);

	cache_get_string(id, "Object_Position_rX", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_rX]);
	cache_get_string(id, "Object_Position_rY", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_rY]);
	cache_get_string(id, "Object_Position_rZ", str_2), sscanf(str_2, "p<,>a<f>[10]", BizData[TOTAL_BUSINESSES][bObject_Position_rZ]);
	
	cache_get_string(id, "Object_Interior", str_2), sscanf(str_2, "p<,>a<i>[10]", BizData[TOTAL_BUSINESSES][bObject_Interior]);
	cache_get_string(id, "Object_VirtualWorld", str_2), sscanf(str_2, "p<,>a<i>[10]", BizData[TOTAL_BUSINESSES][bObject_VirtualWorld]);
	cache_get_int(id, "Auction_Bet", BizData[TOTAL_BUSINESSES][bAuction_Bet]);
	cache_get_string(id, "Auction_Owner", BizData[TOTAL_BUSINESSES][bAuction_Owner]);
	cache_get_int(id, "Rating", BizData[TOTAL_BUSINESSES][bRating]);
	for(new i; i < 10; i++)
	{
		UpdateBiz_Object(TOTAL_BUSINESSES, i);
	}

	UpdateBiz(TOTAL_BUSINESSES, true);
	TOTAL_BUSINESSES++;
	return 1;
}
stock UpdateBiz(id, bool:set)
{
	//delete old data
	new type = BizData[id][bType];
	if(set)
	{
		if(IsValidDynamicMapIcon(Biz_EnterMapIcon[id])) DestroyDynamicMapIcon(Biz_EnterMapIcon[id]), Biz_EnterMapIcon[id] = -1;
		Biz_EnterMapIcon[id] = CreateDynamicMapIcon(BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], BizStaticData[type][bsMapIconID], 0, 0, 0, -1, 300.0);

		if(IsValidDynamicArea(Biz_EnterArea[id])) DestroyDynamicArea(Biz_EnterArea[id]), Biz_EnterArea[id] = -1;
		Biz_EnterArea[id] = CreateDynamicSphere(BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], \
						BizStaticData[type][bsPickupID] != 1650 ? 2.0 : 6.0, 0, 0);
		if(IsValidDynamicPickup(Biz_EnterPickup[id]) && Biz_EnterPickup[id] != -1) DestroyDynamicPickup(Biz_EnterPickup[id]), Biz_EnterPickup[id] = -1;
		else if(IsValidDynamicCP(Biz_EnterPickup[id]) && Biz_EnterPickup[id] != -1) DestroyDynamicCP(Biz_EnterPickup[id]), Biz_EnterPickup[id] = -1;
		if(BizStaticData[type][bsPickupID] != 0)
		{
			if(BizData[id][bEnter][0] > 3990.0 || BizData[id][bEnter][0] < -3990.0 || BizData[id][bEnter][1] > 3990.0 || BizData[id][bEnter][1] < -3990.0)
			{
				Biz_EnterPickup[id] = CreateDynamicCP(BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], 1.5, 0, 0, -1, 15.0);
			}
			else
			{
				Biz_EnterPickup[id] = CreateDynamicPickup(BizStaticData[type][bsPickupID], 64, BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], 0, 0);
			}
		}
	}
	if(IsValidDynamic3DTextLabel(Biz_Enter3DLabel[id])) DestroyDynamic3DTextLabel(Biz_Enter3DLabel[id]), Biz_Enter3DLabel[id] = Text3D:-1;
	Biz_Enter3DLabel[id] = CreateDynamic3DTextLabel(!"", -1, BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2]+1, 6.5, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
	
	str_1[0] = EOS;
	if(!IsBusinessOwned(id)) //гос
	{
		GetBusinessName(id, str_1);
		f(str_1, sizeof(str_1), "%s\n\
			{66CC00}Бизнес продается\n\
			Используйте /buybiz\n\
			Цена: %i руб\n", \
			str_1, BizData[id][bCost]);
	}
	switch(type)
	{
		case 1:
		{
			if(!IsBusinessOwned(id)) //гос
			{

			}
			else
			{
				new idEx = GetFamilyID(BizData[id][bGangRoof_ID]);
				if(idEx < 0 && BizData[id][bGangRoof_ID] != -1) 
				{
					BizData[id][bGangRoof_ID] = -1;
					UpdateDataInt("Businesses", "GangRoof_ID", BizData[id][bGangRoof_ID], BizData[id][bID]);
				}
				f(str_1, sizeof(str_1), "{FFFFFF}Владелец: {0099FF}%s\n\
					{FFFFFF}Крыша: {0099FF}%s\n\
					{FFFFFF}Зарядная станция: {0099FF}Имеется\n\
					{FFFFFF}Цена за литр:\n\
					{FFFFFF}А-92 {FF9900}%i руб\n\
					{FFFFFF}А-95 {FF9900}%i руб\n\
					{FFFFFF}А-98 {FF9900}%i руб\n\
					{FFFFFF}DT {FF9900}%i руб\n\
					{66CC00}Бизнес открыт", \
						BizData[id][bOwner],\
						(idEx < 0 ? "Нет" : (str_f("%s",FamilyData[idEx][fName]))),
						global_GetShopPrice("А-92")*BizData[id][bProductEx],
						global_GetShopPrice("А-95")*BizData[id][bProductEx],
						global_GetShopPrice("А-98")*BizData[id][bProductEx],
						global_GetShopPrice("DT")*BizData[id][bProductEx]);
			}
		}
		default:
		{
			if(!IsBusinessOwned(id)) //гос
			{

			}
			else
			{
				new idEx = GetFamilyID(BizData[id][bGangRoof_ID]);
				if(idEx < 0 && BizData[id][bGangRoof_ID] != -1) 
				{
					BizData[id][bGangRoof_ID] = -1;
					UpdateDataInt("Businesses", "GangRoof_ID", BizData[id][bGangRoof_ID], BizData[id][bID]);
				}
				str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "%s", (idEx < 0 ? "Нет" : (str_f("%s",FamilyData[idEx][fName]))));
				f(str_1, sizeof(str_1), "%s %s\n\
				{FFFFFF}Владелец: {0099FF}%s\n\
				{FFFFFF}Крыша: {0099FF}%s\n\
				{66CC00}%s", \
					BizStaticData[type][bsName], BizData[id][bName],\
					BizData[id][bOwner], str_mes,\
					(BizData[id][bEnterPrice] < 1 ? ("Вход свободный") : (str_f("%s: {FF9900}%i руб", (BizStaticData[type][bsExit][0] == 0.0 ? "Цена услуг" : "Вход"), BizData[id][bEnterPrice]))));
			}
		}
	}
	UpdateDynamic3DTextLabelText(Biz_Enter3DLabel[id], 0xFFFF00FF, str_1);
	return 1;
}
public: LoadGarages()
{
	new stat;
	for(new i, end = cache_num_rows(); i < end; i++)
	{
		stat = LoadGarageMySQL(i);
		if(!stat) break;
	}
	if(stat == 1) printf("[Garages]: Гаражей загружено -> %i", TOTAL_GARAGES);
	else printf("[Garages]: UNKNOWN ( all stat -> %i)", TOTAL_GARAGES);


	//load static object
	if(!IsValidDynamicArea(Garage_ExitArea[0]))
	{
		for(new i; i < sizeof(GarageStaticData); i++)
		{
			Garage_ExitArea[i] = CreateDynamicSphere(GarageStaticData[i][gsExit][0], GarageStaticData[i][gsExit][1], GarageStaticData[i][gsExit][2], 5.0, -1, GarageStaticData[i][gsInterior]);
			CreateDynamic3DTextLabel(!"Выйти: {FF9900}L.ALT", -1, GarageStaticData[i][gsExit][0], GarageStaticData[i][gsExit][1], GarageStaticData[i][gsExit][2], 6.0);
		}
	}
	return 1;
}
public: LoadGarageMySQL(id)
{
	cache_get_int(id, !"ID", GarageData[TOTAL_GARAGES][gID]);
	cache_get_string(id, !"Owner", GarageData[TOTAL_GARAGES][gOwner]);
	cache_get_int(id, !"Level", GarageData[TOTAL_GARAGES][gLevel]);
	cache_get_int(id, !"Nalog", GarageData[TOTAL_GARAGES][gNalog]);
	cache_get_int(id, !"Interior", GarageData[TOTAL_GARAGES][gInterior]);
	cache_get_int(id, !"Lock", GarageData[TOTAL_GARAGES][gLock]);
	cache_get_string(id, !"Enter", str_2), sscanf(str_2, "p<,>a<f>[4]", GarageData[TOTAL_GARAGES][gEnter]);
	cache_get_int(id, !"bindID", GarageData[TOTAL_GARAGES][gbindID]);
	cache_get_int(id, "Auction_Bet", GarageData[TOTAL_GARAGES][gAuction_Bet]);
	cache_get_string(id, "Auction_Owner", GarageData[TOTAL_GARAGES][gAuction_Owner]);
	//cache_get_string(id, !"CarsData", str_2), sscanf(str_2, "p<,>a<i>[15]", GarageData[TOTAL_GARAGES][gCarsData]);
	UpdateGarage(TOTAL_GARAGES, true);
	TOTAL_GARAGES++;
	return 1;
}
stock UpdateGarage(id, bool:set)
{
	if(set) //set это типа если переместили
	{
		//if(IsValidDynamicPickup(Garage_Pickup[id])) DestroyDynamicPickup(Garage_Pickup[id]), Garage_Pickup[id] = -1;
		if(IsValidDynamicArea(Garage_EnterArea[id])) DestroyDynamicArea(Garage_EnterArea[id]), Garage_EnterArea[id] = -1;
		//Garage_Pickup[id] = CreateDynamicPickup(1239, 23, GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2]);
		Garage_EnterArea[id] = CreateDynamicSphere(GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2], 4.0, 0, 0);
		if(IsValidDynamicPickup(Garage_Pickup[id]) && Garage_Pickup[id] != -1) DestroyDynamicPickup(Garage_Pickup[id]), Garage_Pickup[id] = -1;
		else if(IsValidDynamicCP(Garage_Pickup[id]) && Garage_Pickup[id] != -1) DestroyDynamicCP(Garage_Pickup[id]), Garage_Pickup[id] = -1;
		if(GarageData[id][gEnter][0] > 3990.0 || GarageData[id][gEnter][0] < -3990.0 || GarageData[id][gEnter][1] > 3990.0 || GarageData[id][gEnter][1] < -3990.0)
		{
			Garage_Pickup[id] = CreateDynamicCP(GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2], 1.5, 0, 0, -1, 15.0);
		}
		else
		{
			Garage_Pickup[id] = CreateDynamicPickup(1239, 64, GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2], 0, 0);
		}
	}

	if(IsValidDynamic3DTextLabel(Garage_3DLabel[id])) DestroyDynamic3DTextLabel(Garage_3DLabel[id]), Garage_3DLabel[id] = Text3D:-1;
	
	str_1[0] = EOS;
	if(!IsGarageOwned(id))
	{
		f(str_1, sizeof(str_1), "{FF9900}- Гараж -\n{FFFFFF}Гараж класса: %s (%i)\nИспользуйте {66CC60}/buygarage\n{BBBBBB}Цена: %i руб", GarageStaticData[GarageData[id][gInterior]][gsName], id, GarageStaticData[GarageData[id][gInterior]][gsCost]);
	}
	else
	{
		f(str_1, sizeof(str_1), "{00a8e6}- Гараж -\n{FFFFFF}Гараж класса: %s (%i)\n{BBBBBB}Владелец: %s", GarageStaticData[GarageData[id][gInterior]][gsName], id, GarageData[id][gOwner]);
	}
	Garage_3DLabel[id] = CreateDynamic3DTextLabel(str_1, -1, GarageData[id][gEnter][0], GarageData[id][gEnter][1], GarageData[id][gEnter][2], 25.0000);
	return 1;
}
new reklm;
stock OnVehicleUpdateEx()
{
	str_1[0] = EOS;
	new count;
	foreach(new vehicleid: vehicle_MusicPlayer)
	{
		if(!IsValidVehicle(vehicleid) || vehicleid > 1999) continue;
		if(global_time >= (vehicle_MusicPlayer_StartTime[vehicleid]+900))
		{
			str_1[count] = vehicleid;
		}
	}
	for(new vehicleid; vehicleid < count; vehicleid++)
	{
		vehicle_MusicPlayer_Destroy(vehicleid);
	}
	foreach(new vehicleid: Vehicles)
	{
		if(VehicleData[vehicleid][V_MODELID] == 538 || VehicleData[vehicleid][V_MODELID] == 577 || VehicleData[vehicleid][V_MODELID] == 15644) continue;
		VehicleData[vehicleid][V_doTime]++;
		if(g_vehicle_params[vehicleid][V_ENGINE])
		{
			//fuel data update
			if(VehicleData[vehicleid][V_FUEL] < 1)
			{
				SetVehicleParam(vehicleid, V_ENGINE, false);
				foreach(new playerid: PlayerInVehicle[vehicleid])
				{
					SCM(playerid, 0xCECECEFF, !"В транспорте закончилось топливо.");
				}
				VehicleData[vehicleid][V_FUEL] = 0.0;
			}
			else VehicleData[vehicleid][V_FUEL] -= 0.02;

			//mileage data update
			new Float:dist = GetVehicleDistanceFromPoint(vehicleid, VehicleData[vehicleid][vPosition][0], VehicleData[vehicleid][vPosition][1], VehicleData[vehicleid][vPosition][2]);
			if(dist > 1 && dist < 300)
			{
				VehicleData[vehicleid][V_MILEAGE] += dist/200;
			}
			GetVehiclePos(vehicleid, VehicleData[vehicleid][vPosition][0], VehicleData[vehicleid][vPosition][1], VehicleData[vehicleid][vPosition][2]);

			//wash data update
			if(VehicleData[vehicleid][vWash] < 100)
			{
				VehicleData[vehicleid][vWash] += 0.006;
			}
			if(VehicleData[vehicleid][vWash] > 90)
			{
				VehicleData[vehicleid][vWear] += 0.001;
			}
		}
	}
	return 1;
}
//new bool:grand_newminute;
new RWC_cars;
stock TrashDestroy_Update()
{
	str_while[0] = EOS;
	new count;
	foreach(new i: TrashData)
	{
		if(TrashUpdate{i} == 1)
		{
			str_while[count] = i;
			count++;
		}
		else TrashUpdate{i}--;
	}
	for(new i; i < count; i++)
	{
		new id = str_while[i];
		SafeDestroyTrash(id);
		Iter_Remove(TrashData, id);
	}
}
stock OnSecondUpdate()
{
	TrashDestroy_Update();
	if(Machinist_Flood > 0) Machinist_Flood--;
	if(Pilot_Flood > 0) Pilot_Flood--;
	if((reklm % 600) == 0)
	{
		if(Iter_Count(Eat_TrashData) > 0)
		{
			new id = Iter_Random(Eat_TrashData);
			SafeDestroy_EatTrash(id);
			Iter_Remove(Eat_TrashData, id);
		}
		foreach(new i: Player)
		{
			if(!IsPlayerLogged(i)) continue;
			ExecutePacket(i, webUpdate, "interface('ScreenNotification').add\
				('[\
					1,\"Информация\",\
					\"{FFCD00}Наш Telegram:{ffffff} "TG_SERVER"<br>\
					{FFCD00}Наш форум:{ffffff} "SITE_SERVER"<br>\
					{FFCD00}Пополнение счета RCOINS:{ffffff} "SITE_SERVER"\",\"FFCD00\",5000\
				]')");
		}
	}
	else if((reklm % 900) == 0)
	{
		switch(random(20))
		{
			case 0..5:
			{
				SCMAll(-1, !"===================== [ {1E90FF}"NAME_SERVER"{FFFFFF} ] =====================");
				SCMAll(-1, !"");
				SCMAll(-1, !"Группа VK: {1E90FF}"VK_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Telegram: {1E90FF}"TG_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Сайт: {1E90FF}"SITE_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Форум: {1E90FF}"SITE_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Встретились с технической проблемой или нашли баг? {1E90FF}Напишите нам -> /bugreport");
				SCMAll(-1, !"");
				SCMAll(-1, !"===================== [ {1E90FF}"NAME_SERVER"{FFFFFF} ] =====================");
			}
			case 6..11:
			{
				SCMAll(-1, !"===================== [ {1E90FF}"NAME_SERVER"{FFFFFF} ] =====================");
				SCMAll(-1, !"");
				SCMAll(-1, !"Группа VK: {1E90FF}"VK_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Telegram: {1E90FF}"TG_SERVER"");
				SCMAll(-1, !"");
				SCMAll(-1, !"Пополнить счет можно на сайте: {1E90FF}"SITE_SERVER"");
				SCMAll(-1, !"или через людей в контактах группы -<");
				SCMAll(-1, !"");
				SCMAll(-1, !"Закончились слоты для имущества? {1E90FF}Приобрети их в /donate");
				SCMAll(-1, !"");
				SCMAll(-1, !"===================== [ {1E90FF}"NAME_SERVER"{FFFFFF} ] =====================");
			}
			default:
			{
				SCMAll(0xFAAC58FF, "[SERVER]: Telegram: {FF0000}"TG_SERVER"");
				SCMAll(0xFAAC58FF, "[SERVER]: Официальная группа ВК: {FF0000}"VK_SERVER"");
				SCMAll(0xFAAC58FF, "[SERVER]: Ознакомиться с Донат-Услугами можно в обсуждениях группы: {FF0000}"VK_SERVER"");
				SCMAll(0xFAAC58FF, "[SERVER]: Покупки не через владельца караются {FFFF00}БАНОМ и удалением аккаунта!");
			}
		}
	}
	switch(reklm)
	{
		case 3555:
		{
			if(Iter_Count(Vehicles) > 500)
			{
				RWC_cars = 60;
				print("[RWC] НАЧАТО");
			}
		}
		case 1400:
		{

		}
		case 1200:
		{
			if(Iter_Count(Vehicles) > 400)
			{
				RWC_cars = 60;
				print("[RWC] НАЧАТО");
			}
		}
		case 3500: SetRandomWeather();
		case 3600: reklm = 0;
	}
	if(RWC_cars > 0)
	{
		switch(RWC_cars)
		{
			case 60: SCMAll(0xFFCD00FF, "[RWC]: Внимание! Через 1 минуту, будут выгружены все не занятые личные ТС и респавн автомобилей.");
			case 30: SCMAll(0xFFCD00FF, "[RWC]: Внимание! Через 30 секунд, будут выгружены все не занятые личные ТС и респавн автомобилей.");
			case 20: SCMAll(0xFFCD00FF, "[RWC]: Внимание! Через 20 секунд, будут выгружены все не занятые личные ТС и респавн автомобилей.");
			case 10: SCMAll(0xFFCD00FF, "[RWC]: Внимание! Через 10 секунд, будут выгружены все не занятые личные ТС и респавн автомобилей.");
			case 1: 
			{
				SCMAll(0xFFCD00FF, "[RWC]: Успешно! Прошло выгружение всех не занятых личных ТС и респавн автомобилей.");
				RWC_cars = 0;
				str_while[0] = EOS;
				new count;
				foreach(new i: Vehicles)
				{
					new player;
					foreach(new idx: PlayerInVehicle[i]) player++;
					if(!player)
					{
						str_while[count] = i;
						count++;
					}
				}
				for(new i; i < count; i++)
				{
					new j = str_while[i];
					if(!IsValidVehicle(j)) continue;
					if(VehicleData[j][V_doTime] > 80)
					{
						new number = GetVehicleID(j);
						if(number != INVALID_VEHICLE_ID) 
						{
							SafeRemoveCar(number, number);
						}
						else 
						{
							SetVehicleToRespawn(j);
						}
					}
				}
			}
		}
		RWC_cars--;
	}
	reklm++;
}
stock OnceHourTimer()
{
	print("PayDay()++;");
	PayDay();
	SetWorldTime(global_hour);
	g_last_pay_day_time = global_time;
	if(global_hour % 4 == 0)
	{
		CheckNalog();
	}
	CarsShop_Add();
}
stock CheckNalog()
{
	if(!disableNalog)
	{
		//businesses
		new biz_count;
		for(new i; i < TOTAL_BUSINESSES; i++)
		{
			if(!IsBusinessOwned(i) || GetString(BizData[i][bOwner], "Sell Nalog") || BizData[i][bNalog] >= global_time) continue;

			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `ReturnMoney`=`ReturnMoney`+%i WHERE `NickName` = '%s' LIMIT 1;", BizData[i][bCost]/2, BizData[i][bOwner]);
			mysql_tquery(mysql, str_q);

			player_addNotif(BizData[i][bOwner], "Имущество было опечатано {19b80b}[NEW]", (str_f("Ваш бизнес №%i\\nбыл изъят за неоплату, последняя квитанция была на %i.\\nДля того, чтобы вернуть часть средств за бизнес, напишите: /returnmoney", i, BizData[i][bNalog])), "");

			ChangeBusinessOwner(i, (random(100) > 50 ? "Sell Nalog" : "The State"));
			biz_count++;
		}

		new house_count;
		for(new i; i < TOTAL_HOUSES; i++)
		{
			if(!IsHouseOwned(i) || GetString(HouseData[i][hOwner], "Sell Nalog") || HouseData[i][hNalog] >= global_time) continue;

			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `ReturnMoney`=`ReturnMoney`+%i WHERE `NickName` = '%s' LIMIT 1;", HouseData[i][hCost]/2, HouseData[i][hOwner]);
			mysql_tquery(mysql, str_q);

			player_addNotif(HouseData[i][hOwner], "Имущество было опечатано {19b80b}[NEW]", (str_f("Ваш %s №%i\\nбыл изъят за неоплату, последняя квитанция была на %i.\\nДля того, чтобы вернуть часть средств за дом, напишите: /returnmoney", (HouseData[i][hEntrance_ID] == -1 ? "дом" : "квартира"), i, HouseData[i][hNalog])), "");

			ChangeHouseOwner(i, (random(100) > 50 ? "Sell Nalog" : "The State"));
			house_count++;
		}

		new garage_count;
		for(new i; i < TOTAL_GARAGES; i++)
		{
			if(!IsGarageOwned(i) || GetString(GarageData[i][gOwner], "Sell Nalog") || GarageData[i][gNalog] >= global_time) continue;
			
			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `ReturnMoney`=`ReturnMoney`+%i WHERE `NickName` = '%s' LIMIT 1;", GarageStaticData[GarageData[i][gInterior]][gsCost]/2, GarageData[i][gOwner]);
			mysql_tquery(mysql, str_q);

			player_addNotif(GarageData[i][gOwner], "Имущество было опечатано {19b80b}[NEW]", (str_f("Ваш гараж №%i\\nбыл изъят за неоплату, последняя квитанция была на %i.\\nДля того, чтобы вернуть часть средств за гараж, напишите: /returnmoney", i, GarageData[i][gNalog])), "");

			ChangeGarageOwner(i, "The State");
			garage_count++;
		}
		new stall_count;
		for(new i; i < sizeof(StallStaticData); i++)
		{
			if(!IsStallOwned(i) || StallData[i][sNalog] >= global_time) continue;

			str_q[0] = EOS, f(str_q, sizeof(str_q), "UPDATE `players` SET `ReturnMoney`=`ReturnMoney`+%i WHERE `NickName` = '%s' LIMIT 1;", StallData[i][sCost]/2, StallData[i][sOwner]);
			mysql_tquery(mysql, str_q);

			player_addNotif(StallData[i][sOwner], "Имущество было опечатано {19b80b}[NEW]", (str_f("Ваш киоск №%i\\nбыл изъят за неоплату, последняя квитанция была на %i.\\nДля того, чтобы вернуть часть средств за бизнес, напишите: /returnmoney", i, StallData[i][sNalog])), "");

			ChangeStallOwner(i, "The State");
			stall_count++;
		}
		UpdateDebetorList(house_count,biz_count,garage_count);
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "\
			[Информация] {FFFFFF}Из-за неоплаты налогов были конфискованы {c7dae8}%i домов{FFFFFF}, {c7dae8}%i бизнесов{FFFFFF}, {c7dae8}%i гаражей...", house_count, biz_count, garage_count);
		SCMAll(0xc7dae8FF, str_mes);
		str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{FFFFFF} и {c7dae8}%i киосков, которые отправляются на аукцион/слет.", stall_count);
		SCMAll(-1, str_mes);
	}
	else
	{
		SCMAll(0xc7dae8FF, "[Информация] {FFFFFF}В настоящее время налоги на имущество отключены");
	}
}
stock Update_CasinoDice()
{
	for(new i; i < sizeof(Casino_Dice); i++)
	{
		if(!CasinoDice_Data[i][cdiceStart] || !CasinoDice_Data[i][cdiceTimeOut]) continue;
		CasinoDice_Data[i][cdiceTimeOut]--;
		//CasinoDice_UpdateGame(i);
		if(!CasinoDice_Data[i][cdiceTimeOut])
		{
			foreach(new playerid: cDice_Players[i])
			{
				if(!IsPlayerLogged(playerid)) continue;
				player_CasinoDice_RandomBet(playerid, i);
			}
			//CasinoDice_UpdateGame(i);
			//CasinoDice_DefineWinner(i);
		}
		CasinoDice_UpdateGame(i);
	}
}
