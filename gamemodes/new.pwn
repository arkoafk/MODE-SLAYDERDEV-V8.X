	}*/
}
//"interface('PlayerInteraction').setParams('[0,2,[["Список предупреждений","Warnings",53],["Меню сотрудника","TKMenu",54],["Список событий","MPList",56],["Бонусы","Bonus",59]],12]')"
stock player_BuyNumber_Action(playerid, model, const number[], const region[])
{
	if(!(player_AntiFlood[playerid][12]-global_time > 0))
	{
		switch(model)
		{
			case 1: //russia
			{
				if(strlen(number) < 6 || strval(region) < 1 || strval(region) > 999) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Номер должен быть из 6-и символов, а регион мин. из 2-х и не больше 999\")");
			}
			case 2: //kz
			{
				if(strlen(number) < 6 || strlen(region) < 2) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Номер должен быть из 6-и символов, а регион из 2-х\")");
			}
			case 3: //belrussia
			{
				if(strlen(number) < 4 || strlen(region) < 4) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Номер должен быть из 6-и символов, а регион из 1-й\")");
			}
			case 4: //uk
			{
				if(strlen(number) < 4 || strlen(region) < 4) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Проверьте правильность введённого номера\")");
			}
			case 5: 
			{
				if(strlen(number) < 1 || strlen(number) > 7) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Проверьте правильность введённого номера\")");
			}
		}
		if(IsValidNumber(number, region, model) <= 0)
		{
			ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"Проверьте правильность введённого номера #2\")");
			return 1;
		}
		f(player_BuyNumber[playerid], 32, "%s %s", number, region);
		//проверка на выкинутый
		for(new i; i < sizeof(StallStaticData); i++)
		{
			for(new j; j < 30; j++)
			{
				//SCMf(playerid, -1, "%s|%s", InventoryStallString[i][j], player_BuyNumber[playerid]);
				if(!GetString(InventoryStallString[i][j], player_BuyNumber[playerid]) || strlen(InventoryStallString[i][j]) < 4) continue;
				ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, 'Данный номер уже зарегистрирован #1')");
				return 1;
			}
		}
		foreach(new i: TrashData)
		{
			if(GetString(InventoryTrashString[i], player_BuyNumber[playerid]))
			{
				ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, 'Данный номер уже зарегистрирован #2')");
				return 1;
			}
		}
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID` FROM `OwnableCars` WHERE `Number_String` = '%s' OR `Inventory_String` LIKE '%%%s%%' LIMIT 1;", player_BuyNumber[playerid], player_BuyNumber[playerid]);
		mysql_tquery(mysql, str_q, "player_cNumber_OC", "ii", playerid, model);
	}
	else GameTextForPlayerEx(playerid, (str_f("~r~Повторно возможно через %i сек", player_AntiFlood[playerid][12]-global_time)), 3000, 2);
	return 1;
}
public: player_cNumber_OC(playerid, model)
{
	if(!cache_num_rows())
	{
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID` FROM `players` WHERE `Inventory_String` LIKE '%%%s%%' OR `InventoryBag_String` LIKE '%%%s%%' LIMIT 1;", player_BuyNumber[playerid], player_BuyNumber[playerid]);
		mysql_tquery(mysql, str_q, "player_cNumber_PL", "ii", playerid, model);
	}
	else ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, 'Данный номер уже зарегистрирован')");
	return 1;
}
public: player_cNumber_PL(playerid, model)
{
	if(!cache_num_rows())
	{
		str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `ID` FROM `Houses` WHERE `Inventory_String` LIKE '%%%s%%' LIMIT 1;", player_BuyNumber[playerid]);
		mysql_tquery(mysql, str_q, "player_cNumber_Buy", "ii", playerid, model);
	}
	else ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, 'Данный номер уже зарегистрирован')");
	return 1;
}
public: player_cNumber_Buy(playerid, model)
{
	if(!(player_AntiFlood[playerid][12]-global_time > 0))
	{
		if(!cache_num_rows())
		{
			if(!OpenInterface[playerid][22]) 
			{
				new number = player_BuyUID[playerid];
				if(IsAOwnableCar(number))
				{
					if(GetString(CarData[number][cOwner], PN(playerid)))
					{
						if(GetString(CarData[number][cRegNumber_String], "-"))
						{
							SetString(CarData[number][cRegNumber_String], player_BuyNumber[playerid]);
							UpdateDataStr("OwnableCars", "RegNumber_String", CarData[number][cRegNumber_String], CarData[number][cID]);
							new price = GetNumPriceCef(player_BuyNumber[playerid]);
							//if(player_Cash[playerid] < price) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"У вас недостаточно денег\")");
							if(CompareInt64(playerid, "<", price)) return ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, \"У вас недостаточно денег\")");
							GivePlayerMoneyEx(playerid, -price, "Покупка номеров", true, true);
							SCMf(playerid,1724645631, "Вы купили номера формата: {FFCD00}\"%s\" {66CC00}за %i руб", player_BuyNumber[playerid], price);
							ExecutePacket(playerid, webClose, "BuyCarNumber");
						}
						else 
						{
							SCM(playerid, 0x999999FF, "На данный транспорт уже зарегистрирован государственный номер.");
							return 1;
						}
					}
					else 
					{
						SCM(playerid, 0x999999FF, "Это не ваша машина, загрузите свое авто.");
						return 1;
					}
				}
				else 
				{
					SCM(playerid, 0x999999FF, "Это не ваша машина, загрузите свое авто.");
					return 1;
				}
			}
			else
			{
				new price = GetNumPriceCefDonate(player_BuyNumber[playerid]);
				if(PI[playerid][pCash_Donate] < price) return GameTextForPlayerEx(playerid, "~r~Недостаточно средств", 4000, 2);
				GivePlayerDonate(playerid, -price, "Покупка номеров", true, true);
			}
			//SPD(playerid, 910, 0, "Покупка номера", "Вы действительно желаете приобрести автомобильный номер {FFCD00}\'AC 1234 BC\'{FFFFFF} за 61200 руб?", "Да","Нет")
			InvAdd(playerid, 99, 1, "", model, 0, player_BuyNumber[playerid], "Покупка номера");
			player_AntiFlood[playerid][12] = global_time+30;
		}
		else 
		{
			if(!OpenInterface[playerid][22]) ExecutePacket(playerid, webUpdate, "interface('BuyCarNumber').buyResponse(0, 'Данный номер уже зарегистрирован')");
			else GameTextForPlayerEx(playerid, "~r~Уже зарегистрирован", 4000, 2);
		}
	}
	else GameTextForPlayerEx(playerid, "~r~Подождите немного", 3000, 2);
	return 1;
}
stock GetNumPriceInt(const t[])
{
	new e = 0;
	new n = strlen(t);
	for(new r = 0; r < n; r++)
	{
		for(new i = r + 1; i < n; i++)
		{
			if(t[r] == t[i])
				e += 1;
		}
	}
	return e;
}
stock GetNumPriceCefDonate(const t[])
{
	new e =  GetNumPriceInt(t) + 1;
	new price = 200 * e;
	return price;
}
stock GetNumPriceCef(const t[])
{
	new e =  GetNumPriceInt(t) + 1;
	new price = 25300 * pow(e, 2);
	return price;
}
stock pow(dig, deg)
{
	new res = dig;
	if(deg == 0) return 1;
	for(new i=1;i<deg;i++) res *= dig;
	return res;
}
stock GetRandomUnusedLicensePlate(playerid, str)
{
	if(!(player_AntiFlood[playerid][11]-global_time > 0))
	{
		player_AntiFlood[playerid][11] = global_time+300;
		str_1[0] = EOS;
		switch(str)
		{
			case 1: f(str_1, sizeof str_1, "%s %s", GetRandomNumber(0), GetRandomNumber(0, true));
			case 2: f(str_1, sizeof str_1, "%s %s", GetRandomNumber(1), GetRandomNumber(1, true));
			case 3: f(str_1, sizeof str_1, "%s %s", GetRandomNumber(2), GetRandomNumber(2, true));
			case 4: f(str_1, sizeof str_1, "%s", GetRandomNumber(3));
		}
		SetString(player_BuyNumber[playerid], str_1);
		str_2[0] = EOS, f(str_2, sizeof str_2, "interface('BuyCarNumber').getRandomResponse('%s')", player_BuyNumber[playerid]);
		ExecutePacket(playerid, webUpdate, str_2);
	}
	else
	{
		ExecutePacket(playerid, webUpdate, (str_f("interface('BuyCarNumber').getRandomResponse('%s', 'Поиск номеров можно использовать не чаще 1 раза за пять минут!')", player_BuyNumber[playerid])));
	}
	return 1;
}
stock GetRandomNumber(type, bool:region=false)
{
	static str[9];
	str[0] = EOS;

	static const 
			chars[] = {'A', 'B', 'C', 'E', 'H', 'K', 'M', 'O', 'P', 'T', 'X'},
			charsInt[] = {777, 797, 799, 799, 743, 774, 666, 555, 444, 763, 761, 707, 606};

	switch(type)
	{
		case 0: //rus
		{
			if(!region) f(str, sizeof(str),"%c%c%c%c%c%c", chars[random(sizeof chars)], random('9' - '0') + '0', random('9' - '0') + '0', random('9' - '0') + '0', chars[random(sizeof chars)], chars[random(sizeof chars)]);
			else 
			{
				new number = RandomEx(0,200);
				if(number < 10) f(str, sizeof(str),"0%i", number);
				else
				{
					if(random(100) >= 80) f(str, sizeof(str),"%i", charsInt[random(sizeof charsInt)]);
					else f(str, sizeof(str),"%i", number);
				}
			}
		}
		case 1: //kz
		{
			if(!region) f(str, sizeof(str),"%c%c%c%c%c%c", random('9' - '0') + '0',random('9' - '0') + '0',random('9' - '0') + '0', chars[random(sizeof chars)], chars[random(sizeof chars)], chars[random(sizeof chars)]);
			else f(str, sizeof(str),"%i", RandomEx(0,100));
		}
		case 2: //by
		{
			if(!region) f(str, sizeof(str),"%c%c%c%c%c%c", random('9' - '0') + '0', random('9' - '0') + '0', random('9' - '0') + '0', random('9' - '0') + '0', chars[random(sizeof chars)], chars[random(sizeof chars)]);
			else f(str, sizeof(str),"%i", RandomEx(0,10));
		}
		//ua
		case 3: f(str, sizeof(str),"%c%c%c%c%c%c%c%c", chars[random(sizeof chars)], chars[random(sizeof chars)], random('9' - '0') + '0',random('9' - '0') + '0',random('9' - '0') + '0',random('9' - '0') + '0', chars[random(sizeof chars)], chars[random(sizeof chars)]);
	}
	return str;
}
stock player_DisplayText(playerid, const text[], timeout=3)
{
	ExecutePacket(playerid, webClose, "DisplayText");
	str_1[0] = EOS, f(str_1, sizeof str_1, "[\"%s\", %i]",text, timeout*1000);
	ExecutePacket(playerid, webOpen, "DisplayText", str_1);
	return 1;
}
