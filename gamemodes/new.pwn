enum E_DIALOG_STAGE
{
	dsType,
	dsID,
	dsName[46]
};
static const dialog_Stage[][E_DIALOG_STAGE] = {
	{0, 0, "{%s}Комплект STAGE 1"},
	{1, 1, "{%s}Радиатор \t%s%s"},
	{2, 2, "{%s}Выхлоп \t%s%s"},
	{3, 0, "\n \n"},
	{4, 0, "{%s}Комплект STAGE 2"},
	{5, 3, "{%s}Турбина \t%s%s"},
	{6, 0, "\n \n"},
	{7, 0, "{%s}Комплект STAGE 3"},
	{8, 4, "{%s}Нагнетатель \t%s%s"},
	{9, 0, "\n \n"},
	{10, 5, "Изменение выворота колес \t%.2f\t{91D643}%i руб"}
};
stock player_Stage_DialogOpen(playerid, type)
{
	new number = GetVehicleID(GetPlayerVehicleID(playerid));
	if(number != INVALID_VEHICLE_ID)
	{
		if(!GetString(CarData[number][cOwner], PN(playerid)))
		{
			SCM(playerid, COLOR_RED, !"Вы не владелец этого авто!");
			return 1;
		}
		player_ShowUID[playerid][111] = type;
		str_1[0] = EOS;
		str_1 = "{E4E4DF}Деталь \t{E4E4DF}Статус \t{E4E4DF}Стоимость\n";
		for(new i; i < sizeof(dialog_Stage); i++)
		{
			str_mes[0] = EOS;
			player_ShowData[playerid][i] = -1;
			switch(dialog_Stage[i][dsType])
			{
				//stage 1
				case 0:
				{
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 0 ? "F6B243" : "946A1F"));
				}
				case 1:
				{
					f(str_mes, sizeof(str_mes), "\t{%s}%i руб", (type == 0 ? "91D643" : "55703F"), cost_stage[0]);
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 0 ? "E4E4DF" : "5C5D5C"), (!CarData[number][cStage_RadUsed] ? "{AF9795}Не установлено" : "{ffd700}Установлено"), str_mes);
					if(!CarData[number][cStage_RadUsed]) player_ShowData[playerid][i] = (type == 0 ? 0 : -1);
					else player_ShowData[playerid][i] = (type == 0 ? 10 : -1);
				}
				case 2:
				{
					f(str_mes, sizeof(str_mes), "\t{%s}%i руб", (type == 0 ? "91D643" : "55703F"), cost_stage[1]);
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 0 ? "E4E4DF" : "5C5D5C"), (!CarData[number][cStage_ExhUsed] ? "{AF9795}Не установлено" : "{ffd700}Установлено"), str_mes);
					if(!CarData[number][cStage_ExhUsed]) player_ShowData[playerid][i] = (type == 0 ? 1 : -1);
					else player_ShowData[playerid][i] = (type == 0 ? 11 : -1);
				}
				//stage 2
				case 4:
				{
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 1 ? "F6B243" : "946A1F"));
				}
				case 5:
				{
					f(str_mes, sizeof(str_mes), "\t{%s}%i руб", (type == 1 ? "91D643" : "55703F"), cost_stage[2]);
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 1 ? "E4E4DF" : "5C5D5C"), (!CarData[number][cStage_TurUsed] ? "{AF9795}Не установлено" : "{ffd700}Установлено"), str_mes);
					if(!CarData[number][cStage_TurUsed]) player_ShowData[playerid][i] = (type == 1 ? 2 : -1);
					else player_ShowData[playerid][i] = (type == 1 ? 12 : -1);
				}
				//stage 3
				case 7:
				{
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 2 ? "F6B243" : "946A1F"));
				}
				case 8:
				{
					f(str_mes, sizeof(str_mes), "\t{%s}%i руб", (type == 2 ? "91D643" : "55703F"), cost_stage[3]);
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], (type == 2 ? "E4E4DF" : "5C5D5C"), (!CarData[number][cStage_SupUsed] ? "{AF9795}Не установлено" : "{ffd700}Установлено"), str_mes);
					if(!CarData[number][cStage_SupUsed]) player_ShowData[playerid][i] = (type == 2 ? 3 : -1);
					else player_ShowData[playerid][i] = (type == 2 ? 13 : -1);
				}
				case 10:
				{
					player_ShowData[playerid][i] = 14;
					f(str_mes, sizeof(str_mes), dialog_Stage[i][dsName], CarData[number][cStage_Inversion], cost_stage[4]);
				}
				default:
				{
					strcat(str_mes, dialog_Stage[i][dsName]);
				}
			}
			f(str_1, sizeof(str_1), "%s%s\n", str_1, str_mes);
		}
		SPD(playerid, 20420, 5, "{F6CC3F}Элементы установки", str_1, "Выбор","Отмена");
	}
	return 1;
}
stock player_EditVehicleObject(playerid, number, model)
{
	if(EditObjectPlayer[playerid] != INVALID_OBJECT_ID) DestroyDynamicObject(EditObjectPlayer[playerid]);
	EditObjectPlayer[playerid] = INVALID_OBJECT_ID;
	EditObjectToVehicle[playerid] = number;
	static Float:X,Float:Y,Float:Z;
	GetVehiclePos(OwnableCar[number], X,Y,Z);
	EditObjectPlayer[playerid] = CreateDynamicObject(model, X, Y, Z, 0.0, 0.0, 0.0, -1,-1,-1, 150.0, 150.0);
	SetDynamicObjectPos(EditObjectPlayer[playerid], X,Y,Z);
	GetVehicleRot(OwnableCar[number], X,Y,Z);
	SetDynamicObjectRot(EditObjectPlayer[playerid], X,Y,Z);
	EditDynamicObject(playerid, EditObjectPlayer[playerid]);
}
stock RefreshInvStall(id, slot)
{
	InventoryStall[id][0][slot] = -1;
	InventoryStall[id][1][slot] = 0;
	InventoryStall[id][2][slot] = 0;
	InventoryStall[id][3][slot] = 0;
	InventoryStallString[id][slot] = "null";
	InventoryStall_Owner[id][slot] = "null";
	InventoryStall_Price[id][slot] = 0;
}
public: LoadStalls()
{
	for(new i; i < sizeof(StallStaticData); i++)
	{
		//RefreshInvStall(i);
		LoadStall_MySQL(i);
		LoadStall_Object(i);
	}
	//mysql load
	//static load
	return 1;
}
stock LoadStall_MySQL(id)
{
	for(new j; j < 30; j++) RefreshInvStall(id, j);
	cache_get_int(id, "ID", StallData[id][sID]);
	cache_get_string(id, "Owner", StallData[id][sOwner]);
	cache_get_string(id, "Name", StallData[id][sName]);
	cache_get_int(id, "Interior", StallData[id][sInterior]);
	cache_get_int(id, "Lock", StallData[id][sLock]);
	cache_get_int(id, "Cost", StallData[id][sCost]);
	cache_get_int(id, "ProductsEx", StallData[id][sProductsEx]);
	cache_get_int(id, "Nalog", StallData[id][sNalog]);
	cache_get_int(id, "Balance", StallData[id][sBalance]);
	cache_get_int(id, "Level", StallData[id][sLevel]);
	cache_get_int(id, "MinPrice", StallData[id][sMinPrice]);
	LoadInvStall(id, id);
	return 1;
}
stock LoadInvStall(get, id)
{
	cache_get_string(get, "Inventory_0", str_1), sscanf(str_1, "p<,>a<i>[30]", InventoryStall[id][0]);
	cache_get_string(get, "Inventory_1", str_1), sscanf(str_1, "p<,>a<i>[30]", InventoryStall[id][1]);
	cache_get_string(get, "Inventory_2", str_1), sscanf(str_1, "p<,>a<i>[30]", InventoryStall[id][2]);
	cache_get_string(get, "Inventory_3", str_1), sscanf(str_1, "p<,>a<i>[30]", InventoryStall[id][3]);
	cache_get_string(get, "Inventory_String", str_1);
	sscanf_string(str_1, InventoryStallString[id], ',');

	cache_get_string(get, "Inventory_Owner", str_1);
	sscanf_string(str_1, InventoryStall_Owner[id], ',');
	
	cache_get_string(get, "Inventory_Price", str_1), sscanf(str_1, "p<,>a<i>[30]", InventoryStall_Price[id]);
}
new const e_shop_selectint[][] = 
{
	{10000000,15930},
	{20000000,15931},
	{30000000,15932},
	{40000000,15933}
};
stock LoadStall_Object(i)
{	
	//15933 max
	//15930 min
	StallObject[i][0] = CreateDynamicObject(e_shop_selectint[StallData[i][sInterior]][1], StallStaticData[i][0], StallStaticData[i][1], StallStaticData[i][2], 0.000000, 0.000000, StallStaticData[i][3], -1, 9, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD); // 0
	if(StallStaticData[i][3] < 0)
	{
		StallObject[i][1] = CreateDynamicObject(15935, StallStaticData[i][0]-0.00036599999, StallStaticData[i][1]+0.75, StallStaticData[i][2]+3.650025, 0.000000, 0.000000, 0.024994, -1, 9, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD); // 1
	}
	else
	{
		StallObject[i][1] = CreateDynamicObject(15935, StallStaticData[i][0]+0.00036599999, StallStaticData[i][1]-0.75, StallStaticData[i][2]+3.650025, 0.000000, 0.000000, 180.000000, -1, 9, -1, STREAMER_OBJECT_SD, STREAMER_OBJECT_DD); // 1
	}
	str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{824A12}Магазин №%i\n{000000}\"%s\"", i, StallData[i][sName]);
	SetDynamicObjectMaterialText(StallObject[i][1], 0, str_mes, 120, "Verdana", 20, 1, 0xFF000000, 0, 1);

	//pickup
	new Float:x = StallStaticData[i][0], Float:y = StallStaticData[i][1], Float:z = StallStaticData[i][3];
	ShiftCords(0, x, y, z, 3.998978);
	if(z < 0) x += 2.302132;
	else x -= 2.302132;
	CreatePickup(19134, 64, x, y, 1000.4800, -1);
	CreateInteractionMenu("[[132,\"Открыть меню киоска\"]]", x, y, 1000.4800, 4.0, interMenu_Stall, i, -1, 9);
	Stall_EnterArea[i] = CreateDynamicSphere(x, y, 1000.4800, 4.0, -1, 9);
	return 1;
}
stock player_Stall_Open(playerid)
{
	//SCM(playerid,-1499227478, "Возникли вопросы? Используйте \"/help\" и перейдите в раздел \"Киоски\".");
	ExecutePacket(playerid, webUpdate, "interface('Business').close()");
	new id = player_EnterStall[playerid];
	if(id == -1) player_Stall_Close(playerid);
	else if(!IsStallOwned(id))
	{
		SPD(playerid, 20426, DIALOG_STYLE_MSGBOX, "{FFFFFF}Выберите действие", "\
			{FFFFFF}Киоск на продаже\n\
			{FFDD00}Хотите приобрести его?", "Да", "Нет");
	}
	else if(GetString(StallData[id][sOwner], PN(playerid)))
	{
		ExecutePacket(playerid, webClose, "StallCard");
		ExecutePacket(playerid, webOpen, "StallCard");
	}
	else
	{
		ExecutePacket(playerid, webClose, "Stall", str_1);
		str_1[0] = EOS;
		GetStallCellData(id);
		ExecutePacket(playerid, webOpen, "Stall", str_1);
	}
}
stock player_Stall_Close(playerid)
{
	//player_EnterStall[playerid] = -1;
	ExecutePacket(playerid, webClose, "StallCard");
	return 1;
}
stock player_Stall_Click(playerid, click)
{
	new id = player_EnterStall[playerid];
	if(id == -1) player_Stall_Close(playerid);
	else
	{
		DeletePVar(playerid, "stallManage_removeItem");
		switch(click)
		{
			case 1:
			{
				if(!GetString(StallData[id][sOwner], PN(playerid)))
				{
					SCM(playerid,-2127958, "Данное меню вам сейчас недоступно.");
				}
				else
				{
					ExecutePacket(playerid, webClose, "StallManage");
					ExecutePacket(playerid, webUpdate, (str_f("\
						openInterface('StallManage', '[%i, \"%s\", %i.00, %i, %i, 0, 0, 0, %i, 7]')",\
							id, StallData[id][sName], StallData[id][sBalance], StallData[id][sLevel], StallData[id][sProductsEx], ((StallData[id][sNalog]-global_time) / 86400))));
					//openInterface('StallManage', '[3, "1331", 123132.123132, 2, 1, 4, 4, 4, 7, 15]')
				}
				return 1;
			}
			case 2:
			{
				ExecutePacket(playerid, webClose, "StallCard");
				ExecutePacket(playerid, webClose, "Stall");
				str_1[0] = EOS;
				GetStallCellData(id);
				ExecutePacket(playerid, webOpen, "Stall", str_1);
				return 1;
			}
			case 10:
			{
				str_1[0] = EOS;
				for(new i; i < sizeof(e_shop_selectint); i++)
				{
					f(str_1, sizeof(str_1), "%s{FFFFFF}№%i\t\t{FFDD00}%i руб.\n", str_1, i+1, e_shop_selectint[i][0]);
				}
				SPD(playerid, 20448, DIALOG_STYLE_LIST, "Список интерьеров", str_1, "Далее", "Назад");
			}
		}
	}
	return player_Stall_Close(playerid);
}
stock StallCount_FreeSlot(id)
{
	new count;
	for(new i; i < 10*StallData[id][sLevel]; i++)
	{
		if(InventoryStall[id][0][i] == -1) count++;
	}
	return count;
}
stock StallSearch_FreeSlot(id)
{
	for(new i; i < 30; i++)
	{
		if(InventoryStall[id][0][i] == -1) return i;
	}
	return -1;
}
stock player_StallBuy_Click(playerid, slot)
{
	//SCMf(playerid, -1, "player_StallBuy_Click %i", item);
	new id = player_EnterStall[playerid];
	//SCMf(playerid, -1, "%i %i", id, slot);
	if(id != -1)
	{
		if(PI[playerid][pLevel] < 2)
		{
			SCM(playerid,-2127958, "Данное меню доступно со второго уровня.");
			return 1;
		}
		new item = InventoryStall[id][0][slot];
		if(item != -1)
		{
			player_ShowUID[playerid][88] = slot;
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{FFCD00}Покупка \\'%s\\'", ItemsData[item][ItemName]);
			SPD(playerid, 20438, 1, str_mes, (str_f("{E9E9E9}Сколько вы желаете приобрести?\n\
				На продаже: {33AA33}%i {E9E9E9}ед.", InventoryStall[id][1][slot])), "Далее","Назад");
		}
	}
	return 1;
}
stock player_StallBuy_Select(playerid, item)
{
	//SCMf(playerid, -1, "player_StallBuy_Select %i", item);
	new id = player_EnterStall[playerid];
	if(id != -1)
	{
		player_ShowUID[playerid][111] = item;
		if(GetPVarInt(playerid, "stallManage_removeItem") == 1228 && GetString(StallData[id][sOwner], PN(playerid)))
		{
			//снять товар
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{FFCD00}Предмет \\'%s\\'", ItemsData[item][ItemName]);
			SPD(playerid, 20445, DIALOG_STYLE_MSGBOX, str_mes, "Вы действительно хотите снять с продажи этот предмет?", "Да", "Нет");
		}
		else if(!GetString(InventoryStall_Owner[id][item], PN(playerid)))
		{
			//покупка
			//if(GetStrMoney(playerid) < InventoryStall_Price[id][item]) return SCM(playerid, 0xADCEEAFF, "* Недостаточно средств для покупки");
		}
		else
		{
			//снять товар
			str_mes[0] = EOS, f(str_mes, sizeof(str_mes), "{FFCD00}Предмет \\'%s\\'", ItemsData[item][ItemName]);
			SPD(playerid, 20442, DIALOG_STYLE_MSGBOX, str_mes, "Вы действительно хотите снять с продажи этот предмет?", "Да", "Нет");
			ExecutePacket(playerid, webClose, "Stall");
		}
	}
	return 1;
}
stock player_StallBuy_Close(playerid)
{
	//SCM(playerid, -1, "player_StallBuy_Close");
	ExecutePacket(playerid, webClose, "Stall");
	DeletePVar(playerid, "stallManage_removeItem");
	return 1;
}
stock OnPlayerInventorySell(playerid, type, slot)
{
	if(PI[playerid][pLevel] < 2) return player_DisplayText(playerid, "Продавать предметы можно с 2 уровня!");
	if(type != 1) return player_DisplayText(playerid, "Продавать предметы можно только с инвентаря!");
	new id = player_EnterStall[playerid];
	if(id != -1)
	{
		if(StallCount_FreeSlot(id) > 0)
		{
			if(Inventory[playerid][0][slot] == 293 || Inventory[playerid][0][slot] == 0)
			{
				GameTextForPlayerEx(playerid, "Вы не сможете это сделать: данный предмет является временным", 3000, 0);
				UpdateInvCell(playerid);
				return 1;
			}
			player_SlotStall[playerid] = slot;
			SPD(playerid, 20424, DIALOG_STYLE_INPUT, "{FFCD00}Продажа предмета", (str_f("\
				{E9E9E9}Введите цену за {33AA33}1 {E9E9E9}шт.\n\
				Цена не должна быть меньше {33AA33}%i {E9E9E9}руб.", StallData[id][sMinPrice])), "Далее","Назад");
		}
		else SCM(playerid,-2127958, "В киоске закончилось свободное место, мы не сможем принять ваш товар на продажу.");
	}
	else
	{
		SCM(playerid,-1499227478, "Вы не находитесь возле места для продажи.");
		SCM(playerid,-1499227478, "Могут подойти: киоски, антикварные лавки, прием металлолома/улова/урожая.");
	}
	return 1;
}
stock SaveInvStall(id)
{
	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryStall[id][0][i]);
	}
	UpdateDataStr("Stalls", "Inventory_0", str_1, StallData[id][sID]);

	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryStall[id][1][i]);
	}
	UpdateDataStr("Stalls", "Inventory_1", str_1, StallData[id][sID]);

	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryStall[id][2][i]);
	}
	UpdateDataStr("Stalls", "Inventory_2", str_1, StallData[id][sID]);

	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryStall[id][3][i]);
	}
	UpdateDataStr("Stalls", "Inventory_3", str_1, StallData[id][sID]);

	UpdateDataStr("Stalls", "Inventory_String", String_PackMassive(InventoryStallString[id]), StallData[id][sID]);

	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		if(strlen(InventoryStall_Owner[id][i]) < 2) 
		{
			InventoryStall_Owner[id][i] = "null";
		}
		f(str_1, sizeof(str_1), "%s%s,", str_1, InventoryStall_Owner[id][i]);
	}
	UpdateDataStr("Stalls", "Inventory_Owner", str_1, StallData[id][sID]);

	str_1[0] = EOS;
	for(new i; i < 30; i++)
	{
		f(str_1, sizeof(str_1), "%s%i,", str_1, InventoryStall_Price[id][i]);
	}
	UpdateDataStr("Stalls", "Inventory_Price", str_1, StallData[id][sID]);
	return 1;
}
//[[32, "Supermarketddd"], ["Начинающий"], 0, 1, 0, 0, 0,0,0,7,[0, 0, 0],-1,false, [255,1,3,4,5,6,7,8,9,10,11]]
stock GetStallCellData(id)
{
	str_1 = "[";
	new count;
	for(new i; i < 30; i++)
	{
		new item = InventoryStall[id][0][i];
		if(item == -1) continue;
		switch(item)
		{
			case 99:
			{
				f(str_1, sizeof(str_1), "\
					%s[\"%s\", %i, [99, %i, \"%s\"], %i, \"%s\"],", 
					str_1, InventoryStall_Owner[id][i], InventoryStall_Price[id][i], InventoryStall[id][2][i],  InventoryStallString[id][i], i, StallData[id][sName]);
			}
			case 100:
			{
				f(str_1, sizeof(str_1), "\
					%s[\"%s\", %i, [100,0,%i], %i, \"%s\"],", 
					str_1, InventoryStall_Owner[id][i], InventoryStall_Price[id][i], InventoryStall[id][2][i], i, StallData[id][sName]);
			}
			default:
			{
				f(str_1, sizeof(str_1), "\
					%s[\"%s\", %i, [%i, %i, \"%s\"], %i, \"%s\"],", 
					str_1, InventoryStall_Owner[id][i], InventoryStall_Price[id][i], item, InventoryStall[id][2][i], ItemsData[item][ItemName], i, StallData[id][sName]);
			}
		}
		count++;
	}
	if(count > 0)
	{
		strdel(str_1, strlen(str_1)-1, strlen(str_1));
	}
	strcat(str_1, "]");
}
