	PI[playerid][pJob_ID][i] = -1;			// работа
	PI[playerid][pJob_BizID][i] = -1;
	PI[playerid][pJob_Style][i] = -1;
	PI[playerid][pTemp_JobCarID][i] = -1;
	player_Carriers_BizID[playerid] = -1;
	return 1;
}
stock player_JobSave(playerid)
{
	str_1[0] = EOS;
	for(new i; i < 3; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, PI[playerid][pJob_ID][i]);
	UpdatePlayerDataStr(playerid, "Job_ID", str_1);

	str_1[0] = EOS;
	for(new i; i < 3; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, PI[playerid][pJob_BizID][i]);
	UpdatePlayerDataStr(playerid, "Job_BizID", str_1);

	str_1[0] = EOS;
	for(new i; i < 3; i++) f(str_1, sizeof(str_1), "%s%i,", str_1, PI[playerid][pJob_Style][i]);
	UpdatePlayerDataStr(playerid, "Job_Style", str_1);
	return 1;
}
CMD:getban(playerid, get[])
{
	extract get -> new string:name[21]; else return SCM(playerid, 0xCECECEFF, "Используйте: /getban [name]");
	str_mes[0] = EOS, mysql_escape_string(name, str_mes, 24);

	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin`, `Reason`, FROM_UNIXTIME(timeout, '%%Y-%%m-%%d %%H:%%m:%%s') AS `date` FROM `Ban_List` WHERE `Owner` = '%s' LIMIT 1;", str_mes);
	new Cache:rslt = mysql_query(mysql, str_q);

	//init and eos data
	static admin[24], reason[36], date[128];
	str_1[0] = EOS;

	if(cache_num_rows() > 0)
	{
		cache_get_string(0, "Admin", admin);
		cache_get_string(0, "Reason", reason);
		cache_get_string(0, "date", date);
		f(str_1, sizeof(str_1), "Временная блокировка от %s, до %s. Причина: %s\n", admin, date, reason);
	}
	cache_delete(rslt);

	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin`, `Reason`, `IP` FROM `BanIp_List` WHERE `Owner` = '%s' LIMIT 1;", str_mes);
	new Cache:rslt_1 = mysql_query(mysql, str_q);

	if(cache_num_rows() > 0)
	{
		cache_get_string(0, "Admin", admin);
		cache_get_string(0, "Reason", reason);
		cache_get_string(0, "IP", date);
		f(str_1, sizeof(str_1), "%sБлокировка IP (%s) от %s. Причина: %s\n", str_1, date, admin, reason);
	}
	cache_delete(rslt_1);

	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT `Admin`, `Reason`, `Hash` FROM `BanHWID_List` WHERE `Owner` = '%s' LIMIT 1;", str_mes);
	new Cache:rslt_2 = mysql_query(mysql, str_q);

	if(cache_num_rows() > 0)
	{
		cache_get_string(0, "Admin", admin);
		cache_get_string(0, "Reason", reason);
		cache_get_string(0, "Hash", date);
		f(str_1, sizeof(str_1), "%sБлокировка HWID (%s) от %s. Причина: %s\n", str_1, date, admin, reason);
	}
	cache_delete(rslt_2);

	SPD(playerid, 0, 0, str_mes, str_1, "Закрыть", "");
	return 1;
}
alias:getban("get_ban")
