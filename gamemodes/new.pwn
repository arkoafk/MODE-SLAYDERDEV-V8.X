    SCM(playerid, 0xc7dae8FF, "{FFFFFF}Кнопка **Деморган** посадит игрока в **Деморган**.");
    SCM(playerid, 0xc7dae8FF, "{FFFFFF}Кнопка **Мут** **Замутит** игрока.");
    SCM(playerid, 0xc7dae8FF, "{FFFFFF}Кнопка **Подкинуть** **Подкинет** игрока.");
    SCM(playerid, 0xc7dae8FF, "{FFFFFF}Кнопка **Информация** покажет **Информацию** об игроке.");
    SCM(playerid, 0xc7dae8FF, "{FFFFFF}Кнопка **Выход** **Выкинет** из слежки за игроком.");
