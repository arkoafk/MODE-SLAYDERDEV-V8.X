stock player_DeathMenu_Open(playerid)
{
	if(OpenInterface[playerid][23]) return 0;
	OpenInterface[playerid][23] = true;
	player_DeathTimeOut[playerid] = 600;
	//player_DeathMenu_Update(playerid);
	return 1;
}
stock player_DeathMenu_Update(playerid)
{
	static Float:Pos[4];
	GetPlayerPos(playerid, Pos[0], Pos[1], Pos[2]);
	GetPlayerFacingAngle(playerid, Pos[3]);
	for(new i; i < 4; i++)
	{
		player_DeathPos[playerid][i] = Pos[i];
	}

	TogglePlayerControllable(playerid, false);
	ShiftCords(0, Pos[0], Pos[1], Pos[3], 0.2);

	SetPlayerCameraPos(playerid, Pos[0], Pos[1], Pos[2]+1.3);
	SetPlayerCameraLookAt(playerid, Pos[0], Pos[1], Pos[2]);
	ApplyAnimation(playerid, "SWEET", "Sweet_injuredloop",	4.0, true, 0, 0, 0, 0, 1);
	SetPlayerHealth(playerid, 25.0);
	ExecutePacket(playerid, webOpen, "Death", (str_f("[%i, 5000000]", player_DeathTimeOut[playerid])));
	return 1;
}
stock player_DeathMenu_Close(playerid)
{
	OpenInterface[playerid][23] = false;
	player_DeathTimeOut[playerid] = 0;
	ExecutePacket(playerid, webClose, "Death");
	for(new i; i < 4; i++)
	{
		player_DeathPos[playerid][i] = 0.0;
	}
	PI[playerid][pHospital] = true;
	UpdatePlayerDataInt(playerid, "Hospital", PI[playerid][pHospital]);
	player_Spawn(playerid);
	return 1;
}
stock player_ClientSideKey(playerid, keys)
{
	/*
	window.KEY_CODE_ENTER = 13, 
