stock player_GetVehiclePos(playerid, number)
{
	if(CompareInt64(playerid, "<", 300000)) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
	//if(player_Cash[playerid] < 300000) return SCM(playerid, 0x999999FF, !"Недостаточно денег");
	GivePlayerMoneyEx(playerid, -300000, "Метка ТС на GPS", true, true);
	GiveBusinessMoney(playerid, player_SearchBiz(playerid, 29), -150000, -20);
	new Float:Position[3];
	GetVehiclePos(OwnableCar[number], Position[0], Position[1], Position[2]);
	EnablePlayerGPS(playerid, 55, Position[0], Position[1], Position[2], "Местоположение Вашего транспорта отмечено на GPS");
	return 1;
}
CMD:addbiz(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new type, string:name[12]; else return cmd_addbiz(playerid);
	if(type < 0 || type >= sizeof(BizStaticData)) return cmd_addbiz(playerid);
	//if(cost < 0 || cost > 2000000000) return cmd_addbiz(playerid);
	SendAdminsMessagef(0x999999FF, "Админ %s[%i] создал бизнес №%i c параметрами [name: %s %s, type: %i]", PN(playerid), playerid, TOTAL_BUSINESSES, BizStaticData[type][bsName], name, type);
	static Float:position[4];
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	GetPlayerFacingAngle(playerid, position[3]);
	str_1[0] = EOS, mysql_escape_string(name, str_1);
	str_q[0] = EOS, f(str_q, sizeof(str_q), "INSERT INTO `Businesses`(`Name`, `Enter`, `Type`) VALUES ('%s', '%.2f,%.2f,%.2f,%.2f,', '%i')", str_1, position[0], position[1], position[2], position[3], type);
	mysql_tquery(mysql, str_q, "func_AddBiz");
	return 1;
}
public: func_AddBiz()
{
	str_q[0] = EOS, f(str_q, sizeof(str_q), "SELECT * FROM `Businesses` WHERE `ID` = '%i' LIMIT 1;", cache_insert_id());
	mysql_tquery(mysql, str_q, "LoadBusinessMySQL", "i", 0);
	return 1;
}
stock cmd_addbiz(playerid)
{
	SCM(playerid, 0xCECECEFF, !"Используйте: /addbiz [type] [name]");
	SCM(playerid, -1, !"Чтобы не ставить [name], напишите без кавычек \"null\"");
	str_2 = "(type)id - name\n";
	for(new i; i < sizeof(BizStaticData); i++)
	{
		str_1[0] = EOS, f(str_1, sizeof(str_1), "%i - %s\n", i, BizStaticData[i][bsName]);
		strcat(str_2, str_1);
	}
	SPD(playerid, 0, 0, "addbiz", str_2, "Закрыть", "");
	return 1;
}
stock EnterPlayerToBiz(playerid, id)
{
	if(id != -1)
	{
		new type = BizData[id][bType];
		if(BizStaticData[type][bsExit][0] == 0.0) return SCM(playerid, COLOR_RED, !"[Ошибка] {FFFFFF}У данного бизнеса нет входа!");
		SetPlayerPosEx(playerid, BizStaticData[type][bsExit][0], BizStaticData[type][bsExit][1], BizStaticData[type][bsExit][2], 0.0, \
			BizStaticData[type][bsInterior], id+5, false);
		player_BizEntered[playerid] = id;
		player_EnterBiz[playerid] = -1;
		if(type == 16)
		{
			if(PI[playerid][pSettings][6] != false)
			{
				ExecutePacket(playerid, webUpdate, "playSound('sounds/casino/background.wav', true, 1)");
				ExecutePacket(playerid, webUpdate, "setCurrentVolume(0.01, 1)");
			}
		}
		if(GetString(PN(playerid), BizData[id][bOwner]))
		{
			
		}
	}
	return 1;
}
stock GiveBusinessMoney(playerid, id, money, product)
{
	if(id == -1) return 0;
	if(playerid != INVALID_PLAYER_ID)
	{
		if(GetString(BizData[id][bOwner], PN(playerid))) return -3;
	}
	if(!IsIntEx(BizData[id][bBalance], money)) return -2;
	if(!IsIntEx(BizData[id][bProducts], product)) return -1;
	BizData[id][bProducts] += product;
	UpdateDataInt("Businesses", "Products", BizData[id][bProducts], BizData[id][bID]);

	BizData[id][bBalance] += money;
	BizData[id][bBalance_ForDay] += money;
	UpdateDataInt("Businesses", "Balance", BizData[id][bBalance], BizData[id][bID]);
	//add profit stat
	str_q[0] = EOS, mysql_format(mysql, str_q, sizeof(str_q), "\
		INSERT INTO `Businesses_Profit` (`bizID`, `time`,`money`) VALUES ('%i','%i','%i')", \
			BizData[id][bID], global_time, money);

	mysql_tquery(mysql, str_q);
	new idEx = GetFamilyID(BizData[id][bGangRoof_ID]);
	if(idEx >= 0)
	{
		if(!IsIntEx(FamilyData[idEx][fBalance], money/10)) return -4;
		FamilyData[idEx][fBalance] += money/10;
		UpdateDataInt("Familys", "Balance", FamilyData[idEx][fBalance], FamilyData[idEx][fID]);
		UpdateHouse_Store(FamilyData[idEx][fGang_BaseID], false);
	}
	return 1;
}
CMD:buybiz(playerid)
{
	new id = player_EnterBiz[playerid];
	if(id == -1) return SCM(playerid, 0xCECECEFF, !"Вы должны быть рядом с бизнесом, который хотите купить.");
	player_GetTickCount[playerid] = GetTickCount();
	SPD(playerid, 20251, 0, "{33AACC}Покупка нового бизнеса", (str_f("\
		{FFFFFF}Название:\t\t\t{339999}%s %s\n\
		{FFFFFF}Стоимость:\t\t\t{6699FF}%i руб\n\
		{FFFFFF}Плата за аренду:\t\t{6699FF}%i руб в день\n\n\
		{669966}Вы уверены что хотите купить этот бизнес?", \
		BizStaticData[BizData[id][bType]][bsName], BizData[id][bName], \
		BizData[id][bCost], BizStaticData[BizData[id][bType]][bsNalog])), "Да", "Нет");
	return 1;
}
stock ChangeBusinessOwner(id, const name[])
{
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Бизнес %i, Владелец %s, Новый владелец %s.", id, BizData[id][bOwner], name);
	SendLog(3, str_log);

	SetString(BizData[id][bOwner], name);
	UpdateDataStr("Businesses", "Owner", BizData[id][bOwner], BizData[id][bID]);

	BizData[id][bNalog] = global_time+(86400*3);
	UpdateDataInt("Businesses", "Nalog", BizData[id][bNalog], BizData[id][bID]);
	UpdateBiz(id, false);
}
stock ChangeStallOwner(id, const name[])
{
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Киоск %i, Владелец %s, Новый владелец %s.", id, BizData[id][bOwner], name);
	SendLog(3, str_log);

	//StallData[id][sLevel] = 1;
	SetString(StallData[id][sOwner], name);
	UpdateDataStr("Stalls", "Owner", StallData[id][sOwner], StallData[id][sID]);

	StallData[id][sNalog] = global_time+(86400*3);
	UpdateDataInt("Stalls", "Nalog", StallData[id][sNalog], StallData[id][sID]);
	UpdateBiz(id, false);
}
stock ChangeCarOwner(number, const name[], bool:save=true)
{
	//printf("ChangeCarOwner -> [id: %i] [old: %s] [new: %s]", number, CarData[number][cOwner], name);
	str_log[0] = EOS, f(str_log, sizeof(str_log), "Авто %i, Владелец %s, Новый владелец %s.", CarData[number][cID], CarData[number][cOwner], name);
	SendLog(4, str_log);
	SetString(CarData[number][cOwner], name);
	if(save != false)
	{
		UpdateDataStr("OwnableCars", "Owner", CarData[number][cOwner], CarData[number][cID]);
	}
}
CMD:business(playerid)
{
	if(player_TradeID[playerid] != INVALID_PLAYER_ID) return SCM(playerid, COLOR_RED, "Ошибка: {FFFFFF}Во время обмена имущества невозможно, использовать это!");
	cmd_business(playerid);
	return 1;
}
alias:business("bizinfo")
stock cmd_business(playerid, dialogid=20252)
{
	str_1[0] = EOS;
	new count;
	memset(player_ShowID[playerid], -1);
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(!GetString(BizData[i][bOwner], PN(playerid))) continue;
		str_d[0] = EOS, GetBusinessName(i, str_d);
		str_2[0] = EOS, f(str_2, sizeof(str_2), "{FFFFFF}%i. - %s (№%i)\tВладелец\n", count, str_d, i);
		strcat(str_1, str_2);
		player_ShowID[playerid][count] = i;
		count++;
	}
	switch(count)
	{
		case 0: SCM(playerid, 0x999999FF, !"У вас нет бизнеса.");
		case 1: 
		{
			if(dialogid == 20252) ShowPlayerBusinessData(playerid, player_ShowID[playerid][0]);
			else SPD(playerid, dialogid, DIALOG_STYLE_LIST, "{FFCD00}Выберите бизнес", str_1, "Выбрать", "Закрыть");
		}
		default: SPD(playerid, dialogid, DIALOG_STYLE_LIST, "{FFCD00}Выберите бизнес", str_1, "Выбрать", "Закрыть");
	}
	return 1;
}
stock GetBusinessName(id, string[])
{
	string[0] = EOS, f(string, 40, "%s", BizStaticData[BizData[id][bType]][bsName]);
	if(strlen(BizData[id][bName]) > 1)
	{
		f(string, 50, "%s %s", string, BizData[id][bName]);
	}
}
