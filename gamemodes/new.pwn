CMD:rename_cmd(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new string:str[36], string:str_new[36]; else return 1;
	PC_RenameCommand(str, str_new);
	SCM(playerid, -1, "rn_cmd++");
	return 1;
}
stock RemoveFamilyMoneyEx(playerid, count)
{
	new house_id = family_IsPlayerHouseOwner(playerid);
	if(house_id != -1)
	{
		new idEx = GetFamilyID(PI[playerid][pFamily_ID]);
		if(idEx >= 0)
		{
			if(FamilyData[idEx][fBalance] < count)
			{
				return 0;
			}
			else
			{
				if(!FamilyRang_Deputy[idEx][PI[playerid][pFamily_Rang]-1]) 
				{
					SCM(playerid, 0xFF6600FF, "Вам недоступна данная функция");
					return 0;
				}
				GivePlayerMoneyEx(playerid, count, "Положил деньги на склад банды");
				FamilyData[idEx][fBalance] -= count;
				UpdateDataInt("Familys", "Balance", FamilyData[idEx][fBalance], FamilyData[idEx][fID]);
				UpdateHouse_Store(FamilyData[idEx][fGang_BaseID], false);
			}
		}
	}
	return 1;
}
CMD:okay(playerid, get[])
{
	extract get -> new to_player; else return SCM(playerid, 0xCECECEFF, "Используй: /okay [id игрока]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(GetString(PI[to_player][pNickName], PI[to_player][pNickName_Set]))
	{
		return SCM(playerid, 0xCECECEFF, "Игрок не подавал запрос на смену ника");
	}
	SendAdminsMessagef(0x999999FF, "[A] %s[%d] одобрил заявку на смену никнейма %s[%i] >> %s", PN(playerid), playerid, PN(to_player), to_player, PI[to_player][pNickName_Set]);
	player_ChangePlayerName(to_player, PI[to_player][pNickName_Set]);
	return 1;
}
CMD:nokay(playerid, get[])
{
	extract get -> new to_player, string:reason[64]; else return SCM(playerid, 0xCECECEFF, "Используй: /nokay [id игрока] [reason]");
	if(!IsPlayerConnected(to_player) || !IsPlayerLogged(to_player))
		return SCM(playerid, 0xCECECEFF, "Такого игрока нет");
	if(GetString(PI[to_player][pNickName], PI[to_player][pNickName_Set]))
	{
		return SCM(playerid, 0xCECECEFF, "Игрок не подавал запрос на смену ника");
	}
	SetString(PI[to_player][pNickName_Set], PI[to_player][pNickName]);
	SPD(to_player, 0, DIALOG_STYLE_MSGBOX, "{FFD83D}Имя изменено", "\
			{66FF00}Заявка на изменение имени одобрена, новое имя установлено.\n\n\
			{FFFFFF}В следующий раз при входе в игру используйте свое новое имя. Для\n\
			этого нужно изменить его в окне клиента CRMP. Рекомендуем прямо\n\
			сейчас свернуть игру и сделать это.", "Ок", "");
	SendAdminsMessagef(COLOR_GREY, "[A] %s[%i] отменил заявку на смену ника %s[%i]. Причина: %s", PN(playerid), playerid, PN(to_player), to_player, reason);
	SCMf(to_player, 0xFF6600FF, "Администратор %s отменил вашу заявку на смену ника. Причина: %s", PN(playerid), reason);
	return 1;
}
stock player_ChangePlayerName(playerid, const name[])
{
	for(new i; i < TOTAL_HOUSES; i++)
	{
		if(!GetString(HouseData[i][hOwner], PN(playerid))) continue;
		ChangeHouseOwner(i, name);
	}
	for(new i; i < TOTAL_BUSINESSES; i++)
	{
		if(!GetString(BizData[i][bOwner], PN(playerid))) continue;
		ChangeBusinessOwner(i, name);
	}
	for(new i; i < TOTAL_GARAGES; i++)
	{
		if(!GetString(GarageData[i][gOwner], PN(playerid))) continue;
		ChangeGarageOwner(i, name);
	}
	if(PI[playerid][pFamily_ID] != -1)
	{
		for(new i; i < TOTAL_FAMILYS; i++)
		{
			if(!GetString(FamilyData[i][fOwner], PN(playerid))) continue;
			ChangeFamilyOwner(i, name);
			break;
		}
	}
	foreach(new i: OWNABLECARS)
	{
		if(!GetString(CarData[i][cOwner], PN(playerid))) continue;
		ChangeCarOwner(i, name, false);
	}
	mysql_tquery(mysql, (str_f("UPDATE `OwnableCars` SET `Owner` = '%s' WHERE `Owner` = '%s';", name, PN(playerid))));

	for(new i; i < sizeof(StallStaticData); i++)
	{
		if(GetString(StallData[i][sOwner], PN(playerid)))
		{
			ChangeStallOwner(i, name);
		}
		for(new j; j < 30; j++)
		{
			if(GetString(InventoryStall_Owner[i][j], PN(playerid)))
			{
				SetString(InventoryStall_Owner[i][j], name);
			}
		}
		str_1[0] = EOS;
		new bool:set;
		for(new j; j < 30; j++)
		{
			if(GetString(InventoryStall_Owner[i][j], PN(playerid)))
			{
				SetString(InventoryStall_Owner[i][j], name);
				set = true;
				if(strlen(InventoryStall_Owner[i][j]) < 2) 
				{
					InventoryStall_Owner[i][j] = "null";
				}
				f(str_1, sizeof(str_1), "%s%s,", str_1, InventoryStall_Owner[i][j]);
			}
		}
		if(set)
		{
			UpdateDataStr("Stalls", "Inventory_Owner", str_1, StallData[i][sID]);
		}
	}
	SetString(PI[playerid][pNickName], name);
	SetPlayerName(playerid, name);
	mysql_tquery(mysql, (str_f("UPDATE `players` SET `NickName` = '%s' WHERE `ID` = '%i' LIMIT 1;", name, PI[playerid][pID])));
	return 1;
}
public: player_IsRegName(playerid)
{
	if(!cache_num_rows())
	{
		SPD(playerid, 0, DIALOG_STYLE_MSGBOX, "{FFD83D}Заявка на изменение имени",
			"{FFFFFF}Ваша просьба об изменении ника отправлена администрации.\n\
			Вы получите сообщение, как только заявка будет обработана.\n\n\
			Если в течении нескольких минут Ваше имя не было изменено,\n\
			то, скорее всего, оно не соответствует RP правилам,\n\
			либо Вы уже используете RP имя.", "Ок", "");

		SendAdminsMessagef(0x66CC99FF, "[Смена non rp имени] %s >> %s {FFCD00}| /okay %i для одобрения" , PN(playerid), PI[playerid][pNickName_Set], playerid);
	}
	else
	{
		SetString(PI[playerid][pNickName_Set], PN(playerid));
		GameTextForPlayerEx(playerid, "~r~Введенное Вами имя уже используется", 2000, 1);
	}
	return 1;
}
public: player_IsRegName_Donate(playerid)
{
	if(!cache_num_rows())
	{
		if(PI[playerid][pCash_Donate] < 123)
		{
			SCMf(playerid, 0xFF6600FF, "Недостаточно средств. Сейчас на Вашем счету %i руб.", PI[playerid][pCash_Donate]);
			return 1;
		}
		GivePlayerDonate(playerid, -123, "Сменил игровой ник-нейм", true, true);
		SendAdminsMessagef(0x66CC99FF, "[Смена имени] %s теперь стал >> %s", PN(playerid), PI[playerid][pNickName_Set]);
		player_ChangePlayerName(playerid, PI[playerid][pNickName_Set]);
	}
	else
	{
		SetString(PI[playerid][pNickName_Set], PN(playerid));
		GameTextForPlayerEx(playerid, "~r~Введенное Вами имя уже используется", 2000, 1);
	}
	return 1;
}
