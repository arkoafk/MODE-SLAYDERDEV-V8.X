stock IsAIP(const text[])
{
	new numbers;
	for(new i; i < strlen(text); i++) if('0' <= text[i] <= '9') if(!('0' <= text[i+1] <= '9')) numbers ++;
	if(numbers >= 4) return 1;
	return 0;
}
CMD:ahelp(playerid)
{
	if(GetPlayerAdminEx(playerid) >= 1) 
	{
		SCM(playerid, 0xFFFF00FF, !"Доступные команды:");
		new level = PI[playerid][pAdmin]+1;
		if(level > 11) level = 11;
		else if(level < 2) level = 2;
		for(new i=1; i < level; i++)
		{
			str_1[0] = EOS;
			strcat(str_1, (str_f("%i уровень:", i)));
			for(new j; j < sizeof(commandsAdminData); j++)
			{
				if(commandsAdminData[j][caLevel] == i)
				{
					strcat(str_1, (str_f(" /%s", commandsAdminData[j][caName])));
					if(strlen(str_1) > 100)
					{
						SCM(playerid, 0xCC9900FF, str_1);
						str_1[0] = EOS;
						strcat(str_1, (str_f("%i уровень:", i)));
						continue;
					}
				}
			}
			if(strlen(str_1) > 13) SCM(playerid, 0xCC9900FF, str_1);
		}
	}
	return 1;
}
CMD:asellgarage(playerid, get[])
{
    extract get -> new id, string:reason[25]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /asellgarage [id] [reason]");
	if(id < 0 || id > TOTAL_GARAGES-1) return 0;
	if(GetString(GarageData[id][gOwner], "Sell Nalog") && !NameIsFullDostup(PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Данный гараж нельзя продать, он выставлен на слёт.");
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "Админ %s[%i] продал гараж, владелец %s. Причина: %s", PN(playerid), playerid, GarageData[id][gOwner], reason);
	SendAdminsMessage(COLOR_GREY, str_mes);
	ChangeGarageOwner(id, "The State");
	return 1;
}
CMD:asellhouse(playerid, get[])
{
    extract get -> new id, string:reason[25]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /asellhouse [id] [reason]");
	if(id < 0 || id > TOTAL_HOUSES-1) return 0;
	if(GetString(HouseData[id][hOwner], "Sell Nalog") && !NameIsFullDostup(PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Данный биз нельзя продать, он выставлен на слёт.");
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "Админ %s[%i] продал дом, владелец %s. Причина: %s", PN(playerid), playerid, HouseData[id][hOwner], reason);
	SendAdminsMessage(COLOR_GREY, str_mes);
	ChangeHouseOwner(id, "The State");
	return 1;
}
alias:asellhouse("asellhome")
CMD:asellbiz(playerid, get[])
{
    extract get -> new id, string:reason[25]; else return SCM(playerid, 0xCECECEFF, !"Используйте: /asellbiz [id] [reason]");
	if(id < 0 || id > TOTAL_BUSINESSES-1) return 0;
	if(GetString(BizData[id][bOwner], "Sell Nalog") && !NameIsFullDostup(PN(playerid))) return SCM(playerid, 0xCECECEFF, !"Данный дом нельзя продать, он выставлен на слёт.");
	str_mes[0] = EOS, f(str_mes, sizeof str_mes, "Админ %s[%i] продал биз, владелец %s. Причина: %s", PN(playerid), playerid, BizData[id][bOwner], reason);
	SendAdminsMessage(COLOR_GREY, str_mes);
	ChangeBusinessOwner(id, "The State");
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "Админ %s продал бизнес, владелец %s. Причина: %s", str_log, BizData[id][bOwner], reason);
	SendLog(0, str_log);
	return 2;
}
stock SetPlayerHunger(playerid, Float:set)
{
	if(set <= 0.0 && PI[playerid][pHunger] <= 0.0) return 0;
	PI[playerid][pHunger] += set;
	if(PI[playerid][pHunger] > 100) PI[playerid][pHunger] = 100;
	else if(PI[playerid][pHunger] < 1) PI[playerid][pHunger] = 0;
	ExecutePacket(playerid, webUpdate, (str_f("interface('Hud').updateHungerLevel(%i)", floatround(PI[playerid][pHunger]))));
	return 1;
}
