					UpdateVehicleStrob(vehicleid);
				}
			}
			case 16: //[0,\"Багажник\",4,16,1],
			{
				new vehicleid = GetNearestVehicleID(playerid, 6.0);
				if(vehicleid != INVALID_VEHICLE_ID)
