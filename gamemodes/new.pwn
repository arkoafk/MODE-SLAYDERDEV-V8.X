stock InvRemove(playerid, uid, count, model = -1, wear = -1, const name[] = "")
{
	//printf("1. %i %i %i %i %s", uid, count, model, wear, name);
	//printf("2. %i %i %i %i %s", uid, count, model, wear, name);
	new counts = count;
	for(new i; i < 20; i++)
	{
		//check data
		if(uid != Inventory[playerid][0][i]) continue;
		if(model != -1 && Inventory[playerid][2][i] != model) continue;
		if(wear != -1 && Inventory[playerid][3][i] != wear) continue;
		if(strlen(name) > 1 && !GetString(InventoryString[playerid][i], name)) continue;
		//set data
		counts -= Inventory[playerid][1][i];
        Inventory[playerid][1][i] -= count;
        if(Inventory[playerid][1][i] < 1) RefreshInvPlayer(playerid, i);
		if(counts < 1)
		{
			OnPlayerInventory_WeaponSet(playerid, Inventory[playerid][0][i]);
			if(uid == 100 && model == PI[playerid][pSkin] && !GetInvCount(playerid, uid, model)) SetPlayerSkinEx(playerid, 252);
			if(OpenInterface[playerid][7]) UpdateInvCell(playerid);
			player_SaveInv{playerid} = 4;
			return 1;
		}
	}
	if(counts > 0) InvRemove(playerid, uid, count, model, wear, name);
	return 1;
}
stock InvRemoveEx(playerid, uid, count, model = -1, wear = -1, const name[] = "", const desc[] = "none")
{
	if(GetInvCount(playerid, uid, model, wear, name) < count) return 0;
	InvRemove(playerid, uid, count, model, wear, name);
	string_log[0] = EOS, f(string_log, sizeof(string_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(string_log, sizeof(string_log), "Игрок %s потерял предмет: %s(%i), шт: %i, модель: %i, износ: %i, имя: %s. Причина: %s", string_log, ItemsData[uid][ItemName], uid, count, model, wear, name, desc);
	SendLog(0, string_log);
	return 1;
}
stock InvAdd(playerid, uid, count, const notification[], model=0, wear=0, const name[]="", const desc[]="none")
{
	if(uid < 0 || uid >= sizeof(ItemsData)) return -1;
	if(uid == 100)
	{
		if(!IsValidSkin(model))
		{
			SCMf(playerid, 0xCECECEFF, "Неверный ID скина. (%i)", model);
			return 1;
		}
	}
	string_log[0] = EOS, f(string_log, sizeof(string_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(string_log, sizeof(string_log), "Игрок %s получил предмет: %s(%i), шт: %i, модель: %i, износ: %i, имя: %s. Причина: %s", string_log, ItemsData[uid][ItemName], uid, count, model, wear, name, desc);
	SendLog(0, string_log);
	if(strlen(notification) > 10 && count > 0) 
	{
		SCMf(playerid, 0xFFCD00FF, notification, ItemsData[uid][ItemName], count, model, name);
	}
	if(ItemsData[uid][ItemCombination] != false)
	{
		for(new i; i < 20; i++)
		{
			if(Inventory[playerid][0][i] != uid) continue;
			if(!AddInvItem(playerid, i, uid, count, model, wear, name)) continue;
			return 1;
		}
	}
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] != -1) continue;
		if(!SetInvItem(playerid, i, uid, count, model, wear, name)) continue;
		return 1;
	}
	SCM(playerid,-825307393, "* Нельзя взять этот предмет в таком количестве или Ваш инвентарь переполнен");
	SCM(playerid,-825307478, "Недостаточно места в инвентаре.");
	return 0;
}
stock TryInvAdd(playerid, uid)
{
	if(ItemsData[uid][ItemCombination] != false)
	{
		for(new i; i < 20; i++)
		{
			if(Inventory[playerid][0][i] != uid) continue;
			return i;
		}
	}
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] != -1) continue;
		return i;
	}
	SCM(playerid,-825307393, "* Нельзя взять этот предмет в таком количестве или Ваш инвентарь переполнен");
	SCM(playerid,-825307478, "Недостаточно места в инвентаре.");
	return -1;
}
stock SetInvItem(playerid, slot, uid, count, model, wear, const string[])
{
	if(Inventory[playerid][0][slot] == -1) Inventory[playerid][1][slot] = 0;
    new Amount;
    if(Inventory[playerid][1][slot] > 2000000000) return false;
    if(count > 2000000000) Amount = count - 2000000000, count = 2000000000;
	else if(count > 1 && !ItemsData[uid][ItemCombination]) 
	{
		Amount = count - 1;
		count = 1;
	}
	Inventory[playerid][0][slot] = uid;
	Inventory[playerid][1][slot] = count;
	Inventory[playerid][2][slot] = model;
	Inventory[playerid][3][slot] = wear;
	SetString(InventoryString[playerid][slot], string, 24);
	if(OpenInterface[playerid][7]) UpdateInvCell(playerid);
	if(Amount) InvAdd(playerid, uid, count, "", model, wear, string);
	player_SaveInv{playerid} = 4;
	return 1;
}
stock AddInvItem(playerid, slot, uid, count, model, wear, const string[])
{
    new Amount, amounts = Inventory[playerid][1][slot] + count;
    if(Inventory[playerid][1][slot] >= 2000000000) return false;
    if(amounts > 2000000000) Amount = amounts - 2000000000, Inventory[playerid][1][slot] = 2000000000;
    else Inventory[playerid][1][slot] += count;

	Inventory[playerid][0][slot] = uid;
	Inventory[playerid][2][slot] = model;
	Inventory[playerid][3][slot] = wear; //износ
	SetString(InventoryString[playerid][slot], string);

	if(!Inventory[playerid][1][slot]) RefreshInvPlayer(playerid, slot);

	if(OpenInterface[playerid][7]) UpdateInvCell(playerid);
	if(Amount) InvAdd(playerid, uid, count, "", model, wear, string);
	player_SaveInv{playerid} = 4;
	return 1;
}
CMD:additem(playerid, get[])
{
	extract get -> new targetid, uid, count = 1, model = 0, string:name[20] = "null";
	SCMf(playerid, -1, "Используй: /additem [targetid] [1-%i] [count] [model] [name]", sizeof(ItemsData)-1);
	if(!IsPlayerConnected(targetid) || !IsPlayerLogged(targetid))
	{
		SCM(playerid, -1, !"Такого игрока нет!");
		return 1;
	}
	if(uid < 1 || uid > sizeof(ItemsData)-1 || strlen(name) > 18 || count < 1 || count > 100000 || strlen(name) < 1)
	{
		return 1;
	}
	str_1[0] = EOS, f(str_1, sizeof str_1, "[A] %s[%i] выдал игроку %s[%i] предмет %s[%i] с параметрами %i,%i,'%s'", PN(playerid), playerid, PN(targetid), targetid, ItemsData[uid][ItemName], uid, count, model, name);
	SendAdminsMessage(0x999999FF, str_1);
	str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
	f(str_log, sizeof(str_log), "%s выдал игроку", str_log);
	if(!InvAdd(targetid, uid, count, "Администратор выдал вам предмет %s в количестве %i", model, 0, name, str_log)) SCM(playerid, -1, !"У игрока не хватает места в инвентаре!");
	return 1;
}
CMD:additemall(playerid, get[])
{
	if(!NameIsFullDostup(PN(playerid))) return -1;
	extract get -> new uid, count, model = 0, string:name[20] = "null"; else
	{
		SCMf(playerid, -1, "Используй: /additemall [1-%i] [count] [model] [name]", sizeof(ItemsData)-1);
		return 1;
	}
	if(uid < 1 || uid > sizeof(ItemsData)-1 || strlen(name) > 18 || count < 1 || count > 100 || strlen(name) < 1)
	{
		SCMf(playerid, -1, "Используй: /additemall [1-%i] [count] [model] [name]", sizeof(ItemsData)-1);
		return 1;
	}
	str_1[0] = EOS, f(str_1, sizeof str_1, "Админ %s[%i] выдал всем игрокам предмет %s[%i] с параметрами %i,%i,'%s'", PN(playerid), playerid, ItemsData[uid][ItemName], uid, count, model, name);
	SendAdminsMessage(0x999999FF, str_1);
	SCMAllf(0xFFCD00FF, "Администратор %s[%i] выдал всем игрокам %s в количестве %i", PN(playerid), playerid, ItemsData[uid][ItemName], count);
	foreach(new i: Player)
	{
		if(!IsPlayerLogged(i)) continue;
		str_log[0] = EOS, f(str_log, sizeof(str_log), action_log, PI[playerid][pID], PN(playerid), PI[playerid][pID]);
		f(str_log, sizeof(str_log), "%s выдал игроку(all)", str_log);
		InvAdd(i, uid, count, "Администратор выдал вам предмет %s в количестве %i", model, 0, name, str_log);
	}
	return 1;
}
stock SetPlayerSkinEx(playerid, skinid)
{
	SetPlayerData(playerid, pSkin, skinid);
	SetPlayerSkin(playerid, skinid);
	ExecutePacket(playerid, webUpdate, (str_f("window.setPlayerSkinId('%i')", skinid)));
	UpdatePlayerDataInt(playerid, "Skin", skinid);
}
stock GetInvCount(playerid, uid, model = -1, wear = -1, const name[] = "")
{
	new count;
	for(new i; i < 20; i++)
	{
		if(uid != Inventory[playerid][0][i]) continue;
		if(model != -1 && Inventory[playerid][2][i] != model) continue;
		if(wear != -1 && Inventory[playerid][3][i] != wear) continue;
		if(strlen(name) > 1 && !GetString(InventoryString[playerid][i], name)) continue;
		count += Inventory[playerid][1][i];
	}
	return count;
}
stock GetInvItem(playerid, uid, count, model)
{
	new post;
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] == uid)
		{
			post = 1;
			if(Inventory[playerid][1][i] == count)
			{
				post = 2;
				if(Inventory[playerid][2][i] == model) 
				{
					post = 3;
					break;
				}
			}
		}
	}
	return post;
}
stock Float:GetInvHeft(const params[][], params_sizeof)
{
	new Float:heft;
	for(new i; i < params_sizeof; i++)
	{
		if(params[0][i] == -1 || params[0][i] >= sizeof(ItemsData) || params[0][i] < 0) continue;
		heft += ItemsData[params[0][i]][ItemHeft];
	}
	return heft;
}
stock GetInvSlot(playerid, uid)
{
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] != uid) continue;
		return i;
	}
	return -1;
}
stock player_CheckItem(playerid, itemid, amount = 1, data = 0, wear = 2)
{
	/*if(itemid == 0 && (amount < 0 || amount > 2117483647))
	{
		PI[playerid][pCash] = 2117483647;
		GivePlayerMoneyEx(playerid, 1, "None", true, false);
	}*/
	if(itemid == 0 && amount == 0) return 0;
	if(itemid == 100 && data == 252) return 0;
    new item = GetInvItem(playerid, itemid, amount, data);
    if(itemid == 100 && item != 3) InvAdd(playerid, itemid, amount, "", data, wear, "", "Возврат открытие инва");
    else if(!itemid && item > 0) SetInvItem(playerid, GetInvSlot(playerid, itemid), itemid, amount, data, wear, "");
	else if(!itemid && !item) InvAdd(playerid, itemid, amount, "", 0, 0, "", "Возврат открытие инва");
	return 1;
}
stock GetInvCellData(playerid)
{
	//player_aks
	for(new i; i < 10; i++)
	{
		if(InventoryAks[playerid][0][i] == -1) continue;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[0,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
			i, InventoryAks[playerid][0][i], InventoryAks[playerid][2][i],\
			InventoryAksString[playerid][i], i, InventoryAks[playerid][1][i], ItemsData[InventoryAks[playerid][0][i]][ItemHeft],\
			InventoryAks[playerid][3][i]);
		strcat(str_2, str_1);
	}

	//player_inv
	for(new i; i < 20; i++)
	{
		if(Inventory[playerid][0][i] == -1) continue;
		str_1[0] = EOS, f(str_1, sizeof(str_1), "[1,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
			i, Inventory[playerid][0][i], Inventory[playerid][2][i],\
			InventoryString[playerid][i], i, Inventory[playerid][1][i],\
			ItemsData[Inventory[playerid][0][i]][ItemHeft],\
			Inventory[playerid][3][i]);
		strcat(str_2, str_1);
	}

	if(IsPlayerBagUsed(playerid) == 1)
	{
		for(new i; i < 24; i++)
		{
			if(InventoryBag[playerid][0][i] == -1) continue;
			str_1[0] = EOS, f(str_1, sizeof(str_1), "[2,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
				i, InventoryBag[playerid][0][i], InventoryBag[playerid][2][i],\
				InventoryBagString[playerid][i], i, InventoryBag[playerid][1][i],\
				ItemsData[InventoryBag[playerid][0][i]][ItemHeft],\
				InventoryBag[playerid][3][i]);
			strcat(str_2, str_1);
		}
	}
	if(player_InvType{playerid} == 1) //shkaf
	{
		//shkaf
		new id = IsPlayerHouseOwner(playerid, player_HouseEntered[playerid]);
		if(id != -1 && id != -2)
		{
			for(new i; i < 24; i++)
			{
				if(InventoryHouse[id][0][i] == -1) continue;
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
					i, InventoryHouse[id][0][i], InventoryHouse[id][2][i],\
					InventoryHouseString[id][i], i, InventoryHouse[id][1][i],\
					ItemsData[InventoryHouse[id][0][i]][ItemHeft],\
					InventoryHouse[id][3][i]);
				strcat(str_2, str_1);
			}
		}
	}
	else if(player_InvType{playerid} == 2) //trunk
	{
		new id = IsTrunkDostup(playerid);
		if(id != -1 && id != -2)
		{
			for(new i; i < 24; i++)
			{
				if(InventoryTrunk[id][0][i] == -1) continue;
				//%i, %i, %i, \"%s\", %i, %.2f, %i
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
					i, InventoryTrunk[id][0][i], InventoryTrunk[id][2][i],\
					InventoryTrunkString[id][i], i, InventoryTrunk[id][1][i],\
					ItemsData[InventoryTrunk[id][0][i]][ItemHeft],\
					InventoryTrunk[id][3][i]);
				strcat(str_2, str_1);
			}
		}
	}
	else if(player_InvType{playerid} == 3) //garage number board
	{
		new id = player_GarageEntered[playerid];
		if(id != -1)
		{
			for(new i; i < 24; i++)
			{
				if(InventoryGarage[id][0][i] == -1) continue;
				//%i, %i, %i, \"%s\", %i, %.2f, %i
				str_1[0] = EOS, f(str_1, sizeof(str_1), "[3,%i,%i,%i,\"%s\",%i,%i,%.2f,%i],", \
					i, InventoryGarage[id][0][i], InventoryGarage[id][2][i],\
					InventoryGarageString[id][i], i, InventoryGarage[id][1][i],\
					ItemsData[InventoryGarage[id][0][i]][ItemHeft],\
					InventoryGarage[id][3][i]);
				strcat(str_2, str_1);
			}
		}
	}
	strdel(str_2, strlen(str_2)-1, strlen(str_2));
}
stock bool:IsAllNullInv(const s[])
{
	for(new i; s[i] != EOS; )
	{
		if(s[i] == ',') { i++; continue; }
		if(s[i] == 'n' && s[i+1] == 'u' && s[i+2] == 'l' && s[i+3] == 'l') { i += 4; continue; }
		return false;
	}
	return true;
}

stock house_LoadInventory(get, id)
{
	cache_get_string(get, "Inventory_0", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryHouse[id][0]);
	cache_get_string(get, "Inventory_1", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryHouse[id][1]);
	cache_get_string(get, "Inventory_2", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryHouse[id][2]);
	cache_get_string(get, "Inventory_3", str_1), sscanf(str_1, "p<,>a<i>[24]", InventoryHouse[id][3]);
	cache_get_string(get, "Inventory_String", str_1);

	if(IsAllNullInv(str_1))
	{
		for(new s; s < 24; s++) InventoryHouseString[id][s] = "null";
	}
	else sscanf_string(str_1, InventoryHouseString[id], ',');
}
