stock Carriers_SearchVehicleUID(vehicleid)
{
	for(new i; i < sizeof(CarriersCarData); i++)
	{
		if(Carriers_CarData[i] == vehicleid) return i;
	}
	return -1;
}

public: player_Carriers_UnLoadPlant(playerid, amount)
{
	TogglePlayerControllable(playerid, true);
	player_Carriers_Update(playerid, -amount);
	IsPlayerCarriersRaceCP{playerid} = true;
	SCM (playerid,  -1, " ");
	SCMf(playerid,  -1, "Разгрузка окончена, Вы поместили в грузовой отсек {FFFF00}%i{ffffff} ед. товара", amount);
	//SCM (playerid,  -1, "Отправляйтесь к {ffd595}%s{ffffff}, которое отмечено {f06868}красной меткой{ffffff} на карте", );
	player_Carriers_RandAdvice(playerid);
	SCMf(playerid,-65281, "- Текущее состояние груза: %i ед.", player_Carriers_Products[playerid]);
	return 1;
}
public: player_Carriers_UnLoadBiz(playerid)
{
	TogglePlayerControllable(playerid, true);
	new id = player_SearchJobID(playerid, 0);
	if(id == -1) return SCM(playerid,-825307393, "* Вы не работаете дальнобойщиком");

	new job_bizid = PI[playerid][pJob_BizID][id];
	if(job_bizid == -1) return SCM(playerid,-825307393, "* Вы не работаете дальнобойщиком");

	new 
		bizid = player_Carriers_BizID[playerid],
		count = player_Carriers_Products[playerid];
	
	//SCMf(playerid, -1, "%i %i %i", bizid, count, player_Carriers_Products[playerid]);
	new 
		wage = GetCarriersWage(bizid);

//	11574000 = 5300 * 11574000 / 15000 - 8570
	printf("%i = %i * %i / %i - %i", wage, count, wage, 15000, BizData[bizid][bProducts]);
	wage = count * wage / (15000 - BizData[bizid][bProducts]);
	printf("%i", wage);
	if(wage < 5000000) wage = 5000000;
	else if(wage > 2000000000) wage = 2000000000;
	//new temp_wage = ((count-temp) / (15000-BizData[bizid][bProducts])) * 100;

	//wage = (wage + temp_wage / 100) * wage;

	BizData[bizid][bProducts] += player_Carriers_Products[playerid];
	player_Carriers_Update(playerid, -100000);
	
	new temp = BizData[bizid][bProducts]-15000;
	if(temp > 0) player_Carriers_Update(playerid, temp);


	GiveBusinessMoney(playerid, job_bizid, wage/15, -100);
	GiveBusinessMoney(playerid, bizid, -50000000, -100);
	temp = BizData[bizid][bProducts]-15000;
	//SCMf(playerid, -1, "%i", wage);

	player_Carriers_Wage[playerid] += wage;
	GivePlayerMoneyEx(playerid, wage, "Работа ТК: выполнил заказ на бизнес");

	SCM(playerid,-1, " ");
	SCMf(playerid,-1, "Вы доставили {cefb6a}%i{ffffff} %s. товара предприятию «{ffbc57}%s %s{ffffff}», и получили {cefb6a}%i{ffffff} руб.", \
		count, (BizData[bizid][bType] == 1 ? "л" : "ед"), BizStaticData[BizData[bizid][bType]][bsName], BizData[bizid][bName], wage);
	
	if(temp < 0)
	{
		SCMf(playerid,-1, "Предприятию требуется ещё {ffbc57}%i{ffffff} ед. товара. Вы можете прервать контракт, либо продолжить его выполнение", -temp);
	}
	else player_Carriers_BizID[playerid] = -1;

	SCM(playerid,-4433921, "Совет: {ffffff}Если Вы хотите получить {ffbc57}очки навыка и рейтинга{ffffff}, то необходимо закончить контракт");
	player_Carriers_RandAdvice(playerid);
	SCMf(playerid,-65281, "- Текущее состояние груза: %i %s.", player_Carriers_Products[playerid], (BizData[bizid][bType] == 1 ? "л" : "ед"));
	return 1;
}
public: player_Carriers_Load(playerid, amount)
{
	TogglePlayerControllable(playerid, true);
	if(!player_Carriers_Update(playerid, amount)) return SCM(playerid,-825307393, "* Вы не работаете дальнобойщиком");
	IsPlayerCarriersRaceCP{playerid} = true;
	SCM(playerid,-1, " ");
	new id = player_Carriers_BizID[playerid];
	SCMf(playerid,-1, "Загрузка окончена, Вы поместили в грузовой отсек {FFFF00}%i{ffffff} %s. товара", amount, (BizData[id][bType] == 1 ? "л" : "ед"));
	SCM(playerid,-1, "Отправляйтесь к {ffd595}предприятию{ffffff}, которое отмечено {f06868}красной меткой{ffffff} на карте");
	player_Carriers_RandAdvice(playerid);
	SCMf(playerid,-65281, "- Текущее состояние груза: %i %s.", player_Carriers_Products[playerid], (BizData[id][bType] == 1 ? "л" : "ед"));
	
	SetPlayerRaceCheckpoint(playerid, 2, BizData[id][bEnter][0], BizData[id][bEnter][1], BizData[id][bEnter][2], 0.0, 0.0, 0.0, 19.0);
	return 1;
}
stock player_Carriers_Update(playerid, amount)
{
	new id = player_SearchJobID(playerid, 0);
	if(id != -1)
	{
		player_Carriers_Products[playerid] += amount;
		if(player_Carriers_Products[playerid] > 5300) player_Carriers_Products[playerid] = 5300;
		else if(player_Carriers_Products[playerid] < 1) player_Carriers_Products[playerid] = 0;

		new vehicleid = GetPlayerVehicleID(playerid),
			bool:clear = true;
		if(vehicleid == PI[playerid][pTemp_JobCarID][id] && GetVehicleTrailer(vehicleid) > 0)
		{
			if(player_Carriers_Products[playerid] > 0)
			{
				Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] = -1.0;
				Handling_VehicleData[vehicleid][E_ENGINE_INERT] = -5.0;
				Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = -20.0;
				clear = false;
			}
		}
		if(clear != false)
		{
			Handling_VehicleData[vehicleid][E_ENGINE_ACCELERATION] = 0.0;
			Handling_VehicleData[vehicleid][E_ENGINE_INERT] = 0.0;
			Handling_VehicleData[vehicleid][E_MAXGEAR_VELOCITY] = 0.0;
		}
		UpdateVehicleHadlingEx(vehicleid, playerid);
		return 1;
	}
	return 0;
}
new ListMap;
public: OnDialogResponseEx(playerid, response, listitem, inputtext[])
{
	if(strlen(inputtext) > 142 || player_DialogID[playerid] == -1) return 1;

	new dialogid = player_DialogID[playerid];
	player_DialogID[playerid] = -1;

	static inputtextsave[144];
	inputtextsave[0] = EOS;
	if(strlen(inputtext) > 0 && strlen(inputtext) < 144) 
	{
		mysql_escape_string(inputtext, inputtextsave, 144);
	}

	//bank card
	static const 
			Bank_takeCashCount[] = {1000,2000,5000,10000,20000,50000,100000,-1},
			count_limit[][] = {
		{1, 10},
		{10000000, 200000000},
		{0, 100}
	},
			name_table[][] = {
		{"Level"},
		{"Cash"},
		{"Cash_Donate"}
	};
	printf("%s[%i] used dialog: %i[%s]", PN(playerid), playerid, dialogid, inputtextsave);
	//
	switch(dialogid)
	{
		case 20489:{
			if(!response) return true;
			if(isnull(inputtext)){
				SPD(
					playerid, 20489, DIALOG_STYLE_INPUT,
					"Смена названия обьекта",
					"Напишите название обьекта ниже:",
					"Далее","Закрыть"
				);
			}
			else{
				static oldname[24];
				format(oldname, sizeof oldname, ObjInfo[ListMap][objName]);
				ObjInfo[ListMap][objName][0] = EOS;
				format(ObjInfo[ListMap][objName], 24, "%s", inputtext);
				mysql_tquery(mysql, (str_f("UPDATE `Objects` SET `Name` = '%s' WHERE `Name` = '%s' LIMIT 1;", ObjInfo[ListMap][objName], oldname)));
				SendAdminsMessagef(0x999999FF, "[А] %s[%i] сменил обьекту [№%i] название c %s на %s", PN(playerid), playerid, ObjInfo[ListMap][objID], oldname, ObjInfo[ListMap][objName]);
				SCM(playerid, -1, "Готово");
				str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s сменил обьекту [№%i] название c %s на %s", PN(playerid), ObjInfo[ListMap][objID], oldname, ObjInfo[ListMap][objName]);
				SendLog(1, str_log);
			}
		}
		case 20488:{
			if(!response) return true;
			if(isnull(inputtext)){
				SPD(
					playerid, 20488, DIALOG_STYLE_INPUT,
					"Смена обьекта",
					"Напишите айди обьекта ниже:",
					"Далее","Закрыть"
				);
			}
			else{
				new oldmodel = ObjInfo[ListMap][objModel];
				new model = strval(inputtext);
				ObjInfo[ListMap][objModel] = model;
				DestroyDynamicObject(ObjInfo[ListMap][objID]);
				ObjInfo[ListMap][objID] = CreateDynamicObject(ObjInfo[ListMap][objModel], ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY], ObjInfo[ListMap][objPosZ], ObjInfo[ListMap][objRotX], ObjInfo[ListMap][objRotY], ObjInfo[ListMap][objRotZ]);
				mysql_tquery(mysql, (str_f("UPDATE `Objects` SET `Model` = '%i' WHERE `Name` = '%s' LIMIT 1;", ObjInfo[ListMap][objModel], ObjInfo[ListMap][objName])));
				SendAdminsMessagef(0x999999FF, "[А] %s[%i] сменил обьекту [№%i] модель c %i на %i", PN(playerid), playerid, ObjInfo[ListMap][objID], oldmodel, model);
				SCM(playerid, -1, "Готово");
				str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s сменил обьекту [№%i] модель c %i на %i", PN(playerid), ObjInfo[ListMap][objID], oldmodel, model);
				SendLog(1, str_log);
			}
		}
		case 20487:{
			if(!response) return callcmd::maplist(playerid, "");
			switch(listitem){
				case 0:{
					SPD(
						playerid, 20488, DIALOG_STYLE_INPUT,
						"Смена обьекта",
						"Напишите айди обьекта ниже:",
						"Далее","Закрыть"
					);
				}
				case 1:{
					SPD(
						playerid, 20489, DIALOG_STYLE_INPUT,
						"Смена названия обьекта",
						"Напишите название обьекта ниже:",
						"Далее","Закрыть"
					);
				}
				case 2:{
					if(!IsPlayerInRangeOfPoint(playerid, 5.0, ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY], ObjInfo[ListMap][objPosZ])) return SCM(playerid, -1, "Вы слишком далеко от обьекта");
					EditDynamicObject(playerid, ObjInfo[ListMap][objID]);
					SetPVarInt(playerid, "objedit", 1);
				}
				case 3:{
					SetPlayerPos(playerid, ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY]+2.00, ObjInfo[ListMap][objPosZ]+2.00);
					SCMf(playerid, 0x999999FF, "Вы телепортированы к обьекту %i на координаты %.2f, %.2f, %.2f", ObjInfo[ListMap][objModel], ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY], ObjInfo[ListMap][objPosZ]);
					str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s телепортировался к обьекту %i на координаты %.2f, %.2f, %.2f", PN(playerid), ObjInfo[ListMap][objModel], ObjInfo[ListMap][objPosX], ObjInfo[ListMap][objPosY], ObjInfo[ListMap][objPosZ]);
					SendLog(1, str_log);
				}
				case 4:{
					static const mysql_str[] = "DELETE FROM `Objects` WHERE `Name` = '%s'";
					static str[sizeof(mysql_str) + (-4 + 52)];
					SCM(playerid, -1, !"Готово");
					SendAdminsMessagef(0x999999FF, "[А] %s[%i] удалил обьект [№%i] с параметрами %i, %s", PN(playerid), playerid, ObjInfo[ListMap][objID], ObjInfo[ListMap][objModel], ObjInfo[ListMap][objName]);
					format(str, sizeof(str), mysql_str, ObjInfo[ListMap][objName]);
					mysql_tquery(mysql, str);
					DestroyDynamicObject(ObjInfo[ListMap][objID]);
					SetString(ObjInfo[ListMap][objName], "");
					str_log[0] = EOS, f(str_log, sizeof(str_log), "Админ %s удалил обьект [№%i] с параметрами %i, %s", PN(playerid), ObjInfo[ListMap][objID], ObjInfo[ListMap][objModel], ObjInfo[ListMap][objName]);
					SendLog(1, str_log);
				}
			}
		}
		case 20486:{
			if(!response) return true;
			ListMap = 0;
			ListMap = listitem;
			str_q[0] = EOS, f(str_q, sizeof str_q, "Параметр\tЗначение\nМодель:\t %i\nНазвание:\t %s\nКоординаты:\t X:%.2fY:%.2fZ:%.2f\nТелепортироваться к обьекту\nУдалить обьект", ObjInfo[listitem][objModel], ObjInfo[listitem][objName], ObjInfo[listitem][objPosX], ObjInfo[listitem][objPosY], ObjInfo[listitem][objPosZ]);
			SPD(
				playerid, 20487, DIALOG_STYLE_TABLIST_HEADERS,
				"Настройка обьекта", str_q, "Изменить", "Назад"
			);
		}
		case 20485:
		{
			if(!response) return 1;
			//SCMf(playerid, -1, "%i", 5300-player_Carriers_Products[playerid]);
			new amount = strval(inputtextsave);
			if(amount < 10 || amount > 5300 || player_Carriers_Products[playerid]-amount < 1)
			{
				player_DialogID[playerid] = 20485;
				OnDialogResponseEx(playerid, 0, 0, "");
				return 1;
			}
			new time = amount/200;
			if(time < 2) time = 3;
			SCMf(playerid,-1, "Разгрузка товара началась, примерное время: {b3ee7b}%i сек{ffffff}, не покидайте свой транспорт", time);
			TogglePlayerControllable(playerid, false);
			SetTimerEx("player_Carriers_UnLoadPlant", time*1000, false, "ii", playerid, amount);
		}
		case 20484:
		{
			if(!response) return 1;
			if(player_Carriers_BizID[playerid] == -1) return SCM(playerid,-1717986817, "Чтобы выполнить погрузку, необходимо иметь заказ");
			new amount = strval(inputtextsave);
			if(amount < 10 || amount > 5300 || player_Carriers_Products[playerid]+amount > 5300)
			{
				player_DialogID[playerid] = 20484;
				OnDialogResponseEx(playerid, 0, 0, "");
				return 1;
			}
			new time = amount/200;
			if(time < 2) time = 3;
			SCMf(playerid,-1, "Погрузка товара началась, примерное время: {b3ee7b}%i сек{ffffff}, не покидайте свой транспорт", time);
			TogglePlayerControllable(playerid, false);
			SetTimerEx("player_Carriers_Load", time*1000, false, "ii", playerid, amount);
		}
		case 20483:
		{
			new uid = Carriers_SearchVehicleUID(GetPlayerVehicleID(playerid));
			if(uid != -1)
			{
				new trailerid = Carriers_CarTrailer[uid],
					vehicleid = Carriers_CarData[uid];
				if(player_ShowUID[playerid][101] == 1) //bizlist
				{
					if(trailerid != -1)
					{
						new attachVehicle = GetVehicleTrailer(vehicleid);
						if(attachVehicle == trailerid)
						{
							if(VehicleData[trailerid][V_MODELID] == 435)
							{
								SPD(playerid, !response ? 20485 : 20484, 1, "{FFCD00}Действие на заводе", (str_f("{ffffff}Введите количество товара, которое хотите %s:", !response ? "выгрузить" : "погрузить")), "Далее","Закрыть");
							}
							else
							{
								SCM(playerid,-1717986817, "Данный прицеп не подходит для вашего заказа, возьмите в гараже другой");
								SCM(playerid,-1717986817, "Ваш заказ не предусматривает загрузку / разгрузку на нефтезаводе");
							}
						}
						else SCM(playerid,-1717986817, "Ваш прицеп должен быть прикреплён к рабочему транспорту");
					}
					else SCM(playerid,-1717986817, "Вы должны взять соответствующий прицеп из гаража компании");
				}
				else
				{
					if(trailerid != -1 || VehicleData[vehicleid][V_MODELID] == 15097)
